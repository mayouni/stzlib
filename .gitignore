# Softanza reflect: generated example-index cache (rebuilt on demand from tests)
*.stzcache

# Neural model files (large; downloaded on demand)
*.gguf
# EXCEPTION: the BERT-parity test fixture is a tiny (83 KB) SYNTHETIC model,
# committed so CI verifies the forward pass with no model download -- the
# rule above exists to keep real (multi-MB) models out, not fixtures.
!libraries/stzlib/base/test/neural/tiny_bert.gguf

# stzApp/stzPlatform test-run artifacts
**/test/**/.stzapp/

# generated cluster worker entry (R8.3)
**/cluster/.stzworker_gen.ring
**/appserver/.stzbackend_*
# generated mTLS test worker entry (R8 mTLS slice 4)
**/mtls_certs/.mtls_worker_gen.ring

# stzBuilder test scratch (build artifacts; test cleans up, this guards a mid-run crash)
_build_scratch/
_deploy_scratch/
_wasmsub_tmp/
# StzDirDeleteAll / dir-listing probes (ephemeral)
**/_delprobe/
**/_delprobe2/
**/_treeprobe/
# generated emulator bundles (Deploy(:Emulated) output; regenerated on demand)
**/restolean_emulator/
# stzAuth DB-store test databases (guards create + remove these; a leaked sqlite
# handle on Windows can leave the file behind, so guard against committing it)
**/_authtest_*.db
**/_dataport_test.db
**/_p7test.db
# stzFileBlobStore guard directory (removed by the guard; ignored in case it dies
# midway and leaves the store behind)
**/_blobtest/
# generated drill target entry (incident analysis I8; regenerated per run)
**/security/.stzdrilltarget_gen.ring
# drill evidence seals (removed by Destroy(); ignored in case a run dies midway)
**/_drill_*_evidence.stzledger
# generated load-driver entries (perf P11; regenerated per run)
**/perf/.stzloaddriver_gen.ring
**/perf/.stzloadtarget_gen.ring
# fswatch guard scratch dir (the guard reuses it across runs by design)
**/_fswatch_scratch/

# sound studio: the exe is built into zig-out/ with the engine; temp/ holds
# renders the guards and the console studio write
libraries/stzlib/base/test/sound/temp/
