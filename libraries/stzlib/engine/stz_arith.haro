# Softanza Engine -- Arithmetic Expression Evaluator
#
# Loads stz_arith.dll for arithmetic expression parsing/evaluation.
#
# Function prefix: StzEngineArith*

if IsWindows()
    $tStzArithLib = $tEngineDir + "/zig-out/bin/stz_arith.dll"
elseif IsLinux()
    $tStzArithLib = $tEngineDir + "/zig-out/lib/libstz_arith.so"
elseif isMacOS()
    $tStzArithLib = $tEngineDir + "/zig-out/lib/libstz_arith.dylib"
end

# the domain door (SOFTANZA_ONE_HOUR.md W7b): skipped when a manifest leaves it out or DENIED names it
if not StzDomainWanted("arith")
    $hStzArithHandle = ""
elseif FExists($tStzArithLib)
    $hStzArithHandle = LoadLib($tStzArithLib)
else
    ? "WARNING: stz_arith not found at: " + $tStzArithLib
    $hStzArithHandle = ""
end
