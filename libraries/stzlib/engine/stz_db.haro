# Softanza Engine -- SQLite database (R7 delivery-plane data floor)
#
# Loads stz_db.dll: open/exec/query/close over vendored sqlite3.
#
# Function prefix: StzEngineDb*

if IsWindows()
    $tStzDbLib = $tEngineDir + "/zig-out/bin/stz_db.dll"
elseif IsLinux()
    $tStzDbLib = $tEngineDir + "/zig-out/lib/libstz_db.so"
elseif isMacOS()
    $tStzDbLib = $tEngineDir + "/zig-out/lib/libstz_db.dylib"
end

# the domain door (SOFTANZA_ONE_HOUR.md W7b): skipped when a manifest leaves it out or DENIED names it
if not StzDomainWanted("db")
    $hStzDbHandle = null
elseif FExists($tStzDbLib)
    $hStzDbHandle = LoadLib($tStzDbLib)
else
    ? "WARNING: stz_db not found at: " + $tStzDbLib
    $hStzDbHandle = null
end
