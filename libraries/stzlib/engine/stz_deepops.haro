# Softanza Engine -- DeepOps Ring Bridge
#
# Loads stz_deepops.dll as a Ring extension.
# ringlib_init registers all functions natively -- no CallCFunc needed.
# Ring code calls them directly by name (case-insensitive).
#
# Function prefix: StzEngineDeep*

if IsWindows()
    $tStzDeepopsLib = $tEngineDir + "/zig-out/bin/stz_deepops.dll"
elseif IsLinux()
    $tStzDeepopsLib = $tEngineDir + "/zig-out/lib/libstz_deepops.so"
elseif isMacOS()
    $tStzDeepopsLib = $tEngineDir + "/zig-out/lib/libstz_deepops.dylib"
end

# the domain door (SOFTANZA_ONE_HOUR.md W7b): skipped when a manifest leaves it out or DENIED names it
if not StzDomainWanted("deepops")
    $hStzDeepopsHandle = ""
elseif FExists($tStzDeepopsLib)
    $hStzDeepopsHandle = LoadLib($tStzDeepopsLib)
else
    ? "WARNING: stz_deepops not found at: " + $tStzDeepopsLib
    $hStzDeepopsHandle = ""
end
