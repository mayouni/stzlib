# Softanza Engine -- Process Info
#
# Loads stz_process.dll for process/platform introspection.
# It also carries the OS boundary (StzEngineBoundary*, src/boundary.zig): a grant, a command started inside it, and
# how the run ended -- base/security/SOFTANZA_OS_BOUNDARY_STUDY.md, rung B1.
#
# Function prefix: StzEngineProcess*

if IsWindows()
    $tStzProcessLib = $tEngineDir + "/zig-out/bin/stz_process.dll"
elseif IsLinux()
    $tStzProcessLib = $tEngineDir + "/zig-out/lib/libstz_process.so"
elseif isMacOS()
    $tStzProcessLib = $tEngineDir + "/zig-out/lib/libstz_process.dylib"
end

# the domain door (SOFTANZA_ONE_HOUR.md W7b): skipped when a manifest leaves it out or DENIED names it
if not StzDomainWanted("process")
    $hStzProcessHandle = ""
elseif FExists($tStzProcessLib)
    $hStzProcessHandle = LoadLib($tStzProcessLib)
else
    ? "WARNING: stz_process not found at: " + $tStzProcessLib
    $hStzProcessHandle = ""
end
