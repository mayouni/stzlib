# Softanza Engine -- UUID Generation
#
# Loads stz_uuid.dll for UUID v4 generation, validation, comparison.
#
# Function prefix: StzEngineUuid*

if IsWindows()
    $tStzUuidLib = $tEngineDir + "/zig-out/bin/stz_uuid.dll"
elseif IsLinux()
    $tStzUuidLib = $tEngineDir + "/zig-out/lib/libstz_uuid.so"
elseif isMacOS()
    $tStzUuidLib = $tEngineDir + "/zig-out/lib/libstz_uuid.dylib"
end

# the domain door (SOFTANZA_ONE_HOUR.md W7b): skipped when a manifest leaves it out or DENIED names it
if not StzDomainWanted("uuid")
    $hStzUuidHandle = null
elseif FExists($tStzUuidLib)
    $hStzUuidHandle = LoadLib($tStzUuidLib)
else
    ? "WARNING: stz_uuid not found at: " + $tStzUuidLib
    $hStzUuidHandle = null
end
