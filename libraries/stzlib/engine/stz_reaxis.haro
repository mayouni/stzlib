# Softanza Engine -- Reaxis Ring Bridge
#
# Loads stz_reaxis.dll as a Ring extension.
# ringlib_init registers all functions natively -- no CallCFunc needed.
# Ring code calls them directly by name (case-insensitive).
#
# Function prefix: StzEngineReaxis*

if IsWindows()
    $tStzReaxisLib = $tEngineDir + "/zig-out/bin/stz_reaxis.dll"
elseif IsLinux()
    $tStzReaxisLib = $tEngineDir + "/zig-out/lib/libstz_reaxis.so"
elseif isMacOS()
    $tStzReaxisLib = $tEngineDir + "/zig-out/lib/libstz_reaxis.dylib"
end

# the domain door (SOFTANZA_ONE_HOUR.md W7b): skipped when a manifest leaves it out or DENIED names it
if not StzDomainWanted("reaxis")
    $hStzReaxisHandle = ""
elseif FExists($tStzReaxisLib)
    $hStzReaxisHandle = LoadLib($tStzReaxisLib)
else
    ? "WARNING: stz_reaxis not found at: " + $tStzReaxisLib
    $hStzReaxisHandle = ""
end
