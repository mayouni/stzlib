# Softanza Engine -- Performance Senses (perf system P1)
#
# Loads stz_perf.dll: process memory (RSS/peak), system memory
# (total/available), process CPU time, and the engine-resident metric
# series (bounded (time, value) ring buffer with statistical queries).
#
# Function prefix: StzEnginePerf*

if IsWindows()
    $tStzPerfLib = $tEngineDir + "/zig-out/bin/stz_perf.dll"
elseif IsLinux()
    $tStzPerfLib = $tEngineDir + "/zig-out/lib/libstz_perf.so"
elseif isMacOS()
    $tStzPerfLib = $tEngineDir + "/zig-out/lib/libstz_perf.dylib"
end

# the domain door (SOFTANZA_ONE_HOUR.md W7b): skipped when a manifest leaves it out or DENIED names it
if not StzDomainWanted("perf")
    $hStzPerfHandle = null
elseif FExists($tStzPerfLib)
    $hStzPerfHandle = LoadLib($tStzPerfLib)
else
    ? "WARNING: stz_perf not found at: " + $tStzPerfLib
    $hStzPerfHandle = null
end
