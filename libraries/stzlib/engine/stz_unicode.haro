# Softanza Engine -- Base Unicode Ring Bridge
#
# Loads stz_unicode.dll as a Ring extension.
# ringlib_init registers all functions natively -- no CallCFunc needed.
# Ring code calls them directly by name (case-insensitive).
#
# Used by: base/unicode/stzUnicode.ring
# Function prefix: StzEngine*

if IsWindows()
    $tStzUnicodeLib = $tEngineDir + "/zig-out/bin/stz_unicode.dll"
elseif IsLinux()
    $tStzUnicodeLib = $tEngineDir + "/zig-out/lib/libstz_unicode.so"
elseif isMacOS()
    $tStzUnicodeLib = $tEngineDir + "/zig-out/lib/libstz_unicode.dylib"
end

# the domain door (SOFTANZA_ONE_HOUR.md W7b): skipped when a manifest leaves it out or DENIED names it
if not StzDomainWanted("unicode")
    $hStzUnicodeHandle = ""
elseif FExists($tStzUnicodeLib)
    $hStzUnicodeHandle = LoadLib($tStzUnicodeLib)
else
    ? "WARNING: stz_unicode not found at: " + $tStzUnicodeLib
    $hStzUnicodeHandle = ""
end
