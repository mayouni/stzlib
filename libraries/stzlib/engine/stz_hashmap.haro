# Softanza Engine -- Base HashMap Ring Bridge
#
# Loads stz_hashmap.dll as a Ring extension.
# ringlib_init registers all functions natively -- no CallCFunc needed.
# Ring code calls them directly by name (case-insensitive).
#
# Used by: base/list/stzHashMap.ring (future)
# Function prefix: StzEngineHashMap*

if IsWindows()
    $tStzHashMapLib = $tEngineDir + "/zig-out/bin/stz_hashmap.dll"
elseif IsLinux()
    $tStzHashMapLib = $tEngineDir + "/zig-out/lib/libstz_hashmap.so"
elseif isMacOS()
    $tStzHashMapLib = $tEngineDir + "/zig-out/lib/libstz_hashmap.dylib"
end

# the domain door (SOFTANZA_ONE_HOUR.md W7b): skipped when a manifest leaves it out or DENIED names it
if not StzDomainWanted("hashmap")
    $hStzHashMapHandle = ""
elseif FExists($tStzHashMapLib)
    $hStzHashMapHandle = LoadLib($tStzHashMapLib)
else
    ? "WARNING: stz_hashmap not found at: " + $tStzHashMapLib
    $hStzHashMapHandle = ""
end
