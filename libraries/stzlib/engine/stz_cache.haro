# Softanza Engine -- Cache Operations
#
# Loads stz_cache.dll for string key-value caching with TTL.
#
# Function prefix: StzEngineCache*

if IsWindows()
    $tStzCacheLib = $tEngineDir + "/zig-out/bin/stz_cache.dll"
elseif IsLinux()
    $tStzCacheLib = $tEngineDir + "/zig-out/lib/libstz_cache.so"
elseif isMacOS()
    $tStzCacheLib = $tEngineDir + "/zig-out/lib/libstz_cache.dylib"
end

# the domain door (SOFTANZA_ONE_HOUR.md W7b): skipped when a manifest leaves it out or DENIED names it
if not StzDomainWanted("cache")
    $hStzCacheHandle = ""
elseif FExists($tStzCacheLib)
    $hStzCacheHandle = LoadLib($tStzCacheLib)
else
    ? "WARNING: stz_cache not found at: " + $tStzCacheLib
    $hStzCacheHandle = ""
end
