# Softanza Engine -- Base String + Char Ring Bridge
#
# Loads stz_string.dll as a Ring extension.
# ringlib_init registers all functions natively -- no CallCFunc needed.
# Ring code calls them directly by name (case-insensitive).
#
# Used by: base/string/stzString.ring
# Function prefix: StzEngine* (distinct from Core StkEngine*)

if IsWindows()
    $tStzStringLib = $tEngineDir + "/zig-out/bin/stz_string.dll"
elseif IsLinux()
    $tStzStringLib = $tEngineDir + "/zig-out/lib/libstz_string.so"
elseif isMacOS()
    $tStzStringLib = $tEngineDir + "/zig-out/lib/libstz_string.dylib"
end

# the domain door (SOFTANZA_ONE_HOUR.md W7b): skipped when a manifest leaves it out or DENIED names it
if not StzDomainWanted("string")
    $hStzStringHandle = ""
elseif FExists($tStzStringLib)
    $hStzStringHandle = LoadLib($tStzStringLib)
else
    ? "WARNING: stz_string not found at: " + $tStzStringLib
    $hStzStringHandle = ""
end
