# Softanza Engine -- Constraint Validation
#
# Loads stz_constraint.dll for declarative constraints + violation tracking.
#
# Function prefix: StzEngineConstraint*

if IsWindows()
    $tStzConstraintLib = $tEngineDir + "/zig-out/bin/stz_constraint.dll"
elseif IsLinux()
    $tStzConstraintLib = $tEngineDir + "/zig-out/lib/libstz_constraint.so"
elseif isMacOS()
    $tStzConstraintLib = $tEngineDir + "/zig-out/lib/libstz_constraint.dylib"
end

# the domain door (SOFTANZA_ONE_HOUR.md W7b): skipped when a manifest leaves it out or DENIED names it
if not StzDomainWanted("constraint")
    $hStzConstraintHandle = ""
elseif FExists($tStzConstraintLib)
    $hStzConstraintHandle = LoadLib($tStzConstraintLib)
else
    ? "WARNING: stz_constraint not found at: " + $tStzConstraintLib
    $hStzConstraintHandle = ""
end
