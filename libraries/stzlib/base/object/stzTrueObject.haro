

func StzTrueObjectQ
	return new stzTrueObject
end
	func 1Object
		return new stzTrueObject
	end
	func ATrueObject
		return new stzTrueObject
	end
		func TrueObject
			return new stzTrueObject
		end
	func StzTrueQ
		return new stzTrueObject
	end
