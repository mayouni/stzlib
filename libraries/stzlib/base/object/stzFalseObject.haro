	# NNL 2.0: a false premise CARRIES the object it judged, so the
	# conditional mood can recover it -- .Otherwise(:Trim) runs on the
	# origin and hands the live chain back.
	func AFalseObjectXT(pxOrigin)
		oFo = new stzFalseObject
		oFo.SetOrigin(pxOrigin)
		# P2: the chain-local main travels through the false branch too
		if IsObject(pxOrigin) and
		   StzFindFirst("nnlmainraw", ring_methods(pxOrigin)) > 0 and
		   IsObject(pxOrigin.NNLMainRaw())
			oFo.SetNNLMain(pxOrigin.NNLMainRaw())
		end
		return oFo
	end
	func FalseObject
		return new stzFalseObject
	end
	func false
		return new stzFalseObject
	end
	func FALSEQ
		return new stzFalseObject
	end
	func StzFalseQ
		return new stzFalseObject
	end
