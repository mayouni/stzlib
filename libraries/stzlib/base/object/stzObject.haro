			return false
		end
		def IsNotAStzObject
			return this.IsNotAnObject()
		end
	# TRUE if the value given is an object; it compares no types.
	#
	#   p          the value to test
	#   returns    TRUE or FALSE
	#   warning    the name promises a comparison but the body only tests isObject(p): a stzString
	#              and a stzList answer TRUE, a text answers FALSE
	#   see        HasSameStzTypeAs, StzType
		#>
	def HasSameTypeAs(xP)
		return IsObject(xP)
	end
	# TRUE if the value given is a library object of the same class as this one.
	#
	#   p          the value to compare with
	#   returns    TRUE or FALSE
	#   note       two stzString are of the same type, a stzString and a stzList are not, and a text
	#              or a number is not an object at all
	#   warning    the class is the one StzType answers: a stzText answers stzObject, like a bare
	#              stzObject
	#   see        HasSameTypeAs, StzType
	def HasSameStzTypeAs(xP)
		if IsObject(xP) and @IsStzObject(xP) and
		   xP.StzType() = this.StzType()

			return true
		else
			return false
		end
	end
	# TRUE if the object is of at least one of the types listed.
	#
	#   paTypes    the list of type names, each optionally written :Or = type
	#   returns    TRUE or FALSE
	#   warning    a value that is not a list raises "Incorrect param type!"
	#   see        IsNotOneOfTheseTypes, IsEachOneOfTheseTypes, IsA
	def IsOneOfTheseTypes(pxTypes)

		/* EXAMPLE

		? Q("2").IsOneOfTheseTypes([ :Number, :String, :List ])
		#--> TRUE

		# can also be written use :Or = ...
		? Q("2").IsOneOfTheseTypes([ :Number, :Or = :String, :Or = :List ])
		#--> TRUE
		*/

		if not IsList(pxTypes)
			StzRaise("Incorrect param type! paTypes must be a list.")
		end

		xTypes = pxTypes
		nLen = Len(pxTypes)

		for @i = 1 to nLen
			if IsList(xTypes[@i]) and IsOrNamedParamList(xTypes[@i])
				xTypes[@i] = xTypes[@i][2]
			end
		end

		bResult = false

		for @i = 1 to nLen

			tType = xTypes[@i]

			if tType = "number" or tType = "string" or tType = "list"
				tType = "A" + tType

			elseif tType = "object"
				tType = "anobject"
			end

			if (this.IsA(tType) or this.Is(tType))
				bResult = true
				exit
			end
		end

		return bResult
	end
		# TRUE if the object is of none of the types listed.
		#
		#   paTypes    the list of type names
		#   returns    TRUE or FALSE
		#   see        IsOneOfTheseTypes
		#< @FunctionNegativeForm
		def IsNotOneOfTheseTypes(pxTypes)
			return not this.IsOneOfTheseTypes(pxTypes)
		end
	# TRUE if the object is of every type listed at once.
	#
	#   paTypes    the list of type names, each optionally written :Or = type or :And = type
	#   returns    TRUE or FALSE
	#   warning    a value that is not a list raises "Incorrect param type!"
	#   see        IsOneOfTheseTypes, IsA
		#>
	def IsEachOneOfTheseTypes(pxTypes)
		if not IsList(pxTypes)
			StzRaise("Incorrect param type! paTypes must be a list.")
		end

		xTypes = pxTypes
		nLen = Len(xTypes)

		for @i = 1 to nLen
			if IsList(xTypes[@i]) and IsOrOrAndNamedParamList(xTypes[@i])
				xTypes[@i] = xTypes[@i][2]
			end
		end

		bResult = true

		for @i = 1 to nLen

			if not (this.IsA(xTypes[@i]) or this.Is(xTypes[@i]))
				bResult = false
				exit
			end
		end

		return bResult
	end
	# TRUE if the content is a number or a text.
	#
	#   returns    TRUE or FALSE
	#   see        IsStringOrList, IsOneOfTheseTypes
	def IsNumberOrString
		xContent = this.Content()
		if IsNumber(xContent) or IsString(xContent)
			return true
		else
			return false
		end
	end
		def IsStringOrNumber
			return this.IsNumberOrString()
		end
	# TRUE if the content is a text or a list.
	#
	#   returns    TRUE or FALSE
	#   note       TRUE for a stzString and a stzList; FALSE for a stzNumber, which keeps its digits
	#              as text, and for a bare stzObject, which holds an object
	#   see        IsNumberOrString, IsListOrString
	def IsStringOrList
		if this.IsANumber()
			return false
		end

		xContent = this.Content()

		if IsString(xContent) or IsList(xContent)
			return true
		else
			return false
		end
	end
		# TRUE if the content is a list or a text, in the other order of the same question.
		#
		#   returns    TRUE or FALSE
		#   see        IsStringOrList
		def IsListOrString
			return this.IsStringOrList()
		end
	# TRUE if the object is the library's false object, the one a failed chain hands back.
	#
	#   returns    TRUE or FALSE
	#   note       AFalseObject().IsFalseObject() is TRUE; a stzString, a stzList, a stzNumber, a
	#              bare stzObject and the true object answer FALSE
	#   see        IsTrueObject, IsNullObject
	#@ aka  ==
	def IsFalseObject
		if this.StzType() = :stzFalseObject
			return true
		else
			return false
		end
	end
		#-- @Misspelled

		def IsFalseObejct
			return this.IsFalseObject()
		end
	# TRUE if the object is the library's true object, the one that holds 1 and equals everything.
	#
	#   returns    TRUE or FALSE
	#   note       ATrueObject().IsTrueObject() is TRUE; a stzString, a stzList, a stzNumber, a
	#              bare stzObject and the false object answer FALSE
	#   see        IsFalseObject, IsNullObject
	def IsTrueObject
		if this.StzType() = :stzTrueObject
			return true
		else
			return false
		end
	end
	# TRUE if the object is the library's null object.
	#
	#   returns    TRUE or FALSE
	#   note       ANullObject().IsNullObject() answers TRUE
	#   see        IsFalseObject, IsTrueObject
	def IsNullObject
		if this.StzType() = :stzNullObject
			return true
		else
			return false
		end
	end
	#=====

	def IsAXT(pxStr)

		/* EAMPLE
		? Q("ring").IsAXT([ :Lowercase, :Latin, :String ])
		*/

		if CheckingParams()

			if not IsList(pxStr) 
				StzRaise("Incorrect param type! pacStr must be a list.")
			end

			if not StzIsTrue(@IsListOfStrings(pxStr))
				StzRaise("Incorrect param type! pacStr must be a list of strings.")
			end
		end

		# Checking those functions against the object value

		nLen = Len(pxStr)
		if nLen = 0
			return false
		end

		bResult = true

		# the DESCRIPTOR must test the TYPED value: stzNumber stores its
		# content as a STRING (big-number precision), so @@(Content())
		# rendered numbers as string literals and @isString(123) answered
		# 1 while @isNumber(123) answered 0 -- every type descriptor on
		# numbers was silently inverted (pre-existing, exposed by the Q3
		# disjunction tests)
		xIsaxt = this.Content()
		if this.StzType() = :stzNumber
			xIsaxt = this.NumericValue()
		end

		for i = 1 to nLen
			# the value is passed by name: printing it with @@ turned an object into its variable
			# name (@noname), which the eval then read as an uninitialized variable
			tCode = 'bResult = @is' + pxStr[i] + '(xIsaxt)'

			if not StzIsTrue(StzIsPlainIdentifier(pxStr[i]))  StzRaise("Can't proceed! '" + pxStr[i] + "' is not a plain name, and a name is all that is run here.")  end
			Eval(tCode)
			if not StzIsTrue(bResult)
				exit
			end
		end

		return bResult
	end
		#-- @FunctionluentForm

		def IsAXTQ(pxType)
			if @bNNLSkip = true
				@bNNLSkip = false
				return this
			end
			if @tNNLQuant != ""
				return this._NNLDistIsA(pxType)
			end
			if @bNNLNeither = true
				# under neither...nor a HOLDING predicate falsifies;
				# a failing one keeps the chain alive (mode persists
				# across the nor-continuation)
				if this.IsAXT(pxType)
					@bNNLNeither = false
					oFo = AFalseObjectXT(this)
					oFo.SetWhyStopped("no: the predicate held, but neither/nor required it false")
					return oFo
				end
				return this
			end
			if this.IsAXT(pxType)

				xContent = this.Content()
		
				if IsNumber(xContent)
					return this._NNLCarry(new stzNumber(xContent))
		
				elseif IsString(xContent)
					return this._NNLCarry(new stzString(xContent))
		
				elseif IsList(xContent)
					return this._NNLCarry(new stzList(xContent))
		
				elseif IsObject(xContent)
					return this._NNLCarry(new stzObject(xContent))
		
				end
			else
				return AFalseObjectXT(this)
			end
		end
		#-- @FunctionAlternativeForm

		def IsAnXT(pxStr)
			return this.IsAXT(pxStr)
		end
			def IsAnXTQ(pxStr)
				return this.IsAXTQ(pxStr)
			end
			def IsAnXTQRT(pxStr, pxReturnType)
				return this.IsAXTQRT(pxStr, pxReturnType)
			end
		# TRUE if the object is none of the kinds listed, with the list given as one value.
		#
		#   pacStr     the list of kind words to test, such as [ :Lowercase, :String ]
		#   returns    TRUE or FALSE
		#   see        IsA, IsNotAnXT
		#@ aka  -- @FunctionNegativeForm
		def IsNotAXT(pxStr)
			return not this.IsAXT(pxStr)
		end
			def IsNotAXTQ(pxStr)
				return not this.IsAXTQ(pxStr)
			end
			def IsNotAXTQRT(pxStr, pxReturnType)
				return not this.IsAXTQRT(pxStr, pxReturnType)
			end
		# TRUE if the object is none of the kinds listed, in the article form.
		#
		#   pacStr     the list of kind words to test
		#   returns    TRUE or FALSE
		#   see        IsNotAXT
		def IsNotAnXT(pxStr)
			return not this.IsAXT(pxStr)
		end
			def IsNotAnXTQ(pxStr)
				return not this.IsAXTQ(pxStr)
			end
			def IsNotAnXTQRT(pxStr, pxReturnType)
				return not this.IsAXTQRT(pxStr, pxReturnType)
			end
	# TRUE if the object is of the kind given, or of every kind in the list given.
	#
	#   pcType     a kind word such as :String or :Number, or a list of kind words that must all
	#              hold, such as [ :Lowercase, :Latin, :String ]
	#   returns    TRUE or FALSE
	#   note       Q("banana").IsA(:String) is TRUE, Q("Ring").IsA([ :Lowercase, :String ]) is FALSE
	#              and a bare stzObject is an :Object, whatever it wraps, and no other kind
	#   see        Is, IsEitherA, IsOneOfTheseTypes
	def IsA(pxType)
		/* Example

		? Q([ :name = "mio", :age = 12 ]).IsA(:HashList)
		--> 1

		? Q("ring").IsA([ :Lowercase, :Latin, :String ])

		*/

		if IsList(pxType)
			return this.IsAXT(pxType)
	
		else
			return this.IsAXT([ pxType ])
		end
	end
		#< @FunctionFluentForm

		def IsAQ(pxType)

			if @bNNLSkip = true
				@bNNLSkip = false
				return this
			end
			if @tNNLQuant != ""
				return this._NNLDistIsA(pxType)
			end
			if IsList(pxType)
				return this.IsAXTQ(pxType)
			end
			if @bNNLNeither = true
				if this.IsA(pxType)
					@bNNLNeither = false
					oFo = AFalseObjectXT(this)
					oFo.SetWhyStopped("no: the predicate held, but neither/nor required it false")
					return oFo
				end
				return this
			end

			if this.IsA(pxType)

				if pxType = "number" or pxType = "stznumber"
					return this._NNLCarry(this.ToStzNumber())

				elseif pxType = "string" or pxType = "stzstring"
					return this._NNLCarry(this.ToStzString())

				elseif pxType = "char" or pxType = "stzchar"
					return this._NNLCarry(this.ToStzChar())

				elseif pxType = "list" or pxType = "stzlist"
					return this._NNLCarry(this.ToStzList())

				elseif pctype = "object" or pxType = "stzobject"
					return this
				else
					# a NON-core descriptor that held (:Word, :Char,
					# :Email...): continue on the typed object, context
					# carried -- this is what lets the grammatical form
					# TheWordQ("ring").IsAQ(:Word).WhichQ().HasQ()...
					# run as written (it used to fall through and
					# return NOTHING)
					xContent = this.Content()
					if IsNumber(xContent)
						return this._NNLCarry(new stzNumber(xContent))
					elseif IsString(xContent)
						return this._NNLCarry(new stzString(xContent))
					elseif IsList(xContent)
						return this._NNLCarry(new stzList(xContent))
					end
					return this
				end

			else
				return AFalseObjectXT(this)
			end
		end





		#>

		#< @FunctionAlternativeForms

		def IsAn(pxType)
			return this.IsA(pxType)
		end
			def IsAnQ(pxType)
				return this.IsAQ(pxType)
			end




		#--

		def AreA(pxType)
			return this.IsA(pxType)
		end
			def AreAQ(pxType)
				return this.IsAQ(pxType)
			end




		#--

		def AreAn(pxType)
			return this.IsA(pxType)
		end
			def AreAnQ(pxType)
				return this.IsAQ(pxType)
			end




		#--

		def IsThe(pxType)
			return this.IsA(pxType)
		end
			def IsTheQ(pxType)
				return this.IsAQ(pxType)
			end




		#--

		def AreThe(pxType)
			return this.IsA(pxType)
		end
			def AreTheQ(pxType)
				return this.IsAQ(pxType)
			end




	# TRUE if the object is of the kind given, comparing the Softanza class name first and then the kinds IsA knows.
	#
	#   pcType     a kind word with or without the stz prefix, such as :StzString or :String
	#   returns    TRUE or FALSE
	#   see        IsA, IsStzString
		#>
	def Is(pxType)
		# Is(:StzString) et al: match the StzType directly (with or
		# without the stz prefix), then fall back to IsA.
		if IsString(pxType)
			tWanted = Lower(pxType)
			if ring_left(tWanted, 1) = ":"
				tWanted = StzMidToEnd(tWanted, 2)
			end
			tIs = Lower(this.StzType())
			if tIs = tWanted return 1 end
			if tIs = "stz" + tWanted return 1 end
		end
		return this.IsA(pxType)
	end
		def IsQ(pxType)
			if this.Is(pxType)

				if pxType = "number" or pxType = "stznumber" or
				   pxType = "anumber" or pxType = "astznumber"
					return this.ToStzNumber()

				elseif pxType = "string" or pxType = "stzstring" or
				    pxType = "astring" or pxType = "astzstring"
					return this.ToStzString()

				elseif pxType = "char" or pxType = "stzchar" or
				    pxType = "achar" or pxType = "astzchar"
					return this.ToStzChar()

				elseif pxType = "list" or pxType = "stzlist" or
				    pxType = "alist" or pxType = "astzlist"
					return this.ToStzList()

				elseif tPctype = "object" or pxType = "stzobject" or
				    tPctype = "aobject" or pxType = "astzobject" or
				    pxType = "anobject"
					return this
				end
			else
				return AFalseObjectXT(this)
			end
		end




	# TRUE if every item of a list is of the plural kind given.
	#
	#   pcType     a plural kind word such as :Numbers or :Strings
	#   returns    TRUE or FALSE
	#   warning    FALSE for an object that is not a list; a plural nothing can judge raises an
	#              error saying so
	#   see        IsA, AreBothA
	def Are(pxType)

		/* Example

		? Q([ 10, 20, 30 ]).Are(:Numbers)

		--> 1
		*/
 
		if not this.IsAList()
			return false
		end

		if not ( @IsRingTypeInPlural(pxType) or @IsStzTypeInPlural(pxType) )
			StzRaise("Incorrect param type! pcType must be a Ring type or Softanza type in plural.")
		end

		tCode = 'bResult = This.IsListOf'+ pxType + '()'

		if not StzIsTrue(StzIsPlainIdentifier(pxType))  StzRaise("Can't proceed! '" + pxType + "' is not a plain name, and a name is all that is run here.")  end
		Eval(tCode)
		return StzIsTrue(bResult)
	end
		#< @FunctionAlternativeForms

		def AreQ(pxType)

			if this.Are(pxType)

				if pxType = "numbers" or pxType = "stznumbers"
					return this.ToStzListOfNumbers()

				elseif pxType = "strings" or pxType = "stzstrings"
					return this.ToStzListOfStrings()

				elseif pxType = "chars" or pxType = "stzchars"
					return this.ToStzListOfChars()

				elseif pxType = "lists" or pxType = "stzlists"
					return this.ToStzListOfLists()

				elseif pctype = "objects" or pxType = "stzobjects"
					return this.ToStzListOfObjects()
				end
			else
				return AFalseObjectXT(this)
			end
		end
			



		#>

		def AreAll(pxType)
			return this.Are(pxType)
		end
			def AreAllQ(pxType)
				return this.AreQ(pxType)
			end




	# TRUE if each of the two items the object holds is of the kind given.
	#
	#   pcType     a kind word such as :String or :Number, or a list of kind words that must all hold
	#   returns    TRUE or FALSE; a false object when the content is not a list of exactly two items
	#   note       Q([ "a", "b" ]).AreBothA(:String) is TRUE and AreBothA(:List) is FALSE, Q([ 1,
	#              "b" ]).AreBothA(:Number) is FALSE; the second item may be written :And = item
	#   see        AreTwo, IsA
	def AreBothA(pxType)

		if not (this.StzType() = "stzlist" and this.NumberOfItems() = 2)
			return AFalseObjectXT(this)
		end

		xItem1 = this.Content()[1]
		xItem2 = this.Content()[2]
		if IsList(xItem2) and StzIsTrue(IsAndNamedParamList(xItem2))

			xItem2 = xItem2[2]
		end

		if Q(xItem1).IsA(pxType) = 1 and Q(xItem2).IsA(pxType) = 1
			return 1
		else
			return 0
		end
	end
		#< @FunctionFluentForm

		def AreBothAQ(pxType)

			if not (this.StzType() = "stzlist" and this.NumberOfItems() = 2)
				return AFalseObjectXT(this)
			end
	
			xItem1 = this.Content()[1]
			xItem2 = this.Content()[2]
			if IsList(xItem2) and StzIsTrue(IsAndNamedParamList(xItem2))
	
				xItem2 = xItem2[2]
			end
	
			this.UpdateWith([ xItem1, xItem2 ])

			return this.AreQ(pxType)
		end

