		return StzAreEqualObjects(pxObjects)
	end
	func @AreEqualNamedObjects(pxObjects)
		return StzAreEqualObjects(pxObjects)
	end
	#>

func StzAreNamedObjects(pxObjects)
	if IsList(pxObjects) and IsListOfObjects(pxObjects)
		bResult = true

		nLen = Len(pxObjects)
		for i = 1 to nLen
			if not IsNamedObject(pxObjects[i])
				bResult = false
				exit
			end
		end

		return bResult
	else
		return false
	end
end
	#< @FunctionAlternativeForms

	func AreNamedObjects(pxObjects)
		return StzAreNamedObjects(pxObjects)
	end
	func @AreNamedObjects(pxObjects)
		return StzAreNamedObjects(pxObjects)
	end
	#>

func StzAreUnnamedObjects(pxObjects)
	return not StzAreNamedObjects(pxObjects)
end
	func AreUnnamedObjects(pxObjects)
		return StzAreUnnamedObjects(pxObjects)
	end
	func @AreUnnamedObjects(pxObjects)
		return StzAreUnnamedObjects(pxObjects)
	end
func StzObjectsNames(pxObjects)
	if CheckingParams()
		if not IsList(pxObjects)
			StzRaise("Incorrect param type! paObjects must be a list.")
		end
	end

	vtResult = []
	nLen = Len(pxObjects)

	for i = 1 to nLen
		if IsObject(pxObjects[i])
			vtResult + @@(pxObjects[i])
		end
	end

	return vtResult
end
	#< @FunctionAlternativeForms

	func ObjectsNames(pxObjects)
		return StzObjectsNames(pxObjects)
	end
