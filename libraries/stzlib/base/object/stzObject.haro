	  #--------------------------------------#
	 #  REPEATING THE OBJECT VALUE 3 TIMES  #
	#--------------------------------------#

	# Returns a list holding the content three times.
	#
	#   returns    a list of three copies
	#   note       Q(5).Repeat3Times() answers [ 5, 5, 5 ] and Q([ 1 ]).Repeat3Times() answers [ [ 1
	#              ], [ 1 ], [ 1 ] ]
	#   see        Repeat, RepeatInPair
	def Repeat3Times
		return this.RepeatNTimes(3)
	end
		#< @FunctionFluentForm

		def Repeat3TimesQ
			return Q(this.Repeat3Times())
		end
		#>

		#< @FunctionAlternativeForms

		def Reproduce3Times
			return this.Repeat3Times()
		end
			def Reproduce3TimesQ
				return this.Repeat3TimesQ()
			end
		def Copy3Times
			return this.Repeat3Times()
		end
			def Copy3TimesQ
				return this.Repeat3TimesQ()
			end
		#>

	def Repeated3Times
		return this.Repeat3Times()
	end
		#< @FunctionAlternativeForms

		def Reproduced3Times
			return this.Repeated3Times()
		end
		def Copied3Times
			return this.Repeated3Times()
		end
		#>

	  #-------------------------------------------------------------------#
	 #  REPEATING THE OBJECT VALUE IN A GIVEN CONTAINER OF A GIVEN SIZE  #
	#-------------------------------------------------------------------#

	def RepeatNTimesXT(pxSize, pxIn)
		return this.RepeatXT(pxIn, pxSize)
	end
		def RepeatedNTimesXT(pxSize, pxIn)
			return this.RepeatNTimesXT(pxSize, pxIn)
		end
	def RepeatXT(pxIn, pxSize)
		/* EXAMPLE
		o1 = new stzNumber(5)
		o1.RepeatXT( :InA = :List, :OfSize = 2 )
		#--> [ 5, 5 ]

		o1.RepeatXT( [ 3, :Times ], :InAList )

		*/

		# Resolving params

		# ~> Case: RepeatXT([ 3, :Times ], :InAList )
		if IsList(pxIn) and Len(pxIn) = 2 and
		   IsNumber(pxIn[1]) and IsString(pxIn[2]) and pxIn[2] = :Times

			pxSize = pxIn[1]

			if this.IsAString()

				pxIn = :String
				
			else
				pxIn = :List
			end
		end

		# ~> Case : RepeatXT( :NTimes = 3, :InAList )

		if IsList(pxIn) and Len(pxIn) = 2 and
		   IsString(pxIn[1]) and pxIn[1] = :NTimes and IsNumber(pxIn[2])

			nSizeTemp = pxSize
			pxSize = pxIn[2]
			pxIn = nSizeTemp

		end

		# ~> Case : RepeatXT(:In = :AList, :OfSize = 3)
		if IsList(pxIn) and
			( Q(pxIn).IsInNamedParam() or
			  Q(pxIn).IsInANamedParam() )

			pxIn = pxIn[2]
		end

		if not ( IsString(pxIn) and
				Q(pxIn).IsOneOfTheseCS([
					:String, :List, :Pair, :ListOfNumbers, :ListOfStrings,
					:ListOfLists, :ListOfPairs, :Grid, :Table, :StzTable,

					:AString, :AList, :APair, :AListOfNumbers, :AListOfStrings,
					:AListOfLists, :AListOfPairs, :AGrid, :ATable, :AStzTable,

					:InString, :InList, :InPair, :InListOfNumbers, :InListOfStrings,
					:InListOfLists, :InListOfPairs, :InGrid, :InTable, :InStzTable,

					:InAString, :InAList, :InAPair, :InAListOfNumbers, :InAListOfStrings,
					:InAListOfLists, :InAListOfPairs, :InAGrid, :InATable, :InAStzTable

				], 0) )

			StzRaise("Incorrect param! pIn must be a string representing one of" +
				 "these Softanza types: :String, :List, :Pair, :ListOfNumbers, :ListOfStrings, " +
				 ":ListOfLists, :ListOfPairs, :Grid, :Table, and :StzTable.")
		end

		if IsList(pxSize) and
			( Q(pxSize).IsOfSizeNamedParam() or
			  Q(pxSize).IsSizeNamedParam() )

			pxSize = pxSize[2]
		end

		if not ( IsNumber(pxSize) or (IsList(pxSize) and StzIsTrue(IsPairOfNumbers(pxSize))) )
			StzRaise("Incorrect param type! pnSize must be a number.")
		end

		# Doing the job

		# Only a real stzNumber repeats its numeric _value_; a stzString
		# holding "5" keeps the STRING "5" (the :ListOfNumbers /
		# :ListOfStrings kinds do the explicit coercion below).
		xValue = ""
		if this.StzType() = :stzNumber
			if this.IsInteger()
				xValue = this.NumericValue()
			else
				xValue = this.StringValue()
			end
		else
			xValue = this.Content()
		end

		if StzFindFirst(pxIn, [ :List, :InList, :AList, :InAList ]) > 0
	
			xResult = []
			for i = 1 to pxSize
				xResult + xValue
			end
			return xResult

		elseif StzFindFirst(pxIn, [ :Pair, :InPair, :APair, :InAPair ]) > 0

			xResult = []
			for i = 1 to 2
				xResult + xValue
			end
			return xResult

		elseif StzFindFirst(pxIn, [ :ListOfNumbers, :InListOfNumbers,
				:AListOfNumbers, :InAListOfNumbers ]) > 0

			xResult = []
			for i = 1 to pxSize
				xResult + Q(xValue).ToNumber()
			end
			return xResult

		elseif StzFindFirst(pxIn, [ :ListOfStrings, :InListOfStrings,
				:AListOfStrings, :InAListOfStrings ]) > 0

			xResult = []
			for i = 1 to pxSize
				xResult + Q(xValue).Stringified()
			end
			return xResult

		elseif StzFindFirst(pxIn, [ :ListOfLists, :InListOfLists,
				:AListOfLists, :InAListOfLists ]) > 0
	
			xResult = []
			for i = 1 to pxSize
				xResult + [ xValue ]
			end
			return xResult

		elseif StzFindFirst(pxIn, [ :ListOfPairs, :InListOfPairs,
				:AListOfPairs, :InAListOfNPairs ]) > 0
	
			xResult = []
			for i = 1 to pxSize
				xResult + [ xValue, xValue ]
			end
			return xResult

		elseif StzFindFirst(pxIn, [ :String, :InString, :AString, :InAString ]) > 0

			tResult = ""
			for i = 1 to pxSize
				tResult += xValue
			end
			return tResult

		elseif StzFindFirst(pxIn, [ :Grid, :InGrid, :AGrid, :InAGrid ]) > 0

			xResult = StzGridQ([ pxSize[1], pxSize[2] ])
					.ReplaceAllQ([:With, xValue])
					.Content()

			return xResult

		elseif StzFindFirst(pxIn, [ :Table, :InTable, :ATable, :InATable ]) > 0

			xResult = StzTableQ([ pxSize[1], pxSize[2] ]).FillQ(xValue).Content()
			return xResult

		elseif StzFindFirst(pxIn, [ :StzTable, :InStzTable, :InAStzTable ]) > 0

			oResult = StzTableQ([ pxSize[1], pxSize[2] ]).FillQ(xValue)
			return oResult

		else
			StzRaise("Unsupported type of container! Allowed containers you can repeat " +
				 "the _value_ in are: :List, :Pair, :ListOfLists, :ListOfPairs, :String, :Grid, :Table, and :StzTable.")
		end
	end
		#< @FunctionFluentForm

		def RepeatXTQ(pxIn, pxSize)
			if IsString(pxIn) and pxIn = :String
				return new stzString( this.RepeatXT(pxIn, pxSize) )

			else
				return new stzList( this.RepeatXT(pxIn, pxSize) )
			end
		end
		#>

