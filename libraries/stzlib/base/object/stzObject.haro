		#>

	   #------------------------------------------------------------#
	  #  FINDING LAST N OCCURRENCES OF A SUBSTRING/ITEM STARTING   #
	 #  AT A GIVEN POSITION -- EXTENDTED                          #
	#------------------------------------------------------------#

	def FindLastNOccurrencesSTCS(xN, pxStrOrItem, pxStartingAt, pxCaseSensitive)
		if CheckingParams()
			if IsList(pxStrOrItem) and
			   IsOneOfTheseNamedParamsList(pxStrOrItem, [ :Of, :OfSubString ])
	
				pxStrOrItem = pxStrOrItem[2]
			end
	
			if IsList(pxStartingAt) and IsStartingAtNamedParamList(pnstartingAt)
				pxStartingAt = pxStartingAt[2]
			end
		end

		viPos = this.SectionQ(pxStartingAt, :Last)
				.FindAllCS(pxStrOrItem, pxCaseSensitive)

		viResult = Q(viPos).LastNItemsQRT(xN, :stzListOfNumbers).AddedToEach(pxStartingAt-1)

		return viResult
	end
