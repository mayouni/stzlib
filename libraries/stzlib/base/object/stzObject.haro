	# Returns the content wrapped in a new stzChar.
	#
	#   returns    a stzChar
	#   see        ToStzString, ToStzNumber, ToStzList
	def ToStzChar
		return new stzChar(this.Content())
	end
	# Returns the content wrapped in a new stzString.
	#
	#   returns    a stzString
	#   warning    Q(12).ToStzString().Content() answers 12
	#   see        ToStzChar, ToStzNumber, ToStzList
	def ToStzString
		return new stzString(this.Content())
	end
	# Returns the content wrapped in a new stzNumber.
	#
	#   returns    a stzNumber
	#   warning    Q("12").ToStzNumber() works on a text of digits
	#   see        ToStzString, ToStzList
	def ToStzNumber
		return new stzNumber(this.Content())
	end
	# Returns the content wrapped in a new stzList.
	#
	#   returns    a stzList
	#   warning    a content that is not a list raises "Can't create the stzList object! paList must
	#              be a list."
	#   see        ToStzString, ToStzNumber
	def ToStzList
		return new stzList(this.Content())
	end
	   #=====================================================#
	  #   CHECKING IF OBJECT OCCURES BEFORE/AFTER A GIVEN   #
	 #   VALUE IN THE GIVEN STRING OR LIST                 #
	#=====================================================#

	def OccursCS(pxBeforeOrAfter, pxIn, pxCaseSensitive)

		/* EXAMPLE

		o1 = new stzString("ONE")

		? o1.Occurs( :Before = "TWO", :In = "***ONE***TWO***")	#--> TRUE
		? o1.Occurs( :After = "TWO", :In = "***ONE***TWO***")	#--> FALSE

		? o1.Occurs( :Before = "two", :In = [ "***", "ONE", "***", "TWO", "***" ])
		#--> TRUE
		? o1.Occurs( :After = "TWO", :In = [ "***", "ONE", "***", "TWO", "***" ])
		#--> FALSE

		*/
		tBeforeOrAfter = ""

		if IsList(pxBeforeOrAfter) and IsBeforeOrAfterNamedParamList(pxBeforeOrAfter)
			tTemp = pxBeforeOrAfter[1]

			pxBeforeOrAfter = pxBeforeOrAfter[2]
		end

		if IsList(pxIn) and IsInNamedParamList(pxIn)
			pxIn = pxIn[2]
		end

		if not ( IsString(pxIn) or IsList(pxIn) )
			StzRaise("Incorrect param type! pcIn must be a string or list.")
		end
	
		bCaseSensitive = CaseSensitive(pxCaseSensitive)

		if IsString(pxIn)
			oStr = new stzString(pxIn)
	
			nThis  = oStr.FindFirstCS( this.Content(), bCaseSensitive )
			nOther = oStr.FindFirstCS( pxBeforeOrAfter, bCaseSensitive )

		elseif IsList(pxIn)
			if StzIsTrue(@IsListOfStrings(pxIn))
				oListStr = new stzListOfstrings(pxIn)

				nThis  = oListStr.FindFirstCS( this.Content(), bCaseSensitive )
				nOther = oListStr.FindFirstCS( pxBeforeOrAfter, bCaseSensitive )
			else

				if bCaseSensitive = true
					oList = new stzList(pxIn)
	
					nThis  = oList.FindFirst( this.Content() )
					nOther = oList.FindFirst( pxBeforeOrAfter )
						
				else
					oList = new stzList(pxIn)
					oList.Lowercase()

					nThis  = oList.FindFirst( this.ContentQ().Lowercased() )
					nOther = oList.FindFirst( pxBeforeOrAfter )

				end
			end

		end

		bResult = false

		if tTemp = :After
			bResult = nThis > nOther

		elseif tTemp = :Before
			bResult = nThis < nOther
		end

		return bResult
	end
		#< @FunctionAlternativeForms

		def HappensCS(pxBeforeOrAfter, pxIn, pxCaseSensitive)
			return this.OccursCS(pxBeforeOrAfter, pxIn, pxCaseSensitive)
		end
		def ComesCS(pxBeforeOrAfter, pxIn, pxCaseSensitive)
			return this.OccursCS(pxBeforeOrAfter, pxIn, pxCaseSensitive)
		end
		#>


		#< @FunctionMisspelledForm

		def OccuresCS(pxBeforeOrAfter, pxIn, pxCaseSensitive)
			return this.OccursCS(pxBeforeOrAfter, pxIn, pxCaseSensitive)
		end
	# TRUE if the content comes before, or after, another value inside a text or a list.
	#
	#   pcBeforeOrAfter   the named pair :Before = value or :After = value
	#   pIn               the text or list to look in, or the named pair :In = text
	#   returns           TRUE or FALSE
	#   note              Q("ONE").Occurs(:Before = "TWO", :In = "***ONE***TWO***") is TRUE and with
	#                     :After it is FALSE; the same holds for a list of texts
	#   warning           the position must be given as a named pair: the positional form
	#                     Occurs(:After, "banana") raises R24 (uninitialized variable _ctemp_); a
	#                     place to look in that is neither a text nor a list raises "Incorrect param
	#                     type!"
	#   see               OccursBefore, OccursAfter, OccursBetween
		#>
	#@ aka  -- WITHOUT CASESENSITIVTY
	def Occurs(pxBeforeOrAfter, pxIn)
		return this.OccursCS(pxBeforeOrAfter, pxIn, 1)
	end
		#< @FunctionAlternativeForms

		def Happens(pxBeforeOrAfter, pxIn)
			return this.Occurs(pxBeforeOrAfter, pxIn)
		end
		def Comes(pxBeforeOrAfter, pxIn)
			return this.Occurs(pxBeforeOrAfter, pxIn)
		end
		#>

		#< @FunctionMisspelledForm

		def Occures(pxBeforeOrAfter, pxIn)
			return this.Occurs(pxBeforeOrAfter, pxIn)
		end
