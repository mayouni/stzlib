func StzPluralOfRingType(tType)
	if CheckingParams()
		if not IsString(tPlural)
			StzRaise("Incorrect param type! cPlural must be a string.")
		end
	end

	if not IsRingType(tType)
		StzRaise("Incorrect param! cType is not a valid Ring type.")
	end

	tType = StzLower(tType)
	vtRingTypesXT = RingTypesXT()
	nLen = Len(vtRingTypesXT)

	tResult = ""
	for i = 1 to nLen
		if vtRingTypesXT[i][1] = tType
			tResult = vtRingTypesXT[i][2]
			exit
		end
	end

	if tResult = ""
		StzRaise("Can't get a plural of a Ring type form string!")
	else
		return tResult
	end
end
	func PluralOfRingType(tType)
		return StzPluralOfRingType(tType)
	end
func StzRingTypesPlurals
	vtResult = []
	xRingTypesXT = RingTypesXT()
	nLen = Len(xRingTypesXT)

	for i = 1 to nLen
		vtResult + xRingTypesXT[i][2]
	end

	return vtResult
end
	func RingTypesPlurals
		return StzRingTypesPlurals()
	end
	func PluralsOfRingTypes
		return StzRingTypesPlurals()
	end
func StzIsPluralOfRingType(tPlural)
	if CheckingParams()
		if not IsString(tPlural)
			StzRaise("Incorrect param type! cPlural must be a string.")
		end
	end

	tPlural = StzLower(tPlural)
	vtRingTypesPlurals = RingTypesPlurals()

	if ring_find(vtRingTypesPlurals, tPlural)
		return true
	else
		return false
	end
end
