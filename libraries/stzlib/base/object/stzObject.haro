	   #-----------------------------------------------#
	  #   CHECKING IF OBJECT OCCURES BEFORE A GIVEN   #
	 #   VALUE IN THE GIVEN STRING OR LIST           #
	#-----------------------------------------------#

	def OccursBeforeCS( pxSubStr, pxIn, pxCaseSensitive )
		return this.OccursCS( [:Before, pxSubStr], pxIn, pxCaseSensitive)
	end
	# TRUE if the content first appears before another value inside a text or a list.
	#
	#   pcSubStr   the value that must come later
	#   pIn        the text or list to look in
	#   returns    TRUE or FALSE
	#   note       Q("b").OccursBefore("a", "banana") is TRUE and Q("n").OccursBefore("b", "banana")
	#              is FALSE
	#   see        Occurs, OccursAfter, OccursBetween
	#@ aka  -- WITHOUT CASESENSITIVTY
	def OccursBefore(pxSubStr, pxIn)
		return this.OccursBeforeCS( pxSubStr, pxIn, 1 )
	end
	   #----------------------------------------------#
	  #   CHECKING IF OBJECT OCCURES ÙŽAFTER A GIVEN   #
	 #   VALUE IN THE GIVEN STRING OR LIST          #
	#----------------------------------------------#

	def OccursAfterCS( pxSubStr, pxIn, pxCaseSensitive )
		return this.OccursCS( [:After, pxSubStr], pxIn, pxCaseSensitive)
	end
	# TRUE if the content first appears after another value inside a text or a list.
	#
	#   pcSubStr   the value that must come earlier
	#   pIn        the text or list to look in
	#   returns    TRUE or FALSE
	#   note       Q("n").OccursAfter("b", "banana") is TRUE
	#   see        Occurs, OccursBefore, OccursBetween
	#@ aka  -- WITHOUT CASESENSITIVTY
	def OccursAfter(pxSubStr, pxIn)
		return this.OccursAfterCS( pxSubStr, pxIn, 1 )
	end
	   #---------------------------------------------------------#
	  #   CHECKING IF OBJECT OCCURES BETWEEN TWO GIVEN VALUES   #
	 #  IN THE GIVEN STRING OR LIST                            #
	#---------------------------------------------------------#

	def OccursBetweenCS( pxValue1, pxValue2, pxIn, pxCaseSensitive )

		if this.OccursCS( [:After, pxValue1], pxIn, pxCaseSensitive) and
		   this.OccursCS( [:Before, pxValue2], pxIn, pxCaseSensitive)

			return true
		else
			return false
		end
	end
	# TRUE if the content first appears between two other values inside a text or a list.
	#
	#   pValue1    the value that must come first
	#   pValue2    the value that must come last
	#   pIn        the text or list to look in
	#   returns    TRUE or FALSE
	#   note       Q("n").OccursBetween("b", "z", "bnza") is TRUE and with "bzna" it is FALSE; on a
	#              stzNumber the number is compared as text, so Q(2).OccursBetween(1, 3, [ 1, 2, 3
	#              ]) is FALSE
	#   see        OccursBefore, OccursAfter
	#@ aka  -- WITHOUT CASESENSITIVTY
	def OccursBetween( pxValue1, pxValue2, pxIn )
		return this.OccursBetweenCS( pxValue1, pxValue2, pxIn, 1 )
	end
	  #-------------------------------------------------------------------#
	 #   CHECKING IF OBJECT OCCURES N TIMES IN AN OTHER STRING OR LIST   #
	#-------------------------------------------------------------------#

	def OccursNTimesCS( xN, pxIn, pxCaseSensitive )

		if IsList(pxIn) and IsInNamedParamList(pxIn)
			pxIn = pxIn[2]
		end

		if not ( IsString(pxIn) or IsList(pxIn) )
			StzRaise("Incorrect param type! pcIn must be a string or list.")
		end
	
		bCaseSensitive = CaseSensitive(pxCaseSensitive)

		nOccurrence = 0

		if IsString(pxIn)
			oStr = new stzString(pxIn)
			nOccurrence  = oStr.NumberOfOccurrenceCS( this.Content(), bCaseSensitive )

		elseif IsList(pxIn)
			if StzIsTrue(@IsListOfStrings(pxIn))
				oListStr = new stzListOfstrings(pxIn)
				nOccurrence  = oListStr.NumberOfOccurrenceCS( this.Content(), bCaseSensitive )

			else
				if bCaseSensitive = true
					oList = new stzList(pxIn)
					nOccurrence  = oList.NumberOfOccurrence( this.Content() )
		
				else
					oList = new stzList(pxIn)
					oList.Lowercase()

					nThis  = oList.FindFirst( this.ContentQ().Lowercased() )
					nOccurrence  = oList.NumberOfOccurrence( this.Content() )
		
				end
			end

		end

		bResult = false

		if nOccurrence = xN
			bResult = true
		end

		return bResult
	end
	# TRUE if the content appears in a text or a list exactly n times.
	#
	#   _n_        the number of occurrences expected
	#   pIn        the text or list to look in, or the named pair :In = text
	#   returns    TRUE or FALSE
	#   note       Q("an").OccursNTimes(2, "banana") is TRUE and with 3 it is FALSE
	#   warning    on a stzNumber the number is compared as text and a list of numbers never
	#              matches: Q(2).OccursNTimes(2, [ 1, 2, 3, 2 ]) is FALSE
	#   see        OccursBefore, Occurs
	#@ aka  -- WITHOUT CASESENSITIVITY
	def OccursNTimes( xN, pxIn )
		return this.OccursNTimesCS( xN, pxIn, 1 )
	end
	   #----------------------------------------------------#
	  #  CHECKING IF STRING OCCURS FOR THE NTH TIME,       #
	 #  IN AN OTHER STRING OR LIST, AT A GIVEN POSITION   #
	#----------------------------------------------------#

	def OccursForTheNthTimeCS(xN, pxIn, pxAt, pxCaseSensitive)
		/* EXAMPLE

		? Q("*").OccursForTheNthTime( 1, :In = "a*b*c*d", :AtPosition = 2 )
		#--> TRUE

		? Q("*").OccursForTheNthTime( 3, :In = "a*b*c*d", :AtPosition = 6 )
		#--> TRUE

		*/

		if IsList(pxIn) and IsInNamedParamList(pxIn)
			pxIn = pxIn[2]
		end

		if not ( IsString(pxIn) or IsList(pxIn) )
			StzRaise("Incorrect param type! pcIn must be a string or list.")
		end

		if IsList(pxAt) and IsAtOrAtPositionNamedParamList(pxAt)
			pxAt = pxAt[2]
		end
	
		if not IsNumber(pxAt)
			StzRaise("Incorrect param type! pAt must be a number.")
		end

		bCaseSensitive = CaseSensitive(pxCaseSensitive)

		nNthOccurrence = 0

		# the value looked for: the content, read as a number when the object is a stzNumber
		# (its content is the digits as text)
		xNeedle = this.Content()
		if this.IsANumber()
			xNeedle = this.NumericValue()
		end

		if IsString(pxIn)
			if IsNumber(xNeedle)
				xNeedle = "" + xNeedle
			end
			if not IsString(xNeedle)
				return false
			end
			oStr = new stzString(pxIn)
			nNthOccurrence = oStr.FindNthCS( xN, xNeedle, bCaseSensitive )
	
		elseif IsList(pxIn)
			if StzIsTrue(@IsListOfStrings(pxIn))
				oListStr = new stzListOfstrings(pxIn)
				nNthOccurrence  = oListStr.FindNthOccurrenceCS( xN, xNeedle, bCaseSensitive )

			else
				if bCaseSensitive = true
					oList = new stzList(pxIn)
					nNthOccurrence  = oList.FindNthOccurrenceCS( xN, xNeedle, 1 )
		
				else
					oList = new stzList(pxIn)
					nNthOccurrence  = oList.FindNthOccurrenceCS( xN, xNeedle, 0 )
		
				end
			end

		end


		if nNthOccurrence = pxAt
			return true

		else
			return false
		end
	end
		#< @FunctionAlternativeForm

		def OccursForTheNthTimeAtCS(xN, pxIn, pxAt, pxCaseSensitive)
			return this.OccursForTheNthTimeCS(xN, pxIn, pxAt, pxCaseSensitive)
		end
	# TRUE if the content, found for the nth time in a text or a list, is found at the position given.
	#
	#   _n_        which occurrence is meant, counting from 1
	#   pIn        the text or list to look in, or the named pair :In = text
	#   pnAt       the position the occurrence must be at, or the named pair :At = position
	#   returns    TRUE or FALSE
	#   note       Q("*").OccursForTheNthTime(2, :In = "a*b*c*d", :AtPosition = 4) is TRUE and with
	#              :AtPosition = 2 it is FALSE; in a list of texts Q("b") finds its 2nd occurrence
	#              in [ "a", "b", "c", "b" ] at 4
	#   warning    a content that is a list or an object is never found in a text, and the answer
	#              is then FALSE; a text that is not found at all answers FALSE
	#   see        OccursForTheFirstTime, OccursForTheLastTime, OccursNTimes
		#>
	#@ aka  -- WITHOUT CASESENSITIVITY
	def OccursForTheNthTime(xN, pxIn, pxAt)
		return this.OccursForTheNthTimeCS(xN, pxIn, pxAt, 1)
	end
		#< @FunctionAlternativeForm

		def OccursForTheNthTimeAt(xN, pxIn, pxAt)
			return this.OccursForTheNthTime(xN, pxIn, pxAt)
		end
		#>

	   #----------------------------------------------------#
	  #  CHECKING IF STRING OCCURS FOR THE FIRST TIME,     #
	 #  IN AN OTHER STRING OR LIST, AT A GIVEN POSITION   #
	#----------------------------------------------------#

	def OccursForTheFirstTimeCS(pxIn, pxAt, pxCaseSensitive)
		return this.OccursForTheNthTimeCS(1, pxIn, pxAt, pxCaseSensitive)
	end
		def OccursForTheFirstTimeAtCS(pxIn, pxAt, pxCaseSensitive)
			return this.OccursForTheFirstTimeCS(pxIn, pxAt, pxCaseSensitive)
		end
	# TRUE if the content is found for the first time at the position given in a text or a list.
	#
	#   pIn        the text or list to look in, or the named pair :In = text
	#   pnAt       the position the first occurrence must be at, or the named pair :At = position
	#   returns    TRUE or FALSE
	#   note       Q("*").OccursForTheFirstTime(:In = "a*b*c*d", :At = 2) is TRUE and with :At = 4
	#              it is FALSE
	#   see        OccursForTheNthTime, OccursForTheLastTime
	#@ aka  -- WITHOUT CASESENSITIVITY
	def OccursForTheFirstTime(pxIn, pxAt)
		return this.OccursForTheFirstTimeCS(pxIn, pxAt, 1)
	end
		def OccursForTheFirstTimeAt(pxIn, pxAt)
			return this.OccursForTheFirstTime(pxIn, pxAt)
		end
	   #----------------------------------------------------#
	  #  CHECKING IF STRING OCCURS FOR THE LAST TIME,      #
	 #  IN AN OTHER STRING OR LIST, AT A GIVEN POSITION   #
	#----------------------------------------------------#

	def OccursForTheLastTimeCS(pxIn, pxAt, pxCaseSensitive)
		if IsList(pxIn) and IsInNamedParamList(pxIn)
			pxIn = pxIn[2]
		end

		# how many times the content occurs: the last one is the nth, and the position asked
		# for (pnAt) is then tested against that very occurrence
		xNeedle = this.Content()
		if this.IsANumber()
			xNeedle = this.NumericValue()
		end
		if IsString(pxIn) and IsNumber(xNeedle)
			xNeedle = "" + xNeedle
		end
		if IsString(pxIn) and not IsString(xNeedle)
			return false
		end

		nLast = Q(pxIn).NumberOfOccurrenceCS(xNeedle, pxCaseSensitive)
		if nLast = 0
			return false
		end

		return this.OccursForTheNthTimeCS(nLast, pxIn, pxAt, pxCaseSensitive)
	end
		def OccursForTheLastTimeAtCS(pxIn, pxAt, pxCaseSensitive)
			return this.OccursForTheLastTimeCS(pxIn, pxAt, pxCaseSensitive)
		end
	# TRUE if the content is found for the last time at the position given in a text or a list.
	#
	#   pIn        the text or list to look in, or the named pair :In = text
	#   pnAt       the position the last occurrence must be at, or the named pair :At = position
	#   returns    TRUE or FALSE
	#   note       Q("*").OccursForTheLastTime(:In = "a*b*c*d", :At = 6) is TRUE and with :At = 2 or
	#              :At = 4 it is FALSE; a content that does not occur at all answers FALSE
	#   see        OccursForTheNthTime, OccursForTheFirstTime
	#@ aka  -- WITHOUT CASESENSITIVITY
	def OccursForTheLastTime(pxIn, pxAt)
		return this.OccursForTheLastTimeCS(pxIn, pxAt, 1)
	end
		def OccursForTheLastTimeAt(pxIn, pxAt)
			return this.OccursForTheLastTime(pxIn, pxAt)
		end
	  #---------------------------------------------------------------#
	 #  GETTING THE SIZE OF THE OBJECT ~> THE SIZE OF ITS CONTENT()  #
	#---------------------------------------------------------------#

	# Returns the length of the content: its characters for a text, its items for a list, its digits for a number.
	#
	#   returns    a number; 0 for a bare stzObject, whose content is an object
	#   note       Q("banana").Size() is 6, Q([ 1, 2, 3 ]).Size() is 3 and Q(12345).Size() is 5
	#   see        SizeInBytes, ContentSize
	def Size
		xContent = this.Content()
		nResult = 0

		if IsNumber(xContent)
			nResult = StzNumberQ(xContent).Size()

		elseif IsString(xContent)
			nResult = Len(xContent)

		elseif IsList(xContent)
			nResult = Len(xContent)

		end

		return nResult
	end
	# Returns the memory taken by the object's attributes together, in bytes, on this machine's build.
	#
	#   returns    a number
	#   note       a bare stzObject holding a stzString measures 1968 bytes
	#   warning    a stzString has its own and answers the byte length of its text
	#   see        SizeInBytes32, SizeInBytes64, ContentSize
	def SizeInBytes
		vValues = []
		vtAttributes = ring_attributes(this)
		nLen = Len(vtAttributes)

		for i = 1 to nLen
			xValue = GetAttribute(this, vtAttributes[i])   # no eval: Haro runs no text as code
			vValues + xValue
		end

		return @MemorySizeInBytes(vValues)		

		return nResult
	end
		#< @FunctionAlternativeForms

		def HowManyBytes
			return this.SizeInBytes()
		end
		def CountBytes
			return this.SizeInBytes()
		end
		def NumberOfBytes
			return this.SizeInBytes()
		end
		#--

		def MemorySize
			return this.SizeInBytes()
		end
		def MSize
			return this.SizeInBytes()
		end
		def MemorySizeInBytes
			return this.SizeInBytes()
		end
		def MSizeInBytes
			return this.SizeInBytes()
		end
