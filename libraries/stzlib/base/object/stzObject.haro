	end
func StzAttributesXT(pxObj)
	if not IsObject(pxObj)
		StzRaise("Incorrect param type! pObj must be an object.")
	end

	xResult = []
	vtAttr = Attributes(pxObj)
	nLen = Len(vtAttr)

	for i = 1 to nLen
		xVal = GetAttribute(pxObj, vtAttr[i])   # no eval: Haro runs no text as code
		xResult + [ vtAttr[i], xVal ]
	end

	return xResult
end
	func AttributesXT(pxObj)
		return StzAttributesXT(pxObj)
	end
	func AttributesAndValues(pxObj)
		return StzAttributesXT(pxObj)
	end
	func AttributesAndTheirValues(pxObj)
		return StzAttributesXT(pxObj)
	end
	func @AttributesXT(pxObj)
		return StzAttributesXT(pxObj)
	end
	func @AttributesAndValues(pxObj)
		return StzAttributesXT(pxObj)
	end
	func @AttributesAndTheirValues(pxObj)
		return StzAttributesXT(pxObj)
	end
func StzHasAttribute(pxObject, tAttr)
	if StzIsTrue(CheckParams())
		if not IsObject(pxObject)
			StzRaise("Incorrect param type! pObject must be an object.")
		end

		if not IsString(tAttr)
			StzRaise("Incorrect param type! cAttr must be a string.")
		end
	end

	vtAttr = Attributes(pxObject)
	nPos = Find(vtAttr, StzLower(tAttr))
	if nPos > 0
		return true
	else
		return false
	end
end
	func HasAttribute(pxObject, tAttr)
		return StzHasAttribute(pxObject, tAttr)
	end
	func ContainsAttribute(pxObject, tAttr)
		return StzHasAttribute(pxObject, tAttr)
	end
	func @HasAttribute(pxObject, tAttr)
		return HasAttribute(pxObject, tAttr)
	end
	func @ContainsAttribute(pxObject, tAttr)
		return HasAttribute(pxObject, tAttr)
	end
