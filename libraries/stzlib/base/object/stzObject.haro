	  #==========================================#
	 #  CASTING THE OBJECT VALUE INTO A NUMBER  #
	#==========================================#

	# Returns the content as a number: a number as it is, a text read as a number.
	#
	#   returns    a number
	#   note       Q("12.5").ToNumber() answers 12.50
	#   warning    a text that is not a well formed number raises "Incorrect value!"; digit groups
	#              written with underscores such as "1_250" are refused too, although the code
	#              strips the underscores after checking; a list raises "Can't cast the object into
	#              a number."
	#   see        Numberified, ToStzNumber
	def ToNumber
		if this.IsANumber()
			return this.NumericValue()

		elseif this.IsAString()
			if this.IsNumberInString()
				tNumber = StzReplace(this.Content(), "_", "")
				return 0+ tNumber

			else
				StzRaise("Incorrect value! The string do not contain a well formed number.")
			end

		else
			StzRaise("Can't cast the object into a number.")
		end
	end
	# Returns the content as a number, or as a list of numbers when the content is a list of numbers and numeric texts.
	#
	#   returns    a number, or a list of numbers
	#   note       Q("12").Numberified() answers 12, a stzNumber holding 42 answers 42 and
	#              Q([ 1, "2", 3 ]).Numberified() answers [ 1, 2, 3 ]
	#   warning    a text that is not a number raises "Incorrect value!"; a list holding a
	#              non-numeric text raises R41; a bare stzObject raises "Objects can't be
	#              numberified."
	#   see        ToNumber
	def Numberified
		# Detect actual underlying content type rather than relying on
		# the IsA{Number,String,List} dispatch -- those return 0 in the
		# bare stzObject ancestor for subclasses (e.g. stzList) that
		# don't override them, which would route a real list value to
		# the catch-all "can't be numberified" error.

		# a stzNumber keeps its digits as a text: it is a number already, read as one
		if this.IsANumber()
			return this.NumericValue()
		end

		tNfContent = this.Content()

		if IsNumber(tNfContent)
			return tNfContent

		elseif IsString(tNfContent)
			if this.IsNumberInString()
				tNfNumber = StzReplace(tNfContent, "_", "")
				return 0+ tNfNumber

			else
				StzRaise("Incorrect value! The string do not contain a well formed number.")
			end

		elseif IsList(tNfContent)
			viNfResult = []
			nNfLen = Len(tNfContent)
			for i = 1 to nNfLen
				xNfItem = tNfContent[i]
				if IsNumber(xNfItem)
					viNfResult + xNfItem
				elseif IsString(xNfItem)
					viNfResult + (0+ StzReplace(xNfItem, "_", ""))
				else
					StzRaise("Incorrect value! List element is neither number nor numeric string.")
				end
			end
			return viNfResult

		else
			StzRaise("Incorrect param type! Objects can't be numberified.")
		end
	end
		# Aliases used by narrative tests. Numberify == Numberified
		# semantically (we're already returning a fresh value, not
		# mutating). NumberifyQ wraps in stzList for chains.
		def Numberify
			return this.Numberified()
		end
		def NumberifyQ
			return new stzList( this.Numberified() )
		end
		def NumberifiedQ
			return new stzList( this.Numberified() )
		end
		def Numbrify
			return this.Numberified()
		end
	  #------------------------------------------------------------------#
	 #  CASTING THE OBJECT VALUE INTO A NUMBER UNDER A GIVEN CONDITION  #
	#==================================================================#

	# The content as a W condition reads it: a number for a number (a stzNumber keeps its digits
	# as text), the content itself otherwise.
	#
	#   returns    the content, a number when the object holds one
	#   see        ToNumberW, IfQ
	def _ContentAsValue
		xContent = this.Content()
		if this.IsANumber() and IsString(xContent)
			return 0 + xContent
		end
		return xContent
	end
	# Computes a number from the content, by a W expression given as text or by a function.
	#
	#   pcCode     '{ @number = <expression> }' -- the expression's value for the whole content,
	#              named @list, @string or @number; or '{ @number += <expression> }' -- the sum of
	#              the expression over the chars of a text (@char, @i) or the items of a list
	#              (@item, @i); or a function of the content that returns a number
	#   returns    a number
	#   note       the expression is judged by the W engine and never run as code
	#   warning    an expression the W engine does not compute raises, naming the WF form
	#   example    ? Q([ "Me", "and", "You!" ]).ToNumberW('{ @number += len(@item) }')
	#              #--> 9
	def ToNumberW(pxCode)

		if IsList(pxCode) and IsUsingNamedParamList(pxCode)
			pxCode = pxCode[2]
		end

		if StzIsFunctionValue(pxCode)
			nResult = call pxCode(this._ContentAsValue())
			if not IsNumber(nResult)
				StzRaise("Incorrect type! The function must return a number.")
			end
			return nResult
		end

		if not IsString(pxCode)
			StzRaise("Incorrect param type! pcCode must be a string or a function.")
		end

		# RemoveThisBoundQ, which takes the bound. RemoveBoundsQ() takes NONE
		# -- it strips whatever bounds are there -- so passing it a quote was
		# R20 "extra number of parameters", and ToNumberW() raised on its
		# first line for every caller.
		tCode = Q(pxCode)
			.RemoveThisBoundQ('"')
			.RemoveThisFirstCharQ("{")
			.RemoveThisLastCharQ("}")
			.Trimmed()

		tLow = StzLower(tCode)
		tExpr = ""
		bSum = false
		xStarts = [ "@number +=", "@number+=", "@number =", "@number=" ]
		for i = 1 to 4
			if StzLeft(tLow, StzLen(xStarts[i])) = xStarts[i]
				tExpr = ring_trim(StzMid(tCode, StzLen(xStarts[i]) + 1, StzLen(tCode) - StzLen(xStarts[i])))
				bSum = (i <= 2)
				exit
			end
		end
		if tExpr = ""
			StzRaise("Syntax error! pcCode must start with '@number =' or '@number +='.")
		end

		# the content's own names are the engine's item
		tExpr = StzReplaceCS(tExpr, "@list", "@item", false)
		tExpr = StzReplaceCS(tExpr, "@string", "@item", false)
		tExpr = StzReplaceCS(tExpr, "@number", "@item", false)

		if not bSum or this.IsANumber()
			xItems = [ this._ContentAsValue() ]
		elseif this.IsAString()
			xItems = StzChars(this.Content())
		elseif this.IsAList()
			xItems = this.List()
		else
			StzRaise("Incorrect type! ToNumberW works on a number, a text or a list.")
		end

		if Len(xItems) = 0
			return 0
		end
		xValues = StzWValues(xItems, tExpr)
		nResult = 0
		nValues = Len(xValues)
		for i = 1 to nValues
			if not IsNumber(xValues[i])
				StzRaise("Incorrect type! @number must be a number.")
			end
			nResult += xValues[i]
		end
		return nResult
	end
		def ToNumberWQ(pxCode)
			return new stzNumber( this.ToNumberW(pxCode) )
		end
		def ToNumberXT(pxCode)
			return this.ToNumberW(pxCode)
		end
			def ToNumberXTQ(pxCode)
				return new stzNumber( this.ToNumberXT(pxCode) )
			end
