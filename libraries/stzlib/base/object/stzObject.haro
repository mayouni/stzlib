func StzIsPluralOfAStzType(tPlural)
	if CheckingParams()
		if not IsString(tPlural)
			StzRaise("Incorrect param! cPlural must be a string.")
		end
	end

	tPlural = StzLower(tPlural)
	vtPlurals = StzClassesPlurals()
	nLen = Len(vtPlurals)

	if Find(vtPlurals, tPlural) > 0
		return true
	else
		return false
	end
end
