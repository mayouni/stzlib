func StzIsTrue(xP)
	# A boolean is itself; a number is true when it is not 0 (a .ring predicate answers 1 or 0);
	# a text is true when it is not empty; any other value is true.
	if Type(xP) = "BOOLEAN"
		return xP
	end
	if IsNumber(xP)
		return xP != 0
	end
	if IsString(xP)
		return xP != ""
	end
	return true
end
	func IsTrue(xP)
		return StzIsTrue(xP)
	end
func StzIsFalse(xP)
	return not StzIsTrue(xP)
end
	func IsFalse(xP)
		return StzIsFalse(xP)
	end

# AN EMPTY CONFIGURATION MEANS "NOTHING MARKS THIS FALSE" -- so the answer is
# no, not an error.
#
# The three lists consulted below ($acSubStringsMakingAStringFalse,
# $aItemsMakingAListFalse, $aInnerItemsMakingAListFalse) all default to [],
# and ContainsOneOfTheseCS validates its needle list with IsListOfStrings,
# which deliberately REFUSES an empty list ("empty is NOT a list-of-strings",
# stzListFunc.ring). So the library's own defaults failed its own validator:
# out of the box, IsTrueXT raised "pacSubStr must be a list of strings" for
# every non-empty string and every non-empty list -- which is every input
# worth asking about. IsFalseXT delegates here, so it raised too.
#
# The guard goes HERE rather than in ContainsOneOfTheseCS: the empty-list
# refusal is that function's documented contract, and callers who really do
# pass [] by accident should still hear about it.

func StzNoneOfTheseConfigured(pxNeedles)
	return not (IsList(pxNeedles) and Len(pxNeedles) > 0)
end
func StzIsTrueXT(xP)
	if IsNumber(xP)
		return IsTrue(xP)

	elseif IsString(xP)

		# THE KNOB DECIDES, BOTH WAYS.
		#
		# This returned 0 when the flag was ON and otherwise fell through to
		# IsTrue(p) at the bottom -- which for "" is Ring's own truthiness,
		# and Ring says an empty string is false. So the answer was 0 either
		# way and SetEmptyStringIsConsideredFalse(0) looked like a setter that
		# did nothing: the getter changed, the behaviour did not.
		#
		# An empty string is the one case this flag exists to arbitrate, so it
		# is answered here outright rather than delegated to a function that
		# has already made up its mind.
		if xP = ""
			if EmptyStringConsideredFalse()
				return false
			else
				return true
			end
		end

		# Nested rather than chained with `and`: this must not depend on
		# Ring short-circuiting its operands, because the right-hand call
		# is exactly the one that raises on an empty list.
		vtSubs = SubStringsMakingAStringFalse()
		if not StzNoneOfTheseConfigured(vtSubs)
			if ContainsOneOfTheseCS(xP, vtSubs, false)
				return false
			end
		end

		return IsTrue(xP)

	elseif IsList(xP)
		if EmptyListIsConsideredFalse() and Len(xP) = 0
			return false
		end

		xItems = ItemsMakingAListFalse()
		if not StzNoneOfTheseConfigured(xItems)
			if ContainsOneOfTheseCS(xP, xItems, false)
				return false
			end
		end

		xInner = InnerItemsMakingAListFalse()
		if not StzNoneOfTheseConfigured(xInner)
			if DeepContainsCS(xP, xInner, 0)
				return false
			end
		end

		return IsTrue(xP)

	elseif IsObject(xP)
		# NOTE: these sentinel predicates take the object as a param --
		# calling them bare raised R19 (less params), making IsTrueXT/
		# IsFalseXT crash on every object. Pass p.
		if IsTrueObject(xP)
			return true

		elseif IsFalseObject(xP)
			return false

		elseif IsNullObject(xP)
			# inverted: when the null object is configured as FALSE,
			# IsTrue must be 0 (not 1).
			if NullObjectIsFalse()
				return false
			else
				return true
			end

		else
			if ObjectContentDefinesItsTruth()
				return IsTrue(xP.Content())
			else
				return false
			end
		end

	end
end
	func IsTrueXT(xP)
		return StzIsTrueXT(xP)
	end
func StzIsFalseXT(xP)
	return not StzIsTrueXT(xP)
end
	func IsFalseXT(xP)
		return StzIsFalseXT(xP)
	end
