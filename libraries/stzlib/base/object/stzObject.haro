func StzPluralToStzType(tPlural)
	if CheckingParams()
		if not IsString(tPlural)
			StzRaise("Incorrect param! cPlural must be a string.")
		end
	end

	tPlural = StzLower(tPlural)
	
	vtTypesXT = StzTypesXT()

	nLen = Len(vtTypesXT)

	tResult = ""

	for i = 1 to nLen
		if vtTypesXT[i][2] = tPlural
			tResult = vtTypesXT[i][1]
			exit
		end
	end

	if tResult = ""
		StzRaise("Not a plural of a stzType or can't find it!")
	end

	return tResult
end
