	  #---------------------------------#
	 #  TRACING OBJECT EXECUTION TIME  #
	#---------------------------------#

	# Returns the clock reading, in clocks, taken when time keeping was last started.
	#
	#   returns    a number
	#   warning    one global reading serves every object
	#   see        ExecutionTime
	def StartTime
		return $nStartTimeInClocks # A global variable
	end
		def StartingTime
			return this.StartTime()
		end
		def StartTimeInClocks
			return this.StartTime()
		end
		def StartingTimeInClocks
			return this.StartTime()
		end

	# Returns the seconds elapsed since time keeping was started.
	#
	#   returns    a number of seconds
	#   warning    raises "Can't proceed! Keeping object execution time must be turned ON." until
	#              SetKeepingTimeTo(1) is called, which also restarts the clock
	#   see        StartTime, AddTimeValue
	def ExecutionTime
		if not KeepingExecutionTime()
			StzRaise("Can't proceed! Keeping object execution time must be turned ON.")
		end

		nResult = ( Clock() - $nStartTimeInClocks ) / ClocksPerSecond()

		return nResult
	end
		#< @FunctionAlternativeForms

		def ExecTime
			return this.ExecutionTime()
		end
		def ElapsedTime
			return this.ExecutionTime()
		end
		#--

		def ObjectExecutionTime
			return this.ExecutionTime()
		end
		def ObjectExecTime
			return this.ExecutionTime()
		end
		def ObjectElpasedTime
			return this.ExecutionTime()
		end
		#==

		def ExecutionTimeInSeconds
			return this.ExecutionTime()
		end
		def ExecTimeInSeconds
			return this.ExecutionTime()
		end
		def ElapsedTimeInSeconds
			return this.ExecutionTime()
		end
		#--

		def ObjectExecutionTimeInSeconds
			return this.ExecutionTime()
		end
		def ObjectExecTimeInSeconds
			return this.ExecutionTime()
		end
		def ObjectElpasedTimeInSeconds
			return this.ExecutionTime()
		end
	# Appends the seconds elapsed since time keeping started to the list of times every object shares.
	#
	#   returns    nothing; read the list back with TimeValues
	#   warning    time keeping must be on (SetKeepingTimeTo(1)), otherwise it raises the refusal of
	#              ExecutionTime; one list serves the whole process, as the historic values do
	#   see        ExecutionTime, TimeValues
		#>
	def AddTimeValue
		$vStzObjectTimeValues + this.ExecutionTime()
	end
		# Appends the elapsed seconds to the shared list of times, in the longer wording.
		#
		#   returns    nothing
		#   see        AddTimeValue, TimeValues
		def AddExecutionTimeValue
			this.AddTimeValue()
		end
		# Appends the elapsed seconds to the shared list of times, in the shortest wording.
		#
		#   returns    nothing
		#   see        AddTimeValue, TimeValues
		def AddExecutionTime
			this.AddTimeValue()
		end
	# Returns the elapsed times kept by AddTimeValue, in the order they were added, and keeps them.
	#
	#   returns    a list of numbers of seconds; [ ] when none was added
	#   warning    one list serves the whole process: a time added on one object is read back from
	#              another
	#   see        AddTimeValue
	def TimeValues
		return $vStzObjectTimeValues
	end
	# TRUE if the content is one of the values in a list.
	#
	#   paList     the list to look in
	#   returns    TRUE or FALSE
	#   note       Q(12345).ExistsIn([ 12345, 5 ]) is TRUE and Q("banana").ExistsIn([ "banana" ]) is
	#              TRUE; on a bare stzObject holding an object it is FALSE even when that object is
	#              in the list
	#   see        IsOneOfThese
	def ExistsIn(pxList)
		return ListContains(pxList, this.Content())
	end
		def Inn(pxList)
			return this.ExistsIn(pxList)
		end

	  #================================================================#
	 #  NNL 2.0 -- THE NEAR-NATURAL LANGUAGE DEVICE LAYER (RENOVATED)  #
	#================================================================#
	# doc/design/NNL_REVIEW.md is the contract. Hand-written here: the
	# accountable mini-dispatcher, the expectation comparator, the grammar
	# particles that were missing, the COMPARATIVE determiners, the
	# CONDITIONAL MOOD, and ORDINAL REFERENCE. The noun surface
	# (VowelN / VowelNB / VowelsB / ...) is GENERATED from the semantic
	# lexicon between the <nnl-generated-surface> markers further down.

	# --- the accountable dynamic call (the seed of the P3 dispatcher):
	# exact method -> call; else resolve the stem through the ONE lexicon
	# (morphology included); else REFUSE with a suggestion. Silent
	# absorb-anything typo tolerance is gone by design.

	def _NNLCall(pxMethod, pxParams)
		tM = StzLower(ring_trim(pxMethod))
		if not StzFindFirst(tM, ring_methods(this))
			tId = StzResolveSemantic(tM)
			if tId = ""
				# MULTILINGUAL stems: the pack languages speak here too
				# ("majuscule" -> METHOD_UPPERCASE) -- same accountable
				# route, any registered language
				xLangs = StzNaturalLanguages()
				nLg = Len(xLangs)
				for iLg = 1 to nLg
					if xLangs[iLg] != "en"
						tId = StzResolveSemanticInLang(xLangs[iLg], tM)
						if tId != ""
							exit
						end
					end
				end
			end
			bGot = false
			if tId != ""
				nOps = ring_len($aSemanticOperations)
				for i = 1 to nOps
					if $aSemanticOperations[i][:semantic_id] = tId and
					   HasKey($aSemanticOperations[i], :stz_method)
						tCand = Lower($aSemanticOperations[i][:stz_method])
						if StzFindFirst(tCand, ring_methods(this)) > 0
							tM = tCand
							bGot = true
						end
						exit
					end
				end
			end
			if not bGot
				tSugg = StzSuggestWord("en", pxMethod)
				tMsg = "NNL: this " + this.StzType() + " does not understand '" + pxMethod + "'."
				if tSugg != ""
					tMsg += " Did you mean '" + tSugg + "'?"
				end
				StzRaise(tMsg)
			end
		end
		# the method is a name, checked; the parameters are passed BY NAME
		# (paParams[i]), never pasted into the code as source (Haro: no text
		# run as code, and a text parameter cannot end its own literal)
		if not StzIsTrue(StzIsPlainIdentifier(tM))  StzRaise("NNL: the method to call must be a plain name.")  end
		tCode = "xNNL = This." + tM + "("
		nP = ring_len(pxParams)
		for i = 1 to nP
			tCode += "pxParams[" + String(i) + "]"
			if i < nP
				tCode += ", "
			end
		end
		tCode += ")"
		Eval(tCode)
		return xNNL
	end
	# run one ACTION given naturally: :Uppercase, "remove duplicates",
	# or [ :Replace, "a", "b" ] -- the conditional mood's executor
	def _NNLDo(pxAction)
		if IsString(pxAction)
			return this._NNLCall(pxAction, [])
		elseif IsList(pxAction) and ring_len(pxAction) > 0 and IsString(pxAction[1])
			vPrm = []
			nA = ring_len(pxAction)
			for i = 2 to nA
				vPrm + pxAction[i]
			end
			return this._NNLCall(pxAction[1], vPrm)
		end
		StzRaise("NNL: an action must be a name or [ name, params... ].")
	end
	# Stores the main object of a natural chain, the one a later recall of the main object returns.
	#
	#   poObj      the object to remember as the main one
	#   returns    nothing
	#   note       read back with NNLMainRaw
	#   see        NNLMainRaw
	# --- P2: the chain-scoped context machinery -----------------------
	#@ aka  A determiner sets the expectation ON the object it returns; a device that returns a NEW object carries the context over (_NNLCarry); the *QM recalls read the chain-local main first. Globals stay mirrored so legacy code and the detached console surface keep working.
	def SetNNLMain(pxObj)
		@xNNLMain = pxObj
	end
	# Returns the main object stored by SetNNLMain.
	#
	#   returns    the stored object; 0 when none was stored
	#   see        SetNNLMain
	def NNLMainRaw
		return @xNNLMain
	end

	def _NNLSetExpect(pxVal, pxMode, pxTol)
		@xNNLExpect = pxVal
		@tNNLExpectMode = pxMode
		@nNNLExpectTol = pxTol
		# mirror the globals (SetLastValue resets the global mode, so the
		# mode is written AFTER it)
		SetLastValue(pxVal)
		$tStzExpectMode = pxMode
		$nStzExpectTol = pxTol
	end
	def _NNLExpectValue
		if @tNNLExpectMode != ""
			return @xNNLExpect
		end
		return LastValue()
	end
	def _NNLCarry(pxNew)
		if IsObject(pxNew)
			# LAZY subject stamping (no birth snapshot): the subject is
			# recorded at the moment of INTERRUPTION, from the live
			# object being left behind. A birth-time snapshot would
			# dangle once the original mutates (stz copies share the
			# engine handle -- see the aliasing doctrine).
			if IsObject(@xNNLMain)
				pxNew.SetNNLMain(@xNNLMain)
			else
				pxNew.SetNNLMain(this)
			end
			if @tNNLExpectMode != ""
				pxNew._NNLSetExpect(@xNNLExpect, @tNNLExpectMode, @nNNLExpectTol)
			end
		end
		return pxNew
	end
	# --- counting through a noun (guarded, accountable)

	def _NNLNounCount(pxMethod)
		if StzFindFirst(StzLower(pxMethod), ring_methods(this)) > 0
			if not StzIsTrue(StzIsPlainIdentifier(pxMethod))  StzRaise("Can't proceed! '" + pxMethod + "' is not a plain name, and a name is all that is run here.")  end
			Eval("nNNL = This." + StzLower(pxMethod) + "()")
			return nNNL
		end
		# SELECTIONAL ATTACHMENT (anaphora without markers): the current
		# object cannot answer this noun -- if the chain's SUBJECT can,
		# attach there, exactly as a listener resolves "...a length of 4
		# and only 1 vowel" (lengths have no vowels, so the vowel belongs
		# to the word). Deterministic order: nearest referent first (the
		# branch above), the subject second, refusal third.
		if IsObject(@xNNLMain)
			if StzFindFirst(StzLower(pxMethod), ring_methods(@xNNLMain)) > 0
				if not StzIsTrue(StzIsPlainIdentifier(pxMethod))  StzRaise("Can't proceed! '" + pxMethod + "' is not a plain name, and a name is all that is run here.")  end
				Eval("nNNL = @xNNLMain." + StzLower(pxMethod) + "()")
				return nNNL
			end
		end
		StzRaise("NNL: a " + this.StzType() + " cannot count '" +
			StzLower(pxMethod) + "' -- and neither can the chain subject.")
	end
	# --- the expectation comparator: compares an actual count to the
	# expectation register per the active COMPARATIVE MODE, and records
	# its explanation (WhyB) -- the ellipsis device, generalized

	def _NNLExpectCompare(nActual)
		xExp = LastValue()
		tMode = $tStzExpectMode
		nTolR = $nStzExpectTol
		if @tNNLExpectMode != ""
			xExp = @xNNLExpect
			tMode = @tNNLExpectMode
			nTolR = @nNNLExpectTol
		end
		bYes = false
		tExp = @@(xExp)
		if tMode = :Exactly
			bYes = ( nActual = xExp )
		elseif tMode = :AtLeast
			bYes = ( nActual >= xExp )
		elseif tMode = :AtMost
			bYes = ( nActual <= xExp )
		elseif tMode = :MoreThan
			bYes = ( nActual > xExp )
		elseif tMode = :LessThan
			bYes = ( nActual < xExp )
		elseif tMode = :About
			nTol = nTolR
			if nTol < 1
				nTol = xExp * nTol
			end
			bYes = ( nActual >= (xExp - nTol) and nActual <= (xExp + nTol) )
		elseif tMode = :Between
			bYes = ( nActual >= xExp[1] and nActual <= xExp[2] )
			tExp = "between " + xExp[1] + " and " + xExp[2]
		end
		tModeTxt = Lower("" + tMode)
		if bYes
			@tNNLWhy = "yes: expected " + tModeTxt + " " +
				tExp + ", found " + String(nActual)
			$tStzLastWhyB = @tNNLWhy
			return true
		end
		@tNNLWhy = "no: expected " + tModeTxt + " " +
			tExp + ", found " + String(nActual)
		$tStzLastWhyB = @tNNLWhy
		return false
	end
	# the IMMUTABLE form executor: act on a CLONE (QC), return the
	# clone chainable, the original untouched -- the ...QC suffix the
	# reflect layer already tags, generated below for every action
	def _NNLImmutable(pxMethod, pxParams)
		oQc = QC(this)
		oQc._NNLCall(pxMethod, pxParams)
		return oQc
	end
	def _NNLCountIs(pxMethod)
		if @bNNLSkip = true
			@bNNLSkip = false
			@tNNLWhy = "skipped: the disjunction was already satisfied"
			$tStzLastWhyB = @tNNLWhy
			return true
		end
		if @tNNLQuant != ""
			# distribute: every/any/no item's count must satisfy the
			# expectation ("each has at least 2 vowels")
			tQ = @tNNLQuant
			@tNNLQuant = ""
			xItems = this._NNLQuantItems()
			nQc = Len(xItems)
			for i = 1 to nQc
				bOk = ( this._NNLExpectCompare(
					Q(xItems[i])._NNLNounCount(pxMethod) ) = 1 )
				if tQ = "each" and not bOk
					@tNNLWhy = "no: item " + String(i) + " (" + @@(xItems[i]) +
						") fails -- " + @tNNLWhy
					$tStzLastWhyB = @tNNLWhy
					return false
				end
				if tQ = "any" and bOk
					@tNNLWhy = "yes: item " + String(i) + " satisfies -- " + @tNNLWhy
					$tStzLastWhyB = @tNNLWhy
					return true
				end
				if tQ = "none" and bOk
					@tNNLWhy = "no: item " + String(i) + " (" + @@(xItems[i]) +
						") satisfies, and none may"
					$tStzLastWhyB = @tNNLWhy
					return false
				end
			end
			if tQ = "any"
				@tNNLWhy = "no: no item satisfies the expectation"
				$tStzLastWhyB = @tNNLWhy
				return false
			end
			@tNNLWhy = "yes: " + tQ + " over " + String(nQc) + " items"
			$tStzLastWhyB = @tNNLWhy
			return true
		end
		return this._NNLExpectCompare(this._NNLNounCount(pxMethod))
	end
	# --- value agreement: the RESULT of a noun equals the remembered value
	def _NNLValueIs(pxMethod)
		xNNL = this._NNLCall(pxMethod, [])
		if Q(xNNL).IsEqualTo(this._NNLExpectValue())
			@tNNLWhy = "yes: " + StzLower(pxMethod) + " equals the expected value"
			$tStzLastWhyB = @tNNLWhy
			return true
		end
		@tNNLWhy = "no: " + StzLower(pxMethod) + " is " + @@(xNNL) +
			", expected " + @@(this._NNLExpectValue())
		$tStzLastWhyB = @tNNLWhy
		return false
	end
	# Returns, in words, why the last check made on this object failed.
	#
	#   returns    a text: the reason, "the last check did not fail", or "no check has been made on
	#              this object yet"
	#   note       Q("AnnIE").AtMost(2) then VowelNB() leaves: no: expected atmost 2, found 3
	#   warning    the reason lives on the object, so two chains never mix their reasons
	#   see        WhyStopped
	#@ aka  CHAIN-LOCAL explanations, in the stzChainOfValue naming grammar (WhyChainStopped / WhyCodeNotYetExecuted): Why + subject + past verb, always about something NOT proceeding; the reason lives ON the object -- never on a process global (two interleaved chains would lie to each other). Successes are not explained -- the archive never explained them either.
	def WhyCheckFailed
		if @tNNLWhy = ""
			return "no check has been made on this object yet"
		end
		if StzLeft(@tNNLWhy, 4) = "yes:"
			return "the last check did not fail"
		end
		return @tNNLWhy
	end
	# Returns the text that a live chain gives when asked why it stopped.
	#
	#   returns    the text "the chain is not stopped"
	#   warning    only a false object, which ends a chain, carries a real reason
	#   see        WhyCheckFailed
	def WhyStopped
		# a live object means the chain did NOT stop -- answer politely,
		# exactly like the archived "Chain is not stopped!"
		return "the chain is not stopped"
	end
	# Returns the object itself unchanged: the indefinite article 'an' of a natural chain, with no effect on the object.
	#
	#   returns    the object itself, so the chain goes on
	#   see        Only, Exactly, IfSo
	# --- grammar particles that were missing (pure pass-throughs)
	def AnQ
		return this
	end
	# Returns the object itself unchanged: the adverb 'also' of a natural chain, with no effect on the object.
	#
	#   returns    the object itself, so the chain goes on
	#   see        Only, Exactly, IfSo
	def AlsoQ
		return this
	end
	# Returns the object itself unchanged: a unit word such as :Letters that says what a count counts.
	#
	#   pUnit      the unit word, such as :Letters
	#   returns    the object itself, so the chain goes on
	#   see        Exactly, ALengthN
	def UnitQ(pxUnit)
		# unit annotation: ...ALengthQ().OfQ(4).UnitQ(:Letters) -- says
		# WHAT the 4 counts; semantically inert, linguistically load-
		# bearing. (A method named Q() would shadow the global Q() for
		# every child class -- the documented ring_len() trap -- hence UnitQ.)
		return this
	end
	# Returns the length of the content as a number, taken from whichever of characters, items or digits the object counts.
	#
	#   returns    a number
	#   note       Q("softanza").ALengthN() is 8, Q(12345).ALengthN() is 5 and Q([ "ab", "cd" ])
	#              .ALengthN() is 2, its items
	#   warning    a bare stzObject raises "NNL: a stzobject has no length to speak of."
	#   see        Exactly, TheNth
	# --- the article device, generic: "a length" of ANY object
	def ALengthN
		if IsList(this.Content()) and StzFindFirst("numberofitems", ring_methods(this)) > 0
			return this.NumberOfItems()
		elseif StzFindFirst("numberofchars", ring_methods(this)) > 0
			return this.NumberOfChars()
		elseif StzFindFirst("numberofitems", ring_methods(this)) > 0
			return this.NumberOfItems()
		elseif StzFindFirst("numberofdigits", ring_methods(this)) > 0
			return this.NumberOfDigits()
		end
		StzRaise("NNL: a " + this.StzType() + " has no length to speak of.")
	end
		def ALength
			return this.ALengthN()
		end
		def ALengthQ
			return this._NNLCarry(new stzNumber(this.ALengthN()))
		end
		# TRUE if the length of the content meets the expectation set before it, for example by Exactly.
		#
		#   returns    TRUE or FALSE
		#   warning    Q("softanza").Exactly(8).ALengthNB() is TRUE, with Exactly(5) it is FALSE and
		#              with no expectation it is FALSE
		#   see        ALengthN, Exactly
		def ALengthNB
			return this._NNLExpectCompare(this.ALengthN())
		end
	# Sets the expectation that the next counted noun equals a count exactly.
	#
	#   n          the count expected
	#   returns    the object itself
	#   note       Q("AnnIE").Exactly(3).VowelNB() answers TRUE
	#   see        Only, AtLeast, AtMost
	# --- COMPARATIVE DETERMINERS (new devices): degree words for the
	#@ aka  expectation register. Only() said "exactly"; language also says "at least", "at most", "more than", "about" (vagueness!), and "between". Each returns This (chain on) or MainObject (QM recall).
	def Exactly(xN)
		this._NNLSetExpect(xN, :Exactly, 0)
		return this
	end
		def ExactlyQ(xN)
			return this.Exactly(xN)
		end

	# Sets the expectation that the next counted noun reaches a count or goes beyond it.
	#
	#   n          the smallest count accepted
	#   returns    the object itself
	#   note       Q("AnnIE").AtLeast(2).VowelNB() answers TRUE
	#   see        AtMost, MoreThan, Exactly
	def AtLeast(xN)
		this._NNLSetExpect(xN, :AtLeast, 0)
		return this
	end
		def AtLeastQ(xN)
			return this.AtLeast(xN)
		end

	# Sets the expectation that the next counted noun stays at a count or below it.
	#
	#   n          the largest count accepted
	#   returns    the object itself
	#   note       when the check fails, Why() says: no: expected atmost 2, found 3
	#   see        AtLeast, LessThan, Exactly
	def AtMost(xN)
		this._NNLSetExpect(xN, :AtMost, 0)
		return this
	end
		def AtMostQ(xN)
			return this.AtMost(xN)
		end

	# Sets the expectation that the next counted noun goes strictly beyond a count.
	#
	#   n          the count that must be exceeded
	#   returns    the object itself
	#   note       'hello brave new world' MoreThan(2) words is TRUE, and 'hello brave' is FALSE
	#   see        AtLeast, LessThan
	def MoreThan(xN)
		this._NNLSetExpect(xN, :MoreThan, 0)
		return this
	end
		def MoreThanQ(xN)
			return this.MoreThan(xN)
		end

	# Sets the expectation that the next counted noun stays strictly under a count.
	#
	#   n          the count that must not be reached
	#   returns    the object itself
	#   note       'hello brave' LessThan(3) words is TRUE, and 'hello brave world' is FALSE
	#   see        AtMost, MoreThan
	def LessThan(xN)
		this._NNLSetExpect(xN, :LessThan, 0)
		return this
	end
		def LessThanQ(xN)
			return this.LessThan(xN)
		end

	# Sets the expectation that the next counted noun lies within ten percent of a count.
	#
	#   n          the count aimed at
	#   returns    the object itself
	#   note       9 items and 11 items are both about 10; 5 and 12 are not
	#   see        Exactly, BetweenN
	def About(xN)
		this._NNLSetExpect(xN, :About, 0.1)
		return this
	end
		def AboutQ(xN)
			return this.About(xN)
		end

		def AboutXT(xN, nTol)
			this._NNLSetExpect(xN, :About, nTol)
			return this
		end
	# Sets the expectation that the next counted noun lies between two counts.
	#
	#   n1         the lower count
	#   n2         the upper count
	#   returns    the object itself
	#   note       named BetweenN because stzString already owns Between
	#   warning    the explanation after a failed check reads 'expected between between 1 and 2,
	#              found 3', with the word doubled
	#   see        Exactly, About, AtLeast
	#@ aka  named BetweenN (not Between) -- stzString owns Between(sub1, sub2) for text extraction; the N marks the NUMBER expectation
	def BetweenN(xN1, xN2)
		this._NNLSetExpect([ xN1, xN2 ], :Between, 0)
		return this
	end
		def BetweenNQ(xN1, xN2)
			return this.BetweenN(xN1, xN2)
		end

	# Runs an action on the object when the premise of the chain held, and returns the object.
	#
	#   pAction    the action to run, such as :Uppercase
	#   returns    the object, after the action
	#   note       Q("ring").IsAQ(:String).IfSo(:Uppercase).Otherwise(:Reverse).Content() answers
	#              RING; after a false premise it is the Otherwise that runs
	#   see        Otherwise, IsAQ
	# --- CONDITIONAL MOOD (new device): the chain branches on its own
	#@ aka  truth. On a live object the premise held: IfSo RUNS, Otherwise skips. On a false premise (stzFalseObject) IfSo skips and Otherwise recovers the origin object and runs on it. Q("ring").IsAQ(:String).IfSo(:Uppercase).Otherwise(:Trim)
	def IfSo(pxAction)
		this._NNLDo(pxAction)
		return this
	end
		def IfSoQ(pxAction)
			return this.IfSo(pxAction)
		end
	# Returns the object itself; the action only runs when the premise before it failed.
	#
	#   pAction    the action to run on the false branch, such as :Reverse
	#   returns    the object itself
	#   note       on a live object it does nothing: Q("ab").Otherwise(:Uppercase) still holds ab
	#   see        IfSo
	def Otherwise(pxAction)
		return this
	end
		def OtherwiseQ(pxAction)
			return this
		end
	# Returns the object itself unchanged: the word 'both' of a natural chain, with no effect on the object.
	#
	#   returns    the object itself, so the chain goes on
	#   see        Only, Exactly, IfSo
	# --- Q3: NEGATION + TRUTH-FUNCTIONAL COORDINATION ------------------
	#@ aka  NotQ() flips the NEXT comparison ("has not at most 2 vowels"). EitherQ()/BothQ() are readable openers (pass-throughs). OrQ() on a LIVE object short-circuits: the disjunction is already satisfied, so the next disjunct is SKIPPED (one-shot flag honored by the device layer); on a FALSE premise OrQ() recovers the origin and the second disjunct gets its chance -- real disjunction, enabled by the carrie
	def BothQ
		return this
	end
	# RING SEMANTICS (author's rule, mutation-probed): numbers/strings
	# copy; lists and objects pass BY REFERENCE into functions, but the
	# `=` ASSIGNMENT (incl. attribute store) COPIES -- and a copied stz
	# object SHARES its engine handle, so the elder's view dangles after
	# the younger mutates. Therefore the chain's semantics belong to
	# Softanza's returning code alone: never alias stz objects with `=`
	# (use QC()/Copy()), and stored subjects are copies whose live
	# figure must be re-stamped when handed back:
	def _NNLSetFigure(pbNeither, pbEither, pbSat, pbSkip)
		@bNNLNeither = pbNeither
		@bNNLEither = pbEither
		@bNNLSat = pbSat
		@bNNLSkip = pbSkip
	end
	# "It IS EITHER a number or a string" -- the fused copula opens the
	# disjunctive figure: the FIRST disjunct may fail without falsifying
	def IsEitherQ
		@bNNLEither = true
		@bNNLSat = false
		return this
	end
	# Opens a 'neither ... nor' figure: every disjunct that follows must be false.
	#
	#   returns    the object itself, so the chain goes on
	#   see        NeitherQ, OrQ, NorQ
	#@ aka  "It IS NEITHER a number nor a list" -- every disjunct must be false; a holding predicate falsifies the chain
	def IsNeitherQ
		@bNNLNeither = true
		return this
	end
		# Opens a 'neither ... nor' figure, in the short wording.
		#
		#   returns    the object itself, so the chain goes on
		#   see        IsNeitherQ, NorQ
		def NeitherQ
			@bNNLNeither = true
			return this
		end
	# Closes the first branch of an either-or figure: it skips the next disjunct when one already held.
	#
	#   returns    the object itself, so the chain goes on
	#   see        IsNeitherQ, BothQ
	def OrQ
		if @bNNLEither = true
			# inside either...or: skip the next disjunct ONLY when one
			# already held; otherwise the next disjunct decides
			@bNNLEither = false
			if @bNNLSat = true
				@bNNLSkip = true
				@bNNLSat = false
			end
			return this
		end
		# outside the figure: a live object means the premise held --
		# the disjunction is satisfied, skip the next disjunct
		@bNNLSkip = true
		return this
	end
	# Returns the object itself unchanged: the conjunction 'nor' of a natural chain, with no effect on the object.
	#
	#   returns    the object itself, so the chain goes on
	#   see        Only, Exactly, IfSo
	def NorQ
		return this
	end
	# Opens a distributive check so that the next predicate must hold for every item.
	#
	#   returns    the object itself, so the chain goes on
	#   note       Q([ "AnnIE", "aeiou" ]).EachQ().AtLeast(2).VowelNB() is TRUE
	#   see        AnyQ, NoneQ
	# --- Q3b: DISTRIBUTIVE QUANTIFIERS ---------------------------------
	#@ aka  The quantifier opens a figure; the NEXT predicate applies to every item and the figure folds the answers: EACH demands all hold, ANY demands one, NONE demands zero. Singular agreement by design ("each IS a number", "none IS a number"); the collective plural lives in AreQ(:Numbers). The fold explains itself per item.
	def EachQ
		@tNNLQuant = "each"
		return this
	end
	# Opens a distributive check so that the next predicate must hold for at least one item.
	#
	#   returns    the object itself, so the chain goes on
	#   note       Q([ "sky", "AnnIE" ]).AnyQ().AtLeast(3).VowelNB() is TRUE
	#   see        EachQ, NoneQ
	def AnyQ
		@tNNLQuant = "any"
		return this
	end
	# Opens a distributive check so that the next predicate must hold for no item.
	#
	#   returns    the object itself, so the chain goes on
	#   note       Q([ "sky", "by" ]).NoneQ().AtLeast(1).VowelNB() is TRUE
	#   see        EachQ, AnyQ
	def NoneQ
		@tNNLQuant = "none"
		return this
	end
	# Opens a check that the next predicate holds for every item, in the wording that names the noun.
	#
	#   returns    the object itself, so the chain goes on
	#   see        EachQ, AnyItemQ
	#@ aka  the quantifier-NOUN units (author's formulations): "each item is", "any item is", "no item is" -- same figures, the noun spoken.
	def EachItemQ
		@tNNLQuant = "each"
		return this
	end
	# Opens a check that the next predicate holds for at least one item, in the wording that names the noun.
	#
	#   returns    the object itself, so the chain goes on
	#   see        AnyQ, EachItemQ
	def AnyItemQ
		@tNNLQuant = "any"
		return this
	end
	# Opens a check that the next predicate holds for no item, in the wording that names the noun.
	#
	#   returns    the object itself, so the chain goes on
	#   see        NoneQ, EachItemQ
	def NoItemQ
		@tNNLQuant = "none"
		return this
	end
	# Returns the object itself unchanged: the topic words 'all items' of a natural chain, with no effect; AreQ does the checking.
	#
	#   returns    the object itself, so the chain goes on
	#   see        Only, Exactly, IfSo
	#@ aka  "ALL ITEMS ARE numbers" -- the COLLECTIVE side: all takes plural agreement, so AllItemsQ is the topic particle and AreQ (the existing collective check) does the work, answering with the TYPED list. The distributive per-item story belongs to EACH.
	def AllItemsQ
		return this
	end
	# TRUE if the content satisfies every constraint declared for a kind, such as score.
	#
	#   pcKind     the name of a kind whose constraints were declared with ConstrainQ
	#   returns    TRUE or FALSE
	#   note       with score declared a positive even number, Q(42).QualifiesAs("score") is TRUE
	#              and Q(7) is FALSE with: no: 7 is not even (constraint 3 of 'score')
	#   warning    an unknown kind answers FALSE, never TRUE, and Why() says nothing is known about
	#              being it
	#   see        AddConstraint, VerifyConstraints
	# --- MODALITY gate: "the value QUALIFIES AS a score" -- validates
	#@ aka  the content against the kind's declared constraints; monadic (AsAQ was unavailable: the As-family owns it)
	def QualifiesAs(pxKind)
		tQk = StzLower(ring_trim(pxKind))
		xQc = ConstraintsOn(tQk)
		nQc = Len(xQc)
		if nQc = 0
			@tNNLWhy = "no: nothing is known about being a '" + tQk + "'"
			$tStzLastWhyB = @tNNLWhy
			return false
		end
		xQv = this.Content()
		if this.StzType() = :stzNumber
			xQv = this.NumericValue()
		end
		for i = 1 to nQc
			if not StzIsTrue(_StzKindHolds(xQv, xQc[i]))
				@tNNLWhy = "no: " + @@(xQv) + " is not " + xQc[i] +
					" (constraint " + String(i) + " of '" + tQk + "')"
				$tStzLastWhyB = @tNNLWhy
				return false
			end
		end
		@tNNLWhy = "yes: it qualifies as a '" + tQk + "'"
		$tStzLastWhyB = @tNNLWhy
		return true
	end
		def QualifiesAsQ(pxKind)
			if this.QualifiesAs(pxKind)
				return this
			end
			oFo = AFalseObjectXT(this)
			oFo.SetWhyStopped(@tNNLWhy)
			return oFo
		end
	# Declares a named rule that the content should satisfy, without enforcing it.
	#
	#   pcName     the rule's name, kept in lower case
	#   pRule      a kind word such as :Lowercase, or a condition as text such as '{ StzLen(@string)
	#              < 4 }'
	#   returns    nothing
	#   note       declaring is passive: the content can still change to a violating value
	#   warning    a name that is not a text, or is empty, raises "A constraint needs a name."; a
	#              second rule under the same name replaces the first
	#   see        EnforceConstraint, VerifyConstraint, Constraints
	# --- PER-OBJECT CONSTRAINTS (the archived stzString design, finally
	#@ aka  generalized -- the author's own TODO said "Generalize this feature to other classes"). A constraint is NAMED and its rule is either a DESCRIPTOR symbol (:Lowercase -- the @is<X> dispatch) or a CONDITION in the archived placeholder style: o.AddConstraint("stay-small", '{ len(@string) < 10 }') VerifyConstraint answers 1/0 with Why; ApplyConstraints ENFORCES: the archived structured raise ("Execution
	def AddConstraint(pxName, pxRule)
		if not IsString(pxName) or ring_trim(pxName) = ""
			StzRaise("A constraint needs a name.")
		end
		tCn = StzLower(ring_trim(pxName))
		nCn = Len(@xNNLConstraints)
		for i = 1 to nCn
			if @xNNLConstraints[i][1] = tCn
				@xNNLConstraints[i][2] = pxRule
				return
			end
		end
		@xNNLConstraints + [ tCn, pxRule ]
	end
		def AddConstraintQ(pxName, pxRule)
			this.AddConstraint(pxName, pxRule)
			return this
		end
	# Returns the rules declared on the object.
	#
	#   returns    a list of [ name, rule ] rows; a rule with a time scope has four items: [ name,
	#              rule, "while" or "until", condition ]
	#   note       Q("hello") after AddConstraint("lower", :Lowercase) answers [ [ "lower",
	#              "lowercase" ] ]
	#   see        AddConstraint, RemoveConstraint
	def Constraints
		return @xNNLConstraints
	end
	# Removes the rule declared under a name.
	#
	#   pcName     the name of the rule to remove
	#   returns    nothing
	#   warning    a name that is not declared changes nothing
	#   see        AddConstraint, Constraints
	def RemoveConstraint(pxName)
		tCn = StzLower(ring_trim(pxName))
		vKeep = []
		nCn = Len(@xNNLConstraints)
		for i = 1 to nCn
			if @xNNLConstraints[i][1] != tCn
				vKeep + @xNNLConstraints[i]
			end
		end
		@xNNLConstraints = vKeep
	end
	# does one rule hold against the TYPED content?
	def _NNLConstraintHolds(pxRule)
		xCh = this.Content()
		if this.StzType() = :stzNumber
			xCh = this.NumericValue()
		end
		return this._NNLRuleHoldsFor(pxRule, xCh)
	end
	# ...and against a CANDIDATE value -- the enforcement guard asks
	# about the FUTURE state, before it is applied
	def _NNLRuleHoldsFor(pxRule, pxValue)
		xCv = pxValue
		if IsString(pxRule) and StzFindFirst("{", pxRule) > 0
			# the archived placeholder style: @string/@number/@list/
			# @item/@object/@ all mean THE VALUE (longest name first)
			tCc = pxRule
			tCc = StzReplace(tCc, "{", " ")
			tCc = StzReplace(tCc, "}", " ")
			# all of them become the W engine's @item, which judges the
			# condition without running it
			tCc = StzReplaceCS(tCc, "@string", Char(1), false)
			tCc = StzReplaceCS(tCc, "@number", Char(1), false)
			tCc = StzReplaceCS(tCc, "@object", Char(1), false)
			tCc = StzReplaceCS(tCc, "@list", Char(1), false)
			tCc = StzReplaceCS(tCc, "@item", Char(1), false)
			tCc = StzReplace(tCc, "@", Char(1))
			tCc = StzReplace(tCc, Char(1), "@item")
			bCh = false
			try
				bCh = StzWHolds(xCv, tCc)
			catch
				StzRaise("Invalid constraint condition: " + pxRule)
			end
			return bCh
		end
		return StzIsTrue(_StzKindHolds(xCv, StzLower(ring_trim(String(pxRule)))))
	end
	# TRUE if the rule declared under a name holds for the content now.
	#
	#   pcName     the name of the rule to check
	#   returns    TRUE or FALSE
	#   note       for "hello" with lower declared the answer is TRUE and Why() says: yes:
	#              constraint 'lower' holds
	#   warning    an unknown name raises "Inexistant constraint!"; a rule whose while-condition is
	#              false, or whose until-condition was met, is not in force and counts as holding;
	#              Why() explains either answer
	#   see        VerifyConstraints, AddConstraint
	def VerifyConstraint(pxName)
		tCn = StzLower(ring_trim(pxName))
		nCn = Len(@xNNLConstraints)
		for i = 1 to nCn
			if @xNNLConstraints[i][1] = tCn
				if this._NNLTemporalState(i) = :Dormant
					@tNNLWhy = "yes: constraint '" + tCn +
						"' is not in force right now (its while-condition is false)"
					$tStzLastWhyB = @tNNLWhy
					return true
				end
				if this._NNLTemporalState(i) = :Expired
					@tNNLWhy = "yes: constraint '" + tCn +
						"' is no longer in force (its until-condition was met)"
					$tStzLastWhyB = @tNNLWhy
					return true
				end
				if this._NNLConstraintHolds(@xNNLConstraints[i][2])
					@tNNLWhy = "yes: constraint '" + tCn + "' holds"
					$tStzLastWhyB = @tNNLWhy
					return true
				end
				@tNNLWhy = "no: constraint '" + tCn + "' is violated by " +
					@@(this.Content())
				$tStzLastWhyB = @tNNLWhy
				return false
			end
		end
		StzRaise("Inexistant constraint! No constraint named '" + tCn +
			"' on this object.")
	end
	# TRUE if every rule declared on the object holds for the content now.
	#
	#   returns    TRUE or FALSE
	#   note       TRUE when no rule is declared; after a failure WhyCheckFailed() says which rule
	#              was violated and by what content
	#   see        VerifyConstraint, ApplyConstraints
	def VerifyConstraints
		nCn = Len(@xNNLConstraints)
		for i = 1 to nCn
			if not this._NNLConstraintHolds(@xNNLConstraints[i][2])
				@tNNLWhy = "no: constraint '" + @xNNLConstraints[i][1] +
					"' is violated by " + @@(this.Content())
				$tStzLastWhyB = @tNNLWhy
				return false
			end
		end
		@tNNLWhy = "yes: all " + String(nCn) + " constraints hold"
		$tStzLastWhyB = @tNNLWhy
		return true
	end
	# Returns the object when every declared rule holds, and stops the program with an explanation when one does not.
	#
	#   returns    the object itself
	#   warning    a violated rule raises an error with What, Why and Todo parts naming the rule and
	#              the content
	#   see        VerifyConstraints, EnforceConstraints
	#@ aka  ENFORCEMENT -- the archived semantics: execution is cancelled on a violation, with the structured explanation; chainable when clean
	def ApplyConstraints
		nCn = Len(@xNNLConstraints)
		for i = 1 to nCn
			if not this._NNLConstraintHolds(@xNNLConstraints[i][2])
				StzRaise([
					[:Where, "stzObject > ApplyConstraints()"],
					[:What, "Execution is cancelled by Softanza"],
					[:Why, "The constraint '" + @xNNLConstraints[i][1] +
						"' on this object is not verified by " +
						@@(this.Content())],
					[:Todo, "Check that constraint and adjust your logic accordingly ;)"]
				])
			end
		end
		return this
	end
		def ApplyConstraintsQ
			return this.ApplyConstraints()
		end
	# Declares a named rule and switches enforcement on, so that updates that would break any declared rule are refused.
	#
	#   pcName     the rule's name
	#   pRule      a kind word such as :Lowercase, or a condition as text such as '{ @number < 100
	#              }'
	#   returns    nothing
	#   note       RelaxConstraints switches it off again
	#   warning    the guard sits in the update point of stzString and stzNumber (seen on both):
	#              UpdateWith("hi") on an object holding HI under :Uppercase raises "Updating this
	#              object to ... would violate the enforced constraint" and the content stays HI
	#   see        AddConstraint, RelaxConstraints, EnforceConstraintWhile
	#@ aka  ENFORCEMENT-ON-UPDATE -- the archived dream, live: a constrained object REFUSES a violating update at the SINGLE UPDATE POINT (stzString/stzNumber Update(), stzList _SetContent()). EnforceConstraint() declares AND arms; RelaxConstraints() disarms (on-demand verification stays available). Most mutators compute their result THEN Update, so a refusal leaves the object untouched; the few in-place engi
	def EnforceConstraint(pxName, pxRule)
		this.AddConstraint(pxName, pxRule)
		@bNNLEnforce = true
	end
		def EnforceConstraintQ(pxName, pxRule)
			this.EnforceConstraint(pxName, pxRule)
			return this
		end
	# Declares a rule that is enforced only while a condition on the content holds.
	#
	#   pcName            the rule's name
	#   pRule             a kind word or a condition as text
	#   pWhileCondition   a condition as text, such as '{ StzLen(@string) < 6 }', under which the
	#                     rule is in force
	#   returns           nothing
	#   note              an object holding HI under :Uppercase refuses UpdateWith("hi") while it is
	#                     short
	#   see               EnforceConstraint, EnforceConstraintUntil
	#@ aka  TEMPORAL GUARDS -- natural obligation has SCOPE IN TIME: "stay uppercase WHILE it is short" -> in force only while the condition holds "stay positive UNTIL reaching 100" -> in force until the condition is met, then the constraint RETIRES itself The condition speaks the same rule language as constraints (a descriptor symbol or a '{ ... }' placeholder condition) and is checked against the CURRENT va
	def EnforceConstraintWhile(pxName, pxRule, pxWhileCondition)
		this._NNLAddTemporalConstraint(pxName, pxRule, "while", pxWhileCondition)
	end
		def EnforceConstraintWhileQ(pxName, pxRule, pxWhileCondition)
			this.EnforceConstraintWhile(pxName, pxRule, pxWhileCondition)
			return this
		end
	# Declares a rule that is enforced until a condition on the content is met, after which it retires.
	#
	#   pcName            the rule's name
	#   pRule             a kind word or a condition as text
	#   pUntilCondition   a condition as text, such as '{ @number >= 100 }', that ends the rule when
	#                     met
	#   returns           nothing
	#   note              a number holding 5 under :Positive refuses UpdateWith(-3) until it has
	#                     reached 100
	#   see               EnforceConstraint, EnforceConstraintWhile
	def EnforceConstraintUntil(pxName, pxRule, pxUntilCondition)
		this._NNLAddTemporalConstraint(pxName, pxRule, "until", pxUntilCondition)
	end
		def EnforceConstraintUntilQ(pxName, pxRule, pxUntilCondition)
			this.EnforceConstraintUntil(pxName, pxRule, pxUntilCondition)
			return this
		end
	def _NNLAddTemporalConstraint(pxName, pxRule, pxKind, pxCondition)
		if not IsString(pxName) or ring_trim(pxName) = ""
			StzRaise("A constraint needs a name.")
		end
		tCn = StzLower(ring_trim(pxName))
		nCn = Len(@xNNLConstraints)
		for i = 1 to nCn
			if @xNNLConstraints[i][1] = tCn
				@xNNLConstraints[i] = [ tCn, pxRule, pxKind, pxCondition ]
				@bNNLEnforce = true
				return
			end
		end
		@xNNLConstraints + [ tCn, pxRule, pxKind, pxCondition ]
		@bNNLEnforce = true
	end
	# The temporal state of constraint i: :Active (enforce), :Dormant
	# (while-condition false right now), :Expired (until-condition met --
	# retire). Plain 2-field constraints are always :Active.
	def _NNLTemporalState(xI)
		if Len(@xNNLConstraints[xI]) < 4
			return :Active
		end
		bCnd = this._NNLConstraintHolds(@xNNLConstraints[xI][4])
		if @xNNLConstraints[xI][3] = "while"
			if bCnd = true
				return :Active
			end
			return :Dormant
		end
		# "until": in force as long as the condition is NOT yet met
		if bCnd = true
			return :Expired
		end
		return :Active
	end
	# drop every :Expired temporal constraint (an until-condition was met)
	def _NNLRetireExpired
		vKeep = []
		nCn = Len(@xNNLConstraints)
		for i = 1 to nCn
			if this._NNLTemporalState(i) != :Expired
				vKeep + @xNNLConstraints[i]
			end
		end
		@xNNLConstraints = vKeep
	end
	# Switches enforcement on for the rules already declared.
	#
	#   returns    nothing
	#   warning    after it, UpdateWith("HELLO") on an object holding hello under :Lowercase raises
	#              and the content stays hello
	#   see        EnforceConstraint, RelaxConstraints, ConstraintsAreEnforced
	def EnforceConstraints
		@bNNLEnforce = true
	end
		def EnforceConstraintsQ
			this.EnforceConstraints()
			return this
		end
	# Switches enforcement off, keeping the rules declared.
	#
	#   returns    nothing
	#   warning    the rules stay, so VerifyConstraints still judges the content
	#   see        EnforceConstraints, VerifyConstraints
	def RelaxConstraints
		@bNNLEnforce = false
	end
		def RelaxConstraintsQ
			this.RelaxConstraints()
			return this
		end
	# TRUE if updates that break a declared rule are refused.
	#
	#   returns    1 or 0
	#   note       0 until EnforceConstraint or EnforceConstraints is called
	#   see        EnforceConstraints, RelaxConstraints
	def ConstraintsAreEnforced
		return @bNNLEnforce
	end
	# the guard the update points call BEFORE applying a new value
	def _NNLGuardUpdate(pxNewValue)
		if not @bNNLEnforce or Len(@xNNLConstraints) = 0
			return
		end
		this._NNLRetireExpired()
		nGc = Len(@xNNLConstraints)
		for iGc = 1 to nGc
			if this._NNLTemporalState(iGc) != :Active
				loop
			end
			if not this._NNLRuleHoldsFor(@xNNLConstraints[iGc][2], pxNewValue)
				StzRaise([
					[:Where, this.StzType() + " > Update()"],
					[:What, "Execution is cancelled by Softanza"],
					[:Why, "Updating this object to " + @@(pxNewValue) +
						" would violate the enforced constraint " + "'" +
						@xNNLConstraints[iGc][1] + "'"],
					[:Todo, "Fix the new value or relax the constraint (RelaxConstraints())"]
				])
			end
		end
	end
	# --- Q4: DISCOURSE TENSE over the QH history ----------------------
	# Open the chain with QH() and the object remembers its states; the
	# tense devices then answer about TIME, plain-form (they are data):
	#   WasEver(:Uppercase)   -- some state satisfied the descriptor
	#   WasNever(:Number)     -- no state ever did (the negative FORM)
	#   UsedToBe(:Lowercase)  -- held in the PAST, does not hold NOW
	#   IsStill(:Uppercase)   -- held before and still holds
	# Descriptors dispatch like IsAXT (@is<X> over the typed state).
	# The devices PEEK the stream (History() consumes; these do not).

	def _NNLPastStates
		# the QH stream is PROCESS-global (History() consumes it to end
		# a stream); a tense device must not read another chain's
		# leftovers -- the stream belongs to THIS object only if its
		# latest state IS this object's current content
		xTense = $vHisto
		nTe = Len(xTense)
		if nTe = 0
			return []
		end
		if not Q(xTense[nTe]).IsEqualTo(this.Content())
			return []
		end
		return xTense
	end
	def _NNLStateHolds(pxState, pxDesc)
		xTense = pxState
		if not StzIsTrue(StzIsPlainIdentifier(pxDesc))  StzRaise("Can't proceed! '" + pxDesc + "' is not a plain name, and a name is all that is run here.")  end
		Eval("bTh = @is" + pxDesc + "(xTense)")
		return StzIsTrue(bTh)
	end
	# TRUE if the object was in the state described at any moment of its recorded history, or is now.
	#
	#   pcDesc     the state to look for, as a kind word such as :Uppercase
	#   returns    TRUE or FALSE
	#   note       with QH("ring") then UppercaseQ(), WasEver(:Uppercase) is TRUE and Why() says:
	#              yes: state 2 ("RING") was uppercase
	#   warning    the history exists only for a chain opened with QH; without it the answer is
	#              FALSE and Why() says: no: no history was kept (open the chain with QH)
	#   see        WasNever, UsedToBe, IsStill
	def WasEver(pxDesc)
		xPast = this._NNLPastStates()
		nTe = Len(xPast)
		if nTe = 0
			@tNNLWhy = "no: no history was kept (open the chain with QH)"
			$tStzLastWhyB = @tNNLWhy
			return false
		end
		for i = 1 to nTe
			if this._NNLStateHolds(xPast[i], pxDesc)
				@tNNLWhy = "yes: state " + String(i) + " (" + @@(xPast[i]) +
					") was " + StzLower(pxDesc)
				$tStzLastWhyB = @tNNLWhy
				return true
			end
		end
		if this._NNLStateHolds(this.Content(), pxDesc)
			@tNNLWhy = "yes: it is " + StzLower(pxDesc) + " right now"
			$tStzLastWhyB = @tNNLWhy
			return true
		end
		@tNNLWhy = "no: none of the " + String(nTe) + " states was " + StzLower(pxDesc)
		$tStzLastWhyB = @tNNLWhy
		return false
	end
	# TRUE if the object was never in the state described, in its recorded history or now.
	#
	#   pcDesc     the state to look for, as a kind word such as :Number
	#   returns    TRUE or FALSE
	#   note       with QH("ring") then UppercaseQ(), WasNever(:Number) is TRUE and
	#              WasNever(:Uppercase) is FALSE
	#   warning    with no history kept it answers TRUE, since no past state is known to have held
	#              it
	#   see        WasEver, UsedToBe
	def WasNever(pxDesc)
		if this.WasEver(pxDesc)
			@tNNLWhy = "no: " + @tNNLWhy
			$tStzLastWhyB = @tNNLWhy
			return false
		end
		@tNNLWhy = "yes: " + StzLower("" + pxDesc) + " never held"
		$tStzLastWhyB = @tNNLWhy
		return true
	end
	# TRUE if the object was in the state described earlier but is not any more.
	#
	#   pcDesc     the state to look for, as a kind word such as :Lowercase
	#   returns    TRUE or FALSE
	#   note       with QH("ring") then UppercaseQ(), UsedToBe(:Lowercase) is TRUE
	#   warning    needs a chain opened with QH; without one the answer is FALSE
	#   see        WasEver, IsStill
	def UsedToBe(pxDesc)
		xPast = this._NNLPastStates()
		nTe = Len(xPast)
		if nTe = 0
			@tNNLWhy = "no: no history was kept (open the chain with QH)"
			$tStzLastWhyB = @tNNLWhy
			return false
		end
		bPast = false
		for i = 1 to nTe - 1
			if this._NNLStateHolds(xPast[i], pxDesc)
				bPast = true
				exit
			end
		end
		bNow = this._NNLStateHolds(this.Content(), pxDesc)
		if bPast and not bNow
			@tNNLWhy = "yes: it was " + StzLower(pxDesc) + " before, not anymore"
			$tStzLastWhyB = @tNNLWhy
			return true
		end
		if not bPast
			@tNNLWhy = "no: it never was " + StzLower(pxDesc) + " before now"
		else
			@tNNLWhy = "no: it is STILL " + StzLower(pxDesc)
		end
		$tStzLastWhyB = @tNNLWhy
		return false
	end
	# TRUE if the object was in the state described earlier and still is.
	#
	#   pcDesc     the state to look for, as a kind word such as :Uppercase
	#   returns    TRUE or FALSE
	#   note       with QH("ring") then UppercaseQ(), IsStill(:Uppercase) is TRUE and
	#              IsStill(:Lowercase) is FALSE
	#   warning    needs a chain opened with QH; without one the answer is FALSE
	#   see        UsedToBe, WasEver
	def IsStill(pxDesc)
		xPast = this._NNLPastStates()
		nTe = Len(xPast)
		if nTe = 0
			@tNNLWhy = "no: no history was kept (open the chain with QH)"
			$tStzLastWhyB = @tNNLWhy
			return false
		end
		bPast = false
		for i = 1 to nTe - 1
			if this._NNLStateHolds(xPast[i], pxDesc)
				bPast = true
				exit
			end
		end
		bNow = this._NNLStateHolds(this.Content(), pxDesc)
		if bPast and bNow
			@tNNLWhy = "yes: it was and still is " + StzLower(pxDesc)
			$tStzLastWhyB = @tNNLWhy
			return true
		end
		if not bPast
			@tNNLWhy = "no: it was not " + StzLower(pxDesc) + " before"
		else
			@tNNLWhy = "no: it stopped being " + StzLower(pxDesc)
		end
		$tStzLastWhyB = @tNNLWhy
		return false
	end
	# Returns the content wrapped in a new stzListOfNumbers, keeping the natural chain's state.
	#
	#   returns    a stzListOfNumbers
