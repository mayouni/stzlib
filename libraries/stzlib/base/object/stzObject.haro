	#NOTE: I'm not yet decided if this should be generalised. Think about it.

	def FindFirstNOccurrencesCS(xN, pxStrOrItem, pxCaseSensitive)

		viResult = this.FindFirstNOccurrencesSTCS(xN, pxStrOrItem, 1, pxCaseSensitive)
		return viResult
	end
