func StzSetEmptyStringIsConsideredFalse(pxTrueFalse)

	if StzIsTrue(CheckParams()) and IsString(pxTrueFalse)
		tLower = StzLower(pxTrueFalse)
		if tLower = "yes" or tLower = "on"
			pxTrueFalse = 1
		elseif tLower = "no" or tLower = "off"
			pxTrueFalse = 0
		else
			StzRaise("Incorrect param value! Possible values are 0, 1, 'yes', 'no', 'on', and 'off'.")

		end
	end

	if not (IsNumber(pxTrueFalse) and (pxTrueFalse = 1 or pxTrueFalse = 0) )
		StzRaise("Incorrect param type! pnTrueFalse must be a number equal to 1 or 0.")
	end

	$bEmptyStringIsConsideredFalse = pxTrueFalse
end
	func SetEmptyStringIsConsideredFalse(pxTrueFalse)
		StzSetEmptyStringIsConsideredFalse(pxTrueFalse)
	end
func StzSubStringsMakingAStringFalse
