func StzPluralToRingType(tPlural)
	if CheckingParams()
		if not IsString(tPlural)
			StzRaise("Incorrect param type! cPlural must be a string.")
		end
	end

	tPlural = StzLower(tPlural)
	vtRingTypesXT = RingTypesXT()
	nLen = Len(vtRingTypesXT)

	tResult = ""

	for i = 1 to nLen
		if vtRingTypesXT[i][2] = tPlural
			tResult = vtRingTypesXT[i][1]
			exit
		end
	end

	if tResult = ""
		StzRaise("Plural does not exist or can't be be found!")
	else
		return tResult
	end
end
	func PluralToRingType(tPlural)
		return StzPluralToRingType(tPlural)
	end
