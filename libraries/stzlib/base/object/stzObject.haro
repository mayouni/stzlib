	# Wraps the content in a new stzListOfObjects, a class that cannot be built from a list today.
	#
	#   returns    nothing: it raises
	#   warning    the cause is in stzListOfObjects, not here: its init calls IsListOfObjects on a
	#              stzList, a method that does not exist, so every list raises R14 (calling method
	#              without definition: islistofobjects), a list of objects included; a text or a
	#              number is refused with "Incorrect param type!"
	#   see        ToStzList, stzListOfObjects
	def ToStzListOfObjects
		return this._NNLCarry(new stzListOfObjects(this.Content()))
	end
	# the items a quantifier ranges over: a list's items, a string's chars
	def _NNLQuantItems
		xQi = this.Content()
		if IsList(xQi)
			return xQi
		end
		if IsString(xQi)
			return this.Chars()
		end
		StzRaise("NNL: '" + @tNNLQuant + "' needs a plural subject (a list or a string).")
	end
	# distribute a TYPE test (IsAQ symbol or IsAXT descriptor list)
	def _NNLDistIsA(pxType)
		tQ = @tNNLQuant
		@tNNLQuant = ""
		xItems = this._NNLQuantItems()
		nQi = Len(xItems)
		for i = 1 to nQi
			bHold = ( Q(xItems[i]).IsA(pxType) = 1 )
			if tQ = "each" and not bHold
				oFo = AFalseObjectXT(this)
				oFo.SetWhyStopped("no: item " + String(i) + " (" + @@(xItems[i]) +
					") does not hold, and each must")
				return oFo
			end
			if tQ = "any" and bHold
				@tNNLWhy = "yes: item " + String(i) + " holds"
				$tStzLastWhyB = @tNNLWhy
				return this
			end
			if tQ = "none" and bHold
				oFo = AFalseObjectXT(this)
				oFo.SetWhyStopped("no: item " + String(i) + " (" + @@(xItems[i]) +
					") holds, and none may")
				return oFo
			end
		end
		if tQ = "any"
			oFo = AFalseObjectXT(this)
			oFo.SetWhyStopped("no: no item holds, and any needs one")
			return oFo
		end
		@tNNLWhy = "yes: " + tQ + " over " + String(nQi) + " items holds"
		$tStzLastWhyB = @tNNLWhy
		return this
	end
	# --- the TYPE-NOUN predicates: "a number", "a string"... the words
	# the disjunctive figures coordinate ("is either A NUMBER or A
	# STRING"). Outside a figure they behave like IsAQ(type).

	def _NNLTypeNoun(pxType)
		if @bNNLSkip = true
			@bNNLSkip = false
			return this
		end
		if @tNNLQuant != ""
			return this._NNLDistIsA(pxType)
		end
		if @bNNLEither = true
			# first disjunct: record, never falsify
			if this.IsA(pxType)
				@bNNLSat = true
			end
			return this
		end
		if @bNNLNeither = true
			if this.IsA(pxType)
				@bNNLNeither = false
				oFo = AFalseObjectXT(this)
				oFo.SetWhyStopped("no: the predicate held, but neither/nor required it false")
				return oFo
			end
			return this
		end
		return this.IsAQ(pxType)
	end
