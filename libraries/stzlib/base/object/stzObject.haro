#TODO Abstract stzNamedObject into the MAX layer

func StzNamedObject(pxNamed)
	if CheckingParams()
		if not (IsList(pxNamed) and StzIsTrue(IsPairOfStringAndObject(pxNamed)))
			StzRaise("Incorrect param type! paNamed must be a pair of string and object.")
		end
	end

	oObject = Q(pxNamed[2])
	oObject.SetName(pxNamed[1])
	return oObject
end
	func StzNamedObjectQ(pxNamed)
		return StzNamedObject(pxNamed)
	end
	func StzNamedObjectXTQ(pxNamed)
		return StzNamedObject(pxNamed)
	end
func StzNamedObjectFrom(pxObjName)
