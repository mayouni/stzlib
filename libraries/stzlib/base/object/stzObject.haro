	   #--------------------------------------------------------#
	  #  FINDING FIRST N OCCURRENCES OF A SUBSTRING OR ITEM    #
	 #  STARTING AT A GIVEN POSITION -- EXTENDTED             #
	#--------------------------------------------------------#

	def FindFirstNOccurrencesSTCS(xN, pxStrOrItem, pxStartingAt, pxCaseSensitive)

		if IsList(pxStrOrItem) and
		   IsOneOfTheseNamedParamsList(pxStrOrItem, [ :Of, :OfSubString, :OfItem ])

			pxStrOrItem = pxStrOrItem[2]
		end

		if IsList(pxStartingAt) and IsStartingAtNamedParamList(pnstartingAt)
			pxStartingAt = pxStartingAt[2]
		end

		viPos = this.SectionQ(pxStartingAt, :Last)
				.FindAllCS(pxStrOrItem, pxCaseSensitive)

		viResult = []
		if Len(viPos) > 0
			viResult = Q(viPos).FirstNItemsQRT(xN, :stzListOfNumbers).AddedToEach(pxStartingAt-1)
		end

		return viResult
	end
