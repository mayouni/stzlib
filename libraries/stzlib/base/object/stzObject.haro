	# TRUE if the object is one of the values in a list.
	#
	#   paList     the list to look in
	#   returns    TRUE or FALSE
	#   note       Q("banana").IsOneOfThese([ "a", "banana" ]) is TRUE
	#   warning    on a bare stzObject it answers FALSE even when the object itself is in the list
	#   see        IsNotOneOfThese, ExistsIn
	def IsOneOfThese(pxList)
		return ListContains(pxList, this.Object())
	end
		# TRUE if the object is none of the values in a list.
		#
		#   paList     the list to look in
		#   returns    TRUE or FALSE
		#   see        IsOneOfThese
		def IsNotOneOfThese(pxList)
			return not this.IsOneOfThese(pxList)
		end
	# Returns the names of all the methods the object has, those of every ancestor included.
	#
	#   returns    a list of texts
	#   note       a stzString has over five thousand of them
	#   see        NumberOfMethods, Attributes
	def Methods
		return ring_methods(this)
	end
	# Returns how many methods the object has, those inherited included.
	#
	#   returns    a number
	#   see        Methods, CountMethods
	def NumberOfMethods
		return Len(ring_methods(this))
	end
		# Returns how many methods the object has, in the counting wording.
		#
		#   returns    a number
		#   see        NumberOfMethods, Methods
		def CountMethods
			return Len(ring_methods(this))
		end
		# Returns how many methods the object has, in the question wording.
		#
		#   returns    a number
		#   see        NumberOfMethods, Methods
		def HowManyMethods
			return Len(ring_methods(this))
		end
	# Returns the names of the object's attributes, in lower case.
	#
	#   returns    a list of texts, @xContent first
	#   note       a bare stzObject has 18 and a stzString 22
	#   see        NumberOfAttribytes, Methods, Values
	def Attributes
		return ring_attributes(this)
	end
	# Returns how many attributes the object has.
	#
	#   returns    a number
	#   warning    the name carries a misspelling (Attribytes), kept for compatibility
	#   see        Attributes, CountAttributes
	def NumberOfAttribytes
		return Len(ring_attributes(this))
	end
		# Returns how many attributes the object has, in the counting wording.
		#
		#   returns    a number
		#   see        Attributes, NumberOfAttribytes
		def CountAttributes
			return Len(ring_attributes(this))
		end
		# Returns how many attributes the object has, in the question wording.
		#
		#   returns    a number
		#   see        Attributes, NumberOfAttribytes
		def HowManyAttributes
			return Len(ring_attributes(this))
		end
	# Returns the text stzobject for every object, whatever its real class.
	#
	#   returns    the text stzobject
	#   warning    a stzString answers stzobject too: use classname(o) for the true class name, or
	#              StzType()
	#   see        StzType
	def ClassName
		return "stzobject"
	end
		def StzClassName
			return this.ClassName()
		end
		def StzClass
			return this.ClassName()
		end
	# TRUE if the object is a stzText, the library's text class, and not merely a stzString.
	#
	#   returns    TRUE or FALSE
	#   note       new stzText("hello").IsText() is TRUE; Q("banana").IsText() is FALSE, because a
	#              plain text is read as a stzString and no stzString is a stzText
	#   warning    this is not the question whether the content is a text: IsAString answers that
	#   see        IsAString
	def IsText
		if ring_classname(this) = "stztext"
			return true
		else
			return false
		end
	end
	# Returns a Ring pointer to the object itself, the one Ring's own object2pointer gives for it.
	#
	#   returns    a pointer, of the Ring type OBJECTPOINTER
	#   note       the pointer is to the stzString, stzList, stzNumber or stzObject being asked, not
	#              to the value it holds
	#   see        Copy
	def ToPointer
		return Object2Pointer(this)
	end

	# Returns a list holding the content two times.
	#
	#   returns    a list of two copies of the content
	#   note       Q([ 1, 2, 3 ]).Twice() answers [ [ 1, 2, 3 ], [ 1, 2, 3 ] ]
	#   see        RepeatInPair, Repeat
	def Twice
		xResult = [] + this.Content() + this.Content()
		return xResult
	end
		def TwiceQ
			return this
		end
	# Returns the object itself unchanged: the words 'the letter' of a natural chain, whatever letter is named.
	#
	#   c          the letter named
	#   returns    the object itself, so the chain goes on
	#   see        TheNth
	def TheLetterQ(xC)
		return this
	end
	# Returns the object when the condition, given as text, holds, and a false object when it does not.
	#
	#   pcCondition   a W condition as text, about the content as @item, such as "@item > 3" or
	#                 "1 = 1"; or a function of the content
	#   returns       the object itself, or a false object
	#   note          Q(5).IfQ("1 = 2") answers a stzFalseObject, so a chain goes on and says why it
	#                 stopped; the text is judged by the W engine, never run as code
	#   warning       a condition that is neither a text nor a function raises "Incorrect param type!"
	#   see           IfSo
	def IfQ(pxCondition)
		if StzIsFunctionValue(pxCondition)
			bOk = call pxCondition(this._ContentAsValue())
		elseif IsString(pxCondition)
			bOk = StzWHolds(this._ContentAsValue(), pxCondition)
		else
			StzRaise("Incorrect param type!")
		end

		if bOk
			return this
		else
			return AFalseObjectXT(this)
			# (before, nothing was returned and the chain ended with:
			#--> Error (R13) : Object is required) 
		end
	end
	# TRUE if the content is a list holding exactly one item.
	#
	#   returns    TRUE or FALSE
	#   warning    this version answers FALSE for a text, since a text is not a list; a stzList has
	#              its own and answers TRUE for [ 1 ]
	#   see        IsAList
	def IsSingle
		if this.IsAList() and this.Size() = 1
			return true
		else
			return false
		end
	end
	# Stores a value as the content of a bare stzObject, for SwapWith to exchange two of them.
	#
	#   pValue     the value to hold, an object
	#   returns    nothing
	#   see        SwapWith, Content
	def _SetBareContent(pxValue)
		@xContent = pxValue
	end
	# Exchanges the content of the object with that of another object of the same kind.
	#
	#   pOtherStzObject   the other object, which must be a stzObject
	#   returns           nothing
	#   note              between two stzString: Q("abc") and Q("xyz") hold xyz and abc afterwards;
	#                     between two bare stzObject the wrapped objects change places
	#   warning           a bare stzObject against a stzString raises R14 (the bare one has no
	#                     UpdateWith); a value that is not an object raises "Incorrect param
	#                     type!"; a stzNumber refuses a text with its own message
	#   see               SwapContentWith, UpdateWith
	#@ aka  Swapping the content of the stzObject with an other stzObject
	def SwapWith(pxOtherStzObject)

		if CheckingParams()

			if not @IsStzObject(pxOtherStzObject)
				StzRaise("Incorrect param type! pOtherStzObject must be a stzObject.")
			end
	
		end

		oThis = this.Content()
		oOther = pxOtherStzObject.Content()

		if ring_classname(this) = "stzobject" and ring_classname(pxOtherStzObject) = "stzobject"
			# a bare stzObject holds its value in @xContent and has no UpdateWith
			@xContent = oOther
			pxOtherStzObject._SetBareContent(oThis)

		else
			this.UpdateWith(oOther)
			pxOtherStzObject.UpdateWith(oThis)
		end
	end
		def SwapWithQ(pxOtherStzObject)
			this.SwapWith(pxOtherStzObject)
			return this
		end
		# Exchanges the content of the object with that of another object, in the longer wording.
		#
		#   pOtherStzObject   the other object, which must be a stzObject
		#   returns           nothing
		#   note              same as SwapWith
		#   see               SwapWith
		def SwapContentWith(pxOtherStzObject)
			this.SwapWith(pxOtherStzObject)
		end
			def SwapContentWithQ(pxOtherStzObject)
				return this.SwapWithQ(pxOtherStzObject)
			end
	# TRUE if the object is of neither of the two kinds named, judged through the Softanza class names.
	#
	#   pcType1    the first kind word, or the pair [ :Of = kind ]
	#   pcType2    the second kind word, or the pair [ :Nor = kind ]
	#   returns    TRUE or FALSE
	#   warning    Q("banana").@IsNeither(:Number, :List) is TRUE and (:Number, :String) is FALSE
	#   see        IsNeitherA
	def @IsNeither(pxType1, pxType2)
		if CheckingParams()
			if IsList(pxType1) and IsOfTypeNamedParamList(pxType1)
				pxType1 = pxType1[2]
			end

			if IsList(pxType2) and IsNorNamedParamList(pxType2)
				pxType2 = pxType2[2]
			end

			if not @BothAreStrings(pxType1, pxType2)
				StzRaise("Incorrect param type! pcType1 and pcType2 must both be strings.")
			end
		end

		#TODO // Add other Stz types

		bOfType1 = false
		bOfType2 = false

		if pxType1 = :String or pxType1 = :AString
			bOfType1 = this.IsStzString()

		elseif pxType1 = :Char or pxType1 = :AChar
			bOfType1 = this.IsStzChar()

		elseif pxType1 = :Number or pxType1 = :ANumber
			bOfType1 = this.IsStzNumber()

		elseif pxType1 = :List or pxType1 = :AList
			bOfType1 = this.IsStzList()

		elseif pxType1 = :Object or pxType1 = :AnObject
			bOfType1 = this.IsStzObject()
		end

		if pxType2 = :String or pxType2 = :AString
			bOfType2 = this.IsStzString()

		elseif pxType2 = :Char or pxType2 = :AChar
			bOfType2 = this.IsStzChar()

		elseif pxType2 = :Number or pxType2 = :ANumber
			bOfType2 = this.IsStzNumber()

		elseif pxType2 = :List or pxType2 = :AList
			bOfType2 = this.IsStzList()

		elseif pxType2 = :Object or pxType2 = :AnObject
			bOfType2 = this.IsStzObject()
		end

		if not bOfType1 and not bOfType2
			return true
		else
			return false
		end
	end
		def @IsNeitheOfType(pxType1, pxType2)
			return this.IsNeither(pxType1, pxType2)
		end
	# Runs an empty loop the number of times given.
	#
	#   _n_        how many times to loop
	#   returns    nothing
	#   warning    the loop body is empty: it does nothing but take time
	#   see        Repeat
	def LoopNTimes(xN)
		for @i = 1 to xN
			# Do nothing
		end
	end
		def LoopNTimesQ(xN)
			this.LoopNTimes(xN)
			return this
		end
