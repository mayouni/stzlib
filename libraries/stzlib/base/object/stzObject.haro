func StzAreEqualObjects(pxObjects)
	if not AreNamedObjects(pxObjects)
		StzRaise("Incorrect param type! paObjects must be a list of named objects.")
	end

	vtNames = ObjectsNames(pxObjects)
	if Len(U(vtNames)) = 1
		return true
	else
		return false
	end
end
