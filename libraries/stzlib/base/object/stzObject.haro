		#   returns    nothing: it raises
		#   warning    the M-suffixed methods were ruled out of the library (NNL_REVIEW, section 4c)
		#              and OfCSM went with them, so this call raises R14 (calling method without
		#              definition: ofcsm); use OfXTQ
		#   see        OfXT, OfXTQ
		def OfXTM(xN, tIgnored)
			return this.OfCSM(xN, 1)
		end

		def OfXTQ(xN, tIgnored)
			return this.OfCSQ(xN, 1)
		end


	# TRUE if the value given equals the last value remembered with SetLastValue, with a case dial.
	#
	#   _n_              the value to compare
	#   pCaseSensitive   1 to compare with case, 0 to ignore case
	#   returns          TRUE or FALSE
	#   note             after SetLastValue(8), Q(8).OfCSB(8, 1) is TRUE
	#   warning          with nothing remembered the answer is FALSE
	#   see              Of, OfCSBQ, OfBQ
	#@ aka  ==
	def OfCSB(xN, pxCaseSensitive)
		if Q(xN).IsEqualToCS(LastValue(), pxCaseSensitive)
			
			return true
		else
			return false
		end
	end



		def OfCSBQ(xN, pxCaseSensitive)
			if this.OfCSB(xN, pxCaseSensitive)
				return this
			else
				return AFalseObjectXT(this)
			end
		end



	# Raises R14, being a leftover of the retired M family: it forwards to a method that was removed.
	#
	#   _n_        the value to compare with
	#   returns    nothing: it raises
	#   warning    the M-suffixed methods were ruled out of the library (NNL_REVIEW, section 4c) and
	#              OfCSBM went with them, so this call raises R14 (calling method without
	#              definition: ofcsbm); its body also passes a pCaseSensitive it does not declare;
	#              use OfBQ, which keeps the object or answers a false object
	#   see        OfCSB, OfBQ
	def OfBM(xN)
		return this.OfCSBM(xN, pCaseSensitive)
	end

		# Raises R14, being a leftover of the retired M family: it forwards to a method that was removed.
		#
		#   _n_        the value to compare with
		#   returns    nothing: it raises
		#   warning    the M-suffixed methods were ruled out of the library (NNL_REVIEW, section 4c)
		#              and OfCSMB went with them, so this call raises R14 (calling method without
		#              definition: ofcsmb); use OfBQ
		#   see        OfCSB, OfBQ
		def OfMB(xN)
			return this.OfCSMB(xN, 1)
		end
		# Returns the object when the value given equals the last value remembered, and a false object otherwise.
		#
		#   _n_        the value to compare with the last value
		#   returns    the object itself, or a false object
		#   warning    after SetLastValue(8): Q(8).OfBQ(8) answers the stzNumber, Q(8).OfBQ(7) a
		#              stzFalseObject
		#   see        OfCSB, Of
		def OfBQ(xN)
			return this.OfCSBQ(xN, 1)
		end


	# TRUE if the value given equals the last value remembered, with a case dial and a filler word.
	#
	#   _n_              the value to compare with the last value
	#   cIgnored         a filler word that is not used
	#   pCaseSensitive   1 to compare with case, 0 to ignore case
	#   returns          TRUE or FALSE
	#   note             after SetLastValue("kiwi"), Q("x").OfXTCSB("KIWI", "to", 0) is TRUE and with
	#                    1 it is FALSE
	#   see              OfCSB
	#@ aka  ==
	def OfXTCSB(xN, tIgnored, pxCaseSensitive)
		return this.OfCSB(xN, pxCaseSensitive)
	end
		# Raises R14, being a leftover of the retired M family: it forwards to a method that was removed.
		#
		#   _n_              the value to compare with
		#   cIgnored         a filler word that is not used
		#   pCaseSensitive   1 to compare with case, 0 to ignore case
		#   returns          nothing: it raises
		#   warning          the M-suffixed methods were ruled out of the library (NNL_REVIEW, section
		#                    4c) and OfCSBM went with them, so this call raises R14 (calling method
		#                    without definition: ofcsbm); use OfXTCSBQ
		#   see              OfCSB, OfXTCSBQ
		def OfXTCSBM(xN, tIgnored, pxCaseSensitive)
			return this.OfCSBM(xN, pxCaseSensitive)
		end

		# Raises R14, being a leftover of the retired M family: it forwards to a method that was removed.
		#
		#   _n_              the value to compare with
		#   cIgnored         a filler word that is not used
		#   pCaseSensitive   1 to compare with case, 0 to ignore case
		#   returns          nothing: it raises
		#   warning          the M-suffixed methods were ruled out of the library (NNL_REVIEW, section
		#                    4c) and OfCSMB went with them, so this call raises R14 (calling method
		#                    without definition: ofcsmb); use OfXTCSBQ
		#   see              OfCSB, OfXTCSBQ
		def OfXTCSMB(xN, tIgnored, pxCaseSensitive)
			return this.OfCSMB(xN, pxCaseSensitive)
		end
		def OfXTCSBQ(xN, tIgnored, pxCaseSensitive)
			return this.OfCSBQ(xN, pxCaseSensitive)
		end


	# Raises R24, being a leftover of the retired M family whose body uses a name it never declares.
	#
	#   _n_        the value to compare with
	#   returns    nothing: it raises
	#   warning    the M-suffixed methods were ruled out of the library (NNL_REVIEW, section 4c);
	#              the body passes cIgnored, which this method does not declare, so the call raises
	#              R24 (uninitialized variable cignored); use OfXTBQ
	#   see        OfCSB, OfXTBQ
	def OfXTBM(xN)
		return this.OfXTCSB(xN, tIgnored, 1)
	end

		# Raises R19, being a leftover of the retired M family that calls a method with too few arguments.
		#
		#   _n_        the value to compare with
		#   returns    nothing: it raises
		#   warning    the M-suffixed methods were ruled out of the library (NNL_REVIEW, section 4c);
		#              it calls OfXTCSMB with two arguments and that method wants three, so the call
		#              raises R19; use OfXTBQ
		#   see        OfCSB, OfXTBQ
		def OfXTMB(xN)
			return this.OfXTCSMB(xN, 1)
		end
		# Returns the object when the last value remembered equals the one given, and a false object otherwise.
		#
		#   _n_        the value to compare with the last value
		#   returns    the object itself, or a false object
		#   note       after SetLastValue(8): Q(8).OfXTBQ(8) answers the stzNumber and Q(8).OfXTBQ(7)
		#              a stzFalseObject
		#   see        OfBQ, OfCSB
		def OfXTBQ(xN)
			return this.OfXTCSBQ(xN, "", 1)
		end


	# TRUE if the object is of the first kind or of the second kind.
	#
	#   pcType1    the first kind word, such as :Number
	#   pcType2    the second kind word, optionally written :Or = kind
	#   returns    TRUE or FALSE
	#   note       Q("banana") IsEitherA(:Number, :String) is TRUE and (:Number, :List) is FALSE
	#   warning    a value that is not a text raises "Incorrect param type!"
	#   see        IsNeitherA, IsA, IsEither
	#@ aka  ==
	def IsEitherA(pxType1, pxType2)
		if IsList(pxType2) and IsOrNamedParamList(pxType2)
			pxType2 = pxType2[2]
		end

		if not ( IsString(pxType1) and IsString(pxType2) )
			StzRaise("Incorrect param type! pcType1 and pcType2 must be strings.")
		end

		if this.IsA(pxType1) or this.IsA(pxType2)
			return true
		else
			return false
		end
	end

		#< @functionAlternativeForms

		def IsEitherAn(pxType1, pxType2)
			return this.IsEitherA(pxType1, pxType2)
		end
		def AreEitherA(pxType1, pxType2)
			return this.IsEitherA(pxType1, pxType2)
		end
		def AreEitherAn(pxType1, pxType2)
			return this.IsEitherA(pxType1, pxType2)
		end
		def AreBothEitherA(pxType1, pxType2)
			return this.IsEitherA(pxType1, pxType2)
		end
		def AreEitherBothAn(pxType1, pxType2)
			return this.IsEitherA(pxType1, pxType2)
		end
	# TRUE if the object is of neither of the two kinds.
	#
	#   pcType1    the first kind word
	#   pcType2    the second kind word, optionally written :Nor = kind
	#   returns    TRUE or FALSE
	#   note       Q("banana") IsNeitherA(:Number, :List) is TRUE
	#   warning    a value that is not a text raises "Incorrect param type!"
	#   see        IsEitherA, IsA
		#>
	def IsNeitherA(pxType1, pxType2)
		if IsList(pxType2) and IsNorNamedParamList(pxType2)
			pxType2 = pxType2[2]
		end

		if not ( IsString(pxType1) and IsString(pxType2) )
			StzRaise("Incorrect param type! pcType1 and pcType2 must be strings.")
		end

		if not this.IsA(pxType1) and
		   not this.IsA(pxType2)

			return true
		else
			return false
		end
	end
		#< @functionAlternativeForms

		def IsNeitherAn(pxType1, pxType2)
			return this.IsNeitherA(pxType1, pxType2)
		end
		def AreNeitherA(pxType1, pxType2)
			return this.IsNeitherA(pxType1, pxType2)
		end
		def AreNeitherAn(pxType1, pxType2)
			return this.IsNeitherA(pxType1, pxType2)
		end
		def AreBothNeitherA(pxType1, pxType2)
			return this.IsNeitherA(pxType1, pxType2)
		end
		def AreNeitherBothAn(pxType1, pxType2)
			return this.IsNeitherA(pxType1, pxType2)
		end
		#>

	  #-------------------------#
	 #  CHECKING OBJECT VALUE  #
	#-------------------------#

	# TRUE if the content equals the first value or the second value.
	#
	#   pValue1    the first value
	#   pValue2    the second value, optionally written :Or = value
	#   returns    TRUE or FALSE
	#   note       Q(12345) IsEither(12345, 2) is TRUE and Q("banana") IsEither("y", "x") is FALSE
	#   warning    strings, numbers and lists are compared by value, a list through its printed form
	#   see        IsEitherA, IsOneOfThese
	def IsEither(pxValue1, pxValue2)
		if IsList(pxValue2) and IsOrNamedParamList(pxValue2)
			pxValue2 = pxValue2[2]
		end

		if this.IsAString()
			if BothAreStrings(pxValue1, pxValue2) and
			   ( this.String() = pxValue1 or this.String() = pxValue2 )

				return true
			end

		elseif this.IsANumber()

			if BothAreNumbers(pxValue1, pxValue2) and
			   ( this.Number() = pxValue1 or this.Number() = pxValue2 )
				return true
			end

		elseif this.IsAList()
			# Content(), not ListQ() -- ListQ() answers a stzList OBJECT, and
			# comparing an object to a plain list is false however equal they
			# look. Ring's `=` on two LISTS is false as well, even for
			# identical ones, so the comparison goes through @@() which
			# renders both to the same text when they hold the same items.
			if IsList(pxValue1) and IsList(pxValue2)
				tMine = @@(this.Content())
				if tMine = @@(pxValue1) or tMine = @@(pxValue2)
					return true
				end
			end

		elseif this.IsAnObject() #TODO
			StzRaise("Feature not implemented yet!")
		end
	end
		#< @FunctionAlternativeForms

		def AreEither(pxValue1, pxValue2)
			return this.IsEither(pxValue1, pxValue2)
		end
		def BothAreEither(pxValue1, pxValue2)
			return this.IsEither(pxValue1, pxValue2)
		end
		def AreBothEither(pxValue1, pxValue2)
			return this.IsEither(pxValue1, pxValue2)
		end
	# TRUE if the value is an object of the library, as every instance of every class is.
	#
	#   returns    always TRUE
	#   see        IsAObject, IsAString
		#>
	#@ aka  --
	def IsAnObject
		return true
	end
		# TRUE if the value is an object of the library, in the spelling without n.
		#
		#   returns    always TRUE
		#   see        IsAnObject
		def IsAObject
			return true
		end
	# TRUE if the content is a number; a bare stzObject answers FALSE and stzNumber answers for itself.
	#
	#   returns    TRUE or FALSE
	#   warning    on a bare stzObject the answer is FALSE whatever it wraps
	#   see        IsAString, IsAList, IsAnObject
	def IsANumber
		return false
	end
	# TRUE if the content is a text; a bare stzObject answers FALSE and stzString answers for itself.
	#
	#   returns    TRUE or FALSE
	#   warning    on a bare stzObject the answer is FALSE whatever it wraps
	#   see        IsANumber, IsAList, IsAnObject
	def IsAString
		return false
	end
	# TRUE if the content is a list; a bare stzObject answers FALSE and stzList answers for itself.
	#
	#   returns    TRUE or FALSE
	#   warning    on a bare stzObject the answer is FALSE whatever it wraps
	#   see        IsAString, IsANumber, IsAnObject
	def IsAList
		return false
	end
	# TRUE if the content is a text that names a class of the library, whatever the case.
	#
	#   returns    TRUE or FALSE; FALSE when the content is not a text
	#   note       Q("stzList").IsStzType() is TRUE and Q("hello").IsStzType() is FALSE; the test is
	#              on the content, not on the class of the object itself
	#   see        StzType, HasSameStzTypeAs
	#@ aka  IsStzType: when Content() is a string, answer "is this string the name of a registered Softanza class?". Used by the return-type routing in stzNumber.MultiplesUntilQRT etc. -- the user passes :stzList / :stzListOfNumbers as the return type and the dispatch validates it via Q(name).IsStzType().
	def IsStzType
		tIstContent = this.Content()
		if not IsString(tIstContent)
			return false
		end
		tIstName = Lower(tIstContent)
		vtIstTypes = [
			"stzobject", "stznumber", "stzstring", "stzlist",
			"stzlistofnumbers", "stzlistofstrings", "stzlistofchars",
			"stzlistofbytes", "stzlistoflists", "stzlistofpairs",
			"stzlistofhashlists", "stzlistoftimelines",
			"stzlistofentities", "stzlist2d", "stzlistex",
			"stzhashlist", "stzpair", "stzpairofnumbers",
			"stzchar", "stzbyte", "stzdate", "stztime",
			"stzdatetime", "stzcalendar", "stzduration",
			"stztimeline", "stzcounter", "stzintseq",
			"stzregex", "stzhtml", "stzfile", "stzfolder",
			"stztable", "stztablex", "stzpivottable",
			"stzmatrex", "stzgrid", "stzgraph", "stzgraphquery",
			"stzgraphplanner", "stzknowledgegraph", "stzorgchart",
			"stzdiagram", "stztree", "stztext", "stzentity",
			"stzdataset", "stzdatawrangler", "stzcurrency",
			"stzlocale", "stzcountry", "stzuuid", "stzhexnumber",
			"stzbinarynumber", "stzoctalnumber"
		]
		if ring_find(vtIstTypes, tIstName) > 0
			return true
		end
		return false
	end
		# Alias: IsStzClassName -- same predicate, narrative-friendly
		# spelling used by stzNaturalCode.QRT and stzHashList.ItemsZ.
		def IsStzClassName
			return this.IsStzType()
		end
	  #======================================#
	 #  REPEATING THE OBJECT VALUE N TIMES  #
	#======================================#

	# Returns a list holding the content several times.
	#
	#   _n_        how many times, or the pair [ n, :Times ]
	#   returns    a list of the content repeated n times
	#   note       a stzString has its own Repeat; this one serves numbers and bare objects:
	#              Q(7).Repeat(2) answers [ 7, 7 ]
	#   see        Repeat3Times, RepeatInPair
	def Repeat(xN)

		if IsList(xN) and Len(xN) = 2 and
		   IsNumber(xN[1]) and IsString(xN[2]) and xN[2] = :Times
			xN = xN[1]
		end

		return this.RepeatXT(:InList, xN)
	end
		#< @FunctionFluentForm

		def RepeatQ(xN)
			return Q(this.Repeat(xN))
		end
		#>

		#< @FunctionAlternativeForms

		def RepeatNTimes(xN)
			return this.Repeat(xN)
		end
			def RepeatNTimesQ(xN)
				return this.RepeatQ(xN)
			end
		def Reproduce(xN)
			return this.Repeat(xN)
		end
			def ReproduceQ(xN)
				this.Reproduce(xN)
				return this
			end
		def ReproduceNTimes(xN)
			return this.Repeat(xN)
		end
			def ReproduceNTimesQ(xN)
				this.ReproduceNTimes(xN)
				return this
			end
		def CopyNTimes(xN)
			return this.Repeat(xN)
		end
			def CopyNTimesQ(xN)
				this.CopyNTimes(xN)
				return this
			end
		#>

	#--

	def Repeated(xN)
		return this.Repeat(xN)
	end
		#< @FunctionAlternativeForms

		def RepeatedNTimes(xN)
			return this.Repeated(xN)
		end
		def Reproduced(xN)
			return this.Repeated(xN)
		end
		def ReproducedNTimes(xN)
			return this.Repeated(xN)
		end
		def Copied(xN)
