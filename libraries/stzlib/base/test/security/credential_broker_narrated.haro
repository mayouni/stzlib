# THE CREDENTIAL BROKER -- RADAR-OPENSHELL-CREDBROKER-01, narrated
#
# An agent names a credential; the engine attaches its value to a request bound for
# the one host its grant names, and masks it out of what comes back. The value is
# read by the engine from a file, held in locked pages, and never answered to Haro.
#
#   Scene 1  a grant from a file: described by name, host and header, never by value
#   Scene 2  a brokered request reaches the server with the value; the echo comes back masked
#   Scene 3  every refusal is decided before sending: host, scheme, user@, injection, unknown
#   Scene 4  a redirect is not followed, so the value cannot be carried to another host
#   Scene 5  the seal: no grant can be added after it; revoke still narrows
#   Scene 6  a door shut by an advisory refuses the brokered request; reopening restores it
#   Scene 7  a stzSecretStore secret is granted by name; a literal one is refused
#
# RUNS ON haro.exe with the library; STZ_ENGINE_DIR names a built engine. Loopback only.

load "../../stzBase.ring"
$nPass = 0
$nFail = 0

nPort = StzEngineTestServerStart(0)
tBase = "http://127.0.0.1:" + String(nPort)


tFile = TempName()
# a fixture built at run time: it is not a credential and no file holds it
tFixture = "fx-" + StzEngineCryptoRandomHex(12)
Write(tFile, tFixture + Char(10))

Scenario("1. a grant read from a file by the engine")
Then("the grant is accepted", StzBrokerGrant("echo", "file:" + tFile, "127.0.0.1", "X-Key", ""), 1)
Then("one grant", StzBrokerCount(), 1)
vG = StzBrokerGrants()
Then("described by name, host and header", vG[1][1] + " " + vG[1][2] + " " + vG[1][3], "echo 127.0.0.1 X-Key")
Then("the description does not hold the value", Has(tFixture, StzEngineHttpBrokerDescribe()), false)

Scenario("2. the server gets the value; the agent gets it masked")
xR = StzBrokerRequest("echo", "GET", tBase + "/reqheaders", "Accept: text/plain", "")
Then("status 200", xR[:status], 200)
Then("the server read the header, value masked to its own length", Has("X-Key: " + Copy("*", Len(tFixture)), xR[:body]), true)
Then("the body does not hold the value", Has(tFixture, xR[:body]), false)
Then("the response header that echoed it is masked too", Has("X-Seen-Key: " + Copy("*", Len(tFixture)), xR[:headers]), true)
Then("the response headers do not hold the value", Has(tFixture, xR[:headers]), false)
Then("the caller's own header went with it", Has("Accept: text/plain", xR[:body]), true)
StzBrokerGrant("auth", "file:" + tFile, "127.0.0.1", "Authorization", "Bearer ")
Then("negative sibling: /auth without a credential is 401", StzEngineHttpGetStatus(tBase + "/auth"), 401)
Then("/auth through the broker is 200", StzBrokerRequest("auth", "GET", tBase + "/auth", "", "")[:status], 200)

Scenario("3. every refusal is decided before anything is sent")
vCases = [
    ["another host", "https://evil.example/x", "", "host is not the host"],
    ["a look-alike host", "http://127.0.0.1.evil.example/x", "", "not https"],
    ["plain http off loopback", "http://example.org/x", "", "not https"],
    ["credentials in the URL", "http://u:p@127.0.0.1:" + String(nPort) + "/x", "", "credentials of its own"],
    ["the caller names the granted header", tBase + "/reqheaders", "x-key: mine", "already name the granted header"]
]
nC = Len(vCases)
for i = 1 to nC
    xR = StzBrokerRequest("echo", "GET", vCases[i][2], vCases[i][3], "")
    Then(vCases[i][1] + ": refused, status -3", xR[:status], -3)
    Then("...and it says why", Has(vCases[i][4], xR[:refusal]), true)
end
xR = StzBrokerRequest("nobody", "GET", tBase + "/x", "", "")
Then("an unknown grant: refused", xR[:refusal], "no grant of that name (unknown or revoked)")
Then("an unknown method raises", RaisesOn("PURGE"), true)

Scenario("4. a redirect is not followed")
Then("/redirect/1 answers 302 to the agent, not the next hop's 200", StzBrokerRequest("echo", "GET", tBase + "/redirect/1", "", "")[:status], 302)

Scenario("5. the seal")
StzBrokerSeal()
Then("the broker says it is sealed", StzBrokerIsSealed(), true)
Then("a grant after the seal is refused, with the reason", GrantRefusal("late", "file:" + tFile, "127.0.0.1"), "sealed")
Then("revoke still works after the seal", StzBrokerRevoke("auth"), true)
Then("a revoked grant is refused", StzBrokerRequest("auth", "GET", tBase + "/auth", "", "")[:status], -3)
Then("the other grant still works", StzBrokerRequest("echo", "GET", tBase + "/reqheaders", "", "")[:status], 200)

Scenario("6. a door shut by an advisory")
StzEngineSecLogDoorShut("secret", "echo", "ADV-BROKER-T6")
xR = StzBrokerRequest("echo", "GET", tBase + "/reqheaders", "", "")
Then("the shut secret is refused", xR[:status], -3)
Then("...as shut", Has("shut", xR[:refusal]), true)
Then("reopening by the advisory", StzEngineSecLogDoorReopen("ADV-BROKER-T6"), 1)
Then("the request goes again", StzBrokerRequest("echo", "GET", tBase + "/reqheaders", "", "")[:status], 200)
StzEngineSecLogDoorShut("fetch", "127.0.0.1", "ADV-BROKER-T6B")
Then("a shut fetch door to the host refuses it too", StzBrokerRequest("echo", "GET", tBase + "/reqheaders", "", "")[:status], -3)
StzEngineSecLogDoorReopen("ADV-BROKER-T6B")

Scenario("7. a secret from a stzSecretStore, granted by name")
# the seal holds for this process: a store grant is shown refused for the seal, and
# the store's kind check is shown before it ever reaches the engine
oStore = new stzSecretStore("broker-guard")
oF = new stzSecret("from-file")
oF.FromFile(tFile)
oStore.Register(oF)
oL = new stzSecret("inline")
oL.FromLiteral("fixture-inline")
oStore.Register(oL)
Then("a literal secret is refused by kind", StoreRefusal(oStore, "inline"), "literal")
Then("an unknown name is refused", StoreRefusal(oStore, "none"), "no secret named")
Then("a file secret reaches the engine, which refuses it as sealed", StoreRefusal(oStore, "from-file"), "sealed")

StzEngineTestServerStop()
Remove(tFile)
? ""
? "================================================"
? "TOTAL: " + String($nPass + $nFail) + " assertions, " + String($nPass) + " pass, " + String($nFail) + " fail"
? "================================================"
Shutdown($nFail)

func RaisesOn(tMethod)
    try
        StzBrokerMethodCode(tMethod)
    catch
        return true
    end
    return false
end

func GrantRefusal(tName, tSource, tHost)
    try
        StzBrokerGrant(tName, tSource, tHost, "X-Key", "")
    catch
        if Has("sealed", cCatchError)
            return "sealed"
        end
        return cCatchError
    end
    return "granted"
end

func StoreRefusal(oStore, tName)
    try
        StzBrokerGrantFromStore(oStore, tName, "127.0.0.1", "X-Key", "")
    catch
        vWords = ["literal", "no secret named", "sealed"]
        nW = Len(vWords)
        for i = 1 to nW
            if Has(vWords[i], cCatchError)
                return vWords[i]
            end
        end
        return cCatchError
    end
    return "granted"
end

# ASCII containment: every text this guard looks for is ASCII
func Has(tNeedle, tHay)
    return SubStr(tHay, tNeedle) > 0
end

func Scenario(tName)
    ? ""
    ? "SCENARIO: " + tName
end

func Then(tWhat, xGot, xExpected)
    if xGot = xExpected
        $nPass = $nPass + 1
        ? "  THEN  " + tWhat + "  [PASS]"
    else
        $nFail = $nFail + 1
        ? "  THEN  " + tWhat + "  [FAIL]"
        ? "    expected: " + String(xExpected)
        ? "    got:      " + String(xGot)
    end
end
