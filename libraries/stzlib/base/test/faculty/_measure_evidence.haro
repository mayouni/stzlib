# RADAR-EVIDENCE-01: a quote a program can check, and the wrong answers that pass the check.
#
#     haro _measure_evidence.haro <model .gguf> <label>
#
# The support desk's 36 held-out tickets (_data/tickets_heldout.tsv). Each row's fifth column is the words that state
# the ticket's problem, written with the set. Each model is asked to quote, word for word, the one sentence of the
# ticket that states the problem -- greedy, at most 96 new tokens, the first line of its answer kept, wrapping quotes
# taken off. A program then judges it twice:
#
#   the CHECK   the answer occurs verbatim in the ticket; its place is where it occurs (found by the program)
#   the TRUTH   it lies inside the problem's sentence (the one holding those words, case folded) and holds the words
#
# and gives each answer one kind:
#
#   right             passes the check and is true
#   other-sentence    passes the check and quotes a sentence that is not the problem's          } WRONG AND PASSING
#   several           passes the check, holds the problem's words, and runs over a sentence end } the check
#   part              passes the check, inside the problem's sentence, without the problem's words (incomplete)
#   not-verbatim      fails the check (a paraphrase, a changed word, or nothing)
#
# Sentences end at . ! or ? followed by a blank. The fifth column is one reading of "the problem", written with the
# set before this measurement; an answer judged against it is judged against that reading.
#
# Text generated by prompt lookup (StzEngineNeuralGenerateLookup): the same greedy text as plain generation, 36 of 36
# identical on this set (results/lookup.tsv), and faster. From this folder, with STZ_ENGINE_DIR set. A heavy job: one at
# a time. Appends one line to results/evidence.tsv and writes every answer to results/evidence/<label>.tsv.

LoadLib(Slashes(SysGet("STZ_ENGINE_DIR")) + "/zig-out/bin/stz_neural.dll")

tModel = ""
$tLabel = ""
nArgs = Len(SysArgv)
for i = 1 to nArgs
	if Right(SysArgv[i], 22) = "_measure_evidence.haro" and i + 2 <= nArgs
		tModel = SysArgv[i + 1]
		$tLabel = SysArgv[i + 2]
	end
end
if tModel = ""
	? "usage: haro _measure_evidence.haro <model .gguf> <label>"
	Shutdown(2)
end
if StzEngineNeuralModelLoad(Slashes(tModel)) = 0
	? "the model was refused, status " + String(StzEngineNeuralModelLoadStatus())
	Shutdown(1)
end
StzEngineNeuralGenSetPrefixReuse(0)

$tAsk = "Quote, word for word, the one sentence of this support ticket that states the problem. Write only that sentence."
vRows = Lines(Read("_data/tickets_heldout.tsv"))
nItems = 0
nRight = 0
nOther = 0
nSeveral = 0
nPart = 0
nNotVerbatim = 0
nMs = 0
tDetail = "item" + Char(9) + "kind" + Char(9) + "place" + Char(9) + "answer" + Char(10)
for i = 1 to Len(vRows)
	vCol = Cols(vRows[i])
	if Len(vCol) < 5
		loop
	end
	tTicket = vCol[1]
	tKey = Lower(vCol[5])
	tPrompt = Prompt("You answer support questions exactly as asked.", $tAsk + Char(10) + Char(10) + "Ticket: " + tTicket)
	nT = Clock()
	tRaw = StzEngineNeuralGenerateLookup(tPrompt, 96, 4, 3)
	nMs = nMs + (Clock() - nT)
	tA = Clean(tRaw)
	nItems = nItems + 1
	nPlace = Find(tA, tTicket)
	vStarts = SentenceStarts(tTicket)
	nKeySent = SentOf(vStarts, Find(tKey, Lower(tTicket)))
	tKind = ""
	if tA = "" or nPlace = 0
		tKind = "not-verbatim"
		nNotVerbatim = nNotVerbatim + 1
	else
		nFirst = SentOf(vStarts, nPlace)
		nLast = SentOf(vStarts, nPlace + Len(tA) - 1)
		bKey = Find(tKey, Lower(tA)) > 0
		if nFirst != nLast and bKey
			tKind = "several"
			nSeveral = nSeveral + 1
		elseif nFirst = nKeySent and nLast = nKeySent and bKey
			tKind = "right"
			nRight = nRight + 1
		elseif nFirst = nKeySent and nLast = nKeySent
			tKind = "part"
			nPart = nPart + 1
		else
			tKind = "other-sentence"
			nOther = nOther + 1
		end
	end
	tDetail = tDetail + String(nItems) + Char(9) + tKind + Char(9) + String(nPlace) + Char(9) + tA + Char(10)
end
nPassWrong = nOther + nSeveral
tLine = $tLabel + Char(9) + "items " + String(nItems) + Char(9) + "right " + String(nRight) + Char(9) + "pass-and-wrong " + String(nPassWrong) + " (other-sentence " + String(nOther) + ", several " + String(nSeveral) + ")" + Char(9) + "part " + String(nPart) + Char(9) + "not-verbatim " + String(nNotVerbatim) + Char(9) + "ms " + String(nMs)
? tLine
tOld = ""
if FExists("results/evidence.tsv")
	tOld = Read("results/evidence.tsv")
end
Write("results/evidence.tsv", tOld + tLine + Char(10))
Write("results/evidence/" + $tLabel + ".tsv", tDetail)

# the model's chat template, by its label (as clusterbench/run.haro chooses it)
func Prompt(tSys, tUser)
	if Left($tLabel, 4) = "bolt"
		return "<|turn>system" + Char(10) + tSys + "<turn|>" + Char(10) + "<|turn>user" + Char(10) + tUser + "<turn|>" + Char(10) + "<|turn>model" + Char(10)
	end
	if Left($tLabel, 7) = "granite" and Left($tLabel, 9) != "granite42"
		return "<|start_of_role|>system<|end_of_role|>" + tSys + "<|end_of_text|>" + Char(10) + "<|start_of_role|>user<|end_of_role|>" + tUser + "<|end_of_text|>" + Char(10) + "<|start_of_role|>assistant<|end_of_role|>"
	end
	tChat = "<|im_start|>system" + Char(10) + tSys + "<|im_end|>" + Char(10) + "<|im_start|>user" + Char(10) + tUser + "<|im_end|>" + Char(10) + "<|im_start|>assistant" + Char(10)
	if Left($tLabel, 5) = "qwen3"
		return tChat + "<think>" + Char(10) + Char(10) + "</think>" + Char(10) + Char(10)
	end
	if Left($tLabel, 4) = "lfm3"
		return "<|startoftext|>" + tChat + "<think></think>"
	end
	if Left($tLabel, 9) = "granite42"
		return tChat + "<think></think>"
	end
	return tChat
end

# the first non-empty line, its blanks and one pair of wrapping quotes taken off
func Clean(tRaw)
	vL = Lines(tRaw)
	tA = ""
	for j = 1 to Len(vL)
		tA = Trim(vL[j])
		if tA != ""
			exit
		end
	end
	if Len(tA) >= 2
		tF = Left(tA, 1)
		tL = Right(tA, 1)
		if (tF = Char(34) and tL = Char(34)) or (tF = "'" and tL = "'")
			tA = Trim(SubStr(tA, 2, Len(tA) - 2))
		end
	end
	return tA
end

# where each sentence of the ticket begins: 1, and after every sentence end (. ! ?) followed by a blank
func SentenceStarts(tText)
	vOut = [ 1 ]
	nLen = Len(tText)
	for j = 1 to nLen - 2
		if (tText[j] = "." or tText[j] = "!" or tText[j] = "?") and tText[j + 1] = " "
			vOut + (j + 2)
		end
	end
	return vOut
end

# the number of the sentence that holds place nAt (0 when nAt is 0)
func SentOf(vStarts, nAt)
	if nAt = 0
		return 0
	end
	nS = 0
	nLen = Len(vStarts)
	for j = 1 to nLen
		if vStarts[j] <= nAt
			nS = j
		end
	end
	return nS
end

func Trim(tText)
	nA = 1
	nB = Len(tText)
	while nA <= nB and (tText[nA] = " " or tText[nA] = Char(9) or tText[nA] = Char(13))
		nA = nA + 1
	end
	while nB >= nA and (tText[nB] = " " or tText[nB] = Char(9) or tText[nB] = Char(13))
		nB = nB - 1
	end
	if nB < nA
		return ""
	end
	return SubStr(tText, nA, nB - nA + 1)
end

# the first place of tNeedle in tHay, 0 when it is not there (byte positions; the set is ASCII)
func Find(tNeedle, tHay)
	nN = Len(tNeedle)
	nH = Len(tHay)
	if nN = 0
		return 0
	end
	for j = 1 to nH - nN + 1
		if SubStr(tHay, j, nN) = tNeedle
			return j
		end
	end
	return 0
end

func Cols(tRow)
	vOut = []
	tCur = ""
	nLen = Len(tRow)
	for j = 1 to nLen
		if tRow[j] = Char(9)
			vOut + tCur
			tCur = ""
		else
			tCur = tCur + tRow[j]
		end
	end
	vOut + tCur
	return vOut
end

# the lines of a text (no library is loaded here)
func Lines(tText)
	vOut = []
	tCur = ""
	nLen = Len(tText)
	for j = 1 to nLen
		if tText[j] = Char(10)
			vOut + tCur
			tCur = ""
		elseif tText[j] != Char(13)
			tCur = tCur + tText[j]
		end
	end
	if tCur != ""
		vOut + tCur
	end
	return vOut
end

func Slashes(tPath)
	tOut = ""
	nLen = Len(tPath)
	for j = 1 to nLen
		if tPath[j] = Char(92)
			tOut = tOut + "/"
		else
			tOut = tOut + tPath[j]
		end
	end
	return tOut
end
