load "../../stzBase.ring"
load "_narrate.haro"

# TESTOOR TR2 -- PROMISES AS STOPS. The rules of base/meta/promises.py, the
# Python harness that first compared the library's 2,874 files of `#-->`
# promises with what they print, now live in the traveller (stzTraveller.ring,
# the _TravPromise* functions) and judge a promise as a claim of a stop:
# kept, diverged, unreached, unjudged. _expect.ring's pictures join the
# logbook the same way.
#
# EVERY RULE WAS LEARNED BY WATCHING THE HARNESS ACCUSE THE LIBRARY FALSELY,
# so every rule here is planted both ways: the lie it must catch and the
# truth it must not accuse.
#
#   lies/     01 a plain lie                          -> diverged
#             02 two lies in a row                    -> BOTH diverged (a divergence consumes one line)
#             03 a short lie hiding inside a later list -> diverged, the list kept
#   kept/     01 the spellings: TRUE as 1, a note in parentheses, quotes,
#                :Symbol lowercased, @@() list spacing, a bare list item by
#                item, '' for an empty line, a second # as a note -> all kept
#             02 "#--> ERROR: boom" on a line that raises  -> kept, and the tour FINISHED as promised
#             03 a label line before the real value      -> one promise, kept
#   prose/    01 "#--> "C" but should be "sm_AS""        -> prose: unjudged, never diverged, exit 0
#   nostart/  01 a statement that does not compile -> BROKE under rnxc: Ring++
#                compiles a file statement by statement and runs it up to the
#                one it refuses (measured 2026-11-03: the promise before it is
#                kept, the file stops there, exit 1); Ring ran nothing (not-started)
#             02 an unclosed literal (S) -> not-started, promises unreached, 0 diverged
#   raised/   01 a promise, a division by zero, a promise -> 1 kept, 1 unreached, 0 diverged
#   picture/  01 a Shows() that prints PICTURE DOES NOT MATCH and raises -> diverged, named with its row
#             02 a Shows() that is silent                 -> kept
#   and one REAL plot example under ../plot, read and run.

? "TESTOOR TR2 -- promises as stops"
nTpStart = Clock()
tTpHere = CurrentDir()
tTpPlant = tTpHere + "/_planted_promises"
_TpPlantAll(tTpPlant)

#============================================================================
Scenario("A planted lie is diverged; two lies in a row are both caught; a short lie cannot hide in a later line")
	nTpSec = Clock()
	Given("a planted tour promising 3 for 1 + 1")
	oT = TravellerQ().Silent().Timeout(10000).Walk(tTpPlant + "/lies/01_lie.ring")
	xR = oT.Records()[1][:run]
	Then("the promise is diverged", xR[:diverged], 1)
	Then("the claim is the expression", xR[:stops][1][:claims][1][:claim], "1 + 1")
	Then("the tour is diverged", xR[:state], "diverged")
	Then("the runner exits 1", oT.ExitCode(), 1)
	Given("two consecutive lies")
	oT2 = TravellerQ().Silent().Timeout(10000).Walk(tTpPlant + "/lies/02_two_lies.ring")
	Then("both are diverged, the first did not hand its line to the second",
		oT2.Records()[1][:run][:diverged], 2)
	Given("a short lie, 6 for 3, followed by a line printing [ 6, 28 ]")
	oT3 = TravellerQ().Silent().Timeout(10000).Walk(tTpPlant + "/lies/03_short_hidden.ring")
	xR3 = oT3.Records()[1][:run]
	Then("the short lie is diverged, not found inside the list", xR3[:stops][1][:claims][1][:state], "diverged")
	Then("the list promise after it is kept", xR3[:stops][1][:claims][2][:state], "kept")
EndScenario()
? "        [section took " + String((Clock() - nTpSec) / ClocksPerSecond()) + "s]"

#============================================================================
Scenario("The spellings a promise may print as are all kept")
	nTpSec = Clock()
	Given("one planted tour with eight true promises in eight spellings")
	oT = TravellerQ().Silent().Timeout(10000).Walk(tTpPlant + "/kept/01_variants.ring")
	xR = oT.Records()[1][:run]
	xC = xR[:stops][1][:claims]
	Then("TRUE printed as 1", xC[1][:state], "kept")
	Then("FALSE (absent): the note in parentheses dropped", xC[2][:state], "kept")
	Then("a quoted promise against an unquoted print", xC[3][:state], "kept")
	Then(":Number printed bare and lowercased", xC[4][:state], "kept")
	Then("@@() spacing: [ 6, 28 ] against [6, 28]", xC[5][:state], "kept")
	Then("a bare list, one item per line, item by item", xC[6][:state], "kept")
	Then("'' for a line that prints nothing", xC[7][:state], "kept")
	Then("a second # is a note, not more value", xC[8][:state], "kept")
	Then("eight kept, none diverged", NarText(xR[:kept]) + "/" + NarText(xR[:diverged]), "8/0")
	Then("the runner exits 0", oT.ExitCode(), 0)
EndScenario()
? "        [section took " + String((Clock() - nTpSec) / ClocksPerSecond()) + "s]"

#============================================================================
Scenario("#--> ERROR: is honoured; a label line is not a promise; a prose promise is prose")
	nTpSec = Clock()
	Given("a planted tour whose last line promises to raise, and does")
	oT = TravellerQ().Silent().Timeout(10000).Walk(tTpPlant + "/kept/02_error.ring")
	xR = oT.Records()[1][:run]
	Then("the ERROR promise is kept", xR[:stops][1][:claims][2][:state], "kept")
	Then("the promise before it is kept", xR[:stops][1][:claims][1][:state], "kept")
	Then("the tour FINISHED, as it promised, though Ring exited 1", xR[:end], "finished")
	Then("the runner exits 0", oT.ExitCode(), 0)
	Given("a trailing #--> that reads as a label, then the value on its own line")
	oL = TravellerQ().Silent().Timeout(10000).Walk(tTpPlant + "/kept/03_label.ring")
	xL = oL.Records()[1][:run]
	Then("one promise was read, not two", Len(xL[:stops][1][:claims]), 1)
	Then("its value is the standalone line's", xL[:stops][1][:claims][1][:want], "[ 1, 2 ]")
	Then("and it is kept", xL[:stops][1][:claims][1][:state], "kept")
	Given("a list WRAPPED over comment lines but printed on one line, and the same wrapped value with a wrong number")
	oW = TravellerQ().Silent().Timeout(10000).Walk(tTpPlant + "/kept/04_wrapped.ring")
	Then("the wrapped promise is kept, one claim for the whole block", oW.Records()[1][:run][:stops][1][:claims][1][:state], "kept")
	Then("a block of lines printed as lines is kept too", oW.Records()[1][:run][:stops][1][:claims][2][:state], "kept")
	oWl = TravellerQ().Silent().Timeout(10000).Walk(tTpPlant + "/lies/04_wrapped_lie.ring")
	Then("the same block against a wrong number is diverged", oWl.Records()[1][:run][:stops][1][:claims][1][:state], "diverged")
	Given("the short form ERR: on a line that raises")
	oEs = TravellerQ().Silent().Timeout(10000).Walk(tTpPlant + "/kept/05_err_short.ring")
	Then("an ERR: promise is kept", oEs.Records()[1][:run][:stops][1][:claims][2][:state], "kept")
	Then("and the tour finished as promised", oEs.Records()[1][:run][:end], "finished")
	Given("a promise that argues with itself")
	oP = TravellerQ().Silent().Timeout(10000).Walk(tTpPlant + "/prose/01_prose.ring")
	xP = oP.Records()[1][:run]
	Then("the reader calls it prose", xP[:stops][1][:claims][1][:kind], "prose")
	Then("the traveller leaves it unjudged", xP[:stops][1][:claims][1][:state], "unjudged")
	Then("nothing diverged", xP[:diverged], 0)
	Then("the runner exits 0: a note is not a broken promise", oP.ExitCode(), 0)
EndScenario()
? "        [section took " + String((Clock() - nTpSec) / ClocksPerSecond()) + "s]"

#============================================================================
Scenario("Did-not-compile is not diverged; a raise part-way leaves the promises below it unreached")
	nTpSec = Clock()
	Given("a planted tour with a promise and then a statement that does not compile")
	oC = TravellerQ().Silent().Timeout(10000).Walk(tTpPlant + "/nostart/01_syntax.ring")
	xC = oC.Records()[1][:run]
	# Ring++ compiles statement by statement and runs the file up to the one it
	# refuses: the promise before it printed and is kept, then the file broke
	# there (exit 1, "Ring++ refused this statement"). Ring would have run
	# nothing. The promises after the refusal are unreached, never diverged.
	Then("the tour broke at the refused statement", xC[:end], "broke")
	Then("the promise before it is kept, nothing diverged", NarText(xC[:kept]) + "/" + NarText(xC[:unreached]) + "/" + NarText(xC[:diverged]), "1/0/0")
	Then("the child named the refusal", StzFindFirst("refused this statement", oC.Records()[1][:stderr] + _TpJoin(oC.Records()[1][:output])) > 0, true)
	Given("a planted tour with an unclosed string literal (a scanner error)")
	oS = TravellerQ().Silent().Timeout(10000).Walk(tTpPlant + "/nostart/02_scanner.ring")
	Then("it did not start either", oS.Records()[1][:run][:end], "not-started")
	Then("both exit 1: a tour that broke, a tour that did not start", NarText(oC.ExitCode()) + "/" + NarText(oS.ExitCode()), "1/1")
	Given("a planted tour: a true promise, a division by zero, a true promise")
	oRz = TravellerQ().Silent().Timeout(10000).Walk(tTpPlant + "/raised/01_partway.ring")
	xRr = oRz.Records()[1][:run]
	Then("the tour broke", xRr[:end], "broke")
	Then("the first promise is kept", xRr[:stops][1][:claims][1][:state], "kept")
	Then("the second is unreached, not diverged", xRr[:stops][1][:claims][2][:state], "unreached")
	Then("one finding, not two", xRr[:diverged], 0)
EndScenario()
? "        [section took " + String((Clock() - nTpSec) / ClocksPerSecond()) + "s]"

#============================================================================
Scenario("A picture that does not match is diverged and names its row; a picture that matches is kept")
	nTpSec = Clock()
	Given("a planted tour whose Shows() prints PICTURE DOES NOT MATCH and raises")
	oM = TravellerQ().Silent().Timeout(10000).Walk(tTpPlant + "/picture/01_mismatch.ring")
	xM = oM.Records()[1][:run]
	Then("the reader read a picture claim", oM.Records()[1][:stops][1][:claims][1][:kind], "picture")
	Then("the tour is diverged", xM[:state], "diverged")
	Then("the verdict names the row",
		StzFindFirst("first difference at row 2", xM[:stops][1][:claims][2][:claim]) > 0, true)
	Then("the tour's ending is the assertion's own, not a break", xM[:end], "finished")
	Then("the runner exits 1", oM.ExitCode(), 1)
	Given("a planted tour whose Shows() is silent")
	oKept = TravellerQ().Silent().Timeout(10000).Walk(tTpPlant + "/picture/02_match.ring")
	xKept = oKept.Records()[1][:run]
	Then("the picture is kept", xKept[:stops][1][:claims][1][:state], "kept")
	Then("the runner exits 0", oKept.ExitCode(), 0)
	Given("one real plot example under ../plot that calls Shows()")
	tPlot = _TpFirstPictureTour(tTpHere + "/../plot")
	? "        (" + tPlot + ")"
	oPl = TravellerQ().Silent().Timeout(60000).Walk(tPlot)
	xPl = oPl.Records()[1][:run]
	? "        " + _TravRunProse(oPl.Records()[1])
	Then("it was found", tPlot != "", true)
	Then("its pictures were walked", Len(oPl.Records()[1][:stops][1][:claims]) > 0, true)
	Then("and the run ended as finished or finished-timed",
		xPl[:end] = "finished" or xPl[:end] = "finished-timed", true)
EndScenario()
? "        [section took " + String((Clock() - nTpSec) / ClocksPerSecond()) + "s]"

_TpUnplantAll(tTpPlant)
? ""
? "[TR2 took " + String((Clock() - nTpStart) / ClocksPerSecond()) + "s]"
Summary()
Shutdown($nNarFail)

#============================================================================
# HELPERS AFTER THE TOP-LEVEL CODE

func _TpPlantAll(tRoot)
	_TpUnplantAll(tRoot)
	StzMakeDir(tRoot)
	StzMakeDir(tRoot + "/lies")
	StzMakeDir(tRoot + "/kept")
	StzMakeDir(tRoot + "/prose")
	StzMakeDir(tRoot + "/nostart")
	StzMakeDir(tRoot + "/raised")
	StzMakeDir(tRoot + "/picture")
	tNl = Char(10)
	Write(tRoot + "/lies/01_lie.ring", "? 1 + 1" + tNl + "#--> 3" + tNl)
	Write(tRoot + "/lies/02_two_lies.ring",
		'? "alpha"  #--> beta' + tNl + '? "gamma"  #--> delta' + tNl)
	Write(tRoot + "/lies/03_short_hidden.ring",
		"? 3  #--> 6" + tNl + '? "[ 6, 28 ]"  #--> [ 6, 28 ]' + tNl)
	Write(tRoot + "/kept/01_variants.ring",
		"? 1 = 1  #--> TRUE" + tNl +
		"? 1 = 2  #--> FALSE (absent)" + tNl +
		'? "13"  #--> "13"' + tNl +
		"? :Number  #--> :Number" + tNl +
		'? "[ 6, 28 ]"  #--> [6, 28]' + tNl +
		'? [ "a", "b" ]  #--> ["a", "b"]' + tNl +
		'? ""  #--> ' + "''" + tNl +
		"? 5  #--> 5  # a note after the value" + tNl)
	Write(tRoot + "/kept/02_error.ring",
		'? "before"  #--> before' + tNl +
		"? Boom()  #--> ERROR: boom happened" + tNl +
		"func Boom()" + tNl + Char(9) + 'raise("boom happened")' + tNl)
	Write(tRoot + "/kept/03_label.ring",
		'? "[ 1, 2 ]"   #--> Leads to a normal Ring list' + tNl +
		"#--> [ 1, 2 ]" + tNl)
	Write(tRoot + "/kept/04_wrapped.ring",
		'? "[ 11, 22, 33 ]"' + tNl +
		"#--> [" + tNl + "#" + Char(9) + "11, 22," + tNl + "#" + Char(9) + "33" + tNl + "# ]" + tNl + tNl +
		'? "["' + tNl + '? "1,"' + tNl + '? "2"' + tNl + '? "]"' + tNl +
		"#--> [" + tNl + "# 1," + tNl + "# 2" + tNl + "# ]" + tNl)
	Write(tRoot + "/lies/04_wrapped_lie.ring",
		'? "[ 11, 22, 99 ]"' + tNl +
		"#--> [" + tNl + "#" + Char(9) + "11, 22," + tNl + "#" + Char(9) + "33" + tNl + "# ]" + tNl)
	Write(tRoot + "/kept/05_err_short.ring",
		'? "ok"  #--> ok' + tNl +
		"? Boom()" + tNl + "#--> ERR: short form boom" + tNl +
		"func Boom()" + tNl + Char(9) + 'raise("short form boom")' + tNl)
	Write(tRoot + "/prose/01_prose.ring",
		'? "C"  #--> "C" but should be "sm_AS"' + tNl)
	Write(tRoot + "/nostart/01_syntax.ring",
		"? 1  #--> 1" + tNl + "if 1 = 1" + tNl + '? "unclosed if"' + tNl)
	Write(tRoot + "/nostart/02_scanner.ring",
		"? 1  #--> 1" + tNl + '? "an unclosed literal' + tNl)
	Write(tRoot + "/raised/01_partway.ring",
		"? 1  #--> 1" + tNl + "x = 1 / 0" + tNl + "? 2  #--> 2" + tNl)
	Write(tRoot + "/picture/01_mismatch.ring",
		'Shows("a", "b")' + tNl +
		"func Shows(a, b)" + tNl +
		Char(9) + '? ""' + tNl +
		Char(9) + '? "PICTURE DOES NOT MATCH"' + tNl +
		Char(9) + '? "  expected 3 rows, got 3"' + tNl +
		Char(9) + '? "  first difference at row 2:"' + tNl +
		Char(9) + '? "    expected |x|"' + tNl +
		Char(9) + '? "    actual   |y|"' + tNl +
		Char(9) + 'raise("The picture does not match what the example says it shows.")' + tNl)
	Write(tRoot + "/picture/02_match.ring",
		'Shows("a", "a")' + tNl +
		"func Shows(a, b)" + tNl + Char(9) + "return 1" + tNl)
end
func _TpUnplantAll(tRoot)
	if FExists(tRoot + "/lies/01_lie.ring")
		StzDirDeleteAll(tRoot)
	end
end
# the first tour under a folder that the reader says carries a picture claim
func _TpFirstPictureTour(tDir)
	xTwo = _TourFilesUnder(tDir, "")
	vF = xTwo[1]
	nN = Len(vF)
	for k = 1 to nN
		xRec = Tour(vF[k])
		vC = _TourClaimsOf(xRec)
		nC = Len(vC)
		for c = 1 to nC
			if vC[c][:kind] = "picture"  return vF[k]  end
		end
	end
	return ""
end
# the child's printed lines ([ text, seconds ] each) as one text
func _TpJoin(pxLines)
	tC = ""
	nN = Len(pxLines)
	for k = 1 to nN
		tC += pxLines[k][1] + Char(10)
	end
	return tC
end
