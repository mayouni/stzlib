load "../../stzBase.ring"
load "_narrate.haro"

# TESTOOR TR1 -- THE RUNNER. One process per batch, many tours; the exit
# code is the runner's, never Ring's; JSON on a pipe and prose on a terminal
# from one run; wall time per stop; skipped by name; owned and run as two
# figures; pf() as a state.
#
# WHAT IS PLANTED, AND WHY PLANTED. The tours below are written into
# _planted/ beside this guard (a leading "_" is what the reader skips, and
# the folder is ignored by git), one topic folder per outcome, each tour a
# standalone Ring file that needs no library -- so a child starts in tens of
# milliseconds and the guard measures the RUNNER, not the library's load.
# Then the real uuid topic is walked once, for the shape against the corpus.
#
#   pass/    01 two scenes, three [OK]           -> kept, two stops timed
#            02 two promises, next-line and trailing -> kept
#            03 a claim then pf()'s STOPPED!     -> kept, finished-timed
#            04 a claim in a branch never taken  -> unjudged, NOT a failure
#            _skipme.ring                        -> skipped by name
#   fail/    01 a [FAIL]                         -> diverged
#            02 a promise that lies              -> diverged
#            03 a load of a file that is not there -> not-started (E9 exits 0!)
#            04 a claim, a division by zero, a claim -> broke, the second unreached
#   hang/    01 a loop that writes a heartbeat   -> hung, killed, heartbeat stops
#   nonesuch -> the runner refuses, exit 2
#
# Every exit code is read TWICE: from the traveller in this process, and
# from a CHILD `rnxc testoor.ring ...` through the OS -- the $? a shell sees.
# Every child is rnxc (Ring++): TestoorProgram() names it, never `ring`.

? "TESTOOR TR1 -- the runner"
nTrStart = Clock()
tTrHere = CurrentDir()
tTrPlant = tTrHere + "/_planted"
tTrTestoor = tTrHere + "/../../testoor"
_TrPlantAll(tTrPlant)

#============================================================================
Scenario("A kept tour: two stops, three claims, each stop timed")
	nTrSec = Clock()
	Given("a planted tour printing two scene banners and three [OK] lines")
	oT = TravellerQ().Silent().Timeout(10000).Walk(tTrPlant + "/pass/01_kept.ring")
	xR = oT.Records()[1][:run]
	When("the traveller walks it")
	Then("the tour is kept", xR[:state], "kept")
	Then("its child finished", xR[:end], "finished")
	Then("the child's exit was 0", xR[:exit], 0)
	Then("two stops were walked", Len(xR[:stops]), 2)
	Then("the first stop is kept", xR[:stops][1][:state], "kept")
	Then("with two claims", Len(xR[:stops][1][:claims]), 2)
	Then("the second stop's one claim is kept, from a lower-case [ok]",
		xR[:stops][2][:claims][1][:state], "kept")
	Then("three claims kept, none diverged", xR[:kept], 3)
	Then("none diverged", xR[:diverged], 0)
	Then("the tour has a wall time", Float(xR[:wall_ms]) > Float(0), true)
	Then("the first stop has a wall time of its own", Float(xR[:stops][1][:wall_ms]) >= Float(0), true)
	Then("the stop opened after the tour started", Float(xR[:stops][1][:opened]) >= Float(0), true)
	Then("one tour owned, one run", NarText(oT.Owned()) + "/" + NarText(oT.Run()), "1/1")
	Then("the runner's exit code is 0", oT.ExitCode(), 0)
	Then("the seed is in the JSON, a number and no longer null", StzFindFirst('"seed":null', oT.Json()) = 0 and StzFindFirst('"seed":', oT.Json()) > 0, true)
	Then("the JSON is valid JSON", StzJsonIsValid(oT.Json()), true)
EndScenario()
? "        [section took " + String((Clock() - nTrSec) / ClocksPerSecond()) + "s]"

#============================================================================
Scenario("Promises are stops: kept when the value appears, diverged when it lies")
	nTrSec = Clock()
	Given("a planted tour with a next-line and a trailing promise, both true")
	oT = TravellerQ().Silent().Timeout(10000).Walk(tTrPlant + "/pass/02_promises.ring")
	xR = oT.Records()[1][:run]
	Then("both promises are kept", xR[:kept], 2)
	Then("the tour is kept", xR[:state], "kept")
	Given("a planted tour whose promise lies")
	oF = TravellerQ().Silent().Timeout(10000).Walk(tTrPlant + "/fail/02_lie.ring")
	xF = oF.Records()[1][:run]
	Then("the lie is diverged", xF[:diverged], 1)
	Then("the tour is diverged", xF[:state], "diverged")
	Then("and the runner exits 1", oF.ExitCode(), 1)
EndScenario()
? "        [section took " + String((Clock() - nTrSec) / ClocksPerSecond()) + "s]"

#============================================================================
Scenario("pf() is a state, never a failure; a claim in a branch not taken is unjudged, never a failure")
	nTrSec = Clock()
	Given("a planted tour that keeps a claim and then ends the way pf() ends")
	oT = TravellerQ().Silent().Timeout(10000).Walk(tTrPlant + "/pass/03_timed.ring")
	xR = oT.Records()[1][:run]
	Then("Ring exited 1 on the STOPPED! raise", xR[:exit], 1)
	Then("but the tour ended finished-timed", xR[:end], "finished-timed")
	Then("its claim is kept", xR[:kept], 1)
	Then("the tour is kept", xR[:state], "kept")
	Then("and the RUNNER exits 0", oT.ExitCode(), 0)
	Given("a planted tour with a claim inside an if that is never true")
	oU = TravellerQ().Silent().Timeout(10000).Walk(tTrPlant + "/pass/04_unjudged.ring")
	xU = oU.Records()[1][:run]
	Then("the printed claim is kept", xU[:kept], 1)
	Then("the silent claim is unjudged, because the tour ran to its end", xU[:unjudged], 1)
	Then("nothing is unreached", xU[:unreached], 0)
	Then("the stop is unjudged", xU[:stops][1][:state], "unjudged")
	Then("the runner exits 0: unjudged is reported, not counted against", oU.ExitCode(), 0)
EndScenario()
? "        [section took " + String((Clock() - nTrSec) / ClocksPerSecond()) + "s]"

#============================================================================
Scenario("A diverged claim, a tour that never starts, a tour that breaks")
	nTrSec = Clock()
	Given("a planted tour printing one [OK] and one [FAIL]")
	oT = TravellerQ().Silent().Timeout(10000).Walk(tTrPlant + "/fail/01_diverge.ring")
	xR = oT.Records()[1][:run]
	Then("one kept, one diverged", NarText(xR[:kept]) + "/" + NarText(xR[:diverged]), "1/1")
	Then("the stop is diverged", xR[:stops][1][:state], "diverged")
	Then("the diverged claim is named", xR[:stops][1][:claims][2][:claim], "two is three")
	Then("the runner exits 1", oT.ExitCode(), 1)
	Given("a planted tour that loads a file that is not there")
	oNoStart = TravellerQ().Silent().Timeout(10000).Walk(tTrPlant + "/fail/03_nostart.ring")
	xN = oNoStart.Records()[1][:run]
	? "        (Ring's own exit on the E9 was " + NarText(xN[:exit]) + " -- Ring's business, not the runner's)"
	Then("the tour did not start", xN[:end], "not-started")
	Then("its claim is unreached", xN[:unreached], 1)
	Then("the runner exits 1", oNoStart.ExitCode(), 1)
	Given("a planted tour that keeps a claim, divides by zero, and would keep another")
	oB = TravellerQ().Silent().Timeout(10000).Walk(tTrPlant + "/fail/04_broke.ring")
	xB = oB.Records()[1][:run]
	Then("the tour broke", xB[:end], "broke")
	Then("the first claim is kept", xB[:stops][1][:claims][1][:state], "kept")
	Then("the second is unreached, not unjudged", xB[:stops][1][:claims][2][:state], "unreached")
	Then("the stop is unreached", xB[:stops][1][:state], "unreached")
	Then("the runner exits 1 -- decided here, recorded in CONCLUSIONS", oB.ExitCode(), 1)
EndScenario()
? "        [section took " + String((Clock() - nTrSec) / ClocksPerSecond()) + "s]"

#============================================================================
Scenario("A hung tour is killed at the deadline, reported hung, and leaves no process behind")
	nTrSec = Clock()
	Given("a planted tour that loops for 30 s writing a heartbeat, and a 1.5 s deadline")
	tBeat = tTrPlant + "/hang/heartbeat.txt"
	if FExists(tBeat)  Remove(tBeat)  end
	nT0 = Clock()
	oH = TravellerQ().Silent().Timeout(1500).Walk(tTrPlant + "/hang/01_hang.ring")
	nTook = (Clock() - nT0) / ClocksPerSecond()
	xH = oH.Records()[1][:run]
	Then("the tour is hung", xH[:end], "hung")
	Then("the runner came back near the deadline, not after 30 s", nTook < 6, true)
	Then("its claim is unreached", xH[:unreached], 1)
	Then("the runner exits 1", oH.ExitCode(), 1)
	tBeat1 = ""
	if FExists(tBeat)  tBeat1 = Read(tBeat)  end
	nW = Clock()
	while (Clock() - nW) / ClocksPerSecond() < 1.2  end
	tBeat2 = ""
	if FExists(tBeat)  tBeat2 = Read(tBeat)  end
	Then("the heartbeat was beating before the kill", Len(tBeat1) > 0, true)
	Then("and stopped after it: the child process is gone", tBeat2 = tBeat1, true)
EndScenario()
? "        [section took " + String((Clock() - nTrSec) / ClocksPerSecond()) + "s]"

#============================================================================
Scenario("A topic walk: owned and run as two figures, skipped by name, the other topics named, exit 0 / 1 / 2")
	nTrSec = Clock()
	Given("the planted root and its pass topic")
	oP = TravellerQ().Silent().Timeout(10000).WalkTopic(tTrPlant, "pass")
	Then("four tours owned", oP.Owned(), 4)
	Then("four tours run", oP.Run(), 4)
	Then("_skipme.ring was skipped by name, and named",
		StzFindFirst("_skipme.ring", oP.Skipped()[1]) > 0, true)
	Then("the topics not walked are named", Len(oP.TopicsSkipped()), 2)
	Then("the pass topic exits 0", oP.ExitCode(), 0)
	Then("the JSON carries owned and run as two fields",
		StzFindFirst('"owned":4,"run":4', oP.Json()) > 0, true)
	Then("the JSON is valid JSON", StzJsonIsValid(oP.Json()), true)
	Given("the fail topic")
	oF = TravellerQ().Silent().Timeout(10000).WalkTopic(tTrPlant, "fail")
	Then("four owned, four run, even though two never finished", NarText(oF.Owned()) + "/" + NarText(oF.Run()), "4/4")
	Then("the fail topic exits 1", oF.ExitCode(), 1)
	Given("a topic that is not there")
	oRef = TravellerQ().Silent().WalkTopic(tTrPlant, "nonesuch")
	Then("the runner refuses", oRef.Refused(), true)
	Then("and exits 2", oRef.ExitCode(), 2)
	Then("owning nothing", oRef.Owned(), 0)
	Then("the refusal is in the JSON", StzFindFirst('"refusal":"no such topic', oRef.Json()) > 0, true)
EndScenario()
? "        [section took " + String((Clock() - nTrSec) / ClocksPerSecond()) + "s]"

#============================================================================
Scenario("The exit code reaches the shell: 0, 1 and 2 read from a child rnxc testoor.ring")
	nTrSec = Clock()
	Given("testoor.ring run as a child, from its own folder, on each planted topic")
	xPass = _TrShell(tTrTestoor, [ "--root", tTrPlant, "--topic", "pass", "--json" ])
	Then("pass: the shell sees 0", xPass[1], 0)
	Then("pass: JSON came down the pipe", StzFindFirst('"testoor":"logbook"', xPass[2]) > 0, true)
	Then("pass: the JSON says exit 0", StzFindFirst('"exit":0', xPass[2]) > 0, true)
	xFail = _TrShell(tTrTestoor, [ "--root", tTrPlant, "--topic", "fail", "--json" ])
	Then("fail: the shell sees 1", xFail[1], 1)
	Then("fail: the JSON says exit 1", StzFindFirst('"exit":1', xFail[2]) > 0, true)
	xNone = _TrShell(tTrTestoor, [ "--root", tTrPlant, "--topic", "nonesuch" ])
	Then("nonesuch: the shell sees 2", xNone[1], 2)
	Then("nonesuch: the prose says REFUSED", StzFindFirst("REFUSED", xNone[2]) > 0, true)
	xNoScope = _TrShell(tTrTestoor, [])
	Then("no scope at all: the shell sees 2", xNoScope[1], 2)
	xProse = _TrShell(tTrTestoor, [ "--root", tTrPlant, "--topic", "pass" ])
	Then("without --json the terminal gets prose, one line per tour",
		StzFindFirst("KEPT", xProse[2]) > 0 and StzFindFirst("owned 4 tours, run 4", xProse[2]) > 0, true)
EndScenario()
? "        [section took " + String((Clock() - nTrSec) / ClocksPerSecond()) + "s]"

#============================================================================
Scenario("The real uuid topic, walked once: the narrated tour kept, the one-off UUID promises diverged")
	nTrSec = Clock()
	Given("base/test/uuid, nine tours, each loading the library in its own child")
	oU = TravellerQ().Silent().Timeout(60000).WalkTopic(tTrHere + "/..", "uuid")
	? oU.Prose()
	Then("nine owned, nine run", NarText(oU.Owned()) + "/" + NarText(oU.Run()), "9/9")
	xN = oU.Records()[1][:run]
	Then("00_uuid_narrated.ring is kept", xN[:state], "kept")
	Then("with four stops", Len(xN[:stops]), 4)
	Then("and 17 claims kept", xN[:kept], 17)
	Then("its first stop took measurable time", Float(xN[:stops][1][:wall_ms]) >= Float(0), true)
	Then("the pf() tours ended finished-timed", oU.Counts()[:finished_timed] >= 6, true)
	Then("the recorded one-off UUIDs diverged, as the narrated file's header says they must",
		oU.Counts()[:diverged] >= 5, true)
	Then("so the topic exits 1", oU.ExitCode(), 1)
	Then("the other topics were named as not walked", Len(oU.TopicsSkipped()) > 100, true)
EndScenario()
? "        [section took " + String((Clock() - nTrSec) / ClocksPerSecond()) + "s]"

_TrUnplantAll(tTrPlant)
? ""
? "[TR1 took " + String((Clock() - nTrStart) / ClocksPerSecond()) + "s]"
Summary()
Shutdown($nNarFail)

#============================================================================
# HELPERS AFTER THE TOP-LEVEL CODE (Ring runs a file until its first func)

func _TrPlantAll(tRoot)
	_TrUnplantAll(tRoot)
	StzMakeDir(tRoot)
	StzMakeDir(tRoot + "/pass")
	StzMakeDir(tRoot + "/fail")
	StzMakeDir(tRoot + "/hang")
	tNl = Char(10)
	Write(tRoot + "/pass/01_kept.ring",
		'? "-- Scene 1: the first stop --"' + tNl +
		'? "  [OK] one is one"' + tNl +
		'? "  [OK] two is two"' + tNl +
		'? "-- Scene 2: the second stop --"' + tNl +
		'? "  [ok] three is three"' + tNl)
	Write(tRoot + "/pass/02_promises.ring",
		"? 1 + 1" + tNl + "#--> 2" + tNl + NL +
		'? "a"  #--> a' + tNl)
	Write(tRoot + "/pass/03_timed.ring",
		'? "  [OK] a claim before the timer"' + tNl +
		'? "Executed in almost 0 second(s)"' + tNl +
		'raise("----------------" + char(10) + "    STOPPED!    ")' + tNl)
	Write(tRoot + "/pass/04_unjudged.ring",
		'? "  [OK] seen"' + tNl +
		"if 1 = 2" + tNl +
		'	? "  [OK] never printed"' + tNl +
		"ok" + tNl)
	Write(tRoot + "/pass/_skipme.ring", '? "  [OK] a helper, not a tour"' + tNl)
	Write(tRoot + "/fail/01_diverge.ring",
		'? "  [OK] one is one"' + tNl +
		'? "  [FAIL] two is three"' + tNl)
	Write(tRoot + "/fail/02_lie.ring",
		"? 1 + 1" + tNl + "#--> 3" + tNl)
	Write(tRoot + "/fail/03_nostart.ring",
		'load "nope_not_here.ring"' + tNl +
		'? "  [OK] never"' + tNl)
	Write(tRoot + "/fail/04_broke.ring",
		'? "  [OK] before the break"' + tNl +
		"x = 1 / 0" + tNl +
		'? "  [OK] after the break"' + tNl)
	Write(tRoot + "/hang/01_hang.ring",
		"n = 0" + tNl +
		"t0 = clock()" + tNl +
		"while (clock() - t0) / clockspersecond() < 30" + tNl +
		"	t1 = clock()" + tNl +
		"	while (clock() - t1) / clockspersecond() < 0.3  end" + tNl +
		"	n++" + tNl +
		'	write("heartbeat.txt", "" + n)' + tNl +
		"end" + tNl +
		'? "  [OK] never"' + tNl)
end
func _TrUnplantAll(tRoot)
	if FExists(tRoot + "/pass/01_kept.ring") or FExists(tRoot + "/hang/01_hang.ring")
		StzDirDeleteAll(tRoot)
	end
end
# testoor.ring as a child, from its own folder, by argv: [ exit code, output ]
# -- the exit code read here is the one the OS hands any parent, a shell
# included
func _TrShell(tTestoorDir, vtArgs)
	oP = new stzProcess()
	vArgv = [ TestoorProgram(), "testoor.ring" ]
	nN = Len(vtArgs)
	for k = 1 to nN
		vArgv + vtArgs[k]
	end
	oP.SpawnIn(tTestoorDir, vArgv)
	tOut = oP.ReadOutputAll()
	nX = oP.Wait()
	oP.Close()
	return [ nX, tOut ]
end
