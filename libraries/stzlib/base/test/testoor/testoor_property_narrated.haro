load "../../stzBase.ring"
load "_narrate.haro"

# TESTOOR V2 -- PROPERTIES. A property is ONE claim checked over many inputs drawn from a declared
# domain, in ONE walk: on Haro a walk pays the library's compile, so a property that started a child
# per input would cost minutes. The core generates the inputs from the domain and a seed, and orders
# the candidates that shrink a failure (TESTOOR_PROTOCOL_3.md section 4); TestoorProperty() only calls
# the check. A property that held raises the nodes it is about on the evidence ladder: to
# GENERALISED, or to EXHAUSTED when every value of a finite domain was tried.
#
# Every positive has its sibling: a domain tried whole and one drawn from; a property that holds and
# one that fails; a failure shrunk to the same smallest input from two seeds; a tour that holds up
# (its nodes rise) beside one that fails (its nodes stay observed).
#
# The text property that fails is chosen to show what a shrink is for: "a text's length in BYTES equals
# its length in LETTERS" is false for any text with a letter outside ASCII, and from any such text the
# shrink arrives at the shortest, simplest one -- the first non-ASCII letter of the alphabet, alone.
# That is the stzlib law "len() counts bytes, StzLen() counts letters", found by a machine.

? "TESTOOR V2 -- properties"
nPrStart = Clock()
tPrHere = CurrentDir()
tPrPlant = tPrHere + "/_planted_property"

#============================================================================
Scenario("The core's domains, through the Ring seam: every value when there are few, else the origin and seeded draws")
	nPrSec = Clock()
	Given("a dec domain of 26 values, asked for up to 100 inputs")
	xPrD = StzJsonToList(StzEngineTestoorProperty('{"op":"inputs","domain":"rate dec 0..0.25 step 0.01","seed":42,"tries":100}'))
	Then("it is tried whole: exhaustive, 26 of 26", NarText(xPrD[:exhaustive]) + "/" + NarText(xPrD[:of]) + "/" + NarText(Len(xPrD[:inputs])), "1/26/26")
	Then("a dec is exact text, never a float: the first, the eighth and the last",
	     xPrD[:inputs][1][:rate] + " " + xPrD[:inputs][8][:rate] + " " + xPrD[:inputs][26][:rate], "0.00 0.07 0.25")
	Given("an int domain of 101 values, asked for 10")
	xPrI = StzJsonToList(StzEngineTestoorProperty('{"op":"inputs","domain":"n int 0..100","seed":42,"tries":10}'))
	Then("it is drawn from: not exhaustive, of 101, ten inputs", NarText(xPrI[:exhaustive]) + "/" + NarText(xPrI[:of]) + "/" + NarText(Len(xPrI[:inputs])), "0/101/10")
	Then("the first input is the origin, the value nearest zero", xPrI[:inputs][1][:n], 0)
	nPrOut = 0
	for nPr = 1 to Len(xPrI[:inputs])
		if xPrI[:inputs][nPr][:n] < 0 or xPrI[:inputs][nPr][:n] > 100  nPrOut++  end
	end
	Then("every draw is inside the domain", nPrOut, 0)
	xPrI2 = StzJsonToList(StzEngineTestoorProperty('{"op":"inputs","domain":"n int 0..100","seed":42,"tries":10}'))
	xPrI3 = StzJsonToList(StzEngineTestoorProperty('{"op":"inputs","domain":"n int 0..100","seed":43,"tries":10}'))
	Then("the same seed draws the same inputs", _PrJoin(xPrI[:texts]) = _PrJoin(xPrI2[:texts]), true)
	Then("another seed draws others", _PrJoin(xPrI[:texts]) = _PrJoin(xPrI3[:texts]), false)
	Given("a text domain over every alphabet")
	xPrT = StzJsonToList(StzEngineTestoorProperty('{"op":"inputs","domain":"s text 0..12 of mixed","seed":5,"tries":20}'))
	Then("it is unbounded: no size is written", StzFindFirst('"of"', StzEngineTestoorProperty('{"op":"inputs","domain":"s text 0..12 of mixed","seed":5,"tries":2}')), 0)
	Then("and its origin is the empty text", xPrT[:inputs][1][:s], "")
	Given("a failing input, and the candidates the core offers to shrink it")
	xPrS = StzJsonToList(StzEngineTestoorProperty('{"op":"shrink","domain":"n int 0..100","input":{"n":100}}'))
	Then("an int halves its distance to zero: 0, 50, 75, 88, 94, 97, 99", _PrValues(xPrS[:candidates], :n), "0,50,75,88,94,97,99")
	xPrS2 = StzJsonToList(StzEngineTestoorProperty('{"op":"shrink","domain":"s text 0..5 of ascii","input":{"s":"ab"}}'))
	Then("a text gets shorter first, then its letters earlier: '', a, b, aa", _PrValues(xPrS2[:candidates], :s), ",a,b,aa")
	Then("a domain the core cannot read raises a Ring error and breaks nothing", _PrRaises('{"op":"inputs","domain":"n int 9..1","tries":3}'), 1)
	Then("so does an input that is not one of the domain's values", _PrRaises('{"op":"shrink","domain":"n int 0..4","input":{"n":9}}'), 1)
EndScenario()
? "        [section took " + String((Clock() - nPrSec) / ClocksPerSecond()) + "s]"

#============================================================================
Scenario("TestoorProperty in this process: held whole, failed and shrunk to the same answer from two seeds")
	nPrSec = Clock()
	Given("a square is never negative, over every int from -50 to 50")
	xPrA = TestoorProperty("SQUARE-NOT-NEGATIVE", "n int -50..50", "_PrSquareNotNegative", [ [:tries, 200], [:seed, 5], [:print, 0] ])
	Then("it held, and every value was tried: exhausted", NarText(xPrA[:held]) + "/" + NarText(xPrA[:exhaustive]) + "/" + NarText(xPrA[:tried]) + "/" + NarText(xPrA[:of]), "1/1/101/101")
	Given("a square is under 50, over 0 to 100 -- false from 8 on")
	xPrB = TestoorProperty("SQUARE-UNDER-50", "n int 0..100", "_PrSquareUnder50", [ [:tries, 20], [:seed, 5], [:print, 0] ])
	xPrB2 = TestoorProperty("SQUARE-UNDER-50", "n int 0..100", "_PrSquareUnder50", [ [:tries, 20], [:seed, 6], [:print, 0] ])
	Then("it failed", xPrB[:held], 0)
	Then("and shrank to the smallest counterexample, 8", xPrB[:counterexample], '{"n":8}')
	Then("from another seed, to the same 8", xPrB2[:counterexample], '{"n":8}')
	Then("the shrink's path ends where the counterexample is", xPrB[:path][Len(xPrB[:path])], '{"n":8}')
	Given("a text's length in bytes equals its length in letters, over texts in every alphabet")
	xPrC = TestoorProperty("BYTES-ARE-LETTERS", "s text 0..8 of mixed", "_PrBytesAreLetters", [ [:tries, 200], [:seed, 5], [:print, 0] ])
	xPrC2 = TestoorProperty("BYTES-ARE-LETTERS", "s text 0..8 of mixed", "_PrBytesAreLetters", [ [:tries, 200], [:seed, 6], [:print, 0] ])
	Then("it failed: len() counts bytes", xPrC[:held], 0)
	Then("and shrank to ONE letter, the first outside ASCII: U+00E0", xPrC[:counterexample], '{"s":"' + _PrUtf8(224) + '"}')
	Then("from another seed, to the same letter", xPrC2[:counterexample], xPrC[:counterexample])
	Given("the library's own law: replacing a letter by a letter keeps the length in letters, over texts in every alphabet")
	xPrD2 = TestoorProperty("REPLACE-KEEPS-LENGTH", "s text 0..12 of mixed", "_PrReplaceKeepsLength", [ [:tries, 200], [:seed, 5], [:print, 0] ])
	Then("it held over 200 texts; the domain is unbounded, so the grade it gives is generalised, not exhausted",
	     NarText(xPrD2[:held]) + "/" + NarText(xPrD2[:exhaustive]) + "/" + NarText(xPrD2[:tried]) + "/" + NarText(xPrD2[:of]), "1/0/200/")
	Given("a choice among three algorithms, where the last one fails")
	xPrE = TestoorProperty("NOT-HEAP", "algo one quick|merge|heap", "_PrNotHeap", [ [:tries, 10], [:print, 0] ])
	Then("all three were tried, the third failed, and nothing simpler fails", NarText(xPrE[:held]) + "/" + NarText(xPrE[:tried]) + "/" + NarText(xPrE[:shrinks]) + "/" + NarText(xPrE[:counterexample]), '0/3/0/{"algo":"heap"}')
	Given("the line TestoorProperty prints, judged by the core as a child's output")
	tPrOut = "250" + Char(9) + "[testoor stop squares]" + Char(10) + "500" + Char(9) + "[testoor node stzMath.Square 20]" + Char(10) +
	         "750" + Char(9) + xPrB[:line] + Char(10) + "1000" + Char(9) + "[testoor end timed]" + Char(10)
	xPrV = StzJsonToList(StzEngineTestoorVerdict('{"record":{"file":"squares.ring","dialect":"protocol","asserts":1,"stops":[],"routes":[]},"output":' +
	        _TourJsonStr(tPrOut) + ',"meta":{"exit":0,"hung":0,"stderr":"","wall_ms":1000,"seed":5,"unreadable":0,"face":{"ignore":"","endings":[]}}}'))
	Then("the property is the stop's claim, and it diverged", xPrV[:stops][1][:claims][1][:claim] + ":" + xPrV[:stops][1][:claims][1][:state], "property SQUARE-UNDER-50:diverged")
	Then("the tour keeps the record, counterexample included", xPrV[:properties][1][:counterexample][:n], 8)
EndScenario()
? "        [section took " + String((Clock() - nPrSec) / ClocksPerSecond()) + "s]"

#============================================================================
Scenario("Lists: stzList's own Verb/Verbed pairs checked over generated lists of numbers, texts in every alphabet, and lists of lists")
	nPrSec = Clock()
	Given("a list domain through the seam: lists of up to two 0s and 1s")
	xPrL = StzJsonToList(StzEngineTestoorProperty('{"op":"inputs","domain":"xs list 0..2 of int 0..1","seed":1,"tries":10}'))
	Then("seven lists, tried whole, shortest first", NarText(xPrL[:exhaustive]) + "/" + NarText(xPrL[:of]) + "/" + NarText(_PrJoin(xPrL[:texts])),
	     '1/7/{"xs":[]}|{"xs":[0]}|{"xs":[1]}|{"xs":[0,0]}|{"xs":[0,1]}|{"xs":[1,0]}|{"xs":[1,1]}|')
	xPrLS = StzJsonToList(StzEngineTestoorProperty('{"op":"shrink","domain":"xs list 0..5 of int 0..9","input":{"xs":[3,1]}}'))
	Then("a list shrinks shorter first, then element by element", _PrJoin(xPrLS[:texts]),
	     '{"xs":[]}|{"xs":[3]}|{"xs":[1]}|{"xs":[0,1]}|{"xs":[2,1]}|{"xs":[3,0]}|')
	Given("Reverse() and Reversed(), over lists of numbers")
	xPrR = TestoorProperty("LIST-REVERSE-PAIR", "xs list 0..12 of int -50..50", "_PrReversePair", [ [:tries, 150], [:seed, 5], [:print, 0] ])
	Then("Reverse() leaves the list as Reversed() returns it", xPrR[:held], 1)
	xPrR2 = TestoorProperty("LIST-REVERSE-TWICE", "ws list 0..8 of text 0..4 of mixed", "_PrReverseTwice", [ [:tries, 150], [:seed, 5], [:print, 0] ])
	Then("and reversing twice gives the list back, over texts in every alphabet", xPrR2[:held], 1)
	Given("Sort() and Sorted()")
	xPrS = TestoorProperty("LIST-SORT-PAIR", "xs list 0..12 of int -50..50", "_PrSortPair", [ [:tries, 150], [:seed, 5], [:print, 0] ])
	Then("Sort() leaves the list as Sorted() returns it", xPrS[:held], 1)
	xPrS2 = TestoorProperty("LIST-SORTED-IN-ORDER", "xs list 0..12 of int -50..50", "_PrSortedInOrder", [ [:tries, 150], [:seed, 5], [:print, 0] ])
	Then("Sorted() puts every number before the next, and keeps the length", xPrS2[:held], 1)
	xPrS3 = TestoorProperty("LIST-SORT-TWICE", "ws list 0..8 of text 0..4 of mixed", "_PrSortTwice", [ [:tries, 150], [:seed, 5], [:print, 0] ])
	Then("sorting a sorted list of texts changes nothing", xPrS3[:held], 1)
	Given("Flatten() and Flattened(), over lists of lists")
	xPrF = TestoorProperty("LIST-FLATTEN-PAIR", "ls list 0..4 of list 0..3 of int 0..9", "_PrFlattenPair", [ [:tries, 150], [:seed, 5], [:print, 0] ])
	Then("Flatten() leaves the list as Flattened() returns it", xPrF[:held], 1)
	xPrF2 = TestoorProperty("LIST-FLATTEN-COUNTS", "ls list 0..4 of list 0..3 of int 0..9", "_PrFlattenCounts", [ [:tries, 150], [:seed, 5], [:print, 0] ])
	Then("Flattened() keeps every element: its length is the sum of the inner lengths", xPrF2[:held], 1)
	Given("a law that is false: a list equals itself sorted")
	xPrX = TestoorProperty("LIST-IS-SORTED", "xs list 0..8 of int 0..9", "_PrIsSorted", [ [:tries, 100], [:seed, 5], [:print, 0] ])
	xPrX2 = TestoorProperty("LIST-IS-SORTED", "xs list 0..8 of int 0..9", "_PrIsSorted", [ [:tries, 100], [:seed, 6], [:print, 0] ])
	Then("it fails, and shrinks to the smallest unsorted list, [1,0]", xPrX[:counterexample], '{"xs":[1,0]}')
	Then("from another seed, to the same [1,0]", xPrX2[:counterexample], '{"xs":[1,0]}')
EndScenario()
? "        [section took " + String((Clock() - nPrSec) / ClocksPerSecond()) + "s]"

#============================================================================
tPrExe = TestoorNativeExe()
if tPrExe = ""
	? ""
	? "SKIPPED by name, because the native runner is not built:"
	? "  the property tours walked as children (cd engine && zig build testoor-exe -j2)"
else
Scenario("Property tours walked as children, the ladder asked for: a tour that holds up raises its node, one that fails does not")
	nPrSec = Clock()
	_PrPlant(tPrPlant)
	vtPr = [ tPrPlant + "/replace_tour.ring", tPrPlant + "/bytes_tour.ring" ]
	Given("one tour whose text property holds, one whose text property fails; each loads the library")
	Write(tPrPlant + "/manifest.json", TestoorManifestJson(vtPr, [ [:seed, 5], [:timeout_ms, 180000], [:ladder, true] ]))
	xPrN = _PrRun([ "run", tPrPlant + "/manifest.json", "--json" ])
	xPrJ = StzJsonToList(xPrN[2])
	Then("the run is protocol 3 and exits 1, for the failing tour", NarText(xPrJ[:protocol]) + "/" + NarText(xPrN[1]), "3/1")
	Then("the first tour kept its property", xPrJ[:tours][1][:state] + ":" + NarText(xPrJ[:tours][1][:properties][1][:held]), "kept:1")
	Then("the second diverged, its counterexample shrunk to one letter in the child too", xPrJ[:tours][2][:properties][1][:counterexample][:s], _PrUtf8(224))
	Then("Replace is generalised, by the property that held", xPrJ[:ladder][:nodes][1][:id] + ":" + xPrJ[:ladder][:nodes][1][:grade] + ":" +
	     xPrJ[:ladder][:nodes][1][:properties][1], "stzString.Replace:generalised:REPLACE-KEEPS-LENGTH")
	Then("Len stays observed: a tour that failed raises nothing", xPrJ[:ladder][:nodes][2][:id] + ":" + xPrJ[:ladder][:nodes][2][:grade], "stzString.Len:observed")
	Then("the ladder counts grades 3 and 4 when a run carries properties", NarText(xPrJ[:ladder][:generalised]) + "/" + NarText(xPrJ[:ladder][:exhausted]), "1/0")
	xPrP = _PrRun([ "run", tPrPlant + "/manifest.json", "--prose" ])
	Then("the prose shows the counterexample and the seed that replays it",
	     StzFindFirst("counterexample  BYTES-ARE-LETTERS  {" + '"s":"' + _PrUtf8(224) + '"}  (seed 5,', xPrP[2]) > 0, true)
	_PrUnplant(tPrPlant)
EndScenario()
? "        [section took " + String((Clock() - nPrSec) / ClocksPerSecond()) + "s]"
end

? ""
? "[V2 took " + String((Clock() - nPrStart) / ClocksPerSecond()) + "s]"
Summary()
Shutdown($nNarFail)

#============================================================================
# HELPERS AFTER THE TOP-LEVEL CODE

func _PrSquareNotNegative(pxIn)
	return pxIn[:n] * pxIn[:n] >= 0
end
func _PrSquareUnder50(pxIn)
	return pxIn[:n] * pxIn[:n] < 50
end
func _PrBytesAreLetters(pxIn)
	return Len(pxIn[:s]) = StzLen(pxIn[:s])
end
func _PrReplaceKeepsLength(pxIn)
	return StzLen(StzReplace(pxIn[:s], "a", "b")) = StzLen(pxIn[:s])
end
func _PrNotHeap(pxIn)
	return pxIn[:algo] != "heap"
end
func _PrReversePair(pxIn)
	oO = new stzList(pxIn[:xs])
	oO.Reverse()
	return oO.IsStrictlyEqualTo(new stzList(pxIn[:xs]).Reversed())
end
func _PrReverseTwice(pxIn)
	return new stzList(new stzList(new stzList(pxIn[:ws]).Reversed()).Reversed()).IsStrictlyEqualTo(pxIn[:ws])
end
func _PrSortPair(pxIn)
	oO = new stzList(pxIn[:xs])
	oO.Sort()
	return oO.IsStrictlyEqualTo(new stzList(pxIn[:xs]).Sorted())
end
func _PrSortedInOrder(pxIn)
	vA = new stzList(pxIn[:xs]).Sorted()
	if Len(vA) != Len(pxIn[:xs])  return 0  end
	for i = 2 to Len(vA)
		if vA[i - 1] > vA[i]  return 0  end
	end
	return 1
end
func _PrSortTwice(pxIn)
	vA = new stzList(pxIn[:ws]).Sorted()
	return new stzList(new stzList(vA).Sorted()).IsStrictlyEqualTo(vA)
end
func _PrFlattenPair(pxIn)
	oO = new stzList(pxIn[:ls])
	oO.Flatten()
	return oO.IsStrictlyEqualTo(new stzList(pxIn[:ls]).Flattened())
end
func _PrFlattenCounts(pxIn)
	nN = 0
	for i = 1 to Len(pxIn[:ls])
		nN += Len(pxIn[:ls][i])
	end
	return Len(new stzList(pxIn[:ls]).Flattened()) = nN
end
func _PrIsSorted(pxIn)
	return new stzList(pxIn[:xs]).IsStrictlyEqualTo(new stzList(pxIn[:xs]).Sorted())
end
func _PrJoin(pvtList)
	tC = ""
	for i = 1 to Len(pvtList)
		tC += pvtList[i] + "|"
	end
	return tC
end
# one dimension's values across a list of inputs, joined by commas
func _PrValues(pxIns, ptKey)
	tC = ""
	for i = 1 to Len(pxIns)
		if i > 1  tC += ","  end
		tC += NarText(pxIns[i][ptKey])
	end
	return tC
end
func _PrRaises(ptReq)
	nB = 0
	try
		StzEngineTestoorProperty(ptReq)
	catch
		nB = 1
	end
	return nB
end
# a code point as its UTF-8 bytes (two bytes below U+0800, which is all this guard needs)
func _PrUtf8(pnCp)
	if pnCp < 128  return Char(pnCp)  end
	return Char(192 + Floor(pnCp / 64)) + Char(128 + (pnCp % 64))
end
func _PrRun(pvtArgs)
	oP = new stzProcess()
	vArgv = [ TestoorNativeExe() ]
	for i = 1 to Len(pvtArgs)
		vArgv + pvtArgs[i]
	end
	oP.SpawnIn(CurrentDir(), vArgv)
	tOut = oP.ReadOutputAll()
	nX = oP.Wait()
	oP.Close()
	return [ nX, tOut ]
end
func _PrPlant(ptRoot)
	_PrUnplant(ptRoot)
	StzMakeDir(ptRoot)
	tN = Char(10)
	Write(ptRoot + "/replace_tour.ring",
		'load "../../../stzBase.ring"' + tN +
		'? "[testoor stop replace keeps the length of any text]"' + tN +
		'? "[testoor node stzString.Replace]"' + tN +
		'TestoorProperty("REPLACE-KEEPS-LENGTH", "s text 0..12 of mixed", "KeepsLength", [ :tries = 150, :seed = 5, :nodes = [ "stzString.Replace" ] ])' + tN +
		"func KeepsLength(paIn)" + tN +
		'	return StzLen(StzReplace(paIn[:s], "a", "b")) = StzLen(paIn[:s])' + tN)
	Write(ptRoot + "/bytes_tour.ring",
		'load "../../../stzBase.ring"' + tN +
		'? "[testoor stop a text has as many bytes as letters]"' + tN +
		'? "[testoor node stzString.Len]"' + tN +
		'TestoorProperty("BYTES-ARE-LETTERS", "s text 0..8 of mixed", "BytesAreLetters", [ :tries = 150, :seed = 5, :nodes = [ "stzString.Len" ] ])' + tN +
		"func BytesAreLetters(paIn)" + tN +
		"	return len(paIn[:s]) = StzLen(paIn[:s])" + tN)
end
func _PrUnplant(ptRoot)
	if FExists(ptRoot + "/replace_tour.ring")
		StzDirDeleteAll(ptRoot)
	end
end
