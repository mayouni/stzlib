-- bound.stzui -- the same console, with its live values DECLARED.
--
-- A placeholder is an ordinary string with braces in it, which is the
-- whole point: the Grammar Commons fixes what a field value may be, and
-- `CONTENT @bearing` would mint a new kind of value for one plane's
-- convenience. `"{bearing}"` is a string. Nothing about the format
-- changed, every older document still parses, and the round-trip
-- fixpoint still holds.

DEFINE PANEL console (
  SIZE [512, 320],
  DIRECTION column,
  FONT "app",
  BACKGROUND "#0d1219",
  PADDING 20,
  GAP 14,
  CHILDREN [header, readout, actions, footer]
) RATIONALE "A console whose numbers move, declared once and bound after."

DEFINE STYLE button (
  HEIGHT 56,
  PADDING 14,
  TEXT_ALIGN center,
  FOCUSABLE yes,
  ROLE button
) RATIONALE "An action a pilot can reach by keyboard or by pointing at it."

DEFINE BOX header (
  HEIGHT 44,
  BACKGROUND "#1b3a5c",
  PADDING 10,
  CHILDREN [title]
) RATIONALE "The top edge."

DEFINE TEXT title (
  CONTENT "NAV CONSOLE - {mode}",
  SIZE 22,
  COLOR "#cfe6ff",
  ROLE heading
) RATIONALE "Names the screen, and says which mode it is in."

DEFINE BOX readout (
  HEIGHT 96,
  BACKGROUND "#131c26",
  PADDING 14,
  DIRECTION column,
  GAP 6,
  CHILDREN [line_one, line_two]
) RATIONALE "The instrument area: two lines of live text."

DEFINE TEXT line_one (
  CONTENT "BEARING {bearing}   RANGE {range} km",
  SIZE 17,
  COLOR "#9fe0b0"
) RATIONALE "Two values on one line -- so a set of one must not disturb the other."

DEFINE TEXT line_two (
  CONTENT "drift {drift} - hull {hull}%",
  SIZE 15,
  COLOR "#6f8ba6"
) RATIONALE "Secondary state, bound the same way."

DEFINE BOX actions (
  DIRECTION row,
  HEIGHT 56,
  GAP 12,
  CHILDREN [fire, abort]
) RATIONALE "Two commands, side by side."

DEFINE BOX fire (
  STYLE button,
  WIDTH 200,
  BACKGROUND "#a8322c",
  LABEL "Fire",
  CHILDREN [fire_text]
) RATIONALE "The act."

DEFINE TEXT fire_text (
  CONTENT "FIRE",
  SIZE 18,
  COLOR "#ffffff"
) RATIONALE "An UNBOUND label, deliberately: a binding must not touch it."

DEFINE BOX abort (
  STYLE button,
  WIDTH 120,
  BACKGROUND "#33404e",
  LABEL "Abort",
  CHILDREN [abort_text]
) RATIONALE "The way back, which Rule 80 requires to exist."

DEFINE TEXT abort_text (
  CONTENT "ABORT",
  SIZE 18,
  COLOR "#dce6f2"
) RATIONALE "Also unbound."

DEFINE TEXT footer (
  CONTENT "use {} for a set - this brace is prose, not a binding",
  SIZE 13,
  COLOR "#54697f",
  ROLE status
) RATIONALE "A lone empty brace must survive a template language untouched."
