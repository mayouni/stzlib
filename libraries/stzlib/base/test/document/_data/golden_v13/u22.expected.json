      "level": 0,
      "text": "Lifting in the processing plant"
    },
    {
      "level": 1,
      "text": "Repair the overhead hoist and add it to the critical equipment list."
    },
    {
      "level": 1,
      "text": "Supply two mobile lifting frames for the pump workshop."
    },
    {
      "level": 0,
      "text": "Ground control underground"
    },
    {
      "level": 1,
      "text": "Re-train scaling crews on level 9 before work resumes in the area."
    },
    {
      "level": 1,
      "text": "Install additional mesh on the hanging wall of the main drive."
    },
    {
      "level": 0,
      "text": "Repeat the chute unblocking procedure with every plant shift and record attendance."
    },
    {
      "level": 0,
      "text": "Safety"
    },
    {
      "level": 1,
      "text": "Complete the lifting equipment audit in all workshops."
    },
    {
      "level": 1,
      "text": "Run a fatigue management campaign for night shift operators."
    },
    {
      "level": 0,
      "text": "Production"
    },
    {
      "level": 1,
      "text": "Recover 15,000 tonnes of the waste stripping deficit."
    },
