  "list_items": [
    {
      "level": 0,
      "text": "Distribution started three weeks earlier than in 2025 because seed was pre-positioned in the commune stores in May."
    },
    {
      "level": 0,
      "text": "Women made up a larger share of members than in any previous campaign, mainly through the new market gardening groups."
    },
    {
      "level": 0,
      "text": "Two distribution points in the Gaya Plateau commune could not be reached by truck after the heavy rains of 28 June; inputs were carried the last kilometres by cart."
    },
    {
      "level": 0,
      "text": "No losses or thefts were reported, and all delivery notes were countersigned by the village chiefs."
    },
    {
      "level": 0,
      "text": "Keep the May pre-positioning of seed, and add a fourth commune store in the Gaya Plateau."
    },
    {
      "level": 0,
      "text": "Reduce urea quantities for groups farming the sandy soils of the plateau, where losses to leaching are high."
    },
    {
      "level": 0,
      "text": "Train group treasurers to record the planting date of each plot so that yields can be compared across varieties."
    }
  ],
