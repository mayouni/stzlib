      "level": 0,
      "text": "Anggota hadir paling lambat sepuluh menit sebelum latihan dimulai."
    },
    {
      "level": 0,
      "text": "Pakaian dan sepatu:"
    },
    {
      "level": 1,
      "text": "wajib memakai sepatu khusus bulu tangkis bersol karet putih;"
    },
    {
      "level": 1,
      "text": "kaus klub dipakai pada setiap pertandingan liga."
    },
    {
      "level": 0,
      "text": "Kok latihan disediakan klub; kok pertandingan dibeli oleh pemain."
    },
    {
      "level": 0,
      "text": "Ketidakhadiran lebih dari tiga kali berturut-turut tanpa izin dilaporkan kepada orang tua atau wali."
