  "list_items": [
    {
      "level": 0,
      "text": "(a) Add a camera and proximity alarm test to the haul truck pre-start checklist."
    },
    {
      "level": 0,
      "text": "(b) Fit camera fault warnings to the dispatch system so that faults are visible to the controller."
    },
    {
      "level": 0,
      "text": "(c) Brief all haul truck operators on dump approach procedures by 31 October."
    },
    {
      "level": 0,
      "text": "Complete the pre-strip of Stage 5 bench 3 to secure ore supply for November."
    },
    {
      "level": 0,
      "text": "Return HT-08 to service with a rebuilt final drive."
    },
    {
      "level": 0,
      "text": "Finish the tailings dam wall raise to RL 912 before the wet season."
    },
    {
      "level": 0,
      "text": "Close out all three actions from the September high-potential incident."
    }
