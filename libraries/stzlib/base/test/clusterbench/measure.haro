# MEASURES THE HEARING FACULTIES -- WHISPER-CATALOG-01: the registry's evidence for :transcribe and :spoken-language.
#
#     HARO_NOCACHE=1 haro measure.haro [transcribe | spoken-language]      (both when none is named)
#
# From this folder, with STZ_ENGINE_DIR (an engine whose stz_neural has the Whisper builtins) and STZ_MODELS_DIR (the
# folder holding speech/ggml-small.bin and speech/ggml-small-hausa.bin) set; the recordings fetched first
# (`powershell -File _rig/speak.ps1` and `python -I _rig/fleurs_fetch.py`). A heavy job: about twenty Whisper runs an
# implementation.
#
# The golden sets, fixed before this ran:
#
#   hearing-v2           :transcribe: the key-word tasks (kind `heard`) of tasks.tsv -- eight
#                        French and English sentences spoken by the Windows voices, two Arabic and two Hausa sentences
#                        read by FLEURS' speakers -- and hausa_fresh.tsv, ten more Hausa recordings whose key words a
#                        rule fixed before any model heard them. Each item is [ [:audio, path], [:language, code] ]: the
#                        call names its language, as a caller who knows it does. (hearing-v1 was the first twelve,
#                        told nothing; its rows stay on record. The first hearing-v2 run of 2026-11-16 was also filed
#                        per language, rows kept: no language had items enough for the court, so the faculty is
#                        resolved on the whole set.)
#   spoken-language-v1   :spoken-language, spoken_language.tsv: the first five FLEURS test recordings in French,
#                        English, Arabic and Hausa
#
# Runs every implementation on its faculty's golden set (StzRunGoldens: the floor first, then Whisper small), which
# records the measurements and the court's evidence, then writes them to base/sound/hearing.zmdl.txt and
# base/sound/hearing.court.txt, and prints the plan the registry now resolves for each faculty.

load "../../stzBase.ring"

tHere = CurrentDir() + "/recordings/"
tOnly = ""
nArgs = Len(SysArgv)
for i = 1 to nArgs
	if Right(SysArgv[i], 12) = "measure.haro" and i < nArgs
		tOnly = SysArgv[i + 1]
	end
end

oT = StzFacultyQ("transcribe")
vTasks = Split(Read("tasks.tsv"), Char(10))
nTasks = Len(vTasks)
for i = 2 to nTasks
	vF = StzSplit(StzReplace(vTasks[i], Char(13), ""), Char(9))    # StzSplit: a plain Split here also cuts at spaces
	if Len(vF) >= 6 and vF[3] = "heard"
		oT.AddGolden([ [:audio, tHere + vF[4]], [:language, LanguageOfRecording(vF[4])] ], vF[6])
	end
end
vFresh = Split(Read("hausa_fresh.tsv"), Char(10))
nFresh = Len(vFresh)
for i = 1 to nFresh
	vF = StzSplit(StzReplace(vFresh[i], Char(13), ""), Char(9))
	if Len(vF) >= 3 and Left(vF[1], 7) = "fleurs/"
		oT.AddGolden([ [:audio, tHere + vF[1]], [:language, vF[2]] ], vF[3])
	end
end

oL = StzFacultyQ("spoken-language")
vRows = Split(Read("spoken_language.tsv"), Char(10))
nRows = Len(vRows)
for i = 2 to nRows
	vF = StzSplit(StzReplace(vRows[i], Char(13), ""), Char(9))
	if Len(vF) >= 2
		oL.AddGolden(tHere + vF[1], vF[2])
	end
end

? "golden items: transcribe " + String(Len(oT.Goldens())) + ", spoken-language " + String(Len(oL.Goldens()))

if tOnly = "" or tOnly = "transcribe"
	nStart = Clock()
	vM = StzRunGoldens("transcribe", [])
	? "transcribe measured in " + String(Floor((Clock() - nStart) / ClocksPerSecond())) + " s"
end
if tOnly = "" or tOnly = "spoken-language"
	nStart = Clock()
	vM = StzRunGoldens("spoken-language", [])
	? "spoken-language measured in " + String(Floor((Clock() - nStart) / ClocksPerSecond())) + " s"
end

StzSaveMeasurementsOf(StzHearingMeasurementsFile(), [ "transcribe", "spoken-language" ])
StzSaveCourtOf(StzHearingCourtFile(), [ "transcribe", "spoken-language" ])
? Read(StzHearingMeasurementsFile())
? Read(StzHearingCourtFile())

vFac = [ "transcribe", "spoken-language" ]
for i = 1 to 2
	oP = StzModelRegistryQ().ResolveQ(vFac[i])
	? vFac[i] + " -> " + oP.Chosen() + " (" + oP.Kind() + ")"
end
vLangs = [ "fr", "en", "ar", "ha" ]
for i = 1 to 4
	oP = StzModelRegistryQ().ResolveQ(StzRequirementQ("transcribe").RequireLanguagesQ([ vLangs[i] ]))
	? "transcribe in " + vLangs[i] + " -> " + oP.Chosen() + " (" + oP.Kind() + ")"
end

# the language of a hearing task's recording, from its name
func LanguageOfRecording(tWav)
	if Left(tWav, 13) = "fleurs/ar_eg/"
		return "ar"
	end
	if Left(tWav, 13) = "fleurs/ha_ng/"
		return "ha"
	end
	if Left(tWav, 2) = "en"
		return "en"
	end
	return "fr"
end
