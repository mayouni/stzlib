root ::= "<a2ui>\n" stmt ("\n" stmt)* "\n</a2ui>"
stmt ::= ident " = " call | path " = " value
call ::= cname "(" args? ")"
cname ::= "Text" | "Button" | "Row" | "Column" | "Card" | "Divider" | "TextField" | "CheckBox" | "ChoicePicker" | "Slider" | "DateTimeInput"
args ::= arg (", " arg)*
arg ::= ident "=" value | value
value ::= call | event | string | number | "true" | "false" | path | ident | array | map
event ::= "Event(" string ")"
array ::= "[" (value (", " value)*)? "]"
map ::= "{" (ident ": " value (", " ident ": " value)*)? "}"
path ::= "$/" [a-zA-Z0-9_/]+
string ::= "\"" ([^"\\\n] | "\\" ["\\nt])* "\""
number ::= "-"? [0-9]+ ("." [0-9]+)?
ident ::= [a-zA-Z_] [a-zA-Z0-9_]*
