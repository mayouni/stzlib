root ::= ws decl (ws decl)* ws
decl ::= "DEFINE" sp kind sp ident ws "(" ws fields? ws ")"
kind ::= "INTENT_FLOW" | "FORM" | "WIZARD" | "SCREEN" | "COMPONENT" | "NAV_GRAPH" | "WORLD_VIEW" | "INTERACTION" | "FEEDBACK" | "VIBE"
fields ::= field (ws "," ws field)* (ws ",")?
field ::= verbkey ws "[" ws verbs? ws "]" | idkey ws "[" ws idents? ws "]" | kvkey sp scalar
verbkey ::= "SATISFIES" | "ALWAYS_REACHABLE"
idkey ::= "VISIBLE_ENTITIES" | "VISIBLE_STATE" | "INTENT_FLOWS" | "STEPS" | "REPORTS" | "SUPPRESSES" | "SIGNALS" | "ENTRIES"
kvkey ::= "INTENT_FLOW" | "PERSPECTIVE" | "TONE" | "SURFACE_AS" | "DENSITY" | "MOTION" | "ROLE" | "LABEL" | "TARGET" | "ACTOR"
verbs ::= verb (ws "," ws verb)* (ws ",")?
verb ::= "DISCOVER" | "UNDERSTAND" | "LOCATE" | "FOCUS" | "FILTER" | "COMPARE" | "READ" | "SCAN" | "SCROLL" | "ZOOM" | "SELECT" | "HIGHLIGHT" | "PREVIEW" | "MARK" | "ACT" | "CONFIRM" | "CANCEL" | "UNDO" | "PAUSE" | "RESUME" | "RETRY" | "EXIT"
idents ::= ident (ws "," ws ident)* (ws ",")?
scalar ::= ident | string | number
ident ::= [a-zA-Z_] [a-zA-Z0-9_]*
string ::= "\"" [^"\n]* "\""
number ::= "-"? [0-9]+ ("." [0-9]+)?
ws ::= ([ \t\r\n] | "//" [^\n]* "\n")*
sp ::= [ \t\r\n]+
