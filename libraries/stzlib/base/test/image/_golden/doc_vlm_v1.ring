	_a_ + [ pcDir + "v10_q01.png", [ :sentences = [ "This invoice covers the tenant survey analysis delivered under the agreement signed on 4 August 2026.", "All amounts are shown in pounds sterling.", "Please pay by bank transfer within 30 days and quote the invoice number as your reference.", "Our bank details are printed on the remittance advice sent with this invoice.", "Late payments may incur interest at 8% above the Bank of England base rate under the Late Payment of Commercial Debts Act.", "The data cleaning line reflects twelve hours, two more than estimated, as agreed by email on 17 September." ], :headings = [ "Tax Invoice", "Bill to", "Invoice details", "Payment", "Notes" ], :tables = [ [ [ "Invoice number", "INV-2026-0418" ], [ "Invoice date", "2 October 2026" ], [ "Due date", "1 November 2026" ], [ "Purchase order", "HCHT-PO-7731" ] ], [ [ "Description", "Qty", "Unit price", "Amount" ], [ "Survey design workshop (half day)", "1", "£650.00", "£650.00" ], [ "Questionnaire hosting and reminders, per month", "3", "£120.00", "£360.00" ], [ "Data cleaning and weighting", "12", "£85.00", "£1,020.00" ], [ "Analysis report with estate-level breakdown", "1", "£1,400.00", "£1,400.00" ], [ "Presentation to the board of trustees", "1", "£300.00", "£300.00" ], [ "Subtotal", "Subtotal", "Subtotal", "£3,730.00" ], [ "VAT at 20%", "VAT at 20%", "VAT at 20%", "£746.00" ], [ "Total due", "Total due", "Total due", "£4,476.00" ] ] ], :lists = [  ], :furniture = [ "Larkspur Analytics Ltd", "14 Coppergate Yard, Norwich NR3 1HX", "accounts@larkspur-analytics.example · +44 1603 555 0192", "VAT reg. GB 318 4402 77", "Registered in England and Wales, company no. 10928364", "Page 1 of 1" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v11_r01.png", [ :sentences = [ "Please pay by bank transfer within 30 days of the invoice date.", "Quote the invoice number INV-2026-0417 as the payment reference.", "The support retainer covers the period from 1 September to 30 September 2026.", "Hardware items remain our property until they are paid in full.", "Late payments may incur interest at 4% above the base rate.", "Thank you for your business." ], :headings = [ "INVOICE", "Bill to", "Deliver to", "Payment instructions", "Notes" ], :tables = [ [ [ "Invoice no.", "INV-2026-0417" ], [ "Invoice date", "2 October 2026" ], [ "Due date", "1 November 2026" ], [ "Customer reference", "PO 7781-B" ], [ "Account manager", "Ines Varga" ] ], [ [ "Item", "Description", "Qty", "Unit price", "Amount" ], [ "SR-01", "Support retainer, September 2026", "1", "2,400.00", "2,400.00" ], [ "DV-14", "Custom report module Development days, 14 to 21 September", "6", "640.00", "3,840.00" ], [ "TR-02", "On-site training for warehouse staff", "2", "550.00", "1,100.00" ], [ "HW-88", "Barcode scanner, model K3", "4", "189.50", "758.00" ], [ "LC-05", "Annual licence, routing add-on", "1", "1,250.00", "1,250.00" ], [ "Subtotal", "Subtotal", "Subtotal", "Subtotal", "9,348.00" ], [ "VAT 20%", "VAT 20%", "VAT 20%", "VAT 20%", "1,869.60" ], [ "Total due (EUR)", "Total due (EUR)", "Total due (EUR)", "Total due (EUR)", "11,217.60" ] ] ], :lists = [  ], :furniture = [ "Brackenridge Lumen Software Ltd", "14 Calder Wharf, Dunmarren DM4 7QT", "accounts@brackenridge-lumen.example · +44 131 555 0182" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v12_s01.png", [ :sentences = [ "Payment is due within 30 days of the invoice date.", "Please quote the invoice number INV-2026-04817 as the payment reference so that your remittance can be matched without delay.", "Goods remain the property of Harbourline Office Supplies Ltd until payment has been received in full.", "Any shortage or damage must be reported within five working days of delivery.", "Late payments may incur interest at 4% above the statutory base rate." ], :headings = [ "INVOICE", "Payment details", "Notes" ], :tables = [ [ [ "Invoice number", "INV-2026-04817" ], [ "Invoice date", "14 October 2026" ], [ "Due date", "13 November 2026" ], [ "Customer PO", "FM-PO-3391" ], [ "Account", "FEN-0042" ] ], [ [ "Item code", "Description", "Qty", "Unit price (£)", "Amount (£)" ], [ "PAP-A4-80", "Copier paper A4 80 g/m², box of 5 reams", "12", "21.50", "258.00" ], [ "TON-HP-410", "Toner cartridge, black, high yield", "4", "64.90", "259.60" ], [ "FIL-LAT-4D", "Lateral filing cabinet, 4 drawers, grey", "1", "312.00", "312.00" ], [ "PEN-GEL-BL", "Gel pens, blue, pack of 12", "10", "6.75", "67.50" ], [ "NTB-A5-DOT", "Dotted notebooks A5, pack of 6", "5", "14.20", "71.00" ], [ "CHR-ERG-02", "Ergonomic task chair with lumbar support Colour: graphite, assembled on site", "3", "189.00", "567.00" ], [ "LBL-ADR-21", "Address labels, 21 per sheet, 100 sheets", "6", "11.40", "68.40" ], [ "DEL-STD", "Delivery and installation, Zone 2", "1", "45.00", "45.00" ], [ "", "", "", "Subtotal", "1,648.50" ], [ "", "", "", "Account discount", "−50.00" ], [ "", "", "", "VAT at 20%", "319.70" ], [ "", "", "", "Total due", "1,918.20" ] ], [ [ "Account name", "Harbourline Office Supplies Ltd" ], [ "Sort code", "40-11-62" ], [ "Account number", "31926604" ] ] ], :lists = [  ], :furniture = [ "Harbourline Office Supplies Ltd", "Unit 7, Kestrel Trading Estate, Portsmouth PO3 5LZ", "Tel. 023 9200 4471 · accounts@harbourline-supplies.example", "Registered in England and Wales N