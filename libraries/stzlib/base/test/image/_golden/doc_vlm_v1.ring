	_a_ + [ pcDir + "v18_a01.png", [ :sentences = [ "Two 40-foot high-cube containers of machine parts sailed from Felixstowe on 9 March 2027 aboard the vessel Meridian Crest.", "The charges below cover the door-to-port leg and the ocean voyage to Jebel Ali.", "Payment is due within 30 days of the invoice date.", "Please quote the invoice number on every remittance so that we can allocate it promptly.", "Zero-rated items relate to the international carriage of goods and the services directly linked to it.", "Late payments may attract interest at 4% above the base rate." ], :headings = [ "Tax Invoice", "Charges", "Payment details" ], :tables = [ [ [ "Invoice no.", "KBF-27-04418" ], [ "Invoice date", "14 March 2027" ], [ "Due date", "13 April 2027" ], [ "Customer account", "C-20915" ], [ "Shipment ref.", "SEA/EXP/27/1182" ] ], [ [ "No.", "Description", "Qty", "Unit", "Unit price", "VAT", "Amount (GBP)" ], [ "1", "Ocean freight FCL 40' HC Felixstowe to Jebel Ali", "2", "cntr", "1,450.00", "0%", "2,900.00" ], [ "2", "Terminal handling charge, origin", "2", "cntr", "185.00", "0%", "370.00" ], [ "3", "Road haulage Leicester to Felixstowe", "2", "trip", "420.00", "0%", "840.00" ], [ "4", "Export customs declaration", "1", "entry", "65.00", "20%", "65.00" ], [ "5", "Cargo insurance, 0.35% of declared value", "1", "policy", "147.00", "Exempt", "147.00" ], [ "6", "Documentation and bill of lading fee", "1", "set", "35.00", "20%", "35.00" ], [ "Subtotal", "Subtotal", "Subtotal", "Subtotal", "Subtotal", "Subtotal", "4,357.00" ], [ "VAT at 20% on 100.00", "VAT at 20% on 100.00", "VAT at 20% on 100.00", "VAT at 20% on 100.00", "VAT at 20% on 100.00", "VAT at 20% on 100.00", "20.00" ], [ "Total due (GBP)", "Total due (GBP)", "Total due (GBP)", "Total due (GBP)", "Total due (GBP)", "Total due (GBP)", "4,377.00" ] ], [ [ "Bank", "Northmoor Bank plc, Port Ellery", "Sort code", "40-11-62" ], [ "Account name", "Kestrel Bay Freight Forwarding Ltd", "Account number", "30918274" ], [ "IBAN",