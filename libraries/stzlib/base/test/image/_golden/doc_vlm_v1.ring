	_a_ + [ pcDir + "v17_z01.png", [ :sentences = [ "Payment is due within 30 days of the invoice date.", "Please quote the invoice number INV-24117 as the payment reference so that we can allocate your remittance correctly.", "Goods remain the property of Fernhollow Trading Ltd until this invoice has been paid in full.", "Thank you for your custom.", "If you have any questions about this invoice, contact our accounts team on 01632 960 418." ], :headings = [ "TAX INVOICE", "Invoice to", "Deliver to", "Payment terms", "Notes" ], :tables = [ [ [ "Invoice number", "INV-24117" ], [ "Invoice date", "14 October 2026" ], [ "Customer account", "HAL-0392" ], [ "Order reference", "PO 7781-B" ], [ "Due date", "13 November 2026" ] ], [ [ "Item code", "Description", "Qty", "Unit", "Unit price (£)", "Amount (£)" ], [ "FT-OAK-2045", "European oak board, planed, 20 × 145 mm, 2.4 m", "36", "length", "18.40", "662.40" ], [ "FT-PLY-1812", "Birch plywood sheet, 18 mm, 2440 × 1220 mm", "12", "sheet", "54.75", "657.00" ], [ "HW-HNG-0075", "Concealed cabinet hinge, soft close, 110°", "48", "each", "3.15", "151.20" ], [ "HW-SCR-4050", "Wood screws 4.0 × 50 mm, box of 200", "6", "box", "9.80", "58.80" ], [ "FN-OIL-0001", "Hardwax oil, satin, 2.5 litre", "3", "tin", "46.90", "140.70" ], [ "DL-STD-0001", "Delivery, standard rigid vehicle", "1", "trip", "65.00", "65.00" ], [ "Subtotal", "Subtotal", "Subtotal", "Subtotal", "Subtotal", "1,735.10" ], [ "VAT at 20%", "VAT at 20%", "VAT at 20%", "VAT at 20%", "VAT at 20%", "347.02" ], [ "Total due", "Total due", "Total due", "Total due", "Total due", "2,082.12" ] ] ], :lists = [ "Timber lengths are cut to order and cannot be returned unless faulty.", "Shortages or damage must be reported within 48 hours of delivery.", "A late payment charge of 2% per month may be added to overdue balances." ], :furniture = [ "Fernhollow Timber & Joinery Supplies", "Unit 7, Calder Mill Yard, Brackley Road, Hallowfield HF4 2TR", "Tel. 01632 960 418 · accounts@fernhollow