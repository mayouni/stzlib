# doc_vlm_v1.ring -- the :doc-vlm golden set, version v1: one item per page, the page given as a PNG in the
# folder doc_vlm_render.py fills (<key>.png) and what a correct reader recovers from it. The expectations are
# generated from the documents' expected.json (base/test/document/_data), whose authors never saw a reader;
# the 31 pages are the first one-page English document of each of golden_v2 ... golden_v33. Do not edit by hand.

func StzVisionGoldenDocV1(pcDir)
	_a_ = []
	_a_ + [ pcDir + "v2_e01.png", [ :sentences = [ "This summary reports the second season of field trials at three experimental stations.", "Each plot was sown on the same day and received no irrigation after germination.", "Sahel Gold and Riverbank Early produced the highest yields, but Riverbank Early needed almost three more weeks to mature.", "Dune Runner matured fastest and remains the safest choice where the rains end early.", "A third season is planned before any variety is recommended to growers." ], :headings = [ "Field Trial Summary: Drought-Tolerant Millet", "Results", "Next Steps" ], :tables = [ [ [ "Variety", "Yield (kg/ha)", "Days to maturity" ], [ "Sahel Gold", "1,240", "84" ], [ "Tillaberi 3", "1,105", "79" ], [ "Dune Runner", "980", "72" ], [ "Riverbank Early", "1,310", "91" ] ] ], :lists = [  ], :furniture = [  ], :code = [  ] ] ]
	_a_ + [ pcDir + "v3_f01.png", [ :sentences = [ "This summary lists the stock held at the northern warehouse at the close of March.", "Quantities are counted by hand on the last working day of each month.", "Two items fell below their reorder level during the month.", "A replacement order for the wood stain was placed on 2 April.", "The next count is scheduled for the end of April." ], :headings = [ "Regional Warehouse Inventory", "Stock on Hand", "Remarks" ], :tables = [ [ [ "Item code", "Description", "Shelf", "Quantity" ], [ "NW-1102", "Galvanised wall brackets", "A3", "240" ], [ "NW-1187", "Ceramic floor tiles, grey", "B1", "1,150" ], [ "NW-1230", "Copper pipe, 15 mm", "C4", "86" ], [ "NW-1314", "Exterior wood stain", "A7", "32" ], [ "NW-1452", "Cordless drill batteries", "D2", "118" ] ] ], :lists = [  ], :furniture = [  ], :code = [  ] ] ]
	_a_ + [ pcDir + "v4_g01.png", [ :sentences = [ "The town of Brelland draws its water from two shallow reservoirs fed by seasonal streams.", "During the dry months the infrastructure struggles to keep pace with demand, and the administration has asked residents to observe conservation measures.", "A survey completed last spring documented the characteristics of every storage tank in the district.", "Engineers found that most tanks were built before 1970 and that their maintenance records were incomplete.", "The corresponding repair estimates vary widely between neighbourhoods.", "Several recommendations concern the distribution network rather than the tanks themselves.", "The council will publish an intermediate report in October.", "Responsibilities for environmental monitoring will remain with the regional office until a permanent arrangement is agreed." ], :headings = [ "Notes on Municipal Water Storage" ], :tables = [  ], :lists = [  ], :furniture = [  ], :code = [  ] ] ]
	_a_ + [ pcDir + "v5_h03.png", [ :sentences = [ "Payment is due within 30 days of the invoice date.", "Please quote the invoice number INV-2025-0457 with your payment.", "The education discount applies to orders placed by registered schools.", "Returns are accepted within 14 days if the items are unused and in their original packaging.", "Goods remain the property of Brightline Office Supplies Ltd until paid in full." ], :headings = [ "INVOICE", "PAYMENT TERMS", "RETURNS" ], :tables = [ [ [ "No.", "Description", "Qty", "Unit price (£)", "Amount (£)" ], [ "1", "A4 copier paper, 80 g/m², box of 5 reams", "12", "24.90", "298.80" ], [ "2", "Whiteboard markers, assorted colours, pack of 10", "15", "8.75", "131.25" ], [ "3", "Lever-arch files, blue", "40", "2.35", "94.00" ], [ "4", "Laminating pouches A4, pack of 100", "6", "11.40", "68.40" ], [ "5", "Desk organiser, recycled plastic", "10", "6.95", "69.50" ], [ "6", "Toner cartridge TX-410, black, high yield", "4", "89.00", "356.00" ], [ "7", "Stapler, heavy duty, 100 sheets", "3", "21.50", "64.50" ], [ "Subtotal", "Subtotal", "Subtotal", "Subtotal", "1,082.45" ], [ "Education discount 5%", "Education discount 5%", "Education discount 5%", "Education discount 5%", "-54.12" ], [ "Net amount", "Net amount", "Net amount", "Net amount", "1,028.33" ], [ "VAT 20%", "VAT 20%", "VAT 20%", "VAT 20%", "205.67" ], [ "Total due", "Total due", "Total due", "Total due", "£1,234.00" ] ] ], :lists = [  ], :furniture = [ "Brightline Office Supplies Ltd · Registered office: Unit 4, Canal Road Trading Estate, Westbury", "Page 1 of 1" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v6_k17.png", [ :sentences = [ "All times shown are local times at each airport.", "Your return flight on 9 November is waitlisted, and we will confirm it or rebook you by 30 October.", "A driver from Acacia Park Hotel will meet you in the arrivals hall at Nairobi and hold a sign with your name.", "Transfers in Kigali are not included and can be booked at the hotel reception.", "Please check in online 24 hours before each flight and arrive at the airport at least three hours before international departures." ], :headings = [ "Travel Itinerary", "Flights", "Hotels", "Ground transport", "Before you travel" ], :tables = [ [ [ "Traveller", "Ms Nadia Rahmani-Okafor", "Booking reference", "QX7R2M" ], [ "Company", "Halden Engineering Consultants", "Issued", "21 October 2026" ], [ "Ticket number", "176-2412093388", "Travel consultant", "Tunde Afolabi" ] ], [ [ "Date", "Flight", "From", "To", "Departs", "Arrives", "Class", "Status" ], [ "Wed 4 Nov 2026", "XQ 214", "Lagos (LOS)", "Nairobi (NBO)", "08:45", "15:40", "Business (J)", "Confirmed" ], [ "Fri 6 Nov 2026", "XQ 731", "Nairobi (NBO)", "Kigali (KGL)", "11:20", "11:35", "Business (J)", "Confirmed" ], [ "Mon 9 Nov 2026", "XQ 590", "Kigali (KGL)", "Lagos (LOS)", "13:05", "17:50", "Economy (Y)", "Waitlisted" ] ], [ [ "Check-in", "Check-out", "Hotel", "Address", "Confirmation" ], [ "4 Nov 2026", "6 Nov 2026", "Acacia Park Hotel", "Waiyaki Way, Westlands, Nairobi", "ACP-55120" ], [ "6 Nov 2026", "9 Nov 2026", "Hotel Kivu Heights", "KN 3 Avenue, Kigali", "KH-80931" ] ] ], :lists = [ "□ Passport valid for at least six months after the return date", "□ Yellow fever vaccination certificate", "□ Printed or electronic copy of this itinerary", "□ Corporate card for incidental hotel charges" ], :furniture = [ "Meridian Business Travel", "18 Adeola Hopewell Street, Victoria Island, Lagos", "+234 1 555 0140 · trips@meridian-bt.example", "Meridian Business Travel Ltd · RC 1184420 · 24-hour emergency line +234 1 555 0147", "This itinerary is not a ticket. Fares and availability are subject to change until ticketed." ], :code = [  ] ] ]
	_a_ + [ pcDir + "v7_m09.png", [ :sentences = [ "Smallholder vegetable growers in the savanna zone irrigate by habit rather than by measurement.", "Over-irrigation wastes pumped water and fuel, while under-irrigation during fruit set cuts yields sharply.", "Commercial tensiometers cost more than a season of fuel, so we tested whether a capacitive sensor costing under five dollars could guide irrigation decisions.", "Sensor-guided plots received 28 percent less water while yielding slightly more onions.", "The saving was largest in the first six weeks after transplanting, when farmers usually irrigate every second day.", "The yield gain is modest, but the fuel saving alone repays the sensor within the first month." ], :headings = [ "Low-cost soil moisture sensing for smallholder irrigation scheduling: a two-season field trial", "Background", "Objectives", "Methods", "Results", "Discussion", "Conclusions", "Next steps", "Acknowledgements", "References" ], :tables = [ [ [ "Indicator", "Usual practice", "Sensor-guided", "Change" ], [ "Irrigation events per season", "41", "27", "−34 %" ], [ "Water applied (mm)", "612", "438", "−28 %" ], [ "Pump fuel (litres)", "96", "69", "−28 %" ], [ "Bulb yield (t/ha)", "18.4", "19.7", "+7 %" ], [ "Net income (GHS per plot)", "1 520", "1 790", "+18 %" ] ] ], :lists = [ "Calibrate a low-cost capacitive probe against gravimetric soil samples.", "Compare sensor-guided scheduling with farmers’ usual practice.", "Measure water use, onion yield and net income per plot.", "A five-dollar capacitive probe, calibrated once per soil type, is accurate enough to schedule irrigation.", "Sensor-guided scheduling saved over a quarter of the water and fuel without any loss of yield.", "Adoption depends on a display that farmers can read at a glance.", "Allen R.G. et al. (1998) Crop evapotranspiration: guidelines for computing crop water requirements. FAO, Rome.", "Placidi P. et al. (2020) Characterization of low-cost capacitive soil moisture sensors for IoT networks. Sensors 20, 3585.", "Dauda A. and Sule I. (2024) Irrigation habits of dry-season onion growers in northern Ghana. Savanna Agric. J. 12, 44–58." ], :furniture = [ "NSIA Northern Savanna Institute of Agriculture", "LUAS Lindenfeld University", "Presented at the 14th Regional Conference on Water and Food Security, Accra, 3–5 November 2026", "Contact: a.dauda@nsia.example" ], :code = [ "import numpy as np

# raw ADC counts vs. gravimetric VWC (m3/m3), 36 samples
slope, intercept = np.polyfit(counts, vwc, 1)

def to_vwc(raw):
    return max(0.0, slope * raw + intercept)

THRESHOLD = 0.55 * (FC - PWP) + PWP" ] ] ]
	_a_ + [ pcDir + "v8_n01.png", [ :sentences = [ "Two of the twelve lifejackets on your order are on back order and will be invoiced separately when dispatched.", "Payment is due within 30 days of the invoice date.", "Please quote the invoice number as your payment reference.", "Goods remain the property of Halvorsen Marine Supplies Ltd until payment has been received in full.", "Interest may be charged on overdue accounts at 8% per year above the base rate." ], :headings = [ "Tax Invoice", "Payment terms", "Bank details" ], :tables = [ [ [ "Item", "Description", "Qty", "Unit price (£)", "VAT %", "Amount (£)" ], [ "MR-2210", "Mooring rope, 16 mm polyester, 50 m coil", "4", "86.50", "20", "346.00" ], [ "FD-0445", "Fender, cylindrical, 200 x 750 mm", "6", "41.20", "20", "247.20" ], [ "SH-1032", "Stainless shackle, D-type, 10 mm", "24", "6.85", "20", "164.40" ], [ "LJ-3150", "Lifejacket, 150 N, automatic inflation", "10", "72.00", "20", "720.00" ], [ "BP-0080", "Bilge pump, 12 V, 2000 GPH", "2", "118.75", "20", "237.50" ], [ "CH-6006", "Admiralty-style chart folio, North Sea East", "1", "64.00", "0", "64.00" ], [ "DL-0001", "Delivery to vessel, Port Elden harbour", "1", "35.00", "20", "35.00" ], [ "Subtotal", "Subtotal", "Subtotal", "Subtotal", "Subtotal", "1,814.10" ], [ "VAT at 20% on £1,750.10", "VAT at 20% on £1,750.10", "VAT at 20% on £1,750.10", "VAT at 20% on £1,750.10", "VAT at 20% on £1,750.10", "350.02" ], [ "Total due (GBP)", "Total due (GBP)", "Total due (GBP)", "Total due (GBP)", "Total due (GBP)", "2,164.12" ] ] ], :lists = [  ], :furniture = [ "Halvorsen Marine Supplies Ltd", "Unit 4, Quayside Trading Estate", "Port Elden PE3 7QA", "Tel. 01632 960 418", "accounts@halvorsen-marine.example", "VAT No. GB 418 2290 63", "Halvorsen Marine Supplies Ltd · Registered in England and Wales No. 08847215 · Registered office as above" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v9_p01.png", [ :sentences = [ "Payment is due within 30 days of the invoice date.", "Please quote invoice number KF-24187 with your remittance.", "Goods remain the property of Kestrel Fasteners & Supply Ltd until payment has been received in full.", "Any shortage or damage must be reported within five working days of delivery.", "Late payments may attract interest and compensation under the Late Payment of Commercial Debts (Interest) Act 1998.", "Thank you for your business." ], :headings = [ "Tax Invoice", "Payment terms" ], :tables = [ [ [ "Invoice number", "KF-24187" ], [ "Invoice date", "12 October 2026" ], [ "Due date", "11 November 2026" ], [ "Customer PO", "PO-55102" ], [ "Account", "BRAD-0042" ] ], [ [ "Code", "Description", "Qty", "Unit price", "Amount" ], [ "HX-M10-50", "Hex bolt M10 × 50 mm, zinc plated (box of 100)", "12", "£18.40", "£220.80" ], [ "NY-M10", "Nyloc nut M10, zinc plated (box of 200)", "6", "£14.75", "£88.50" ], [ "WF-M10A", "Flat washer M10, form A (box of 500)", "4", "£11.20", "£44.80" ], [ "CA-380", "Chemical anchor resin, 380 ml cartridge", "10", "£9.85", "£98.50" ], [ "TR-M12-1", "Threaded rod M12 × 1 m, grade 8.8", "25", "£3.62", "£90.50" ], [ "SD-4250", "Self-drilling screw 4.2 × 50 mm, hex head (box of 250)", "8", "£16.90", "£135.20" ], [ "EP-NOZ", "Static mixing nozzle for resin cartridges (pack of 12)", "3", "£7.45", "£22.35" ], [ "Subtotal", "Subtotal", "Subtotal", "Subtotal", "£700.65" ], [ "Delivery, next working day (pallet)", "Delivery, next working day (pallet)", "Delivery, next working day (pallet)", "Delivery, next working day (pallet)", "£35.00" ], [ "VAT at 20%", "VAT at 20%", "VAT at 20%", "VAT at 20%", "£147.13" ], [ "Total due", "Total due", "Total due", "Total due", "£882.78" ] ] ], :lists = [  ], :furniture = [ "Kestrel Fasteners & Supply Ltd", "Unit 7, Harrow Mill Industrial Estate, Leeds LS12 4QT", "Tel. 0113 496 0721 · accounts@kestrelfasteners.example", "VAT Reg. No. GB 318 4402 57 · Company No