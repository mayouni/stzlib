	_a_ + [ pcDir + "v14_w01.png", [ :sentences = [ "This invoice covers the export of two 40-foot high-cube containers of garden furniture from our Westerby depot to the consignee's terminal in Rotterdam.", "Vessel MV Calder Spirit, voyage 2641E, sailed from Felixstowe on 4 October 2026.", "VAT is charged only on the UK haulage, customs and documentation services; international sea freight and its origin charges are zero-rated.", "Please pay by bank transfer within 30 days of the invoice date.", "Claims for loss or damage must be notified to us in writing within seven days of delivery.", "All business is transacted under our standard trading conditions, a copy of which is available on request.", "Interest may be charged on overdue accounts at 4% above the base rate." ], :headings = [ "Tax Invoice", "PAYMENT DETAILS", "REMARKS" ], :tables = [ [ [ "Invoice number", "HFS-26-04418" ], [ "Invoice date", "9 October 2026" ], [ "Due date", "8 November 2026" ], [ "Customer account", "NGS-0193" ], [ "Our reference", "EXP/FXT/26/2207" ] ], [ [ "Description", "Qty", "Unit", "Rate (GBP)", "Amount (GBP)" ], [ "Sea freight FCL 40' HC, Felixstowe to Rotterdam", "2", "container", "1,180.00", "2,360.00" ], [ "Terminal handling charge, origin", "2", "container", "145.00", "290.00" ], [ "Haulage, Westerby depot to Felixstowe", "2", "trip", "410.00", "820.00" ], [ "Customs export declaration", "1", "entry", "65.00", "65.00" ], [ "Cargo insurance, 0.35% of declared value", "1", "policy", "192.50", "192.50" ], [ "Documentation fee", "1", "set", "35.00", "35.00" ], [ "Subtotal", "Subtotal", "Subtotal", "Subtotal", "3,762.50" ], [ "VAT at 20% on 920.00", "VAT at 20% on 920.00", "VAT at 20% on 920.00", "VAT at 20% on 920.00", "184.00" ], [ "Total due", "Total due", "Total due", "Total due", "3,946.50" ] ], [ [ "Bank", "Calder Mutual Bank" ], [ "Account name", "Harbourline Freight Services Ltd" ], [ "Sort code", "40-11-62" ], [ "Account number", "71839204" ], [ "Payment reference", "HFS-26-04418" ] ] ], :lists = [  ], :furniture = [ "HARBOURLINE FREIGHT SERVICES", "Unit 3, Quayside Business Park · Port Calder · PC4 7RT", "+44 1632 960 418 · accounts@harbourline.example", "Harbourline Freight Services Ltd · Registered in England and Wales No. 10457732 · VAT No. GB 318 2290 47", "Page 1 of 1" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v15_x01.png", [ :sentences = [ "Invoices are processed by the central finance office in Brackmoor.", "Deliveries are accepted between 07:30 and 15:00 on weekdays.", "Payment is due within 30 days of the invoice date.", "Please quote the invoice number on all remittances so that your payment can be allocated without delay.", "Goods remain the property of Northmere Industrial Supply Co. until payment has been received in full.", "Damaged or missing items must be reported within five working days of delivery." ], :headings = [ "Tax Invoice", "Payment instructions", "Notes" ], :tables = [ [ [ "Invoice number", "NIS-2026-04417" ], [ "Invoice date", "9 October 2026" ], [ "Due date", "8 November 2026" ], [ "Customer reference", "PO 7781-B" ], [ "Account", "C-01294" ] ], [ [ "Item", "Description", "Qty", "Unit", "Unit price", "Amount" ], [ "HX-M10-50", "Hex bolt M10 x 50, zinc plated, grade 8.8", "400", "pcs", "0.21", "84.00" ], [ "NY-M10", "Nylon insert lock nut M10", "400", "pcs", "0.09", "36.00" ], [ "BR-6204", "Deep groove ball bearing 6204-2RS", "24", "pcs", "3.85", "92.40" ], [ "CT-115", "Cutting disc 115 x 1.0 mm, stainless steel", "50", "pcs", "0.96", "48.00" ], [ "GL-NIT-L", "Nitrile gloves, size L, box of 100", "12", "box", "6.40", "76.80" ], [ "TH-LOC-243", "Threadlocker, medium strength, 50 ml", "6", "btl", "9.75", "58.50" ], [ "Subtotal", "Subtotal", "Subtotal", "Subtotal", "Subtotal", "395.70" ], [ "VAT at 20%", "VAT at 20%", "VAT at 20%", "VAT at 20%", "VAT at 20%", "79.14" ], [ "Carriage", "Carriage", "Carriage", "Carriage", "Carriage", "12.50" ], [ "Total due (GBP)", "Total due (GBP)", "Total due (GBP)", "Total due (GBP)", "Total due (GBP)", "487.34" ] ], [ [ "Bank", "Fenwick Mercantile Bank" ], [ "Sort code", "40-17-22" ], [ "Account number", "31884506" ], [ "IBAN", "GB29 FMBK 4017 2231 8845 06" ] ] ], :lists = [  ], :furniture = [ "NORTHMERE INDUSTRIAL SUPPLY CO.", "Fasteners · Bearings · Workshop consumables", "Unit 14, Calder Bank Trad