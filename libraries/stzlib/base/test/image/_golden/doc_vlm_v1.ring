	_a_ + [ pcDir + "v19_b01.png", [ :sentences = [ "Payment is due within 30 days of the invoice date.", "Please quote the invoice number INV-2025-0417 with your payment so that we can match it to your account.", "Goods remain our property until they have been paid for in full.", "Any shortage or damage must be reported to us within seven days of delivery.", "We may charge interest on overdue accounts at 4% above the Bank of England base rate." ], :headings = [ "Tax Invoice", "How to pay", "Terms" ], :tables = [ [ [ "Invoice number", "INV-2025-0417" ], [ "Invoice date", "14 March 2025" ], [ "Your reference", "PO 88213" ], [ "Due date", "13 April 2025" ], [ "Account", "THO-0092" ] ], [ [ "Item", "Description", "Qty", "Unit price", "Amount" ], [ "1", "Concert programmes, A5, 16 pages full colour, saddle stitched", "400", "£1.85", "£740.00" ], [ "2", "Tickets, numbered, with perforated stub", "600", "£0.22", "£132.00" ], [ "3", "A2 posters, 170 gsm silk", "35", "£3.40", "£119.00" ], [ "4", "Design adjustments (hours)", "2.5", "£38.00", "£95.00" ], [ "5", "Delivery to St Aldhelm’s Hall", "1", "£18.00", "£18.00" ], [ "Subtotal", "Subtotal", "Subtotal", "Subtotal", "£1,104.00" ], [ "VAT at 20%", "VAT at 20%", "VAT at 20%", "VAT at 20%", "£220.80" ], [ "Total due", "Total due", "Total due", "Total due", "£1,324.80" ] ] ], :lists = [ "a) Bank transfer to Fernhollow Print & Bindery Ltd, sort code 20-19-74, account 41736025", "b) Card payment by telephone on 01632 960418, Monday to Friday", "c) Cheque payable to Fernhollow Print & Bindery Ltd, sent to the address above" ], :furniture = [ "Fernhollow Print & Bindery Ltd", "Unit 4, Mardale Trading Estate, Kestwick KW3 9TP", "Telephone 01632 960418 · accounts@fernhollow-print.example", "Fernhollow Print & Bindery Ltd · Registered in England No. 08815237 · VAT No. GB 318 4402 17" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v20_c22.png", [ :sentences = [ "Payment is due within 30 days of the invoice date, quoting the invoice number as the payment reference.", "Charges in currencies other than US dollars have been converted at the carrier’s rate on the date of sailing.", "All business is undertaken subject to our standard trading conditions, a copy of which is available on request.", "Please tell us about any query on this invoice within seven days of receiving it." ], :headings = [ "INVOICE" ], :tables = [ [ [ "B/L number", "HFFX2611873", "Vessel / voyage", "Northern Larch 047W" ], [ "Port of loading", "Felixmouth", "Port of discharge", "Callao" ], [ "Containers", "2 × 40 ft HC", "Gross weight", "31,420 kg" ], [ "Incoterm", "FCA Kettering", "Your reference", "PO-TA-5520" ] ], [ [ "Code", "Description", "Basis", "Qty", "Rate (USD)", "Amount (USD)" ], [ "Origin charges", "Origin charges", "Origin charges", "Origin charges", "Origin charges", "Origin charges" ], [ "THC-O", "Terminal handling, origin", "per container", "2", "185.00", "370.00" ], [ "DOC", "Export documentation and customs filing", "per shipment", "1", "95.00", "95.00" ], [ "HAUL", "Road haulage, Kettering to Felixmouth", "per container", "2", "640.00", "1,280.00" ], [ "Freight", "Freight", "Freight", "Freight", "Freight", "Freight" ], [ "OF", "Ocean freight, 40 ft high cube", "per container", "2", "2,310.00", "4,620.00" ], [ "BAF", "Bunker adjustment factor", "per container", "2", "415.00", "830.00" ], [ "Destination charges", "Destination charges", "Destination charges", "Destination charges", "Destination charges", "Destination charges" ], [ "THC-D", "Terminal handling, destination", "per container", "2", "210.00", "420.00" ], [ "DEL", "Delivery order fee", "per shipment", "1", "60.00", "60.00" ], [ "Subtotal", "Subtotal", "Subtotal", "Subtotal", "Subtotal", "7,675.00" ], [ "VAT 0% (export services, zero-rated)", "VAT 0% (export services, zero-rated)", "VAT 0% (export services, zero-rated)", "VAT 0% (export services, zero-rated)", "VAT 0% (export services, zero-rated)", "0.00" ], [ "Total due", "Total due", "Total due", "Total due", "Total due", "USD 7,675.00" ] ], [ [ "Bank", "Felixmouth Merchant Bank" ], [ "Account name", "Harbourline Freight Forwarding Ltd" ], [ "Account number", "00-0418-1187" ], [ "Sort code", "00-00-00" ], [ "SWIFT", "FXMBGB00" ] ] ], :lists = [  ], :furniture = [ "HARBOURLINE FREIGHT FORWARDING LTD", "Unit 9, Quay Logistics Park, Felixmouth FX3 2LQ", "+44 1632 960 777 · accounts@harbourline.example · VAT GB 000 0418 00", "Registered in England and Wales · Company no. 00000418 · Registered office as above", "Page 1/1" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v21_d01.png", [ :sentences = [ "Payment is due within 30 days of the invoice date.", "Please quote the invoice number as the reference on every payment so that we can match it to your account.", "We accept bank transfer and card payments by telephone.", "Accounts that remain unpaid after the due date may be charged interest at the statutory rate.", "Thank you for choosing Harbourline again this season.", "If you have any questions about this invoice, please contact our accounts team." ], :headings = [ "Tax Invoice", "Payment terms", "Notes" ], :tables = [ [ [ "Invoice number", "HPB-26-0418" ], [ "Invoice date", "3 March 2026" ], [ "Due date", "2 April 2026" ], [ "Purchase order", "FVRC/114" ] ], [ [ "Description", "Qty", "Unit price", "Amount" ], [ "Regatta programme, 24 pages, A5 saddle stitched", "400", "£1.85", "£740.00" ], [ "Entry forms, A4 single sided", "250", "£0.12", "£30.00" ], [ "Vinyl banner 3 m × 0.8 m with eyelets", "2", "£96.00", "£192.00" ], [ "Correx course markers, numbered 1 to 12", "12", "£8.50", "£102.00" ], [ "Artwork amendments (hourly)", "1.5", "£42.00", "£63.00" ], [ "Delivery to Ashcombe", "1", "£18.00", "£18.00" ], [ "Subtotal", "Subtotal", "Subtotal", "£1,145.00" ], [ "VAT at 20%", "VAT at 20%", "VAT at 20%", "£229.00" ], [ "Total due", "Total due", "Total due", "£1,374.00" ] ] ], :lists = [ "Programmes were delivered in two boxes of 200 on 27 February.", "The second banner was reprinted at no charge after a colour fault.", "Unused course markers can be stored by us until the autumn head race." ], :furniture = [ "Harbourline Print & Bind Ltd", "Unit 7, Quayside Works, Port Elver PE4 2QT", "accounts@harbourline.example · 01632 960418", "Registered in England and Wales No. 08814426 · VAT registration GB 318 4420 61" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v22_e01.png", [ :sentences = [ "Thank you for choosing us for the classroom storage project.", "This invoice covers the second and final stage of the works described in quotation Q-2026-112.", "The works were completed on 9 October 2026 and signed off by your site manager.", "We guarantee all fitted furniture for five years from the date of installation.", "If you have any questions about this invoice, please contact our accounts team." ], :headings = [ "Invoice", "Payment details", "Terms" ], :tables = [ [ [ "Invoice number", "HF-2026-0418" ], [ "Invoice date", "12 October 2026" ], [ "Due date", "11 November 2026" ], [ "Your order", "PO 7731" ], [ "Account", "HF-C-0219" ] ], [ [ "No.", "Description", "Qty", "Unit", "Unit price (£)", "Amount (£)" ], [ "1", "Oak veneer storage unit, 1800 × 900 mm, with adjustable shelves", "6", "each", "412.00", "2,472.00" ], [ "2", "Coat hook rail in solid ash 1200 mm long, eight hooks", "10", "each", "38.50", "385.00" ], [ "3", "Reading nook bench with lift-up lid", "2", "each", "655.00", "1,310.00" ], [ "4", "Site installation, two fitters", "14", "hour", "42.00", "588.00" ], [ "5", "Removal and disposal of old fittings", "1", "lot", "120.00", "120.00" ], [ "Subtotal", "Subtotal", "Subtotal", "Subtotal", "Subtotal", "4,875.00" ], [ "VAT at 20%", "VAT at 20%", "VAT at 20%", "VAT at 20%", "VAT at 20%", "975.00" ], [ "Less deposit paid on 3 March 2026", "Less deposit paid on 3 March 2026", "Less deposit paid on 3 March 2026", "Less deposit paid on 3 March 2026", "Less deposit paid on 3 March 2026", "−1,462.50" ], [ "Total due", "Total due", "Total due", "Total due", "Total due", "4,387.50" ] ], [ [ "Bank", "Wessex Mutual Bank" ], [ "Account name", "Harrow & Finch Joinery Ltd" ], [ "Sort code", "40-17-62" ], [ "Account number", "51883047" ], [ "Reference", "HF-2026-0418" ] ] ], :lists = [ "Payment is due within 30 days of the invoice date.", "We accept bank transfer and cheque.", "Please quote the invoice number as your reference.", "Cheques should be made payable to Harrow & Finch Joinery Ltd.", "Late payments may incur interest at 4% above base rate.", "All goods remain our property until paid in full." ], :furniture = [ "Harrow & Finch Joinery Ltd", "Unit 7, Millbrook Trading Estate", "Ashcombe, Wiltshire SN14 6QT", "Tel. 01249 550 318 · accounts@harrowfinch.example", "Harrow & Finch Joinery Ltd · Registered in England and Wales No. 09417263 · VAT GB 318 5520 47" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v23_f01.png", [ :sentences = [ "Thank you for instructing us on the mezzanine floor at your Easterby workshop.", "This invoice covers the survey and design stages completed in September 2026.", "Payment is due within 30 days of the invoice date.", "Please quote the invoice number on every remittance so that we can allocate it promptly.", "Interest may be charged on balances that remain unpaid after the due date." ], :headings = [ "Tax Invoice", "Payment", "Notes" ], :tables = [ [ [ "Invoice no.", "BSC-2026-0417" ], [ "Invoice date", "12 October 2026" ], [ "Due date", "11 November 2026" ], [ "Client ref.", "PO 55-1903" ], [ "Project", "Workshop mezzanine" ] ], [ [ "Item", "Description", "Qty", "Unit", "Rate (GBP)", "Amount (GBP)" ], [ "Phase 1 — Survey", "Phase 1 — Survey", "Phase 1 — Survey", "Phase 1 — Survey", "Phase 1 — Survey", "Phase 1 — Survey" ], [ "1.1", "Site measurement survey", "2", "day", "640.00", "1,280.00" ], [ "1.2", "Condition report for existing steel frame and base plates", "1", "lump sum", "950.00", "950.00" ], [ "Phase 2 — Design", "Phase 2 — Design", "Phase 2 — Design", "Phase 2 — Design", "Phase 2 — Design", "Phase 2 — Design" ], [ "2.1", "Structural calculations, mezzanine floor", "18", "hour", "85.00", "1,530.00" ], [ "2.2", "General arrangement drawings", "6", "sheet", "120.00", "720.00" ], [ "2.3", "Building control liaison", "4", "hour", "85.00", "340.00" ], [ "Subtotal", "Subtotal", "Subtotal", "Subtotal", "Subtotal", "4,820.00" ], [ "VAT at 20%", "VAT at 20%", "VAT at 20%", "VAT at 20%", "VAT at 20%", "964.00" ], [ "Total due", "Total due", "Total due", "Total due", "Total due", "5,784.00" ] ] ], :lists = [ "Rates are those agreed in our fee proposal of 3 March 2026.", "Drawings were issued as PDF and DWG files on 29 September 2026.", "Phase 3 (site inspections during construction) will be invoiced separately." ], :furniture = [ "Brackenfield Structural Consultants Ltd", "14 Tannery Wharf, Lowmoor LM4 7QX", "accounts@brackenfield-sc.example · 01632 960 417", "Registered in England and Wales No. 08814423 · VAT No. GB 318 4471 09" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v24_g01.png", [ :sentences = [ "The goods listed above were delivered on 9 October 2026 and signed for by your boathouse steward.", "Please quote the invoice number on every remittance so that we can match your payment quickly.", "We prefer payment by bank transfer to the account below.", "Cheques are no longer accepted after the closure of our town-centre branch." ], :headings = [ "Tax Invoice", "Payment terms", "How to pay" ], :tables = [ [ [ "Invoice number", "INV-2026-0418" ], [ "Invoice date", "14 October 2026" ], [ "Your order", "PO 55102" ], [ "Due date", "13 November 2026" ] ], [ [ "Item", "Description", "Qty", "Unit price", "Amount" ], [ "1", "Perfect-bound annual report 64 pp, 170 gsm silk cover", "750", "£4.12", "£3,090.00" ], [ "2", "Saddle-stitched regatta programme 16 pp, two colours throughout", "2,000", "£0.86", "£1,720.00" ], [ "3", "Colour proof Wet proof on the chosen stock", "2", "£65.00", "£130.00" ], [ "4", "Delivery Pallet service to two addresses", "1", "£148.00", "£148.00" ], [ "Subtotal", "Subtotal", "Subtotal", "Subtotal", "£5,088.00" ], [ "VAT at 20%", "VAT at 20%", "VAT at 20%", "VAT at 20%", "£1,017.60" ], [ "Total due", "Total due", "Total due", "Total due", "£6,105.60" ] ], [ [ "Bank", "Wherry Valley Building Society" ], [ "Account name", "Larkspur Print & Bindery Ltd." ], [ "Sort code", "40-12-76" ], [ "Account number", "31926604" ] ] ], :lists = [ "1) Payment is due within 30 days of the invoice date.", "2) Late payments attract interest at 8% above the base rate, as permitted by statute.", "a) A first reminder is sent seven days after the due date.", "b) A fixed recovery charge of £70 applies to debts of £10,000 or more.", "3) Title in the goods remains with Larkspur Print & Bindery Ltd. until the invoice is paid in full." ], :furniture = [ "Larkspur Print & Bindery Ltd.", "Unit 7, Kestrel Way Trading Estate", "Norwich NR6 4QT", "Tel. 01603 550 218 · accounts@larkspur-print.example", "Registered in England No. 088