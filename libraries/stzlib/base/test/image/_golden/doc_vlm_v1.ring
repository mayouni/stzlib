	_a_ + [ pcDir + "v25_h15.png", [ :sentences = [ "Please complete this form in block capitals and return it to People Services before your first day of work.", "Fields marked with an asterisk (*) are required.", "We use these details only to set up your employment, pay and pension records.", "They are kept for six years after your employment ends and then deleted.", "I confirm that the information I have given on this form is correct and complete." ], :headings = [ "New Starter Details", "Section 1 — Personal details", "Section 2 — Role details", "Section 3 — Emergency contact", "Section 4 — Declaration" ], :tables = [ [ [ "Received by", "", "Date received", "" ], [ "Employee number", "", "Payroll entry date", "" ] ] ], :lists = [ "1. Scan or photograph every page.", "2. E-mail the files to people@kestrelvalley.example.", "3. Bring your passport or birth certificate on your first day." ], :furniture = [ "Kestrel Valley Housing Trust", "People Services", "Form HR-03 · revised 09/2026", "Kestrel Valley Housing Trust is a registered charity and a registered provider of social housing.", "Page 1 of 1" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v26_k01.png", [ :sentences = [ "Payment is due within 30 days of the invoice date.", "Thank you for asking us to fit out the reading room at the institute.", "The shelving was installed on 9 October and signed off by the building committee the same afternoon.", "The oak has been finished with two coats of hardwax oil.", "Our workmanship guarantee runs for five years from the date of installation." ], :headings = [ "Invoice", "Payment terms", "Notes on the work" ], :tables = [ [ [ "Invoice number", "INV-2026-0418" ], [ "Invoice date", "14 October 2026" ], [ "Due date", "13 November 2026" ], [ "Your reference", "Reading room shelving" ] ], [ [ "Item", "Description", "Qty", "Unit price (£)", "Amount (£)" ], [ "Materials", "Materials", "Materials", "Materials", "Materials" ], [ "M-104", "Solid oak shelving boards, 2400 × 280 × 22 mm", "14", "46.50", "651.00" ], [ "M-221", "Brass shelf studs, pack of 50", "3", "12.80", "38.40" ], [ "M-318", "Hardwax oil, satin finish, 2.5 litre tin", "2", "39.90", "79.80" ], [ "Labour", "Labour", "Labour", "Labour", "Labour" ], [ "L-010", "Site survey and measured drawing", "1", "180.00", "180.00" ], [ "L-020", "Workshop fabrication, hours", "22", "38.00", "836.00" ], [ "L-030", "Installation on site, hours", "9", "42.00", "378.00" ], [ "Subtotal", "Subtotal", "Subtotal", "Subtotal", "2,163.20" ], [ "VAT at 20%", "VAT at 20%", "VAT at 20%", "VAT at 20%", "432.64" ], [ "Total due", "Total due", "Total due", "Total due", "2,595.84" ] ] ], :lists = [ "1. Payment is due within 30 days of the invoice date.", "2. Please pay by bank transfer to sort code 30-96-41, account 20718834, quoting the invoice number as the reference.", "3. Interest may be charged on overdue amounts at 4% above the Bank of England base rate.", "The oak has been finished with two coats of hardwax oil.", "A third coat can be applied after six months if the surface looks dry.", "Avoid silicone polish, which prevents later re-oiling.", "Offcuts long enough