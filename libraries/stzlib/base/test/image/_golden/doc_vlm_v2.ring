# doc_vlm_v2.ring -- the :doc-vlm golden set, version v2: one item per page, the page given as a PNG in the
# folder doc_vlm_render.py fills (<key>.png) and what a correct reader recovers from it. The expectations are
# generated from the documents' expected.json (base/test/document/_data), whose authors never saw a reader;
# the pages are the second and, when there is one, the third one-page English document of each of golden_v2 ... golden_v33 (FRESH: no model had read one when the combination rule was written). Do not edit by hand.

func StzVisionGoldenDocV2(pcDir)
	_a_ = []
	_a_ + [ pcDir + "v2_e02.png", [ :sentences = [ "The long-awaited bus stop on Quay Street opened to passengers on the first Monday of April.", "Route 14 now stops there every twenty minutes between six in the morning and ten at night.", "Residents asked for a shelter with a bench, and the council has promised one before the summer.", "The Harbour Lane library will stay open until eight o'clock on Tuesdays and Thursdays.", "Volunteers will run a homework club for children aged eight to twelve during the extra hours.", "Anyone who wants to help can leave their name at the front desk.", "Our yearly clean-up day takes place on Saturday the 16th of May, starting at nine o'clock.", "Gloves, bags and tea will be provided at the community hall.", "Last year forty-two neighbours collected more than ninety bags of rubbish from the beach and the park." ], :headings = [ "The Harbour Lane Gazette", "New Bus Stop Opens on Quay Street", "Library Extends Its Opening Hours", "Spring Clean-Up Day" ], :tables = [  ], :lists = [  ], :furniture = [  ], :code = [  ] ] ]
	_a_ + [ pcDir + "v2_e03.png", [ :sentences = [ "The old mill pond is the last open water in the eastern part of the town.", "For decades it was a resting place for herons, ducks and the occasional kingfisher.", "Since the sluice gate collapsed, the pond has slowly filled with silt and reeds.", "Contractors will first remove about four thousand cubic metres of silt.", "The sluice gate will then be rebuilt in oak, following the original drawings kept in the town archive.", "Finally, a footpath with two viewing platforms will be laid along the southern bank.", "The pond covers about 1.8 hectares.", "Work began in September 2025 and should end in June 2026.", "The total budget is 214,000 euros." ], :headings = [ "Restoring the Old Mill Pond", "Why the Pond Matters", "What the Work Involves", "At a Glance" ], :tables = [  ], :lists = [  ], :furniture = [  ], :code = [  ] ] ]
	_a_ + [ pcDir + "v3_f02.png", [ :sentences = [ "The volunteer office records every session in a shared logbook.", "Hours are rounded to the nearest half hour.", "Meal delivery remains the programme with the largest commitment.", "The repair workshop doubled its sessions after moving to a larger room.", "Coordinators are asked to submit the July figures by the tenth of August." ], :headings = [ "Volunteer Hours by Programme", "Notes" ], :tables = [ [ [ "Programme", "Site", "Sessions", "Hours" ], [ "Reading circle", "Elm Street Library", "24", "96.5" ], [ "Garden maintenance", "Westfield Allotments", "31", "212.0" ], [ "Meal delivery", "Central Kitchen", "48", "1,034.5" ], [ "Language café", "Harbour Community Hall", "18", "54.0" ], [ "Repair workshop", "Old Mill Studio", "12", "73.5" ], [ "Youth football", "Brookside Fields", "36", "158.0" ], [ "Library tidying", "Elm Street Library", "9", "22.5" ] ] ], :lists = [  ], :furniture = [  ], :code = [  ] ] ]
	_a_ + [ pcDir + "v3_f04.png", [ :sentences = [ "Thank you for your letter of 2 September regarding the community hall on Linden Row.", "Our members discussed the proposed terms at the general meeting held last Thursday.", "The association would like to renew the lease for a further three years.", "We accept the revised rent, provided that the heating system is serviced before the winter.", "We would also welcome a meeting to agree a schedule for the repairs to the roof.", "Please let us know which dates suit your office in October.", "We look forward to continuing our work with the council." ], :headings = [  ], :tables = [  ], :lists = [  ], :furniture = [ "Harbourview Tenants Association | 14 Linden Row | Port Avel PA3 9QD", "Our reference: HTA/2026/0417" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v4_g02.png", [ :sentences = [ "The finance office will move to the third floor on Monday.", "Staff are asked to affirm their new desk numbers by Friday so that the relocation can flow smoothly.", "An efficient workflow depends on clear labels for every box.", "The facilities team has confirmed that the official floor plan is final.", "Please file any complaint about misplaced equipment with the help desk.", "Coffee will be served in the lounge on the fifth floor during the transition.", "The move coordinator will send a short summary every evening." ], :headings = [ "Office Relocation: Weekly Update", "Practical details" ], :tables = [  ], :lists = [  ], :furniture = [  ], :code = [  ] ] ]
	_a_ + [ pcDir + "v4_g05.png", [ :sentences = [ "Pupils from Year 5 will visit the Dunmore Museum of Industry on 14 May.", "Teachers should work through the four lists below in the week before the trip.", "Complete these steps in the order shown.", "Each pupil should pack the following items.", "The group leader ticks each point at the museum gate.", "The museum does not permit the following.", "Buses leave the school gate at half past eight and return by four." ], :headings = [ "Field Trip Preparation", "Before departure", "What to bring", "Checked on arrival", "Not allowed" ], :tables = [  ], :lists = [ "→ Confirm the bus booking with the depot", "→ Collect the signed permission forms", "→ Print the route map for each group leader", "• A packed lunch and a water bottle", "• A waterproof jacket", "• A notebook and two pencils", "✓ Head count matches the register", "✓ First aid kit is present", "✓ Emergency contact sheet is signed", "- Flash photography in the galleries", "- Food outside the picnic area", "- Large bags in the exhibition halls" ], :furniture = [  ], :code = [  ] ] ]
	_a_ + [ pcDir + "v5_h05.png", [ :sentences = [ "This timetable applies from Monday 8 September 2025 until the October half-term.", "Lessons shaded green are double lessons and take place in the same room without a break.", "Pupils who arrive after 08:50 must sign in at the main office.", "Changes to this timetable are announced in the weekly bulletin." ], :headings = [ "Timetable – Form 8B", "Notes for pupils and parents", "Key" ], :tables = [ [ [ "Time", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" ], [ "08:30–08:50", "Registration and assembly", "Registration and assembly", "Registration and assembly", "Registration and assembly", "Registration and assembly" ], [ "08:50–09:45", "Mathematics Room M4", "English Room E2", "Science Lab 2", "French Room L3", "Geography Room H1" ], [ "09:45–10:40", "History Room H2", "Mathematics Room M4", "Science Lab 2", "English Room E2", "Mathematics Room M4" ], [ "10:40–11:00", "Break", "Break", "Break", "Break", "Break" ], [ "11:00–11:55", "English Room E2", "Art Studio A1", "Mathematics Room M4", "Science Lab 1", "Music Main hall" ], [ "11:55–12:50", "French Room L3", "Art Studio A1", "Religious Education Room H3", "Science Lab 1", "English Room E2" ], [ "12:50–13:40", "Lunch", "Lunch", "Lunch", "Lunch", "Lunch" ], [ "13:40–14:35", "Physical Education Sports hall", "Geography Room H1", "English Room E2", "Computing Room C1", "Science Lab 1" ], [ "14:35–15:30", "Physical Education Sports hall", "Drama Studio D1", "History Room H2", "Mathematics Room M4", "Form tutor time Room F8" ] ] ], :lists = [ "PE kit is needed on Monday afternoons, including trainers for indoor use.", "Science on Wednesday morning takes place in Lab 2 while Lab 1 is refitted.", "Music on Friday is in the main hall until the music block reopens.", "Homework is set in the planner and checked during Friday form tutor time." ], :furniture = [ "Timetable office · Printed 1 September 2025" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v5_h07.png", [ :sentences = [ "Its sealed probe has no exposed metal electrodes, so readings stay stable for several seasons in acidic or saline soils.", "The sensor is installed by pushing it into a pilot hole made with the supplied auger.", "A single cable carries both power and data, which keeps installation simple for irrigation contractors and extension officers.", "Readings taken closer than this mostly show the wetting pattern of the emitter rather than the moisture of the field.", "Several sensors can share one logger, and the logger can send readings to a phone every fifteen minutes.", "Prices exclude VAT and delivery.", "Volume discounts are available for orders of ten or more sensors." ], :headings = [ "AquaSense 300", "Overview", "Features", "Typical applications" ], :tables = [ [ [ "Parameter", "Value" ], [ "Measurement", "Measurement" ], [ "Moisture range", "0 to 60% VWC" ], [ "Accuracy", "±2% VWC after calibration" ], [ "Depths", "10, 20 and 30 cm" ], [ "Temperature accuracy", "±0.5 °C" ], [ "Electrical", "Electrical" ], [ "Supply voltage", "6 to 16 V DC" ], [ "Current", "12 mA active, 30 µA sleep" ], [ "Outputs", "SDI-12 v1.4, Modbus RTU (RS-485)" ], [ "Mechanical", "Mechanical" ], [ "Probe length", "380 mm" ], [ "Housing", "Glass-filled polyamide, IP68" ], [ "Operating range", "−20 to 60 °C" ] ], [ [ "Order code", "Cable", "Price (EUR)" ], [ "AS300-05", "5 m", "214.00" ], [ "AS300-10", "10 m", "229.00" ], [ "AS300-25", "25 m", "262.00" ] ] ], :lists = [ "Measures moisture at three depths along one probe", "Built-in temperature compensation from −10 to 55 °C", "SDI-12 and Modbus RTU outputs on the same cable", "IP68 housing rated for permanent burial", "Factory calibration for mineral soils, with a user table for peat" ], :furniture = [ "Fieldmark Instruments · Datasheet FM-AS300 · Rev. C", "Specifications are subject to change without notice." ], :code = [  ] ] ]
	_a_ + [ pcDir + "v8_n16.png", [ :sentences = [ "This procedure describes the preparation, sterilisation and pouring of LB agar plates for routine bacterial culture.", "It applies to all staff and students who prepare media in the Media Preparation Unit.", "Store the plates inverted at 2–8 °C and use them within four weeks.", "Record the batch number, date and preparer in the media log.", "Discard any plate that shows contamination, cracking or drying." ], :headings = [ "Preparation of Luria–Bertani (LB) Agar Plates", "1 Purpose", "2 Scope", "3 Safety", "4 Materials", "5 Procedure", "6 Storage and records" ], :tables = [ [ [ "Document no.", "Version", "Effective date", "Next review", "Approved by" ], [ "SOP-MB-017", "4.0", "1 September 2026", "1 September 2028", "Head of Media Preparation" ] ], [ [ "Component", "Amount per litre", "Grade" ], [ "Tryptone", "10 g", "Microbiology grade" ], [ "Yeast extract", "5 g", "Microbiology grade" ], [ "Sodium chloride", "10 g", "Analytical reagent" ], [ "Agar", "15 g", "Bacteriological" ], [ "Purified water", "to 1000 mL", "Type II" ] ] ], :lists = [ "Wear a laboratory coat, safety glasses and heat-resistant gloves when handling hot media.", "Never open the autoclave until the chamber pressure has returned to zero.", "Report any burn or spillage to the unit supervisor immediately.", "Weigh the dry components into a 2 L glass bottle.", "Add 900 mL of purified water and stir until the powders are fully suspended.", "Adjust the volume to 1000 mL.", "Sterilise by autoclaving:", "121 °C for 15 minutes on the liquid cycle;", "loosen the cap by a quarter turn before loading.", "Cool the medium to about 50 °C in a water bath.", "If required, add the antibiotic aseptically and swirl gently to mix.", "Pour approximately 20 mL into each sterile Petri dish and allow the plates to set." ], :furniture = [ "Kestrel Ridge Institute for Applied Microbiology", "Media Preparation Unit · Building C, 40 Larchmere Road, Kestrel Ridge KR7 2PD · Tel. 01632 960 733", "Uncontrolled when printed", "SOP-MB-017 v4.0 · Page 1 of 1" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v8_n19.png", [ :sentences = [ "LARL is a non-profit organisation that helps smallholder farmers around Lake Kyoga to raise their incomes and adapt to a changing climate.", "We currently work with 18,000 households in five districts.", "Send a cover letter and a CV of no more than three pages to jobs@larl.example, quoting the reference number in the subject line.", "Only shortlisted candidates will be contacted.", "LARL does not charge any fee at any stage of the recruitment process." ], :headings = [ "Vacancy Announcement: Monitoring, Evaluation and Learning Officer", "About us", "Key responsibilities", "Qualifications and experience", "How to apply" ], :tables = [ [ [ "Reference", "LARL/HR/2026/031" ], [ "Duty station", "Mbale, with frequent travel to Bukedea and Kumi" ], [ "Contract", "Two years, renewable subject to funding and performance" ], [ "Reporting to", "Programme Manager" ], [ "Closing date", "14 November 2026, 17:00 East Africa Time" ] ] ], :lists = [ "Maintain the programme’s results framework and indicator reference sheets.", "Plan and supervise baseline, midline and endline surveys.", "Train field officers in data collection and data quality checks.", "Prepare quarterly progress reports and dashboards for donors and partners.", "Organise learning reviews with farmer groups and district officials.", "A bachelor’s degree in statistics, economics, agriculture or a related field", "At least three years of experience in monitoring and evaluation, including:", "designing household surveys and sampling plans", "managing data collection on mobile phones or tablets", "Strong skills in spreadsheets and in at least one statistical package", "Fluency in English; knowledge of Ateso or Lusoga is an advantage" ], :furniture = [ "LARL", "Lakeshore Alliance for Rural Livelihoods", "Plot 22, Kanyanja Road · P.O. Box 4187, Mbale, Uganda", "Tel. +256 39 000 4187 · jobs@larl.example", "LARL is an equal opportunity employer. Women and people with disabilities are encouraged to apply.", "Registered NGO No. 0418/2014 · www.larl.example" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v9_p08.png", [ :sentences = [ "Prices are valid from Wednesday, November 4 through Tuesday, November 10, 2026.", "Rewards members earn one point for every dollar spent.", "Digital coupons can be loaded to your rewards card in the FreshWay app.", "Items marked with a star are limited per household, while supplies last.", "We reserve the right to limit quantities.", "We are not responsible for typographical or pictorial errors." ], :headings = [ "This Week's Specials", "Fresh Produce", "Meat & Seafood", "Dairy & Bakery", "Pantry Staples", "Rewards & Coupons", "Store Information" ], :tables = [ [ [ "Day", "Store hours", "Pharmacy hours" ], [ "Monday – Friday", "7:00 am – 10:00 pm", "9:00 am – 8:00 pm" ], [ "Saturday", "7:00 am – 10:00 pm", "9:00 am – 5:00 pm" ], [ "Sunday", "8:00 am – 9:00 pm", "Closed" ] ] ], :lists = [  ], :furniture = [ "FreshWay Market", "Store #214 · Riverside Plaza", "Weekly ad · Rewards members save more", "FreshWay Market · 1820 Riverside Plaza, Millbrook · (555) 014-2201 · Open 7 days a week" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v10_q09.png", [ :sentences = [ "Buses on this route are wheelchair accessible and carry up to two folded bicycles.", "Please have your ticket or contactless card ready when you board.", "During roadworks on Fenwick Road, buses may run up to five minutes late between the hospital and Ashby Village.", "Live departure times are shown at every stop with a display screen." ], :headings = [ "Route 42 weekday timetable", "Fares", "What changes on 2 November" ], :tables = [ [ [ "Stop", "Morning", "Morning", "Morning", "Morning", "Morning", "Daytime", "Daytime", "Daytime", "Evening", "Evening", "Evening", "Evening" ], [ "Stop", "4201", "4203", "4205", "4207", "4209", "4211", "4213", "4215", "4217", "4219", "4221", "4223" ], [ "Harbour Station", "06:10", "06:40", "07:10", "07:35", "08:05", "10:15", "12:15", "14:15", "16:20", "17:00", "17:45", "19:10" ], [ "Quay Street", "06:13", "06:43", "07:13", "07:38", "08:08", "10:18", "12:18", "14:18", "16:23", "17:03", "17:48", "19:13" ], [ "Market Cross", "06:16", "06:46", "07:16", "07:41", "08:11", "10:21", "12:21", "14:21", "16:26", "17:06", "17:51", "19:16" ], [ "Northgate Library", "06:20", "06:50", "07:20", "07:45", "08:15", "10:25", "12:25", "14:25", "16:30", "17:10", "17:55", "19:20" ], [ "Kelmscott Hospital", "06:26", "06:56", "07:26", "07:51", "08:21", "10:31", "12:31", "14:31", "16:36", "17:16", "18:01", "19:26" ], [ "Fenwick Road", "06:31", "07:01", "07:31", "07:56", "08:26", "10:36", "12:36", "14:36", "16:41", "17:21", "18:06", "19:31" ], [ "Ashby Village", "06:37", "07:07", "07:37", "08:02", "08:32", "10:42", "12:42", "14:42", "16:47", "17:27", "18:12", "19:37" ], [ "Ashby School", "—", "—", "07:40", "08:05", "—", "—", "—", "14:45", "16:50", "—", "—", "—" ], [ "Larch Lane", "06:43", "07:13", "07:43", "08:08", "08:38", "10:48", "12:48", "14:48", "16:53", "17:33", "18:18", "19:43" ], [ "Ashby Park & Ride", "06:47", "07:17", "07:47", "08:12", "08:42", "10:52", "12:52", "14:52", "16:57", "17:37", "18:22", "19:47" ] ], [ [ "Ticket", "Adult", "Child (5–15)", "Concession" ], [ "Single, any distance", "£2.40", "£1.20", "£1.60" ], [ "Day ticket", "£5.10", "£2.50", "£3.40" ], [ "7-day ticket", "£19.00", "£9.50", "£12.50" ] ] ], :lists = [ "The 06:10 journey now starts from Harbour Station instead of Quay Street.", "School journeys serve Ashby School on weekdays in term time only.", "The last evening journey leaves at 19:10, ten minutes later than before." ], :furniture = [ "Brackenridge Regional Transit", "42", "Timetable valid from 2 November 2026 until further notice", "Customer line 0300 555 0142 · brt.example/42" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v14_w17.png", [ :sentences = [ "Please pay £218.58 by 20 October 2026.", "We will collect this amount by Direct Debit on or after 20 October 2026, so you do not need to do anything.", "Your estimated annual consumption is 3,640 kWh, based on your readings over the last twelve months.", "If your night reading looks wrong, send us a photo of your meter within 14 days and we will reissue the bill.", "As a member-owned co-operative, any surplus we make is returned to members or invested in local renewable energy." ], :headings = [ "Your electricity bill", "Account summary", "Meter readings", "Charges for 1 July to 30 September 2026", "Ways to save" ], :tables = [ [ [ "Previous balance", "£112.40" ], [ "Payment received 18 July, thank you", "−£112.40" ], [ "Charges this period", "£218.58" ], [ "Amount due", "£218.58" ] ], [ [ "Register", "Previous", "Current", "Units" ], [ "Day", "41 872 A", "42 391 A", "519" ], [ "Night", "18 203 A", "18 592 E", "389" ] ], [ [ "Description", "Quantity", "Rate", "Amount" ], [ "Day units", "519 kWh", "27.40p per kWh", "£142.21" ], [ "Night units", "389 kWh", "13.10p per kWh", "£50.96" ], [ "Standing charge", "92 days", "51.20p per day", "£47.10" ], [ "Smart export credit", "214 kWh", "15.00p per kWh", "−£32.10" ], [ "Subtotal", "Subtotal", "Subtotal", "£208.17" ], [ "VAT at 5%", "VAT at 5%", "VAT at 5%", "£10.41" ], [ "Total charges", "Total charges", "Total charges", "£218.58" ] ] ], :lists = [ "Run your washing machine and dishwasher after 22:00, when night units are cheaper.", "Members can join the community solar share scheme from 1 January.", "Ask us for a free home energy check if your usage has risen by more than 10%." ], :furniture = [ "Brightwater Energy Co-operative", "PO Box 2204, Lowfield LF3 9QA", "0300 000 6612 · brightwater.example", "Brightwater Energy Co-operative Ltd is a registered society, number 31877R.", "Page 1 of 1" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v17_z17.png", [ :sentences = [ "A cold front will cross Kestrel Bay between 07:00 and 09:00 UTC with gusts up to 35 knots.", "Expect moderate turbulence below 8,000 feet on the approach to Kestrel Bay.", "Report any fatigue concerns to crew control before signing on for duty.", "This briefing package is valid only for the duty date shown and must not be reused." ], :headings = [ "Crew Briefing: Pairing HCA-4471", "DUTY SUMMARY", "CREW", "SECTORS", "WEATHER", "NOTAM SUMMARY", "OPERATIONAL NOTES" ], :tables = [ [ [ "Report time", "05:10 UTC" ], [ "Duty end", "14:25 UTC" ], [ "Aircraft", "A220-300, fleet no. 312" ], [ "Maximum duty period", "11:30" ] ], [ [ "Captain", "D. Moravec" ], [ "First Officer", "L. Adebayo-King" ], [ "Cabin manager", "S. Rautio" ], [ "Cabin crew", "P. Oyelowo, J. Brennan" ] ], [ [ "Flight", "From", "To", "STD (UTC)", "STA (UTC)", "Block", "Fuel planned (kg)", "Alternate" ], [ "HC 401", "Port Alder", "Kestrel Bay", "06:10", "07:25", "1:15", "4,850", "Mirren" ], [ "HC 402", "Kestrel Bay", "Port Alder", "08:05", "09:20", "1:15", "4,700", "Ostrow" ], [ "HC 517", "Port Alder", "Mirren", "10:15", "11:50", "1:35", "5,600", "Kestrel Bay" ], [ "HC 518", "Mirren", "Port Alder", "12:35", "14:05", "1:30", "5,450", "Ostrow" ] ] ], :lists = [ "• Captain to brief the crosswind limits before departure from Port Alder.", "• Catering for HC 517 includes 4 special meals; confirm loading with the dispatcher.", "• Cabin crew to complete the security search of the aircraft before the first sector." ], :furniture = [ "Halcyon Coast Airways", "Flight Operations", "Crew Briefing Package", "Valid for duty date 24 OCT 2026 only", "Sheet 1 of 1" ], :code = [ "A1182/26 KESTREL BAY RWY 09/27 CLSD 0600-0730 DUE WIP.
         RWY 14/32 AVBL, LDA 2150M.
A1190/26 PORT ALDER ILS RWY 22 GP U/S UNTIL 28 OCT 2026.
         LOC/DME APCH AVBL.
B0417/26 MIRREN TWY C BTN TWY C2 AND C4 CLSD." ] ] ]
	_a_ + [ pcDir + "v18_a24.png", [ :sentences = [ "The rates below apply to all members served from the cooperative's distribution system.", "They were approved after a cost-of-service study that showed revenue from residential members falling short of the cost of serving them.", "The basic charge covers the cost of the meter, billing and the line that connects your premises, whatever the amount of energy you use.", "The energy charge is multiplied by the kilowatt-hours recorded during the billing period." ], :headings = [ "Schedule of Retail Electricity Rates", "Rate table", "Other charges", "How to read your bill", "Notes" ], :tables = [ [ [ "Rate class", "Code", "Basic charge ($/month)", "Energy charge (¢/kWh)", "Energy charge (¢/kWh)", "Demand charge ($/kW)" ], [ "Rate class", "Code", "Basic charge ($/month)", "Summer (Jun–Sep)", "Winter (Oct–May)", "Demand charge ($/kW)" ], [ "Residential", "R-1", "24.00", "11.42", "10.18", "–" ], [ "Residential time-of-use, on-peak hours", "R-TOU", "26.50", "19.85", "16.40", "–" ], [ "Residential time-of-use, off-peak hours", "R-TOU", "26.50", "7.96", "7.12", "–" ], [ "Small commercial (up to 50 kW)", "C-1", "38.00", "12.05", "10.77", "–" ], [ "Large power (over 50 kW)", "LP-2", "145.00", "7.31", "6.88", "14.25" ], [ "Irrigation pumping", "IR-1", "30.00", "9.64", "9.64", "6.10" ], [ "Outdoor lighting, per fixture", "OL", "11.75", "–", "–", "–" ] ], [ [ "Power cost adjustment", "up to ±0.25 ¢/kWh, reviewed each quarter" ], [ "Late payment charge", "1.5% of the overdue balance" ], [ "Reconnection during business hours", "$65.00" ], [ "Reconnection after hours", "$180.00" ], [ "Returned payment", "$25.00" ] ] ], :lists = [ "1. On-peak hours for rate R-TOU are 2 p.m. to 8 p.m. on weekdays, excluding public holidays.", "2. The summer energy charge applies to meter readings taken from 1 June to 30 September.", "3. Members whose demand exceeds 50 kW in three consecutive months are moved to rate LP-2.", "4. A copy of the full tariff, including terms of service, is available at the member services office." ], :furniture = [ "Brindle Valley Electric Cooperative", "410 Depot Road, Brindle Falls", "Member services (555) 014-2290", "Approved by the Board of Directors on 18 November 2026 · Tariff sheet No. 3, Revision 12" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v19_b11.png", [ :sentences = [ "Three compliant tenders were received by the closing date of 23 January.", "Each tender was scored against the criteria published in the invitation to tender, with price weighted at 40%.", "Prices were scored in proportion to the lowest compliant tender.", "We recommend that the contract is awarded to Brightwell Services, which achieved the highest overall score.", "Its price is £13,450 a year higher than the lowest tender, but its method statement is considerably stronger.", "The current contract with the outgoing supplier ends on 31 March 2026 and cannot be extended." ], :headings = [ "Office Cleaning Contract: Comparison of Tenders", "Scoring summary", "Risks", "Recommendation", "Next steps" ], :tables = [ [ [ "To", "Property and Facilities Committee" ], [ "From", "Facilities Team" ], [ "Date", "6 February 2026" ], [ "Subject", "Award of the cleaning contract for Kingsgate House, 2026–2029" ] ], [ [ "Criterion (weight)", "Brightwell Services", "Corran Clean Ltd", "Silverbirch Facilities" ], [ "Price (40%)", "35 £118,400 a year", "40 £104,950 a year", "32 £131,200 a year" ], [ "Method statement (25%)", "21", "17", "22" ], [ "Staffing and supervision (15%)", "12", "10", "12" ], [ "Environmental approach (10%)", "8", "6", "9" ], [ "References (10%)", "9", "7", "9" ], [ "Total (100%)", "85", "80", "84" ] ] ], :lists = [ "Corran Clean’s price depends on a staff turnover rate that looks optimistic.", "Silverbirch would need six weeks to mobilise, which would delay the start to May.", "All three bidders assume the current opening hours of the building.", "i. Committee decision at the meeting of 19 February.", "ii. Standstill period of ten days, then contract signature.", "iii. Contract start on 1 April 2026." ], :furniture = [ "Ravensmoor Housing Trust · Facilities Team", "Internal document — not for circulation outside the Trust" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v21_d11.png", [ :sentences = [ "The forum brings together utilities, regulators and community groups to discuss how river catchments can be managed for both people and wildlife.", "Sessions in Hall A focus on policy and finance, while Hall B hosts practical case studies.", "Helena leads the catchment science group at the Brackenford Environment Trust.", "Her talk opens the forum with a view of rivers as infrastructure that serves every sector.", "Samuel chairs the regional farmers network and has converted his own land to wetland grazing.", "He will speak about the costs and rewards of changing farm practice.", "Ana studies public finance and has advised several water regulators.", "Her closing keynote asks who should pay for a healthy river." ], :headings = [ "Programme: Day One", "Schedule", "Keynote speakers", "Dr Helena Marsh", "Samuel Okonjo", "Prof. Ana Lindqvist", "Practical information" ], :tables = [ [ [ "Time", "Hall A: Policy and finance", "Hall B: Case studies" ], [ "08:30", "Registration and coffee", "Registration and coffee" ], [ "09:15", "Opening keynote: Rivers as shared infrastructure", "Opening keynote: Rivers as shared infrastructure" ], [ "10:15", "Paying for catchment restoration: lessons from three funding models", "Rebuilding the Ashby meanders: five years on" ], [ "11:15", "Regulating diffuse pollution", "Farmers as water managers" ], [ "12:30", "Lunch and poster exhibition", "Lunch and poster exhibition" ], [ "13:45", "Panel: who owns the flood risk?", "Citizen monitoring networks" ], [ "15:00", "Water pricing and fairness", "Urban rivers and new housing" ], [ "16:15", "Closing keynote and reception", "Closing keynote and reception" ] ] ], :lists = [ "Badges must be worn at all times inside the centre.", "Wireless access is available in both halls and in the exhibition area.", "Slides from each session will be shared with registered delegates after the forum." ], :furniture = [ "BRACKENFORD WATER FORUM 2026", "Thursday 14 May 2026 · Brackenford Exchange Centre", "Brackenford Water Forum · Programme subject to change", "forum@brackenford-water.example" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v22_e10.png", [ :sentences = [ "Welcome to the second annual conference of the Northshore Library Network.", "This year’s theme is reading in a changing community.", "All sessions in the Lecture Theatre will be recorded and published within two weeks.", "Please wear your badge at all times while in the building." ], :headings = [ "Programme — Day One", "Practical information", "Contacts", "Wi-Fi" ], :tables = [ [ [ "Time", "Session", "Room" ], [ "Morning", "Morning", "Morning" ], [ "08:30–09:15", "Registration and coffee", "Atrium" ], [ "09:15–09:30", "Opening remarks Director, Northshore Library Network", "Lecture Theatre" ], [ "09:30–10:30", "Keynote: The library as a third place Dr Amara Lindqvist-Obi", "Lecture Theatre" ], [ "10:30–11:00", "Break", "Atrium" ], [ "11:00–12:30", "Workshop A: Running a repair café Workshop B: Story time for multilingual families", "Room 2.04 Room 2.06" ], [ "Afternoon", "Afternoon", "Afternoon" ], [ "13:30–14:30", "Panel: Keeping small branches open", "Lecture Theatre" ], [ "14:30–15:30", "Lightning talks Six speakers, ten minutes each", "Room 1.10" ], [ "15:30–16:00", "Closing remarks and prize draw", "Lecture Theatre" ] ], [ [ "Registration desk", "ext. 210" ], [ "First aid", "ext. 222" ], [ "Lost property", "Atrium desk" ] ] ], :lists = [ "Lunch is served in the Atrium from 12:30.", "Cloakroom on the ground floor, next to the lifts.", "Quiet room: Room 1.02, open all day.", "Step-free access from the Quay Street entrance." ], :furniture = [ "NORTHSHORE LIBRARY NETWORK", "Annual Conference 2026 · Harbourside Civic Centre · 6–7 November", "Northshore Library Network · Conference 2026 · Programme subject to change" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v22_e22.png", [ :sentences = [ "The PSU-450 series converts single-phase mains into a stable 24 V or 48 V supply for control cabinets.", "All models are cooled by natural convection and need no fan.", "Above 60 °C the output power must be reduced by 2.5% per degree.", "Two units of the same model can be connected in parallel for redundancy." ], :headings = [ "PSU-450 Series DIN-Rail Power Supplies", "Key features", "Typical applications", "Derating and installation", "Ordering information" ], :tables = [ [ [ "Model", "Output", "Output", "Output", "Efficiency", "Width", "Weight" ], [ "Model", "Voltage", "Current", "Power", "Efficiency", "Width", "Weight" ], [ "PSU-450-24", "24 V DC", "10 A", "240 W", "93.5%", "40 mm", "0.62 kg" ], [ "PSU-450-24H", "24 V DC", "20 A", "480 W", "94.8%", "60 mm", "0.98 kg" ], [ "PSU-450-48", "48 V DC", "5 A", "240 W", "94.0%", "40 mm", "0.61 kg" ], [ "PSU-450-48H", "48 V DC", "10 A", "480 W", "95.2%", "60 mm", "0.97 kg" ] ], [ [ "Input voltage", "100–240 V AC" ], [ "Frequency", "50/60 Hz" ], [ "Operating temperature", "−25 to +70 °C" ], [ "Protection class", "IP20" ], [ "MTBF", "> 900,000 h" ] ], [ [ "Order code", "Description" ], [ "HE-450-24", "PSU-450-24 with screw terminals" ], [ "HE-450-24H", "PSU-450-24H with screw terminals" ], [ "HE-450-48P", "PSU-450-48 with push-in terminals" ], [ "HE-450-48HP", "PSU-450-48H with push-in terminals" ] ] ], :lists = [ "Wide input range for use on any mains supply", "Power reserve of 20% for five seconds", "DC OK relay contact for remote monitoring", "Tool-free mounting on 35 mm rails", "Machine control cabinets", "Building automation panels", "Conveyor and packaging lines", "Water treatment plants" ], :furniture = [ "HALVARD ELECTRIC", "Product data sheet", "Halvard Electric · DS-PSU-450 Rev. C · October 2026 · Specifications subject to change without notice" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v23_f17.png", [ :sentences = [ "The sample was analysed in the condition in which it was received.", "Results relate only to the sample tested and are compared with the limits for drinking water supplies.", "The sample does not meet the drinking water limits for coliform bacteria, iron and pH.", "We recommend disinfecting the borehole and taking a repeat sample after 14 days.", "Until a satisfactory result is obtained, water for drinking should be boiled or taken from a bottled supply." ], :headings = [ "Water Quality Test Report", "Results", "Remarks", "Interpretation" ], :tables = [ [ [ "Client", "Ashgrove Farm Holidays" ], [ "Address", "Ashgrove Lane, Upper Wyke UW3 8NB" ], [ "Contact", "Site manager" ], [ "Order no.", "AFH-0926" ] ], [ [ "Sample ID", "WQ-26-1187-01" ], [ "Source", "Private borehole, kitchen tap" ], [ "Collected", "14 Oct 2026, 09:40" ], [ "Received", "14 Oct 2026, 13:15" ], [ "Condition", "Chilled, intact seal" ] ], [ [ "Parameter", "Method", "Result", "Unit", "Limit", "Assessment" ], [ "Microbiological", "Microbiological", "Microbiological", "Microbiological", "Microbiological", "Microbiological" ], [ "Escherichia coli", "ISO 9308-1 membrane filtration", "0", "cfu/100 ml", "0", "Complies" ], [ "Coliform bacteria", "ISO 9308-1 membrane filtration", "3", "cfu/100 ml", "0", "Does not comply (see remark 1)" ], [ "Chemical", "Chemical", "Chemical", "Chemical", "Chemical", "Chemical" ], [ "Nitrate (as NO3)", "Ion chromatography", "38.2", "mg/l", "50", "Complies" ], [ "Iron", "ICP-OES", "0.41", "mg/l", "0.20", "Does not comply (see remark 2)" ], [ "Manganese", "ICP-OES", "0.032", "mg/l", "0.050", "Complies" ], [ "Fluoride", "Ion-selective electrode", "0.6", "mg/l", "1.5", "Complies" ], [ "Physical", "Physical", "Physical", "Physical", "Physical", "Physical" ], [ "pH at 20 °C", "Electrometric", "6.4", "pH units", "6.5 – 9.5", "Does not comply (see remark 3)" ], [ "Turbidity", "Nephelometric", "2.8", "NTU", "4", "Complies" ] ] ], :lists = [ "Coliform bacteria were detected while E. coli was absent, which points to surface ingress rather than faecal contamination.", "Iron above the indicator value can stain sanitary ware and laundry.", "Slightly acidic water can dissolve copper and lead from older pipework." ], :furniture = [ "Fernhill Analytical Laboratories", "Accredited testing laboratory No. 4471", "Unit 9, Brookside Science Park, Fernhill FH2 6LQ", "lab@fernhill-analytical.example · 01632 960 552", "Report WQ-26-1187 · issued 22 October 2026", "Page 1 of 1" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v24_g22.png", [ :sentences = [ "This order is placed under our standard terms of purchase, which are available on request.", "Please confirm acceptance of the order and the delivery date within two working days.", "Any change to price, quantity or specification must be agreed in writing before dispatch.", "Part deliveries will not be accepted without the buyer's prior approval." ], :headings = [ "Purchase Order", "Delivery instructions", "Authorisation" ], :tables = [ [ [ "PO number", "HJS-PO-26-0931" ], [ "Order date", "27 October 2026" ], [ "Required by", "10 November 2026" ], [ "Buyer", "Callum Ashdown" ] ], [ [ "Line", "Supplier code", "Description", "Species / grade", "Dimensions (mm)", "Qty", "Unit", "Unit price (£)", "Discount", "Line total (£)" ], [ "1", "OAK-PSE-2045", "Oak boards, planed all round", "European oak, prime grade", "20 × 145 × 2400", "120", "board", "38.60", "5%", "4,400.40" ], [ "2", "ASH-SAW-5020", "Ash sawn boards, kiln dried", "European ash, 1st & 2nd", "50 × 200 × 3000", "24", "board", "61.25", "5%", "1,396.50" ], [ "3", "SPR-CLS-3863", "Spruce studs", "C24 graded spruce", "38 × 63 × 2400", "400", "length", "3.18", "0%", "1,272.00" ], [ "4", "PLY-BIR-18", "Birch plywood sheets", "Birch, BB/BB face", "18 × 1220 × 2440", "30", "sheet", "72.40", "7.5%", "2,009.10" ], [ "5", "MDF-MR-25", "Moisture-resistant MDF", "MR MDF, E1", "25 × 1220 × 2440", "16", "sheet", "41.90", "0%", "670.40" ], [ "6", "DOW-BEE-12", "Beech dowels, fluted", "Beech", "Ø 12 × 1000", "200", "length", "0.94", "0%", "188.00" ], [ "7", "GLU-PVA-D3", "Wood glue, D3 water resistant", "—", "5 litre tub", "12", "tub", "23.75", "0%", "285.00" ], [ "8", "SAN-P120-R", "Sanding rolls, P120", "Aluminium oxide", "115 mm × 50 m", "10", "roll", "18.20", "10%", "163.80" ], [ "Goods total", "Goods total", "Goods total", "Goods total", "Goods total", "Goods total", "Goods total", "Goods total", "Goods total", "10,385.20" ], [ "Carriage", "Carriage", "Carriage", "Carriage