	_a_ + [ pcDir + "v25_h17.png", [ :sentences = [ "All rooms have step-free access and hearing loops.", "A quiet room is available on the first floor throughout the day.", "Large print copies of this programme are available on request.", "Please speak to the registration desk if you need any other support." ], :headings = [ "Coastal Resilience Forum 2026", "Day 2 programme — Thursday 19 November 2026", "Practical information", "Accessibility" ], :tables = [ [ [ "Time", "Main Hall", "Room A — Planning", "Room B — Engineering", "Room C — Communities" ], [ "08:30–09:00", "Registration and coffee", "Registration and coffee", "Registration and coffee", "Registration and coffee" ], [ "09:00–10:00", "Keynote: Managed retreat after a decade of storms Dr Ines Holloway, Northern Coast Authority", "Keynote: Managed retreat after a decade of storms Dr Ines Holloway, Northern Coast Authority", "Keynote: Managed retreat after a decade of storms Dr Ines Holloway, Northern Coast Authority", "Keynote: Managed retreat after a decade of storms Dr Ines Holloway, Northern Coast Authority" ], [ "10:00–11:00", "Session 2A Insurance markets and coastal property Chair: M. Adeyemi", "Session 2B Zoning rules for flood-prone land Chair: K. Lindqvist", "Session 2C Nature-based sea defences: first results Chair: P. Rossetti", "Session 2D Working with volunteer flood wardens Chair: S. Okonkwo" ], [ "11:00–11:30", "Break and poster viewing", "Break and poster viewing", "Break and poster viewing", "Break and poster viewing" ], [ "11:30–12:30", "Panel: Who pays for adaptation?", "Session 3B Land swaps and buy-out schemes", "Session 3C Monitoring dunes with drones", "Session 3D Schools as emergency shelters" ], [ "12:30–13:30", "Lunch, Terrace Restaurant", "Lunch, Terrace Restaurant", "Lunch, Terrace Restaurant", "Lunch, Terrace Restaurant" ], [ "13:30–14:30", "Session 4A Measuring resilience: indicators that work", "Workshop: Mapping flood exposure with open data Bring a laptop; places limited to 30", "Session 4C Drainage design for heavier rainfall", "Session 4D Recovery funds for small businesses" ], [ "14:30–15:30", "Session 5A Lessons from the 2025 surge", "Workshop: Mapping flood exposure with open data Bring a laptop; places limited to 30", "Session 5C Retrofitting harbour walls", "Session 5D Telling the story: local media" ], [ "15:30–16:15", "Closing plenary and poster awards", "Closing plenary and poster awards", "Closing plenary and poster awards", "Closing plenary and poster awards" ] ] ], :lists = [ "Badges must be worn at all times in the conference centre.", "Session rooms are on the first floor; the Main Hall is on the ground floor.", "Slides from all sessions will be shared with registered delegates after the event." ], :furniture = [ "Coastal Resilience Forum 2026 · Harbourside Conference Centre · Programme subject to change" ], :code = [  ] ] ]
	_a_ + [ pcDir + "v25_h23.png", [ :sentences = [ "The lot described above was tested against the current product specification, and the results are reported below.", "All results comply with the specification, and the lot is released for sale.", "This certificate was generated from the laboratory information system and is valid without a handwritten signature.", "Raw data are kept for at least ten years after the retest date." ], :headings = [ "Certificate of Analysis", "Test results", "Conclusion" ], :tables = [ [ [ "Product name", "Sodium chloride, low endotoxin" ], [ "Catalogue number", "MBM-SC-500" ], [ "Grade", "Pharmacopoeial, for bioprocessing" ], [ "Pack size", "25 kg drum" ] ], [ [ "Lot number", "SC26-1043" ], [ "Date of manufacture", "06 October 2026" ], [ "Retest date", "05 October 2029" ], [ "Storage", "Below 30 °C, keep container closed" ] ], [ [ "Test", "Method", "Unit", "Specification", "Specification", "Result", "Status", "Analyst", "Date" ], [ "Test", "Method", "Unit", "Lower", "Upper", "Result", "Status", "Analyst", "Date" ], [ "Assay (dried basis)", "Ph. Eur. 0193", "%", "99.0", "100.5", "99.8", "Pass", "R. Feld", "12 Oct 2026" ], [ "Loss on drying", "Ph. Eur. 2.2.32", "%", "–", "0.5", "0.12", "Pass", "R. Feld", "12 Oct 2026" ], [ "pH (5 % solution)", "USP <791>", "–", "5.0", "9.0", "6.4", "Pass", "T. Ansah", "13 Oct 2026" ], [ "Bacterial endotoxins", "Ph. Eur. 2.6.14", "EU/g", "–", "0.5", "< 0.1", "Pass", "M. Kowal", "14 Oct 2026" ], [ "Total aerobic microbial count", "Ph. Eur. 2.6.12", "CFU/g", "–", "100", "< 10", "Pass", "M. Kowal", "19 Oct 2026" ], [ "Sulfates", "Ph. Eur. 0193", "ppm", "–", "200", "< 50", "Pass", "T. Ansah", "13 Oct 2026" ], [ "Iron", "Ph. Eur. 2.4.9", "ppm", "–", "2", "< 1", "Pass", "R. Feld", "12 Oct 2026" ], [ "Heavy metals (as Pb)", "ICP-MS, QC-M-071", "ppm", "–", "5", "0.3", "Pass", "T. Ansah", "15 Oct 2026" ], [ "Appearance", "Visual, QC-M-002", "–", "White crystalline powder", "White crystalline powder", "Conforms", "Pa