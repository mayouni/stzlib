	_a_ + [ pcDir + "v26_k16.png", [ :sentences = [ "All specimens were received in good condition and were tested within the permitted tolerance on age.", "Strength is the maximum load divided by the nominal cross-sectional area of 22,500 mm².", "Specimen C-308 showed an unsatisfactory failure pattern and its result should be treated with caution.", "The results relate only to the specimens tested." ], :headings = [ "Test Report: Compressive Strength of Concrete Cubes" ], :tables = [ [ [ "Sample ref.", "Pour date", "Location", "Age (days)", "Test date", "Specimen", "Specimen", "Result", "Result", "Result", "Failure mode" ], [ "Sample ref.", "Pour date", "Location", "Age (days)", "Test date", "Mass (kg)", "Density (kg/m³)", "Max. load (kN)", "Strength (MPa)", "Mean (MPa)", "Failure mode" ], [ "C-301", "15/09/2026", "Abutment A footing, east bay", "7", "22/09/2026", "8.12", "2406", "742.5", "33.0", "33.0", "Satisfactory" ], [ "C-302", "15/09/2026", "Abutment A footing, east bay", "7", "22/09/2026", "8.09", "2397", "731.3", "32.5", "33.0", "Satisfactory" ], [ "C-303", "15/09/2026", "Abutment A footing, east bay", "7", "22/09/2026", "8.15", "2415", "751.5", "33.4", "33.0", "Satisfactory" ], [ "C-304", "15/09/2026", "Abutment A footing, east bay", "28", "13/10/2026", "8.11", "2403", "1008.0", "44.8", "44.8", "Satisfactory" ], [ "C-305", "15/09/2026", "Abutment A footing, east bay", "28", "13/10/2026", "8.14", "2412", "994.5", "44.2", "44.8", "Satisfactory" ], [ "C-306", "15/09/2026", "Abutment A footing, east bay", "28", "13/10/2026", "8.07", "2391", "1023.8", "45.5", "44.8", "Satisfactory" ], [ "C-307", "23/09/2026", "Abutment A wall, lift 1", "7", "30/09/2026", "8.05", "2385", "652.5", "29.0", "29.0", "Satisfactory" ], [ "C-308", "23/09/2026", "Abutment A wall, lift 1", "7", "30/09/2026", "8.10", "2400", "639.0", "28.4", "29.0", "Unsatisfactory" ], [ "C-309", "23/09/2026", "Abutment A wall, lift 1", "7", "30/09/2026", "8.02", "2376", "668.3", "29.7", "29.0", "Satisfactor