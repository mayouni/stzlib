load "../../stzBase.ring"
load "../_narrated.ring"

# stzDateTime before 1970: the engine's FromUnix answers no date for a negative count, so every
# FromXSinceEpoch with a negative count, and every origin earlier than 1970, read as 0-00-00.
# They are split Ring-side now. Run from this folder: ring dtfix_pre1970_narrated.ring

Scenario("A negative count of seconds, minutes, hours, days or weeks is a date before 1970")
	o = new stzDateTime("2026-03-05 14:30:00")
	o.FromSecondsSinceEpoch(-86400)
	Then("minus one day of seconds is 1969-12-31", o.ToIso(), "1969-12-31 00:00:00")
	o.FromSecondsSinceEpoch(-1)
	Then("minus one second is the last second of 1969", o.ToIso(), "1969-12-31 23:59:59")
	o.FromMillisecondsSinceEpoch(-1)
	Then("minus one millisecond keeps its milliseconds", o.ToIsoWithMs(), "1969-12-31 23:59:58.999")
	o.FromMinutesSinceEpoch(-90)
	Then("minus 90 minutes", o.ToIso(), "1969-12-31 22:30:00")
	o.FromHoursSinceEpoch(-25)
	Then("minus 25 hours", o.ToIso(), "1969-12-30 23:00:00")
	o.FromDaysSinceEpoch(-365)
	Then("minus 365 days is 1 January 1969", o.ToIso(), "1969-01-01 00:00:00")
	o.FromWeeksSinceEpoch(-1)
	Then("minus one week", o.ToIso(), "1969-12-25 00:00:00")
	o.FromDaysSinceEpoch(-719162)
	Then("minus 719162 days is 1 January of year 1 (padded to four digits)", o.ToIso(), "0001-01-01 00:00:00")
	o.FromDaysSinceEpoch(-25508)
	Then("a leap day before 1970 is found (1900 is no leap year, 1896 is)", o.ToIso(), "1900-03-01 00:00:00")
	o.FromDaysSinceEpoch(-25509)
	Then("so the day before 1900-03-01 is 28 February", o.ToIso(), "1900-02-28 00:00:00")
	o.FromDaysSinceEpoch(-135081)
	Then("1600, a leap year, has a 29 February", o.ToIso(), "1600-02-29 00:00:00")
EndScenario()

Scenario("The components agree with the stzDate arithmetic, which was already right before 1970")
	o = new stzDateTime("2026-03-05 14:30:00")
	oD = new stzDate("1955-07-04")
	o.FromDaysSinceEpoch(oD.DaysTo("1970-01-01") * -1)
	Then("the day count back to 1970 lands on the same date", o.Date(), "1955-07-04")
	o = new stzDateTime("1955-07-04 10:20:30")
	Then("the seconds since the epoch of a 1955 date are negative", o.ToSecondsSinceEpochXT(:UnixEpoch) < 0, 1)
	n = o.ToSecondsSinceEpochXT(:UnixEpoch)
	o2 = new stzDateTime("2026-03-05 14:30:00")
	o2.FromSecondsSinceEpoch(n)
	Then("and reading them back gives the date and time again", o2.ToIso(), "1955-07-04 10:20:30")
EndScenario()

Scenario("An origin earlier than 1970 is a date, not 0-00-00")
	o = new stzDateTime("2026-03-05 14:30:00")
	o.FromSecondsSinceEpochXT(0, :YearOne)
	Then("YearOne is 1 January of year 1", o.ToIso(), "0001-01-01 00:00:00")
	o.FromSecondsSinceEpochXT(10, :FrenchRevolution)
	Then("FrenchRevolution plus ten seconds", o.ToIso(), "1792-09-22 00:00:10")
	o.SetCountingFrom(5, :USIndependence)
	Then("USIndependence plus five seconds", o.ToIso(), "1776-07-04 00:00:05")
	o.SetFromNaturalDuration("1 day 1 hour", :YearOne)
	Then("a duration in words from YearOne", o.ToIso(), "0001-01-02 01:00:00")
	o.FromSecondsSinceEpochXT(0, "YearOne")
	Then("an origin written as mixed-case text is the same origin", o.ToIso(), "0001-01-01 00:00:00")
	Then("GetOriginBase finds the mixed-case text", o.GetOriginBase("YearOne"), o.GetOriginBase(:YearOne))
	Then("and an unknown name still answers 0", o.GetOriginBase("nonsense"), 0)
	Then("modern computing maps to ModernComputing and not to the Unix epoch",
		o.MapOriginName("modern computing"), "moderncomputing")
EndScenario()

Scenario("Months, years and decades counted from an origin before 1970")
	o = new stzDateTime("2026-03-05 14:30:00")
	Then("months since the 1945 atomic origin are about 80 years of months",
		o.ToMonthsSinceEpochXT(:AtomicAge) > 960 and o.ToMonthsSinceEpochXT(:AtomicAge) < 975, 1)
	Then("years since AtomicAge are 80, not 2026", o.ToYearsSinceEpochXT(:AtomicAge), 80)
	Then("decades since AtomicAge are 8", o.ToDecadesSinceEpochXT(:AtomicAge), 8)
	Then("years since YearOne are 2025", o.ToYearsSinceEpochXT(:YearOne), 2025)
	Then("the mixed-case origin gives the same years", o.DurationInYearsFrom("YearOne"), 2025)
EndScenario()

Scenario("A negative month count is a month of the year before 1970, and never ends the process")
	o = new stzDateTime("2026-03-05 14:30:00")
	o.FromMonthsSinceEpoch(-1)
	Then("minus one month is December 1969", o.ToIso(), "1969-12-01 00:00:00")
	o.FromMonthsSinceEpoch(-3)
	Then("minus three months (this stopped the Ring process before) is October 1969", o.ToIso(), "1969-10-01 00:00:00")
	o.FromMonthsSinceEpoch(-12)
	Then("minus twelve months is January 1969", o.ToIso(), "1969-01-01 00:00:00")
	o.FromMonthsSinceEpoch(-13)
	Then("minus thirteen months is December 1968", o.ToIso(), "1968-12-01 00:00:00")
	o.SetFromEpochMonths(-2)
	Then("SetFromEpochMonths(-2) is November 1969", o.ToIso(), "1969-11-01 00:00:00")
	o.SetComponents([ 2026, -3, 10, 0, 0, 0 ])
	Then("a stored month below 1 is formatted without reaching the engine", len(o.ToIso()) > 0, 1)
	Then("and the instant of an invalid month does not stop the process", isNumber(o.ToMillisecondsSinceEpochXT(:UnixEpoch)), 1)
EndScenario()

Scenario("The parameter-name typos that raised R24 now answer")
	o = new stzDateTime("2026-03-05 14:30:00")
	Then("DurationInDecadesTo reads its own parameter", o.DurationInDecadesTo("2046-03-05 14:30:00"), 2)
	Then("DecadesTo agrees with it", o.DecadesTo("2046-03-05 14:30:00"), 2)
	nMs = o.DurationInMillisecondsFrom(:UnixEpoch)
	Then("MillisecondsFrom answers the milliseconds from the origin", o.MillisecondsFrom(:UnixEpoch), nMs)
	Then("MillisecondsSince answers the same", o.MillisecondsSince(:UnixEpoch), nMs)
	Then("DurationInMillisecondsSince answers the same", o.DurationInMillisecondsSince(:UnixEpoch), nMs)
	Then("and the value is the 2026-03-05 14:30 instant", nMs, 1772721000000)
	Then("from YearOne it is larger by the origin distance", o.MillisecondsFrom(:YearOne), nMs + 62135596800000)
EndScenario()

Scenario("The constructor takes a negative number of seconds, and 0 is the epoch, not the clock")
	o = new stzDateTime(-86400)
	Then("a negative number is the day before 1970", o.ToIso(), "1969-12-31 00:00:00")
	o = new stzDateTime(0)
	Then("the number 0 is 1970-01-01 (0 equals an empty text in Ring)", o.ToIso(), "1970-01-01 00:00:00")
	o = new stzDateTime("1 day counting from year one")
	Then("a counting-from text with a pre-1970 origin reads as a date", o.ToIso(), "0001-01-02 00:00:00")
EndScenario()

Scenario("A duration in words from epoch counts each unit once")
	o = new stzDateTime("2 days from epoch")
	Then("2 days is the 3rd of January, not 4 days", o.ToIso(), "1970-01-03 00:00:00")
	o = new stzDateTime("5 minutes since epoch")
	Then("5 minutes is 5, not 15", o.ToIso(), "1970-01-01 00:05:00")
	o = new stzDateTime("90 seconds from epoch")
	Then("90 seconds is 90, not 270", o.ToIso(), "1970-01-01 00:01:30")
	o = new stzDateTime("3 days 2 hours 1 week from epoch")
	Then("mixed units add up once each", o.ToIso(), "1970-01-11 02:00:00")
	o = new stzDateTime("250 ms from epoch")
	Then("an abbreviation counts once", o.ToIsoWithMs(), "1970-01-01 00:00:00.250")
EndScenario()

Summary()
