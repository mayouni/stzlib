load "../../stzBase.ring"
load "../_narrated.ring"

# stzCalendar: holidays after the first day were never found (stzDate.NextDay answers dd/MM/yyyy and
# IsHoliday compared that text with yyyy-MM-dd), several methods were stubs that raised, and three
# calls named methods that do not exist. Run from this folder: ring dtfix_calendar_narrated.ring

Scenario("A holiday on any day of the calendar is taken away, not only on the first")
	c = new stzCalendar("2026-03")
	Then("March 2026 has 22 working days before any holiday", c.AvailableDaysN(), 22)
	c.AddHoliday("2026-03-10", "Fete")
	Then("a holiday on the 10th (a Tuesday, the middle of the month) leaves 21", c.AvailableDaysN(), 21)
	Then("and 168 available hours at 8 a day", c.AvailableHoursN(), 168)
	Then("the list of available days has 21 dates", len(c.AvailableDays()), 21)
	Then("every date of the list is written yyyy-MM-dd", c.AvailableDays()[3], "2026-03-04")
	Then("the same day written dd/MM/yyyy is found as a holiday", c.IsHoliday("10/03/2026"), 1)
	Then("and its name too", c.HolidayName("10/03/2026"), "Fete")
	Then("a day that is no holiday is not", c.IsHoliday("11/03/2026"), 0)
	Then("AvailableHoursOnN given dd/MM/yyyy answers 0 on the holiday", c.AvailableHoursOnN("10/03/2026"), 0)
	c2 = new stzCalendar("2026-03")
	c2.AddHoliday("10/03/2026", "Fete")
	Then("a holiday added as dd/MM/yyyy is stored and found as yyyy-MM-dd", c2.IsHoliday("2026-03-10"), 1)
	Then("and is taken away from the count", c2.AvailableDaysN(), 21)
EndScenario()

Scenario("A sub-range total no longer replaces the answer for the whole calendar")
	c = new stzCalendar("2026-03")
	nWhole = c.AvailableHoursN()
	nWeek = c.AvailableHoursBetweenN("2026-03-09", "2026-03-13")
	Then("a working week of 8 hours a day is 40", nWeek, 40)
	Then("the whole calendar still answers 176", c.AvailableHoursN(), nWhole)
	Then("which is 176 for March 2026", nWhole, 176)
EndScenario()

Scenario("The stubs answer lists of dates and slots")
	c = new stzCalendar("2026-03")
	c.AddHoliday("2026-03-10", "Fete")
	aDay = c.AvailableHoursOn("2026-03-11")
	Then("a working day has 8 hour slots", len(aDay), 8)
	Then("the first slot is the opening time", aDay[1], "2026-03-11 09:00:00")
	Then("the last slot starts an hour before closing", aDay[8], "2026-03-11 16:00:00")
	Then("a holiday has none", len(c.AvailableHoursOn("2026-03-10")), 0)
	Then("a Saturday has none", len(c.AvailableHoursOn("2026-03-14")), 0)
	Then("AvailableHours lists every slot of the calendar", len(c.AvailableHours()), c.AvailableHoursN())
	Then("AvailableHoursBetween lists the slots of a range", len(c.AvailableHoursBetween("2026-03-09", "2026-03-13")), 32)
	Then("HasAvailableHoursOn", c.HasAvailableHoursOn("2026-03-11"), 1)
	Then("ContainsAvailableHoursOn on a holiday", c.ContainsAvailableHoursOn("2026-03-10"), 0)
	Then("HasAvailableHoursBetween", c.HasAvailableHoursBetween("2026-03-09", "2026-03-13"), 1)
	c.AddBreak("12:00:00", "13:00:00", "Lunch")
	aDay = c.AvailableHoursOn("2026-03-11")
	Then("a one hour break takes one slot away", len(aDay), 7)
	Then("the noon slot is the one gone", find(aDay, "2026-03-11 12:00:00"), 0)
	Then("and the slot count agrees with AvailableHoursOnN", len(aDay), c.AvailableHoursOnN("2026-03-11"))
	aDays = c.AvailableDaysBetween("2026-03-09", "2026-03-13")
	Then("AvailableDaysBetween lists the working days of the range, holiday out", len(aDays), 4)
	Then("the 10th is not among them", find(aDays, "2026-03-10"), 0)
	Then("AvailableDaysBetweenN counts them (it called a misspelled method before)", c.AvailableDaysBetweenN("2026-03-09", "2026-03-13"), 4)
	Then("HowManyAvailableDaysBetween", c.HowManyAvailableDaysBetween("2026-03-09", "2026-03-13"), 4)
	Then("ContainsAvailableDaysBetween", c.ContainsAvailableDaysBetween("2026-03-09", "2026-03-13"), 1)
	Then("HasAvailableDaysBetween on a weekend", c.HasAvailableDaysBetween("2026-03-14", "2026-03-15"), 0)
	aWeeks = c.AvailableWeeks()
	Then("March 2026 holds five weeks with an available day", len(aWeeks), 5)
	Then("the first week runs Monday the 2nd to Friday the 6th", aWeeks[1][1] + " " + aWeeks[1][2], "2026-03-02 2026-03-06")
	Then("the last one is the two days of the 30th and 31st", aWeeks[5][1] + " " + aWeeks[5][2], "2026-03-30 2026-03-31")
	Then("AvailableWeeks agrees with AvailableWeeksN here", len(aWeeks), c.AvailableWeeksN())
	aEnds = c.WeekendsBetween("2026-03-01", "2026-03-31")
	Then("March 2026 has 9 weekend days", len(aEnds), 9)
	Then("the first is Sunday the 1st", aEnds[1], "2026-03-01")
	Then("WeekendsBetweenN counts them", c.WeekendsBetweenN("2026-03-01", "2026-03-31"), 9)
	Then("HasWeekends answers TRUE", c.HasWeekends(), 1)
	Then("CountAvailableHoursBetween counts hours, not breaks", c.CountAvailableHoursBetween("2026-03-09", "2026-03-13"), 28)
EndScenario()

Scenario("Breaks, navigation and the span conflicts no longer name methods that do not exist")
	c = new stzCalendar("2026-03")
	c.AddBreak("12:00:00", "13:00:00", "Lunch")
	Then("a break is a time of day, so the range holds it", len(c.BreaksBetween("2026-03-01", "2026-03-31")), 1)
	Then("BreaksBetweenN", c.BreaksBetweenN("2026-03-01", "2026-03-31"), 1)
	Then("ContainsBreaksBetween (raised R14 every time)", c.ContainsBreaksBetween("2026-03-01", "2026-03-31"), 1)
	Then("a range of weekend days holds no break", c.ContainsBreaksBetween("2026-03-14", "2026-03-15"), 0)
	cDec = new stzCalendar("2026-12")
	Then("Next_ in December is January", cDec.Next_(), "January")
	cDec.GoToNext()
	Then("GoToNext (it called GoNextMonth) moves to January", cDec.Start(), "2027-01-01")
	Then("and ends on the 31st", cDec.End_(), "2027-01-31")
	cDec.GoTo("2026-05-17")
	Then("GoTo moves a month calendar to the month of the date", cDec.Start() + " " + cDec.End_(), "2026-05-01 2026-05-31")
	cRange = new stzCalendar([ [ "Start", "2026-03-10" ], [ "End", "2026-03-20" ] ])
	cMsg = ""
	try
		cRange.GoTo("2026-05-17")
	catch
		cMsg = cCatchError
	done
	Then("GoTo on a range raises and the process survives", StzFindFirst("GoTo needs a month", cMsg) > 0, 1)
	cMsg = ""
	try
		c.ConflictsWithSpan("sprint", [])
	catch
		cMsg = cCatchError
	done
	Then("ConflictsWithSpan with no timeline raises the library's own message, not R24", StzFindFirst("stzTimeLine", cMsg) > 0, 1)
	c.AddHoliday("2026-03-10", "Fete")
	oTl = new stzTimeLine("2026-03-01", "2026-03-31")
	oTl.AddSpan("SPRINT", "2026-03-09", "2026-03-15")
	c.MarkTimeline(oTl)
	aConf = c.ConflictsWithSpan("SPRINT", [])
	Then("with a timeline attached it lists the holiday and the weekend days of the span", len(aConf), 3)
	Then("the holiday comes first, named", aConf[1][1] + " " + aConf[1][2], "2026-03-10 Holiday: Fete")
	Then("then the Saturday", aConf[2][1] + " " + aConf[2][2], "2026-03-14 Weekend")
	Then("a label with no span has no conflict", len(c.ConflictsWithSpan("NOPE", [])), 0)
EndScenario()

Summary()
