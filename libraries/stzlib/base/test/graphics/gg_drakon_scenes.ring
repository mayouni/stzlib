func StzDrakonScene18(paOpt)
	_o_ = new stzDiagram("icons")
	_o_.SetNotation(StzDrakonNotation())
	_o_.AddNodeXTT("t",  "Title",     [ :type = "title" ])
	_o_.AddNodeXTT("i",  "Input",     [ :type = "input" ])
	_o_.AddNodeXTT("o",  "Output",    [ :type = "output" ])
	_o_.AddNodeXTT("a",  "Action",    [ :type = "action" ])
	_o_.AddNodeXTT("q",  "Question",  [ :type = "question" ])
	_o_.AddNodeXTT("sel","Select",    [ :type = "select" ])
	_o_.AddNodeXTT("cs", "Case",      [ :type = "case" ])
	_o_.AddNodeXTT("ins","Insertion", [ :type = "insertion" ])
	# A SHELF CARRIES TWO TEXTS OR IT IS A BOX. Declared with only a name
	# it drew as one compartment, which is the icon with its own rule
	# missing -- the thing that makes it a shelf.
	_o_.AddNodeXTT("sh", "Shelf",     [ :type = "shelf", :value = "what it is" ])
	_o_.AddNodeXTT("bf", "Begin For", [ :type = "foreach" ])
	_o_.AddNodeXTT("ef", "End For",   [ :type = "endforeach" ])
	_o_.AddNodeXTT("tm", "Timer",     [ :type = "timer" ])
	_o_.AddNodeXTT("pa", "Pause",     [ :type = "pause" ])
	_o_.AddNodeXTT("br", "Branch",    [ :type = "branch" ])
	_o_.AddNodeXTT("ad", "Address",   [ :type = "address" ])
	_o_.AddNodeXTT("e",  "End",       [ :type = "end" ])
	_o_.AddEdge("t","i")    _o_.AddEdge("i","o")    _o_.AddEdge("o","a")
	_o_.AddEdge("a","q")
	_o_.AddEdgeXTT("q","sel","yes", [ :exit = :down ])
	_o_.AddEdge("sel","cs") _o_.AddEdge("cs","ins")  _o_.AddEdge("ins","sh")
	_o_.AddEdge("sh","bf")  _o_.AddEdge("bf","ef")   _o_.AddEdge("ef","tm")
	_o_.AddEdge("tm","pa")  _o_.AddEdge("pa","br")   _o_.AddEdge("br","ad")
	_o_.AddEdge("ad","e")
	_o_.ToCanvasXT(paOpt)
	return _o_

func StzDrakonScene19(paOpt)
	_o_ = new stzDiagram("shelfwork")
	_o_.SetNotation(StzDrakonNotation())
	_o_.AddNodeXTT("t",  "Price a basket",   [ :type = "title" ])
	_o_.AddNodeXTT("rd", "Read the lines",   [ :type = "input" ])
	_o_.AddNodeXTT("ins","Apply the tariff", [ :type = "insertion" ])
	_o_.AddNodeXTT("s1", "net",              [ :type = "shelf",
	                                           :value = "sum of the lines" ])
	_o_.AddNodeXTT("s2", "total",            [ :type = "shelf",
	                                           :value = "net + tax" ])
	_o_.AddNodeXTT("ou", "Show the total",   [ :type = "output" ])
	_o_.AddNodeXTT("e",  "End",              [ :type = "end" ])
	_o_.AddEdge("t","rd")   _o_.AddEdge("rd","ins")  _o_.AddEdge("ins","s1")
	_o_.AddEdge("s1","s2")  _o_.AddEdge("s2","ou")   _o_.AddEdge("ou","e")
	_o_.ToCanvasXT(paOpt)
	return _o_

func StzDrakonScene20(paOpt)
	_o_ = new stzDiagram("realtime")
	_o_.SetNotation(StzDrakonNotation())
	_o_.AddNodeXTT("t",  "Poll the sensor",  [ :type = "title" ])
	_o_.AddNodeXTT("rd", "Read the value",   [ :type = "action" ])
	_o_.AddNodeXTT("tm", "500 ms",           [ :type = "timer" ])
	_o_.AddNodeXTT("pub","Publish the run",  [ :type = "par" ])
	_o_.AddNodeXTT("st", "Settle",           [ :type = "pause" ])
	_o_.AddNodeXTT("wr", "Write the log",    [ :type = "action" ])
	_o_.AddNodeXTT("e",  "Done",             [ :type = "end" ])
	_o_.AddEdge("t","rd")   _o_.AddEdge("rd","pub")
	_o_.AddEdge("pub","wr") _o_.AddEdge("wr","e")
	# the two attachments: each governs the icon it points at, and neither
	# is a step in the sequence
	_o_.AddEdge("tm","rd")
	_o_.AddEdge("st","wr")
	_o_.ToCanvasXT(paOpt)
	return _o_
