# THE DRAKON SCENES, AS FUNCTIONS TWO FILES SHARE.
#
# The catalogue renders them; the gate GOVERNS them. They were written
# once, inline in the catalogue, and the governor's corpus carried its
# own smaller copies -- and a rule tested on the smaller copy passed a
# picture the larger one broke: the OR staircase, three deep in the
# catalogue and two deep in the corpus, inverted for as long as the rule
# existed. A family written in two places drifts; this is the one place.
# Each takes the options it renders with, so the catalogue and the gate
# ask for the same scene at their own size.
#
# Functions only: loading this file draws nothing.

func StzDrakonScene01(paOpt)
	_o_ = new stzDiagram("simplest")
	_o_.SetNotation(StzDrakonNotation())
	_o_.AddNodeXTT("t", "Sum two numbers", [ :type = "title" ])
	_o_.AddNodeXTT("a", "result = a + b",  [ :type = "action" ])
	_o_.AddNodeXTT("e", "End",             [ :type = "end" ])
	_o_.AddEdge("t","a")  _o_.AddEdge("a","e")
	_o_.ToCanvasXT(paOpt)
	return _o_

func StzDrakonScene02(paOpt)
	_o_ = new stzDiagram("theif")
	_o_.SetNotation(StzDrakonNotation())
	_o_.AddNodeXTT("t",  "Go out",           [ :type = "title" ])
	_o_.AddNodeXTT("q",  "Is it raining?",   [ :type = "question" ])
	_o_.AddNodeXTT("umb", "Take an umbrella",[ :type = "action" ])
	_o_.AddNodeXTT("go", "Leave the house",  [ :type = "action" ])
	_o_.AddNodeXTT("e",  "End",              [ :type = "end" ])
	_o_.AddEdge("t","q")
	_o_.AddEdgeXTT("q","umb","yes", [ :exit = :down ])
	_o_.AddEdgeXTT("q","go","no",   [ :exit = :right ])
	_o_.AddEdge("umb","go")  _o_.AddEdge("go","e")
	_o_.ToCanvasXT(paOpt)
	return _o_

