	_o_.AddNodeXTT("z", "end for",         [ :type = "endforeach" ])
	_o_.AddNodeXTT("s", "Show the total",  [ :type = "action" ])
	_o_.AddNodeXTT("e", "End",             [ :type = "end" ])
