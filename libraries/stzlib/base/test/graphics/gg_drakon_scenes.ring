func StzDrakonScene15(paOpt)
	_o_ = new stzDiagram("branchloop")
	_o_.SetNotation(StzDrakonNotation())
	_o_.AddNodeXTT("b1", "Prepare",         [ :type = "branch", :branchId = 1 ])
	_o_.AddNodeXTT("s1", "Open the line",   [ :type = "action" ])
	_o_.AddNodeXTT("x1", "Attempt",         [ :type = "address" ])
	_o_.AddNodeXTT("b2", "Attempt",         [ :type = "branch", :branchId = 2 ])
	_o_.AddNodeXTT("s2", "Send the packet", [ :type = "action" ])
	_o_.AddNodeXTT("q",  "Acknowledged?",   [ :type = "question" ])
	_o_.AddNodeXTT("x2", "Finish",          [ :type = "address" ])
	_o_.AddNodeXTT("rt", "Attempt",         [ :type = "address" ])
	_o_.AddNodeXTT("b3", "Finish",          [ :type = "branch", :branchId = 3 ])
	_o_.AddNodeXTT("s3", "Close the line",  [ :type = "action" ])
	_o_.AddNodeXTT("fin","End",             [ :type = "end" ])
	_o_.AddEdge("b1","s1")  _o_.AddEdge("s1","x1")  _o_.AddEdge("x1","b2")
	_o_.AddEdge("b2","s2")  _o_.AddEdge("s2","q")
	_o_.AddEdgeXTT("q","x2","yes", [ :exit = :down ])
	_o_.AddEdgeXTT("q","rt","no",  [ :exit = :right ])
	_o_.AddEdge("x2","b3")
	# the branch loop: this address names a branch to the LEFT
	_o_.AddEdge("rt","b2")
	_o_.AddEdge("b3","s3")  _o_.AddEdge("s3","fin")
	_o_.ToCanvasXT(paOpt)
	return _o_

func StzDrakonScene16(paOpt)
	_o_ = new stzDiagram("advancestep")
	_o_.SetNotation(StzDrakonNotation())
	_o_.AddNodeXTT("t",  "advanceStep",       [ :type = "title" ])
	_o_.AddNodeXTT("s",  "module.state",      [ :type = "select" ])
	_o_.AddNodeXTT("k1", "playing",           [ :type = "case" ])
	_o_.AddNodeXTT("k2", "dropping",          [ :type = "case" ])
	_o_.AddNodeXTT("k3", "finished",          [ :type = "case" ])
	_o_.AddNodeXTT("p1", "module.projectile", [ :type = "question" ])
	_o_.AddNodeXTT("p2", "canMoveDown()",     [ :type = "question" ])
	_o_.AddNodeXTT("p3", "moveDown()",        [ :type = "action" ])
	_o_.AddNodeXTT("p4", "return getStepPeriod()", [ :type = "action" ])
	_o_.AddNodeXTT("p5", "freezeProjectile()",[ :type = "action" ])
	_o_.AddNodeXTT("p6", "return noProjectile()",  [ :type = "action" ])
	_o_.AddNodeXTT("d1", "canMoveDown()",     [ :type = "question" ])
	_o_.AddNodeXTT("d2", "moveDown()",        [ :type = "action" ])
	_o_.AddNodeXTT("d3", "return DropPeriod", [ :type = "action" ])
	_o_.AddNodeXTT("d4", "freezeProjectile()",[ :type = "action" ])
	_o_.AddNodeXTT("d5", "return getStepPeriod()", [ :type = "action" ])
	_o_.AddNodeXTT("f1", "return undefined",  [ :type = "action" ])
	_o_.AddNodeXTT("e",  "End",               [ :type = "end" ])
	_o_.AddEdge("t","s")
	_o_.AddEdge("s","k1")  _o_.AddEdge("s","k2")  _o_.AddEdge("s","k3")
	_o_.AddEdge("k1","p1")
	_o_.AddEdgeXTT("p1","p2","yes", [ :exit = :down ])
	_o_.AddEdgeXTT("p1","p6","no",  [ :exit = :right ])
	_o_.AddEdgeXTT("p2","p3","yes", [ :exit = :down ])
	_o_.AddEdgeXTT("p2","p5","no",  [ :exit = :right ])
	_o_.AddEdge("p3","p4")  _o_.AddEdge("p5","p6")
	_o_.AddEdge("p4","e")   _o_.AddEdge("p6","e")
	_o_.AddEdge("k2","d1")
	_o_.AddEdgeXTT("d1","d2","yes", [ :exit = :down ])
	_o_.AddEdgeXTT("d1","d4","no",  [ :exit = :right ])
	_o_.AddEdge("d2","d3")  _o_.AddEdge("d4","d5")
	_o_.AddEdge("d3","e")   _o_.AddEdge("d5","e")
	_o_.AddEdge("k3","f1")  _o_.AddEdge("f1","e")
	_o_.ToCanvasXT(paOpt)
	return _o_

