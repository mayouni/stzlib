func StzDrakonScene11(paOpt)
	_o_ = new stzDiagram("switchloop")
	_o_.SetNotation(StzDrakonNotation())
	_o_.AddNodeXTT("t",  "Read a command",  [ :type = "title" ])
	_o_.AddNodeXTT("rd", "Take one word",   [ :type = "input" ])
	_o_.AddNodeXTT("s",  "Which command?",  [ :type = "select" ])
	_o_.AddNodeXTT("k1", "run",             [ :type = "case" ])
	_o_.AddNodeXTT("k2", "stop",            [ :type = "case" ])
	_o_.AddNodeXTT("k3", "anything else",   [ :type = "case" ])
	_o_.AddNodeXTT("d1", "Start the job",   [ :type = "action" ])
	_o_.AddNodeXTT("d2", "Halt the job",    [ :type = "action" ])
	_o_.AddNodeXTT("d3", "Say it is unknown",[ :type = "action" ])
	_o_.AddNodeXTT("e",  "End",             [ :type = "end" ])
	_o_.AddEdge("t","rd")  _o_.AddEdge("rd","s")
	_o_.AddEdge("s","k1")  _o_.AddEdge("s","k2")  _o_.AddEdge("s","k3")
	_o_.AddEdge("k1","d1") _o_.AddEdge("k2","d2") _o_.AddEdge("k3","d3")
	_o_.AddEdge("d1","e")  _o_.AddEdge("d2","e")
	# the loop: the last case goes back above the Select and asks again
	_o_.AddEdge("d3","rd")
	_o_.ToCanvasXT(paOpt)
	return _o_

