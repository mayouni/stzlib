load "../../stzBase.ring"
load "../_narrated.ring"

# stzConstraint -- a condition (Ring code in a text) paired with the object it guards.
# Register rows (all four were "raises R14", "answers an empty text", "raises R24" or "answers 0"):
#   init              IsConstraint called RemoveFirstBoundQ, a method stzString does not have, so no
#                     constraint could be built at all
#   Name              read @cConstraintName, which nothing assigned (the inherited SetName writes the
#                     OBJECT's variable name, a different field)
#   Expression        read _cConstraint_, a variable nobody assigns (the field is @cConstraint)
#   CheckConstraint   always 0: Expression raised inside the try, and the failure was reported as a
#                     broken constraint
# The guard drives every method with a small guarded class (a Box holding a Value) and a stzString, with
# conditions that hold and conditions that fail, a braced and an unbraced text, a multi-line text, a
# broken text (syntax error, run-time error) and accented letters (built from char codes so the source
# stays ASCII). Every positive has a negative sibling. Run from inside test/common.
#
# NOTE: the condition text is EXECUTED AS CODE. A broken text makes Ring print its own compile report
# ("eval Line (1) Error ...") before the raise; those lines in this output are expected.

$bCoBoxBroken = 0

Scenario("Construction: an object and a condition text build a constraint")
	oBox = new CoBox(5)
	cErr = BuildErr(oBox, "{ @.Value() > 3 }")
	Then("a braced condition on an object that obeys it builds", cErr, "")
	cErr = BuildErr(oBox, "@.Value() > 3")
	Then("an unbraced condition builds as well", cErr, "")
	cErr = BuildErr(oBox, "{ @.Value() > 30 }")
	Then("a condition the object does NOT obey still builds (the constraint is built, then checked)", cErr, "")
	cErr = BuildErr(StzStringQ("hello"), "{ @.IsLowercase() }")
	Then("the documented stzString form builds", cErr, "")
	cErr = BuildErr(oBox, "{ @.Value() > > 3 }")
	Then("a condition with a syntax error is refused", cErr, "Constraint can't be evaluated on the given object!")
	cErr = BuildErr(oBox, "{ @.NoSuchMethod() > 3 }")
	Then("a condition calling a method the object lacks is refused", cErr, "Constraint can't be evaluated on the given object!")
	cErr = BuildErr(oBox, "{ }")
	Then("an empty braced condition is refused", cErr, "Constraint can't be empty!")
	cErr = BuildErr(oBox, "   ")
	Then("a blank condition is refused", cErr, "Constraint can't be empty!")
	cErr = BuildErr("hello", "{ @.IsLowercase() }")
	Then("a plain text instead of an object is refused", cErr, "Incorrect types of object params!")
	cErr = BuildErr(oBox, 42)
	Then("a number instead of a condition text is refused", cErr, "Incorrect types of object params!")
	cErr = BuildErr(oBox, [ "a" ])
	Then("a list instead of a condition text is refused", cErr, "Incorrect types of object params!")
EndScenario()

Scenario("IsConstraint and StzConstraintQ: the free functions behind the constructor")
	oBox = new CoBox(5)
	nOk = IsConstraint(oBox, "{ @.Value() > 3 }")
	Then("IsConstraint answers 1 for a condition that runs on the object", nOk, 1)
	nOkNo = IsConstraint(oBox, "{ @.Value() > 30 }")
	Then("a condition that merely fails still runs, so it answers 1 too", nOkNo, 1)
	nBad = IsConstraint(oBox, "{ @.Value() > > 3 }")
	Then("a condition with a syntax error answers 0", nBad, 0)
	nBad2 = IsConstraint(oBox, "{ @.Nope() }")
	Then("a condition that raises at run time answers 0", nBad2, 0)
	nNoObj = IsConstraint("hello", "{ @.IsLowercase() }")
	Then("a non-object answers 0", nNoObj, 0)
	nNoTxt = IsConstraint(oBox, 7)
	Then("a non-text condition answers 0", nNoTxt, 0)
	nAlias = @IsConstraint(oBox, "{ @.Value() > 3 }")
	Then("the @-form answers the same", nAlias, 1)
	oC = StzConstraintQ(oBox, "{ @.Value() > 3 }")
	cCls = classname(oC)
	Then("StzConstraintQ builds a stzConstraint", cCls, "stzconstraint")
	nChk = oC.CheckConstraint()
	Then("and it checks", nChk, 1)
EndScenario()

Scenario("Content, Value, Constraint and Object: what the constraint holds")
	oBox = new CoBox(5)
	cCond = "{ @.Value() > 3 }"
	oC = new stzConstraint(oBox, cCond)
	cContent = oC.Content()
	Then("Content answers the condition exactly as given, braces included", cContent, cCond)
	cValue = oC.Value()
	Then("Value answers the same", cValue, cCond)
	cCons = oC.Constraint()
	Then("Constraint answers the same", cCons, cCond)
	oObj = oC.Object()
	nVal = oObj.Value()
	Then("Object answers the guarded object", nVal, 5)
	cCond2 = "@.Value() < 3"
	oC2 = new stzConstraint(oBox, cCond2)
	cContent2 = oC2.Content()
	Then("a second constraint keeps its own condition", cContent2, cCond2)
	cContent1 = oC.Content()
	Then("and the first one is not disturbed", cContent1, cCond)
	cMulti = "{" + char(10) + "   @.Value() > 3   " + char(10) + "}"
	oC3 = new stzConstraint(oBox, cMulti)
	cContent3 = oC3.Content()
	Then("a multi-line text is kept untouched by Content", cContent3, cMulti)
EndScenario()

Scenario("Name: nothing sets it until SetName does")
	oBox = new CoBox(5)
	oC = new stzConstraint(oBox, "{ @.Value() > 3 }")
	cName = oC.Name()
	Then("an unnamed constraint answers the empty text", cName, "")
	nNamed = oC.IsNamed()
	Then("and is not named", nNamed, 0)
	oC.SetName("positive")
	cName = oC.Name()
	Then("SetName gives it a name that Name reads back", cName, "positive")
	nNamed = oC.IsNamed()
	Then("and it is named now", nNamed, 1)
	oSib = new stzConstraint(oBox, "{ @.Value() > 4 }")
	cSib = oSib.Name()
	Then("a sibling built from the same object stays unnamed", cSib, "")
	oSib.SetName("above four")
	cNameKeep = oC.Name()
	Then("naming the sibling leaves the first name alone", cNameKeep, "positive")
	cSib = oSib.Name()
	Then("and the sibling has its own", cSib, "above four")
EndScenario()

Scenario("Name: the chained form, renaming and the wrong kind of name")
	oBox = new CoBox(5)
	oC = new stzConstraint(oBox, "{ @.Value() > 3 }")
	oBack = oC.SetNameQ("first")
	cName = oBack.Name()
	Then("SetNameQ returns the constraint, named", cName, "first")
	oC.SetName("second")
	cName = oC.Name()
	Then("a name can be replaced", cName, "second")
	oC.SetName("")
	cName = oC.Name()
	Then("an empty name clears it", cName, "")
	cErr = SetNameErr(oC, 42)
	Then("a number is refused as a name", cErr, "Incorrect param type! pcName must be a string.")
	cName = oC.Name()
	Then("and the name is untouched by the refusal", cName, "")
	oC.SetName("kept")
	oStr = oC.NameQ()
	cNameQ = oStr.Content()
	Then("NameQ answers the name as a stzString", cNameQ, "kept")
	cVarName = oC.VarName()
	Then("the object's own variable name is a different field and stays @noname", cVarName, "@noname")
EndScenario()

Scenario("Expression: the Ring code that tests the condition")
	oBox = new CoBox(5)
	oC = new stzConstraint(oBox, "{ @.Value() > 3 }")
	cCode = oC.Expression()
	cWant = "if @.Value() > 3" + char(10) + char(9) + " // Pass" + char(10) + "else" + char(10) +
		char(9) + "StzRaise('Constraint unverified!')" + char(10) + "ok"
	Then("a braced condition is written without its braces", cCode, cWant)
	oCu = new stzConstraint(oBox, "@.Value() > 3")
	cCodeU = oCu.Expression()
	Then("an unbraced condition gives the very same code", cCodeU, cWant)
	oCm = new stzConstraint(oBox, "{" + char(10) + "   @.Value() > 3   " + char(10) + "}")
	cCodeM = oCm.Expression()
	Then("a multi-line braced condition is trimmed to the same code", cCodeM, cWant)
	nHasBrace = StzFindFirst("{", cCode)
	Then("no brace is left in the code", nHasBrace, 0)
	oD = new stzConstraint(oBox, "{ @.Value() < 3 }")
	cCodeD = oD.Expression()
	nSame = (cCodeD = cCode)
	Then("another condition gives other code", nSame, 0)
	cCodeAgain = oC.Expression()
	Then("asking twice gives the same code", cCodeAgain, cWant)
EndScenario()

Scenario("CheckConstraint: obeyed and violated")
	oBox = new CoBox(5)
	oYes = new stzConstraint(oBox, "{ @.Value() > 3 }")
	nYes = oYes.CheckConstraint()
	Then("an object that obeys the condition answers 1", nYes, 1)
	oNo = new stzConstraint(oBox, "{ @.Value() > 30 }")
	nNo = oNo.CheckConstraint()
	Then("an object that does not answers 0", nNo, 0)
	oUn = new stzConstraint(oBox, "@.Value() = 5")
	nUn = oUn.CheckConstraint()
	Then("an unbraced equality that holds answers 1", nUn, 1)
	oUn2 = new stzConstraint(oBox, "@.Value() = 6")
	nUn2 = oUn2.CheckConstraint()
	Then("and one that does not answers 0", nUn2, 0)
	oLow = new stzConstraint(StzStringQ("hello"), "{ @.IsLowercase() }")
	nLow = oLow.CheckConstraint()
	Then("a lowercase string obeys the documented condition", nLow, 1)
	oUp = new stzConstraint(StzStringQ("HELLO"), "{ @.IsLowercase() }")
	nUp = oUp.CheckConstraint()
	Then("an uppercase string violates it", nUp, 0)
	oHi = new stzConstraint(StzStringQ("Hello"), "{ @.IsLowercase() }")
	nHi = oHi.CheckConstraint()
	Then("so does a string with one capital", nHi, 0)
	nAgain = oYes.CheckConstraint()
	Then("checking again gives the same answer", nAgain, 1)
	nAgainNo = oNo.CheckConstraint()
	Then("and the same for the violated one", nAgainNo, 0)
EndScenario()

Scenario("Verdict and LastError: a violated condition is not a broken one")
	oBox = new CoBox(5)
	oYes = new stzConstraint(oBox, "{ @.Value() > 3 }")
	oNo = new stzConstraint(oBox, "{ @.Value() > 30 }")
	cV = oYes.Verdict()
	Then("an obeyed condition has the verdict holds", cV, "holds")
	cE = oYes.LastError()
	Then("and no error", cE, "")
	cV = oNo.Verdict()
	Then("a violated condition has the verdict violated", cV, "violated")
	cE = oNo.LastError()
	Then("and no Ring error either: the condition ran and said no", cE, "")
	$bCoBoxBroken = 1
	nBroken = oYes.CheckConstraint()
	Then("when the condition itself raises, CheckConstraint still answers 0", nBroken, 0)
	cV = oYes.Verdict()
	Then("but the verdict tells it apart: broken", cV, "broken")
	cE = oYes.LastError()
	nHasErr = (len(cE) > 0)
	Then("and LastError keeps the Ring error", nHasErr, 1)
	nHasWhy = StzFindFirst("box is out of order", cE)
	Then("which carries the reason the object raised", nHasWhy > 0, 1)
	nNotViol = (StzFindFirst("Constraint unverified!", cE) = 0)
	Then("and is not the violation message", nNotViol, 1)
	$bCoBoxBroken = 0
	cV = oYes.Verdict()
	Then("once the object works again the verdict is holds", cV, "holds")
	cE = oYes.LastError()
	Then("and LastError is cleared", cE, "")
	cV = oNo.Verdict()
	Then("the violated one is still violated, with LastError empty", cV, "violated")
EndScenario()

Scenario("The constraint keeps its own copy of the object")
	oBox = new CoBox(5)
	oC = new stzConstraint(oBox, "{ @.Value() > 3 }")
	oBox.SetValue(1)
	nOrig = oBox.Value()
	Then("the original object changed", nOrig, 1)
	nChk = oC.CheckConstraint()
	Then("but the constraint still sees the value it was built with", nChk, 1)
	oObj = oC.Object()
	nVal = oObj.Value()
	Then("Object answers the copy, with its old value", nVal, 5)
	oC2 = new stzConstraint(oBox, "{ @.Value() > 3 }")
	nChk2 = oC2.CheckConstraint()
	Then("a constraint built after the change sees the new value and is violated", nChk2, 0)
EndScenario()

Scenario("Braces inside the condition are left alone")
	oBrace = new CoBox("}")
	oYes = new stzConstraint(oBrace, "{ @.Value() = '}' }")
	nYes = oYes.CheckConstraint()
	Then("only the enclosing pair is taken off: a closing brace inside a quoted text survives", nYes, 1)
	cBody = oYes.Expression()
	nFound = StzFindFirst("= '}'", cBody)
	Then("the code still holds the inner brace", nFound > 0, 1)
	oOther = new CoBox("x")
	oNo = new stzConstraint(oOther, "{ @.Value() = '}' }")
	nNo = oNo.CheckConstraint()
	Then("and another value violates it", nNo, 0)
EndScenario()

Scenario("Accented letters in the condition text")
	cE = char(195) + char(169)
	cWord = "caf" + cE
	oBox = new CoBox(cWord)
	cCond = '{ @.Value() = "' + cWord + '" }'
	oYes = new stzConstraint(oBox, cCond)
	nYes = oYes.CheckConstraint()
	Then("a condition quoting an accented word holds for that word", nYes, 1)
	cBody = oYes.Expression()
	nFound = StzFindFirst('"' + cWord + '"', cBody)
	Then("the accented word reaches the code intact", nFound > 0, 1)
	nByteLonger = (len(cBody) > StzLen(cBody))
	Then("the code is longer in bytes than in letters, so the accent was kept as two bytes", nByteLonger, 1)
	oBox2 = new CoBox("cafe")
	oNo = new stzConstraint(oBox2, cCond)
	nNo = oNo.CheckConstraint()
	Then("the same condition fails for the unaccented word", nNo, 0)
	cHe = char(215) + char(144)
	oHe = new CoBox(cHe)
	cCondHe = "{ @.Value() = '" + cHe + "' }"
	oHeC = new stzConstraint(oHe, cCondHe)
	nHe = oHeC.CheckConstraint()
	Then("a Hebrew letter in the condition holds for that letter", nHe, 1)
	oHeNo = new stzConstraint(oBox, cCondHe)
	nHeNo = oHeNo.CheckConstraint()
	Then("and fails for an accented word", nHeNo, 0)
	cCondBraceAccent = "{" + cE + "@.Value() = 1 }"
	cErr = BuildErr(oBox, cCondBraceAccent)
	Then("a stray accented letter right after the opening brace is a broken condition, not a crash", cErr, "Constraint can't be evaluated on the given object!")
EndScenario()

Summary()

func BuildErr(pObject, pCondition)
	try
		_oBuilt_ = new stzConstraint(pObject, pCondition)
		return ""
	catch
		return StzTrim(cCatchError)
	done

func SetNameErr(pConstraint, pName)
	try
		pConstraint.SetName(pName)
		return ""
	catch
		return StzTrim(cCatchError)
	done

class CoBox
	@v
	def init(pv)
		@v = pv
	def SetValue(pv)
		@v = pv
	def Value()
		if $bCoBoxBroken = 1
			raise("the box is out of order")
		ok
		return @v
