# GS6e -- the UMAP k-NN kernel through GK2's foundry, under GK0's checker
# (SOFTANZA_GPU_PLAN.md; cuML's paper puts the k-NN at 98% of a 3M-point
# run -- it is the ceiling at scale, and ours was the naive scan).
#
# Four kernels answer one contract -- the k nearest of every row, ties to the
# lower index -- and a for-loop proposes them: generic, tile, tile4, chunk.
# GK0's checker verifies each against the generic on the same device buffers
# at the asked shape and at a hidden one (a different, odd n, different
# data), times both on the GPU clock with the device awake, and the winner,
# if it clears 1.3x, is recorded for the shape class in the stats DLL's
# variant table and persisted beside pairdist's rows. A variant the checker
# refuses cannot win, whatever it timed.
#
# What this guard asserts, mechanism first, negative sibling beside each:
#   - the enumeration runs at 4,096 x 8 x 15 and every eligible variant is
#     either VERIFIED or refused by name; the chunk variant is the only one
#     eligible at d = 128
#   - the broken sibling (right in shape, one index off) is REFUSED through
#     the mask and can never be set in the table
#   - a set variant DISPATCHES: the counter moves and the table answers the
#     generic's rows exactly; cleared, the counter stays still
#   - the verdict persisted under "umap_knn" survives the sync into the
#     stats DLL's table
#   - the numbers, printed: the ceiling this desk now has

load "../../stzBase.ring"

$nPass = 0
$nFail = 0

pr()

$nStzPlaces = 4

if _C(StzEngineGpuInit($tStzGpuRuntime), "=", 0) or _C(StzEngineGpuIsAvailable(), "=", 0)
	? "  NO GPU ON THIS MACHINE -- the foundry cannot run; the table's refusals are the coverage"
	chk("the table refuses the broken variant without a device", _C(StzEngineUmapKnnVariantSet(4096, 8, 15, 4), "!=", 0))
	chk("...and answers 0 (the generic) for an unset class", _C(StzEngineUmapKnnVariantGet(4096, 8, 15), "=", 0))
else
	oG = new stzGpu
	oG.Wake(400)
	# a clean table for the scenes; the persisted rows are put back at the end,
	# and the calibration files the foundry writes are restored byte for byte --
	# a guard measures, it does not leave verdicts behind (the shaped guard's rule)
	xSaved = StzGpuVariants()
	vCalFiles = [ StzGpuCalibFileDefault(), StzGpuCalibFileForAdapter() ]
	vCalBackup = []
	for tF in vCalFiles
		if tF != "" and FExists(tF)
			vCalBackup + [ tF, Read(tF) ]
		else
			vCalBackup + [ tF, "" ]
		end
	end
	StzEngineUmapKnnVariantClear()

	? "-- Scene 1: the enumeration at 4,096 x 8 x 15 --"
	xR = oG.FoundryUmapKnnWith(4096, 8, 15, 7)
	? "  hidden n " + _T(xR[:hiddenn]) + "   clocks " + _T(xR[:clocks]) + "   generic: GPU " + _T(xR[:refgpums]) + " ms, wall " + _T(xR[:refwallms]) + " ms"
	nVerified = 0
	nRefused = 0
	for v in xR[:variants]
		tState = "not asked"
		if v[2] = 1 tState = "VERIFIED" elseif v[2] = 0 tState = "REFUSED" elseif v[2] = -1 tState = "not eligible" end
		? "  " + _T(v[1]) + ": " + tState + "   GPU " + _T(v[3]) + " ms   wall " + _T(v[4]) + " ms   ratio GPU " + _T(v[5]) + "x   wall " + _T(v[6]) + "x"
		if _C(v[2], "=", 1) nVerified++ end
		if _C(v[2], "=", 0) nRefused++ end
	end
	? "  winner: " + _T(xR[:winner]) + " at " + _T(xR[:ratio]) + "x   stored: " + _T(xR[:stored])
	chk("three real variants were proposed", _C(Len(xR[:variants]), "=", 3))
	chk("every eligible variant was VERIFIED (right at the visible shape and the hidden one)", _C(nVerified, "=", 3) and _C(nRefused, "=", 0))
	chk("the hidden shape is another, odd n", _C(xR[:hiddenn], "!=", 4096) and _C((xR[:hiddenn] % 2), "=", 1))
	nW8 = StzEngineUmapKnnVariantGet(4096, 8, 15)
	chk("the table holds the winner for the class, or the generic (0) when nothing cleared 1.3x", (_C(xR[:ratio], ">=", 1.3) and _C(nW8, ">", 0)) or (_C(xR[:ratio], "<", 1.3) and _C(nW8, "=", 0)))

	? ""
	? "-- Scene 2: d = 128, where only the chunk variant can answer --"
	xR2 = oG.FoundryUmapKnnWith(4096, 128, 15, 5)
	for v in xR2[:variants]
		tState = "not asked"
		if v[2] = 1 tState = "VERIFIED" elseif v[2] = 0 tState = "REFUSED" elseif v[2] = -1 tState = "not eligible" end
		? "  " + _T(v[1]) + ": " + tState + "   ratio GPU " + _T(v[5]) + "x"
	end
	? "  winner: " + _T(xR2[:winner]) + " at " + _T(xR2[:ratio]) + "x"
	chk("tile and tile4 are not eligible at d = 128 (they stage the point in 64 registers)", _C(xR2[:variants][1][2], "=", -1) and _C(xR2[:variants][2][2], "=", -1))
	chk("the chunk variant is VERIFIED at d = 128", _C(xR2[:variants][3][2], "=", 1))

	? ""
	? "-- Scene 3: the broken sibling is refused by the checker, and the table will not take it --"
	nSt = StzEngineUmapKnnFoundry(2048, 8, 10, 3, 16)
	nBroken = StzEngineUmapKnnFoundryResult(_A(8, "+", 4 * 5))
	? "  broken (mask bit 4): verified flag " + _T(nBroken) + "   winner " + _T(StzEngineUmapKnnFoundryResult(3))
	chk("the foundry ran the broken variant when asked", _C(nSt, "=", 0) and _C(nBroken, "!=", -2))
	chk("...and the checker REFUSED it (one index off is not the same answer)", _C(nBroken, "=", 0))
	chk("...so it cannot be the winner", _C(StzEngineUmapKnnFoundryResult(3), "=", 0))
	chk("...and the table refuses it outright", _C(StzEngineUmapKnnVariantSet(2048, 8, 10, 4), "!=", 0))

	? ""
	? "-- Scene 4: a set variant dispatches, and answers the generic's rows --"
	nN = 3000
	nD = 8
	nK = 15
	xX = []
	for i = 1 to nN
		for t = 1 to nD
			xX + _A(_A(_A(((i - 1) % 4), "*", 4), "*", ((_A(t, "+", (i - 1) % 4)) % 2)), "+", _A(Sin(_A(_A(i, "*", 0.731), "+", _A(t, "*", 1.37))), "*", 0.5))
		end
	end
	StzEngineUmapKnnVariantClear()
	StzEngineUmapGpuCountersReset()
	xGen = StzEngineUmapKnn(xX, nN, nD, nK, 1)
	chk("with the table cleared, the generic answered (variant counter still)", _C(StzEngineUmapGpuCounter(4), "=", 0) and _C(Len(xGen), "=", _A(nN, "*", nK)))
	for nV in [ 1, 2, 3 ]
		StzEngineUmapKnnVariantSet(nN, nD, nK, nV)
		StzEngineUmapGpuCountersReset()
		xVar = StzEngineUmapKnn(xX, nN, nD, nK, 1)
		nDiff = 0
		for j = 1 to nN * nK
			if _C(xVar[j], "!=", xGen[j]) nDiff++ end
		end
		? "  " + _T(StzEngineUmapKnnVariantName(nV)) + ": variant dispatches " + _T(StzEngineUmapGpuCounter(4)) + "   entries differing from the generic: " + _T(nDiff)
		chk(_T(StzEngineUmapKnnVariantName(nV)) + " dispatched (the counter moved once)", _C(StzEngineUmapGpuCounter(4), "=", 1))
		chk("...and answered the generic's rows exactly", _C(nDiff, "=", 0))
	end
	StzEngineUmapKnnVariantClear()
	StzEngineUmapGpuCountersReset()
	StzEngineUmapKnn(xX, nN, nD, nK, 1)
	chk("cleared, the counter stays still", _C(StzEngineUmapGpuCounter(4), "=", 0))

	? ""
	? "-- Scene 5: the persisted verdict reaches the stats DLL through the sync --"
	StzGpuVariantSet("umap_knn", 15, 4096, 8, 3)
	$bStzUmapKnnVariantsSynced_ = false
	StzEngineUmapKnnVariantClear()
	StzUmapKnnVariantsSync()
	chk("a persisted umap_knn row lands in the stats DLL's table after the sync", _C(StzEngineUmapKnnVariantGet(4096, 8, 15), "=", 3))
	chk("...for that class only (a class nobody measured stays generic)", _C(StzEngineUmapKnnVariantGet(512, 8, 15), "=", 0))

	? ""
	? "-- Scene 6: the kill line, per d-class -- the grid the plan reads --"
	nCells = 0
	nAllVerified = 0
	for xCell in [ [16384, 8], [8192, 32], [8192, 64], [4096, 256] ]
		xRg = oG.FoundryUmapKnnWith(xCell[1], xCell[2], 15, 5)
		tRow = "  " + _T(xCell[1]) + " x " + _T(xCell[2]) + ": generic " + _T(xRg[:refgpums]) + " ms |"
		bAll = true
		for v in xRg[:variants]
			if _C(v[2], "=", 1)
				tRow += " " + _T(v[1]) + " " + _T(v[5]) + "x"
			elseif _C(v[2], "=", 0)
				tRow += " " + _T(v[1]) + " REFUSED"
				bAll = false
			end
		end
		tRow += " | winner " + _T(xRg[:winner]) + " " + _T(xRg[:ratio]) + "x"
		? tRow
		nCells++
		if bAll nAllVerified++ end
	end
	chk("every eligible variant is VERIFIED in every cell of the grid (right at every shape it was shown and hidden)", _C(nAllVerified, "=", nCells))

	# the machine's own verdicts back, and the files as they were
	nB = Len(vCalBackup)
	for i = 1 to nB
		if vCalBackup[i][1] != ""
			if vCalBackup[i][2] != ""
				Write(vCalBackup[i][1], vCalBackup[i][2])
			elseif FExists(vCalBackup[i][1])
				Remove(vCalBackup[i][1])
			end
		end
	end
	StzEngineUmapKnnVariantClear()
	$bStzUmapKnnVariantsSynced_ = false
	nS = Len(xSaved)
	for i = 1 to nS
		if xSaved[i][1] = "umap_knn"
			StzGpuVariantSet("umap_knn", xSaved[i][2], xSaved[i][3], xSaved[i][4], xSaved[i][5])
		end
	end
	StzUmapKnnVariantsSync()
end

? ""
? "=========================================="
? "TOTAL: " + _T((_A($nPass, "+", $nFail))) + " assertions, " + _T($nPass) + " pass, " + _T($nFail) + " fail"
? "=========================================="

pfq()
Shutdown($nFail)

func chk(tLabel, xCond)
	if _StzB(xCond)
		$nPass++
		? "  [OK] " + tLabel
	else
		$nFail++
		? "  [FAIL] " + tLabel
	end
end

# A value as text, as the guard's narration writes it: a text as it is, a whole number plainly, any other number
# to $nStzPlaces places, rounded half away from zero. (The library's one-argument Text and Round shadow the built-ins.)
func _T(xV)
	if IsString(xV)
		return xV
	end
	if not IsNumber(xV)
		return String(xV)
	end
	tS = String(xV)
	nLen = Len(tS)
	bPlain = true
	for k = 1 to nLen
		tC = tS[k]
		if tC = "n" or tC = "i"
			return tS
		end
		if tC = "." or tC = "e" or tC = "E"
			bPlain = false
		end
	end
	if bPlain
		return tS
	end
	nP = $nStzPlaces
	nScale = 1
	for k = 1 to nP
		nScale = nScale * 10
	end
	fV = Float(xV)
	bNeg = fV < Float(0)
	if bNeg
		fV = Float(0) - fV
	end
	nI = Floor(fV * Float(nScale) + 0.5f)
	if nP = 0
		tR = String(nI)
	else
		nW = _Q((nI - nI % nScale), nScale)
		tF = String(nI % nScale)
		while Len(tF) < nP
			tF = "0" + tF
		end
		tR = String(nW) + "." + tF
	end
	if bNeg and nI != 0
		tR = "-" + tR
	end
	return tR
end

# A condition as true or false: a 1 or 0 from older code, or a boolean.
func _StzB(xV)
	if IsNumber(xV)
		return xV != 0
	end
	return xV
end

# The absolute value of any number: exact for an integer or a decimal, a float for a float.
func _StzAbs(xV)
	try
		if xV < 0
			return 0 - xV
		end
		return xV
	catch e
		fV = Float(xV)
		if fV < Float(0)
			return Float(0) - fV
		end
		return fV
	end
end

# A quotient as the older code took it: exact when one exists; otherwise, taken through floats, a decimal to
# nine places, or a float when either side is a float.
func _Q(xA, xB)
	try
		return xA / xB
	catch e
	end
	fQ = Float(String(xA)) / Float(String(xB))
	if _StzIsFloat(xA) or _StzIsFloat(xB)
		return fQ
	end
	try
		return Decimal(fQ, 9)
	catch e
		return fQ
	end
end

# A comparison as the older code made it, where every number was of one kind: the comparison itself when both
# sides are of one kind; otherwise both sides as floats, equal when neither is below the other, and a NaN equal
# to nothing.
func _C(xA, tOp, xB)
	try
		if tOp = "="
			return xA = xB
		end
		if tOp = "!="
			return xA != xB
		end
		if tOp = "<"
			return xA < xB
		end
		if tOp = ">"
			return xA > xB
		end
		if tOp = "<="
			return xA <= xB
		end
		return xA >= xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	bNaN = _StzNaN(fA) or _StzNaN(fB)
	if tOp = "="
		return not bNaN and not (fA < fB) and not (fA > fB)
	end
	if tOp = "!="
		return bNaN or fA < fB or fA > fB
	end
	if bNaN
		return false
	end
	if tOp = "<"
		return fA < fB
	end
	if tOp = ">"
		return fA > fB
	end
	if tOp = "<="
		return not (fA > fB)
	end
	return not (fA < fB)
end

# A number, or a true or false, as a float (the older code read a true as 1).
func _StzF(xV)
	if IsNumber(xV)
		if _StzIsFloat(xV)
			return xV
		end
		return Float(String(xV))
	end
	if xV
		return 1.0f
	end
	return 0.0f
end

# True for a NaN, read from its text.
func _StzNaN(xV)
	if not IsNumber(xV)
		return false
	end
	tS = String(xV)
	return tS = "nan" or tS = "-nan"
end

# True for a float: an integer or a decimal takes a zero added, a float refuses it.
func _StzIsFloat(xV)
	if not IsNumber(xV)
		return false
	end
	try
		xT = xV + 0
		return false
	catch e
		return true
	end
end

# Arithmetic as the older code did it, where every number was of one kind: the operation itself when both sides
# are of one kind; otherwise both sides as floats.
func _A(xA, tOp, xB)
	try
		if tOp = "+"
			return xA + xB
		end
		if tOp = "-"
			return xA - xB
		end
		return xA * xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	if tOp = "+"
		return fA + fB
	end
	if tOp = "-"
		return fA - fB
	end
	return fA * fB
end
