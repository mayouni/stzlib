# GK5 -- F16 WEIGHTS ON THE DEVICE (SOFTANZA_GPU_PLAN.md, GK5).
#
# The device asks for shader-f16 when the adapter offers it (subgroups are
# noted, never requested). The matmul template gains a form that stores B --
# the weights, in the backbone -- as f16 in VRAM and widens each read to f32;
# the accumulation stays f32. The resident backbone keeps its weight
# matrices at f16 on a path BESIDE the f32 one, off unless asked, so the two
# can alternate. f16 accumulation is not in scope: the storage number did
# not earn the question (measured 2026-10-27: 2-6% on the kernels, about 2%
# on the forward).
#
# What this suite asserts, bands set from measurement (about ten times the
# differences measured on 2026-10-27 on the RTX 3050):
#   - the adapter's features are reported, and a granted device runs the
#     f16 form: on MiniLM's three matmul shapes at 130 tokens, register-
#     blocked, the f16 result stays within 2e-3 of an f64 product (measured
#     6.85e-4 at |ref| 3.6) while the f32 one stays within 1e-5 (5.3e-6);
#     neither form is slower than the other by a third
#   - the backbone (MiniLM, when the model is present): f16 binds exactly
#     half the weight bytes; at a hidden shape (68 tokens) its embedding is
#     within 2e-6 of the f32 path's by cosine (1.5e-7), and as close to the
#     CPU forward as the f32 path is (within 1e-5 of the same distance)
#   - the default is f32: asked off, the forward runs on f32 weights
#
# Run with haro: haro gpu_f16_narrated.haro

load "../../stzBase.ring"

$nPass = 0
$nFail = 0

pr()

$nStzPlaces = 9

? "-- Scene 1: the device's features, and the f16 matmul against an f64 product --"
$nT0 = Clock()
oG = new stzGpu
bDevice = oG.IsAvailable()
if bDevice
	? "  adapter: " + _T(oG.DeviceName()) + "; shader-f16 offered " + _T(StzEngineGpuFeature(0)) + ", granted " + _T(StzEngineGpuFeature(1)) +
		"; subgroups offered " + _T(StzEngineGpuFeature(2)) + " (noted, never requested)"
	chk("a feature the adapter offers is granted (shader-f16: offered " + _T(StzEngineGpuFeature(0)) + ", granted " + _T(StzEngineGpuFeature(1)) + ")",
		_C(StzEngineGpuFeature(1), "=", StzEngineGpuFeature(0)))
	if _C(StzEngineGpuFeature(1), "=", 1)
		for xS in [ [ 130, 384, 384 ], [ 130, 384, 1536 ], [ 130, 1536, 384 ] ]
			nSt = StzEngineGpuFoundryMatmulF16(xS[1], xS[2], xS[3], 7, 3)
			tS = "" + _T(xS[1]) + " x " + _T(xS[2]) + " x " + _T(xS[3])
			nE32 = StzEngineGpuFoundryF16Result(11)
			nE16 = StzEngineGpuFoundryF16Result(12)
			nR = StzEngineGpuFoundryF16Result(7)
			if _C(nR, "<", 0)
				nR = StzEngineGpuFoundryF16Result(8)
			end
			? "  " + tS + " reg4: f32 " + _T(StzEngineGpuFoundryF16Result(3)) + " ms, f16 " + _T(StzEngineGpuFoundryF16Result(4)) + " ms on the GPU clock, f32/f16 " + _T(nR) +
				"; error f32 " + _T(nE32) + ", f16 " + _T(nE16) + " against |ref| up to " + _T(StzEngineGpuFoundryF16Result(14))
			chk(tS + ": both forms ran, alternated four times", _C(nSt, "=", 0) and _C(StzEngineGpuFoundryF16Result(0), "=", 1) and _C(StzEngineGpuFoundryF16Result(15), "=", 4))
			chk("...the f32 form within 1e-5 of the f64 product", _C(nE32, "<", 0.00001))
			chk("...the f16 form within 2e-3 (the weights rounded to f16 once, at upload)", _C(nE16, "<", 0.002))
			chk("...and it is MORE than the f32 error: the f16 path really ran on f16 weights", _C(nE16, ">", _A(10, "*", nE32)))
			chk("...neither form slower than the other by a third", _C(nR, ">", 0.75) and _C(nR, "<", 1.33))
		end
	end
end
? "  (scene 1: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"

tModel = "../../../models/all-MiniLM-L6-v2.Q8_0.gguf"
if bDevice and FExists(tModel)
	? ""
	? "-- Scene 2: the resident backbone on MiniLM, f32 and f16 weights --"
	$nT0 = Clock()
	chk("the model loads (its digest recorded beside it)", _C(StzEngineNeuralModelLoad(tModel), "=", 1))
	tHid = ""
	for i = 1 to 6
		tHid += "a hidden sentence with other words in it, said again "
	end
	nMin = StzEngineNeuralBackboneMinTokens()
	StzEngineNeuralBackboneSetMinTokens(1000000)
	nDim = StzEngineNeuralEmbed(tHid)
	StzEngineNeuralBackboneSetMinTokens(nMin)
	vCpu = []
	for i = 1 to nDim
		vCpu + StzEngineNeuralEmbedAt(i - 1)
	end
	StzEngineNeuralBackboneSetWeightsF16(0)
	vA32 = StzEngineNeuralBackboneEmbed(tHid)
	nW32 = StzEngineNeuralBackboneWeightBytes()
	chk("asked off, the forward runs on f32 weights", _C(StzEngineNeuralBackboneWeightsF16(), "=", 0) and _C(Len(vA32), "=", nDim))
	chk("...in 50 dispatches (1 + 8 per layer x 6 + 1: Q, K and V one product since GQ1; GELU stays a pass of its own, GK4)", _C(StzEngineNeuralBackboneDispatches(), "=", 50))
	if _C(StzEngineNeuralBackboneF16Available(), "=", 1)
		StzEngineNeuralBackboneSetWeightsF16(1)
		vA16 = StzEngineNeuralBackboneEmbed(tHid)
		nW16 = StzEngineNeuralBackboneWeightBytes()
		StzEngineNeuralBackboneSetWeightsF16(0)
		chk("asked on, with shader-f16 granted, the forward runs on f16 weights", _C(StzEngineNeuralBackboneWeightsF16(), "=", 1) and _C(Len(vA16), "=", nDim))
		? "  weight matrices bound per forward: " + _T(nW32) + " bytes in f32, " + _T(nW16) + " in f16"
		chk("...binding exactly half the weight bytes", _C(_A(nW16, "*", 2), "=", nW32) and _C(nW32, ">", 0))
		nD = _A(1, "-", cosv(vA32, vA16))
		nD32 = _A(1, "-", cosv(vCpu, vA32))
		nD16 = _A(1, "-", cosv(vCpu, vA16))
		? "  " + _T(StzEngineNeuralTokenize(tHid)) + " tokens: 1 - cos(f32, f16) " + _T(nD) + "; from the CPU forward: f32 " + _T(nD32) + ", f16 " + _T(nD16)
		chk("at the hidden shape the f16 embedding is within 2e-6 of the f32 one by cosine (measured 1.5e-7)", _C(nD, "<", 0.000002))
		chk("...and as close to the CPU forward as the f32 path is (within 1e-5 of the same distance)", _C(_StzAbs(_A(nD16, "-", nD32)), "<", 0.00001))
	end
	StzEngineNeuralModelFree()
	? "  (scene 2: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"
end

? ""
? "=========================================="
? "TOTAL: " + _T((_A($nPass, "+", $nFail))) + " assertions, " + _T($nPass) + " pass, " + _T($nFail) + " fail"
? "=========================================="

pfq()
Shutdown($nFail)

func chk(tLabel, xCond)
	if _StzB(xCond)
		$nPass++
		? "  [OK] " + tLabel
	else
		$nFail++
		? "  [FAIL] " + tLabel
	end
end
func cosv(xA, xB)
	nN = 0
	nNa = 0
	nNb = 0
	for i = 1 to Len(xA)
		nN = _A(nN, "+", _A(xA[i], "*", xB[i]))
		nNa = _A(nNa, "+", _A(xA[i], "*", xA[i]))
		nNb = _A(nNb, "+", _A(xB[i], "*", xB[i]))
	end
	return _Q(nN, Sqrt(_A(nNa, "*", nNb)))
end

# A value as text, as the guard's narration writes it: a text as it is, a whole number plainly, any other number
# to $nStzPlaces places, rounded half away from zero. (The library's one-argument Text and Round shadow the built-ins.)
func _T(xV)
	if IsString(xV)
		return xV
	end
	if not IsNumber(xV)
		return String(xV)
	end
	tS = String(xV)
	nLen = Len(tS)
	bPlain = true
	for k = 1 to nLen
		tC = tS[k]
		if tC = "n" or tC = "i"
			return tS
		end
		if tC = "." or tC = "e" or tC = "E"
			bPlain = false
		end
	end
	if bPlain
		return tS
	end
	nP = $nStzPlaces
	nScale = 1
	for k = 1 to nP
		nScale = nScale * 10
	end
	fV = Float(xV)
	bNeg = fV < Float(0)
	if bNeg
		fV = Float(0) - fV
	end
	nI = Floor(fV * Float(nScale) + 0.5f)
	if nP = 0
		tR = String(nI)
	else
		nW = _Q((nI - nI % nScale), nScale)
		tF = String(nI % nScale)
		while Len(tF) < nP
			tF = "0" + tF
		end
		tR = String(nW) + "." + tF
	end
	if bNeg and nI != 0
		tR = "-" + tR
	end
	return tR
end

# A condition as true or false: a 1 or 0 from older code, or a boolean.
func _StzB(xV)
	if IsNumber(xV)
		return xV != 0
	end
	return xV
end

# The absolute value of any number: exact for an integer or a decimal, a float for a float.
func _StzAbs(xV)
	try
		if xV < 0
			return 0 - xV
		end
		return xV
	catch e
		fV = Float(xV)
		if fV < Float(0)
			return Float(0) - fV
		end
		return fV
	end
end

# A quotient as the older code took it: exact when one exists; otherwise, taken through floats, a float.
func _Q(xA, xB)
	try
		return xA / xB
	catch e
	end
	return _StzF(xA) / _StzF(xB)
end

# A comparison as the older code made it, where every number was of one kind: the comparison itself when both
# sides are of one kind; otherwise both sides as floats, equal when neither is below the other, and a NaN equal
# to nothing.
func _C(xA, tOp, xB)
	try
		if tOp = "="
			return xA = xB
		end
		if tOp = "!="
			return xA != xB
		end
		if tOp = "<"
			return xA < xB
		end
		if tOp = ">"
			return xA > xB
		end
		if tOp = "<="
			return xA <= xB
		end
		return xA >= xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	bNaN = _StzNaN(fA) or _StzNaN(fB)
	if tOp = "="
		return not bNaN and not (fA < fB) and not (fA > fB)
	end
	if tOp = "!="
		return bNaN or fA < fB or fA > fB
	end
	if bNaN
		return false
	end
	if tOp = "<"
		return fA < fB
	end
	if tOp = ">"
		return fA > fB
	end
	if tOp = "<="
		return not (fA > fB)
	end
	return not (fA < fB)
end

# A number, or a true or false, as a float (the older code read a true as 1).
func _StzF(xV)
	if IsNumber(xV)
		if _StzIsFloat(xV)
			return xV
		end
		return Float(String(xV))
	end
	if xV
		return 1.0f
	end
	return 0.0f
end

# True for a NaN, read from its text.
func _StzNaN(xV)
	if not IsNumber(xV)
		return false
	end
	tS = String(xV)
	return tS = "nan" or tS = "-nan"
end

# True for a float: an integer or a decimal takes a zero added, a float refuses it.
func _StzIsFloat(xV)
	if not IsNumber(xV)
		return false
	end
	try
		xT = xV + 0
		return false
	catch e
		return true
	end
end

# Arithmetic as the older code did it, where every number was of one kind: the operation itself when both sides
# are of one kind; otherwise both sides as floats.
func _A(xA, tOp, xB)
	try
		if tOp = "+"
			return xA + xB
		end
		if tOp = "-"
			return xA - xB
		end
		return xA * xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	if tOp = "+"
		return fA + fB
	end
	if tOp = "-"
		return fA - fB
	end
	return fA * fB
end
