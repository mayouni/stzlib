# GS1 -- FFT CONVOLUTION ON THE GPU, the GPU plane's op (SOFTANZA_GPU_PLAN.md
# GS1; the sound plan's SN0 criterion #3, signed and never wired).
#
# The linear convolution of two real signals as ONE batched pass on the
# device: pack, forward transforms of both operands (Stockham radix-2,
# twiddles from a TABLE computed in f64), a pointwise product, the inverse
# chain, the scaled real part. Verified here against fft.zig's f64
# convolveReal -- the CPU capability as shipped, an INDEPENDENT reference --
# and timed against it with the device woken first.
#
# What this guard asserts, mechanism first, negative siblings beside:
#   - small integer signals convolve to the exact integers (within f32)
#   - a 1 s signal against a 1 s impulse response matches fft.zig within
#     the measured band on BOTH adapters -- the iGPU included, which is the
#     prerequisite SN0 named (per-butterfly cos/sin there read 2.75e-5)
#   - the chain is ONE batched submit of exactly 4 + 3*log2(N) dispatches
#     (the counters are the witness), the twiddle table is built once and
#     reused (live buffers do not grow on the second run), and a wrong size
#     is refused before any dispatch
#   - the RESIDENT chain at 1 s (signals already on the device) is timed
#     against SN0's numbers, device woken; the list doorway is timed
#     against fft.zig through the same lists and named for what it is
#     (list marshalling on both sides); a 60 s render is timed on the
#     device without a list (informational, beside SN0's 62 ms)
#   - without a device the op refuses (a counted fallback) and the face
#     raises by name

load "../../stzBase.ring"

$nPass = 0
$nFail = 0

xC_DISP = 0
iC_FALLBACK = 3
iC_SUBMIT = 6
iC_LIVE = 8

pr()

$nStzPlaces = 9

if _C(StzEngineGpuInit($tStzGpuRuntime), "=", 0) or _C(StzEngineGpuIsAvailable(), "=", 0)
	? "  NO GPU ON THIS MACHINE -- asserting the refusal contract only"
	StzEngineGpuCountersReset()
	chk("the op refuses without a device", _C(StzEngineGpuOpConvolveReal(1, 4, 1, 4, 1), "!=", 0))
	chk("...and counts the fallback", _C(StzEngineGpuCounter(iC_FALLBACK), ">=", 1))
	oG0 = new stzGpu
	bRaised = false
	try
		oG0.ConvolveReal([1, 2, 3], [1, 1])
	catch
		bRaised = _C(StzFindFirst("no GPU device", cCatchError), ">", 0)
	end
	chk("the face raises by name", bRaised)
else
	oG = new stzGpu
	? "  device: " + _T(oG.DeviceName())

	? ""
	? "-- Scene 1: small integers, exact --"
	xC = oG.ConvolveReal([1, 2, 3], [1, 1])
	? "  [1,2,3] * [1,1] = " + _T(xC[1]) + ", " + _T(xC[2]) + ", " + _T(xC[3]) + ", " + _T(xC[4])
	chk("four samples out (3 + 2 - 1)", _C(Len(xC), "=", 4))
	chk("[1,3,5,3] within 1e-5 (f32 through an 8-point transform)",
		near(xC[1], 1) and near(xC[2], 3) and near(xC[3], 5) and near(xC[4], 3))
	xD = oG.ConvolveReal([2, 0, 0, 0, 0], [1, 2, 3, 4])
	chk("a scaled impulse reproduces the other operand: 2*[1,2,3,4] then zeros",
		near(xD[1], 2) and near(xD[2], 4) and near(xD[3], 6) and near(xD[4], 8) and near(xD[5], 0) and near(xD[8], 0))
	xE = oG.ConvolveReal([1, 2, 3], [4, 5, 6])
	xR = StzEngineConvolveReal([1, 2, 3], [4, 5, 6])
	chk("...and agrees with fft.zig's f64 answer on a non-power-of-two case", _C(maxreldiff(xE, xR), "<", 0.00001))

	? ""
	? "-- Scene 2: one second against a one-second impulse response, vs fft.zig --"
	nSr = 48000
	vSig = []
	vIr = []
	for i = 1 to nSr
		vSig + (_A(_A(_A(_A(Sin(_A(i, "*", 0.0137)), "*", 0.6), "+", _A(Sin(_A(i, "*", 0.211)), "*", 0.3)), "+", _Q(((i * 7919) % 101), 101.0)), "-", 0.5))
		vIr + _A(_A((_Q((_A((i * 31) % 17, "-", 8)), 8.0)), "*", (_A(1, "-", _Q((i - 1), nSr)))), "*", (_A(1, "-", _Q((i - 1), nSr))))
	end
	nM = StzEngineGpuConvolveSize(nSr, nSr)
	chk("the transform size for 2 x 48000 is 131072", _C(nM, "=", 131072))
	xRef = StzEngineConvolveReal(vSig, vIr)
	StzEngineGpuCountersReset()
	nLive0 = StzEngineGpuCounter(iC_LIVE)
	xGpu = oG.ConvolveReal(vSig, vIr)
	chk("95999 samples out", _C(Len(xGpu), "=", _A(_A(2, "*", nSr), "-", 1)) and _C(Len(xRef), "=", Len(xGpu)))
	nErr = maxreldiff(xGpu, xRef)
	? "  max relative error vs fft.zig f64 (relative to the output's peak): " + _T(nErr)
	chk("within 1e-5 of the f64 reference (SN0 measured 1.47e-6 on this card)", _C(nErr, "<", 0.00001))
	nDisp = StzEngineGpuCounter(xC_DISP)
	? "  dispatches " + _T(nDisp) + "   submits " + _T(StzEngineGpuCounter(iC_SUBMIT))
	chk("exactly 4 + 3*log2(N) = 55 dispatches for N = 131072 (pack x2, 17 x2 forward, product, 17 inverse, unpack)", _C(nDisp, "=", 55))
	chk("ONE submit for the whole chain (+1 for the readback copy)", _C(StzEngineGpuCounter(iC_SUBMIT), "<=", 2))
	# the twiddle CACHE: one table, replaced on a size change, never accumulated
	nLive1 = StzEngineGpuCounter(iC_LIVE)
	xGpu2 = oG.ConvolveReal(vSig, vIr)
	chk("a second run at the same size builds no second table (live buffers unchanged)", _C(StzEngineGpuCounter(iC_LIVE), "=", nLive1))
	chk("...and answers identically (the chain is deterministic)", _C(maxreldiff(xGpu, xGpu2), "=", 0))
	oG.ConvolveReal([1, 2, 3], [1, 1])
	chk("a run at another size REPLACES the table rather than adding one (live buffers unchanged)", _C(StzEngineGpuCounter(iC_LIVE), "=", nLive1))

	? ""
	? "-- Scene 3: a wrong size is refused BEFORE any dispatch --"
	nHA = StzEngineGpuBufferNew(16)
	nHB = StzEngineGpuBufferNew(16)
	nHS = StzEngineGpuBufferNew(8)     # room for 2 floats, the answer needs 7
	nD0 = StzEngineGpuCounter(xC_DISP)
	chk("an output buffer too small for na+nb-1 is refused", _C(StzEngineGpuOpConvolveReal(nHA, 4, nHB, 4, nHS), "!=", 0))
	chk("...with no dispatch", _C(StzEngineGpuCounter(xC_DISP), "=", nD0))
	StzEngineGpuBufferFree(nHA)  StzEngineGpuBufferFree(nHB)  StzEngineGpuBufferFree(nHS)

	? ""
	? "-- Scene 4: the SN0 margin at 1 s, both timed the same way, device woken --"
	oG.Wake(400)
	nCpu = 999999
	for r = 1 to 3
		nT0c = StzEngineWatchTimestampNs()
		StzEngineConvolveReal(vSig, vIr)
		nMsC = (_A(StzEngineWatchTimestampNs(), "-", nT0c)) / 1000000
		if _C(nMsC, "<", nCpu) nCpu = nMsC end
	end
	nGpu = 999999
	for r = 1 to 3
		nT0c = StzEngineWatchTimestampNs()
		oG.ConvolveReal(vSig, vIr)
		nMsC = (_A(StzEngineWatchTimestampNs(), "-", nT0c)) / 1000000
		if _C(nMsC, "<", nGpu) nGpu = nMsC end
	end
	# the RESIDENT form -- the seam's real shape: signals already on the
	# device, the chain alone timed (upload once, outside the clock)
	nHRa = StzEngineGpuBufferNew(_A(nSr, "*", 4))
	nHRb = StzEngineGpuBufferNew(_A(nSr, "*", 4))
	nHRo = StzEngineGpuBufferNew(_A((_A(_A(2, "*", nSr), "-", 1)), "*", 4))
	StzEngineGpuBufferUploadList(nHRa, vSig)
	StzEngineGpuBufferUploadList(nHRb, vIr)
	StzEngineGpuOpConvolveReal(nHRa, nSr, nHRb, nSr, nHRo)
	StzEngineGpuSync()
	nChain = 999999
	for r = 1 to 5
		nT0c = StzEngineWatchTimestampNs()
		StzEngineGpuOpConvolveReal(nHRa, nSr, nHRb, nSr, nHRo)
		StzEngineGpuSync()
		nMsC = (_A(StzEngineWatchTimestampNs(), "-", nT0c)) / 1000000
		if _C(nMsC, "<", nChain) nChain = nMsC end
	end
	StzEngineGpuBufferFree(nHRa)  StzEngineGpuBufferFree(nHRb)  StzEngineGpuBufferFree(nHRo)
	? "  1 s through LISTS on both sides: fft.zig " + _T(nCpu) + " ms vs GPU doorway " + _T(nGpu) + " ms (" + _T((_Q(nCpu, nGpu))) + "x) -- list marshalling dominates both"
	? "  1 s RESIDENT: the chain + sync alone " + _T(nChain) + " ms   (SN0: fft.zig's own compute 24-25 ms, the GPU 1.74 ms with transfer)"
	chk("the doorway is no slower than fft.zig through the same lists", _C(_Q(nCpu, nGpu), ">=", 1))
	chk("the RESIDENT chain at 1 s is under 10 ms -- the seam's shape (SN0 measured 1.74 ms with transfer)", _C(nChain, "<", 10))

	? ""
	? "-- Scene 5: sixty seconds on the device, no list (informational) --"
	nBig = 2880000
	nHX = StzEngineGpuBufferNew(_A(nBig, "*", 4))
	nHH = StzEngineGpuBufferNew(_A(nSr, "*", 4))
	nHY = StzEngineGpuBufferNew(_A((_A(_A(nBig, "+", nSr), "-", 1)), "*", 4))
	chk("2.88 M + 48 k samples staged on the device", _C(StzEngineGpuBufferFillLcg(nHX, nBig, 7), "=", 0) and _C(StzEngineGpuBufferFillLcg(nHH, nSr, 11), "=", 0))
	oG.Wake(400)
	StzEngineGpuOpConvolveReal(nHX, nBig, nHH, nSr, nHY)
	StzEngineGpuSync()
	nBest = 999999
	for r = 1 to 3
		nT0c = StzEngineWatchTimestampNs()
		StzEngineGpuOpConvolveReal(nHX, nBig, nHH, nSr, nHY)
		StzEngineGpuSync()
		nMsC = (_A(StzEngineWatchTimestampNs(), "-", nT0c)) / 1000000
		if _C(nMsC, "<", nBest) nBest = nMsC end
	end
	? "  60 s of audio, N = " + _T(StzEngineGpuConvolveSize(nBig, nSr)) + ": chain + sync " + _T(nBest) + " ms on the device (SN0 measured 62 ms incl. transfer; fft.zig 1,390-1,464 ms)"
	chk("the 60 s chain ran (a real number, under a second)", _C(nBest, ">", 0) and _C(nBest, "<", 1000))
	StzEngineGpuBufferFree(nHX)  StzEngineGpuBufferFree(nHH)  StzEngineGpuBufferFree(nHY)

	? ""
	? "-- Scene 6: the iGPU, where per-butterfly cos/sin read 2.75e-5 -- the table fixes it --"
	nAd = StzEngineGpuAdapterCount()
	nIntel = -1
	for a = 0 to nAd - 1
		if _C(StzFindFirst("Intel", StzEngineGpuAdapterName(a)), ">", 0) and _C(nIntel, "<", 0)
			nIntel = a
		end
	end
	if _C(nIntel, "<", 0)
		? "  no second adapter on this machine -- scene skipped, and says so"
	else
		if _C(StzEngineGpuSelectAdapter(nIntel), "=", 1)
			? "  device: " + _T(StzEngineGpuAdapterName(nIntel))
			oG2 = new stzGpu
			xGpuI = oG2.ConvolveReal(vSig, vIr)
			nErrI = maxreldiff(xGpuI, xRef)
			? "  max relative error vs fft.zig f64 on the iGPU: " + _T(nErrI)
			chk("the iGPU is inside 1e-5 too (SN0 read 2.75e-5 with cos/sin per butterfly; the table is the fix)", _C(nErrI, "<", 0.00001))
		else
			? "  the second adapter could not be opened -- scene skipped, and says so"
		end
	end
end

? ""
? "=========================================="
? "TOTAL: " + _T((_A($nPass, "+", $nFail))) + " assertions, " + _T($nPass) + " pass, " + _T($nFail) + " fail"
? "=========================================="

pfq()
Shutdown($nFail)

func chk(tLabel, xCond)
	if _StzB(xCond)
		$nPass++
		? "  [OK] " + tLabel
	else
		$nFail++
		? "  [FAIL] " + tLabel
	end
end
func near(xA, xB)
	xD = _A(xA, "-", xB)
	if _C(xD, "<", 0) xD = -xD end
	return _C(xD, "<", 0.00001)
end
# max |got - want| relative to the reference's peak magnitude
func maxreldiff(xGot, xWant)
	nN = Len(xWant)
	nPeak = 0
	for i = 1 to nN
		xV = xWant[i]
		if _C(xV, "<", 0) xV = -xV end
		if _C(xV, ">", nPeak) nPeak = xV end
	end
	if _C(nPeak, "=", 0) nPeak = 1 end
	nM = 0
	for i = 1 to nN
		xD = _A(xGot[i], "-", xWant[i])
		if _C(xD, "<", 0) xD = -xD end
		if _C(xD, ">", nM) nM = xD end
	end
	return _Q(nM, nPeak)
end

# A value as text, as the guard's narration writes it: a text as it is, a whole number plainly, any other number
# to $nStzPlaces places, rounded half away from zero. (The library's one-argument Text and Round shadow the built-ins.)
func _T(xV)
	if IsString(xV)
		return xV
	end
	if not IsNumber(xV)
		return String(xV)
	end
	tS = String(xV)
	nLen = Len(tS)
	bPlain = true
	for k = 1 to nLen
		tC = tS[k]
		if tC = "n" or tC = "i"
			return tS
		end
		if tC = "." or tC = "e" or tC = "E"
			bPlain = false
		end
	end
	if bPlain
		return tS
	end
	nP = $nStzPlaces
	nScale = 1
	for k = 1 to nP
		nScale = nScale * 10
	end
	fV = Float(xV)
	bNeg = fV < Float(0)
	if bNeg
		fV = Float(0) - fV
	end
	nI = Floor(fV * Float(nScale) + 0.5f)
	if nP = 0
		tR = String(nI)
	else
		nW = _Q((nI - nI % nScale), nScale)
		tF = String(nI % nScale)
		while Len(tF) < nP
			tF = "0" + tF
		end
		tR = String(nW) + "." + tF
	end
	if bNeg and nI != 0
		tR = "-" + tR
	end
	return tR
end

# A condition as true or false: a 1 or 0 from older code, or a boolean.
func _StzB(xV)
	if IsNumber(xV)
		return xV != 0
	end
	return xV
end

# The absolute value of any number: exact for an integer or a decimal, a float for a float.
func _StzAbs(xV)
	try
		if xV < 0
			return 0 - xV
		end
		return xV
	catch e
		fV = Float(xV)
		if fV < Float(0)
			return Float(0) - fV
		end
		return fV
	end
end

# A quotient as the older code took it: exact when one exists; otherwise, taken through floats, a decimal to
# nine places, or a float when either side is a float.
func _Q(xA, xB)
	try
		return xA / xB
	catch e
	end
	fQ = Float(String(xA)) / Float(String(xB))
	if _StzIsFloat(xA) or _StzIsFloat(xB)
		return fQ
	end
	try
		return Decimal(fQ, 9)
	catch e
		return fQ
	end
end

# A comparison as the older code made it, where every number was of one kind: the comparison itself when both
# sides are of one kind; otherwise both sides as floats, equal when neither is below the other, and a NaN equal
# to nothing.
func _C(xA, tOp, xB)
	try
		if tOp = "="
			return xA = xB
		end
		if tOp = "!="
			return xA != xB
		end
		if tOp = "<"
			return xA < xB
		end
		if tOp = ">"
			return xA > xB
		end
		if tOp = "<="
			return xA <= xB
		end
		return xA >= xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	bNaN = _StzNaN(fA) or _StzNaN(fB)
	if tOp = "="
		return not bNaN and not (fA < fB) and not (fA > fB)
	end
	if tOp = "!="
		return bNaN or fA < fB or fA > fB
	end
	if bNaN
		return false
	end
	if tOp = "<"
		return fA < fB
	end
	if tOp = ">"
		return fA > fB
	end
	if tOp = "<="
		return not (fA > fB)
	end
	return not (fA < fB)
end

# A number, or a true or false, as a float (the older code read a true as 1).
func _StzF(xV)
	if IsNumber(xV)
		if _StzIsFloat(xV)
			return xV
		end
		return Float(String(xV))
	end
	if xV
		return 1.0f
	end
	return 0.0f
end

# True for a NaN, read from its text.
func _StzNaN(xV)
	if not IsNumber(xV)
		return false
	end
	tS = String(xV)
	return tS = "nan" or tS = "-nan"
end

# True for a float: an integer or a decimal takes a zero added, a float refuses it.
func _StzIsFloat(xV)
	if not IsNumber(xV)
		return false
	end
	try
		xT = xV + 0
		return false
	catch e
		return true
	end
end

# Arithmetic as the older code did it, where every number was of one kind: the operation itself when both sides
# are of one kind; otherwise both sides as floats.
func _A(xA, tOp, xB)
	try
		if tOp = "+"
			return xA + xB
		end
		if tOp = "-"
			return xA - xB
		end
		return xA * xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	if tOp = "+"
		return fA + fB
	end
	if tOp = "-"
		return fA - fB
	end
	return fA * fB
end
