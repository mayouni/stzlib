# gpu_lease_narrated.haro -- RADAR-GPU-OWNER-01 (a): one process at a time owns a GPU adapter.
#
# Two processes computing on the RTX 3050 at once crashed the driver on 2026-11-03: a segfault under
# nvoglv64.dll and "Parent device is lost", about 20 s after a second process started a neural job beside the
# first. The engine now takes a LEASE before it opens a device: a lock on a file in the temp folder, one per
# adapter, dropped when the device closes and by the OS when the process ends, however it ends. A second process
# waits up to STZ_GPU_LEASE_WAIT_MS (default 30000), then runs with no device, as on a machine without a GPU,
# and its last error names the holder.
#
# This guard holds the device and starts a second process (gpu_lease_child.haro, the same haro.exe) against it.
# The child that would open a SECOND device on the same card -- the lease switched off while this process holds
# it -- is never started: that is the crash itself. On a machine with no device, every scene skips by name.
load "../../stzBase.ring"
load "doors.haro"

$nPass = 0
$nFail = 0
$nSkip = 0
$nRun = 0

? "-- Scene 0: this process opens the device and holds the lease --"
nUp = StzEngineGpuInit($tStzGpuRuntime)
if nUp = 0
	if StzEngineGpuLease(0) = 3
		Skip("every scene: another process holds the GPU (process " + String(StzEngineGpuLease(2)) + ") for longer than the wait")
	else
		Skip("every scene: no device on this machine")
	end
	Shutdown($nFail)
end
chk("the device opened, and the lease was taken (outcome " + String(StzEngineGpuLease(0)) + ", 1 or 2)", StzEngineGpuLease(0) = 1 or StzEngineGpuLease(0) = 2)
chk("this process holds the lease now", StzEngineGpuLease(3) = 1)

? "-- Scene 1: a second process meets the lease, waits, and runs without a device --"
xC = Child("STZ_GPU_LEASE_WAIT_MS=1000", "")
chk("the second process got no device", xC[1] = 0)
chk("its lease was refused (outcome 3)", xC[2] = 3)
chk("it waited the whole second it was given (" + String(xC[3]) + " ms), and not ten", xC[3] >= 1000 and xC[3] < 10000)
chk("it names the process that holds the card (" + String(xC[4]) + ")", xC[4] > 0)
chk("it holds no lease", xC[5] = 0)
chk("its last error says why, by name: " + xC[6], StzFindFirst("leased by process", xC[6]) > 0)
? "  (not run: a second process with STZ_GPU_LEASE=off while this one holds the card -- that is the crash itself)"

? "-- Scene 1b: a second engine library of THIS process shares the lease at once --"
# stz_gpu and stz_neural each carry the engine's GPU code, so one process opens two devices; the lease orders
# processes, not libraries. Until 2026-11-15 the backbone waited the full 30 s on its own process and ran without one.
tModel = $tStzLibDir + "/models/all-MiniLM-L6-v2.Q8_0.gguf"
if StzEngineNeuralModelLoad(tModel) != 1
	Skip("scene 1b: MiniLM is not in " + $tStzLibDir + "/models (load status " + String(StzEngineNeuralModelLoadStatus()) + ")")
else
	tText = ""
	for j = 1 to 4
		tText += "the quick brown fox jumps over the lazy dog and runs away "
	end
	nT = StzEngineWatchTimestampNs()
	vE = StzEngineNeuralBackboneEmbed(tText)
	nMs = (StzEngineWatchTimestampNs() - nT - (StzEngineWatchTimestampNs() - nT) % 1000000) / 1000000
	chk("the backbone, in the other library, ran on its device while this one holds the lease (" + String(Len(vE)) + " dimensions)", Len(vE) = 384)
	chk("and did not wait for its own process: " + String(nMs) + " ms, against a 30,000 ms wait", nMs < 10000)
	StzEngineNeuralModelFree()
end

? "-- Scene 1c: a puzzle grader that finds the card busy waits, and never grades on the interpreter --"
# kp-05's missing guard writes past the region: only the device's margin sees it. A grader refused by the lease used
# to fall to the interpreter and answer "verified" -- a wrong answer accepted (KP-PROVE-FLAKE, 2026-11-15).
xC = ChildGrade("STZ_GPU_LEASE_WAIT_MS=300")
chk("the grader got no device while this process holds the card", xC[1] = 0)
chk("and its verdict on the missing guard says it waited, naming the holder: " + xC[7], StzFindFirst("waiting for the device", xC[7]) > 0)
chk("it did not answer verified", StzFindFirst("verified", xC[7]) = 0)

? "-- Scene 2: this process lets go, and the next one takes the lease at once --"
StzEngineGpuShutdown()
chk("closing the device dropped the lease", StzEngineGpuLease(3) = 0)
xC = Child("STZ_GPU_LEASE_WAIT_MS=0", "")
chk("the next process got a device", xC[1] = 1)
chk("its lease was free (outcome 1)", xC[2] = 1)
chk("it met no other holder", xC[4] = 0)

? "-- Scene 3: a process that ends without closing its device does not strand the card --"
xC = Child("STZ_GPU_LEASE_WAIT_MS=0", "abrupt")
chk("a process took the lease and ended without closing the device", xC[1] = 1 and xC[5] = 1)
xC = Child("STZ_GPU_LEASE_WAIT_MS=0", "")
chk("the next one took it at once, with no wait: the OS dropped the lock when the first process ended", xC[1] = 1 and xC[2] = 1)

? "-- Scene 4: STZ_GPU_LEASE=off opens with no lease, when no one else holds the card --"
xC = Child("STZ_GPU_LEASE=off", "")
chk("a process with the lease off got a device", xC[1] = 1)
chk("and says the lease was off (outcome 4), holding none", xC[2] = 4 and xC[5] = 0)

? "-- Scene 5: this process opens again after them all --"
nUp = StzEngineGpuInit($tStzGpuRuntime)
chk("the device opened again, and the lease was free (outcome 1)", nUp = 1 and StzEngineGpuLease(0) = 1)
StzEngineGpuShutdown()

? ""
? "TOTAL: " + String($nPass + $nFail) + " assertions, " + String($nPass) + " pass, " + String($nFail) + " fail, " + String($nSkip) + " skipped"
Shutdown($nFail)

# Runs gpu_lease_child.haro in a second process with tEnv set, and reads back what its lease said:
# [ device 1/0, outcome, ms waited, other holder's process id, held 1/0, last error ].
func Child(tEnv, tExit)
	xL = RunChild(tEnv, tExit, "")
	if Len(xL) = 0
		return [ -1, -1, -1, -1, -1, "the second process wrote nothing" ]
	end
	tErr = ""
	if Len(xL) >= 6
		tErr = xL[6]
	end
	return [ Number(xL[1]), Number(xL[2]), Number(xL[3]), Number(xL[4]), Number(xL[5]), tErr ]
end

# Child() with the kp-05 grade: [ device, outcome, waited, other, held, last error, verdict ].
func ChildGrade(tEnv)
	xL = RunChild(tEnv, "", "kp05-noguard")
	if Len(xL) = 0
		return [ -1, -1, -1, -1, -1, "the second process wrote nothing", "" ]
	end
	tV = ""
	if Len(xL) >= 7
		tV = xL[7]
	end
	return [ Number(xL[1]), Number(xL[2]), Number(xL[3]), Number(xL[4]), Number(xL[5]), xL[6], tV ]
end

# The second process: this same haro, run as a DECLARED command (doors, no shell) on gpu_lease_child.haro. What it is
# told goes in this process's variables, which it inherits; each is set before the run and emptied after, so no
# scene leaks into the next one or into this process. tEnv is one NAME=VALUE. Answers the lines it wrote, or [].
func RunChild(tEnv, tExit, tGrade)
	$nRun += 1
	tOut = "_lease_out_" + String($nRun) + ".txt"
	vSet = StzSplit(tEnv, "=")
	vVars = [ [vSet[1], vSet[2]], ["STZ_LEASE_OUT", tOut], ["STZ_LEASE_EXIT", tExit], ["STZ_LEASE_GRADE", tGrade] ]
	for vV in vVars
		SysSet(vV[1], vV[2])
	end
	tQ = Char(34)
	sDoors = doors.Judge("DEFINE COMMAND child AS (ITSELF yes, TAKES [word], QUIET yes) RATIONALE " + tQ + "this haro, the guard's second process" + tQ)
	sDoors.Invocation("child", ["gpu_lease_child.haro"]).Run()
	for vV in vVars
		SysSet(vV[1], "")
	end
	if not FExists(tOut)
		return []
	end
	xL = StzSplit(Read(tOut), Char(10))
	Remove(tOut)
	return xL
end

func chk(tWhat, bOk)
	if bOk
		$nPass += 1
		? "  [OK] " + tWhat
	else
		$nFail += 1
		? "  [FAIL] " + tWhat
	end
end

func Skip(tWhat)
	$nSkip += 1
	? "  [SKIP] " + tWhat
end
