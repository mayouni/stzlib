# GL0 -- VECTORS (SOFTANZA_GPU_PLAN.md, GL0; the reader's account of the
# language is base/gpu/SOFTANZA_GPU_KERNELS.md, 3.1c).
#
# The third admission: vec2, vec3 and vec4 of floats, as values inside a
# kernel. They are built from numbers (vec3(@x, @y, @z), vec4(v2, 1, 0),
# vec3(1)), read by component (.x, .zyx), combined component by component (a
# number meeting a vector is spread across it), passed to every float function
# component by component, and reduced by dot, length and distance;
# normalize, cross and reflect give vectors back. An input or an output is
# still a number, so a vector is built and reduced inside one expression.
# Vector inputs and outputs need interleaved buffers, which belong with the
# real i32 buffers atomics need: the next rung.
#
# One decision is shared by both readers: what a call means once its
# arguments' types are known (planCall). Each reader parses, writes and
# computes the call its own way; the interpreter computes every component
# through the same function that computes a number (applyF), so a vector's
# meaning and a number's cannot drift. The transpiler wrote the same WGSL,
# byte for byte, for 18,000 generated kernels before and after.
#
# Run with haro: haro gpu_vec_narrated.haro

load "../../stzBase.ring"

$nPass = 0
$nFail = 0

pr()

$nStzPlaces = 4
tNL = Char(10)

? "-- Scene 1: vectors built, read, combined and reduced, in both readers --"
$nT0 = Clock()
kLen = StzKernelMakerFromSpec("in x" + tNL + "in y" + tNL + "in z" + tNL + "out d" + tNL + "body { @d = length(vec3(@x, @y, @z)) }")
chk("the transpiler writes WGSL's own vector: length(vec3<f32>(v_x[i], v_y[i], v_z[i]))",
	StzFindFirst("length(vec3<f32>(v_x[i], v_y[i], v_z[i]))", kLen.ToWGSL()) > 0)
xL = kLen.EvaluateOn([ [:x, [ 3, 0, 1 ]], [:y, [ 4, 0, 2 ]], [:z, [ 0, 0, 2 ]] ])
chk("the interpreter: the lengths of (3, 4, 0), (0, 0, 0), (1, 2, 2) are 5, 0, 3", xL[1] = 5 and xL[2] = 0 and xL[3] = 3)
kSw = StzKernelMakerFromSpec("in a" + tNL + "out c" + tNL + "body { @c = (vec3(@a, 1, 2) * 2 + 1).zyx.x + dot(vec2(@a, 1), vec2(3, 4)) }")
xS = kSw.EvaluateOn([ [:a, [ 0, 1, 2 ]] ])
chk("a number spread across a vector, a swizzle of a swizzle, a dot: 3a + 9 gives 9 12 15", xS[1] = 9 and xS[2] = 12 and xS[3] = 15)
kFx = StzKernelMakerFromSpec("in a" + tNL + "out c" + tNL + "body { @c = cross(vec3(1, 0, 0), vec3(0, @a, 0)).z + normalize(vec2(@a, 0)).x + reflect(vec2(1, -1), vec2(0, 1)).y + mix(vec2(0, 2), vec2(4, 6), 0.5).y + when(@a > 1, vec2(10, 20), vec2(30, 40)).y + floor(vec2(@a * 1.5, 0)).x }")
xF = kFx.EvaluateOn([ [:a, [ 1, 2, 3 ]] ])
chk("cross, normalize, reflect, mix with one weight, when of vectors, floor by component: 48 31 33", xF[1] = 48 and xF[2] = 31 and xF[3] = 33)
chk("...and when of two vectors is WGSL's select of two vectors", StzFindFirst("select((vec2<f32>(30f, 40f)), (vec2<f32>(10f, 20f)), (v_a[i] > 1f)).y", kFx.ToWGSL()) > 0)
kCt = StzKernelMakerFromSpec("in a" + tNL + "out c" + tNL + "body { @c = vec4(vec2(@a, 1), 2, 3).w + vec3(@a).y - (-vec2(@a, 5)).y }")
xC = kCt.EvaluateOn([ [:a, [ 0, 1, 2 ]] ])
chk("a constructor of a vector and numbers, one number spread, a vector negated: a + 8", xC[1] = 8 and xC[2] = 9 and xC[3] = 10)
? "  (scene 1: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"

? ""
? "-- Scene 2: what is refused, in the same words by both readers --"
$nT0 = Clock()
xRef = [
	[ "a vector as the output's value", "body { @c = vec3(@a, 1, 2) }", "a vector stands where a number is needed" ],
	[ "a vector compared whole", "body { @c = when(vec2(@a, 1) > 0, 1, 0) }", "a vector is not compared whole" ],
	[ "two widths in one sum", "body { @c = (vec2(1, 2) + vec3(1, 2, 3)).x }", "vectors of two widths meet at '+'" ],
	[ "a number where a function takes a vector", "body { @c = min(vec2(@a, 1), 0).x }", "'min' takes values of one type: write vec2(x)" ],
	[ "a constructor short of numbers", "body { @c = vec3(1, 2).x }", "vec3 takes 3 numbers" ],
	[ "a vector function given numbers", "body { @c = dot(@a, 2) }", "'dot' works on vectors" ],
	[ "cross of two vec2s", "body { @c = cross(vec2(1, 2), vec2(3, 4)).x }", "cross takes two vec3s" ],
	[ "a component of a number", "body { @c = @a.x }", "'.x' reads a vector's components, and this value is a number" ],
	[ "a component past the width", "body { @c = vec2(@a, 1).z }", "a vec2's letters are xy" ],
	[ "a vector as an index", "body { @c = @a[vec2(1, 2)] }", "a vector stands where a number is needed" ],
	[ "a vector and a number in one when", "body { @c = when(@a > 0, vec2(1, 2), 3).x }", "'when' takes values of one type" ]
]
for vQ in xRef
	tSpec = "in a" + tNL + "out c" + tNL + _T(vQ[2])
	tT = ""
	try
		StzKernelMakerFromSpec(tSpec).ToWGSL()
	catch
		tT = cCatchError
	end
	tI = ""
	try
		StzKernelMakerFromSpec(tSpec).EvaluateOn([ [:a, [ 1, 2 ]] ])
	catch
		tI = cCatchError
	end
	chk(_T(vQ[1]) + ": both readers refuse it with '" + _T(vQ[3]) + "'", StzFindFirst(vQ[3], tT) > 0 and tT = tI)
end
tSpec = "in k int" + tNL + "out c" + tNL + "body { @c = vec2(@k, 1).x }"
tT = ""
try
	StzKernelMakerFromSpec(tSpec).ToWGSL()
catch
	tT = cCatchError
end
chk("an int in a vector: 'a vector holds floats'", StzFindFirst("a vector holds floats", tT) > 0)
? "  (scene 2: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"

oG = new stzGpu
bDevice = oG.IsAvailable()
if bDevice
	? ""
	? "-- Scene 3: on the device --"
	$nT0 = Clock()
	xX = [] vY = [] xZ = []
	for i = 1 to 3000
		xX + ((((i * 7) % 33) - 16) / 8)
		vY + ((((i * 5) % 29) - 14) / 4)
		xZ + ((((i * 3) % 17) - 8) / 2)
	end
	vCases = [
		[ "a length", "body { @c = length(vec3(@x, @y, @z)) }" ],
		[ "swizzles and spreading", "body { @c = (vec3(@x, 1, 2) * 2 + @y).zyx.x + dot(vec2(@x, @z), vec2(3, 4)) }" ],
		[ "cross, reflect, mix, when, floor", "body { @c = cross(vec3(@x, @y, @z), vec3(@z, @x, @y)).y + reflect(vec2(@x, @y), vec2(0, 1)).y + mix(vec2(@x, 2), vec2(4, @z), 0.25).x + when(@x > 1, vec2(@y, 20), vec2(30, @z)).x + floor(vec2(@x * 1.5, 0)).x }" ],
		[ "normalize and distance", "body { @c = normalize(vec3(@x, @y, @z) + 0.5).x + distance(vec2(@x, @y), vec2(@z, 1)) }" ],
		[ "max, clamp, smoothstep by component", "body { @c = max(vec2(@x, @y), vec2(@z, 0)).y + clamp(vec2(@x, @y), vec2(-1, -1), vec2(1, 1)).x + smoothstep(vec2(-2, -2), vec2(2, 2), vec2(@x, @y)).y }" ]
	]
	for vQ in vCases
		oKer = StzKernelMakerFromSpec("in x" + tNL + "in y" + tNL + "in z" + tNL + "out c" + tNL + _T(vQ[2]))
		xV = oG.VerifySpecWith(oKer, oKer, [ [:x, xX], [:y, vY], [:z, xZ] ], [ [:n, 3000] ])
		chk(_T(vQ[1]) + ": the kernel compiles and agrees with the interpreter (" + _T(xV[:verdict]) + ", maxdiff " + _T(xV[:maxdiff]) + ")", xV[:verdict] = "verified")
	end
	? "  (scene 3: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"

	? ""
	? "-- Scene 4: the fuzz's vector kind, and its control --"
	$nT0 = Clock()
	nSeed = 20261028
	StzEngineGpuFuzzRun(nSeed, 300, 1024, 0.00001)
	? "  generated " + _T(StzEngineGpuFuzzResult(42)) + " vector kernels; ran " + _T(StzEngineGpuFuzzResult(4)) + ", agreed " + _T(StzEngineGpuFuzzResult(5)) + " (exact " + _T(StzEngineGpuFuzzResult(9)) + ", the worst inexact one at " + _T(StzEngineGpuFuzzResult(11)) + " of the band)"
	chk("300 vector kernels: none refused by both readers, no split, no compile failure",
		StzEngineGpuFuzzResult(42) = 300 and StzEngineGpuFuzzResult(1) = 0 and StzEngineGpuFuzzResult(2) = 0 and StzEngineGpuFuzzResult(3) = 0)
	chk("...all 300 agree with the interpreter, the exact ones bit for bit, and they are more than half",
		StzEngineGpuFuzzResult(5) = 300 and StzEngineGpuFuzzResult(17) = 0 and StzEngineGpuFuzzResult(9) > 150)
	StzEngineGpuFuzzRun(nSeed, 300, 1024 + 64, 0.00001)
	nMut = StzEngineGpuFuzzResult(18)
	nCaught = StzEngineGpuFuzzResult(19)
	? "  mutated " + _T(nMut) + ", caught " + _T(nCaught)
	chk("the control: over a hundred vector kernels had a '+' to break", nMut > 100)
	chk("...and at least 85% were caught (measured 157 of 173 on 2026-10-28)", nCaught >= 0.85 * nMut)
	? "  (scene 4: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"
end

? ""
? "-- Scene 5: puzzle 15, light on a surface --"
$nT0 = Clock()
oQ = StzKernelPuzzleQ("kp-15")
chk("the starter grades 'waiting for your implementation'", oQ.Grade(oQ.Starter()) = "waiting for your implementation")
chk("the task reads in four languages and ends with what the GPU did differently from a loop",
	oQ.Task("en") != "" and oQ.Task("fr") != "" and oQ.Task("ar") != "" and oQ.Task("ha") != "" and StzFindFirst("differently from a loop", oQ.Task("en")) > 0)
tHead = "in nx" + tNL + "in ny" + tNL + "in nz" + tNL + "scalar sx" + tNL + "scalar sy" + tNL + "scalar sz" + tNL + "out c" + tNL
vCases = [
	[ "max(dot(normalize(vec3(@nx, @ny, @nz)), normalize(vec3(sx, sy, sz))), 0)", "verified" ],
	[ "max(dot(normalize(vec3(@nx, @ny, @nz)), vec3(sx, sy, sz) / 3), 0)", "verified" ],
	[ "max(dot(vec3(@nx, @ny, @nz), normalize(vec3(sx, sy, sz))), 0)", "mismatch at element 8" ],
	[ "dot(normalize(vec3(@nx, @ny, @nz)), normalize(vec3(sx, sy, sz)))", "mismatch at element 1" ]
]
nAgree = 0
for vQ in vCases
	tSpec = tHead + "body { @c = " + _T(vQ[1]) + " }"
	if bDevice
		tV = oQ.Grade(tSpec)
	else
		tV = oQ.GradeOnCpu(tSpec)
	end
	chk(_T(vQ[1]) + " -> " + _T(vQ[2]) + " (" + tV + ")", tV = vQ[2])
	if oQ.GradeOnCpu(tSpec) = vQ[2]
		nAgree++
	end
end
chk("GradeOnCpu says the same words for all " + _T(Len(vCases)) + " cases", nAgree = Len(vCases))
tV = oQ.Grade(tHead + "body { @c = normalize(vec3(@nx, @ny, @nz)) }")
chk("a vector for the output is refused by name (" + tV + ")", StzFindFirst("refused", tV) = 1 and StzFindFirst("a vector stands where a number is needed", tV) > 0)
if bDevice
	oE = StzExerciseQ("../../education/program/courses/kernel-puzzles/exercises/kp-15")
	# the parent lets go of the card first: since the GPU lease (2026-11-14) the graders ProveItself starts
	# cannot take it from their own parent, and would wait and answer "waiting for the device" (KP-PROVE-FLAKE)
	StzEngineGpuShutdown()
	xPr = oE.ProveItself()
	chk("the exercise proves itself through the System's checker: wrong refused " + _T(xPr[:wrong]) + ", right accepted " + _T(xPr[:right]) + ", failures " + _T(@@(xPr[:failures])),
		xPr[:wrong] = 5 and xPr[:right] = 3 and Len(xPr[:failures]) = 0)
end
? "  (scene 5: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"

? ""
? "=========================================="
? "TOTAL: " + _T(($nPass + $nFail)) + " assertions, " + _T($nPass) + " pass, " + _T($nFail) + " fail"
? "=========================================="

pfq()
Shutdown($nFail)

func chk(tLabel, xCond)
	if _StzB(xCond)
		$nPass++
		? "  [OK] " + tLabel
	else
		$nFail++
		? "  [FAIL] " + tLabel
	end
end

# A value as text, as the guard's narration writes it: a text as it is, a whole number plainly, any other number
# to $nStzPlaces places, rounded half away from zero. (The library's one-argument Text and Round shadow the built-ins.)
func _T(xV)
	if IsString(xV)
		return xV
	end
	if not IsNumber(xV)
		return String(xV)
	end
	tS = String(xV)
	nLen = Len(tS)
	bPlain = true
	for k = 1 to nLen
		tC = tS[k]
		if tC = "n" or tC = "i"
			return tS
		end
		if tC = "." or tC = "e" or tC = "E"
			bPlain = false
		end
	end
	if bPlain
		return tS
	end
	nP = $nStzPlaces
	nScale = 1
	for k = 1 to nP
		nScale = nScale * 10
	end
	fV = Float(xV)
	bNeg = fV < Float(0)
	if bNeg
		fV = Float(0) - fV
	end
	nI = Floor(fV * Float(nScale) + 0.5f)
	if nP = 0
		tR = String(nI)
	else
		nW = (nI - nI % nScale) / nScale
		tF = String(nI % nScale)
		while Len(tF) < nP
			tF = "0" + tF
		end
		tR = String(nW) + "." + tF
	end
	if bNeg and nI != 0
		tR = "-" + tR
	end
	return tR
end

# A condition as true or false: a 1 or 0 from older code, or a boolean.
func _StzB(xV)
	if IsNumber(xV)
		return xV != 0
	end
	return xV
end

# The absolute value of any number: exact for an integer or a decimal, a float for a float.
func _StzAbs(xV)
	try
		if xV < 0
			return 0 - xV
		end
		return xV
	catch e
		fV = Float(xV)
		if fV < Float(0)
			return Float(0) - fV
		end
		return fV
	end
end
