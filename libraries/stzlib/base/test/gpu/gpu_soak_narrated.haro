# GT3 -- THE LONG RUN (SOFTANZA_GPU_PLAN.md, GT3), with GT3b's OUTSIDE WITNESS: the library layer across a device
# that closes and reopens, and under a loop that runs for minutes.
#
# The plan's criterion: "memory and handle counts are flat; a lost device is reported and recovered, not crashed".
# This guard asserts the MECHANISMS, each with its negative sibling:
#   - every compute module of the plane (the fft op, the checker, the scan, compaction, the radix sort, the segmented
#     reduction, the sparse product) keeps SOMETHING device-scoped between calls (a twiddle table, a verifier's
#     kernels, a scratch vector); when the device goes those must be forgotten, not reused: the device is closed and
#     reopened FIVE times and every answer after each reopening must equal the answer before the first closing;
#   - while it is closed every op answers FALLBACK, counted, and nothing crashes;
#   - a close-hook registry that silently dropped a hook once it was full is a defect that hides exactly here, so the
#     number of hooks registered and the number DROPPED are both asserted: nothing may be dropped;
#   - the live buffer count returns to its baseline after the scratch is given back, however many closings and
#     reopenings and however many iterations of the loop have gone by;
#   - no uncaptured device error is counted anywhere.
#
# THE OUTSIDE WITNESS (GT3b, 2026-11-13). The live-buffer count is the engine counting itself, and an identity is
# not a self-check. StzEngineGpuProcessMemory reads what WINDOWS counts for this process on the card (the kernel's
# per-process GPU memory counters, the ones gputaskman reads), so every "flat" above is asserted a second time by a
# measurement the engine does not make. Its first run found a defect the engine's count could not show: an upload
# freed before any submit kept its buffer and wgpu's staging copy alive, 1,092 MB after six 64 MB cycles while the
# engine counted 0 live buffers (Sync now sends staged uploads first; scene 5 is that defect's regression check, and
# its negative sibling, a 64 MB upload the witness must SEE). Opening the device alone puts about 196 MB on the card
# that no engine counter names: the driver's and wgpu's own. Where Windows gives no reading (-1), the witness
# assertions are SKIPPED by name, never passed.
#
# The checker's SPEED verdict is not a correctness answer. `impossible` means a measured time fell below the
# device's measured floors (its own source records the same false alarm on a cold or contended device). Measured
# 2026-11-06 over two runs, 2,650 and 290 rounds: `impossible` instead of `verified` for a tiny correct kernel in 4
# rounds of 2,940 (0.14%); the six compute modules never erred. No claim is made about its cause: the guard keeps
# the verdict apart from the answers, treats `verified` and `impossible` as "the checker found no mismatch", fails
# on a verdict of any other kind, and bounds the plain RATE of `impossible` (under 2%) and prints it.
#
# What the resident-memory checks can see: the process's resident memory mixes the ENGINE's allocations with the
# language's own heap, which grows in steps as it builds lists. So scene 2 bounds the whole process loosely, and
# scene 3 runs the device ops ALONE on resident buffers, no list built in its loop, where the engine's own memory is
# the only thing that can move.
#
# The loop's length is a parameter (SOAK_SECONDS in the environment, default 60) so the same guard is a minute in a
# gate and an hour on a quiet machine set aside for it: a long run holds the GPU, and a second process that uses it
# at the same time has crashed the driver before (the image desk's mailbox note of 2026-11-03).
#
# RUNS ON haro.exe with the library: STZ_ENGINE_DIR names an engine built for Haro at stzlib e89ea8f07 or later
# (the witness and the Sync flush), from this folder: haro gpu_soak_narrated.haro

load "../../stzBase.ring"

$nPass = 0
$nFail = 0
$nSkip = 0
$nMB = 1048576

? "-- Scene 0: before there is a device --"
chk("an op answers FALLBACK before Init", StzEngineGpuOpScan(1, 2, 100, 0) = 1)
chk("the witness answers -1 for a kind it does not know, never a made-up 0", StzEngineGpuProcessMemory(7) = -1)
$bWitness = (StzEngineGpuProcessMemory(0) >= 0)
? "  the outside witness: " + Pick($bWitness, "Windows gives this process's GPU memory", "NO READING on this machine -- the witness checks below are skipped by name")

oG = new stzGpu
bDevice = oG.IsAvailable()
if not bDevice
	? "  NO GPU ON THIS MACHINE -- the scenes below need a device; the fallback scene above is the CI coverage"
else
	? "  device: [" + String(StzEngineGpuSelectedAdapter()) + "] " + StzEngineGpuAdapterName(StzEngineGpuSelectedAdapter())

	? ""
	? "-- Scene 1: every compute module across five closings and reopenings of the device --"
	$nT0 = Clock()
	StzEngineGpuCountersReset()
	xRound1 = _Round(oG)
	chk("round 1 (before any closing): the fft op, the checker, the scan, compaction, the sort, the segmented reduction and the sparse product answer: " + Left(xRound1[1], 90), xRound1[2])
	nHooks1 = StzEngineGpuCloseHooks(0)
	? "  close hooks registered after round 1: " + String(nHooks1) + ", dropped: " + String(StzEngineGpuCloseHooks(1))
	# what stays on the device after the scratch is given back is what is KEPT ON PURPOSE (the fft op's twiddle
	# table); FLAT means every later round, after every closing, ends with the same count
	_ReleaseScratch()
	nFlat = StzEngineGpuCounter(8)
	? "  live buffers after round 1 with the scratch given back: " + String(nFlat) + " (the fft op keeps its twiddle table on purpose)"
	$nW1 = StzEngineGpuProcessMemory(0)
	? "  the witness after round 1: " + Mb($nW1) + " on the card for this process (" + Mb(StzEngineGpuProcessMemory(1)) + " shared)"
	nDownMax = 0
	nUpMin = $nW1
	nUpMax = $nW1
	for nCycle = 1 to 5
		StzEngineGpuShutdown()
		bDown = (StzEngineGpuIsAvailable() = 0)
		nWDown = StzEngineGpuProcessMemory(0)
		nDownMax = Bigger(nDownMax, nWDown)
		bFb = (StzEngineGpuOpScan(1, 2, 100, 0) = 1) and (StzEngineGpuOpSort(1, 2, 100, 0) = 1) and (StzEngineGpuOpSpmv(1, 2, 3, 4, 5, 10, 10, 0) = 1)
		StzEngineGpuInit($tStzGpuRuntime)
		bUp = (StzEngineGpuIsAvailable() = 1)
		xR = _Round(oG)
		_ReleaseScratch()
		nWUp = StzEngineGpuProcessMemory(0)
		nUpMin = Smaller(nUpMin, nWUp)
		nUpMax = Bigger(nUpMax, nWUp)
		bFlat = (StzEngineGpuCounter(8) = nFlat)
		? "  closing " + String(nCycle) + ": the checker's verdict on its first round after the reopening: " + xR[4] + "; the witness while down " + Mb(nWDown) + ", after the reopening " + Mb(nWUp)
		chk("closing " + String(nCycle) + ": the device is down, three ops answer FALLBACK, it reopens, every answer is the first round's, and the live buffers are as flat as after round 1 (" + String(StzEngineGpuCounter(8)) + " of " + String(nFlat) + ")", bDown and bFb and bUp and xR[2] and xR[1] = xRound1[1] and bFlat)
	end
	chk("no hook was dropped: the registry held every module that registered one (" + String(StzEngineGpuCloseHooks(0)) + " registered, " + String(StzEngineGpuCloseHooks(1)) + " dropped)", StzEngineGpuCloseHooks(1) = 0)
	chk("no uncaptured device error was counted across the five closings", StzEngineGpuCounter(9) = 0)
	chk("after five closings and reopenings the live buffers are exactly what they were after the first round (" + String(nFlat) + ")", StzEngineGpuCounter(8) = nFlat)
	witness("WINDOWS gave the card's memory back at every closing: at most " + Mb(nDownMax) + " while down, against " + Mb($nW1) + " with the device open", nDownMax < $nW1 / 2)
	witness("WINDOWS counts the same after every reopening: " + Mb(nUpMin) + " to " + Mb(nUpMax) + ", within 16 MB of round 1's " + Mb($nW1), nUpMax - nUpMin <= 16 * $nMB and Abs(nUpMax - $nW1) <= 16 * $nMB)
	? "  (scene 1: " + Secs($nT0) + " s)"

	? ""
	? "-- Scene 2: the loop, for as long as SOAK_SECONDS says (default 60) --"
	$nT0 = Clock()
	tSec = SysGet("SOAK_SECONDS")
	nSec = 60
	if tSec != ""
		nSec = Number(tSec)
	end
	if nSec <= 0
		nSec = 60
	end
	? "  running for " + String(nSec) + " seconds: a round of every module, the device closed and reopened every tenth round"
	StzEngineGpuCountersReset()
	nStart = StzEngineWatchTimestampNs()
	nRound = 0
	nClosings = 0
	nWrong = 0
	nCompileMoved = 0
	nLiveMoved = 0
	nPrevCompile = -1
	nLastSample = 0
	vRss = []
	vWrongAt = []
	nImpossible = 0
	nW2Min = $nW1
	nW2Max = $nW1
	nW2Reads = 0
	while (StzEngineWatchTimestampNs() - nStart) / 1000000000 < nSec
		nRound++
		bReopened = false
		if nRound % 10 = 0
			StzEngineGpuShutdown()
			StzEngineGpuOpScan(1, 2, 100, 0)
			StzEngineGpuOpSort(1, 2, 100, 0)
			StzEngineGpuOpSpmv(1, 2, 3, 4, 5, 10, 10, 0)
			StzEngineGpuInit($tStzGpuRuntime)
			nClosings++
			nPrevCompile = -1
			bReopened = true
		end
		xR = _Round(oG)
		if xR[4] = "impossible"
			nImpossible++
		end
		if not xR[2] or xR[1] != xRound1[1]
			nWrong++
			if Len(vWrongAt) < 5
				vWrongAt + ("round " + String(nRound) + " (" + String(nRound % 10) + " since the last closing; errors " + String(StzEngineGpuCounter(9)) + "): " + xR[3] + " | " + xR[1] + " | the device says: " + Left(StzEngineGpuLastError(), 80))
			end
		end
		nC = StzEngineGpuCounter(4)
		if nPrevCompile >= 0 and nC != nPrevCompile
			nCompileMoved++
		end
		nPrevCompile = nC
		if nRound % 5 = 0 or bReopened
			_ReleaseScratch()
			if StzEngineGpuCounter(8) != nFlat
				nLiveMoved++
			end
		end
		if bReopened
			# the witness costs about 0.1 s a reading: once per reopening, after its first round
			nW = StzEngineGpuProcessMemory(0)
			nW2Min = Smaller(nW2Min, nW)
			nW2Max = Bigger(nW2Max, nW)
			nW2Reads++
		end
		nT = Floor((StzEngineWatchTimestampNs() - nStart) / 1000000000)
		if nT >= nLastSample + 5
			nLastSample = nT
			vRss + StzEnginePerfMemRss()
		end
	end
	_ReleaseScratch()
	nWEnd = StzEngineGpuProcessMemory(0)
	nN = Len(vRss)
	nQ = Floor(nN / 4)
	nEarly = 0
	nLate = 0
	if nQ >= 1
		for i = nQ + 1 to 2 * nQ
			nEarly += vRss[i]
		end
		for i = nN - nQ + 1 to nN
			nLate += vRss[i]
		end
		nEarly = IntDiv(nEarly, nQ)
		nLate = IntDiv(nLate, nQ)
	end
	? "  " + String(nRound) + " rounds, " + String(nClosings) + " closings; resident memory, the second quarter's mean " + String(Floor(nEarly / $nMB)) + " MB and the last quarter's " + String(Floor(nLate / $nMB)) + " MB (" + String(nN) + " samples)"
	? "  the witness at " + String(nW2Reads) + " reopenings: " + Mb(nW2Min) + " to " + Mb(nW2Max) + "; at the end of the loop " + Mb(nWEnd)
	for i = 1 to Len(vWrongAt)
		? "  WRONG: " + vWrongAt[i]
	end
	? "  the checker's speed verdict was 'impossible' in " + String(nImpossible) + " of " + String(nRound) + " rounds (measured before: 4 of 2,940)"
	chk(String(nRound) + " rounds: every answer of every module was the first round's, to the bit, through " + String(nClosings) + " closings (" + String(nWrong) + " were not)", nWrong = 0 and nRound >= 3)
	chk("kernel handles are flat: a round that follows a round without a closing compiled nothing new, in every one (" + String(nCompileMoved) + " moved)", nCompileMoved = 0)
	chk("buffer handles are flat: with the scratch given back every fifth round and after every reopening, the live buffers were " + String(nFlat) + " each time (" + String(nLiveMoved) + " moved)", nLiveMoved = 0)
	chk("fallbacks are exactly the ones asked for: 3 probes in each of the " + String(nClosings) + " closings = " + String(3 * nClosings) + " (the counter says " + String(StzEngineGpuCounter(3)) + ")", StzEngineGpuCounter(3) = 3 * nClosings)
	chk("no uncaptured device error was counted in the whole run", StzEngineGpuCounter(9) = 0)
	chk("no close hook was dropped (" + String(StzEngineGpuCloseHooks(0)) + " registered, " + String(StzEngineGpuCloseHooks(1)) + " dropped)", StzEngineGpuCloseHooks(1) = 0)
	chk("the checker's speed verdict `impossible` on its tiny correct kernel is rare: " + String(nImpossible) + " of " + String(nRound) + " rounds, under 2% (it is a speed verdict, never a wrong answer: the six compute modules were right in every round)", nImpossible <= 0.02 * nRound + 1)
	chk("the device did the work: " + String(StzEngineGpuCounter(0)) + " dispatches in " + String(StzEngineGpuCounter(6)) + " queue submits", StzEngineGpuCounter(0) > 100 * nRound / 10)
	witness("WINDOWS counts the card flat across the loop: " + Mb(nW2Min) + " to " + Mb(nW2Max) + " at " + String(nW2Reads) + " reopenings and " + Mb(nWEnd) + " at the end, all within 16 MB of round 1's " + Mb($nW1), nW2Reads >= 1 and nW2Max - nW2Min <= 16 * $nMB and Abs(nWEnd - $nW1) <= 16 * $nMB)
	if nQ >= 1
		chk("resident memory does not climb: the last quarter's mean is within 25% + 64 MB of the second quarter's (the bound is a measurement, printed above)", nLate < nEarly * 1.25 + 64 * $nMB)
	else
		$nSkip++
		? "  [SKIPPED] the memory check: the run was too short to sample (a sample every 5 s, four quarters)"
	end
	? "  (scene 2: " + Secs($nT0) + " s)"

	? ""
	? "-- Scene 3: the engine alone, no list built in the loop --"
	$nT0 = Clock()
	nSec3 = IntDiv(nSec, 3)
	if nSec3 < 10
		nSec3 = 10
	end
	nN = 70000
	vIn = []
	vFl = []
	for i = 1 to nN
		vIn + ((i * 5) % 7)
		vFl + Pick(i % 100 = 1, 1, 0)
	end
	nHI = StzEngineGpuBufferNew(nN * 4)
	nHF = StzEngineGpuBufferNew(nN * 4)
	nHO = StzEngineGpuBufferNew(nN * 4)
	StzEngineGpuBufferUploadList(nHI, vIn)
	StzEngineGpuBufferUploadList(nHF, vFl)
	StzEngineGpuCountersReset()
	nC3a = -1
	nLive3a = -1
	nW3a = -1
	nStart = StzEngineWatchTimestampNs()
	nLastSample = -2
	nRounds3 = 0
	vRss3 = []
	while (StzEngineWatchTimestampNs() - nStart) / 1000000000 < nSec3
		StzEngineGpuOpScan(nHI, nHO, nN, 0)
		StzEngineGpuOpCompactWhere(nHI, nHO, nN, 0, 3)
		StzEngineGpuOpSort(nHI, nHO, nN, 0)
		StzEngineGpuOpSegScan(nHI, nHF, nHO, nN, 0)
		StzEngineGpuSync()
		nRounds3++
		if nRounds3 = 3
			nC3a = StzEngineGpuCounter(4)
			nLive3a = StzEngineGpuCounter(8)
			nW3a = StzEngineGpuProcessMemory(0)
		end
		nT = Floor((StzEngineWatchTimestampNs() - nStart) / 1000000000)
		if nT >= nLastSample + 2
			nLastSample = nT
			vRss3 + StzEnginePerfMemRss()
		end
	end
	nW3b = StzEngineGpuProcessMemory(0)
	nN3 = Len(vRss3)
	nQ3 = Floor(nN3 / 4)
	nE3 = 0
	nLt3 = 0
	if nQ3 >= 1
		for i = nQ3 + 1 to 2 * nQ3
			nE3 += vRss3[i]
		end
		for i = nN3 - nQ3 + 1 to nN3
			nLt3 += vRss3[i]
		end
		nE3 = IntDiv(nE3, nQ3)
		nLt3 = IntDiv(nLt3, nQ3)
	end
	? "  " + String(nRounds3) + " rounds of four ops in " + String(nSec3) + " s; resident memory, second quarter's mean " + String(Floor(nE3 / $nMB)) + " MB, last quarter's " + String(Floor(nLt3 / $nMB)) + " MB (" + String(nN3) + " samples); the witness " + Mb(nW3a) + " after the third round, " + Mb(nW3b) + " at the end"
	chk("the engine compiled nothing after the third round (" + String(nC3a) + " kernels then, " + String(StzEngineGpuCounter(4)) + " at the end)", StzEngineGpuCounter(4) = nC3a)
	chk("the live buffers did not move: " + String(nLive3a) + " after the third round (the scratch made and kept), " + String(StzEngineGpuCounter(8)) + " after " + String(nRounds3) + " rounds", StzEngineGpuCounter(8) = nLive3a)
	chk("no uncaptured device error in " + String(nRounds3) + " rounds", StzEngineGpuCounter(9) = 0)
	witness("WINDOWS counts the card flat through the engine-alone loop: " + Mb(nW3a) + " after the third round, " + Mb(nW3b) + " after " + String(nRounds3), Abs(nW3b - nW3a) <= 16 * $nMB)
	if nQ3 >= 1
		chk("the engine's resident memory does not climb: the last quarter's mean is within 32 MB of the second quarter's (measured: 5 MB over 40 s)", nLt3 < nE3 + 32 * $nMB)
	else
		$nSkip++
		? "  [SKIPPED] the engine memory check: the run was too short to sample"
	end
	StzEngineGpuBufferFree(nHI)
	StzEngineGpuBufferFree(nHF)
	StzEngineGpuBufferFree(nHO)
	_ReleaseScratch()
	? "  (scene 3: " + Secs($nT0) + " s)"

	? ""
	? "-- Scene 4: a device destroyed under the engine, the way a driver reset does it, then recovered --"
	$nT0 = Clock()
	nW4Max = 0
	for nLoss = 1 to 3
		nErr0 = StzEngineGpuCounter(9)
		nSeen = StzEngineGpuSimulateDeviceLoss()
		bDown = (StzEngineGpuIsAvailable() = 0)
		nErr1 = StzEngineGpuCounter(9)
		tMsg = StzEngineGpuLastError()
		bFb = (StzEngineGpuOpScan(1, 2, 100, 0) = 1) and (StzEngineGpuOpSort(1, 2, 100, 0) = 1) and (StzEngineGpuOpSpmv(1, 2, 3, 4, 5, 10, 10, 0) = 1)
		nUp = StzEngineGpuInit($tStzGpuRuntime)
		bUp = (StzEngineGpuIsAvailable() = 1)
		xR = _Round(oG)
		_ReleaseScratch()
		nW = StzEngineGpuProcessMemory(0)
		nW4Max = Bigger(nW4Max, nW)
		? "  loss " + String(nLoss) + ": noticed " + String(nSeen) + ", errors " + String(nErr0) + " -> " + String(nErr1) + ", the device says '" + Left(tMsg, 70) + "'; after Init: " + xR[3] + "; the witness " + Mb(nW)
		chk("loss " + String(nLoss) + ": the engine noticed it, is down, REPORTED it (the error count rose), answers FALLBACK for three ops, Init brings it back, and every module's answer is the first round's", nSeen = 1 and bDown and nErr1 > nErr0 and Len(tMsg) > 0 and bFb and bUp and xR[2] and xR[1] = xRound1[1])
	end
	chk("after three losses and recoveries the live buffers are what they were after the first round (" + String(StzEngineGpuCounter(8)) + " of " + String(nFlat) + ")", StzEngineGpuCounter(8) = nFlat)
	witness("WINDOWS counts no more after three losses than after round 1: at most " + Mb(nW4Max) + " against " + Mb($nW1) + " (a lost device's memory did not stay behind)", nW4Max <= $nW1 + 16 * $nMB)
	? "  (scene 4: " + Secs($nT0) + " s)"

	? ""
	? "-- Scene 5: the witness itself: it sees an upload, and freed uploads come back --"
	$nT0 = Clock()
	nLive5 = StzEngineGpuCounter(8)
	nWa = StzEngineGpuProcessMemory(0)
	# the GPU allocator suballocates from blocks it has already reserved, so ONE buffer can fit in room the device
	# already holds (measured: a 64 MB upload moved nothing after the rounds above, and +64 MB on a fresh device).
	# Four held at once, 256 MB, exceed that room: the witness must see at least half of it.
	vBufs = []
	for k = 1 to 4
		nBuf = StzEngineGpuBufferNew(64 * $nMB)
		StzEngineGpuBufferFillLcg(nBuf, 16 * $nMB, 7 + k)
		vBufs + nBuf
	end
	StzEngineGpuSync()
	nWb = StzEngineGpuProcessMemory(0)
	for k = 1 to 4
		StzEngineGpuBufferFree(vBufs[k])
	end
	StzEngineGpuSync()
	nWc = StzEngineGpuProcessMemory(0)
	? "  four 64 MB buffers held at once: the witness " + Mb(nWa) + " -> " + Mb(nWb) + " while held, " + Mb(nWc) + " after they are freed"
	witness("the negative sibling: WINDOWS SEES the engine's uploads (four 64 MB buffers held raised the card's count by " + Mb(nWb - nWa) + ", at least 128 MB), so a climb in the checks above would have been seen", nWb - nWa >= 128 * $nMB)
	# six cycles of upload and free with NO op between: before e89ea8f07 nothing submitted the staged writes, and the
	# card's count climbed 324 -> 580 -> 708 -> 708 -> 1,092 -> 1,092 MB while the engine counted 0 live buffers
	nWMin = -1
	nWMax = 0
	tCycles = ""
	for nCycle = 1 to 6
		nBuf = StzEngineGpuBufferNew(64 * $nMB)
		StzEngineGpuBufferFillLcg(nBuf, 16 * $nMB, 7 + nCycle)
		StzEngineGpuSync()
		StzEngineGpuBufferFree(nBuf)
		StzEngineGpuSync()
		nW = StzEngineGpuProcessMemory(0)
		tCycles += Mb(nW) + " "
		if nWMin < 0 or nW < nWMin
			nWMin = nW
		end
		nWMax = Bigger(nWMax, nW)
	end
	? "  six cycles of a 64 MB upload freed with no op between, the witness after each: " + tCycles
	witness("WINDOWS counts the six upload-and-free cycles flat (" + Mb(nWMin) + " to " + Mb(nWMax) + "): Sync sends a staged upload, so a freed buffer and its staging copy go back", nWMax - nWMin <= 16 * $nMB)
	chk("...and the engine counts the same live buffers as before the scene (" + String(StzEngineGpuCounter(8)) + " of " + String(nLive5) + ")", StzEngineGpuCounter(8) = nLive5)
	? "  (scene 5: " + Secs($nT0) + " s)"
end

? ""
? "=========================================="
? "TOTAL: " + String($nPass + $nFail) + " assertions, " + String($nPass) + " pass, " + String($nFail) + " fail, " + String($nSkip) + " skipped"
? "=========================================="

Shutdown($nFail)

func chk(tLabel, bCond)
	if bCond
		$nPass++
		? "  [OK] " + tLabel
	else
		$nFail++
		? "  [FAIL] " + tLabel
	end
end

# a check made by the outside witness: skipped by name where Windows gives no reading, never passed
func witness(tLabel, bCond)
	if not $bWitness
		$nSkip++
		? "  [SKIPPED] (no reading from Windows) " + tLabel
	else
		chk(tLabel, bCond)
	end
end

func Mb(nB)
	if nB < 0
		return "n/a"
	end
	return String(Floor(nB * 10 / $nMB) / 10) + " MB"
end

func Secs(nT0)
	return String(Floor((Clock() - nT0) * 10 / ClocksPerSecond()) / 10)
end

func Pick(bCond, xYes, xNo)
	if bCond
		return xYes
	end
	return xNo
end

# the whole part of a quotient, exact: a .haro quotient with no exact decimal is refused
func IntDiv(nA, nB)
	return (nA - nA % nB) / nB
end

func Bigger(nA, nB)
	return Pick(nA > nB, nA, nB)
end

func Smaller(nA, nB)
	return Pick(nA < nB, nA, nB)
end

func Yn(bCond)
	return Pick(bCond, "1", "0")
end

func _ReleaseScratch
	StzEngineGpuCompactRelease()
	StzEngineGpuSortRelease()
	StzEngineGpuSegScanRelease()
end

# One pass over every compute module, small inputs whose answers are known exactly:
# returns [ the answers as one text, whether every one is as expected, the flags, the checker's verdict ]
func _Round(oG)
	tAns = ""
	# the fft op: a convolution of whole numbers
	xC = oG.ConvolveReal([ 1, 2, 3 ], [ 4, 5 ])
	bC = (Len(xC) = 4 and Abs(xC[1] - 4) < 0.01 and Abs(xC[2] - 13) < 0.01 and Abs(xC[3] - 22) < 0.01 and Abs(xC[4] - 15) < 0.01)
	tAns += "conv " + _Round1(xC) + "; "
	# the checker: a tiny kernel against itself, verified
	tSpec = "in a" + Char(10) + "out c" + Char(10) + "body { @c = @a * 2 + 1 }"
	xK = StzKernelMakerFromSpec(tSpec)
	xV = oG.VerifySpecWith(xK, xK, [ [ "a", _Seq(1000) ] ], [ [ "n", 1000 ] ])
	bV = (xV[:verdict] = "verified" or xV[:verdict] = "impossible")
	# the scan: 70,000 ones is the ramp
	vOnes = []
	for i = 1 to 70000
		vOnes + 1
	end
	xS = oG.Scan(vOnes)
	bS = (xS[1] = 1 and xS[256] = 256 and xS[257] = 257 and xS[70000] = 70000)
	tAns += "scan " + String(xS[70000]) + "; "
	# compaction: the elements above 3 of 0..6 repeated
	vIn = []
	for i = 1 to 70000
		vIn + ((i * 5) % 7)
	end
	xK = oG.CompactWhere(vIn, ">", 3)
	nKeep = 0
	for i = 1 to 70000
		if vIn[i] > 3
			nKeep++
		end
	end
	bK = (Len(xK) = nKeep and xK[1] > 3 and xK[Len(xK)] > 3)
	tAns += "compact " + String(Len(xK)) + "; "
	# the sort: 70,000 keys with ties, ordered afterwards
	xT = oG.Sort(vIn)
	bT = (Len(xT) = 70000 and xT[1] = 0 and xT[70000] = 6)
	for i = 2 to 70000 step 997
		if xT[i] < xT[i - 1]
			bT = false
		end
	end
	tAns += "sort " + String(xT[1]) + "-" + String(xT[70000]) + "; "
	# the segmented reduction: segments of 100 ones sum to 100 each
	vFl = []
	for i = 1 to 70000
		vFl + Pick(i % 100 = 1, 1, 0)
	end
	xR = oG.SegmentedReduce(vOnes, vFl, "sum")
	bR = (Len(xR) = 700 and xR[1] = 100 and xR[700] = 100)
	tAns += "segreduce " + String(Len(xR)) + "x" + String(xR[1]) + "; "
	# the sparse product: the identity of 50 rows times a ramp is the ramp
	vRp = []
	vCo = []
	vVa = []
	vX = []
	for i = 0 to 49
		vRp + i
		vCo + i
		vVa + 1
		vX + (i + 1)
	end
	vRp + 50
	xP = oG.Spmv(vRp, vCo, vVa, vX)
	bP = (Len(xP) = 50 and xP[1] = 1 and xP[50] = 50)
	tAns += "spmv " + String(xP[50])
	tFlags = "conv=" + Yn(bC) + " verify=" + Yn(bV) + " scan=" + Yn(bS) + " compact=" + Yn(bK) + " sort=" + Yn(bT) + " segreduce=" + Yn(bR) + " spmv=" + Yn(bP)
	return [ tAns, (bC and bV and bS and bK and bT and bR and bP), tFlags, xV[:verdict] ]
end

func _Round1(xList)
	tOut = ""
	for i = 1 to Len(xList)
		tOut += String(Floor(xList[i] + 0.5)) + " "
	end
	return tOut
end

func _Seq(nN)
	vOut = []
	for i = 0 to nN - 1
		vOut + i
	end
	return vOut
end
