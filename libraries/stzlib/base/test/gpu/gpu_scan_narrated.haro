# GB0 -- THE SCAN, the library layer's first op (SOFTANZA_GPU_PLAN.md, GB0).
#
# out[i] = in[0] + ... + in[i] (inclusive) or in[0] + ... + in[i-1] (exclusive),
# over n f32s, entirely on the device: every group of 256 scans its block in
# workgroup memory, the block totals are scanned one level up until one group
# holds them, and the scanned totals are added back down. 2 * levels - 1
# dispatches in ONE submit; the data is never read back in between.
#
# Parity discipline, as the op library's guard states it:
#   - EXACT WITNESSES first: whole numbers whose every partial is exact in
#     f32 (below 2^24), at sizes that cross each level (1, 255, 256, 257,
#     65536, 65537, 1,000,003): the device must equal the sequential scan to
#     the BIT, whatever the tree.
#   - a TOLERANCE BAND second, on data whose partials round: the order is a
#     fixed tree, not left to right, so the band is SET FROM MEASUREMENT.
#   - NEGATIVE SIBLINGS: wrong sizes, the same buffer twice, a freed buffer,
#     an unknown mode, no device -- and the happy path counts ZERO fallbacks.
#
# Run with haro: haro gpu_scan_narrated.haro

load "../../stzBase.ring"

$nPass = 0
$nFail = 0
$nSkip = 0

pr()

$nStzPlaces = 10

nS_OK = 0
nS_FALLBACK = 1
iS_STALE = 2
iS_BADARG = 3

? "-- Scene 0: the op refuses the fallback way before there is a device --"
chk("a scan before Init answers FALLBACK", _C(StzEngineGpuOpScan(1, 2, 100, 0), "=", nS_FALLBACK))

oG = new stzGpu
bDevice = oG.IsAvailable()
if not bDevice
	? "  NO GPU ON THIS MACHINE -- the scenes below need a device; the fallback scene above is the CI coverage"
else
	? "  device: [" + _T(StzEngineGpuSelectedAdapter()) + "] " + _T(StzEngineGpuAdapterName(StzEngineGpuSelectedAdapter()))

	? ""
	? "-- Scene 1: exact witnesses, whole numbers, across every level --"
	$nT0 = Clock()
	StzEngineGpuCountersReset()
	for nN in [ 1, 255, 256, 257, 65536, 65537, 1000003 ]
		vIn = []
		for i = 1 to nN
			vIn + ((i * 5) % 7)
		end
		nHI = StzEngineGpuBufferNew(_A(nN, "*", 4))
		nHO = StzEngineGpuBufferNew(_A(nN, "*", 4))
		StzEngineGpuBufferUploadList(nHI, vIn)
		nStI = StzEngineGpuOpScan(nHI, nHO, nN, 0)
		xOut = StzEngineGpuBufferDownloadList(nHO, nN)
		bSame = (nStI = nS_OK and _C(Len(xOut), "=", nN))
		nRun = 0
		for i = 1 to nN
			nRun = _A(nRun, "+", vIn[i])
			if _C(xOut[i], "!=", nRun)
				bSame = false
				? "  first difference at " + _T(i) + ": " + _T(xOut[i]) + " against " + _T(nRun)
				exit
			end
		end
		chk("inclusive, n = " + _T(nN) + " (" + _T(StzEngineGpuScanDispatches(nN)) + " dispatches): every element equals the sequential scan to the bit", bSame)
		nStE = StzEngineGpuOpScan(nHI, nHO, nN, 1)
		xOut = StzEngineGpuBufferDownloadList(nHO, nN)
		bSame = (nStE = nS_OK and _C(Len(xOut), "=", nN))
		nRun = 0
		for i = 1 to nN
			if _C(xOut[i], "!=", nRun)
				bSame = false
				? "  first difference at " + _T(i) + ": " + _T(xOut[i]) + " against " + _T(nRun)
				exit
			end
			nRun = _A(nRun, "+", vIn[i])
		end
		chk("exclusive, n = " + _T(nN) + ": every element equals the sequential scan, shifted, to the bit", bSame)
		StzEngineGpuBufferFree(nHI)
		StzEngineGpuBufferFree(nHO)
	end
	chk("the happy path counted zero fallbacks", _C(StzEngineGpuCounter(3), "=", 0))
	? "  (scene 1: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"

	? ""
	? "-- Scene 2: the shift is exact inside a block, and the band holds where partials round --"
	$nT0 = Clock()
	nN = 100000
	vIn = []
	for i = 1 to nN
		vIn + (_A(_Q(((i * 37) % 1000), 1000.0), "+", 0.001))
	end
	nHI = StzEngineGpuBufferNew(_A(nN, "*", 4))
	nHInc = StzEngineGpuBufferNew(_A(nN, "*", 4))
	nHExc = StzEngineGpuBufferNew(_A(nN, "*", 4))
	StzEngineGpuBufferUploadList(nHI, vIn)
	StzEngineGpuOpScan(nHI, nHInc, nN, 0)
	StzEngineGpuOpScan(nHI, nHExc, nN, 1)
	xInc = StzEngineGpuBufferDownloadList(nHInc, nN)
	xExc = StzEngineGpuBufferDownloadList(nHExc, nN)
	xUp = StzEngineGpuBufferDownloadList(nHI, nN)
	bShift = true
	nChecked = 0
	for i = 2 to nN
		if _C((i - 1) % 256, "!=", 0)
			nChecked++
			if _C(xExc[i], "!=", xInc[i - 1])
				bShift = false
			end
		end
	end
	chk("exclusive[i] equals inclusive[i - 1] to the bit at every position inside a block (" + _T(nChecked) + " of them, on data whose partials round)", bShift and _C(xExc[1], "=", 0))
	nRun = 0
	nMaxRel = 0
	nMaxRelExc = 0
	for i = 1 to nN
		nRef = nRun
		nRun = _A(nRun, "+", xUp[i])
		nR = _Q(_StzAbs(_A(xInc[i], "-", nRun)), nRun)
		if _C(nR, ">", nMaxRel)
			nMaxRel = nR
		end
		if _C(nRef, ">", 0)
			nR = _Q(_StzAbs(_A(xExc[i], "-", nRef)), nRef)
			if _C(nR, ">", nMaxRelExc)
				nMaxRelExc = nR
			end
		end
	end
	? "  measured max relative error against the f64 scan of the uploaded values, n = 100000: inclusive " + _T(nMaxRel) + ", exclusive " + _T(nMaxRelExc)
	chk("band: inclusive relative error < 1e-5 (the band is set from the measurement printed above)", _C(nMaxRel, "<", 0.00001))
	chk("band: exclusive relative error < 1e-5", _C(nMaxRelExc, "<", 0.00001))
	StzEngineGpuBufferFree(nHI)
	StzEngineGpuBufferFree(nHInc)
	StzEngineGpuBufferFree(nHExc)
	? "  (scene 2: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"

	? ""
	? "-- Scene 3: one submit, 2 * levels - 1 dispatches, no buffer left behind --"
	nN = 100000
	nHI = StzEngineGpuBufferNew(_A(nN, "*", 4))
	nHO = StzEngineGpuBufferNew(_A(nN, "*", 4))
	vOnes = []
	for i = 1 to nN
		vOnes + 1
	end
	StzEngineGpuBufferUploadList(nHI, vOnes)
	StzEngineGpuSync()
	nD0 = StzEngineGpuCounter(0)
	nS0 = StzEngineGpuCounter(6)
	nL0 = StzEngineGpuCounter(8)
	nF0 = StzEngineGpuCounter(3)
	StzEngineGpuOpScan(nHI, nHO, nN, 0)
	StzEngineGpuSync()
	chk("a scan of 100,000 is " + _T(StzEngineGpuScanDispatches(nN)) + " dispatches (the counter says " + _T((_A(StzEngineGpuCounter(0), "-", nD0))) + ")", _C(_A(StzEngineGpuCounter(0), "-", nD0), "=", StzEngineGpuScanDispatches(nN)) and _C(StzEngineGpuScanDispatches(nN), "=", 5))
	chk("...in ONE queue submit (the counter says " + _T((_A(StzEngineGpuCounter(6), "-", nS0))) + ")", _C(_A(StzEngineGpuCounter(6), "-", nS0), "=", 1))
	chk("...the work buffers are gone (live buffers " + _T(nL0) + " before, " + _T(StzEngineGpuCounter(8)) + " after)", _C(StzEngineGpuCounter(8), "=", nL0))
	chk("...and nothing fell back", _C(StzEngineGpuCounter(3), "=", nF0))
	xOut = StzEngineGpuBufferDownloadList(nHO, nN)
	chk("a scan of ones is the ramp 1 .. 100000", _C(xOut[1], "=", 1) and _C(xOut[256], "=", 256) and _C(xOut[257], "=", 257) and _C(xOut[nN], "=", nN))
	chk("the dispatch counts: 1 up to 256, 3 up to 65,536, 5 up to 16,777,216, 7 past it",
		_C(StzEngineGpuScanDispatches(256), "=", 1) and _C(StzEngineGpuScanDispatches(257), "=", 3) and _C(StzEngineGpuScanDispatches(65536), "=", 3) and _C(StzEngineGpuScanDispatches(65537), "=", 5) and _C(StzEngineGpuScanDispatches(16777217), "=", 7))

	? ""
	? "-- Scene 4: what it refuses --"
	chk("n = 0 is BAD_ARG", _C(StzEngineGpuOpScan(nHI, nHO, 0, 0), "=", iS_BADARG))
	chk("an unknown mode is BAD_ARG", _C(StzEngineGpuOpScan(nHI, nHO, nN, 2), "=", iS_BADARG))
	chk("the same buffer twice is BAD_ARG (WebGPU aliasing validation)", _C(StzEngineGpuOpScan(nHI, nHI, nN, 0), "=", iS_BADARG))
	chk("an output too small is BAD_ARG", _C(StzEngineGpuOpScan(nHI, nHO, _A(nN, "+", 1), 0), "=", iS_BADARG))
	StzEngineGpuBufferFree(nHO)
	chk("a freed output answers STALE", _C(StzEngineGpuOpScan(nHI, nHO, nN, 0), "=", iS_STALE))
	StzEngineGpuBufferFree(nHI)

	? ""
	? "-- Scene 5: the face, a list in and a list out --"
	xS = oG.Scan([ 3, 1, 4, 1, 5, 9, 2, 6 ])
	xE = oG.ScanExclusive([ 3, 1, 4, 1, 5, 9, 2, 6 ])
	chk("Scan([3 1 4 1 5 9 2 6]) = [3 4 8 9 14 23 25 31]", @@(xS) = "[ 3, 4, 8, 9, 14, 23, 25, 31 ]")
	chk("ScanExclusive of the same = [0 3 4 8 9 14 23 25]", @@(xE) = "[ 0, 3, 4, 8, 9, 14, 23, 25 ]")
	tErr = ""
	try
		oG.Scan([])
	catch
		tErr = cCatchError
	end
	chk("an empty list is refused by name (" + Left(tErr, 50) + ")", _C(StzFindFirst("non-empty list", tErr), ">", 0))

	? ""
	? "-- Scene 6: how fast, against the same bytes moved by a scale pass --"
	$nT0 = Clock()
	nN = 16000000
	nHI = StzEngineGpuBufferNew(_A(nN, "*", 4))
	nHO = StzEngineGpuBufferNew(_A(nN, "*", 4))
	if _C(nHI, "=", 0) or _C(nHO, "=", 0)
		? "  (no room for two 64 MB buffers: scene skipped)"
	else
		oG.Wake(400)
		StzEngineGpuSync()
		nBestScan = 1000000
		nBestScale = 1000000
		nPer = 10
		for nRep = 1 to 5
			StzEngineGpuSync()
			nT = Clock()
			for q = 1 to nPer
				StzEngineGpuOpScan(nHI, nHO, nN, 0)
			end
			StzEngineGpuSync()
			nMs = _Q(_A(_Q((_A(Clock(), "-", nT)), ClocksPerSecond()), "*", 1000), nPer)
			if _C(nMs, "<", nBestScan)
				nBestScan = nMs
			end
			StzEngineGpuSync()
			nT = Clock()
			for q = 1 to nPer
				StzEngineGpuOpScaleInPlace(nHI, 1.0, nN)
			end
			StzEngineGpuSync()
			nMs = _Q(_A(_Q((_A(Clock(), "-", nT)), ClocksPerSecond()), "*", 1000), nPer)
			if _C(nMs, "<", nBestScale)
				nBestScale = nMs
			end
		end
		nBytes = _A(_A(nN, "*", 4), "*", 2)
		nGbsScan = _Q(_Q(nBytes, (_Q(nBestScan, 1000))), 1000000000)
		nGbsScale = _Q(_Q(nBytes, (_Q(nBestScale, 1000))), 1000000000)
		? "  16,000,000 floats, " + _T(StzEngineGpuScanDispatches(nN)) + " dispatches, ten to a sync: scan " + _T(nBestScan) + " ms (" + _T(nGbsScan) + " GB/s counting the minimum read + write), scale " + _T(nBestScale) + " ms (" + _T(nGbsScale) + " GB/s)"
		? "  the scan reaches " + _T((_Q(nGbsScan, nGbsScale))) + " of what a scale pass over the same bytes reaches (it moves twice the minimum: the offsets pass reads and writes every element again)"
		chk("the scan runs at more than a tenth of the bandwidth a scale pass reaches (measured above; the floor is a sanity line, not a goal)", _C(_Q(nGbsScan, nGbsScale), ">", 0.1))
	end
	StzEngineGpuBufferFree(nHI)
	StzEngineGpuBufferFree(nHO)
	? "  (scene 6: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"

	? ""
	? "-- Scene 7: the route -- the loop against the device through the face, measured, stored, followed --"
	$nT0 = Clock()
	xCal = oG.CalibrateScan()
	? "  adapter " + _T(xCal[:adapter]) + ", flat line at " + _T(xCal[:flat]) + " (" + _T(xCal[:flatwhy]) + ")"
	for xCell in xCal[:cells]
		? "  n = " + _T(xCell[2]) + ": loop " + _T(xCell[3]) + " ms, face " + _T(xCell[4]) + " ms, ratio " + _T(xCell[5])
	end
	if xCal[:confounded]
		# the control rung moved by more than 2x: another process held the machine, the store refused the line,
		# and a route that was never stored cannot be followed. A gate that could not run says so; it is not a pass
		$nSkip++
		? "  [SKIPPED] the route checks: the machine was too loaded for a stable measurement (the control rung moved more than 2x), so nothing was stored; run this guard again on a quiet machine"
	else
		chk("the control rung (the first, measured again at the end) stayed within 2x, so the line is stored", not xCal[:confounded])
		bFollow = true
		for xCell in xCal[:cells]
			bWin = (_C(xCell[5], ">=", 1.3))
			if (_C(StzEngineGpuCalibRouteShaped("scan", xCell[2], 1), "=", 1)) != bWin
				bFollow = false
			end
		end
		chk("the route sends a size to the device exactly where its measured ratio reached 1.3, at every rung", bFollow)
		chk("the smallest rung stays on the loop and the largest goes to the device on this machine (the face costs about 0.15 ms before it scans)",
			_C(xCal[:cells][1][5], "<", 1.3) and _C(xCal[:cells][ring_len(xCal[:cells])][5], ">=", 1.3))
		vNum = []
		for i = 1 to 200000
			vNum + ((i * 5) % 7)
		end
		xR = oG.ScanRouted(vNum)
		xG = oG.Scan(vNum)
		chk("ScanRouted gives the same running total whichever side it ran on (200,000 whole numbers, to the bit)", _C(@@(xR), "=", @@(xG)))
		xRE = oG.ScanExclusiveRouted([ 3, 1, 4 ])
		chk("a short list stays on the loop and ScanExclusiveRouted answers [0 3 4]", @@(xRE) = "[ 0, 3, 4 ]" and _C(StzEngineGpuCalibRouteShaped("scan", 3, 1), "=", 0))
	end
	? "  (scene 7: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"
end

? ""
? "-- Scene 8: puzzle 20, the running total of a group --"
$nT0 = Clock()
tNL = Char(10)
oQ = StzKernelPuzzleQ("kp-20")
chk("the starter grades 'waiting for your implementation'", oQ.Grade(oQ.Starter()) = "waiting for your implementation")
chk("the task reads in four languages and ends with what the GPU did differently from a loop",
	oQ.Task("en") != "" and oQ.Task("fr") != "" and oQ.Task("ar") != "" and oQ.Task("ha") != "" and _C(StzFindFirst("differently from a loop", oQ.Task("en")), ">", 0) and _C(StzFindFirst("block step of the library", oQ.Task("en")), ">", 0))
tLoad = "in a" + tNL + "out c" + tNL + "shared t 256" + tNL + "stage { @t[@l] = @a }" + tNL
tTwo = "in a" + tNL + "out c" + tNL + "shared t 256" + tNL + "shared u 256" + tNL + "stage { @t[@l] = @a }" + tNL + "tiles s { N }" + tNL + "stage { @u[@l] = @t[@l] + @t[@l - pow(2, s)] }" + tNL + "stage { @t[@l] = @u[@l] }" + tNL + "body { @c = @t[@l] }"
# the verdicts were worked out from the data (a is (i * 7) % 13: 0, 7, 1, 8, 2 ... so a[0] = 0) before the first run:
#   exclusive:   element 1 is 0 either way; element 2 owes a[0] + a[1] = 7 and gets a[0] = 0
#   no restart:  the second group starts at element 257, which owes a[256] alone
#   7 steps:     reaches 128 places back; thread 128 owes 129 numbers and is missing a[0], which is 0,
#                so element 129 coincides and element 130 is the first wrong one
vCases = [
	[ tLoad + "body { @c = sum(j, 0, 256, when(j <= @l, @t[j], 0)) }", "verified" ],
	[ StzReplace(tTwo, "N", "8"), "verified" ],
	[ tLoad + "body { @c = sum(j, 0, 256, when(j < @l, @t[j], 0)) }", "mismatch at element 2" ],
	[ "in a" + tNL + "out c" + tNL + "body { @c = sum(j, 0, @i + 1, @a[j]) }", "mismatch at element 257" ],
	[ StzReplace(tTwo, "N", "7"), "mismatch at element 130" ]
]
nAgree = 0
for vQ in vCases
	if bDevice
		tV = oQ.Grade(vQ[1])
	else
		tV = oQ.GradeOnCpu(vQ[1])
	end
	chk(_T(Replace(Replace(vQ[1], tNL, " / "), "in a / out c / ", "")) + " -> " + _T(vQ[2]) + " (" + tV + ")", tV = vQ[2])
	if _C(oQ.GradeOnCpu(vQ[1]), "=", vQ[2])
		nAgree++
	end
end
chk("GradeOnCpu says the same words for all " + _T(Len(vCases)) + " cases", _C(nAgree, "=", Len(vCases)))
tV = oQ.Grade("in a" + tNL + "out c" + tNL + "shared t 256" + tNL + "stage { @t[@l] = @t[@l] + @t[@l - 1] }" + tNL + "body { @c = @t[@l] }")
chk("a stage that reads the array it writes is refused by name (" + Left(tV, 60) + ")", _C(StzFindFirst("refused", tV), "=", 1) and _C(StzFindFirst("cannot read the array it writes", tV), ">", 0))
if bDevice
	oE = StzExerciseQ("../../education/program/courses/kernel-puzzles/exercises/kp-20")
	# the parent lets go of the card first: since the GPU lease (2026-11-14) the graders ProveItself starts
	# cannot take it from their own parent, and would wait and answer "waiting for the device" (KP-PROVE-FLAKE)
	StzEngineGpuShutdown()
	xPr = oE.ProveItself()
	chk("the exercise proves itself through the System's checker: wrong refused " + _T(xPr[:wrong]) + ", right accepted " + _T(xPr[:right]) + ", failures " + _T(@@(xPr[:failures])),
		_C(xPr[:wrong], "=", 5) and _C(xPr[:right], "=", 2) and _C(Len(xPr[:failures]), "=", 0))
end
? "  (scene 8: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"

? ""
? "=========================================="
? "TOTAL: " + _T((_A($nPass, "+", $nFail))) + " assertions, " + _T($nPass) + " pass, " + _T($nFail) + " fail" + ", " + _T($nSkip) + " skipped"
? "=========================================="

pfq()
Shutdown($nFail)

func chk(tLabel, xCond)
	if _StzB(xCond)
		$nPass++
		? "  [OK] " + tLabel
	else
		$nFail++
		? "  [FAIL] " + tLabel
	end
end

# A value as text, as the guard's narration writes it: a text as it is, a whole number plainly, any other number
# to $nStzPlaces places, rounded half away from zero. (The library's one-argument Text and Round shadow the built-ins.)
func _T(xV)
	if IsString(xV)
		return xV
	end
	if not IsNumber(xV)
		return String(xV)
	end
	tS = String(xV)
	nLen = Len(tS)
	bPlain = true
	for k = 1 to nLen
		tC = tS[k]
		if tC = "n" or tC = "i"
			return tS
		end
		if tC = "." or tC = "e" or tC = "E"
			bPlain = false
		end
	end
	if bPlain
		return tS
	end
	nP = $nStzPlaces
	nScale = 1
	for k = 1 to nP
		nScale = nScale * 10
	end
	fV = Float(xV)
	bNeg = fV < Float(0)
	if bNeg
		fV = Float(0) - fV
	end
	nI = Floor(fV * Float(nScale) + 0.5f)
	if nP = 0
		tR = String(nI)
	else
		nW = _Q((nI - nI % nScale), nScale)
		tF = String(nI % nScale)
		while Len(tF) < nP
			tF = "0" + tF
		end
		tR = String(nW) + "." + tF
	end
	if bNeg and nI != 0
		tR = "-" + tR
	end
	return tR
end

# A condition as true or false: a 1 or 0 from older code, or a boolean.
func _StzB(xV)
	if IsNumber(xV)
		return xV != 0
	end
	return xV
end

# The absolute value of any number: exact for an integer or a decimal, a float for a float.
func _StzAbs(xV)
	try
		if xV < 0
			return 0 - xV
		end
		return xV
	catch e
		fV = Float(xV)
		if fV < Float(0)
			return Float(0) - fV
		end
		return fV
	end
end

# A quotient as the older code took it: exact when one exists; otherwise, taken through floats, a float.
func _Q(xA, xB)
	try
		return xA / xB
	catch e
	end
	return _StzF(xA) / _StzF(xB)
end

# A comparison as the older code made it, where every number was of one kind: the comparison itself when both
# sides are of one kind; otherwise both sides as floats, equal when neither is below the other, and a NaN equal
# to nothing.
func _C(xA, tOp, xB)
	try
		if tOp = "="
			return xA = xB
		end
		if tOp = "!="
			return xA != xB
		end
		if tOp = "<"
			return xA < xB
		end
		if tOp = ">"
			return xA > xB
		end
		if tOp = "<="
			return xA <= xB
		end
		return xA >= xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	bNaN = _StzNaN(fA) or _StzNaN(fB)
	if tOp = "="
		return not bNaN and not (fA < fB) and not (fA > fB)
	end
	if tOp = "!="
		return bNaN or fA < fB or fA > fB
	end
	if bNaN
		return false
	end
	if tOp = "<"
		return fA < fB
	end
	if tOp = ">"
		return fA > fB
	end
	if tOp = "<="
		return not (fA > fB)
	end
	return not (fA < fB)
end

# A number, or a true or false, as a float (the older code read a true as 1).
func _StzF(xV)
	if IsNumber(xV)
		if _StzIsFloat(xV)
			return xV
		end
		return Float(String(xV))
	end
	if xV
		return 1.0f
	end
	return 0.0f
end

# True for a NaN, read from its text.
func _StzNaN(xV)
	if not IsNumber(xV)
		return false
	end
	tS = String(xV)
	return tS = "nan" or tS = "-nan"
end

# True for a float: an integer or a decimal takes a zero added, a float refuses it.
func _StzIsFloat(xV)
	if not IsNumber(xV)
		return false
	end
	try
		xT = xV + 0
		return false
	catch e
		return true
	end
end

# Arithmetic as the older code did it, where every number was of one kind: the operation itself when both sides
# are of one kind; otherwise both sides as floats.
func _A(xA, tOp, xB)
	try
		if tOp = "+"
			return xA + xB
		end
		if tOp = "-"
			return xA - xB
		end
		return xA * xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	if tOp = "+"
		return fA + fB
	end
	if tOp = "-"
		return fA - fB
	end
	return fA * fB
end
