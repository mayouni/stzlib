# The second process of gpu_lease_narrated.haro: it opens the GPU and writes what the lease said, one value a line,
# to the file STZ_LEASE_OUT names -- the device it got (1/0), the lease's outcome, the milliseconds it waited, the
# other holder's process id, whether it holds the lease, and the device's last error. With STZ_LEASE_EXIT=abrupt it
# ends WITHOUT closing the device, as a crashed process would, so the guard can show the OS drops the lease.
load "../../stzBase.ring"

nUp = StzEngineGpuInit($tStzGpuRuntime)
tR = String(nUp) + Char(10)
tR += String(StzEngineGpuLease(0)) + Char(10)
tR += String(StzEngineGpuLease(1)) + Char(10)
tR += String(StzEngineGpuLease(2)) + Char(10)
tR += String(StzEngineGpuLease(3)) + Char(10)
tR += StzEngineGpuLastError() + Char(10)
# With STZ_LEASE_GRADE=kp05-noguard it also grades kp-05's missing-guard mistake, the one only a device can see,
# and writes the verdict as a seventh line.
if SysGet("STZ_LEASE_GRADE") = "kp05-noguard"
	oMk = StzKernelMakerQ()
	oMk.TakesVector(:a)
	oMk.ReturnsVector(:c)
	oMk.WithoutGuard()
	oMk.ForEachElement("{ @c = @a * 2 }")
	tR += StzKernelPuzzleQ("kp-05").Grade(oMk) + Char(10)
end
Write(SysGet("STZ_LEASE_OUT"), tR)
if SysGet("STZ_LEASE_EXIT") != "abrupt"
	StzEngineGpuShutdown()
end
