# The RENDER lifecycle layer -- GR1 of the graphics plane
# (SOFTANZA_GRAPHICS_PLAN.md; rides the G1 lifecycle of the GPU plane).
#
# GR0 proved the vendored render surface needs no lifecycle surgery and
# measured where the budget goes (the PNG encoder, not the pass). GR1 is
# that proof as product: textures/targets in the SAME gen-keyed + VRAM
# discipline, a render-pipeline cache (1 compile + N hits, counted), a
# one-submit pass machine, de-padded readback, and the PNG/image codecs.
#
# This guard asserts the MECHANISMS, each with its negative sibling:
#   - the codecs work WITHOUT a device (encode->decode round-trip is a
#     cross-check of two independent implementations: our zlib chunks
#     out, stb_image's inflate+parser back in)
#   - fallback counts before Init and does NOT count after
#   - texture churn returns live count and VRAM accounting to baseline;
#     freed ids answer STALE by name
#   - the pipeline cache compiles ONCE per (text,fmt,blend); malformed
#     WGSL refuses AND counts a device error
#   - drawn pixels are EXACT (flat colors chosen to round-trip unorm8)
#   - readback de-pads correctly at a width whose row is NOT 256-aligned
#   - a 15-rect batch is BYTE-IDENTICAL to a CPU-computed reference
#     (the GR0 parity claim, now guarded through the product layer)
#   - a COMPUTE kernel writes the vertex buffer a RENDER pass consumes
#     (the composition witness through stz_gpu.dll, not the spike)
#   - eviction under a small budget crosses KINDS (oldest buffer evicted
#     to fit a texture), counted; big budget ⇒ zero evictions
#   - shutdown mid-pass is clean; re-Init restores service
#
# CI note: passes WITHOUT a GPU -- device scenes gate on IsAvailable();
# the fallback + codec scenes ARE the CI coverage.
#
# STANDALONE like gpu_lifecycle_narrated: loads only the engine bridge.

$tEngineDir = "../../../engine"
# the domain door (W7b) asks StzDomainWanted, which lives in stkRingLibs
load "../../../core/common/stkRingLibs.haro"
load "../../../engine/stz_gpu.haro"
$nStzPlaces = 2

$nPass = 0
$nFail = 0

# counter indices (documented in engine/stz_gpu.haro)
iC_BYTES = 2
iC_FALL  = 3
xC_SUB   = 6
iC_EVICT = 7
iC_LIVE  = 8
iC_ERR   = 9
iC_RPC   = 10
iC_RPH   = 11
iC_DRAW  = 12
iC_TLIVE = 13

# status codes
nS_OK = 0
nS_FALLBACK = 1
iS_STALE = 2
iS_BADARG = 3

# texture kinds
nK_TARGET = 0
nK_NEAREST = 1
iK_LINEAR = 2

# WGSL: flat/interpolated color pipeline (vmain/fmain, pos2+col4)
tWgslColor = 'struct VSOut { @builtin(position) pos: vec4<f32>, @location(0) col: vec4<f32> }' + Char(10) +
    '@vertex' + Char(10) +
    'fn vmain(@location(0) pos: vec2<f32>, @location(1) col: vec4<f32>) -> VSOut {' + Char(10) +
    '  var o: VSOut;' + Char(10) +
    '  o.pos = vec4<f32>(pos, 0.0, 1.0);' + Char(10) +
    '  o.col = col;' + Char(10) +
    '  return o;' + Char(10) +
    '}' + Char(10) +
    '@fragment' + Char(10) +
    'fn fmain(in: VSOut) -> @location(0) vec4<f32> { return in.col; }'

# WGSL: textured pipeline (pos2+uv2, group0 = texture+sampler)
tWgslTex = 'struct VSOut { @builtin(position) pos: vec4<f32>, @location(0) uv: vec2<f32> }' + Char(10) +
    '@vertex' + Char(10) +
    'fn vmain(@location(0) pos: vec2<f32>, @location(1) uv: vec2<f32>) -> VSOut {' + Char(10) +
    '  var o: VSOut;' + Char(10) +
    '  o.pos = vec4<f32>(pos, 0.0, 1.0);' + Char(10) +
    '  o.uv = uv;' + Char(10) +
    '  return o;' + Char(10) +
    '}' + Char(10) +
    '@group(0) @binding(0) var tex: texture_2d<f32>;' + Char(10) +
    '@group(0) @binding(1) var smp: sampler;' + Char(10) +
    '@fragment' + Char(10) +
    'fn fmain(in: VSOut) -> @location(0) vec4<f32> { return textureSample(tex, smp, in.uv); }'

? "-- Scene 1: the codecs live CPU-side -- no device, real bytes --"
StzEngineGpuCountersReset()
# a 3x2 image with exact byte values, encoded then decoded back
tSrc = ""
for i = 0 to 23
    tSrc += Char((i * 37) % 251)
end
tPng = StzEngineGpuPngEncode(3, 2, tSrc, 1)
chk("PNG bytes came back", _C(Len(tPng), ">", 8))
chk("PNG signature is real", _C(Ascii(SubStr(tPng, 1, 1)), "=", 137) and SubStr(tPng, 2, 3) = "PNG")
xImg = StzEngineGpuImageDecode(tPng)
chk("decode returns [w, h, bytes]", _C(Len(xImg), "=", 3))
if _C(Len(xImg), "=", 3)
    chk("width survives the round-trip", _C(xImg[1], "=", 3))
    chk("height survives the round-trip", _C(xImg[2], "=", 2))
    chk("pixels are BYTE-IDENTICAL through encode->decode", xImg[3] = tSrc)
end
chk("z6 also answers (opt-in knob), same pixels",
    _C(StzEngineGpuImageDecode(StzEngineGpuPngEncode(3, 2, tSrc, 6))[3], "=", tSrc))

? ""
? "-- Scene 2: before Init, render asks refuse and are COUNTED --"
chk("not available before Init", _C(StzEngineGpuIsAvailable(), "=", 0))
nF0 = StzEngineGpuCounter(iC_FALL)
chk("texture creation refuses (id 0)", _C(StzEngineGpuTextureNew(64, 64, nK_TARGET), "=", 0))
chk("RenderBegin refuses with FALLBACK", _C(StzEngineGpuRenderBegin(1, 0, 0, 0, 1), "=", nS_FALLBACK))
chk("pipeline compile refuses (id 0)", _C(StzEngineGpuRenderPipeline(tWgslColor, "2,4", 0), "=", 0))
chk("every refusal was counted", _C(StzEngineGpuCounter(iC_FALL), ">=", _A(nF0, "+", 3)))

? ""
? "-- Scene 3: Init against the vendored runtime --"
nInit = StzEngineGpuInit($tStzGpuRuntime)
? "  Init(" + $tStzGpuRuntime + ") = " + _T(nInit)
if _C(StzEngineGpuIsAvailable(), "=", 0)
    ? "  NO GPU ON THIS MACHINE -- device scenes skipped, scenes 1-2 ARE the coverage"
else
    StzEngineGpuCountersReset()

    ? ""
    ? "-- Scene 4: texture churn is exact, staleness answers by name --"
    nLive0 = StzEngineGpuCounter(iC_TLIVE)
    nVram0 = StzEngineGpuVramInUse()
    vTex = []
    for i = 1 to 20
        vTex + StzEngineGpuTextureNew(32, 32, nK_TARGET)
    end
    chk("20 targets live", _C(StzEngineGpuCounter(iC_TLIVE), "=", _A(nLive0, "+", 20)))
    chk("VRAM accounts 20*32*32*4", _C(StzEngineGpuVramInUse(), "=", _A(nVram0, "+", _A(_A(20 * 32, "*", 32), "*", 4))))
    chk("width reads back", _C(StzEngineGpuTextureWidth(vTex[1]), "=", 32))
    for i = 1 to 20
        StzEngineGpuTextureFree(vTex[i])
    end
    chk("live count returns to baseline", _C(StzEngineGpuCounter(iC_TLIVE), "=", nLive0))
    chk("VRAM accounting returns to baseline", _C(StzEngineGpuVramInUse(), "=", nVram0))
    chk("freed id answers STALE on free", _C(StzEngineGpuTextureFree(vTex[1]), "=", iS_STALE))
    chk("freed id answers -1 on width", _C(StzEngineGpuTextureWidth(vTex[1]), "=", -1))

    ? ""
    ? "-- Scene 5: the render-pipeline cache compiles ONCE per key --"
    nP1 = StzEngineGpuRenderPipeline(tWgslColor, "2,4", 0)
    chk("color pipeline compiled (id > 0)", _C(nP1, ">", 0))
    nP2 = StzEngineGpuRenderPipeline(tWgslColor, "2,4", 0)
    chk("same key returns the SAME id", _C(nP2, "=", nP1))
    chk("exactly 1 real compile", _C(StzEngineGpuCounter(iC_RPC), "=", 1))
    chk("and 1 cache hit", _C(StzEngineGpuCounter(iC_RPH), "=", 1))
    nErr0 = StzEngineGpuCounter(iC_ERR)
    chk("malformed WGSL refuses (id 0)", _C(StzEngineGpuRenderPipeline("@fragment fn broken(", "2,4", 0), "=", 0))
    chk("and the device error was counted", _C(StzEngineGpuCounter(iC_ERR), ">", nErr0))
    chk("malformed FORMAT refuses (id 0)", _C(StzEngineGpuRenderPipeline(tWgslColor, "9,x", 0), "=", 0))

    ? ""
    ? "-- Scene 6: a flat triangle lands EXACT pixels on a target --"
    nW = 64  nH = 48
    nHT = StzEngineGpuTextureNew(nW, nH, nK_TARGET)
    chk("target created", _C(nHT, ">", 0))
    # flat color (240,200,40) -- k/255 values round-trip unorm8 exactly
    xV = []
    xV + [-0.8, -0.8]  xV + [_Q(240, 255.0), _Q(200, 255.0), _Q(40, 255.0), 1]
    xV + [ 0.0,  0.9]  xV + [_Q(240, 255.0), _Q(200, 255.0), _Q(40, 255.0), 1]
    xV + [ 0.8, -0.8]  xV + [_Q(240, 255.0), _Q(200, 255.0), _Q(40, 255.0), 1]
    xFlat = []
    vRow2 = xV
    nRow2 = Len(vRow2)
    for iRow2 = 1 to nRow2
    	xRowV = vRow2[iRow2]
        vV3 = xRowV
        nV3 = Len(vV3)
        for iV3 = 1 to nV3
        	xV3e = vV3[iV3]
            xFlat + xV3e
        end
    end
    nHV = StzEngineGpuBufferNew(Len(xFlat) * 4)
    chk("vertex buffer created", _C(nHV, ">", 0))
    chk("vertex upload OK", StzEngineGpuBufferUploadList(nHV, xFlat) = nS_OK)
    nDraw0 = StzEngineGpuCounter(iC_DRAW)
    nSub0 = StzEngineGpuCounter(xC_SUB)
    chk("Begin opens the pass", StzEngineGpuRenderBegin(nHT, _Q(16, 255.0), _Q(20, 255.0), _Q(24, 255.0), 1) = nS_OK)
    chk("pass reports active", _C(StzEngineGpuRenderActive(), "=", 1))
    chk("draw encodes", StzEngineGpuRenderDraw(nP1, nHV, 0, 3, 0) = nS_OK)
    chk("End submits", StzEngineGpuRenderEnd() = nS_OK)
    chk("pass no longer active", _C(StzEngineGpuRenderActive(), "=", 0))
    chk("ONE submit for the whole pass", _C(StzEngineGpuCounter(xC_SUB), "=", _A(nSub0, "+", 1)))
    chk("draw was counted", _C(StzEngineGpuCounter(iC_DRAW), "=", _A(nDraw0, "+", 1)))
    tFrame = StzEngineGpuTargetRead(nHT)
    chk("readback returns w*h*4 bytes", _C(Len(tFrame), "=", _A(_A(nW, "*", nH), "*", 4)))
    chk("corner pixel = clear color EXACT", pxeq(tFrame, nW, 2, 2, 16, 20, 24))
    chk("triangle center = flat color EXACT", pxeq(tFrame, nW, nW/2, nH/2, 240, 200, 40))

    ? ""
    ? "-- Scene 7: PNG round-trip on REAL rendered pixels --"
    tP = StzEngineGpuPngEncode(nW, nH, tFrame, 1)
    xBack = StzEngineGpuImageDecode(tP)
    chk("decode gives the frame back byte-identical", _C(Len(xBack), "=", 3) and xBack[3] = tFrame)

    ? ""
    ? "-- Scene 8: textured quad samples EXACT texels (nearest) --"
    # 2x2 checker: (200,60,60) and (240,240,240)
    nHCk = StzEngineGpuTextureNew(2, 2, nK_NEAREST)
    tCk = Char(200)+Char(60)+Char(60)+Char(255) + Char(240)+Char(240)+Char(240)+Char(255) +
          Char(240)+Char(240)+Char(240)+Char(255) + Char(200)+Char(60)+Char(60)+Char(255)
    chk("checker upload OK", StzEngineGpuTextureWrite(nHCk, tCk) = nS_OK)
    chk("upload to a TARGET refuses BAD_ARG", _C(StzEngineGpuTextureWrite(nHT, tCk), "=", iS_BADARG))
    nPT = StzEngineGpuRenderPipeline(tWgslTex, "2,2", 0)
    chk("textured pipeline compiled", _C(nPT, ">", 0))
    # full-screen quad, uv 0..1 (v: 0 at top of target)
    vQ = []
    vQ + [-1.0, -1.0]  vQ + [0.0, 1.0]
    vQ + [ 1.0, -1.0]  vQ + [1.0, 1.0]
    vQ + [ 1.0,  1.0]  vQ + [1.0, 0.0]
    vQ + [-1.0, -1.0]  vQ + [0.0, 1.0]
    vQ + [ 1.0,  1.0]  vQ + [1.0, 0.0]
    vQ + [-1.0,  1.0]  vQ + [0.0, 0.0]
    vQF = []
    vRow4 = vQ
    nRow4 = Len(vRow4)
    for iRow4 = 1 to nRow4
    	xRowV = vRow4[iRow4]
        vV5 = xRowV
        nV5 = Len(vV5)
        for iV5 = 1 to nV5
        	xV3e = vV5[iV5]
            vQF + xV3e
        end
    end
    nHVQ = StzEngineGpuBufferNew(Len(vQF) * 4)
    StzEngineGpuBufferUploadList(nHVQ, vQF)
    StzEngineGpuRenderBegin(nHT, 0, 0, 0, 1)
    chk("textured draw encodes", StzEngineGpuRenderDraw(nPT, nHVQ, 0, 6, nHCk) = nS_OK)
    StzEngineGpuRenderEnd()
    tTex = StzEngineGpuTargetRead(nHT)
    # quadrant centers: TL texel (0,0)=A, TR=(1,0)=B, BL=(0,1)=B, BR=(1,1)=A
    chk("top-left quadrant = checker A", pxeq(tTex, nW, nW/4, nH/4, 200, 60, 60))
    chk("top-right quadrant = checker B", pxeq(tTex, nW, _A(3, "*", nW) / 4, nH/4, 240, 240, 240))
    chk("bottom-left quadrant = checker B", pxeq(tTex, nW, nW/4, _A(3, "*", nH) / 4, 240, 240, 240))
    chk("bottom-right quadrant = checker A", pxeq(tTex, nW, _A(3, "*", nW) / 4, _A(3, "*", nH) / 4, 200, 60, 60))

    ? ""
    ? "-- Scene 9: indexed draw reaches the same pixels --"
    # same full-screen quad as 4 unique verts + 6 u32 indices
    vQI = []
    vQI + [-1.0, -1.0]  vQI + [0.0, 1.0]
    vQI + [ 1.0, -1.0]  vQI + [1.0, 1.0]
    vQI + [ 1.0,  1.0]  vQI + [1.0, 0.0]
    vQI + [-1.0,  1.0]  vQI + [0.0, 0.0]
    vQIF = []
    vRow6 = vQI
    nRow6 = Len(vRow6)
    for iRow6 = 1 to nRow6
    	xRowV = vRow6[iRow6]
        vV7 = xRowV
        nV7 = Len(vV7)
        for iV7 = 1 to nV7
        	xV3e = vV7[iV7]
            vQIF + xV3e
        end
    end
    nHVI = StzEngineGpuBufferNew(Len(vQIF) * 4)
    StzEngineGpuBufferUploadList(nHVI, vQIF)
    nHIdx = StzEngineGpuBufferNew(6 * 4)
    chk("index upload OK", StzEngineGpuBufferUploadListU32(nHIdx, [0, 1, 2, 0, 2, 3]) = nS_OK)
    StzEngineGpuRenderBegin(nHT, 0, 0, 0, 1)
    chk("indexed draw encodes", StzEngineGpuRenderDrawIndexed(nPT, nHVI, nHIdx, 6, nHCk) = nS_OK)
    StzEngineGpuRenderEnd()
    tIdxFrame = StzEngineGpuTargetRead(nHT)
    chk("indexed result matches the non-indexed frame byte-for-byte", tIdxFrame = tTex)

    ? ""
    ? "-- Scene 10: readback de-pads at a NON-256-aligned width --"
    # 63*4 = 252 bytes/row: the padded staging row is 256 -- a de-pad bug
    # would shear every row after the first
    nHT63 = StzEngineGpuTextureNew(63, 5, nK_TARGET)
    StzEngineGpuRenderBegin(nHT63, _Q(90, 255.0), _Q(140, 255.0), _Q(210, 255.0), 1)
    StzEngineGpuRenderEnd()
    tPx63 = StzEngineGpuTargetRead(nHT63)
    chk("tight length 63*5*4", _C(Len(tPx63), "=", _A(63 * 5, "*", 4)))
    bRows = true
    for y = 0 to 4
        if not (pxeq(tPx63, 63, 0, y, 90, 140, 210) and pxeq(tPx63, 63, 62, y, 90, 140, 210))
            bRows = false
        end
    end
    chk("first AND last pixel of EVERY row carry the clear color", bRows)
    StzEngineGpuTextureFree(nHT63)

    ? ""
    ? "-- Scene 11: 15-rect batch is BYTE-IDENTICAL to the CPU-computed reference --"
    nBW = 40  nBH = 30
    nHTB = StzEngineGpuTextureNew(nBW, nBH, nK_TARGET)
    # palette (exact u8 triples), rect = [x, y, w, h, palette index]
    vPal = [ [220,60,60], [60,180,90], [70,110,230], [235,200,60] ]
    vRects = [ [2,2,10,8,1], [8,5,12,10,2], [15,1,9,20,3], [0,20,18,8,4], [25,3,12,12,1],
               [30,15,9,9,2], [5,12,20,6,3], [22,22,14,7,4], [1,8,6,15,2], [33,0,7,26,1],
               [12,18,10,10,4], [18,9,8,8,1], [27,20,11,8,3], [3,25,30,4,2], [20,14,15,5,1] ]
    # GPU: 6 verts per rect, integer pixel corners -> NDC, painter order
    vBV = []
    vR8 = vRects
    nR8 = Len(vR8)
    for iR8 = 1 to nR8
    	vRc = vR8[iR8]
        fX0 = _A(_A(Float(vRc[1]) / Float(nBW), "*", 2.0f), "-", 1.0f)
        fX1 = _A(_A(Float(_A(vRc[1], "+", vRc[3])) / Float(nBW), "*", 2.0f), "-", 1.0f)
        fY0 = _A(1.0f, "-", _A(Float(vRc[2]) / Float(nBH), "*", 2.0f))
        fY1 = _A(1.0f, "-", _A(Float(_A(vRc[2], "+", vRc[4])) / Float(nBH), "*", 2.0f))
        vCol = vPal[vRc[5]]
        vPts = [ [fX0,fY0], [fX1,fY0], [fX1,fY1], [fX0,fY0], [fX1,fY1], [fX0,fY1] ]
        vP9 = vPts
        nP9 = Len(vP9)
        for iP9 = 1 to nP9
        	vPt = vP9[iP9]
            vBV + vPt[1]  vBV + vPt[2]
            vBV + (Float(vCol[1]) / 255.0f) vBV + (Float(vCol[2]) / 255.0f) vBV + (Float(vCol[3]) / 255.0f) vBV + 1
        end
    end
    nHVB = StzEngineGpuBufferNew(Len(vBV) * 4)
    StzEngineGpuBufferUploadList(nHVB, vBV)
    StzEngineGpuRenderBegin(nHTB, Float(16) / 255.0f, Float(20) / 255.0f, Float(24) / 255.0f, 1)
    StzEngineGpuRenderDraw(nP1, nHVB, 0, Len(vRects) * 6, 0)
    StzEngineGpuRenderEnd()
    tBatch = StzEngineGpuTargetRead(nHTB)
    # CPU reference: same painter order, per-pixel palette index
    xRef = List(_A(nBW, "*", nBH))
    for i = 1 to nBW * nBH
        xRef[i] = 0
    end
    vR10 = vRects
    nR10 = Len(vR10)
    for iR10 = 1 to nR10
    	vRc = vR10[iR10]
        for nDy = 0 to vRc[4] - 1
            nRow = _A((_A(vRc[2], "+", nDy)), "*", nBW)
            for nDx = 0 to vRc[3] - 1
                xRef[nRow + vRc[1] + nDx + 1] = vRc[5]
            end
        end
    end
    nMismatch = 0
    for i = 0 to nBW * nBH - 1
        nIdx = xRef[i + 1]
        if _C(nIdx, "=", 0)
            vCol = [16, 20, 24]
        else
            vCol = vPal[nIdx]
        end
        nOff = i * 4
        if _C(Ascii(SubStr(tBatch, _A(nOff, "+", 1), 1)), "!=", vCol[1]) or
           _C(Ascii(SubStr(tBatch, _A(nOff, "+", 2), 1)), "!=", vCol[2]) or
           _C(Ascii(SubStr(tBatch, _A(nOff, "+", 3), 1)), "!=", vCol[3])
            nMismatch++
        end
    end
    chk("0 mismatching pixels of " + _T((_A(nBW, "*", nBH))), _C(nMismatch, "=", 0))
    StzEngineGpuTextureFree(nHTB)

    ? ""
    ? "-- Scene 12: a COMPUTE kernel writes the verts a RENDER pass draws --"
    # the GR0 composition witness, through the product layer: one buffer,
    # Storage in the compute pass, Vertex in the render pass
    # NOTE: the kernel must READ the tile uniform, not merely declare it --
    # layout:"auto" drops unread bindings and the layer's bind group would
    # be invalid (the neural-backbone lesson, resurfacing on cue)
    tWgslGen = 'struct StzTile { xoff : u32, p0 : u32, p1 : u32, p2 : u32 }' + Char(10) +
        '@group(0) @binding(0) var<uniform> tile : StzTile;' + Char(10) +
        '@group(0) @binding(1) var<storage, read_write> v : array<f32>;' + Char(10) +
        '@compute @workgroup_size(1)' + Char(10) +
        'fn main() {' + Char(10) +
        '  if (tile.xoff != 0u) { return; }' + Char(10) +
        '  let r = 80.0/255.0; let g = 220.0/255.0; let b = 160.0/255.0;' + Char(10) +
        '  v[0] = -0.9; v[1] = -0.9; v[2] = r; v[3] = g; v[4] = b; v[5] = 1.0;' + Char(10) +
        '  v[6] =  0.0; v[7] =  0.9; v[8] = r; v[9] = g; v[10] = b; v[11] = 1.0;' + Char(10) +
        '  v[12] = 0.9; v[13] = -0.9; v[14] = r; v[15] = g; v[16] = b; v[17] = 1.0;' + Char(10) +
        '}'
    nKGen = StzEngineGpuKernelCompile(tWgslGen)
    chk("generator kernel compiled", _C(nKGen, ">", 0))
    nHVC = StzEngineGpuBufferNew(18 * 4)
    chk("compute dispatch over the vertex buffer", StzEngineGpuDispatch(nKGen, [nHVC], 1, 1) = nS_OK)
    StzEngineGpuRenderBegin(nHT, 0, 0, 0, 1)
    chk("render consumes the compute-written buffer", StzEngineGpuRenderDraw(nP1, nHVC, 0, 3, 0) = nS_OK)
    StzEngineGpuRenderEnd()
    tComp = StzEngineGpuTargetRead(nHT)
    chk("compute-authored triangle landed EXACT", pxeq(tComp, nW, nW/2, nH/2, 80, 220, 160))

    ? ""
    ? "-- Scene 13: refusals answer by NAME --"
    chk("draw outside a pass: BAD_ARG", _C(StzEngineGpuRenderDraw(nP1, nHV, 0, 3, 0), "=", iS_BADARG))
    chk("Begin on a SAMPLED texture: BAD_ARG", _C(StzEngineGpuRenderBegin(nHCk, 0, 0, 0, 1), "=", iS_BADARG))
    nHDead = StzEngineGpuBufferNew(72)
    StzEngineGpuBufferFree(nHDead)
    StzEngineGpuRenderBegin(nHT, 0, 0, 0, 1)
    chk("draw with a FREED vertex buffer: STALE", _C(StzEngineGpuRenderDraw(nP1, nHDead, 0, 3, 0), "=", iS_STALE))
    chk("second Begin while a pass is open: BAD_ARG", _C(StzEngineGpuRenderBegin(nHT, 0, 0, 0, 1), "=", iS_BADARG))
    chk("readback mid-pass: BAD_ARG", StzEngineGpuTargetRead(nHT) = "")
    StzEngineGpuRenderEnd()

    ? ""
    ? "-- Scene 14: eviction crosses KINDS under a small budget --"
    nBudget0 = StzEngineGpuVramBudget()
    # drain to a clean slate for exact accounting
    StzEngineGpuTextureFree(nHT)
    StzEngineGpuTextureFree(nHCk)
    StzEngineGpuBufferFree(nHV)
    StzEngineGpuBufferFree(nHVQ)
    StzEngineGpuBufferFree(nHVI)
    StzEngineGpuBufferFree(nHIdx)
    StzEngineGpuBufferFree(nHVB)
    StzEngineGpuBufferFree(nHVC)
    nEv0 = StzEngineGpuCounter(iC_EVICT)
    StzEngineGpuSetVramBudget(_A(StzEngineGpuVramInUse(), "+", 100000))
    nHOldBuf = StzEngineGpuBufferNew(40000)      # oldest resident
    nHTx1 = StzEngineGpuTextureNew(100, 100, nK_TARGET)   # 40000 bytes
    chk("two residents fit without eviction", _C(StzEngineGpuCounter(iC_EVICT), "=", nEv0))
    nHTx2 = StzEngineGpuTextureNew(100, 100, nK_TARGET)   # forces one out
    chk("third resident evicted the OLDEST (counted)", _C(StzEngineGpuCounter(iC_EVICT), "=", _A(nEv0, "+", 1)))
    chk("and the victim was the BUFFER, now STALE", _C(StzEngineGpuBufferSize(nHOldBuf), "=", -1))
    chk("the newer texture survived", _C(StzEngineGpuTextureWidth(nHTx1), "=", 100))
    StzEngineGpuSetVramBudget(1073741824)
    nEv1 = StzEngineGpuCounter(iC_EVICT)
    nHTx3 = StzEngineGpuTextureNew(100, 100, nK_TARGET)
    chk("negative sibling: big budget ⇒ zero evictions", _C(StzEngineGpuCounter(iC_EVICT), "=", nEv1))
    StzEngineGpuTextureFree(nHTx1)
    StzEngineGpuTextureFree(nHTx2)
    StzEngineGpuTextureFree(nHTx3)
    StzEngineGpuSetVramBudget(nBudget0)

    ? ""
    ? "-- Scene 15: shutdown mid-pass is clean, re-Init restores service --"
    nHTS = StzEngineGpuTextureNew(16, 16, nK_TARGET)
    StzEngineGpuRenderBegin(nHTS, 0, 0, 0, 1)
    StzEngineGpuShutdown()
    chk("not available after shutdown", _C(StzEngineGpuIsAvailable(), "=", 0))
    chk("the open pass was aborted", _C(StzEngineGpuRenderActive(), "=", 0))
    nF1 = StzEngineGpuCounter(iC_FALL)
    chk("post-shutdown texture ask refuses", _C(StzEngineGpuTextureNew(16, 16, nK_TARGET), "=", 0))
    chk("and was counted", _C(StzEngineGpuCounter(iC_FALL), "=", _A(nF1, "+", 1)))
    chk("re-Init restores the device", _C(StzEngineGpuInit($tStzGpuRuntime), "=", 1))
    nHTR = StzEngineGpuTextureNew(8, 8, nK_TARGET)
    chk("render service is back (target creates)", _C(nHTR, ">", 0))
    StzEngineGpuShutdown()
end

? ""
? "=========================================="
? "TOTAL: " + _T((_A($nPass, "+", $nFail))) + " assertions, " + _T($nPass) + " pass, " + _T($nFail) + " fail"
? "=========================================="
Shutdown($nFail)

func chk(tLabel, xCond)
	if _StzB(xCond)
		$nPass++
		? "  [OK] " + tLabel
	else
		$nFail++
		? "  [FAIL] " + tLabel
	end
end
# pixel (x,y) 0-based in tight RGBA8 bytes equals (r,g,b) exactly
func pxeq(tBytes, nRowW, nX, nY, nR, nG, nB)
	nOff = _A((_A(_A(Floor(nY), "*", nRowW), "+", Floor(nX))), "*", 4)
	return _C(Ascii(SubStr(tBytes, _A(nOff, "+", 1), 1)), "=", nR) and
	       _C(Ascii(SubStr(tBytes, _A(nOff, "+", 2), 1)), "=", nG) and
	       _C(Ascii(SubStr(tBytes, _A(nOff, "+", 3), 1)), "=", nB)
end

# A value as text, as the guard's narration writes it: a text as it is, a whole number plainly, any other number
# to $nStzPlaces places, rounded half away from zero. (The library's one-argument Text and Round shadow the built-ins.)
func _T(xV)
	if IsString(xV)
		return xV
	end
	if not IsNumber(xV)
		return String(xV)
	end
	tS = String(xV)
	nLen = Len(tS)
	bPlain = true
	for k = 1 to nLen
		tC = tS[k]
		if tC = "n" or tC = "i"
			return tS
		end
		if tC = "." or tC = "e" or tC = "E"
			bPlain = false
		end
	end
	if bPlain
		return tS
	end
	nP = $nStzPlaces
	nScale = 1
	for k = 1 to nP
		nScale = nScale * 10
	end
	fV = Float(xV)
	bNeg = fV < Float(0)
	if bNeg
		fV = Float(0) - fV
	end
	nI = Floor(fV * Float(nScale) + 0.5f)
	if nP = 0
		tR = String(nI)
	else
		nW = _Q((nI - nI % nScale), nScale)
		tF = String(nI % nScale)
		while Len(tF) < nP
			tF = "0" + tF
		end
		tR = String(nW) + "." + tF
	end
	if bNeg and nI != 0
		tR = "-" + tR
	end
	return tR
end

# A condition as true or false: a 1 or 0 from older code, or a boolean.
func _StzB(xV)
	if IsNumber(xV)
		return xV != 0
	end
	return xV
end

# The absolute value of any number: exact for an integer or a decimal, a float for a float.
func _StzAbs(xV)
	try
		if xV < 0
			return 0 - xV
		end
		return xV
	catch e
		fV = Float(xV)
		if fV < Float(0)
			return Float(0) - fV
		end
		return fV
	end
end

# A quotient as the older code took it: exact when one exists; otherwise, taken through floats, a decimal to
# nine places, or a float when either side is a float.
func _Q(xA, xB)
	try
		return xA / xB
	catch e
	end
	fQ = Float(String(xA)) / Float(String(xB))
	if _StzIsFloat(xA) or _StzIsFloat(xB)
		return fQ
	end
	try
		return Decimal(fQ, 9)
	catch e
		return fQ
	end
end

# A comparison as the older code made it, where every number was of one kind: the comparison itself when both
# sides are of one kind; otherwise both sides as floats, equal when neither is below the other, and a NaN equal
# to nothing.
func _C(xA, tOp, xB)
	try
		if tOp = "="
			return xA = xB
		end
		if tOp = "!="
			return xA != xB
		end
		if tOp = "<"
			return xA < xB
		end
		if tOp = ">"
			return xA > xB
		end
		if tOp = "<="
			return xA <= xB
		end
		return xA >= xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	bNaN = _StzNaN(fA) or _StzNaN(fB)
	if tOp = "="
		return not bNaN and not (fA < fB) and not (fA > fB)
	end
	if tOp = "!="
		return bNaN or fA < fB or fA > fB
	end
	if bNaN
		return false
	end
	if tOp = "<"
		return fA < fB
	end
	if tOp = ">"
		return fA > fB
	end
	if tOp = "<="
		return not (fA > fB)
	end
	return not (fA < fB)
end

# A number, or a true or false, as a float (the older code read a true as 1).
func _StzF(xV)
	if IsNumber(xV)
		if _StzIsFloat(xV)
			return xV
		end
		return Float(String(xV))
	end
	if xV
		return 1.0f
	end
	return 0.0f
end

# True for a NaN, read from its text.
func _StzNaN(xV)
	if not IsNumber(xV)
		return false
	end
	tS = String(xV)
	return tS = "nan" or tS = "-nan"
end

# True for a float: an integer or a decimal takes a zero added, a float refuses it.
func _StzIsFloat(xV)
	if not IsNumber(xV)
		return false
	end
	try
		xT = xV + 0
		return false
	catch e
		return true
	end
end

# Arithmetic as the older code did it, where every number was of one kind: the operation itself when both sides
# are of one kind; otherwise both sides as floats.
func _A(xA, tOp, xB)
	try
		if tOp = "+"
			return xA + xB
		end
		if tOp = "-"
			return xA - xB
		end
		return xA * xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	if tOp = "+"
		return fA + fB
	end
	if tOp = "-"
		return fA - fB
	end
	return fA * fB
end
