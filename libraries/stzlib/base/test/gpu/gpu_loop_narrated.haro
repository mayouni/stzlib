# GL0 -- THE BOUNDED LOOP (SOFTANZA_GPU_PLAN.md, GL0; the reader's account of
# the language is base/gpu/SOFTANZA_GPU_KERNELS.md, 3.1f).
#
# The sixth admission: iterate(k, from, to, s, init, step) and, to stop early,
# iterate(k, from, to, s, init, step, stop). A STATE s starts at init; on each
# pass k counts up from `from` and s becomes step; the value is the state at
# the end, or at the pass whose stop held. The state is a float, an int
# (written int(1)) or a vector. sum(k, a, b, e) is the special case
# iterate(k, a, b, s, 0, s + e). A loop runs at most 4096 times -- the trip
# count is to - from, wrapping as an i32, clamped to 0 .. 4096 -- so a kernel
# always ends, and a literal span past the cap is refused by name. One level:
# no loop inside a loop.
#
# Both readers read it as typed recursive descents with the same checks run
# first by shared code (iterCheck), so they refuse in the same order and the
# same words; the transpiler writes a prelude (var, for, break) and the
# interpreter five ops (it_begin, it_upd, it_end, it_k, it_s) over a frame
# that keeps the counter, the passes left and up to four state words.
#
# Run with haro: haro gpu_loop_narrated.haro

load "../../stzBase.ring"

$nPass = 0
$nFail = 0

pr()

$nStzPlaces = 4
tNL = Char(10)

? "-- Scene 1: a state, a stop, and sum as a special case, in both readers --"
$nT0 = Clock()
kCol = StzKernelMakerFromSpec("in a" + tNL + "out c" + tNL + "body { @c = iterate(k, 0, 200, s, vec2(@a, 0), vec2(when(s.x % 2 == 0, s.x / 2, 3 * s.x + 1), s.y + 1), s.x == 1).y }")
tW = kCol.ToWGSL()
chk("the transpiler declares the state, runs at most 4096 passes, and breaks when the stop holds",
	StzFindFirst("var it0 : vec2<f32> = vec2<f32>(v_a[i], 0f);", tW) > 0 and StzFindFirst("clamp(i32(200i) - f_, 0i, 4096i)", tW) > 0 and StzFindFirst("if (it0.x == 1f) { break; }", tW) > 0)
xC = kCol.EvaluateOn([ [:a, [ 6, 1, 27 ]] ])
chk("Collatz with a vec2 state (the value, the passes): 6 takes 8 passes, 1 takes 3, 27 takes 111", xC[1] = 8 and xC[2] = 3 and xC[3] = 111)
kS1 = StzKernelMakerFromSpec("in a" + tNL + "out c" + tNL + "body { @c = iterate(k, 0, 5, s, 0, s + k * 2) + @a * 0 }")
kS2 = StzKernelMakerFromSpec("in a" + tNL + "out c" + tNL + "body { @c = sum(k, 0, 5, k * 2) + @a * 0 }")
chk("sum is the special case: iterate(k, 0, 5, s, 0, s + k * 2) and sum(k, 0, 5, k * 2) both give 20",
	kS1.EvaluateOn([ [:a, [ 1 ]] ])[1] = 20 and kS2.EvaluateOn([ [:a, [ 1 ]] ])[1] = 20)
kE = StzKernelMakerFromSpec("in a" + tNL + "out c" + tNL + "body { @c = iterate(k, 5, 5, s, 7, s + 1) + iterate(k, 5, 2, t, 100, t + 1) + @a * 0 }")
chk("an empty range and a backwards one leave the init: 7 + 100", kE.EvaluateOn([ [:a, [ 1 ]] ])[1] = 107)
kF = StzKernelMakerFromSpec("in a" + tNL + "out c int" + tNL + "body { @c = iterate(k, 1, 6, s, int(1), s * k) + int(@a) * 0 }")
chk("an int state, written int(1): a factorial, whole, 5! = 120", kF.EvaluateOn([ [:a, [ 0 ]] ])[1] = 120)
kKf = StzKernelMakerFromSpec("in a" + tNL + "out c" + tNL + "body { @c = iterate(k, 0, 4, s, 0, s + k / 2) + @a * 0 }")
kKi = StzKernelMakerFromSpec("in a" + tNL + "out c" + tNL + "body { @c = float(iterate(k, 0, 4, s, int(0), s + k / 2)) + @a * 0 }")
chk("the variable takes the state's type: float k / 2 adds 0 .5 1 1.5 = 3, int k / 2 adds 0 0 1 1 = 2",
	kKf.EvaluateOn([ [:a, [ 0 ]] ])[1] = 3 and kKi.EvaluateOn([ [:a, [ 0 ]] ])[1] = 2)
kCap = StzKernelMakerFromSpec("in a int" + tNL + "out c" + tNL + "body { @c = iterate(k, 0, @a, s, 0, s + 1) }")
chk("a data-dependent bound is clamped to the cap, and a negative one runs nothing: 5 5000 -3 give 5 4096 0",
	_Same(kCap.EvaluateOn([ [:a, [ 5, 5000, -3 ]] ]), [ 5, 4096, 0 ]))
? "  (scene 1: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"

? ""
? "-- Scene 2: what is refused, in the same words by both readers --"
$nT0 = Clock()
xRef = [
	[ "too few arguments", "body { @c = iterate(k, 0, 5, s, 0) }", "iterate takes 6 or 7 arguments" ],
	[ "one name twice", "body { @c = iterate(k, 0, 5, k, 0, k) }", "need two names, and 'k' is both" ],
	[ "a variable that is an input", "body { @c = iterate(a, 0, 5, s, 0, s) }", "iterate's variable 'a' is already a name here" ],
	[ "a state that is the element index", "body { @c = iterate(k, 0, 5, i, 0, i) }", "iterate's state 'i' is already a name here" ],
	[ "a literal span past the cap", "body { @c = iterate(k, 0, 5000, s, 0, s + 1) }", "a loop runs at most 4096 times; from 0 to 5000 asks for 5000" ],
	[ "a sum inside a loop", "body { @c = iterate(k, 0, 3, s, 0, s + sum(j, 0, 2, j)) }", "a loop inside a loop is not admitted" ],
	[ "a loop inside a sum", "body { @c = sum(j, 0, 3, iterate(k, 0, 2, s, 0, s + 1)) }", "a loop inside a loop is not admitted" ],
	[ "a step of another type", "body { @c = iterate(k, 0, 3, s, 0, vec2(1, 2)) }", "the loop's state is a float, and its step gives a vec2" ],
	[ "a stop that is a number", "body { @c = iterate(k, 0, 3, s, 0, s + 1, s) }", "a bare value is not a condition" ],
	[ "a vector as a bound", "body { @c = iterate(k, vec2(0, 1), 3, s, 0, s + 1) }", "a vector stands where a number is needed" ],
	[ "a comparison as a step", "body { @c = iterate(k, 0, 3, s, 0, s > 1) }", "is a comparison" ],
	[ "the variable after the loop", "body { @c = iterate(k, 0, 3, s, 0, s + 1) + k }", "unknown name 'k'" ],
	[ "the state after the loop", "body { @c = iterate(k, 0, 3, s, 0, s + 1) + s }", "unknown name 's'" ]
]
for vQ in xRef
	tSpec = "in a" + tNL + "out c" + tNL + _T(vQ[2])
	tT = ""
	try
		StzKernelMakerFromSpec(tSpec).ToWGSL()
	catch
		tT = cCatchError
	end
	tI = ""
	try
		StzKernelMakerFromSpec(tSpec).EvaluateOn([ [:a, [ 1, 2 ]] ])
	catch
		tI = cCatchError
	end
	chk(_T(vQ[1]) + ": both readers refuse it with '" + _T(vQ[3]) + "'", StzFindFirst(vQ[3], tT) > 0 and tT = tI)
end
? "  (scene 2: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"

oG = new stzGpu
bDevice = oG.IsAvailable()
if bDevice
	? ""
	? "-- Scene 3: on the device --"
	$nT0 = Clock()
	xA = [] xB = []
	for i = 1 to 3000
		xA + ((((i * 7) % 33) - 16) / 8)
		xB + ((i * 37) % 201 - 100)
	end
	vCases = [
		[ "Collatz with a vec2 state and a stop", kCol, [ [:a, _Ramp(3000, 1)] ] ],
		[ "an int state through a wrapping recurrence", StzKernelMakerFromSpec("in b int" + tNL + "out c int" + tNL + "body { @c = iterate(k, 0, (abs(@b) % 9 + 4), s, int(@b), s * 1103515245 + 12345, s % 7 == 0) }"), [ [:b, xB] ] ],
		[ "a data-dependent bound, some empty", StzKernelMakerFromSpec("in a" + tNL + "in b int" + tNL + "out c" + tNL + "body { @c = iterate(k, 0, @b % 25, s, @a, max(s, k - @a), s > 12) }"), [ [:a, xA], [:b, xB] ] ],
		[ "a vec2 state, fibonacci with a stop", StzKernelMakerFromSpec("in b int" + tNL + "out c" + tNL + "body { @c = iterate(k, 0, (@b % 12 + 14), s, vec2(0, 1), vec2(s.y, s.x + s.y), s.x > 50).y }"), [ [:b, xB] ] ],
		[ "a loop in a guard", StzKernelMakerFromSpec("in a" + tNL + "out c" + tNL + "guard { @i < n and iterate(k, 0, 3, s, 0, s + @a) > 0 }" + tNL + "body { @c = @a }"), [ [:a, xA] ] ],
		[ "a stopping loop in a stage, before the barrier", StzKernelMakerFromSpec("in a" + tNL + "out c" + tNL + "shared t 256" + tNL + "stage { @t[@l] = iterate(k, 0, 8, s, @a, s * 0.5 + 1, s < 1.5) }" + tNL + "reduce t sum" + tNL + "body { @c = @t[0] }"), [ [:a, xA] ] ]
	]
	for vQ in vCases
		xV = oG.VerifySpecWith(vQ[2], vQ[2], vQ[3], [ [:n, 2000] ])
		chk(_T(vQ[1]) + ": the kernel compiles and agrees with the interpreter (" + _T(xV[:verdict]) + ", maxdiff " + _T(xV[:maxdiff]) + ")", xV[:verdict] = "verified")
	end
	? "  (scene 3: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"

	? ""
	? "-- Scene 4: the fuzz's loop kind, and its control --"
	$nT0 = Clock()
	nSeed = 20261028
	StzEngineGpuFuzzRun(nSeed, 300, 8192, 0.00001)
	? "  generated " + _T(StzEngineGpuFuzzResult(48)) + " loop kernels; ran " + _T(StzEngineGpuFuzzResult(4)) + ", agreed " + _T(StzEngineGpuFuzzResult(5)) + " (exact " + _T(StzEngineGpuFuzzResult(9)) + ")"
	chk("300 kernels: none refused by both readers, no split, no compile failure",
		StzEngineGpuFuzzResult(48) = 300 and StzEngineGpuFuzzResult(1) = 0 and StzEngineGpuFuzzResult(2) = 0 and StzEngineGpuFuzzResult(3) = 0)
	chk("...all 300 agree with the interpreter bit for bit, float, int and vector states, with and without a stop",
		StzEngineGpuFuzzResult(5) = 300 and StzEngineGpuFuzzResult(9) = 300 and StzEngineGpuFuzzResult(17) = 0)
	StzEngineGpuFuzzRun(nSeed, 300, 8192 + 64, 0.00001)
	nMut = StzEngineGpuFuzzResult(18)
	nCaught = StzEngineGpuFuzzResult(19)
	? "  step operator flipped in " + _T(nMut) + ", caught " + _T(nCaught)
	chk("the control flips each loop's step operator, and all 300 had one", nMut = 300)
	chk("...at least 80% were caught (measured 254 of 300; twelve of the 46 escapes read: loops that run no pass, a component the flip never reaches, a fibonacci whose signs alternate back)", nCaught >= 0.8 * nMut)
	StzEngineGpuFuzzRun(nSeed, 300, 63, 0.00001)
	chk("the six float kinds still agree as before (300, 219 exactly)", StzEngineGpuFuzzResult(5) = 300 and StzEngineGpuFuzzResult(9) = 219)
	? "  (scene 4: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"
end

? ""
? "-- Scene 5: puzzle 18, round up to a power of two --"
$nT0 = Clock()
oQ = StzKernelPuzzleQ("kp-18")
chk("the starter grades 'waiting for your implementation'", oQ.Grade(oQ.Starter()) = "waiting for your implementation")
chk("the task reads in four languages and ends with what the GPU did differently from a loop",
	oQ.Task("en") != "" and oQ.Task("fr") != "" and oQ.Task("ar") != "" and oQ.Task("ha") != "" and StzFindFirst("differently from a loop", oQ.Task("en")) > 0)
tHead = "in a" + tNL + "out c" + tNL
# the verdicts were worked out from the data (a runs 0, 1, 2 ... 3999) before the first run:
#   s > a:      element 2 (a = 1) gets 2, not 1
#   start at 1: element 1 (a = 0) gets 2, not 1
#   8 passes:   the largest state is 128, so a = 129 (element 130) is the first wrong one
vCases = [
	[ "iterate(k, 0, 40, s, 0.5, s * 2, s >= @a)", "verified" ],
	[ "iterate(k, 0, 13, s, 1, when(s >= @a, s, s * 2))", "verified" ],
	[ "float(iterate(k, 0, 13, s, int(1), when(s < int(@a), s * 2, s)))", "verified" ],
	[ "iterate(k, 0, 40, s, 0.5, s * 2, s > @a)", "mismatch at element 2" ],
	[ "iterate(k, 0, 40, s, 1, s * 2, s >= @a)", "mismatch at element 1" ],
	[ "iterate(k, 0, 8, s, 0.5, s * 2, s >= @a)", "mismatch at element 130" ]
]
nAgree = 0
for vQ in vCases
	tSpec = tHead + "body { @c = " + _T(vQ[1]) + " }"
	if bDevice
		tV = oQ.Grade(tSpec)
	else
		tV = oQ.GradeOnCpu(tSpec)
	end
	chk(_T(vQ[1]) + " -> " + _T(vQ[2]) + " (" + tV + ")", tV = vQ[2])
	if oQ.GradeOnCpu(tSpec) = vQ[2]
		nAgree++
	end
end
chk("GradeOnCpu says the same words for all " + _T(Len(vCases)) + " cases", nAgree = Len(vCases))
tV = oQ.Grade(tHead + "body { @c = iterate(k, 0, 40, s, 0.5, s * 2, s) }")
chk("a stop that is a number is refused by name (" + tV + ")", StzFindFirst("refused", tV) = 1 and StzFindFirst("not a condition", tV) > 0)
if bDevice
	oE = StzExerciseQ("../../education/program/courses/kernel-puzzles/exercises/kp-18")
	# the parent lets go of the card first: since the GPU lease (2026-11-14) the graders ProveItself starts
	# cannot take it from their own parent, and would wait and answer "waiting for the device" (KP-PROVE-FLAKE)
	StzEngineGpuShutdown()
	xPr = oE.ProveItself()
	chk("the exercise proves itself through the System's checker: wrong refused " + _T(xPr[:wrong]) + ", right accepted " + _T(xPr[:right]) + ", failures " + _T(@@(xPr[:failures])),
		xPr[:wrong] = 5 and xPr[:right] = 3 and Len(xPr[:failures]) = 0)
end
? "  (scene 5: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"

? ""
? "=========================================="
? "TOTAL: " + _T(($nPass + $nFail)) + " assertions, " + _T($nPass) + " pass, " + _T($nFail) + " fail"
? "=========================================="

pfq()
Shutdown($nFail)

func chk(tLabel, xCond)
	if _StzB(xCond)
		$nPass++
		? "  [OK] " + tLabel
	else
		$nFail++
		? "  [FAIL] " + tLabel
	end
end
func _Same(pxA, pxB)
	if Len(pxA) != Len(pxB)
		return 0
	end
	nQ = Len(pxA)
	for q = 1 to nQ
		if pxA[q] != pxB[q]
			return 0
		end
	end
	return 1
end
func _Ramp(nN, nFrom)
	xR = []
	for q = 0 to nN - 1
		xR + (nFrom + q % 40)
	end
	return xR
end

# A value as text, as the guard's narration writes it: a text as it is, a whole number plainly, any other number
# to $nStzPlaces places, rounded half away from zero. (The library's one-argument Text and Round shadow the built-ins.)
func _T(xV)
	if IsString(xV)
		return xV
	end
	if not IsNumber(xV)
		return String(xV)
	end
	tS = String(xV)
	nLen = Len(tS)
	bPlain = true
	for k = 1 to nLen
		tC = tS[k]
		if tC = "n" or tC = "i"
			return tS
		end
		if tC = "." or tC = "e" or tC = "E"
			bPlain = false
		end
	end
	if bPlain
		return tS
	end
	nP = $nStzPlaces
	nScale = 1
	for k = 1 to nP
		nScale = nScale * 10
	end
	fV = Float(xV)
	bNeg = fV < Float(0)
	if bNeg
		fV = Float(0) - fV
	end
	nI = Floor(fV * Float(nScale) + 0.5f)
	if nP = 0
		tR = String(nI)
	else
		nW = (nI - nI % nScale) / nScale
		tF = String(nI % nScale)
		while Len(tF) < nP
			tF = "0" + tF
		end
		tR = String(nW) + "." + tF
	end
	if bNeg and nI != 0
		tR = "-" + tR
	end
	return tR
end

# A condition as true or false: a 1 or 0 from older code, or a boolean.
func _StzB(xV)
	if IsNumber(xV)
		return xV != 0
	end
	return xV
end

# The absolute value of any number: exact for an integer or a decimal, a float for a float.
func _StzAbs(xV)
	try
		if xV < 0
			return 0 - xV
		end
		return xV
	catch e
		fV = Float(xV)
		if fV < Float(0)
			return Float(0) - fV
		end
		return fV
	end
end
