# GB0 -- SEGMENTED SCAN AND SEGMENTED REDUCTION, the library layer's fourth op
# (SOFTANZA_GPU_PLAN.md, GB0; the scan of gpu_scan_narrated.haro with a reset, and the
# compaction of gpu_compact_narrated.haro on top).
#
# A flags buffer cuts a vector into SEGMENTS: a nonzero flag at i starts a new segment
# there, and element 0 always starts one. Two ops, each with an operator (sum, max, min):
#   segscan     out[i] = the operator over the elements of i's segment up to i
#   segreduce   out[s] = the operator over the whole of segment s, one number per segment,
#               packed, and how many segments there were
# The scan carries pairs (flag, value), combined as (f1, v1) + (f2, v2) = (f1 or f2,
# if f2 then v2 else v1 op v2) -- associative, so the three-phase scan applies unchanged.
#
# Parity discipline, as the scan's guard states it:
#   - EXACT WITNESSES: whole numbers (negatives included), the plain loop's answer element
#     for element, for all three operators, at sizes that cross every level, with segments of
#     every length, with no flag, and with a flag everywhere;
#   - a TOLERANCE BAND for sums whose partials round, set from measurement;
#   - NEGATIVE SIBLINGS: wrong sizes, aliased buffers, a freed buffer, an unknown operator,
#     no device -- and the happy path counts ZERO fallbacks.
#
# Run with haro: haro gpu_segscan_narrated.haro

load "../../stzBase.ring"

$nPass = 0
$nFail = 0
$nSkip = 0

pr()

$nStzPlaces = 10

nS_OK = 0
nS_FALLBACK = 1
iS_STALE = 2
iS_BADARG = 3
iS_TOOLARGE = 4

vOpNames = [ "sum", "max", "min" ]

? "-- Scene 0: the ops refuse the fallback way before there is a device --"
chk("a segmented scan before Init answers FALLBACK", _C(StzEngineGpuOpSegScan(1, 2, 3, 100, 0), "=", nS_FALLBACK))
xF = StzEngineGpuOpSegReduce(1, 2, 3, 100, 0)
chk("...and so does the reduction", _C(xF[1], "=", nS_FALLBACK))

oG = new stzGpu
bDevice = oG.IsAvailable()
if not bDevice
	? "  NO GPU ON THIS MACHINE -- the scenes below need a device; the fallback scene above is the CI coverage"
else
	? "  device: [" + _T(StzEngineGpuSelectedAdapter()) + "] " + _T(StzEngineGpuAdapterName(StzEngineGpuSelectedAdapter()))

	? ""
	? "-- Scene 1: the segmented scan, exact, three operators, every level, segments of every length --"
	$nT0 = Clock()
	StzEngineGpuCountersReset()
	for nN in [ 1, 2, 255, 256, 257, 4096, 65537, 1000003 ]
		vIn = []
		vFl = []
		for i = 1 to nN
			vIn + (_A(((i * 5) % 7), "-", 3))
			vFl + _StzI(_C(((i * 7919) % 97), "<", 3))
		end
		nHI = StzEngineGpuBufferNew(_A(nN, "*", 4))
		nHF = StzEngineGpuBufferNew(_A(nN, "*", 4))
		nHO = StzEngineGpuBufferNew(_A(nN, "*", 4))
		StzEngineGpuBufferUploadList(nHI, vIn)
		StzEngineGpuBufferUploadList(nHF, vFl)
		for nOp = 0 to 2
			nSt = StzEngineGpuOpSegScan(nHI, nHF, nHO, nN, nOp)
			xOut = StzEngineGpuBufferDownloadList(nHO, nN)
			xRef = _RefScan(vIn, vFl, nOp)
			bSame = (nSt = nS_OK and _C(@@(xOut), "=", @@(xRef)))
			chk("n = " + _T(nN) + " " + _T(vOpNames[nOp + 1]) + " (" + _T(StzEngineGpuSegScanDispatches(nN)) + " dispatches): every element equals the loop's, to the bit", bSame)
		end
		StzEngineGpuBufferFree(nHI)
		StzEngineGpuBufferFree(nHF)
		StzEngineGpuBufferFree(nHO)
	end
	nN = 100000
	vIn = []
	vNone = []
	xAll = []
	for i = 1 to nN
		vIn + (_A(((i * 5) % 7), "-", 3))
		vNone + 0
		xAll + 1
	end
	nHI = StzEngineGpuBufferNew(_A(nN, "*", 4))
	nHF = StzEngineGpuBufferNew(_A(nN, "*", 4))
	nHO = StzEngineGpuBufferNew(_A(nN, "*", 4))
	nHP = StzEngineGpuBufferNew(_A(nN, "*", 4))
	StzEngineGpuBufferUploadList(nHI, vIn)
	StzEngineGpuBufferUploadList(nHF, vNone)
	StzEngineGpuOpSegScan(nHI, nHF, nHO, nN, 0)
	StzEngineGpuOpScan(nHI, nHP, nN, 0)
	chk("no flag at all is one segment, so a segmented sum is the plain scan's, to the bit (100,000 elements)", _C(@@(StzEngineGpuBufferDownloadList(nHO, nN)), "=", @@(StzEngineGpuBufferDownloadList(nHP, nN))))
	StzEngineGpuBufferUploadList(nHF, xAll)
	StzEngineGpuOpSegScan(nHI, nHF, nHO, nN, 1)
	chk("a flag on every element makes every element its own segment, so any operator returns the input", _C(@@(StzEngineGpuBufferDownloadList(nHO, nN)), "=", @@(vIn)))
	vZero = [ 0, 5, 0, 5, 0 ]
	StzEngineGpuBufferFree(nHF)
	nHF2 = StzEngineGpuBufferNew(20)
	nHI2 = StzEngineGpuBufferNew(20)
	nHO2 = StzEngineGpuBufferNew(20)
	StzEngineGpuBufferUploadList(nHF2, [ 0, 0, 1, 0, 0 ])
	StzEngineGpuBufferUploadList(nHI2, [ 1, 2, 3, 4, 5 ])
	StzEngineGpuOpSegScan(nHI2, nHF2, nHO2, 5, 0)
	chk("element 0 starts a segment whatever its flag says: flags [0 0 1 0 0] over [1 2 3 4 5] give [1 3 3 7 12]", @@(StzEngineGpuBufferDownloadList(nHO2, 5)) = "[ 1, 3, 3, 7, 12 ]")
	StzEngineGpuBufferFree(nHF2)
	StzEngineGpuBufferFree(nHI2)
	StzEngineGpuBufferFree(nHO2)
	StzEngineGpuBufferFree(nHP)
	chk("the happy path counted zero fallbacks", _C(StzEngineGpuCounter(3), "=", 0))
	? "  (scene 1: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"

	? ""
	? "-- Scene 2: the reduction, one number per segment --"
	$nT0 = Clock()
	for nN in [ 1, 255, 257, 65537, 1000003 ]
		vIn = []
		vFl = []
		for i = 1 to nN
			vIn + (_A(((i * 5) % 7), "-", 3))
			vFl + _StzI(_C(((i * 7919) % 97), "<", 3))
		end
		nHI = StzEngineGpuBufferNew(_A(nN, "*", 4))
		nHF = StzEngineGpuBufferNew(_A(nN, "*", 4))
		nHO = StzEngineGpuBufferNew(_A(nN, "*", 4))
		StzEngineGpuBufferUploadList(nHI, vIn)
		StzEngineGpuBufferUploadList(nHF, vFl)
		for nOp = 0 to 2
			xRes = StzEngineGpuOpSegReduce(nHI, nHF, nHO, nN, nOp)
			nSeg = Floor(xRes[2])
			xOut = []
			if _C(nSeg, ">", 0)
				xOut = StzEngineGpuBufferDownloadList(nHO, nSeg)
			end
			xRef = _RefReduce(vIn, vFl, nOp)
			chk("n = " + _T(nN) + " " + _T(vOpNames[nOp + 1]) + ": " + _T(nSeg) + " segments, each the loop's number, to the bit", xRes[1] = nS_OK and _C(nSeg, "=", Len(xRef)) and _C(@@(xOut), "=", @@(xRef)))
		end
		StzEngineGpuBufferFree(nHI)
		StzEngineGpuBufferFree(nHF)
		StzEngineGpuBufferFree(nHO)
	end
	nHI = StzEngineGpuBufferNew(40)
	nHF = StzEngineGpuBufferNew(40)
	nHO = StzEngineGpuBufferNew(40)
	StzEngineGpuBufferUploadList(nHI, [ 4, 1, 7, 2, 9, 3, 8, 5, 6, 0 ])
	StzEngineGpuBufferUploadList(nHF, [ 1, 0, 0, 1, 0, 0, 0, 1, 0, 0 ])
	xRes = StzEngineGpuOpSegReduce(nHI, nHF, nHO, 10, 1)
	chk("segments [4 1 7] [2 9 3 8] [5 6 0]: the largest of each is [7 9 6], three segments", _C(xRes[2], "=", 3) and @@(StzEngineGpuBufferDownloadList(nHO, 3)) = "[ 7, 9, 6 ]")
	xRes = StzEngineGpuOpSegReduce(nHI, nHF, nHO, 10, 0)
	chk("...the sums are [12 22 11]", @@(StzEngineGpuBufferDownloadList(nHO, 3)) = "[ 12, 22, 11 ]")
	xRes = StzEngineGpuOpSegReduce(nHI, nHF, nHO, 10, 2)
	chk("...the smallest are [1 2 0]", @@(StzEngineGpuBufferDownloadList(nHO, 3)) = "[ 1, 2, 0 ]")
	StzEngineGpuBufferFree(nHI)
	StzEngineGpuBufferFree(nHF)
	StzEngineGpuBufferFree(nHO)
	? "  (scene 2: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"

	? ""
	? "-- Scene 3: a sum whose partials round, against the loop in f64 --"
	nN = 100000
	vIn = []
	vFl = []
	for i = 1 to nN
		vIn + (_A(_Q(((i * 37) % 1000), 1000.0), "+", 0.001))
		vFl + _StzI(_C(((i * 7919) % 997), "<", 2))
	end
	nHI = StzEngineGpuBufferNew(_A(nN, "*", 4))
	nHF = StzEngineGpuBufferNew(_A(nN, "*", 4))
	nHO = StzEngineGpuBufferNew(_A(nN, "*", 4))
	StzEngineGpuBufferUploadList(nHI, vIn)
	StzEngineGpuBufferUploadList(nHF, vFl)
	xUp = StzEngineGpuBufferDownloadList(nHI, nN)
	StzEngineGpuOpSegScan(nHI, nHF, nHO, nN, 0)
	xOut = StzEngineGpuBufferDownloadList(nHO, nN)
	xRef = _RefScan(xUp, vFl, 0)
	nMaxRel = 0
	for i = 1 to nN
		xRel = _Q(_StzAbs(_A(xOut[i], "-", xRef[i])), xRef[i])
		if _C(xRel, ">", nMaxRel)
			nMaxRel = xRel
		end
	end
	? "  measured max relative error against the f64 segmented scan of the uploaded values, n = 100000: " + _T(nMaxRel)
	chk("band: relative error < 1e-5 (the band is set from the measurement printed above)", _C(nMaxRel, "<", 0.00001))
	StzEngineGpuBufferFree(nHI)
	StzEngineGpuBufferFree(nHF)
	StzEngineGpuBufferFree(nHO)

	? ""
	? "-- Scene 4: one submit, dispatches counted, the scratch kept and given back --"
	nN = 100000
	vIn = []
	vFl = []
	for i = 1 to nN
		vIn + (_A(((i * 5) % 7), "-", 3))
		vFl + _StzI(_C(((i * 7919) % 97), "<", 3))
	end
	nHI = StzEngineGpuBufferNew(_A(nN, "*", 4))
	nHF = StzEngineGpuBufferNew(_A(nN, "*", 4))
	nHO = StzEngineGpuBufferNew(_A(nN, "*", 4))
	StzEngineGpuBufferUploadList(nHI, vIn)
	StzEngineGpuBufferUploadList(nHF, vFl)
	StzEngineGpuOpSegScan(nHI, nHF, nHO, nN, 0)
	StzEngineGpuSync()
	nD0 = StzEngineGpuCounter(0)
	nS0 = StzEngineGpuCounter(6)
	nL0 = StzEngineGpuCounter(8)
	nF0 = StzEngineGpuCounter(3)
	StzEngineGpuOpSegScan(nHI, nHF, nHO, nN, 0)
	StzEngineGpuSync()
	chk("a segmented scan of 100,000 is " + _T(StzEngineGpuSegScanDispatches(nN)) + " dispatches (the counter says " + _T((_A(StzEngineGpuCounter(0), "-", nD0))) + ")", _C(_A(StzEngineGpuCounter(0), "-", nD0), "=", StzEngineGpuSegScanDispatches(nN)) and _C(StzEngineGpuSegScanDispatches(nN), "=", 5))
	chk("...in ONE queue submit (the counter says " + _T((_A(StzEngineGpuCounter(6), "-", nS0))) + ")", _C(_A(StzEngineGpuCounter(6), "-", nS0), "=", 1))
	chk("...the scratch is kept, not made again: live buffers " + _T(nL0) + " before the call and " + _T(StzEngineGpuCounter(8)) + " after", _C(StzEngineGpuCounter(8), "=", nL0))
	chk("...and nothing fell back", _C(StzEngineGpuCounter(3), "=", nF0))
	nLive = StzEngineGpuCounter(8)
	StzEngineGpuSegScanRelease()
	chk("SegScanRelease gives the three scratch buffers back (live buffers " + _T(nLive) + " then " + _T(StzEngineGpuCounter(8)) + ")", _C(StzEngineGpuCounter(8), "=", _A(nLive, "-", 3)))

	? ""
	? "-- Scene 5: what it refuses --"
	chk("n = 0 is BAD_ARG", _C(StzEngineGpuOpSegScan(nHI, nHF, nHO, 0, 0), "=", iS_BADARG))
	chk("an unknown operator is BAD_ARG", _C(StzEngineGpuOpSegScan(nHI, nHF, nHO, nN, 3), "=", iS_BADARG) and _C(StzEngineGpuOpSegScan(nHI, nHF, nHO, nN, 0 - 1), "=", iS_BADARG))
	chk("the same buffer twice is BAD_ARG (WebGPU aliasing validation)", _C(StzEngineGpuOpSegScan(nHI, nHI, nHO, nN, 0), "=", iS_BADARG) and _C(StzEngineGpuOpSegScan(nHI, nHF, nHI, nN, 0), "=", iS_BADARG) and _C(StzEngineGpuOpSegScan(nHI, nHF, nHF, nN, 0), "=", iS_BADARG))
	chk("an output too small is BAD_ARG", _C(StzEngineGpuOpSegScan(nHI, nHF, nHO, _A(nN, "+", 1), 0), "=", iS_BADARG))
	xR = StzEngineGpuOpSegReduce(nHI, nHF, nHO, 16777217, 0)
	chk("a reduction of more than 16,777,216 elements is refused by name (TOO_LARGE): the compaction's counts are f32", _C(xR[1], "=", iS_TOOLARGE))
	StzEngineGpuBufferFree(nHO)
	chk("a freed output answers STALE", _C(StzEngineGpuOpSegScan(nHI, nHF, nHO, nN, 0), "=", iS_STALE))
	StzEngineGpuBufferFree(nHI)
	StzEngineGpuBufferFree(nHF)

	? ""
	? "-- Scene 6: the face, lists in and lists out --"
	xA = oG.SegmentedScan([ 1, 2, 3, 4, 5, 6 ], [ 1, 0, 0, 1, 0, 0 ], "sum")
	xB = oG.SegmentedReduce([ 4, 1, 7, 2, 9, 3, 8, 5, 6, 0 ], [ 1, 0, 0, 1, 0, 0, 0, 1, 0, 0 ], "max")
	xC = oG.SegmentedReduce([ 4, 1, 7 ], [ 0, 0, 0 ], "min")
	chk("SegmentedScan([1..6], flags [1 0 0 1 0 0], 'sum') = [1 3 6 4 9 15]", @@(xA) = "[ 1, 3, 6, 4, 9, 15 ]")
	chk("SegmentedReduce of the three segments, 'max' = [7 9 6]", @@(xB) = "[ 7, 9, 6 ]")
	chk("no flag is one segment: SegmentedReduce([4 1 7], 'min') = [1]", @@(xC) = "[ 1 ]")
	tErr = ""
	try
		oG.SegmentedReduce([ 1, 2 ], [ 1 ], "sum")
	catch
		tErr = cCatchError
	end
	chk("flags of another length are refused by name (" + Left(tErr, 50) + ")", _C(StzFindFirst("flags of the same length", tErr), ">", 0))
	tErr = ""
	try
		oG.SegmentedScan([ 1, 2 ], [ 1, 0 ], "mean")
	catch
		tErr = cCatchError
	end
	chk("an unknown operator is refused by name (" + Left(tErr, 60) + ")", _C(StzFindFirst("one of sum, max, min", tErr), ">", 0))

	? ""
	? "-- Scene 7: how fast, resident, against the plain scan --"
	$nT0 = Clock()
	nN = 16000000
	nHI = StzEngineGpuBufferNew(_A(nN, "*", 4))
	nHF = StzEngineGpuBufferNew(_A(nN, "*", 4))
	nHO = StzEngineGpuBufferNew(_A(nN, "*", 4))
	if _C(nHI, "=", 0) or _C(nHF, "=", 0) or _C(nHO, "=", 0)
		? "  (no room for three 64 MB buffers: scene skipped)"
	else
		oG.Wake(400)
		StzEngineGpuSync()
		nBestSeg = 1000000
		nBestScan = 1000000
		for nRep = 1 to 5
			StzEngineGpuSync()
			nT = StzEngineWatchTimestampNs()
			for q = 1 to 5
				StzEngineGpuOpSegScan(nHI, nHF, nHO, nN, 0)
			end
			StzEngineGpuSync()
			nMs = _Q(_Q((_A(StzEngineWatchTimestampNs(), "-", nT)), 1000000), 5)
			if _C(nMs, "<", nBestSeg)
				nBestSeg = nMs
			end
			StzEngineGpuSync()
			nT = StzEngineWatchTimestampNs()
			for q = 1 to 5
				StzEngineGpuOpScan(nHI, nHO, nN, 0)
			end
			StzEngineGpuSync()
			nMs = _Q(_Q((_A(StzEngineWatchTimestampNs(), "-", nT)), 1000000), 5)
			if _C(nMs, "<", nBestScan)
				nBestScan = nMs
			end
		end
		? "  16,000,000 floats, " + _T(StzEngineGpuSegScanDispatches(nN)) + " dispatches: segmented scan " + _T(nBestSeg) + " ms, plain scan " + _T(nBestScan) + " ms (" + _T((_Q(nBestSeg, nBestScan))) + " times)"
		chk("a segmented scan costs under 6 plain scans (a sanity line from the measurement above, not a goal: it moves two more vectors, the flags in and the carried flags out)", _C(_Q(nBestSeg, nBestScan), "<", 6))
	end
	StzEngineGpuBufferFree(nHI)
	StzEngineGpuBufferFree(nHF)
	StzEngineGpuBufferFree(nHO)
	? "  (scene 7: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"

	? ""
	? "-- Scene 8: the route -- the loop against the device through the face, measured, stored, followed --"
	$nT0 = Clock()
	xCal = oG.CalibrateSegmentedReduce()
	? "  adapter " + _T(xCal[:adapter]) + ", flat line at " + _T(xCal[:flat]) + " (" + _T(xCal[:flatwhy]) + ")"
	for xCell in xCal[:cells]
		? "  n = " + _T(xCell[2]) + ": loop " + _T(xCell[3]) + " ms, face " + _T(xCell[4]) + " ms, ratio " + _T(xCell[5])
	end
	if xCal[:confounded]
		# the control rung moved by more than 2x: another process held the machine, the store refused the line,
		# and a route that was never stored cannot be followed. A gate that could not run says so; it is not a pass
		$nSkip++
		? "  [SKIPPED] the route checks: the machine was too loaded for a stable measurement (the control rung moved more than 2x), so nothing was stored; run this guard again on a quiet machine"
	else
		chk("the control rung (the first, measured again at the end) stayed within 2x, so the line is stored", not xCal[:confounded])
		bFollow = true
		for xCell in xCal[:cells]
			bWin = (_C(xCell[5], ">=", 1.3))
			if (_C(StzEngineGpuCalibRouteShaped("segreduce", xCell[2], 1), "=", 1)) != bWin
				bFollow = false
			end
		end
		chk("the route sends a size to the device exactly where its measured ratio reached 1.3, at every rung", bFollow)
		vNum = []
		vFlg = []
		for i = 1 to 200000
			vNum + ((i * 5) % 7)
			vFlg + _StzI(_C(i % 64, "=", 1))
		end
		chk("SegmentedReduceRouted gives the same numbers whichever side it ran on (200,000 whole numbers, 3,125 segments, to the bit)", _C(@@(oG.SegmentedReduceRouted(vNum, vFlg, "sum")), "=", @@(oG._SegReduceCpu(vNum, vFlg, "sum"))))
		chk("a short list stays on the loop and SegmentedReduceRouted answers [3 9]", @@(oG.SegmentedReduceRouted([ 1, 2, 4, 5 ], [ 1, 0, 1, 0 ], "sum")) = "[ 3, 9 ]" and _C(StzEngineGpuCalibRouteShaped("segreduce", 4, 1), "=", 0))
	end
	? "  (scene 8: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"
end

? ""
? "-- Scene 9: puzzle 23, a running total that starts over --"
$nT0 = Clock()
tNL = Char(10)
oQ = StzKernelPuzzleQ("kp-23")
chk("the starter grades 'waiting for your implementation'", oQ.Grade(oQ.Starter()) = "waiting for your implementation")
chk("the task reads in four languages, names SegmentedScan and ends with what the GPU did differently from a loop",
	oQ.Task("en") != "" and oQ.Task("fr") != "" and oQ.Task("ar") != "" and oQ.Task("ha") != "" and _C(StzFindFirst("SegmentedScan", oQ.Task("en")), ">", 0) and _C(StzFindFirst("differently from a loop", oQ.Task("en")), ">", 0))
tHead = "in a" + tNL + "in b" + tNL + "out c" + tNL + "shared t 256" + tNL + "shared s 256" + tNL + "shared r 256" + tNL + "stage { @t[@l] = @a }" + tNL + "stage { @s[@l] = when(@b < 2, 1, 0) }" + tNL
tIds = "stage { @r[@l] = sum(j, 0, 256, when(j <= @l, @s[j], 0)) }" + tNL
tExc = "stage { @r[@l] = sum(j, 0, 256, when(j < @l, @s[j], 0)) }" + tNL
# the verdicts were worked out from the data before the first run. a is (i * 7) % 13 = 0 7 1 8 2 9 3 10 ...;
# b is (i * 3) % 7 = 0 3 6 2 5 1 4 0 ..., so a mark below 2 starts a segment at i = 0, 5, 7, 12, 14 ... and the
# reference gives 0 7 8 16 18 | 9 12 | 10 ... (a[0] is 0, which hides some mistakes at element 1):
#   forgets the resets:    i = 5 adds everything before it (27) where its own 9 is owed: element 6
#   a start joins the one before: the count before i = 5 is 1, shared with i = 1 .. 4, so i = 5 totals 27: element 6
#   compares the marks:    i = 5 (a start, mark 1) matches only i = 0 (a 0) and i = 5, so it is right; i = 6 (mark 4)
#                          matches 1 2 3 4 and itself, 21 for 12 owed: element 7
vCases = [
	[ _T(tHead + tIds) + "body { @c = sum(j, 0, 256, when(j <= @l and @r[j] == @r[@l], @t[j], 0)) }", "verified" ],
	[ _T(tHead + tExc) + "body { @c = sum(j, 0, 256, when(j <= @l and @r[j] + @s[j] == @r[@l] + @s[@l], @t[j], 0)) }", "verified" ],
	[ tHead + "body { @c = sum(j, 0, 256, when(j <= @l, @t[j], 0)) }", "mismatch at element 6" ],
	[ _T(tHead + tIds) + "body { @c = sum(j, 0, 256, when(j <= @l and @s[j] == @s[@l], @t[j], 0)) }", "mismatch at element 7" ],
	[ _T(tHead + tExc) + "body { @c = sum(j, 0, 256, when(j <= @l and @r[j] == @r[@l], @t[j], 0)) }", "mismatch at element 6" ]
]
nAgree = 0
for vQ in vCases
	if bDevice
		tV = oQ.Grade(vQ[1])
	else
		tV = oQ.GradeOnCpu(vQ[1])
	end
	tShow = Replace(vQ[1], tNL, " / ")
	tShow = Replace(tShow, "in a / in b / out c / shared t 256 / shared s 256 / shared r 256 / stage { @t[@l] = @a } / stage { @s[@l] = when(@b < 2, 1, 0) } / ", "")
	chk(tShow + " -> " + _T(vQ[2]) + " (" + tV + ")", tV = vQ[2])
	if _C(oQ.GradeOnCpu(vQ[1]), "=", vQ[2])
		nAgree++
	end
end
chk("GradeOnCpu says the same words for all " + _T(Len(vCases)) + " cases", _C(nAgree, "=", Len(vCases)))
tV = oQ.Grade("in a" + tNL + "in b" + tNL + "out c" + tNL + "shared t 256" + tNL + "stage { @t[@l] = @t[@l] + @t[@l - 1] }" + tNL + "body { @c = @t[@l] }")
chk("a stage that reads the array it writes is refused by name (" + Left(tV, 60) + ")", _C(StzFindFirst("refused", tV), "=", 1) and _C(StzFindFirst("cannot read the array it writes", tV), ">", 0))
if bDevice
	oE = StzExerciseQ("../../education/program/courses/kernel-puzzles/exercises/kp-23")
	# the parent lets go of the card first: since the GPU lease (2026-11-14) the graders ProveItself starts
	# cannot take it from their own parent, and would wait and answer "waiting for the device" (KP-PROVE-FLAKE)
	StzEngineGpuShutdown()
	xPr = oE.ProveItself()
	chk("the exercise proves itself through the System's checker: wrong refused " + _T(xPr[:wrong]) + ", right accepted " + _T(xPr[:right]) + ", failures " + _T(@@(xPr[:failures])),
		_C(xPr[:wrong], "=", 5) and _C(xPr[:right], "=", 2) and _C(Len(xPr[:failures]), "=", 0))
end
? "  (scene 9: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"

? ""
? "=========================================="
? "TOTAL: " + _T((_A($nPass, "+", $nFail))) + " assertions, " + _T($nPass) + " pass, " + _T($nFail) + " fail" + ", " + _T($nSkip) + " skipped"
? "=========================================="

pfq()
Shutdown($nFail)

func chk(tLabel, xCond)
	if _StzB(xCond)
		$nPass++
		? "  [OK] " + tLabel
	else
		$nFail++
		? "  [FAIL] " + tLabel
	end
end
# the loop's segmented scan: nOp 0 sum, 1 max, 2 min; element 1 always starts a segment
func _RefScan(vIn, vFl, nOp)
	xOut = []
	nAcc = 0
	nN = Len(vIn)
	for i = 1 to nN
		if _C(i, "=", 1) or _C(vFl[i], "!=", 0)
			nAcc = vIn[i]
		else
			if _C(nOp, "=", 0)
				nAcc = _A(nAcc, "+", vIn[i])
			elseif _C(nOp, "=", 1)
				if _C(vIn[i], ">", nAcc)
					nAcc = vIn[i]
				end
			else
				if _C(vIn[i], "<", nAcc)
					nAcc = vIn[i]
				end
			end
		end
		xOut + nAcc
	end
	return xOut
end
# the loop's segmented reduction: the last element of each segment of its segmented scan
func _RefReduce(vIn, vFl, nOp)
	xS = _RefScan(vIn, vFl, nOp)
	xOut = []
	nN = Len(vIn)
	for i = 1 to nN
		if _C(i, "=", nN) or _C(vFl[i + 1], "!=", 0)
			xOut + xS[i]
		end
	end
	return xOut
end

# A value as text, as the guard's narration writes it: a text as it is, a whole number plainly, any other number
# to $nStzPlaces places, rounded half away from zero. (The library's one-argument Text and Round shadow the built-ins.)
func _T(xV)
	if IsString(xV)
		return xV
	end
	if not IsNumber(xV)
		return String(xV)
	end
	tS = String(xV)
	nLen = Len(tS)
	bPlain = true
	for k = 1 to nLen
		tC = tS[k]
		if tC = "n" or tC = "i"
			return tS
		end
		if tC = "." or tC = "e" or tC = "E"
			bPlain = false
		end
	end
	if bPlain
		return tS
	end
	nP = $nStzPlaces
	nScale = 1
	for k = 1 to nP
		nScale = nScale * 10
	end
	fV = Float(xV)
	bNeg = fV < Float(0)
	if bNeg
		fV = Float(0) - fV
	end
	nI = Floor(fV * Float(nScale) + 0.5f)
	if nP = 0
		tR = String(nI)
	else
		nW = _Q((nI - nI % nScale), nScale)
		tF = String(nI % nScale)
		while Len(tF) < nP
			tF = "0" + tF
		end
		tR = String(nW) + "." + tF
	end
	if bNeg and nI != 0
		tR = "-" + tR
	end
	return tR
end

# A condition as true or false: a 1 or 0 from older code, or a boolean.
func _StzB(xV)
	if IsNumber(xV)
		return xV != 0
	end
	return xV
end

# The absolute value of any number: exact for an integer or a decimal, a float for a float.
func _StzAbs(xV)
	try
		if xV < 0
			return 0 - xV
		end
		return xV
	catch e
		fV = Float(xV)
		if fV < Float(0)
			return Float(0) - fV
		end
		return fV
	end
end

# A quotient as the older code took it: exact when one exists; otherwise, taken through floats, a float.
func _Q(xA, xB)
	try
		return xA / xB
	catch e
	end
	return _StzF(xA) / _StzF(xB)
end

# A comparison as the older code made it, where every number was of one kind: the comparison itself when both
# sides are of one kind; otherwise both sides as floats, equal when neither is below the other, and a NaN equal
# to nothing.
func _C(xA, tOp, xB)
	try
		if tOp = "="
			return xA = xB
		end
		if tOp = "!="
			return xA != xB
		end
		if tOp = "<"
			return xA < xB
		end
		if tOp = ">"
			return xA > xB
		end
		if tOp = "<="
			return xA <= xB
		end
		return xA >= xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	bNaN = _StzNaN(fA) or _StzNaN(fB)
	if tOp = "="
		return not bNaN and not (fA < fB) and not (fA > fB)
	end
	if tOp = "!="
		return bNaN or fA < fB or fA > fB
	end
	if bNaN
		return false
	end
	if tOp = "<"
		return fA < fB
	end
	if tOp = ">"
		return fA > fB
	end
	if tOp = "<="
		return not (fA > fB)
	end
	return not (fA < fB)
end

# A number, or a true or false, as a float (the older code read a true as 1).
func _StzF(xV)
	if IsNumber(xV)
		if _StzIsFloat(xV)
			return xV
		end
		return Float(String(xV))
	end
	if xV
		return 1.0f
	end
	return 0.0f
end

# True for a NaN, read from its text.
func _StzNaN(xV)
	if not IsNumber(xV)
		return false
	end
	tS = String(xV)
	return tS = "nan" or tS = "-nan"
end

# True for a float: an integer or a decimal takes a zero added, a float refuses it.
func _StzIsFloat(xV)
	if not IsNumber(xV)
		return false
	end
	try
		xT = xV + 0
		return false
	catch e
		return true
	end
end

# Arithmetic as the older code did it, where every number was of one kind: the operation itself when both sides
# are of one kind; otherwise both sides as floats.
func _A(xA, tOp, xB)
	try
		if tOp = "+"
			return xA + xB
		end
		if tOp = "-"
			return xA - xB
		end
		return xA * xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	if tOp = "+"
		return fA + fB
	end
	if tOp = "-"
		return fA - fB
	end
	return fA * fB
end

# A true or false as the older code held it: 1 or 0.
func _StzI(xB)
	if xB
		return 1
	end
	return 0
end
