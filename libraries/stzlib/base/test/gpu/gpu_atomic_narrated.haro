# GL0 -- ATOMICS (SOFTANZA_GPU_PLAN.md, GL0; the reader's account of the
# language is base/gpu/SOFTANZA_GPU_KERNELS.md, 3.1e).
#
# The fifth admission: an output may be counters that many threads write at
# once. 'out h atomic 16' is 16 i32 counters, and the body is
# '@h[index] += value' (or max=, min=). The transpiler writes WGSL's
# atomicAdd / atomicMax / atomicMin into an engine-made array<atomic<i32>>, the
# real i32 buffer the typed-buffer rung left for this one. An index outside
# the counters is dropped. += counters start at 0, max= at the most negative
# int, min= at the most positive; every host fills them so.
#
# Add, max and min on ints give one answer in any order, so the
# interpreter's count is the device's, bit for bit, however the threads
# arrive.
#
# Two defects this rung's own fuzz found, held here by name:
#   - an untyped index was f32, as every index before it, and the device's
#     float '%' gave 55 for some multiples of 55: @h[@i % 55] dropped threads.
#     A counter index that meets no type is an int now
#   - 1i / 0i between two literals is folded by WGSL at compile time and the
#     kernel refused; an int '/' goes through stz_div, as '%' through stz_rem
#
# Run with haro: haro gpu_atomic_narrated.haro

load "../../stzBase.ring"

$nPass = 0
$nFail = 0

pr()

$nStzPlaces = 3
tNL = Char(10)

? "-- Scene 1: counters many threads add to, in both readers --"
$nT0 = Clock()
oKer = new stzKernelMaker
oKer.TakesVector(:a)
oKer.ReturnsAtomic(:h, 4)
oKer.ForEachElement('{ @h[@a] += 1 }')
chk("the declaration reads back as written: 'out h atomic 4'", StzFindFirst("out h atomic 4", oKer.Spec()) > 0 and StzKernelMakerFromSpec(oKer.Spec()).Spec() = oKer.Spec())
chk("...and the output is 4 counters, whatever n is", oKer.OutputIsAtomic() = 1 and oKer.OutputLength(1000) = 4)
tW = oKer.ToWGSL()
chk("the WGSL binds array<atomic<i32>> and adds through atomicAdd, dropping an index outside",
	StzFindFirst("v_h : array<atomic<i32>>;", tW) > 0 and StzFindFirst("if (k_ >= 0 && k_ < 4) { atomicAdd(&v_h[u32(k_)], 1i); }", tW) > 0)
xH = oKer.EvaluateOn([ [:a, [ 0, 1, 1, 3, 5, -1 ]] ])
chk("the interpreter counts 0 1 1 3 into 1 2 0 1, and drops 5 and -1", _Same(xH, [ 1, 2, 0, 1 ]))
kM = StzKernelMakerFromSpec("in a int" + tNL + "out m atomic 3" + tNL + "body { @m[@i % 2] max= @a }")
chk("max= keeps the largest; a counter nobody touched holds the most negative int",
	_Same(kM.EvaluateOn([ [:a, [ 3, -7, 9, 2 ]] ]), [ 9, 2, -2147483648 ]))
kN = StzKernelMakerFromSpec("in a int" + tNL + "out m atomic 2" + tNL + "body { @m[0] min= @a * 2 }")
chk("min= keeps the smallest; an untouched one holds the most positive", _Same(kN.EvaluateOn([ [:a, [ 3, -7, 9 ]] ]), [ -14, 2147483648 ]))
kW = StzKernelMakerFromSpec("in a int" + tNL + "out h atomic 1" + tNL + "body { @h[0] += 2147483647 }")
chk("the adds wrap, as on every GPU: two threads adding 2147483647 leave -2", _Same(kW.EvaluateOn([ [:a, [ 0, 0 ]] ]), [ -2 ]))
kI = StzKernelMakerFromSpec("in a" + tNL + "out h atomic 55" + tNL + "body { @h[@i % 55] += 1 }")
chk("an untyped counter index is an int: @i % 55 is written stz_rem(i32(i), 55i), not a float '%'",
	StzFindFirst("i32(stz_rem(i32(i), 55i))", kI.ToWGSL()) > 0)
? "  (scene 1: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"

? ""
? "-- Scene 2: what is refused, in the same words by both readers --"
$nT0 = Clock()
xRef = [
	[ "a float added to a counter", "in a" + tNL + "out h atomic 4" + tNL + "body { @h[@a] += 0.5 }", "an atomic output holds ints" ],
	[ "a counter assigned whole", "in a" + tNL + "out h atomic 4" + tNL + "body { @h = 1 }", "an atomic output is written '@h[index] += value'" ],
	[ "a counter stored, not added", "in a" + tNL + "out h atomic 4" + tNL + "body { @h[@a] = 1 }", "an atomic output is written" ],
	[ "an index into a plain output", "in a" + tNL + "out c" + tNL + "body { @c[@i] += 1 }", "declare it 'out c atomic SIZE'" ],
	[ "no counters", "in a" + tNL + "out h atomic 0" + tNL + "body { @h[0] += 1 }", "SIZE a whole number from 1 to 65536" ]
]
for vQ in xRef
	tT = ""
	try
		StzKernelMakerFromSpec(vQ[2]).ToWGSL()
	catch
		tT = cCatchError
	end
	tI = ""
	try
		StzKernelMakerFromSpec(vQ[2]).EvaluateOn([ [:a, [ 1, 2 ]] ])
	catch
		tI = cCatchError
	end
	chk(_T(vQ[1]) + ": both readers refuse it with '" + _T(vQ[3]) + "'", StzFindFirst(vQ[3], tT) > 0 and tT = tI)
end
? "  (scene 2: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"

oG = new stzGpu
bDevice = oG.IsAvailable()
if bDevice
	? ""
	? "-- Scene 3: on the device, every path that makes the counters --"
	$nT0 = Clock()
	xA = [] xB = []
	for i = 1 to 3000
		xA + ((i * 7) % 5)
		xB + ((i * 37) % 201 - 100)
	end
	xV = oG.VerifySpecWith(oKer, oKer, [ [:a, xA] ], [ [:n, 3000] ])
	chk("the checker verifies the histogram at both shapes (" + _T(xV[:verdict]) + ")", xV[:verdict] = "verified")
	kS = StzKernelMakerFromSpec("in b int" + tNL + "out h atomic 55" + tNL + "guard { @i < n and @b != 0 }" + tNL + "body { @h[@i % 55] += clamp(@b, -50, 50) }")
	xV = oG.VerifySpecWith(kS, kS, [ [:b, xB] ], [ [:n, 3000] ])
	chk("sums of ints into 55 counters, with a guard: the case the float index lost (" + _T(xV[:verdict]) + ")", xV[:verdict] = "verified")
	kX = StzKernelMakerFromSpec("in b int" + tNL + "out m atomic 7" + tNL + "body { @m[@b % 7] max= @b * @b - @i }")
	xV = oG.VerifySpecWith(kX, kX, [ [:b, xB] ], [ [:n, 3000] ])
	chk("max= from 3000 threads, negative indices dropped (" + _T(xV[:verdict]) + ")", xV[:verdict] = "verified")
	kD = StzKernelMakerFromSpec("in b int" + tNL + "out h atomic 2" + tNL + "body { @h[0] += 1 / 0 + @b / (@b - @b) }")
	xV = oG.VerifySpecWith(kD, kD, [ [:b, xB] ], [ [:n, 3000] ])
	chk("1 / 0 between literals compiles and gives the dividend, as a runtime zero does (" + _T(xV[:verdict]) + ")", xV[:verdict] = "verified")
	xRun = oG.RunQWith(oKer, [ [:a, [ 0, 1, 1, 3, 5, -1 ]] ], []).Download()
	chk("RunQWith fills the counters and reads them as ints: " + _T(@@(xRun)), _Same(xRun, [ 1, 2, 0, 1 ]))
	xCh = oG.UploadQ([ 3, -7, 9, 2 ]).ApplyQ(kM).Download()
	chk("ApplyQ starts max= counters at the most negative int: " + _T(@@(xCh)), _Same(xCh, [ 9, 2, -2147483648 ]))
	bRef = false
	try
		oG.UploadQ([ 1, 2 ]).ApplyQ(kM).ApplyQ(oKer)
	catch
		bRef = StzFindFirst("whole-number counters", cCatchError) > 0
	end
	chk("...and refuses to hand counters to the next kernel as floats", bRef)
	? "  (scene 3: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"

	? ""
	? "-- Scene 4: the fuzz's atomic kind, and its control --"
	$nT0 = Clock()
	nSeed = 20261028
	StzEngineGpuFuzzRun(nSeed, 300, 4096, 0.00001)
	? "  generated " + _T(StzEngineGpuFuzzResult(46)) + " atomic kernels; ran " + _T(StzEngineGpuFuzzResult(4)) + ", agreed " + _T(StzEngineGpuFuzzResult(5)) + " (exact " + _T(StzEngineGpuFuzzResult(9)) + ")"
	chk("300 kernels: no split, no compile failure, nothing past the counters",
		StzEngineGpuFuzzResult(46) = 300 and StzEngineGpuFuzzResult(2) = 0 and StzEngineGpuFuzzResult(3) = 0 and StzEngineGpuFuzzResult(7) = 0)
	chk("...and all 300 agree with the interpreter bit for bit, in whatever order the threads arrived",
		StzEngineGpuFuzzResult(5) = 300 and StzEngineGpuFuzzResult(9) = 300 and StzEngineGpuFuzzResult(17) = 0)
	StzEngineGpuFuzzRun(nSeed, 300, 4096 + 64, 0.00001)
	nMut = StzEngineGpuFuzzResult(18)
	nCaught = StzEngineGpuFuzzResult(19)
	? "  operation rotated in " + _T(nMut) + ", caught " + _T(nCaught)
	chk("the control rotates each kernel's operation (add to max to min to add), and all 300 had one", nMut = 300)
	chk("...at least 80% caught (measured 257 of 300; seven escapes read: every index dropped, or one contribution where the operations agree)", nCaught >= 0.8 * nMut)
	StzEngineGpuFuzzRun(nSeed, 300, 512, 0.00001)
	chk("the int kind, its '/' now through stz_div, still agrees bit for bit (300)", StzEngineGpuFuzzResult(5) = 300 and StzEngineGpuFuzzResult(17) = 0)
	? "  (scene 4: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"
end

? ""
? "-- Scene 5: puzzle 17, count the votes --"
$nT0 = Clock()
oQ = StzKernelPuzzleQ("kp-17")
chk("the starter grades 'waiting for your implementation'", oQ.Grade(oQ.Starter()) = "waiting for your implementation")
chk("the task reads in four languages and ends with what the GPU did differently from a loop",
	oQ.Task("en") != "" and oQ.Task("fr") != "" and oQ.Task("ar") != "" and oQ.Task("ha") != "" and StzFindFirst("differently from a loop", oQ.Task("en")) > 0)
tHead = "in a" + tNL + "out h atomic 13" + tNL
vCases = [
	[ "@h[@a] += 1", "verified" ],
	[ "@h[int(@a)] += 1", "verified" ],
	[ "@h[@a % 13] += 1", "verified" ],
	[ "@h[@a] += int(@a)", "mismatch at element 1" ],
	[ "@h[@a - 1] += 1", "mismatch at element 5" ],
	[ "@h[@a] max= 1", "mismatch at element 1" ]
]
nAgree = 0
for vQ in vCases
	tSpec = tHead + "body { " + _T(vQ[1]) + " }"
	if bDevice
		tV = oQ.Grade(tSpec)
	else
		tV = oQ.GradeOnCpu(tSpec)
	end
	chk(_T(vQ[1]) + " -> " + _T(vQ[2]) + " (" + tV + ")", tV = vQ[2])
	if oQ.GradeOnCpu(tSpec) = vQ[2]
		nAgree++
	end
end
chk("GradeOnCpu says the same words for all " + _T(Len(vCases)) + " cases", nAgree = Len(vCases))
tV = oQ.Grade(tHead + "body { @h[@a] += 0.5 }")
chk("half a vote is refused by name (" + tV + ")", StzFindFirst("refused", tV) = 1 and StzFindFirst("holds ints", tV) > 0)
if bDevice
	oE = StzExerciseQ("../../education/program/courses/kernel-puzzles/exercises/kp-17")
	# the parent lets go of the card first: since the GPU lease (2026-11-14) the graders ProveItself starts
	# cannot take it from their own parent, and would wait and answer "waiting for the device" (KP-PROVE-FLAKE)
	StzEngineGpuShutdown()
	xPr = oE.ProveItself()
	chk("the exercise proves itself through the System's checker: wrong refused " + _T(xPr[:wrong]) + ", right accepted " + _T(xPr[:right]) + ", failures " + _T(@@(xPr[:failures])),
		xPr[:wrong] = 5 and xPr[:right] = 3 and Len(xPr[:failures]) = 0)
end
? "  (scene 5: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"

? ""
? "=========================================="
? "TOTAL: " + _T(($nPass + $nFail)) + " assertions, " + _T($nPass) + " pass, " + _T($nFail) + " fail"
? "=========================================="

pfq()
Shutdown($nFail)

func chk(tLabel, xCond)
	if _StzB(xCond)
		$nPass++
		? "  [OK] " + tLabel
	else
		$nFail++
		? "  [FAIL] " + tLabel
	end
end
func _Same(pxA, pxB)
	if Len(pxA) != Len(pxB)
		return 0
	end
	nQ = Len(pxA)
	for q = 1 to nQ
		if pxA[q] != pxB[q]
			return 0
		end
	end
	return 1
end

# A value as text, as the guard's narration writes it: a text as it is, a whole number plainly, any other number
# to $nStzPlaces places, rounded half away from zero. (The library's one-argument Text and Round shadow the built-ins.)
func _T(xV)
	if IsString(xV)
		return xV
	end
	if not IsNumber(xV)
		return String(xV)
	end
	tS = String(xV)
	nLen = Len(tS)
	bPlain = true
	for k = 1 to nLen
		tC = tS[k]
		if tC = "n" or tC = "i"
			return tS
		end
		if tC = "." or tC = "e" or tC = "E"
			bPlain = false
		end
	end
	if bPlain
		return tS
	end
	nP = $nStzPlaces
	nScale = 1
	for k = 1 to nP
		nScale = nScale * 10
	end
	fV = Float(xV)
	bNeg = fV < Float(0)
	if bNeg
		fV = Float(0) - fV
	end
	nI = Floor(fV * Float(nScale) + 0.5f)
	if nP = 0
		tR = String(nI)
	else
		nW = (nI - nI % nScale) / nScale
		tF = String(nI % nScale)
		while Len(tF) < nP
			tF = "0" + tF
		end
		tR = String(nW) + "." + tF
	end
	if bNeg and nI != 0
		tR = "-" + tR
	end
	return tR
end

# A condition as true or false: a 1 or 0 from older code, or a boolean.
func _StzB(xV)
	if IsNumber(xV)
		return xV != 0
	end
	return xV
end

# The absolute value of any number: exact for an integer or a decimal, a float for a float.
func _StzAbs(xV)
	try
		if xV < 0
			return 0 - xV
		end
		return xV
	catch e
		fV = Float(xV)
		if fV < Float(0)
			return Float(0) - fV
		end
		return fV
	end
end
