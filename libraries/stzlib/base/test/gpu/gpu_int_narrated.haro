# GL0 -- WHOLE NUMBERS (SOFTANZA_GPU_PLAN.md, GL0; the reader's account of
# the language is base/gpu/SOFTANZA_GPU_KERNELS.md, 3.1).
#
# The second admission: a value is an f32, an i32 or a truth value. A
# declaration says which ('in a int', 'scalar k int', 'out c int'). A whole
# number with no decimal point, and the counting names (@i, n, @l, @g ...),
# take the type of the value they meet, and are f32 when they meet none,
# which is what every description before GL0 meant. An int and a float never
# meet without int(...) or float(...).
#
# Both readers were rebuilt as typed recursive descents. The transpiler wrote
# the same WGSL, byte for byte, for 18,000 generated kernels before and after.
#
# Two defects the device showed, held here by name:
#   - the RTX 3050's compiler (wgpu-native 29) takes an i32 '%' as UNSIGNED:
#     -7 % 4 was 1 there, -3 in WGSL. So the transpiler writes every int
#     remainder out itself (stz_rem: a - (a / b) * b), never WGSL's '%'
#   - a sum in a GUARD had its loop written inside the guard's own if, after
#     the guard read it: the device refused every such kernel since KP0. The
#     int fuzz found it on its first run
# And one meaning measured rather than assumed: int() of a value past i32
# saturates at 2147483520, the largest f32 below 2^31, and NaN reads as the
# most negative int. The interpreter follows the device.
#
# Run with haro: haro gpu_int_narrated.haro

load "../../stzBase.ring"

$nPass = 0
$nFail = 0

pr()

$nStzPlaces = 3
tNL = Char(10)

? "-- Scene 1: an int is declared, and a whole number takes its partner's type --"
$nT0 = Clock()
kAr = StzKernelMakerFromSpec("in a int" + tNL + "scalar k int" + tNL + "out c int" + tNL + "body { @c = (@a * 3 + k) / 2 - @a % 4 }")
tW = kAr.ToWGSL()
chk("the declarations read back as written: Spec() is 'in a int', 'scalar k int', 'out c int'",
	StzFindFirst("in a int", kAr.Spec()) = 1 and _C(StzFindFirst("scalar k int", kAr.Spec()), ">", 0) and _C(StzFindFirst("out c int", kAr.Spec()), ">", 0))
chk("the WGSL reads the int input and scalar through i32(), writes 3i and 2i, the int / and % through helpers, and the output through f32()",
	_C(StzFindFirst("v_c[i] = f32(stz_div((i32(v_a[i]) * 3i + i32(p.s_k)), 2i) - stz_rem(i32(v_a[i]), 4i));", tW), ">", 0))
xR = kAr.EvaluateOn([ [:a, [ -7, -1, 0, 5, 9.9 ]], [:k, 1] ])
chk("the interpreter: (a * 3 + 1) / 2 - a % 4 over -7 -1 0 5 9.9 gives -7 0 0 7 13 (a / truncates; 9.9 reads as 9)",
	xR[1] = -7 and _C(xR[2], "=", 0) and _C(xR[3], "=", 0) and _C(xR[4], "=", 7) and _C(xR[5], "=", 13))
kUn = StzKernelMakerFromSpec("in a" + tNL + "out c" + tNL + "body { @c = 3 / 4 + @a }")
chk("a whole number that meets no int is a float, as before GL0: 3 / 4 is 0.75", _C(kUn.EvaluateOn([ [:a, [ 1 ]] ])[1], "=", 1.75) and _C(StzFindFirst("3f / 4f", kUn.ToWGSL()), ">", 0))
kIx = StzKernelMakerFromSpec("in a int" + tNL + "out c int" + tNL + "body { @c = @i * @a + n }")
chk("@i and n meet an int and become ints: i32(i) * i32(v_a[i]) + i32(p.n)", _C(StzFindFirst("i32(i) * i32(v_a[i]) + i32(p.n)", kIx.ToWGSL()), ">", 0))
kCv = StzKernelMakerFromSpec("in a" + tNL + "out c int" + tNL + "body { @c = int(@a) }")
xC = kCv.EvaluateOn([ [:a, [ 2.7, -2.7 ]] ])
chk("int() goes toward zero: 2.7 and -2.7 give 2 and -2", _C(xC[1], "=", 2) and _C(xC[2], "=", -2))
? "  (scene 1: " + _T((_Q((Clock() - $nT0), ClocksPerSecond()))) + " s)"

? ""
? "-- Scene 2: what is refused, in the same words by both readers --"
$nT0 = Clock()
xRef = [
	[ "an int meeting a float", "in a int" + tNL + "out c int" + tNL + "body { @c = @a + 0.5 }", "an int and a float meet at '+'" ],
	[ "a float function on an int", "in a int" + tNL + "out c int" + tNL + "body { @c = sqrt(@a) }", "'sqrt' works on floats: write sqrt(float(...))" ],
	[ "a float into an int output", "in a" + tNL + "out c int" + tNL + "body { @c = @a }", "holds ints; its value is a float" ],
	[ "an int into a float output", "in a int" + tNL + "out c" + tNL + "body { @c = @a }", "holds floats; its value is an int" ],
	[ "a literal past i32", "in a int" + tNL + "out c int" + tNL + "body { @c = @a + 2147483648 }", "too large for an int" ],
	[ "an int compared with a float", "in a int" + tNL + "out c" + tNL + "guard { @a > 0.5 }" + tNL + "body { @c = 1 }", "meet at '>'" ],
	[ "two types in one when", "in a int" + tNL + "out c int" + tNL + "body { @c = when(@a > 0, @a, 0.5) }", "meet at 'when'" ],
	[ "an unknown type word", "in a word" + tNL + "out c" + tNL + "body { @c = 1 }", "'word' is not a type" ],
	[ "an int staged into a shared array", "in a int" + tNL + "out c" + tNL + "shared t 256" + tNL + "stage { @t[@l] = @a }" + tNL + "body { @c = @t[0] }", "a shared array holds floats" ]
]
for vQ in xRef
	tT = ""
	try
		StzKernelMakerFromSpec(vQ[2]).ToWGSL()
	catch
		tT = cCatchError
	end
	tI = ""
	try
		StzKernelMakerFromSpec(vQ[2]).EvaluateOnWith([ [:a, [ 1, 2 ]] ], [ [:n, 2] ])
	catch
		tI = cCatchError
	end
	chk(_T(vQ[1]) + ": both readers refuse it with '" + _T(vQ[3]) + "'", _C(StzFindFirst(vQ[3], tT), ">", 0) and tT = tI)
end
? "  (scene 2: " + _T((_Q((Clock() - $nT0), ClocksPerSecond()))) + " s)"

oG = new stzGpu
bDevice = oG.IsAvailable()
if bDevice
	? ""
	? "-- Scene 3: on the device, the edges where an int is decided --"
	$nT0 = Clock()
	vCases = [
		[ "a negative remainder: -7 % 4 is -3, the device's own '%' said 1", "in a int" + tNL + "out c int" + tNL + "body { @c = @a % 4 }", [ -7, -1, 7 ] ],
		[ "a wrapped product into a remainder: (2 * 2147483647) % 100000 is -2", "in a int" + tNL + "out c int" + tNL + "body { @c = (@a * 2147483647) % 100000 }", [ 2, 3 ] ],
		[ "division and remainder by zero: the dividend, and 0", "in a int" + tNL + "out c int" + tNL + "body { @c = @a / (@a - @a) * 1000 + @a % (@a - @a) }", [ -7, 0, 5 ] ],
		[ "the most negative int over -1: itself, remainder 0", "in a int" + tNL + "out c int" + tNL + "body { @c = (0 - 2147483647 - 1) / (@a - @a - 1) + (0 - 2147483647 - 1) % (@a - @a - 1) }", [ 1, 2 ] ],
		[ "int() past the range: 2147483520 and the most negative int", "in a" + tNL + "out c int" + tNL + "body { @c = int(@a * 1000000000) }", [ 3, -3 ] ],
		[ "int() of infinity and of NaN", "in a" + tNL + "out c int" + tNL + "body { @c = int(1 / (@a - @a)) + int((@a - @a) / (@a - @a)) * 0 }", [ 3 ] ],
		[ "a sum in a guard: its loop now comes before the guard's if", "in a int" + tNL + "out c int" + tNL + "guard { @i < n and sum(k, 0, 3, @a[@i + k]) > 0 }" + tNL + "body { @c = @a }", [ 1, 5, 2, 2, 3 ] ]
	]
	for vQ in vCases
		oKer = StzKernelMakerFromSpec(vQ[2])
		xD = oG.UploadQ(vQ[3]).ApplyQ(oKer).Download()
		xI = oKer.EvaluateOnWith([ [:a, vQ[3]] ], [ [:n, Len(vQ[3])] ])
		chk(_T(vQ[1]) + ": device " + _T(@@(xD)) + ", interpreter " + _T(@@(xI)), _SameNumbers(xD, xI))
	end
	xV = oG.VerifySpecWith(kAr, kAr, [ [:a, [ -7, -1, 0, 5, 9, 300, -300 ]], [:k, 1] ], [ [:n, 7] ])
	chk("the arithmetic of scene 1 is verified on the device (" + _T(xV[:verdict]) + ")", xV[:verdict] = "verified")
	? "  (scene 3: " + _T((_Q((Clock() - $nT0), ClocksPerSecond()))) + " s)"

	? ""
	? "-- Scene 4: the fuzz's int kind, and its control --"
	$nT0 = Clock()
	nSeed = 20261028
	StzEngineGpuFuzzRun(nSeed, 300, 512, 0.00001)
	? "  generated " + _T(StzEngineGpuFuzzResult(40)) + " int kernels; ran " + _T(StzEngineGpuFuzzResult(4)) + ", agreed " + _T(StzEngineGpuFuzzResult(5)) + " (exact " + _T(StzEngineGpuFuzzResult(9)) + ")"
	chk("300 int kernels: no split, no compile failure", _C(StzEngineGpuFuzzResult(40), "=", 300) and _C(StzEngineGpuFuzzResult(2), "=", 0) and _C(StzEngineGpuFuzzResult(3), "=", 0))
	chk("...and all 300 agree with the interpreter bit for bit: wrapping, division by zero and conversions included",
		StzEngineGpuFuzzResult(5) = 300 and _C(StzEngineGpuFuzzResult(9), "=", 300) and _C(StzEngineGpuFuzzResult(17), "=", 0))
	StzEngineGpuFuzzRun(nSeed, 300, 512 + 64, 0.00001)
	nMut = StzEngineGpuFuzzResult(18)
	nCaught = StzEngineGpuFuzzResult(19)
	? "  mutated " + _T(nMut) + ", caught " + _T(nCaught)
	chk("the control: over a hundred int kernels had a '+' to break", _C(nMut, ">", 100))
	chk("...and at least 75% were caught (measured 100 of 124 on 2026-10-28; ten escapes read, nine cannot change an answer)", _C(nCaught, ">=", 0.75 * nMut))
	StzEngineGpuFuzzRun(nSeed, 300, 63, 0.00001)
	chk("the six float kinds, rewritten by the typed readers, still all agree (219 exactly)", _C(StzEngineGpuFuzzResult(5), "=", 300) and _C(StzEngineGpuFuzzResult(9), "=", 219))
	? "  (scene 4: " + _T((_Q((Clock() - $nT0), ClocksPerSecond()))) + " s)"
end

? ""
? "-- Scene 5: puzzle 14, roll the dice --"
$nT0 = Clock()
oQ = StzKernelPuzzleQ("kp-14")
chk("the starter grades 'waiting for your implementation'", oQ.Grade(oQ.Starter()) = "waiting for your implementation")
chk("the task reads in four languages and ends with what the GPU did differently from a loop",
	oQ.Task("en") != "" and oQ.Task("fr") != "" and oQ.Task("ar") != "" and oQ.Task("ha") != "" and _C(StzFindFirst("differently from a loop", oQ.Task("en")), ">", 0))
vCases = [
	[ "in a int" + tNL + "out c int" + tNL + "body { @c = (@a * 1664525 + 1013904223) % 1000 }", "verified" ],
	[ "in a int" + tNL + "out c int" + tNL + "body { @c = (@a * 525 + 223) % 1000 }", "verified" ],
	[ "in a" + tNL + "out c" + tNL + "body { @c = (@a * 1664525 + 1013904223) % 1000 }", "mismatch at element 1" ],
	[ "in a int" + tNL + "out c int" + tNL + "body { @c = @a * 1664525 + 1013904223 % 1000 }", "mismatch at element 2" ]
]
nAgree = 0
for vQ in vCases
	if bDevice
		tV = oQ.Grade(vQ[1])
	else
		tV = oQ.GradeOnCpu(vQ[1])
	end
	vtL = StzSplit(vQ[1], tNL)
	chk(_T(vtL[1]) + " / " + _T(vtL[Len(vtL)]) + " -> " + _T(vQ[2]) + " (" + tV + ")", tV = vQ[2])
	if _C(oQ.GradeOnCpu(vQ[1]), "=", vQ[2])
		nAgree++
	end
end
chk("GradeOnCpu says the same words for all " + _T(Len(vCases)) + " cases", _C(nAgree, "=", Len(vCases)))
tV = oQ.Grade("in a int" + tNL + "out c int" + tNL + "body { @c = (@a * 1664525 + 1013904223) % 1000.0 }")
chk("a float in the int kernel is refused by name (" + tV + ")", _C(StzFindFirst("refused", tV), "=", 1) and _C(StzFindFirst("meet at '%'", tV), ">", 0))
if bDevice
	oE = StzExerciseQ("../../education/program/courses/kernel-puzzles/exercises/kp-14")
	# the parent lets go of the card first: since the GPU lease (2026-11-14) the graders ProveItself starts
	# cannot take it from their own parent, and would wait and answer "waiting for the device" (KP-PROVE-FLAKE)
	StzEngineGpuShutdown()
	xPr = oE.ProveItself()
	chk("the exercise proves itself through the System's checker: wrong refused " + _T(xPr[:wrong]) + ", right accepted " + _T(xPr[:right]) + ", failures " + _T(@@(xPr[:failures])),
		xPr[:wrong] = 5 and _C(xPr[:right], "=", 3) and _C(Len(xPr[:failures]), "=", 0))
end
? "  (scene 5: " + _T((_Q((Clock() - $nT0), ClocksPerSecond()))) + " s)"

? ""
? "=========================================="
? "TOTAL: " + _T(($nPass + $nFail)) + " assertions, " + _T($nPass) + " pass, " + _T($nFail) + " fail"
? "=========================================="

pfq()
Shutdown($nFail)

func chk(tLabel, xCond)
	if _StzB(xCond)
		$nPass++
		? "  [OK] " + tLabel
	else
		$nFail++
		? "  [FAIL] " + tLabel
	end
end
func _SameNumbers(pxA, pxB)
	if _C(Len(pxA), "!=", Len(pxB))
		return 0
	end
	nQ = Len(pxA)
	for q = 1 to nQ
		if _C(pxA[q], "!=", pxB[q])
			return 0
		end
	end
	return 1
end

# A value as text, as the guard's narration writes it: a text as it is, a whole number plainly, any other number
# to $nStzPlaces places, rounded half away from zero. (The library's one-argument Text and Round shadow the built-ins.)
func _T(xV)
	if IsString(xV)
		return xV
	end
	if not IsNumber(xV)
		return String(xV)
	end
	tS = String(xV)
	nLen = Len(tS)
	bPlain = true
	for k = 1 to nLen
		tC = tS[k]
		if tC = "n" or tC = "i"
			return tS
		end
		if tC = "." or tC = "e" or tC = "E"
			bPlain = false
		end
	end
	if bPlain
		return tS
	end
	nP = $nStzPlaces
	nScale = 1
	for k = 1 to nP
		nScale = nScale * 10
	end
	fV = Float(xV)
	bNeg = fV < Float(0)
	if bNeg
		fV = Float(0) - fV
	end
	nI = Floor(fV * Float(nScale) + 0.5f)
	if nP = 0
		tR = String(nI)
	else
		nW = _Q((nI - nI % nScale), nScale)
		tF = String(nI % nScale)
		while Len(tF) < nP
			tF = "0" + tF
		end
		tR = String(nW) + "." + tF
	end
	if bNeg and nI != 0
		tR = "-" + tR
	end
	return tR
end

# A condition as true or false: a 1 or 0 from older code, or a boolean.
func _StzB(xV)
	if IsNumber(xV)
		return xV != 0
	end
	return xV
end

# The absolute value of any number: exact for an integer or a decimal, a float for a float.
func _StzAbs(xV)
	try
		if xV < 0
			return 0 - xV
		end
		return xV
	catch e
		fV = Float(xV)
		if fV < Float(0)
			return Float(0) - fV
		end
		return fV
	end
end

# A quotient as the older code took it: exact when one exists; otherwise, taken through floats, a decimal to
# nine places, or a float when either side is a float.
func _Q(xA, xB)
	try
		return xA / xB
	catch e
	end
	fQ = Float(String(xA)) / Float(String(xB))
	if _StzIsFloat(xA) or _StzIsFloat(xB)
		return fQ
	end
	try
		return Decimal(fQ, 9)
	catch e
		return fQ
	end
end

# A comparison as the older code made it, where every number was of one kind: the comparison itself when both
# sides are of one kind; otherwise both sides as floats, equal when neither is below the other, and a NaN equal
# to nothing.
func _C(xA, tOp, xB)
	try
		if tOp = "="
			return xA = xB
		end
		if tOp = "!="
			return xA != xB
		end
		if tOp = "<"
			return xA < xB
		end
		if tOp = ">"
			return xA > xB
		end
		if tOp = "<="
			return xA <= xB
		end
		return xA >= xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	bNaN = _StzNaN(fA) or _StzNaN(fB)
	if tOp = "="
		return not bNaN and not (fA < fB) and not (fA > fB)
	end
	if tOp = "!="
		return bNaN or fA < fB or fA > fB
	end
	if bNaN
		return false
	end
	if tOp = "<"
		return fA < fB
	end
	if tOp = ">"
		return fA > fB
	end
	if tOp = "<="
		return not (fA > fB)
	end
	return not (fA < fB)
end

# A number, or a true or false, as a float (the older code read a true as 1).
func _StzF(xV)
	if IsNumber(xV)
		if _StzIsFloat(xV)
			return xV
		end
		return Float(String(xV))
	end
	if xV
		return 1.0f
	end
	return 0.0f
end

# True for a NaN, read from its text.
func _StzNaN(xV)
	if not IsNumber(xV)
		return false
	end
	tS = String(xV)
	return tS = "nan" or tS = "-nan"
end

# True for a float: an integer or a decimal takes a zero added, a float refuses it.
func _StzIsFloat(xV)
	if not IsNumber(xV)
		return false
	end
	try
		xT = xV + 0
		return false
	catch e
		return true
	end
end

# Arithmetic as the older code did it, where every number was of one kind: the operation itself when both sides
# are of one kind; otherwise both sides as floats.
func _A(xA, tOp, xB)
	try
		if tOp = "+"
			return xA + xB
		end
		if tOp = "-"
			return xA - xB
		end
		return xA * xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	if tOp = "+"
		return fA + fB
	end
	if tOp = "-"
		return fA - fB
	end
	return fA * fB
end
