# GK2b's matmul leg -- the matmul op's variants through the foundry, under
# GK0's checker, on the shapes the neural backbone dispatches
# (SOFTANZA_GPU_PLAN.md, section GK).
#
# C(m x n) = A(m x k) B(k x n). Seven kernels on one contract, every one on a
# LINEAR workgroup grid so the checker can judge them all: tile16 (the G0
# spike kernel, the generic), tile8, reg2 (each thread a 2x2 block), reg4
# (4x4), and GK2d's reg4s (4x4, strided ownership), reg8 (8x8 over a 128 x
# 128 tile) and reg8p (reg8 with the next tile prefetched). A broken sibling (reg2 with one element wrong) exists for the
# checker to refuse. The winner per (m, n, k) class lands in the variant
# table under "matmul", is persisted beside pairdist's rows, and the
# backbone compiles that winner with its bias fused for its own shapes.
#
# What this guard asserts, mechanism first, negative sibling beside each:
#   - at the backbone's shapes (tokens x 384 x 384, tokens x 384 x 1536,
#     tokens x 1536 x 384) every variant is VERIFIED at the visible shape and
#     the hidden one, and the verdict per cell is printed
#   - the broken sibling is REFUSED through the mask; the table rejects it
#   - a set variant DISPATCHES through the op (the variant counter moves) and
#     answers the generic's product within f32; cleared, the counter stays
#   - the neural DLL's own table takes a row and answers it for that class
#   - the backbone (MiniLM, 130 tokens) dispatches the synced winners with
#     the bias fused: the forward is faster and the embedding unchanged

load "../../stzBase.ring"

$nPass = 0
$nFail = 0

pr()

$nStzPlaces = 4

if _C(StzEngineGpuInit($tStzGpuRuntime), "=", 0) or _C(StzEngineGpuIsAvailable(), "=", 0)
	? "  NO GPU ON THIS MACHINE -- the foundry cannot run; the table's refusals are the coverage"
	chk("the table refuses the broken matmul variant without a device", _C(StzEngineGpuVariantSet("matmul", 256, 384, 384, 4), "!=", 0))
else
	oG = new stzGpu
	oG.Wake(400)
	xSaved = StzGpuVariants()
	vCalFiles = [ StzGpuCalibFileDefault(), StzGpuCalibFileForAdapter() ]
	vCalBackup = []
	for tF in vCalFiles
		if tF != "" and FExists(tF)
			vCalBackup + [ tF, Read(tF) ]
		else
			vCalBackup + [ tF, "" ]
		end
	end
	StzEngineGpuVariantClear()

	? "-- Scene 1: the backbone's shapes, every variant under the checker --"
	nCells = 0
	nAllOk = 0
	for xCell in [ [64, 384, 384], [256, 384, 384], [256, 384, 1536], [256, 1536, 384], [512, 384, 1536] ]
		xR = oG.FoundryMatmulWith(xCell[1], xCell[2], xCell[3], 7)
		tRow = "  " + _T(xCell[1]) + " x " + _T(xCell[2]) + " x " + _T(xCell[3]) + ": generic " + _T(xR[:refgpums]) + " ms |"
		bAll = true
		for v in xR[:variants]
			if _C(v[2], "=", 1)
				tRow += " " + _T(v[1]) + " " + _T(v[5]) + "x"
			elseif _C(v[2], "=", 0)
				tRow += " " + _T(v[1]) + " REFUSED"
				bAll = false
			end
		end
		tRow += " | winner " + _T(xR[:winner]) + " " + _T(xR[:ratio]) + "x"
		? tRow
		# GK3: the same cells as fractions of what the device CAN do (peak, copy bandwidth)
		tFr = "      of peak " + _T(xR[:peakgflops]) + " GFLOP/s:"
		for f in xR[:fractions]
			tFr += " " + _T(f[1]) + " " + _T((Floor(_A(f[3], "*", 1000)) / 10)) + "% / " + _T((Floor(_A(f[4], "*", 1000)) / 10)) + "% bw"
		end
		? tFr
		nCells++
		if bAll nAllOk++ end
	end
	chk("six real variants were proposed (GK2d added reg4s, reg8, reg8p)", _C(Len(xR[:variants]), "=", 6))
	chk("every variant is VERIFIED in every cell (right at every shape it was shown and hidden)", _C(nAllOk, "=", nCells))
	chk("the hidden shape is another, odd n", _C(xR[:hiddenn], "!=", 1536) and _C((xR[:hiddenn] % 2), "=", 1))

	? ""
	? "-- Scene 2: the broken sibling is refused, and the table will not take it --"
	nSt = StzEngineGpuFoundryMatmul(64, 384, 384, 3, 16)
	# the broken variant's verdict: F_BASE (10) + 4 x 5. This read 8 + 4 x 5 = 28 -- a masked
	# variant's slot, always 0 -- from GK3 (which moved F_BASE to 10) until GK2d found it, so
	# "refused" held whatever the checker said
	nBroken = StzEngineGpuFoundryResult(_A(10, "+", 4 * 5))
	? "  broken (mask bit 4): verified flag " + _T(nBroken) + "   winner " + _T(StzEngineGpuFoundryResult(3))
	chk("the foundry ran the broken variant when asked", _C(nSt, "=", 0) and _C(nBroken, "!=", -2))
	chk("...and the checker REFUSED it (one element off is not the same product)", _C(nBroken, "=", 0))
	chk("...so it cannot be the winner", _C(StzEngineGpuFoundryResult(3), "=", 0))
	chk("...and the table refuses it outright", _C(StzEngineGpuVariantSet("matmul", 64, 384, 384, 4), "!=", 0))

	? ""
	? "-- Scene 3: a set variant dispatches through the op, and multiplies like the generic --"
	nM = 96
	nK = 384
	nN = 512
	nHA = StzEngineGpuBufferNew(_A(_A(nM, "*", nK), "*", 4))
	nHB = StzEngineGpuBufferNew(_A(_A(nK, "*", nN), "*", 4))
	nHC = StzEngineGpuBufferNew(_A(_A(nM, "*", nN), "*", 4))
	StzEngineGpuBufferFillLcg(nHA, _A(nM, "*", nK), 11)
	StzEngineGpuBufferFillLcg(nHB, _A(nK, "*", nN), 22)
	StzEngineGpuVariantClear()
	nV0 = StzEngineGpuCounter(14)
	StzEngineGpuOpMatmul(nHA, nHB, nHC, nM, nK, nN)
	xGen = StzEngineGpuBufferDownloadList(nHC, _A(nM, "*", nN))
	chk("with the table cleared, the generic multiplied (the variant counter still)", _C(StzEngineGpuCounter(14), "=", nV0) and _C(Len(xGen), "=", _A(nM, "*", nN)))
	for nV in [ 1, 2, 3, 5, 6, 7 ] # 4 is the broken sibling, which the table refuses
		StzEngineGpuVariantSet("matmul", nM, nN, nK, nV)
		nV0 = StzEngineGpuCounter(14)
		StzEngineGpuOpMatmul(nHA, nHB, nHC, nM, nK, nN)
		xVar = StzEngineGpuBufferDownloadList(nHC, _A(nM, "*", nN))
		nMax = 0
		for j = 1 to nM * nN
			xDiff = _StzAbs(_A(xVar[j], "-", xGen[j]))
			if _C(xDiff, ">", nMax) nMax = xDiff end
		end
		? "  " + _T(StzEngineGpuMmVariantName(nV)) + ": variant dispatches " + _T((_A(StzEngineGpuCounter(14), "-", nV0))) + "   max |variant - generic| " + _T(nMax)
		chk(_T(StzEngineGpuMmVariantName(nV)) + " dispatched (the counter moved once)", _C(_A(StzEngineGpuCounter(14), "-", nV0), "=", 1))
		chk("...and the product agrees with the generic within f32 (k = 384 terms in [0,1))", _C(nMax, "<", 0.01))
	end
	StzEngineGpuVariantClear()
	nV0 = StzEngineGpuCounter(14)
	StzEngineGpuOpMatmul(nHA, nHB, nHC, nM, nK, nN)
	chk("cleared, the counter stays still", _C(StzEngineGpuCounter(14), "=", nV0))
	StzEngineGpuBufferFree(nHA)
	StzEngineGpuBufferFree(nHB)
	StzEngineGpuBufferFree(nHC)

	? ""
	? "-- Scene 3b: split-K, a two-pass candidate, under the foundry (GK2e) --"
	# measured 2026-10-28 on the RTX 3050, S = 4 against reg4s: 1.16 to 1.21x faster at
	# 130 x 1536 x 384 (MiniLM's down-projection), 1.48x at 256 x 1536 x 384, and SLOWER where
	# k is shallow (0.70 to 0.86x at 130 x 384 x 1536): it pays only where k is deep
	StzEngineGpuFoundrySplitK(256, 1536, 384, 4, 7, 5)
	? "  256 x 1536 x 384, S = 4: reg4s " + _T(StzEngineGpuFoundrySplitKResult(3)) + " ms, split-K " + _T(StzEngineGpuFoundrySplitKResult(4)) + " ms, ratio " + _T(StzEngineGpuFoundrySplitKResult(7)) + "   diff " + _T(StzEngineGpuFoundrySplitKResult(1)) + " / hidden " + _T(StzEngineGpuFoundrySplitKResult(2))
	chk("split-K's two passes agree with the generic at the visible and the hidden shape, and the judge accepts their time", _C(StzEngineGpuFoundrySplitKResult(0), "=", 1))
	chk("...and where k is deep they beat the best single pass (ratio over 1.1; measured 1.48)", _C(StzEngineGpuFoundrySplitKResult(7), ">", 1.1))
	StzEngineGpuFoundrySplitK(130, 384, 1536, 4, 7, 5)
	? "  130 x 384 x 1536, S = 4: ratio " + _T(StzEngineGpuFoundrySplitKResult(7))
	chk("...where k is shallow they lose to it (ratio under 1; measured 0.70 to 0.86)", _C(StzEngineGpuFoundrySplitKResult(0), "=", 1) and _C(StzEngineGpuFoundrySplitKResult(7), "<", 1))
	chk("a split count out of range is refused", _C(StzEngineGpuFoundrySplitK(130, 384, 384, 0, 3, 5), "!=", 0) and _C(StzEngineGpuFoundrySplitK(130, 384, 384, 4, 3, 4), "!=", 0))

	? ""
	? "-- Scene 4: the neural DLL's own table takes the persisted verdict --"
	StzEngineNeuralVariantClear()
	StzEngineNeuralVariantSet("matmul", 256, 1536, 384, 3)
	chk("the neural DLL's table answers the row for its class", _C(StzEngineNeuralVariantGet("matmul", 256, 1536, 384), "=", 3))
	chk("...and the generic for a class nobody set", _C(StzEngineNeuralVariantGet("matmul", 64, 384, 384), "=", 0))
	chk("...and refuses the broken sibling too", _C(StzEngineNeuralVariantSet("matmul", 256, 1536, 384, 4), "!=", 0))
	StzEngineNeuralVariantClear()

	? ""
	? "-- Scene 5: the backbone dispatches the winners, bias fused, and the forward is faster --"
	tModel = "../../../models/all-MiniLM-L6-v2.Q8_0.gguf"
	if not FExists(tModel)
		? "  no local MiniLM -- the backbone scene needs models/; the op-level scenes above are the coverage"
	else
		StzEngineNeuralModelLoad(tModel)
		tText = ""
		for i = 1 to 12
			tText += "the quick brown fox jumps over the lazy dog and runs away "
		end
		StzEngineNeuralGpuSetThreshold(1000000)
		# the winners for the backbone's three shapes, measured here and now
		oG.FoundryMatmulWith(130, 384, 384, 5)
		oG.FoundryMatmulWith(130, 384, 1536, 5)
		oG.FoundryMatmulWith(130, 1536, 384, 5)
		# BEFORE: the neural DLL's own table empty, the sync held off
		StzEngineNeuralVariantClear()
		$bStzNeuralVariantsSynced_ = true
		StzEngineNeuralEmbed(tText)
		nBefore = 1000000000
		for r = 1 to 7
			nT0 = StzEngineWatchTimestampNs()
			StzEngineNeuralEmbed(tText)
			nMs = (_A(StzEngineWatchTimestampNs(), "-", nT0)) / 1000000
			if _C(nMs, "<", nBefore) nBefore = nMs end
		end
		vVecB = []
		nDimB = StzEngineNeuralEmbed(tText)
		for i = 1 to nDimB
			vVecB + StzEngineNeuralEmbedAt(i - 1)
		end
		# AFTER: the verdicts synced across
		$bStzNeuralVariantsSynced_ = false
		StzNeuralVariantsSync()
		nRow = StzEngineNeuralVariantGet("matmul", 130, 1536, 384)
		StzEngineNeuralEmbed(tText)
		nAfter = 1000000000
		for r = 1 to 7
			nT0 = StzEngineWatchTimestampNs()
			StzEngineNeuralEmbed(tText)
			nMs = (_A(StzEngineWatchTimestampNs(), "-", nT0)) / 1000000
			if _C(nMs, "<", nAfter) nAfter = nMs end
		end
		vVecA = []
		nDimA = StzEngineNeuralEmbed(tText)
		for i = 1 to nDimA
			vVecA + StzEngineNeuralEmbedAt(i - 1)
		end
		nMaxD = 0
		for i = 1 to nDimA
			xDiff = _StzAbs(_A(vVecA[i], "-", vVecB[i]))
			if _C(xDiff, ">", nMaxD) nMaxD = xDiff end
		end
		? "  backbone forward at 130 tokens, warm-min of 7: generic " + _T(nBefore) + " ms   winners " + _T(nAfter) + " ms   = " + _T((_Q(nBefore, nAfter))) + "x   max |embedding difference| " + _T(nMaxD)
		chk("the sync landed a winner for the backbone's FFN class in the neural DLL's table", _C(nRow, ">", 0))
		chk("the backbone forward is at least 1.5x faster with the winners (bias fused, same answer)", _C(_Q(nBefore, nAfter), ">=", 1.5))
		chk("...and the embedding is the same within f32 (max difference < 1e-4 on unit vectors)", _C(nDimA, "=", nDimB) and _C(nMaxD, "<", 0.0001))
		StzEngineNeuralVariantClear()
		$bStzNeuralVariantsSynced_ = false
		StzEngineNeuralModelFree()
	end

	# the files and the tables as they were
	nB = Len(vCalBackup)
	for i = 1 to nB
		if vCalBackup[i][1] != ""
			if vCalBackup[i][2] != ""
				Write(vCalBackup[i][1], vCalBackup[i][2])
			elseif FExists(vCalBackup[i][1])
				Remove(vCalBackup[i][1])
			end
		end
	end
	StzEngineGpuVariantClear()
	nS = Len(xSaved)
	for i = 1 to nS
		StzGpuVariantSet(xSaved[i][1], xSaved[i][2], xSaved[i][3], xSaved[i][4], xSaved[i][5])
	end
end

? ""
? "=========================================="
? "TOTAL: " + _T((_A($nPass, "+", $nFail))) + " assertions, " + _T($nPass) + " pass, " + _T($nFail) + " fail"
? "=========================================="

pfq()
Shutdown($nFail)

func chk(tLabel, xCond)
	if _StzB(xCond)
		$nPass++
		? "  [OK] " + tLabel
	else
		$nFail++
		? "  [FAIL] " + tLabel
	end
end

# A value as text, as the guard's narration writes it: a text as it is, a whole number plainly, any other number
# to $nStzPlaces places, rounded half away from zero. (The library's one-argument Text and Round shadow the built-ins.)
func _T(xV)
	if IsString(xV)
		return xV
	end
	if not IsNumber(xV)
		return String(xV)
	end
	tS = String(xV)
	nLen = Len(tS)
	bPlain = true
	for k = 1 to nLen
		tC = tS[k]
		if tC = "n" or tC = "i"
			return tS
		end
		if tC = "." or tC = "e" or tC = "E"
			bPlain = false
		end
	end
	if bPlain
		return tS
	end
	nP = $nStzPlaces
	nScale = 1
	for k = 1 to nP
		nScale = nScale * 10
	end
	fV = Float(xV)
	bNeg = fV < Float(0)
	if bNeg
		fV = Float(0) - fV
	end
	nI = Floor(fV * Float(nScale) + 0.5f)
	if nP = 0
		tR = String(nI)
	else
		nW = _Q((nI - nI % nScale), nScale)
		tF = String(nI % nScale)
		while Len(tF) < nP
			tF = "0" + tF
		end
		tR = String(nW) + "." + tF
	end
	if bNeg and nI != 0
		tR = "-" + tR
	end
	return tR
end

# A condition as true or false: a 1 or 0 from older code, or a boolean.
func _StzB(xV)
	if IsNumber(xV)
		return xV != 0
	end
	return xV
end

# The absolute value of any number: exact for an integer or a decimal, a float for a float.
func _StzAbs(xV)
	try
		if xV < 0
			return 0 - xV
		end
		return xV
	catch e
		fV = Float(xV)
		if fV < Float(0)
			return Float(0) - fV
		end
		return fV
	end
end

# A quotient as the older code took it: exact when one exists; otherwise, taken through floats, a decimal to
# nine places, or a float when either side is a float.
func _Q(xA, xB)
	try
		return xA / xB
	catch e
	end
	fQ = Float(String(xA)) / Float(String(xB))
	if _StzIsFloat(xA) or _StzIsFloat(xB)
		return fQ
	end
	try
		return Decimal(fQ, 9)
	catch e
		return fQ
	end
end

# A comparison as the older code made it, where every number was of one kind: the comparison itself when both
# sides are of one kind; otherwise both sides as floats, equal when neither is below the other, and a NaN equal
# to nothing.
func _C(xA, tOp, xB)
	try
		if tOp = "="
			return xA = xB
		end
		if tOp = "!="
			return xA != xB
		end
		if tOp = "<"
			return xA < xB
		end
		if tOp = ">"
			return xA > xB
		end
		if tOp = "<="
			return xA <= xB
		end
		return xA >= xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	bNaN = _StzNaN(fA) or _StzNaN(fB)
	if tOp = "="
		return not bNaN and not (fA < fB) and not (fA > fB)
	end
	if tOp = "!="
		return bNaN or fA < fB or fA > fB
	end
	if bNaN
		return false
	end
	if tOp = "<"
		return fA < fB
	end
	if tOp = ">"
		return fA > fB
	end
	if tOp = "<="
		return not (fA > fB)
	end
	return not (fA < fB)
end

# A number, or a true or false, as a float (the older code read a true as 1).
func _StzF(xV)
	if IsNumber(xV)
		if _StzIsFloat(xV)
			return xV
		end
		return Float(String(xV))
	end
	if xV
		return 1.0f
	end
	return 0.0f
end

# True for a NaN, read from its text.
func _StzNaN(xV)
	if not IsNumber(xV)
		return false
	end
	tS = String(xV)
	return tS = "nan" or tS = "-nan"
end

# True for a float: an integer or a decimal takes a zero added, a float refuses it.
func _StzIsFloat(xV)
	if not IsNumber(xV)
		return false
	end
	try
		xT = xV + 0
		return false
	catch e
		return true
	end
end

# Arithmetic as the older code did it, where every number was of one kind: the operation itself when both sides
# are of one kind; otherwise both sides as floats.
func _A(xA, tOp, xB)
	try
		if tOp = "+"
			return xA + xB
		end
		if tOp = "-"
			return xA - xB
		end
		return xA * xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	if tOp = "+"
		return fA + fB
	end
	if tOp = "-"
		return fA - fB
	end
	return fA * fB
end
