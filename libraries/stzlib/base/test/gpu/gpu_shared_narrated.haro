# KP3 -- THE GROUP'S MEMORY (SOFTANZA_GPU_PLAN.md, KP3).
#
# KP0 stopped the grammar at the reduction a single thread can do. KP3
# admits what a tiled matrix product needs: arrays in the workgroup's
# shared memory, a SCHEDULE of stages (one write per thread, then a
# barrier), reduces (the halving tree, a barrier at each step) and a tiles
# loop with a per-thread accumulator; a width line makes the output a
# matrix worked in 16 x 16 tiles. The transpiler and the interpreter read
# them through one parser and refuse the same things with the same words;
# the interpreter runs a GROUP at a time, every item over all 256 threads
# before the next, which is what the barrier promises the kernel.
#
# What this suite asserts, negative siblings beside each:
#   - on the CPU: each group reversed through a stage; a reduce over a
#     partial last group; the tiled product equal to the plain loop and to
#     a product computed here; six refusals, the same words from both readers
#   - on the device: each form verifies itself at a visible and a hidden
#     shape; a kernel that reads shared memory no stage wrote is a mismatch
#     at element 1 -- it PASSED the visible shape before 2026-10-27, reading
#     the previous kernel's values, until the kernel zeroed its own memory;
#     one tile only is caught; a hidden shape given whole is honoured and a
#     short hidden vector refused
#   - puzzles 9 to 12: every right answer verified, every wrong one named,
#     on the device and the CPU in the same words; each exercise proves
#     itself through the System's checker
#   - the roofline: SAXPY sits under the bandwidth roof and a right answer
#     that rereads memory shows a smaller share of it (measured A B A)
#
# Run with haro: haro gpu_shared_narrated.haro

load "../../stzBase.ring"

$nPass = 0
$nFail = 0
$nT0 = Clock()

pr()

$nStzPlaces = 6
tNL = Char(10)

? "-- Scene 0: the group's memory on the CPU, no device --"
$nT0 = Clock()
kRev = StzKernelMakerQ()
kRev.TakesVector(:a)
kRev.ReturnsVector(:c)
kRev.Shared(:t, 256)
kRev.Stage('{ @t[@l] = @a }')
kRev.ForEachElement('{ @c = @t[255 - @l] }')
vRamp = []
for i = 0 to 511
	vRamp + i
end
xR = kRev.EvaluateOn([ [:a, vRamp] ])
chk("a stage then a read across the group: element 1 is 255, element 256 is 0, element 257 is 511",
	_C(xR[1], "=", 255) and _C(xR[256], "=", 0) and _C(xR[257], "=", 511))
tW = kRev.ToWGSL()
chk("...the WGSL declares the array in the group's memory", _C(StzFindFirst("var<workgroup> w_t : array<f32, 256>;", tW), ">", 0))
chk("...zeroes it itself before any stage (WGSL promises it; this machine's runtime did not keep the promise)",
	_C(StzFindFirst("for (var z_ : u32 = l; z_ < 256u; z_ = z_ + 256u) { w_t[z_] = 0.0; }", tW), ">", 0))
chk("...and waits at a barrier after the stage", _C(StzFindFirst("workgroupBarrier();", tW), ">", 0))

kSum = StzKernelMakerQ()
kSum.TakesVector(:a)
kSum.ReturnsVector(:c)
kSum.Shared(:t, 256)
kSum.Stage('{ @t[@l] = @a }')
kSum.Reduce(:t, :sum)
kSum.ForEachElement('{ @c = @t[0] }')
vOnes = []
for i = 1 to 300
	vOnes + 1
end
xR = kSum.EvaluateOn([ [:a, vOnes] ])
chk("a reduce over 300 ones: the first group sums 256, the partial last one 44 (zero past the input)", _C(xR[1], "=", 256) and _C(xR[300], "=", 44))

tMm = "in a" + tNL + "in b" + tNL + "scalar k" + tNL + "scalar w" + tNL + "out c" + tNL + "width w" + tNL +
	"shared ta 256" + tNL + "shared tb 256" + tNL + "tiles t { k / 16 }" + tNL +
	"stage { @ta[@ly * 16 + @lx] = @a[@row * k + t * 16 + @lx] }" + tNL +
	"stage { @tb[@ly * 16 + @lx] = @b[(t * 16 + @ly) * w + @col] }" + tNL +
	"accumulate { @acc = @acc + sum(j, 0, 16, @ta[@ly * 16 + j] * @tb[j * 16 + @lx]) }" + tNL + "body { @c = @acc }"
tPl = "in a" + tNL + "in b" + tNL + "scalar k" + tNL + "scalar w" + tNL + "out c" + tNL + "width w" + tNL +
	"body { @c = sum(j, 0, k, @a[@row * k + j] * @b[j * w + @col]) }"
vMa = []
for i = 0 to 2047
	vMa + ((i * 7) % 13)
end
vMb = []
for i = 0 to 3071
	vMb + ((i * 3) % 7)
end
xBm = [ [ "a", vMa ], [ "b", vMb ], [ "k", 64 ], [ "w", 48 ] ]
kT = StzKernelMakerFromSpec(tMm)
xT = kT.EvaluateOnWith(xBm, [ [:n, 1536] ])
xP = StzKernelMakerFromSpec(tPl).EvaluateOnWith(xBm, [ [:n, 1536] ])
nSame = 0
for i = 1 to 1536
	if _C(xT[i], "=", xP[i])
		nSame++
	end
end
chk("the tiled product (32 x 64 times 64 x 48) equals the plain loop in all 1536 cells", _C(nSame, "=", 1536))
nHere = 0
for xCell in [ [ 0, 0 ], [ 17, 33 ], [ 31, 47 ] ]
	nS = 0
	for j = 0 to 63
		nS += _A(vMa[xCell[1] * 64 + j + 1], "*", vMb[j * 48 + xCell[2] + 1])
	end
	if _C(xT[xCell[1] * 48 + xCell[2] + 1], "=", nS)
		nHere++
	end
end
chk("...and three cells equal the product computed here, by hand", _C(nHere, "=", 3))

xRef = [
	[ "in a" + tNL + "out c" + tNL + "shared t 256" + tNL + "stage { @t[@l] = @t[@l + 1] }" + tNL + "body { @c = @t[0] }", "cannot read the array it writes" ],
	[ "in a" + tNL + "out c" + tNL + "shared t 256" + tNL + "tiles q { @i }" + tNL + "stage { @t[@l] = @a }" + tNL + "body { @c = @t[0] }", "same for every thread" ],
	[ "in a" + tNL + "out c" + tNL + "body { @c = @a + @row }", "needs a width line" ],
	[ "in a" + tNL + "out c" + tNL + "shared t 256" + tNL + "stage { @t[@l] = @a }" + tNL + "body { @c = @t }", "read one slot" ],
	[ "in a" + tNL + "out c" + tNL + "shared t 300" + tNL + "stage { @t[@l] = @a }" + tNL + "reduce t sum" + tNL + "body { @c = @t[0] }", "power of two" ],
	[ "in a" + tNL + "out c" + tNL + "shared t 256" + tNL + "accumulate { @acc = @a }" + tNL + "body { @c = @acc }", "inside a tiles loop" ]
]
for xCase in xRef
	tT = ""
	try
		StzKernelMakerFromSpec(xCase[1]).ToWGSL()
	catch
		tT = cCatchError
	end
	tE = ""
	try
		StzKernelMakerFromSpec(xCase[1]).EvaluateOn([ [:a, [ 1, 2, 3 ]] ])
	catch
		tE = cCatchError
	end
	chk("refused by both readers, naming the offender: '" + _T(xCase[2]) + "'",
		_C(StzFindFirst(xCase[2], tT), ">", 0) and _C(StzFindFirst(xCase[2], tE), ">", 0))
end
? "  (scene 0: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"

bDevice = (_C(StzEngineGpuInit($tStzGpuRuntime), "!=", 0) and _C(StzEngineGpuIsAvailable(), "!=", 0))
if bDevice
	? ""
	? "-- Scene 1: the same forms on the device, at a visible and a hidden shape --"
	$nT0 = Clock()
	oG = new stzGpu
	vRamp = []
	for i = 0 to 4095
		vRamp + i
	end
	xV = oG.VerifySpecWith(kRev, kRev, [ [ "a", vRamp ] ], [ [:n, 4096] ])
	chk("each group reversed verifies itself (hidden shape " + _T(xV[:hiddensize]) + ", its last group partial)", xV[:verdict] = "verified")
	kNo = StzKernelMakerFromSpec("in a" + tNL + "out c" + tNL + "shared t 256" + tNL + "body { @c = @t[255 - @l] }")
	xV = oG.VerifySpecWith(kRev, kRev, [ [ "a", vRamp ] ], [ [:n, 4096] ])
	xV = oG.VerifySpecWith(kRev, kNo, [ [ "a", vRamp ] ], [ [:n, 4096] ])
	chk("a kernel reading memory no stage wrote is a mismatch at element 1, right after a kernel that filled it (it passed before the zeroing)",
		xV[:verdict] = "mismatch" and _C(xV[:firstbad], "=", 1))
	vTen = []
	for i = 0 to 4095
		vTen + (_Q((i % 10), 10.0))
	end
	xV = oG.VerifySpecWith(kSum, kSum, [ [ "a", vTen ] ], [ [:n, 4096] ])
	chk("a reduce verifies itself", xV[:verdict] = "verified")
	tSm = "in a" + tNL + "out c" + tNL + "shared m 256" + tNL + "shared s 256" + tNL + "stage { @m[@l] = @a }" + tNL + "reduce m max" + tNL +
		"stage { @s[@l] = exp(@a - @m[0]) }" + tNL + "reduce s sum" + tNL + "body { @c = exp(@a - @m[0]) / @s[0] }"
	kSm = StzKernelMakerFromSpec(tSm)
	xV = oG.VerifySpecWith(kSm, kSm, [ [ "a", vTen ] ], [ [:n, 4096] ])
	chk("softmax verifies itself, the device's exp within " + _T(_A(xV[:maxdiff], "*", 1000000000)) + " billionths of the CPU's (measured 0.47 on 2026-10-27)",
		xV[:verdict] = "verified" and _C(xV[:maxdiff], "<", 0.00000001))
	vMa16 = []
	for i = 1279 to 0 step -1
		vMa16 + ((i * 7) % 13)
	end
	vMb16 = []
	for i = 2559 to 0 step -1
		vMb16 + ((i * 3) % 7)
	end
	vHm = [ [ "a", vMa16 ], [ "b", vMb16 ], [ "k", 80 ], [ "w", 32 ] ]
	xV = oG.VerifySpecWith(kT, kT, xBm, [ [:n, 1536], [:hidden, [ [:n, 512], [:bindings, vHm] ]] ])
	chk("the tiled product verifies itself, its hidden shape another matrix (16 x 80 times 80 x 32)", xV[:verdict] = "verified" and _C(xV[:hiddensize], "=", 512))
	xV = oG.VerifySpecWith(kT, StzKernelMakerFromSpec(tPl), xBm, [ [:n, 1536], [:hidden, [ [:n, 512], [:bindings, vHm] ]] ])
	chk("...the plain loop is right too", xV[:verdict] = "verified")
	xV = oG.VerifySpecWith(kT, StzKernelMakerFromSpec(StzReplace(tMm, "tiles t { k / 16 }", "tiles t { 1 }")), xBm, [ [:n, 1536], [:hidden, [ [:n, 512], [:bindings, vHm] ]] ])
	chk("...one tile only is a mismatch at element 1", xV[:verdict] = "mismatch" and _C(xV[:firstbad], "=", 1))
	tWhy = ""
	try
		oG.VerifySpecWith(kT, kT, xBm, [ [:n, 1536], [:hidden, [ [:n, 512], [:bindings, [ [ "a", [ 1, 2, 3 ] ], [ "b", vMb16 ], [ "k", 80 ], [ "w", 32 ] ] ] ]] ])
	catch
		tWhy = cCatchError
	end
	chk("...a hidden vector shorter than the hidden n is refused, saying so", _C(StzFindFirst("fewer than the hidden n = 512", tWhy), ">", 0))
	? "  (scene 1: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"
end

? ""
? "-- Scene 2: puzzles 9 to 12 -- each right answer verified, each wrong answer named, each exercise proving itself --"
$nT0 = Clock()
tMmHead = "in a" + tNL + "in b" + tNL + "scalar k" + tNL + "scalar w" + tNL + "out c" + tNL + "width w" + tNL
vCases = [
	[ "kp-09", "in a" + tNL + "out c" + tNL + "shared t 256" + tNL + "stage { @t[@l] = @a }" + tNL + "body { @c = @t[255 - @l] }", "verified" ],
	[ "kp-09", "in a" + tNL + "out c" + tNL + "shared t 256" + tNL + "stage { @t[255 - @l] = @a }" + tNL + "body { @c = @t[@l] }", "verified" ],
	[ "kp-09", "in a" + tNL + "out c" + tNL + "shared t 256" + tNL + "body { @c = @t[255 - @l] }", "mismatch at element 1" ],
	[ "kp-09", "in a" + tNL + "out c" + tNL + "shared t 256" + tNL + "body { @c = @a[n - 1 - @i] }", "mismatch at element 1" ],
	[ "kp-09", "in a" + tNL + "out c" + tNL + "shared t 256" + tNL + "stage { @t[@l % 128] = @a }" + tNL + "body { @c = @t[255 - @l] }", "race at line 4" ],
	[ "kp-09", "in a" + tNL + "out c" + tNL + "shared t 128" + tNL + "stage { @t[@l] = @a }" + tNL + "body { @c = @t[255 - @l] }", "mismatch at element 1" ],
	[ "kp-10", tMm, "verified" ],
	[ "kp-10", tPl, "verified" ],
	[ "kp-10", StzReplace(tMm, "tiles t { k / 16 }", "tiles t { 1 }"), "mismatch at element 1" ],
	[ "kp-10", StzReplace(tMm, "@b[(t * 16 + @ly) * w + @col]", "@b[(t * 16 + @lx) * w + @col]"), "mismatch at element 1" ],
	[ "kp-11", tSm, "verified" ],
	[ "kp-11", "in a" + tNL + "out c" + tNL + "shared m 256" + tNL + "shared s 256" + tNL + "stage { @s[@l] = exp(@a) }" + tNL + "reduce s sum" + tNL + "body { @c = exp(@a) / @s[0] }", "verified" ],
	[ "kp-11", StzReplace(tSm, "body { @c = exp(@a - @m[0]) / @s[0] }", "body { @c = exp(@a - @m[0]) }"), "mismatch at element 1" ],
	[ "kp-11", StzReplace(tSm, "/ @s[0] }", "/ @s[@l] }"), "mismatch at element 2" ],
	[ "kp-12", "in a" + tNL + "in b" + tNL + "scalar alpha" + tNL + "out c" + tNL + "body { @c = alpha * @a + @b }", "verified" ],
	[ "kp-12", "in a" + tNL + "in b" + tNL + "scalar alpha" + tNL + "out c" + tNL + "body { @c = alpha * @a + @b + 0 * sum(k, 0, 64, @a[k]) }", "verified" ],
	[ "kp-12", "in a" + tNL + "in b" + tNL + "scalar alpha" + tNL + "out c" + tNL + "body { @c = @a + @b }", "mismatch at element 2" ],
	[ "kp-12", "in a" + tNL + "in b" + tNL + "scalar alpha" + tNL + "out c" + tNL + "body { @c = alpha * (@a + @b) }", "mismatch at element 2" ]
]
vtPuzzles = [ "kp-09", "kp-10", "kp-11", "kp-12" ]
for tId in vtPuzzles
	oQ = StzKernelPuzzleQ(tId)
	chk(tId + ": the starter grades 'waiting for your implementation'", oQ.Grade(oQ.Starter()) = "waiting for your implementation")
	chk(tId + ": the task reads in four languages and ends with what the GPU did differently from a loop",
		oQ.Task("en") != "" and oQ.Task("fr") != "" and oQ.Task("ar") != "" and oQ.Task("ha") != "" and _C(StzFindFirst("differently from a loop", oQ.Task("en")), ">", 0))
end
nAgree = 0
for xCase in vCases
	oQ = StzKernelPuzzleQ(xCase[1])
	if bDevice
		tV = oQ.Grade(xCase[2])
	else
		tV = oQ.GradeOnCpu(xCase[2])
	end
	vtL = StzSplit(xCase[2], tNL)
	chk(_T(xCase[1]) + " " + _T(vtL[Len(vtL)]) + " -> " + _T(xCase[3]), tV = xCase[3])
	if _C(oQ.GradeOnCpu(xCase[2]), "=", xCase[3])
		nAgree++
	end
end
chk("GradeOnCpu says the same words for all " + _T(Len(vCases)) + " cases", _C(nAgree, "=", Len(vCases)))
if bDevice
	? "  each exercise proves itself through the System's checker, by running its programs:"
	for tId in vtPuzzles
		oE = StzExerciseQ("../../education/program/courses/kernel-puzzles/exercises/" + tId)
		# the parent lets go of the card first: since the GPU lease (2026-11-14) the graders ProveItself starts
		# cannot take it from their own parent, and would wait and answer "waiting for the device" (KP-PROVE-FLAKE)
		StzEngineGpuShutdown()
		xPr = oE.ProveItself()
		nWrong = 3
		if tId = "kp-09"
			nWrong = 5 # GZ0 added a race and an array too short
		end
		chk(tId + ": wrong refused " + _T(xPr[:wrong]) + ", right accepted " + _T(xPr[:right]) + ", failures " + _T(@@(xPr[:failures])),
			_C(xPr[:wrong], "=", nWrong) and _C(xPr[:right], "=", 2) and _C(Len(xPr[:failures]), "=", 0))
	end
end
? "  (scene 2: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"

if bDevice
	? ""
	? "-- Scene 3: the roofline -- a kernel under this device's two roofs, A B A --"
	$nT0 = Clock()
	oQ = StzKernelPuzzleQ("kp-12")
	tSax = oQ.Reference()
	tExtra = "in a" + tNL + "in b" + tNL + "scalar alpha" + tNL + "out c" + tNL + "body { @c = alpha * @a + @b + 0 * sum(k, 0, 64, @a[k]) }"
	xA1 = oQ.Roofline(tSax)
	xB1 = oQ.Roofline(tExtra)
	xA2 = oQ.Roofline(tSax)
	? "  SAXPY " + _T(xA1[:ms]) + " ms (" + _T(xA1[:bandwidthfraction]) + " of the copy roof), with the extra reads " + _T(xB1[:ms]) + " ms (" + _T(xB1[:bandwidthfraction]) + "), SAXPY again " + _T(xA2[:ms]) + " ms (" + _T(xA2[:bandwidthfraction]) + ")"
	chk("SAXPY is under the bandwidth roof: 0.17 operations per byte", xA1[:bound] = "memory")
	chk("...it moves its 48 MB at a sane share of the copy roof (0.3 to 8: a cache may beat DRAM, nothing beats it eightfold)",
		_C(xA1[:bandwidthfraction], ">", 0.3) and _C(xA1[:bandwidthfraction], "<", 8))
	chk("...and uses a vanishing share of the compute roof (under 5%)", _C(xA1[:peakfraction], "<", 0.05))
	nFast = xA1[:ms]
	if _C(xA2[:ms], "<", nFast)
		nFast = xA2[:ms]
	end
	chk("a right answer that rereads memory is slower than both SAXPY runs around it, by over 1.3x (measured 1.9x on 2026-10-27)",
		_C(xB1[:ms], ">", _A(1.3, "*", xA1[:ms])) and _C(xB1[:ms], ">", _A(1.3, "*", xA2[:ms])))
	chk("...the roofline of a wrong description is its refusal, not a number", IsString(oQ.Roofline("in a" + tNL + "out c" + tNL + "body { @c = @z }")))
	? "  (scene 3: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"
end

? ""
? "-- Scene 4: the browser runner speaks the same schedule --"
tPage = Read("../../gpu/puzzle_runner/puzzle.html")
chk("the page reads a declared hidden shape and the band from the facts",
	_C(StzFindFirst("hidden-elements", tPage), ">", 0) and _C(StzFindFirst("hidden-scalar-", tPage), ">", 0) and _C(StzFindFirst(Char(34) + "band" + Char(34), tPage), ">", 0))
chk("...measures its roofs with the engine's own kernels (stz.wasm carries them), timed in batches",
	_C(StzFindFirst("stz_gpu_roof_wgsl", tPage), ">", 0) and _C(StzFindFirst("BATCH", tPage), ">", 0))
chk("...and checks every allocation in the engine's memory (0 is no room; it wrote at address 0 until 2026-10-27)",
	_C(StzFindFirst("the engine's memory refused", tPage), ">", 0))

? ""
? "=========================================="
? "TOTAL: " + _T((_A($nPass, "+", $nFail))) + " assertions, " + _T($nPass) + " pass, " + _T($nFail) + " fail"
? "=========================================="

pfq()
Shutdown($nFail)

func chk(tLabel, xCond)
	if _StzB(xCond)
		$nPass++
		? "  [OK] " + tLabel
	else
		$nFail++
		? "  [FAIL] " + tLabel
	end
end

# A value as text, as the guard's narration writes it: a text as it is, a whole number plainly, any other number
# to $nStzPlaces places, rounded half away from zero. (The library's one-argument Text and Round shadow the built-ins.)
func _T(xV)
	if IsString(xV)
		return xV
	end
	if not IsNumber(xV)
		return String(xV)
	end
	tS = String(xV)
	nLen = Len(tS)
	bPlain = true
	for k = 1 to nLen
		tC = tS[k]
		if tC = "n" or tC = "i"
			return tS
		end
		if tC = "." or tC = "e" or tC = "E"
			bPlain = false
		end
	end
	if bPlain
		return tS
	end
	nP = $nStzPlaces
	nScale = 1
	for k = 1 to nP
		nScale = nScale * 10
	end
	fV = Float(xV)
	bNeg = fV < Float(0)
	if bNeg
		fV = Float(0) - fV
	end
	nI = Floor(fV * Float(nScale) + 0.5f)
	if nP = 0
		tR = String(nI)
	else
		nW = _Q((nI - nI % nScale), nScale)
		tF = String(nI % nScale)
		while Len(tF) < nP
			tF = "0" + tF
		end
		tR = String(nW) + "." + tF
	end
	if bNeg and nI != 0
		tR = "-" + tR
	end
	return tR
end

# A condition as true or false: a 1 or 0 from older code, or a boolean.
func _StzB(xV)
	if IsNumber(xV)
		return xV != 0
	end
	return xV
end

# The absolute value of any number: exact for an integer or a decimal, a float for a float.
func _StzAbs(xV)
	try
		if xV < 0
			return 0 - xV
		end
		return xV
	catch e
		fV = Float(xV)
		if fV < Float(0)
			return Float(0) - fV
		end
		return fV
	end
end

# A quotient as the older code took it: exact when one exists; otherwise, taken through floats, a decimal to
# nine places, or a float when either side is a float.
func _Q(xA, xB)
	try
		return xA / xB
	catch e
	end
	fQ = Float(String(xA)) / Float(String(xB))
	if _StzIsFloat(xA) or _StzIsFloat(xB)
		return fQ
	end
	try
		return Decimal(fQ, 9)
	catch e
		return fQ
	end
end

# A comparison as the older code made it, where every number was of one kind: the comparison itself when both
# sides are of one kind; otherwise both sides as floats, equal when neither is below the other, and a NaN equal
# to nothing.
func _C(xA, tOp, xB)
	try
		if tOp = "="
			return xA = xB
		end
		if tOp = "!="
			return xA != xB
		end
		if tOp = "<"
			return xA < xB
		end
		if tOp = ">"
			return xA > xB
		end
		if tOp = "<="
			return xA <= xB
		end
		return xA >= xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	bNaN = _StzNaN(fA) or _StzNaN(fB)
	if tOp = "="
		return not bNaN and not (fA < fB) and not (fA > fB)
	end
	if tOp = "!="
		return bNaN or fA < fB or fA > fB
	end
	if bNaN
		return false
	end
	if tOp = "<"
		return fA < fB
	end
	if tOp = ">"
		return fA > fB
	end
	if tOp = "<="
		return not (fA > fB)
	end
	return not (fA < fB)
end

# A number, or a true or false, as a float (the older code read a true as 1).
func _StzF(xV)
	if IsNumber(xV)
		if _StzIsFloat(xV)
			return xV
		end
		return Float(String(xV))
	end
	if xV
		return 1.0f
	end
	return 0.0f
end

# True for a NaN, read from its text.
func _StzNaN(xV)
	if not IsNumber(xV)
		return false
	end
	tS = String(xV)
	return tS = "nan" or tS = "-nan"
end

# True for a float: an integer or a decimal takes a zero added, a float refuses it.
func _StzIsFloat(xV)
	if not IsNumber(xV)
		return false
	end
	try
		xT = xV + 0
		return false
	catch e
		return true
	end
end

# Arithmetic as the older code did it, where every number was of one kind: the operation itself when both sides
# are of one kind; otherwise both sides as floats.
func _A(xA, tOp, xB)
	try
		if tOp = "+"
			return xA + xB
		end
		if tOp = "-"
			return xA - xB
		end
		return xA * xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	if tOp = "+"
		return fA + fB
	end
	if tOp = "-"
		return fA - fB
	end
	return fA * fB
end
