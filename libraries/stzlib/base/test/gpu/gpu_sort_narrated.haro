# GB0 -- THE RADIX SORT, the library layer's third op (SOFTANZA_GPU_PLAN.md, GB0;
# built on the scan of gpu_scan_narrated.haro, as stream compaction is).
#
# Sort n f32 keys ascending or descending, STABLY, with the values that follow them
# (a key-value sort) or the permutation that sorts them (an argsort), on the device:
# the key becomes an unsigned integer that orders like the float; eight passes of four
# bits each; in a pass every group of 256 sorts its keys by the digit in shared memory
# (four one-bit splits, each a scan), a scan of the table of digit counts says where each
# group's run of each digit lands, and a scatter puts every key there.
#
# This guard proves a sort WITHOUT a reference sort to lean on, by what a sort IS:
#   - the keys come out in order (ascending or descending);
#   - the values come out as a PERMUTATION of 0 .. n - 1, every one exactly once;
#   - each value sits beside ITS OWN key (keys[value] is the key it carries);
#   - STABLE: where two keys are equal, their values stay in increasing order.
# Those four together say the output is a stable sort of the input, whatever the tree.
# The fractional data is also compared to the library's own sort, element for element.
#
# Run with haro: haro gpu_sort_narrated.haro

load "../../stzBase.ring"

$nPass = 0
$nFail = 0
$nSkip = 0

pr()

$nStzPlaces = 10

nS_OK = 0
nS_FALLBACK = 1
iS_STALE = 2
iS_BADARG = 3
iS_TOOLARGE = 4

? "-- Scene 0: the op refuses the fallback way before there is a device --"
chk("a sort before Init answers FALLBACK", _C(StzEngineGpuOpSort(1, 2, 100, 0), "=", nS_FALLBACK))
chk("...and so do the pairs and the argsort", _C(StzEngineGpuOpSortPairs(1, 2, 3, 4, 100, 0), "=", nS_FALLBACK) and _C(StzEngineGpuOpArgSort(1, 2, 100, 0), "=", nS_FALLBACK))

oG = new stzGpu
bDevice = oG.IsAvailable()
if not bDevice
	? "  NO GPU ON THIS MACHINE -- the scenes below need a device; the fallback scene above is the CI coverage"
else
	? "  device: [" + _T(StzEngineGpuSelectedAdapter()) + "] " + _T(StzEngineGpuAdapterName(StzEngineGpuSelectedAdapter()))

	? ""
	? "-- Scene 1: whole numbers with ties, across every level, both directions --"
	$nT0 = Clock()
	StzEngineGpuCountersReset()
	for nN in [ 1, 2, 255, 256, 257, 4096, 4352, 65537, 1000003 ]
		vIn = []
		for i = 1 to nN
			vIn + (_A(((i * 7919) % 1000), "-", 500))
		end
		vVal = []
		for i = 1 to nN
			vVal + (i - 1)
		end
		nHK = StzEngineGpuBufferNew(_A(nN, "*", 4))
		nHV = StzEngineGpuBufferNew(_A(nN, "*", 4))
		nHOK = StzEngineGpuBufferNew(_A(nN, "*", 4))
		nHOV = StzEngineGpuBufferNew(_A(nN, "*", 4))
		StzEngineGpuBufferUploadList(nHK, vIn)
		StzEngineGpuBufferUploadList(nHV, vVal)
		for nDesc = 0 to 1
			nSt = StzEngineGpuOpSortPairs(nHK, nHV, nHOK, nHOV, nN, nDesc)
			xK = StzEngineGpuBufferDownloadList(nHOK, nN)
			xV = StzEngineGpuBufferDownloadList(nHOV, nN)
			tWhy = _Verify(vIn, xK, xV, nDesc)
			tDir = "ascending"
			if _C(nDesc, "=", 1) tDir = "descending" end
			chk("n = " + _T(nN) + " " + tDir + " (" + _T(StzEngineGpuSortDispatches(nN)) + " dispatches): ordered, a permutation, each value beside its own key, stable" + tWhy, nSt = nS_OK and tWhy = "")
		end
		StzEngineGpuBufferFree(nHK)
		StzEngineGpuBufferFree(nHV)
		StzEngineGpuBufferFree(nHOK)
		StzEngineGpuBufferFree(nHOV)
	end
	chk("the happy path counted zero fallbacks", _C(StzEngineGpuCounter(3), "=", 0))
	? "  (scene 1: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"

	? ""
	? "-- Scene 2: fractions, negatives and wide magnitudes, against the library's own sort --"
	$nT0 = Clock()
	nN = 100000
	vIn = []
	for i = 1 to nN
		xKey = _Q((_A(((i * 7919) % 100003), "-", 50000)), 7)
		if _C(i % 11, "=", 0)
			xKey = _A(xKey, "*", 100000000)
		end
		if _C(i % 13, "=", 0)
			xKey = _Q(xKey, 100000000)
		end
		vIn + xKey
	end
	nHI = StzEngineGpuBufferNew(_A(nN, "*", 4))
	nHO = StzEngineGpuBufferNew(_A(nN, "*", 4))
	StzEngineGpuBufferUploadList(nHI, vIn)
	xUp = StzEngineGpuBufferDownloadList(nHI, nN)
	xRef = ring_sort(xUp)
	StzEngineGpuOpSort(nHI, nHO, nN, 0)
	xAsc = StzEngineGpuBufferDownloadList(nHO, nN)
	chk("100,000 floats (negatives, 1e-8 to 1e10): the keys-only sort equals the library's sort of the same values, element for element", _C(@@(xAsc), "=", @@(xRef)))
	StzEngineGpuOpSort(nHI, nHO, nN, 1)
	xDesc = StzEngineGpuBufferDownloadList(nHO, nN)
	bRev = true
	for i = 1 to nN
		if _C(xDesc[i], "!=", xRef[nN + 1 - i])
			bRev = false
			exit
		end
	end
	chk("...and descending is its reverse, element for element", bRev)
	StzEngineGpuBufferFree(nHI)
	StzEngineGpuBufferFree(nHO)
	? "  (scene 2: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"

	? ""
	? "-- Scene 3: the argsort, a permutation that sorts --"
	nN = 100000
	vIn = []
	for i = 1 to nN
		vIn + (_A(((i * 7919) % 1000), "-", 500))
	end
	nHK = StzEngineGpuBufferNew(_A(nN, "*", 4))
	nHO = StzEngineGpuBufferNew(_A(nN, "*", 4))
	StzEngineGpuBufferUploadList(nHK, vIn)
	nSt = StzEngineGpuOpArgSort(nHK, nHO, nN, 0)
	xIdx = StzEngineGpuBufferDownloadList(nHO, nN)
	vSorted = []
	for i = 1 to nN
		vSorted + vIn[xIdx[i] + 1]
	end
	tWhy = _Verify(vIn, vSorted, xIdx, 0)
	chk("the argsort of 100,000 keys with ties: the places sort the keys, each exactly once, ties in their original order" + tWhy, nSt = nS_OK and tWhy = "")
	nSt = StzEngineGpuOpArgSort(nHK, nHO, nN, 1)
	xIdx = StzEngineGpuBufferDownloadList(nHO, nN)
	vSorted = []
	for i = 1 to nN
		vSorted + vIn[xIdx[i] + 1]
	end
	tWhy = _Verify(vIn, vSorted, xIdx, 1)
	chk("...and descending, ties still in their original order" + tWhy, nSt = nS_OK and tWhy = "")
	StzEngineGpuBufferFree(nHK)
	StzEngineGpuBufferFree(nHO)

	? ""
	? "-- Scene 4: one submit, the dispatches counted, the scratch kept between calls and given back --"
	nN = 100000
	nHI = StzEngineGpuBufferNew(_A(nN, "*", 4))
	nHO = StzEngineGpuBufferNew(_A(nN, "*", 4))
	StzEngineGpuBufferUploadList(nHI, vIn)
	StzEngineGpuOpSort(nHI, nHO, nN, 0)
	StzEngineGpuSync()
	nD0 = StzEngineGpuCounter(0)
	nS0 = StzEngineGpuCounter(6)
	nL0 = StzEngineGpuCounter(8)
	nF0 = StzEngineGpuCounter(3)
	StzEngineGpuOpSort(nHI, nHO, nN, 0)
	StzEngineGpuSync()
	chk("a sort of 100,000 is " + _T(StzEngineGpuSortDispatches(nN)) + " dispatches (the counter says " + _T((_A(StzEngineGpuCounter(0), "-", nD0))) + "): the keys in, eight passes of local sort + scan + scatter, the keys out", _C(_A(StzEngineGpuCounter(0), "-", nD0), "=", StzEngineGpuSortDispatches(nN)) and _C(StzEngineGpuSortDispatches(nN), "=", 42))
	chk("...in ONE queue submit, nothing read back (the counter says " + _T((_A(StzEngineGpuCounter(6), "-", nS0))) + ")", _C(_A(StzEngineGpuCounter(6), "-", nS0), "=", 1))
	chk("...the scratch is kept, not made again: live buffers " + _T(nL0) + " before the call and " + _T(StzEngineGpuCounter(8)) + " after", _C(StzEngineGpuCounter(8), "=", nL0))
	chk("...and nothing fell back", _C(StzEngineGpuCounter(3), "=", nF0))
	nLive = StzEngineGpuCounter(8)
	StzEngineGpuSortRelease()
	chk("SortRelease gives the seven scratch buffers back (live buffers " + _T(nLive) + " then " + _T(StzEngineGpuCounter(8)) + ")", _C(StzEngineGpuCounter(8), "=", _A(nLive, "-", 7)))
	chk("the dispatch counts: 26 for one group, 42 for 100,000, and one more level of scan makes the table longer",
		_C(StzEngineGpuSortDispatches(100), "=", 26) and _C(StzEngineGpuSortDispatches(100000), "=", 42) and _C(StzEngineGpuSortDispatches(4352), "=", 42) and _C(StzEngineGpuSortDispatches(16777216), "=", 58))

	? ""
	? "-- Scene 5: what it refuses --"
	chk("n = 0 is BAD_ARG", _C(StzEngineGpuOpSort(nHI, nHO, 0, 0), "=", iS_BADARG))
	chk("the same buffer in and out is BAD_ARG (WebGPU aliasing validation)", _C(StzEngineGpuOpSort(nHI, nHI, nN, 0), "=", iS_BADARG))
	chk("the values as the keys, or an output as an input, is BAD_ARG", _C(StzEngineGpuOpSortPairs(nHI, nHI, nHO, nHO, nN, 0), "=", iS_BADARG) and _C(StzEngineGpuOpSortPairs(nHI, nHO, nHO, nHI, nN, 0), "=", iS_BADARG))
	chk("an output too small is BAD_ARG", _C(StzEngineGpuOpSort(nHI, nHO, _A(nN, "+", 1), 0), "=", iS_BADARG))
	chk("more than 16,777,216 elements are refused by name (TOO_LARGE): the scan and the table are f32", _C(StzEngineGpuOpSort(nHI, nHO, 16777217, 0), "=", iS_TOOLARGE))
	StzEngineGpuBufferFree(nHO)
	chk("a freed output answers STALE", _C(StzEngineGpuOpSort(nHI, nHO, nN, 0), "=", iS_STALE))
	StzEngineGpuBufferFree(nHI)

	? ""
	? "-- Scene 6: the face, lists in and lists out --"
	xA = oG.Sort([ 3, 1, 4, 1, 5, 9, 2, 6 ])
	xB = oG.SortDescending([ 3, 1, 4, 1, 5, 9, 2, 6 ])
	xC = oG.SortPairs([ 3, 1, 4, 1, 5 ], [ 10, 20, 30, 40, 50 ])
	xD = oG.ArgSort([ 3, 1, 4, 1, 5 ])
	chk("Sort([3 1 4 1 5 9 2 6]) = [1 1 2 3 4 5 6 9]", @@(xA) = "[ 1, 1, 2, 3, 4, 5, 6, 9 ]")
	chk("SortDescending of the same = [9 6 5 4 3 2 1 1]", @@(xB) = "[ 9, 6, 5, 4, 3, 2, 1, 1 ]")
	chk("SortPairs: keys [3 1 4 1 5] carry [10 20 30 40 50] -> keys [1 1 3 4 5], values [20 40 10 30 50] (the two 1s keep their order)", @@(xC) = "[ [ 1, 1, 3, 4, 5 ], [ 20, 40, 10, 30, 50 ] ]")
	chk("ArgSort([3 1 4 1 5]) = [2 4 1 3 5]: 1-based places, the two 1s in their order", @@(xD) = "[ 2, 4, 1, 3, 5 ]")
	tErr = ""
	try
		oG.Sort([])
	catch
		tErr = cCatchError
	end
	chk("an empty list is refused by name (" + Left(tErr, 50) + ")", _C(StzFindFirst("non-empty list", tErr), ">", 0))
	tErr = ""
	try
		oG.SortPairs([ 1, 2, 3 ], [ 1, 2 ])
	catch
		tErr = cCatchError
	end
	chk("values of another length are refused by name (" + Left(tErr, 50) + ")", _C(StzFindFirst("values of the same length", tErr), ">", 0))

	? ""
	? "-- Scene 7: how fast, resident --"
	$nT0 = Clock()
	nN = 1000000
	vIn = []
	for i = 1 to nN
		vIn + (_Q(((i * 7919) % 100003), 7))
	end
	nHI = StzEngineGpuBufferNew(_A(nN, "*", 4))
	nHO = StzEngineGpuBufferNew(_A(nN, "*", 4))
	StzEngineGpuBufferUploadList(nHI, vIn)
	oG.Wake(400)
	StzEngineGpuSync()
	StzEngineGpuOpSort(nHI, nHO, nN, 0)
	nBest = 1000000
	for nRep = 1 to 5
		StzEngineGpuSync()
		nT = StzEngineWatchTimestampNs()
		for q = 1 to 3
			StzEngineGpuOpSort(nHI, nHO, nN, 0)
		end
		StzEngineGpuSync()
		nMs = _Q(_Q((_A(StzEngineWatchTimestampNs(), "-", nT)), 1000000), 3)
		if _C(nMs, "<", nBest)
			nBest = nMs
		end
	end
	nT = StzEngineWatchTimestampNs()
	xRing = ring_sort(vIn)
	nRingMs = _Q((_A(StzEngineWatchTimestampNs(), "-", nT)), 1000000)
	? "  1,000,000 floats resident: " + _T(nBest) + " ms on the device (" + _T((_Q(_Q(nN, nBest), 1000))) + " million keys a second); the library's own sort of the same list: " + _T(nRingMs) + " ms"
	xOut = StzEngineGpuBufferDownloadList(nHO, nN)
	xRing = ring_sort(StzEngineGpuBufferDownloadList(nHI, nN))
	chk("the resident sort's output is the library's sort of the same f32 values, element for element (1,000,000 of them)", _C(@@(xOut), "=", @@(xRing)))
	StzEngineGpuBufferFree(nHI)
	StzEngineGpuBufferFree(nHO)
	? "  (scene 7: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"

	? ""
	? "-- Scene 8: the route -- the library's sort against the device through the face, measured, stored, followed --"
	$nT0 = Clock()
	xCal = oG.CalibrateSort()
	? "  adapter " + _T(xCal[:adapter]) + ", flat line at " + _T(xCal[:flat]) + " (" + _T(xCal[:flatwhy]) + ")"
	for xCell in xCal[:cells]
		? "  n = " + _T(xCell[2]) + ": the library's sort " + _T(xCell[3]) + " ms, face " + _T(xCell[4]) + " ms, ratio " + _T(xCell[5])
	end
	if xCal[:confounded]
		# the control rung moved by more than 2x: another process held the machine, the store refused the line,
		# and a route that was never stored cannot be followed. A gate that could not run says so; it is not a pass
		$nSkip++
		? "  [SKIPPED] the route checks: the machine was too loaded for a stable measurement (the control rung moved more than 2x), so nothing was stored; run this guard again on a quiet machine"
	else
		chk("the control rung (the first, measured again at the end) stayed within 2x, so the line is stored", not xCal[:confounded])
		bFollow = true
		for xCell in xCal[:cells]
			bWin = (_C(xCell[5], ">=", 1.3))
			if (_C(StzEngineGpuCalibRouteShaped("sort", xCell[2], 1), "=", 1)) != bWin
				bFollow = false
			end
		end
		chk("the route sends a size to the device exactly where its measured ratio reached 1.3, at every rung", bFollow)
		vNum = []
		for i = 1 to 200000
			vNum + (_Q(((i * 7919) % 100003), 7))
		end
		chk("SortRouted gives the same sorted list whichever side it ran on (200,000 floats, element for element)", _C(@@(oG.SortRouted(vNum)), "=", @@(oG.Sort(vNum))) or _C(@@(oG.SortRouted(vNum)), "=", @@(ring_sort(vNum))))
		chk("a short list stays on the library's sort and SortRouted answers [1 2 3]", @@(oG.SortRouted([ 3, 1, 2 ])) = "[ 1, 2, 3 ]" and _C(StzEngineGpuCalibRouteShaped("sort", 3, 1), "=", 0))
	end
	? "  (scene 8: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"
end

? ""
? "-- Scene 9: puzzle 22, sort a group --"
$nT0 = Clock()
tNL = Char(10)
oQ = StzKernelPuzzleQ("kp-22")
chk("the starter grades 'waiting for your implementation'", oQ.Grade(oQ.Starter()) = "waiting for your implementation")
chk("the task reads in four languages and ends with what the GPU did differently from a loop, and names the library's Sort",
	oQ.Task("en") != "" and oQ.Task("fr") != "" and oQ.Task("ar") != "" and oQ.Task("ha") != "" and _C(StzFindFirst("differently from a loop", oQ.Task("en")), ">", 0) and _C(StzFindFirst("library's `Sort`", oQ.Task("en")), ">", 0))
tHead = "in a" + tNL + "out c" + tNL + "shared t 256" + tNL + "shared r 256" + tNL + "stage { @t[@l] = @a }" + tNL
tBody = tNL + "body { @c = sum(j, 0, 256, when(@r[j] == @l, @t[j], 0)) }"
# the verdicts were worked out from the data before the first run. a is (i * 7) % 13; the first group of 256
# holds the value 0 twenty times (at i = 0, 13 ... 247), so the sorted group starts with twenty 0s:
#   ties share a rank:  the twenty 0s all have rank 0, slot 0 sums them (0) and slots 1 to 19 find nobody (0):
#                       all equal to the owed 0s; slot 20 owes 1 and the 1s share rank 20: element 21
#   counts itself:      every rank is one too high, so slot k holds what slot k - 1 was owed: the twenty 0s
#                       still fill slots 0 to 19 (slot 0 finds nobody, a 0), and slot 20 gets a 0 where a 1 is owed: element 21
#   the larger:         the biggest value (12) goes to slot 0 where 0 is owed: element 1
vCases = [
	[ tHead + "stage { @r[@l] = sum(j, 0, 256, when(@t[j] < @t[@l] or (@t[j] == @t[@l] and j < @l), 1, 0)) }" + tBody, "verified" ],
	[ tHead + "stage { @r[@l] = sum(j, 0, 256, when(@t[j] < @t[@l] or (@t[j] == @t[@l] and j > @l), 1, 0)) }" + tBody, "verified" ],
	[ tHead + "stage { @r[@l] = sum(j, 0, 256, when(@t[j] < @t[@l], 1, 0)) }" + tBody, "mismatch at element 21" ],
	[ tHead + "stage { @r[@l] = sum(j, 0, 256, when(@t[j] > @t[@l] or (@t[j] == @t[@l] and j < @l), 1, 0)) }" + tBody, "mismatch at element 1" ],
	[ tHead + "stage { @r[@l] = sum(j, 0, 256, when(@t[j] < @t[@l] or (@t[j] == @t[@l] and j <= @l), 1, 0)) }" + tBody, "mismatch at element 21" ]
]
nAgree = 0
for vQ in vCases
	if bDevice
		tV = oQ.Grade(vQ[1])
	else
		tV = oQ.GradeOnCpu(vQ[1])
	end
	chk(_T(Replace(Replace(Replace(Replace(vQ[1], tNL, " / "), "in a / out c / ", ""), "shared t 256 / shared r 256 / stage { @t[@l] = @a } / ", ""), " / body { @c = sum(j, 0, 256, when(@r[j] == @l, @t[j], 0)) }", "")) + " -> " + _T(vQ[2]) + " (" + tV + ")", tV = vQ[2])
	if _C(oQ.GradeOnCpu(vQ[1]), "=", vQ[2])
		nAgree++
	end
end
chk("GradeOnCpu says the same words for all " + _T(Len(vCases)) + " cases", _C(nAgree, "=", Len(vCases)))
tV = oQ.Grade("in a" + tNL + "out c" + tNL + "shared t 256" + tNL + "stage { @t[@l] = @t[@l] + @t[@l - 1] }" + tNL + "body { @c = @t[@l] }")
chk("a stage that reads the array it writes is refused by name (" + Left(tV, 60) + ")", _C(StzFindFirst("refused", tV), "=", 1) and _C(StzFindFirst("cannot read the array it writes", tV), ">", 0))
if bDevice
	oE = StzExerciseQ("../../education/program/courses/kernel-puzzles/exercises/kp-22")
	# the parent lets go of the card first: since the GPU lease (2026-11-14) the graders ProveItself starts
	# cannot take it from their own parent, and would wait and answer "waiting for the device" (KP-PROVE-FLAKE)
	StzEngineGpuShutdown()
	xPr = oE.ProveItself()
	chk("the exercise proves itself through the System's checker: wrong refused " + _T(xPr[:wrong]) + ", right accepted " + _T(xPr[:right]) + ", failures " + _T(@@(xPr[:failures])),
		_C(xPr[:wrong], "=", 5) and _C(xPr[:right], "=", 2) and _C(Len(xPr[:failures]), "=", 0))
end
? "  (scene 9: " + _T((_Q((_A(Clock(), "-", $nT0)), ClocksPerSecond()))) + " s)"

? ""
? "=========================================="
? "TOTAL: " + _T((_A($nPass, "+", $nFail))) + " assertions, " + _T($nPass) + " pass, " + _T($nFail) + " fail" + ", " + _T($nSkip) + " skipped"
? "=========================================="

pfq()
Shutdown($nFail)

func chk(tLabel, xCond)
	if _StzB(xCond)
		$nPass++
		? "  [OK] " + tLabel
	else
		$nFail++
		? "  [FAIL] " + tLabel
	end
end
# "" when aK, aV are a stable sort of aIn (aV holds 0-based places in aIn); else the first reason, with a leading ": "
func _Verify(vIn, xK, xV, nDesc)
	nN = Len(vIn)
	if _C(Len(xK), "!=", nN) or _C(Len(xV), "!=", nN)
		return ": the output has the wrong length"
	end
	vSeen = []
	for i = 1 to nN
		vSeen + 0
	end
	for i = 1 to nN
		nPlace = _A(xV[i], "+", 1)
		if _C(nPlace, "<", 1) or _C(nPlace, ">", nN) or _C(vSeen[nPlace], "=", 1)
			return ": not a permutation at " + _T(i) + " (value " + _T(xV[i]) + ")"
		end
		vSeen[nPlace] = 1
		if _C(xK[i], "!=", vIn[nPlace])
			return ": the key at " + _T(i) + " is not the key its value carries"
		end
		if _C(i, ">", 1)
			if _C(nDesc, "=", 0) and _C(xK[i], "<", xK[i - 1])
				return ": out of order at " + _T(i)
			end
			if _C(nDesc, "=", 1) and _C(xK[i], ">", xK[i - 1])
				return ": out of order at " + _T(i)
			end
			if _C(xK[i], "=", xK[i - 1]) and _C(xV[i], "<", xV[i - 1])
				return ": unstable at " + _T(i)
			end
		end
	end
	return ""
end

# A value as text, as the guard's narration writes it: a text as it is, a whole number plainly, any other number
# to $nStzPlaces places, rounded half away from zero. (The library's one-argument Text and Round shadow the built-ins.)
func _T(xV)
	if IsString(xV)
		return xV
	end
	if not IsNumber(xV)
		return String(xV)
	end
	tS = String(xV)
	nLen = Len(tS)
	bPlain = true
	for k = 1 to nLen
		tC = tS[k]
		if tC = "n" or tC = "i"
			return tS
		end
		if tC = "." or tC = "e" or tC = "E"
			bPlain = false
		end
	end
	if bPlain
		return tS
	end
	nP = $nStzPlaces
	nScale = 1
	for k = 1 to nP
		nScale = nScale * 10
	end
	fV = Float(xV)
	bNeg = fV < Float(0)
	if bNeg
		fV = Float(0) - fV
	end
	nI = Floor(fV * Float(nScale) + 0.5f)
	if nP = 0
		tR = String(nI)
	else
		nW = _Q((nI - nI % nScale), nScale)
		tF = String(nI % nScale)
		while Len(tF) < nP
			tF = "0" + tF
		end
		tR = String(nW) + "." + tF
	end
	if bNeg and nI != 0
		tR = "-" + tR
	end
	return tR
end

# A condition as true or false: a 1 or 0 from older code, or a boolean.
func _StzB(xV)
	if IsNumber(xV)
		return xV != 0
	end
	return xV
end

# The absolute value of any number: exact for an integer or a decimal, a float for a float.
func _StzAbs(xV)
	try
		if xV < 0
			return 0 - xV
		end
		return xV
	catch e
		fV = Float(xV)
		if fV < Float(0)
			return Float(0) - fV
		end
		return fV
	end
end

# A quotient as the older code took it: exact when one exists; otherwise, taken through floats, a float.
func _Q(xA, xB)
	try
		return xA / xB
	catch e
	end
	return _StzF(xA) / _StzF(xB)
end

# A comparison as the older code made it, where every number was of one kind: the comparison itself when both
# sides are of one kind; otherwise both sides as floats, equal when neither is below the other, and a NaN equal
# to nothing.
func _C(xA, tOp, xB)
	try
		if tOp = "="
			return xA = xB
		end
		if tOp = "!="
			return xA != xB
		end
		if tOp = "<"
			return xA < xB
		end
		if tOp = ">"
			return xA > xB
		end
		if tOp = "<="
			return xA <= xB
		end
		return xA >= xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	bNaN = _StzNaN(fA) or _StzNaN(fB)
	if tOp = "="
		return not bNaN and not (fA < fB) and not (fA > fB)
	end
	if tOp = "!="
		return bNaN or fA < fB or fA > fB
	end
	if bNaN
		return false
	end
	if tOp = "<"
		return fA < fB
	end
	if tOp = ">"
		return fA > fB
	end
	if tOp = "<="
		return not (fA > fB)
	end
	return not (fA < fB)
end

# A number, or a true or false, as a float (the older code read a true as 1).
func _StzF(xV)
	if IsNumber(xV)
		if _StzIsFloat(xV)
			return xV
		end
		return Float(String(xV))
	end
	if xV
		return 1.0f
	end
	return 0.0f
end

# True for a NaN, read from its text.
func _StzNaN(xV)
	if not IsNumber(xV)
		return false
	end
	tS = String(xV)
	return tS = "nan" or tS = "-nan"
end

# True for a float: an integer or a decimal takes a zero added, a float refuses it.
func _StzIsFloat(xV)
	if not IsNumber(xV)
		return false
	end
	try
		xT = xV + 0
		return false
	catch e
		return true
	end
end

# Arithmetic as the older code did it, where every number was of one kind: the operation itself when both sides
# are of one kind; otherwise both sides as floats.
func _A(xA, tOp, xB)
	try
		if tOp = "+"
			return xA + xB
		end
		if tOp = "-"
			return xA - xB
		end
		return xA * xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	if tOp = "+"
		return fA + fB
	end
	if tOp = "-"
		return fA - fB
	end
	return fA * fB
end
