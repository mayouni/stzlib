# GL0 -- THE 3-D GRID (SOFTANZA_GPU_PLAN.md, GL0; the reader's account of the
# language is base/gpu/SOFTANZA_GPU_KERNELS.md, 3.1g).
#
# The seventh admission, and the last of GL0's vocabulary: a `depth` line after
# `width`. The output is a STACK of slices, each a `width` grid worked in
# 16 x 16 tiles. A thread knows its slice (@slice) and its row and column
# INSIDE that slice (@row, @col); @i is its place in the whole volume. The
# groups run slice by slice -- a group is a tile of ONE slice, never a tile
# straddling two -- so the dispatch is still ceil(n / 256) groups in x, the
# host contract moves not at all, and the element count must be a whole number
# of slices of whole tiles (n = width * rows * depth, rows a multiple of 16).
#
# Both readers carry it: the transpiler writes the prologue (per, tps, slc,
# gs, row, col, i) and the interpreter keeps the slice in the thread; a depth
# of one is the 2-D grid it always was. width and depth are each a number or
# a declared scalar.
#
# Run with haro: haro gpu_grid3_narrated.haro

load "../../stzBase.ring"

$nPass = 0
$nFail = 0

pr()

$nStzPlaces = 4
tNL = Char(10)

? "-- Scene 1: slices of width grids, in both readers --"
$nT0 = Clock()
kLit = StzKernelMakerFromSpec("in a" + tNL + "out c" + tNL + "width 16" + tNL + "depth 3" + tNL + "body { @c = @slice * 1000 + @row * 16 + @col + @a * 0 }")
tW = kLit.ToWGSL()
chk("the transpiler splits the elements into slices of per = n / 3, then tiles",
	StzFindFirst("let per = p.n / 3u;", tW) > 0 and StzFindFirst("let tps = per / 256u;", tW) > 0 and StzFindFirst("let slc = g / tps;", tW) > 0)
chk("...and puts the cell at slice * per + row * width + col, with @slice reading the slice",
	StzFindFirst("let i = slc * per + row * 16u + col;", tW) > 0 and StzFindFirst("f32(slc)", tW) > 0)
xSeq = _Seq(768)
xC = kLit.EvaluateOn([ [:a, xSeq] ])
bOk = true
for j = 1 to 768
	nJ0 = j - 1
	if xC[j] != Floor(nJ0 / 256) * 1000 + nJ0 % 256
		bOk = false
	end
end
chk("the interpreter: three 16 x 16 slices, every cell is slice * 1000 + its place in its own slice (768 cells)", bOk)
kSc = StzKernelMakerFromSpec("in a" + tNL + "scalar w" + tNL + "scalar d" + tNL + "out c" + tNL + "width w" + tNL + "depth d" + tNL + "body { @c = @slice * 10000 + @row * 100 + @col + @a * 0 }")
chk("width and depth as scalars are read from the parameters",
	StzFindFirst("let per = p.n / u32(p.s_d);", kSc.ToWGSL()) > 0 and StzFindFirst("let tpr = u32(p.s_w) / 16u;", kSc.ToWGSL()) > 0)
xS = kSc.EvaluateOn([ [:a, _Seq(2048)], [:w, 32], [:d, 2] ])
chk("two 32 x 32 slices: the cell at element 1058 is slice 1, row 1, column 1 (10101), and element 33 is slice 0, row 1, column 0 (100)",
	xS[1058] = 10101 and xS[33] = 100 and xS[2048] = 10000 + 31 * 100 + 31)
xOne = kSc.EvaluateOn([ [:a, _Seq(1024)], [:w, 32], [:d, 1] ])
chk("a depth of one is the 2-D grid it always was: @slice is 0 and rows count down the whole grid",
	xOne[33] = 100 and xOne[1024] = 31 * 100 + 31)
tT = ""
try
	kSc.EvaluateOn([ [:a, _Seq(1536)], [:w, 32], [:d, 2] ])
catch
	tT = cCatchError
end
chk("elements that are not whole slices of whole tiles are refused by name (" + Left(tT, 70) + ")", StzFindFirst("whole slices", tT) > 0)
tT = ""
try
	kSc.EvaluateOn([ [:a, _Seq(1024)], [:w, 32], [:d, 0] ])
catch
	tT = cCatchError
end
chk("a depth scalar of zero is refused by name", StzFindFirst("depth scalar", tT) > 0)
? "  (scene 1: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"

? ""
? "-- Scene 2: what is refused, in the same words by both readers --"
$nT0 = Clock()
# (two depth lines are refused by the engine's own test: the face keeps one depth, as it keeps one width)
xRef = [
	[ "@slice without a depth line", "in a" + tNL + "out c" + tNL + "width 16" + tNL + "body { @c = @a + @slice }", "'@slice' needs a depth line" ],
	[ "a depth line without a width line", "in a" + tNL + "out c" + tNL + "depth 2" + tNL + "body { @c = @a }", "a depth line needs a width line" ],
	[ "a depth of zero", "in a" + tNL + "out c" + tNL + "width 16" + tNL + "depth 0" + tNL + "body { @c = @a }", "depth 0 holds no slice" ],
	[ "a depth that is not a declared scalar", "in a" + tNL + "out c" + tNL + "width 16" + tNL + "depth d" + tNL + "body { @c = @a }", "depth must be a declared scalar or a number" ],
	[ "a scalar named slice", "in a" + tNL + "scalar slice" + tNL + "out c" + tNL + "width 16" + tNL + "body { @c = @a }", "'slice' is the slice of a 3-D grid" ]
]
for vQ in xRef
	tT = ""
	try
		StzKernelMakerFromSpec(vQ[2]).ToWGSL()
	catch
		tT = cCatchError
	end
	tI = ""
	try
		StzKernelMakerFromSpec(vQ[2]).EvaluateOn([ [:a, _Seq(256)] ])
	catch
		tI = cCatchError
	end
	chk(_T(vQ[1]) + ": both readers refuse it with '" + _T(vQ[3]) + "'", StzFindFirst(vQ[3], tT) > 0 and tT = tI)
end
? "  (scene 2: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"

oG = new stzGpu
bDevice = oG.IsAvailable()
if bDevice
	? ""
	? "-- Scene 3: on the device --"
	$nT0 = Clock()
	tHead = "in a" + tNL + "scalar w" + tNL + "scalar d" + tNL + "scalar p" + tNL + "out c" + tNL + "width w" + tNL + "depth d" + tNL
	xA = []
	for i = 1 to 1536
		xA + (i % 13)
	end
	xB = [ [ "a", xA ], [ "w", 16 ], [ "d", 3 ], [ "p", 512 ] ]
	vOpt = [ [ "n", 1536 ], [ "hidden", [ [ "n", 1536 ], [ "bindings", xB ] ] ] ]
	vBodies = [
		"@slice * 1000 + @row * 16 + @col + @a * 0",
		"@a * (@slice + 1) + @row * 0.5",
		"when(@slice > 0, @a - @a[@i - p], @a)",
		"@a[@i + p] + @a",
		"sum(j, 0, d, @a[j * p + @row * w + @col])",
		"sum(j, 0, d, @a[j * p + @row * w + @col] * (j + 1))"
	]
	for tB in vBodies
		oKer = StzKernelMakerFromSpec(tHead + "body { @c = " + tB + " }")
		xV = oG.VerifySpecWith(oKer, oKer, xB, vOpt)
		chk(tB + ": three 16 x 32 slices, the device agrees with the interpreter (" + _T(xV[:verdict]) + ")", xV[:verdict] = "verified")
	end
	# a literal width and depth, a different shape: two slices of 48 x 16
	xA2 = []
	for i = 1 to 1536
		xA2 + ((i * 7) % 11)
	end
	vB2 = [ [ "a", xA2 ] ]
	oKer = StzKernelMakerFromSpec("in a" + tNL + "out c" + tNL + "width 48" + tNL + "depth 2" + tNL + "body { @c = @a * (@slice + 1) + @col - @row }")
	xV = oG.VerifySpecWith(oKer, oKer, vB2, [ [ "n", 1536 ], [ "hidden", [ [ "n", 1536 ], [ "bindings", vB2 ] ] ] ])
	chk("literal width 48 and depth 2: the device agrees with the interpreter (" + _T(xV[:verdict]) + ")", xV[:verdict] = "verified")
	? "  (scene 3: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"

	? ""
	? "-- Scene 4: the fuzz's grid kind, and its control --"
	$nT0 = Clock()
	nSeed = 20261028
	StzEngineGpuFuzzRun(nSeed, 300, 16384, 0.00001)
	? "  generated " + _T(StzEngineGpuFuzzResult(50)) + " grid kernels; ran " + _T(StzEngineGpuFuzzResult(4)) + ", agreed " + _T(StzEngineGpuFuzzResult(5)) + " (exact " + _T(StzEngineGpuFuzzResult(9)) + ")"
	chk("300 kernels: none refused by both readers, no split, no compile failure",
		StzEngineGpuFuzzResult(50) = 300 and StzEngineGpuFuzzResult(1) = 0 and StzEngineGpuFuzzResult(2) = 0 and StzEngineGpuFuzzResult(3) = 0)
	chk("...all 300 agree with the interpreter bit for bit, literal and scalar width and depth, one to four slices",
		StzEngineGpuFuzzResult(5) = 300 and StzEngineGpuFuzzResult(9) = 300 and StzEngineGpuFuzzResult(17) = 0)
	StzEngineGpuFuzzRun(nSeed, 300, 16384 + 64, 0.00001)
	nMut = StzEngineGpuFuzzResult(18)
	nCaught = StzEngineGpuFuzzResult(19)
	? "  slice stride read as the tiles per slice in " + _T(nMut) + ", caught " + _T(nCaught)
	chk("the control reads each grid's slice stride as the tiles per slice, and all 300 had one", nMut = 300)
	chk("...at least 80% were caught (measured 256 of 300; the 44 escapes are exactly the 44 volumes of ONE slice, where a stride has nothing to separate)", nCaught >= 0.8 * nMut)
	StzEngineGpuFuzzRun(nSeed, 300, 63, 0.00001)
	chk("the six float kinds still agree as before (300, 219 exactly)", StzEngineGpuFuzzResult(5) = 300 and StzEngineGpuFuzzResult(9) = 219)
	? "  (scene 4: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"
end

? ""
? "-- Scene 5: puzzle 19, what changed since the slice before --"
$nT0 = Clock()
oQ = StzKernelPuzzleQ("kp-19")
chk("the starter grades 'waiting for your implementation'", oQ.Grade(oQ.Starter()) = "waiting for your implementation")
chk("the task reads in four languages and ends with what the GPU did differently from a triple loop",
	oQ.Task("en") != "" and oQ.Task("fr") != "" and oQ.Task("ar") != "" and oQ.Task("ha") != "" and StzFindFirst("differently from a triple loop", oQ.Task("en")) > 0)
tHead = "in a" + tNL + "scalar w" + tNL + "scalar d" + tNL + "scalar p" + tNL + "out c" + tNL + "width w" + tNL + "depth d" + tNL
# the verdicts were worked out from the data (a is (i * 7) % 13, so a[0] = 0, and the hidden volume is
# 3 slices of 16 x 32, its first cell also 0) before the first run:
#   the row above:    element 33 (row 1, column 0) coincides, a[0] being 0; element 34 is the first wrong one
#   a stride of 1024: right at the shape shown; in the hidden volume (512 a slice) element 513 coincides, 514 does not
#   from slice 2:     element 1025 (slice 1, column 0) coincides; 1026 is the first wrong one
vCases = [
	[ "when(@slice > 0, @a - @a[@i - p], @a)", "verified" ],
	[ "@a - @a[@i - p]", "verified" ],
	[ "@a - when(@slice > 0, @a[@i - p], 0)", "verified" ],
	[ "when(@row > 0, @a - @a[@i - w], @a)", "mismatch at element 34" ],
	[ "when(@slice > 0, @a - @a[@i - 1024], @a)", "mismatch-hidden at element 514" ],
	[ "when(@slice > 1, @a - @a[@i - p], @a)", "mismatch at element 1026" ]
]
nAgree = 0
for vQ in vCases
	tSpec = tHead + "body { @c = " + _T(vQ[1]) + " }"
	if bDevice
		tV = oQ.Grade(tSpec)
	else
		tV = oQ.GradeOnCpu(tSpec)
	end
	chk(_T(vQ[1]) + " -> " + _T(vQ[2]) + " (" + tV + ")", tV = vQ[2])
	if oQ.GradeOnCpu(tSpec) = vQ[2]
		nAgree++
	end
end
chk("GradeOnCpu says the same words for all " + _T(Len(vCases)) + " cases", nAgree = Len(vCases))
tV = oQ.Grade("in a" + tNL + "scalar w" + tNL + "scalar d" + tNL + "scalar p" + tNL + "out c" + tNL + "width w" + tNL + "body { @c = when(@slice > 0, @a - @a[@i - p], @a) }")
chk("@slice with no depth line is refused by name (" + tV + ")", StzFindFirst("refused", tV) = 1 and StzFindFirst("needs a depth line", tV) > 0)
if bDevice
	tV = oQ.Grade(tHead + "body { @c = when(@slice > 0, @a - @a[@i - n / d], @a) }")
	tC = oQ.GradeOnCpu(tHead + "body { @c = when(@slice > 0, @a - @a[@i - n / d], @a) }")
	# A DEVICE FACT, kept out of the puzzle's mistakes because it is not the same on every device:
	# the RTX 3050 compiles a float division to a multiplication by a reciprocal and fuses it with the
	# subtraction, so for 1536 / 3 the index @i - n / d lands a hair under the element and reads the one
	# before (mismatch-hidden at element 514); the Intel iGPU divides exactly and verifies. The
	# interpreter divides exactly, so it can never see it -- which is the checker's whole reason to run the device
	? "  (n / d for three slices: device says '" + tV + "', interpreter says '" + tC + "')"
	chk("n / d, the quotient given as a division: the interpreter verifies it, and the device either agrees or the checker names the element where the division was not exact (" + tV + ")",
		tC = "verified" and (tV = "verified" or tV = "mismatch-hidden at element 514"))
	oE = StzExerciseQ("../../education/program/courses/kernel-puzzles/exercises/kp-19")
	# the parent lets go of the card first: since the GPU lease (2026-11-14) the graders ProveItself starts
	# cannot take it from their own parent, and would wait and answer "waiting for the device" (KP-PROVE-FLAKE)
	StzEngineGpuShutdown()
	xPr = oE.ProveItself()
	chk("the exercise proves itself through the System's checker: wrong refused " + _T(xPr[:wrong]) + ", right accepted " + _T(xPr[:right]) + ", failures " + _T(@@(xPr[:failures])),
		xPr[:wrong] = 5 and xPr[:right] = 3 and Len(xPr[:failures]) = 0)
end
? "  (scene 5: " + _T(((Clock() - $nT0) / ClocksPerSecond())) + " s)"

? ""
? "=========================================="
? "TOTAL: " + _T(($nPass + $nFail)) + " assertions, " + _T($nPass) + " pass, " + _T($nFail) + " fail"
? "=========================================="

pfq()
Shutdown($nFail)

func chk(tLabel, xCond)
	if _StzB(xCond)
		$nPass++
		? "  [OK] " + tLabel
	else
		$nFail++
		? "  [FAIL] " + tLabel
	end
end
func _Seq(nN)
	xR = []
	for q = 0 to nN - 1
		xR + q
	end
	return xR
end

# A value as text, as the guard's narration writes it: a text as it is, a whole number plainly, any other number
# to $nStzPlaces places, rounded half away from zero. (The library's one-argument Text and Round shadow the built-ins.)
func _T(xV)
	if IsString(xV)
		return xV
	end
	if not IsNumber(xV)
		return String(xV)
	end
	tS = String(xV)
	nLen = Len(tS)
	bPlain = true
	for k = 1 to nLen
		tC = tS[k]
		if tC = "n" or tC = "i"
			return tS
		end
		if tC = "." or tC = "e" or tC = "E"
			bPlain = false
		end
	end
	if bPlain
		return tS
	end
	nP = $nStzPlaces
	nScale = 1
	for k = 1 to nP
		nScale = nScale * 10
	end
	fV = Float(xV)
	bNeg = fV < Float(0)
	if bNeg
		fV = Float(0) - fV
	end
	nI = Floor(fV * Float(nScale) + 0.5f)
	if nP = 0
		tR = String(nI)
	else
		nW = (nI - nI % nScale) / nScale
		tF = String(nI % nScale)
		while Len(tF) < nP
			tF = "0" + tF
		end
		tR = String(nW) + "." + tF
	end
	if bNeg and nI != 0
		tR = "-" + tR
	end
	return tR
end

# A condition as true or false: a 1 or 0 from older code, or a boolean.
func _StzB(xV)
	if IsNumber(xV)
		return xV != 0
	end
	return xV
end

# The absolute value of any number: exact for an integer or a decimal, a float for a float.
func _StzAbs(xV)
	try
		if xV < 0
			return 0 - xV
		end
		return xV
	catch e
		fV = Float(xV)
		if fV < Float(0)
			return Float(0) - fV
		end
		return fV
	end
end
