# G6 measurement -- the ggml-Vulkan decision's numbers, taken AFTER the
# kill criteria were written (see the G6 section of SOFTANZA_GPU_PLAN.md).
#
# Compares the neural tier's ACTUAL compute route (StzEngineMatrixMulGgml:
# ggml's threaded SIMD f32 matmul, as shipped, bridge overhead included --
# that IS what the tier pays today) against the already-shipped wgpu path
# (StzEngineGpuOpMatmul on resident buffers) across the BERT-class shape
# census: attention/projection (k=384,n=384), FFN up/down (384<->1536),
# the batch-embedding shape, and the token-by-token DECODE matvec (m=1).
#
# wgpu here is a fair PROXY CEILING for ggml-Vulkan on this silicon: same
# GPU, same f32; if even the proxy cannot clear the bar, vendoring a
# second GPU stack cannot pay.

load "../../stzBase.ring"

$nStzPlaces = 3

StzEngineGpuInit($tStzGpuRuntime)
if _C(StzEngineGpuIsAvailable(), "=", 0)
    ? "NO GPU -- the measurement needs the proxy device"
    return
end
? "device: " + _T(StzEngineGpuAdapterName(StzEngineGpuSelectedAdapter()))
? ""
? "shape (m x k x n)      ggml-cpu ms   wgpu ms    ratio"

# the census: [m, k, n, label]
vShapes = [
    [ 128,  384,  384, "attn qkv/proj, seq 128" ],
    [ 128,  384, 1536, "ffn up,        seq 128" ],
    [ 128, 1536,  384, "ffn down,      seq 128" ],
    [ 512,  384, 1536, "ffn up,        seq 512" ],
    [ 4096, 384, 1536, "batch embed (32x128 tokens)" ],
    [ 1,    384, 1536, "DECODE matvec (m=1)" ],
    [ 1,   1536,  384, "DECODE matvec down" ]
]

for s = 1 to Len(vShapes)
    nM = vShapes[s][1]
    nK = vShapes[s][2]
    nN = vShapes[s][3]

    # ggml route: resident stz_matrix handles, repeated MulGgml
    nHA = StzEngineMatrixNew(nM, nK)
    nHB = StzEngineMatrixNew(nK, nN)
    nHR = StzEngineMatrixNew(nM, nN)
    for i = 1 to nM
        StzEngineMatrixSet(nHA, i, 1 + (i % nK), 1.5)
    end
    for i = 1 to nK
        StzEngineMatrixSet(nHB, i, 1 + (i % nN), 0.5)
    end
    StzEngineMatrixMulGgml(nHA, nHB, nHR)
    nGgml = 999999999
    for r = 1 to 5
        nT0 = StzEngineWatchTimestampNs()
        StzEngineMatrixMulGgml(nHA, nHB, nHR)
        nMs = (StzEngineWatchTimestampNs() - nT0) / 1000000
        if _C(nMs, "<", nGgml) nGgml = nMs end
    end

    # wgpu route: resident buffers, OpMatmul + Sync per rep
    nHGa = StzEngineGpuBufferNew(nM * nK * 4)
    nHGb = StzEngineGpuBufferNew(nK * nN * 4)
    nHGc = StzEngineGpuBufferNew(nM * nN * 4)
    vFill = []
    for i = 1 to nM * nK
        vFill + 1.5
    end
    StzEngineGpuBufferUploadList(nHGa, vFill)
    vFill = []
    for i = 1 to nK * nN
        vFill + 0.5
    end
    StzEngineGpuBufferUploadList(nHGb, vFill)
    StzEngineGpuOpMatmul(nHGa, nHGb, nHGc, nM, nK, nN)
    StzEngineGpuSync()
    nGpu = 999999999
    for r = 1 to 5
        nT0 = StzEngineWatchTimestampNs()
        StzEngineGpuOpMatmul(nHGa, nHGb, nHGc, nM, nK, nN)
        StzEngineGpuSync()
        nMs = (StzEngineWatchTimestampNs() - nT0) / 1000000
        if _C(nMs, "<", nGpu) nGpu = nMs end
    end

    ? "" + _T(nM) + " x " + _T(nK) + " x " + _T(nN) + "  (" + _T(vShapes[s][4]) + ")" + Char(10) +
        "    " + _T(nGgml) + "    " + _T(nGpu) + "    " + _T((_Q(nGgml, nGpu))) + "x"

    StzEngineMatrixFree(nHA)
    StzEngineMatrixFree(nHB)
    StzEngineMatrixFree(nHR)
    StzEngineGpuBufferFree(nHGa)
    StzEngineGpuBufferFree(nHGb)
    StzEngineGpuBufferFree(nHGc)
end
StzEngineGpuShutdown()

# A value as text, as the guard's narration writes it: a text as it is, a whole number plainly, any other number
# to $nStzPlaces places, rounded half away from zero. (The library's one-argument Text and Round shadow the built-ins.)
func _T(xV)
	if IsString(xV)
		return xV
	end
	if not IsNumber(xV)
		return String(xV)
	end
	tS = String(xV)
	nLen = Len(tS)
	bPlain = true
	for k = 1 to nLen
		tC = tS[k]
		if tC = "n" or tC = "i"
			return tS
		end
		if tC = "." or tC = "e" or tC = "E"
			bPlain = false
		end
	end
	if bPlain
		return tS
	end
	nP = $nStzPlaces
	nScale = 1
	for k = 1 to nP
		nScale = nScale * 10
	end
	fV = Float(xV)
	bNeg = fV < Float(0)
	if bNeg
		fV = Float(0) - fV
	end
	nI = Floor(fV * Float(nScale) + 0.5f)
	if nP = 0
		tR = String(nI)
	else
		nW = _Q((nI - nI % nScale), nScale)
		tF = String(nI % nScale)
		while Len(tF) < nP
			tF = "0" + tF
		end
		tR = String(nW) + "." + tF
	end
	if bNeg and nI != 0
		tR = "-" + tR
	end
	return tR
end

# A condition as true or false: a 1 or 0 from older code, or a boolean.
func _StzB(xV)
	if IsNumber(xV)
		return xV != 0
	end
	return xV
end

# The absolute value of any number: exact for an integer or a decimal, a float for a float.
func _StzAbs(xV)
	try
		if xV < 0
			return 0 - xV
		end
		return xV
	catch e
		fV = Float(xV)
		if fV < Float(0)
			return Float(0) - fV
		end
		return fV
	end
end

# A quotient as the older code took it: exact when one exists; otherwise, taken through floats, a decimal to
# nine places, or a float when either side is a float.
func _Q(xA, xB)
	try
		return xA / xB
	catch e
	end
	fQ = Float(String(xA)) / Float(String(xB))
	if _StzIsFloat(xA) or _StzIsFloat(xB)
		return fQ
	end
	try
		return Decimal(fQ, 9)
	catch e
		return fQ
	end
end

# A comparison as the older code made it, where every number was of one kind: the comparison itself when both
# sides are of one kind; otherwise both sides as floats, equal when neither is below the other, and a NaN equal
# to nothing.
func _C(xA, tOp, xB)
	try
		if tOp = "="
			return xA = xB
		end
		if tOp = "!="
			return xA != xB
		end
		if tOp = "<"
			return xA < xB
		end
		if tOp = ">"
			return xA > xB
		end
		if tOp = "<="
			return xA <= xB
		end
		return xA >= xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	bNaN = _StzNaN(fA) or _StzNaN(fB)
	if tOp = "="
		return not bNaN and not (fA < fB) and not (fA > fB)
	end
	if tOp = "!="
		return bNaN or fA < fB or fA > fB
	end
	if bNaN
		return false
	end
	if tOp = "<"
		return fA < fB
	end
	if tOp = ">"
		return fA > fB
	end
	if tOp = "<="
		return not (fA > fB)
	end
	return not (fA < fB)
end

# A number, or a true or false, as a float (the older code read a true as 1).
func _StzF(xV)
	if IsNumber(xV)
		if _StzIsFloat(xV)
			return xV
		end
		return Float(String(xV))
	end
	if xV
		return 1.0f
	end
	return 0.0f
end

# True for a NaN, read from its text.
func _StzNaN(xV)
	if not IsNumber(xV)
		return false
	end
	tS = String(xV)
	return tS = "nan" or tS = "-nan"
end

# True for a float: an integer or a decimal takes a zero added, a float refuses it.
func _StzIsFloat(xV)
	if not IsNumber(xV)
		return false
	end
	try
		xT = xV + 0
		return false
	catch e
		return true
	end
end

# Arithmetic as the older code did it, where every number was of one kind: the operation itself when both sides
# are of one kind; otherwise both sides as floats.
func _A(xA, tOp, xB)
	try
		if tOp = "+"
			return xA + xB
		end
		if tOp = "-"
			return xA - xB
		end
		return xA * xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	if tOp = "+"
		return fA + fB
	end
	if tOp = "-"
		return fA - fB
	end
	return fA * fB
end
