# The NATIVE half of the G5 edge-convergence proof (SOFTANZA_GPU_PLAN.md),
# extended by KP0 (2026-10-24) from one case to five, and by KP3 (2026-10-27) to eight.
#
# Emits edge_proof/fixture.js: for each case a kernel SPEC, the native engine's
# WGSL for it, f32-exact inputs (each with its own length), the ordered
# scalars, the output count n, and the natively computed GPU results. The
# browser harness (edge_proof.html) then proves convergence per case:
#   1. stz.wasm (the freestanding build of the SAME transpiler) turns the
#      same spec into BYTE-IDENTICAL WGSL, and
#   2. the browser's WebGPU runs that kernel to results EXACTLY equal to
#      the native run's (an element both sides leave unwritten reads 0 on
#      both: WebGPU zero-fills a new buffer, natively and in the browser).
#
# The five cases: the original axpby (G5); the element index; the learner's
# guard; the stencil with its edge guard; the reduction's first pass over an
# input longer than n (KP0's four admissions).
#
# To run the proof (needs a WebGPU browser; result 2026-08-07: 5/5 PASS):
#   cd base/test/gpu ; haro edge_proof/gen_fixture.haro
#   cp ../../../engine/zig-out/bin/stz.wasm edge_proof/   (zig build wasm)
#   serve edge_proof/ over http and open edge_proof.html
#
# RUN FROM base/test/gpu (the engine-dir sensitivity applies).

load "../../stzBase.ring"

$oG = new stzGpu
if not $oG.IsAvailable()
    ? "no GPU on this machine -- the fixture needs the native results"
    return
end

$vCases = []

# ---- case 1: the original G5 kernel
oK1 = StzKernelMakerQ()
oK1.TakesVector(:a)
oK1.TakesVector(:b)
oK1.TakesScalar(:alpha)
oK1.ReturnsVector(:c)
oK1.ForEachElement('{ @C = alpha * @A + @B }')
nN = 256
vA = []
vB = []
for i = 1 to nN
    vA + ((i-1) / 2.0)
    vB + ((i-1) / 4.0)
end
AddCase("axpby", oK1, [ [:a, vA], [:b, vB], [:alpha, 2.5] ], [ vA, vB ], [ 2.5 ], nN)

# ---- case 2: the element index
oK2 = StzKernelMakerQ()
oK2.TakesVector(:a)
oK2.ReturnsVector(:c)
oK2.ForEachElement('{ @c = @a + @i }')
AddCase("index", oK2, [ [:a, vA] ], [ vA ], [], nN)

# ---- case 3: the learner's guard (the last element stays unwritten: 0 on both sides)
oK3 = StzKernelMakerQ()
oK3.TakesVector(:a)
oK3.ReturnsVector(:c)
oK3.Guard('{ @i < n - 1 }')
oK3.ForEachElement('{ @c = @a * 2 }')
AddCase("guard", oK3, [ [:a, vA] ], [ vA ], [], nN)

# ---- case 4: the stencil with its edge guard
oK4 = StzKernelMakerQ()
oK4.TakesVector(:a)
oK4.ReturnsVector(:c)
oK4.Guard('{ @i > 0 and @i < n - 1 }')
oK4.ForEachElement('{ @c = (@a[@i - 1] + @a + @a[@i + 1]) / 3 }')
AddCase("stencil", oK4, [ [:a, vA] ], [ vA ], [], nN)

# ---- case 5: the reduction's first pass, 16 partials over 256
oK5 = StzKernelMakerQ()
oK5.TakesVector(:a)
oK5.ReturnsVector(:c)
oK5.ForEachElement('{ @c = sum(k, 0, 16, @a[@i * 16 + k]) }')
AddCase("partials", oK5, [ [:a, vA] ], [ vA ], [], 16)

# ---- KP3 (2026-10-27): the group's memory. Exact data, so both sides must agree bit for bit.
# case 6: each group of 256 reversed through a stage and a barrier
oK6 = StzKernelMakerQ()
oK6.TakesVector(:a)
oK6.ReturnsVector(:c)
oK6.Shared(:t, 256)
oK6.Stage('{ @t[@l] = @a }')
oK6.ForEachElement('{ @c = @t[255 - @l] }')
AddCase("shared-reverse", oK6, [ [:a, vA] ], [ vA ], [], nN)

# case 7: a reduce: every element gets its group's sum
oK7 = StzKernelMakerQ()
oK7.TakesVector(:a)
oK7.ReturnsVector(:c)
oK7.Shared(:t, 256)
oK7.Stage('{ @t[@l] = @a }')
oK7.Reduce(:t, :sum)
oK7.ForEachElement('{ @c = @t[0] }')
AddCase("reduce", oK7, [ [:a, vA] ], [ vA ], [], nN)

# case 8: the tiled matrix product, 16 x 32 times 32 x 32, small integers
vM = []
for i = 0 to 511
    vM + ((i * 7) % 13)
end
vBM = []
for i = 0 to 1023
    vBM + ((i * 3) % 7)
end
oK8 = StzKernelMakerQ()
oK8.TakesVector(:a)
oK8.TakesVector(:b)
oK8.TakesScalar(:k)
oK8.TakesScalar(:w)
oK8.ReturnsVector(:c)
oK8.Width(:w)
oK8.Shared(:ta, 256)
oK8.Shared(:tb, 256)
oK8.Tiles(:t, '{ k / 16 }')
oK8.Stage('{ @ta[@ly * 16 + @lx] = @a[@row * k + t * 16 + @lx] }')
oK8.Stage('{ @tb[@ly * 16 + @lx] = @b[(t * 16 + @ly) * w + @col] }')
oK8.Accumulate('{ @acc = @acc + sum(j, 0, 16, @ta[@ly * 16 + j] * @tb[j * 16 + @lx]) }')
oK8.ForEachElement('{ @c = @acc }')
AddCase("tiled-matmul", oK8, [ [:a, vM], [:b, vBM], [:k, 32], [:w, 32] ], [ vM, vBM ], [ 32, 32 ], 512)

tOut = "// generated by gen_fixture.haro -- the NATIVE side of the G5/KP0 proof" + Char(10)
tOut += "export const cases = [" + Char(10)
nC = Len($vCases)
for i = 1 to nC
    vCase = $vCases[i]
    tOut += "  { name: " + Char(34) + vCase[1] + Char(34) + ","
    tOut += " spec: " + Char(34) + _JsEscape(vCase[2]) + Char(34) + ","
    tOut += " nativeWgsl: " + Char(34) + _JsEscape(vCase[3]) + Char(34) + ","
    tOut += " n: " + String(vCase[6]) + ","
    tOut += " inputs: ["
    nI = Len(vCase[4])
    for j = 1 to nI
        if j > 1
            tOut += ","
        end
        tOut += "[" + _JoinNums(vCase[4][j]) + "]"
    end
    tOut += "], scalars: [" + _JoinNums(vCase[5]) + "],"
    tOut += " expected: [" + _JoinNums(vCase[7]) + "] }"
    if i < nC
        tOut += ","
    end
    tOut += Char(10)
end
tOut += "];" + Char(10)
Write("edge_proof/fixture.js", tOut)
? "fixture written: " + String(nC) + " cases"
for vCase in $vCases
    ? "  " + vCase[1] + ": spec " + String(Len(vCase[2])) + " chars, wgsl " + String(Len(vCase[3])) + " chars, n " + String(vCase[6]) + ", " + String(Len(vCase[7])) + " expected values"
end

func AddCase(tName, oKer, xBindings, xInputs, xScalars, xN)
    xExp = $oG.RunWith(oKer, xBindings, [ [:n, xN] ])
    $vCases + [ tName, oKer.Spec(), oKer.ToWGSL(), xInputs, xScalars, xN, xExp ]
end
func _JsEscape(ptS)
    xC = StzReplace(ptS, "\", "\\")
    xC = StzReplace(xC, Char(34), "\" + Char(34))
    xC = StzReplace(xC, Char(10), "\n")
    return xC
end
func _JoinNums(pxList)
    tC = ""
    nN = Len(pxList)
    for i = 1 to nN
        if i > 1
            tC += ","
        end
        tC += _JsNum(pxList[i])
    end
    return tC
end

# A number as the older runtime wrote it into the fixture: a whole value bare, any other
# to two places, rounded half away from zero (0.50, 127.50). The browser reads either form.
func _JsNum(xV)
	if IsString(xV)
		return xV
	end
	if not IsNumber(xV)
		return String(xV)
	end
	tS = String(xV)
	nLen = Len(tS)
	bPlain = true
	for oK1 = 1 to nLen
		tC = tS[oK1]
		if tC = "n" or tC = "i"
			return tS
		end
		if tC = "." or tC = "e" or tC = "E"
			bPlain = false
		end
	end
	if bPlain
		return tS
	end
	nP = 2
	nScale = 1
	for oK1 = 1 to nP
		nScale = nScale * 10
	end
	if _StzIsFloat(xV)
		fV = xV
		bNeg = fV < Float(0)
		if bNeg
			fV = Float(0) - fV
		end
		# fewer places for a float too large to scale into a whole number
		while nP > 0 and fV * Float(nScale) >= 9000000000000000.0f
			nP = nP - 1
			nScale = (nScale - nScale % 10) / 10
		end
		nI = Floor(fV * Float(nScale) + 0.5f)
	else
		xA = xV
		bNeg = xA < 0
		if bNeg
			xA = 0 - xA
		end
		# fewer places for a decimal whose digits would pass 64 bits
		xW = xA - xA % 1
		while nP > 0 and Len(String(Integer(xW))) + nP > 18
			nP = nP - 1
			nScale = (nScale - nScale % 10) / 10
		end
		xT = xA * nScale + 0.5
		nI = Integer(xT - xT % 1)
	end
	if nP = 0
		tR = String(nI)
	elseif nI % nScale = 0
		tR = String(_Q((nI - nI % nScale), nScale))
	else
		nW = _Q((nI - nI % nScale), nScale)
		tF = String(nI % nScale)
		while Len(tF) < nP
			tF = "0" + tF
		end
		tR = String(nW) + "." + tF
	end
	if bNeg and nI != 0
		tR = "-" + tR
	end
	return tR
end

func _Q(xA, xB)
	try
		return xA / xB
	catch e
	end
	return _StzF(xA) / _StzF(xB)
end

func _StzIsFloat(xV)
	if not IsNumber(xV)
		return false
	end
	try
		xT = xV + 0
		return false
	catch e
		return true
	end
end
