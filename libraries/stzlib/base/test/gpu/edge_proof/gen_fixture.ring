# The NATIVE half of the G5 edge-convergence proof (SOFTANZA_GPU_PLAN.md),
# extended by KP0 (2026-10-24) from one case to five, and by KP3 (2026-10-27) to eight.
#
# Emits edge_proof/fixture.js: for each case a kernel SPEC, the native engine's
# WGSL for it, f32-exact inputs (each with its own length), the ordered
# scalars, the output count n, and the natively computed GPU results. The
# browser harness (edge_proof.html) then proves convergence per case:
#   1. stz.wasm (the freestanding build of the SAME transpiler) turns the
#      same spec into BYTE-IDENTICAL WGSL, and
#   2. the browser's WebGPU runs that kernel to results EXACTLY equal to
#      the native run's (an element both sides leave unwritten reads 0 on
#      both: WebGPU zero-fills a new buffer, natively and in the browser).
#
# The five cases: the original axpby (G5); the element index; the learner's
# guard; the stencil with its edge guard; the reduction's first pass over an
# input longer than n (KP0's four admissions).
#
# To run the proof (needs a WebGPU browser; result 2026-08-07: 5/5 PASS):
#   cd base/test/gpu ; rnxc edge_proof/gen_fixture.ring
#   cp ../../../engine/zig-out/bin/stz.wasm edge_proof/   (zig build wasm)
#   serve edge_proof/ over http and open edge_proof.html
#
# RUN FROM base/test/gpu (the engine-dir sensitivity applies).

load "../../stzBase.ring"

$oG = new stzGpu
if NOT $oG.IsAvailable()
    ? "no GPU on this machine -- the fixture needs the native results"
    return
ok

$aCases = []

# ---- case 1: the original G5 kernel
k = StzKernelMakerQ()
k.TakesVector(:A)
k.TakesVector(:B)
k.TakesScalar(:alpha)
k.ReturnsVector(:C)
k.ForEachElement('{ @C = alpha * @A + @B }')
nN = 256
aA = []
aB = []
for i = 1 to nN
    aA + ((i-1) / 2.0)
    aB + ((i-1) / 4.0)
next
AddCase("axpby", k, [ :A = aA, :B = aB, :alpha = 2.5 ], [ aA, aB ], [ 2.5 ], nN)

# ---- case 2: the element index
k2 = StzKernelMakerQ()
k2.TakesVector(:a)
k2.ReturnsVector(:c)
k2.ForEachElement('{ @c = @a + @i }')
AddCase("index", k2, [ :a = aA ], [ aA ], [], nN)

# ---- case 3: the learner's guard (the last element stays unwritten: 0 on both sides)
k3 = StzKernelMakerQ()
k3.TakesVector(:a)
k3.ReturnsVector(:c)
k3.Guard('{ @i < n - 1 }')
k3.ForEachElement('{ @c = @a * 2 }')
AddCase("guard", k3, [ :a = aA ], [ aA ], [], nN)

# ---- case 4: the stencil with its edge guard
k4 = StzKernelMakerQ()
k4.TakesVector(:a)
k4.ReturnsVector(:c)
k4.Guard('{ @i > 0 and @i < n - 1 }')
k4.ForEachElement('{ @c = (@a[@i - 1] + @a + @a[@i + 1]) / 3 }')
AddCase("stencil", k4, [ :a = aA ], [ aA ], [], nN)

# ---- case 5: the reduction's first pass, 16 partials over 256
k5 = StzKernelMakerQ()
k5.TakesVector(:a)
k5.ReturnsVector(:c)
k5.ForEachElement('{ @c = sum(k, 0, 16, @a[@i * 16 + k]) }')
AddCase("partials", k5, [ :a = aA ], [ aA ], [], 16)

# ---- KP3 (2026-10-27): the group's memory. Exact data, so both sides must agree bit for bit.
# case 6: each group of 256 reversed through a stage and a barrier
k6 = StzKernelMakerQ()
k6.TakesVector(:a)
k6.ReturnsVector(:c)
k6.Shared(:t, 256)
k6.Stage('{ @t[@l] = @a }')
k6.ForEachElement('{ @c = @t[255 - @l] }')
AddCase("shared-reverse", k6, [ :a = aA ], [ aA ], [], nN)

# case 7: a reduce: every element gets its group's sum
k7 = StzKernelMakerQ()
k7.TakesVector(:a)
k7.ReturnsVector(:c)
k7.Shared(:t, 256)
k7.Stage('{ @t[@l] = @a }')
k7.Reduce(:t, :sum)
k7.ForEachElement('{ @c = @t[0] }')
AddCase("reduce", k7, [ :a = aA ], [ aA ], [], nN)

# case 8: the tiled matrix product, 16 x 32 times 32 x 32, small integers
aM = []
for i = 0 to 511
    aM + ((i * 7) % 13)
next
bM = []
for i = 0 to 1023
    bM + ((i * 3) % 7)
next
k8 = StzKernelMakerQ()
k8.TakesVector(:a)
k8.TakesVector(:b)
k8.TakesScalar(:k)
k8.TakesScalar(:w)
k8.ReturnsVector(:c)
k8.Width(:w)
k8.Shared(:ta, 256)
k8.Shared(:tb, 256)
k8.Tiles(:t, '{ k / 16 }')
k8.Stage('{ @ta[@ly * 16 + @lx] = @a[@row * k + t * 16 + @lx] }')
k8.Stage('{ @tb[@ly * 16 + @lx] = @b[(t * 16 + @ly) * w + @col] }')
k8.Accumulate('{ @acc = @acc + sum(j, 0, 16, @ta[@ly * 16 + j] * @tb[j * 16 + @lx]) }')
k8.ForEachElement('{ @c = @acc }')
AddCase("tiled-matmul", k8, [ :a = aM, :b = bM, :k = 32, :w = 32 ], [ aM, bM ], [ 32, 32 ], 512)

cOut = "// generated by gen_fixture.ring -- the NATIVE side of the G5/KP0 proof" + char(10)
cOut += "export const cases = [" + char(10)
nC = len($aCases)
for i = 1 to nC
    c = $aCases[i]
    cOut += "  { name: " + char(34) + c[1] + char(34) + ","
    cOut += " spec: " + char(34) + _JsEscape(c[2]) + char(34) + ","
    cOut += " nativeWgsl: " + char(34) + _JsEscape(c[3]) + char(34) + ","
    cOut += " n: " + c[6] + ","
    cOut += " inputs: ["
    nI = len(c[4])
    for j = 1 to nI
        if j > 1
            cOut += ","
        ok
        cOut += "[" + _JoinNums(c[4][j]) + "]"
    next
    cOut += "], scalars: [" + _JoinNums(c[5]) + "],"
    cOut += " expected: [" + _JoinNums(c[7]) + "] }"
    if i < nC
        cOut += ","
    ok
    cOut += char(10)
next
cOut += "];" + char(10)
write("edge_proof/fixture.js", cOut)
? "fixture written: " + nC + " cases"
for c in $aCases
    ? "  " + c[1] + ": spec " + len(c[2]) + " chars, wgsl " + len(c[3]) + " chars, n " + c[6] + ", " + len(c[7]) + " expected values"
next

func AddCase cName, oK, aBindings, aInputs, aScalars, n
    aExp = $oG.RunWith(oK, aBindings, [ :n = n ])
    $aCases + [ cName, oK.Spec(), oK.ToWGSL(), aInputs, aScalars, n, aExp ]

func _JsEscape pcS
    _c_ = StzReplace(pcS, "\", "\\")
    _c_ = StzReplace(_c_, char(34), "\" + char(34))
    _c_ = StzReplace(_c_, char(10), "\n")
    return _c_

func _JoinNums paList
    _c_ = ""
    _n_ = len(paList)
    for _i_ = 1 to _n_
        if _i_ > 1
            _c_ += ","
        ok
        _c_ += "" + paList[_i_]
    next
    return _c_
