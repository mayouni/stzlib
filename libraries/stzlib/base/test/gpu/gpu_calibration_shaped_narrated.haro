# GK1 -- the SHAPE-KEYED calibration store (SOFTANZA_GPU_PLAN.md, GK1).
#
# The flat store held ONE number per op (dispatch pairdist from n*d >= T).
# GK1's probe measured, on 2026-09-09, that T on disk routed half the
# (dimension x corpus) grid to a GPU that lost by 2-10x, and that on the
# Intel iGPU the crossover moves 4x with the dimension. So the store gains
# a shape: (op, n-class, d-class) -> the measured cpu/gpu ratio, classes
# being powers-of-two ceilings; the gate applies ONE margin; an unmeasured
# class falls back to the flat line; and the authority order G5 wrote --
# explicit > persisted > seed -- is carried to shapes with a flag.
#
# What this suite asserts, mechanism first, each with its negative sibling:
#   - classes bucket as powers of two (16000 and 16384 share one, 16385 does not)
#   - the ROUTE: a measured class decides by its ratio against the margin;
#     a ratio under the margin stays CPU; an unmeasured class falls back to
#     the flat line; an EXPLICIT flat line outranks a FILLED class (a guard
#     forcing a route keeps working after a file has loaded)
#   - the SEAM consults the shape: a losing class keeps a corpus on the CPU
#     even where the flat line would dispatch it, and a winning class sends
#     a corpus the flat line would keep -- witnessed by the dispatch counter
#   - persistence ROUND-TRIPS shapes AND the ladder: written, scrambled,
#     restored from disk; the file holds a trace row per measured cell
#   - CalibrateShapedWith on a small grid stores a class per cell, sets the
#     flat line to the most conservative crossover (or beyond the ladder),
#     and CHECKS ITSELF at two shapes the grid never held
#
# The device scenes need a GPU; the store and classing scenes are CI's.

load "../../stzBase.ring"

$nPass = 0
$nFail = 0

xC_DISP = 0

pr()

$nStzPlaces = 3

? "-- Scene 1: shape classes are powers-of-two ceilings --"
chk("1000 and 1024 share class 10", _C(StzEngineGpuShapeClass(1000), "=", 10) and _C(StzEngineGpuShapeClass(1024), "=", 10))
chk("1025 is class 11 (the negative sibling)", _C(StzEngineGpuShapeClass(1025), "=", 11))
chk("16000 and 16384 share class 14; 16385 does not",
	StzEngineGpuShapeClass(16000) = 14 and _C(StzEngineGpuShapeClass(16385), "=", 15))
chk("dimension 16 is class 4, 1 is class 0", _C(StzEngineGpuShapeClass(16), "=", 4) and _C(StzEngineGpuShapeClass(1), "=", 0))

? ""
? "-- Scene 2: the route, device-free --"
# a private op name so nothing persisted interferes
tOp = "gk1_route_test"
chk("no calibration at all: CPU", _C(StzEngineGpuCalibRouteShaped(tOp, 4000, 256), "=", 0))
StzEngineGpuCalibFill(tOp, 100000)
chk("a flat line filled from 'disk': n*d = 1,024,000 dispatches", _C(StzEngineGpuCalibRouteShaped(tOp, 4000, 256), "=", 1))
chk("...and n*d = 1,600 does not", _C(StzEngineGpuCalibRouteShaped(tOp, 100, 16), "=", 0))
StzEngineGpuCalibFillShaped(tOp, 4000, 256, 0.6)
chk("a measured class that LOSES overrides the flat line for its class", _C(StzEngineGpuCalibRouteShaped(tOp, 3000, 200), "=", 0))
chk("...and only its class: (4000, 1024) still follows the flat line", _C(StzEngineGpuCalibRouteShaped(tOp, 4000, 1024), "=", 1))
StzEngineGpuCalibSetShaped(tOp, 1000, 16, 1.1)
chk("a class the GPU wins by 1.1x is UNDER the 1.3 margin: CPU", _C(StzEngineGpuCalibRouteShaped(tOp, 1000, 16), "=", 0))
StzEngineGpuCalibSetShaped(tOp, 1000, 16, 2.0)
chk("...at 2.0x it dispatches, though n*d = 16,000 is far below the flat line", _C(StzEngineGpuCalibRouteShaped(tOp, 1000, 16), "=", 1))
StzEngineGpuCalibSet(tOp, 1)
chk("an EXPLICIT flat line outranks the FILLED losing class (a guard forcing a route)", _C(StzEngineGpuCalibRouteShaped(tOp, 4000, 256), "=", 1))
StzEngineGpuCalibSetShaped(tOp, 4000, 256, 0.6)
chk("...but not an explicit shaped one: both in-process, the specific wins", _C(StzEngineGpuCalibRouteShaped(tOp, 4000, 256), "=", 0))
StzEngineGpuCalibSetShaped(tOp, 4000, 256, 0)
chk("setting a class to 0 clears it: back to the flat line", _C(StzEngineGpuCalibRouteShaped(tOp, 4000, 256), "=", 1))
StzEngineGpuCalibFill(tOp, 999999)
chk("a fill never overrides a set value", _C(StzEngineGpuCalibGet(tOp), "=", 1))

oG = new stzGpu
if not oG.IsAvailable()
	? ""
	? "  NO GPU ON THIS MACHINE -- the seam, round-trip and grid scenes need a device; scenes 1-2 are the CI coverage"
else
	? ""
	? "  device: " + _T(oG.DeviceName())
	? ""
	? "-- Scene 3: the SEAM consults the shape --"
	# a small corpus: 200 x 16 = 3,200 elements, class (8, 4)
	vVecs = []
	for i = 0 to 199
		vRow = []
		for j = 0 to 15
			vRow + ((i * 7 + j * 13) % 32)
		end
		vVecs + vRow
	end
	vQry = []
	for j = 0 to 15
		vQry + ((j * 3 + 11) % 32)
	end
	# the flat line says GPU for everything...
	StzEngineGpuCalibSet("pairdist", 1)
	# ...but the class of this corpus was measured to LOSE
	StzEngineGpuCalibSetShaped("pairdist", 200, 16, 0.5)
	StzEngineGpuCountersReset()
	oIdx = new stzVectorIndex(vVecs)
	xRes = oIdx.SearchExact(vQry, 3)
	chk("a losing class keeps the corpus on the CPU: NO dispatch, though the flat line would send it",
		Len(xRes) = 3 and _C(StzEngineGpuCounter(xC_DISP), "=", 0))
	# the negative sibling: the class WINS, the flat line says CPU
	StzEngineGpuCalibSet("pairdist", 999999999999)
	StzEngineGpuCalibSetShaped("pairdist", 200, 16, 3.0)
	StzEngineGpuCountersReset()
	oIdx2 = new stzVectorIndex(vVecs)
	xRes2 = oIdx2.SearchExact(vQry, 3)
	chk("a winning class sends the corpus to the GPU: the dispatch counter MOVED, though the flat line would keep it",
		Len(xRes2) = 3 and _C(StzEngineGpuCounter(xC_DISP), ">", 0))
	chk("both routes name the same neighbours", _C(xRes[1][1], "=", xRes2[1][1]) and _C(xRes[2][1], "=", xRes2[2][1]))
	StzEngineGpuCalibSetShaped("pairdist", 200, 16, 0)   # clear the class

	? ""
	? "-- Scene 3b: Wake() does the work it claims --"
	# the mechanism, not the vibe: Wake copies until a copy runs at full
	# speed, then settles and STOPS -- so a device that is already awake
	# is recognised within its settle count, whatever the cap
	nT0 = StzEngineWatchTimestampNs()
	nCopies = oG.Wake(400)
	nWakeMs = (StzEngineWatchTimestampNs() - nT0) / 1000000
	? "  Wake(400): " + _T(nCopies) + " copies of 16 MB in " + _T(nWakeMs) + " ms"
	chk("Wake dispatched copies", _C(nCopies, ">", 0))
	chk("...and stopped within its cap", _C(nWakeMs, "<", 450))
	nT0 = StzEngineWatchTimestampNs()
	nAgain = oG.Wake(400)
	nAgainMs = (StzEngineWatchTimestampNs() - nT0) / 1000000
	? "  Wake(400) again, device awake: " + _T(nAgain) + " copies in " + _T(nAgainMs) + " ms"
	chk("an AWAKE device is recognised: the second burst stops at the settle count (<= 25 copies)", _C(nAgain, ">", 0) and _C(nAgain, "<=", 25))
	chk("...in a few ms, not the cap (the cap is a cap)", _C(nAgainMs, "<", 100))

	? ""
	? "-- Scene 4: persistence round-trips shapes AND the ladder --"
	# this guard writes the calibration files to prove the round trip, but
	# a four-cell grid is NOT this machine's calibration: the real files
	# are kept and put back at the end
	tBakA = ""
	tBakD = ""
	if FExists(StzGpuCalibFileForAdapter())
		tBakA = Read(StzGpuCalibFileForAdapter())
		Remove(StzGpuCalibFileForAdapter())
	end
	if FExists(StzGpuCalibFileDefault())
		tBakD = Read(StzGpuCalibFileDefault())
	end
	StzEngineGpuCalibSet("pairdist", 4096000)
	StzGpuCalibSetShaped("pairdist", 4000, 256, 2.519)
	StzGpuCalibAddLadderRow("pairdist", 4000, 256, 2.306, 3.576)
	StzGpuSaveCalibration(["pairdist"])
	tFile = Read(StzGpuCalibFileForAdapter())
	chk("the file holds the flat line", _C(StzFindFirst("pairdist" + Char(9) + "4096000", tFile), ">", 0))
	chk("...a shape row for the measured class", _C(StzFindFirst("shape" + Char(9) + "pairdist" + Char(9) + "4000" + Char(9) + "256", tFile), ">", 0))
	chk("...and the LADDER row that produced it (the trace, not just the number)",
		_C(StzFindFirst("ladder" + Char(9) + "pairdist" + Char(9) + "4000" + Char(9) + "256" + Char(9), tFile), ">", 0))
	# scramble, then restore from disk (the raw loader is the round-trip's own tool)
	StzEngineGpuCalibSetShaped("pairdist", 4000, 256, 0.1)
	StzEngineGpuCalibSet("pairdist", 7)
	_StzGpuCalibLoadFile(StzGpuCalibFileForAdapter())
	chk("the flat line is restored from disk", _C(StzEngineGpuCalibGet("pairdist"), "=", 4096000))
	chk("the shaped ratio is restored from disk (2.519)", _C(_StzAbs(_A(StzEngineGpuCalibGetShaped("pairdist", 4000, 256), "-", 2.519)), "<", 0.0005))
	xLad = StzGpuCalibrationLadder()
	chk("the ladder reads back", _C(Len(xLad), ">=", 1) and _C(xLad[Len(xLad)][2], "=", 4000) and _C(xLad[Len(xLad)][3], "=", 256))

	? ""
	? "-- Scene 5: CalibrateShapedWith on a small grid, and it checks itself --"
	xRep = oG.CalibrateShapedWith([16, 256], [1000, 4000])
	? "  adapter: " + _T(xRep[:adapter])
	nCells = Len(xRep[:cells])
	for i = 1 to nCells
		xCell = xRep[:cells][i]
		? "    d " + _T(xCell[1]) + "  n " + _T(xCell[2]) + "  cpu " + _T(xCell[3]) + " ms  gpu " + _T(xCell[4]) + " ms  ratio " + _T(xCell[5])
	end
	? "  flat line stored: " + _T(xRep[:flat]) + "  (" + _T(xRep[:flatwhy]) + ")"
	xCtl = xRep[:control]
	? "  control (first cell re-measured last): cpu " + _T(xCtl[3]) + " -> " + _T(xCtl[5]) + " ms (x" + _T(xCtl[7]) + ")   gpu " + _T(xCtl[4]) + " -> " + _T(xCtl[6]) + " ms (x" + _T(xCtl[8]) + ")"
	chk("four cells measured", _C(nCells, "=", 4))
	chk("the CONTROL ran: the first cell was measured again at the end (8 fields)", _C(Len(xCtl), "=", 8) and _C(xCtl[5], ">", 0) and _C(xCtl[6], ">", 0))
	if xRep[:confounded]
		? "  THE CONTROL MOVED: this grid is CONFOUNDED and was NOT persisted (a wrong number on disk routes every later process wrong)"
		chk("a confounded grid says so, and stores no flat line", xRep[:flatwhy] = "confounded" and _C(xRep[:flat], "=", 0))
		chk("...and its classes were withdrawn from the store", _C(StzEngineGpuCalibGetShaped("pairdist", 1000, 16), "=", 0))
		chk("...and it ran no hidden check (nothing to check against)", _C(Len(xRep[:hidden]), "=", 0))
	else
		chk("every cell stored its class (ratio readable from the engine)",
			_C(StzEngineGpuCalibGetShaped("pairdist", 1000, 16), ">", 0) and _C(StzEngineGpuCalibGetShaped("pairdist", 4000, 256), ">", 0))
		chk("the flat line is either a measured crossover or beyond the ladder (never the old seed)",
			_C(xRep[:flat], ">", 0) and _C(xRep[:flat], "!=", 256000) and (xRep[:flatwhy] = "crossover" or xRep[:flatwhy] = "beyond-ladder"))
		if xRep[:flatwhy] = "beyond-ladder"
			chk("beyond the ladder means past the largest n*d measured (1,024,000)", _C(xRep[:flat], "=", 1024001))
		else
			chk("a crossover is one of the grid's n*d values", _C(xRep[:flat], "=", 16000) or _C(xRep[:flat], "=", 64000) or _C(xRep[:flat], "=", 256000) or _C(xRep[:flat], "=", 1024000))
		end
		nHid = Len(xRep[:hidden])
		for i = 1 to nHid
			xHid = xRep[:hidden][i]
			? "    hidden d " + _T(xHid[1]) + "  n " + _T(xHid[2]) + "  cpu " + _T(xHid[3]) + " ms  gpu " + _T(xHid[4]) + " ms  ratio " + _T(xHid[8]) + "  predicted " + _T(xHid[5]) + "  measured " + _T(xHid[6]) + "  agree " + _T(xHid[7]) + "  decisive " + _T(xHid[9])
		end
		chk("TWO hidden shapes were checked (one in a measured class, one in an unmeasured one)", _C(nHid, "=", 2))
		chk("...and both were actually measured (both routes ran)", _C(xRep[:hidden][1][3], ">", 0) and _C(xRep[:hidden][1][4], ">", 0) and _C(xRep[:hidden][2][3], ">", 0))
		# a hidden shape counts against the store only when its measurement is
		# DECISIVE (ratio outside the margin band); a marginal shape agrees or
		# disagrees by noise, and a guard that fails by noise teaches nothing
		chk("the in-class hidden shape agrees with its class's verdict (or is marginal)", xRep[:hidden][1][7] or not xRep[:hidden][1][9])
		chk("the off-class hidden shape agrees with the estimate between measured classes, or the flat line where none brackets it (or is marginal)", xRep[:hidden][2][7] or not xRep[:hidden][2][9])
		chk("the ladder now holds every cell AND the hidden checks", _C(Len(StzGpuCalibrationLadder()), ">=", 6))
		tFile2 = Read(StzGpuCalibFileForAdapter())
		chk("the file was rewritten with the grid's shapes", _C(StzFindFirst("shape" + Char(9) + "pairdist" + Char(9) + "1000" + Char(9) + "16", tFile2), ">", 0))
	end
	# put the machine's real calibration back
	if tBakA != ""
		Write(StzGpuCalibFileForAdapter(), tBakA)
	else
		if FExists(StzGpuCalibFileForAdapter())
			Remove(StzGpuCalibFileForAdapter())
		end
	end
	if tBakD != ""
		Write(StzGpuCalibFileDefault(), tBakD)
	end
	chk("the machine's calibration files are back as they were", Read(StzGpuCalibFileDefault()) = tBakD)
end

? ""
? "=========================================="
? "TOTAL: " + _T(($nPass + $nFail)) + " assertions, " + _T($nPass) + " pass, " + _T($nFail) + " fail"
? "=========================================="

pfq()
Shutdown($nFail)

func chk(tLabel, xCond)
	if _StzB(xCond)
		$nPass++
		? "  [OK] " + tLabel
	else
		$nFail++
		? "  [FAIL] " + tLabel
	end
end

# A value as text, as the guard's narration writes it: a text as it is, a whole number plainly, any other number
# to $nStzPlaces places, rounded half away from zero. (The library's one-argument Text and Round shadow the built-ins.)
func _T(xV)
	if IsString(xV)
		return xV
	end
	if not IsNumber(xV)
		return String(xV)
	end
	tS = String(xV)
	nLen = Len(tS)
	bPlain = true
	for k = 1 to nLen
		tC = tS[k]
		if tC = "n" or tC = "i"
			return tS
		end
		if tC = "." or tC = "e" or tC = "E"
			bPlain = false
		end
	end
	if bPlain
		return tS
	end
	nP = $nStzPlaces
	nScale = 1
	for k = 1 to nP
		nScale = nScale * 10
	end
	fV = Float(xV)
	bNeg = fV < Float(0)
	if bNeg
		fV = Float(0) - fV
	end
	nI = Floor(fV * Float(nScale) + 0.5f)
	if nP = 0
		tR = String(nI)
	else
		nW = _Q((nI - nI % nScale), nScale)
		tF = String(nI % nScale)
		while Len(tF) < nP
			tF = "0" + tF
		end
		tR = String(nW) + "." + tF
	end
	if bNeg and nI != 0
		tR = "-" + tR
	end
	return tR
end

# A condition as true or false: a 1 or 0 from older code, or a boolean.
func _StzB(xV)
	if IsNumber(xV)
		return xV != 0
	end
	return xV
end

# The absolute value of any number: exact for an integer or a decimal, a float for a float.
func _StzAbs(xV)
	try
		if xV < 0
			return 0 - xV
		end
		return xV
	catch e
		fV = Float(xV)
		if fV < Float(0)
			return Float(0) - fV
		end
		return fV
	end
end

# A quotient as the older code took it: exact when one exists; otherwise, taken through floats, a decimal to
# nine places, or a float when either side is a float.
func _Q(xA, xB)
	try
		return xA / xB
	catch e
	end
	fQ = Float(String(xA)) / Float(String(xB))
	if _StzIsFloat(xA) or _StzIsFloat(xB)
		return fQ
	end
	try
		return Decimal(fQ, 9)
	catch e
		return fQ
	end
end

# A comparison as the older code made it, where every number was of one kind: the comparison itself when both
# sides are of one kind; otherwise both sides as floats, equal when neither is below the other, and a NaN equal
# to nothing.
func _C(xA, tOp, xB)
	try
		if tOp = "="
			return xA = xB
		end
		if tOp = "!="
			return xA != xB
		end
		if tOp = "<"
			return xA < xB
		end
		if tOp = ">"
			return xA > xB
		end
		if tOp = "<="
			return xA <= xB
		end
		return xA >= xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	bNaN = _StzNaN(fA) or _StzNaN(fB)
	if tOp = "="
		return not bNaN and not (fA < fB) and not (fA > fB)
	end
	if tOp = "!="
		return bNaN or fA < fB or fA > fB
	end
	if bNaN
		return false
	end
	if tOp = "<"
		return fA < fB
	end
	if tOp = ">"
		return fA > fB
	end
	if tOp = "<="
		return not (fA > fB)
	end
	return not (fA < fB)
end

# A number, or a true or false, as a float (the older code read a true as 1).
func _StzF(xV)
	if IsNumber(xV)
		if _StzIsFloat(xV)
			return xV
		end
		return Float(String(xV))
	end
	if xV
		return 1.0f
	end
	return 0.0f
end

# True for a NaN, read from its text.
func _StzNaN(xV)
	if not IsNumber(xV)
		return false
	end
	tS = String(xV)
	return tS = "nan" or tS = "-nan"
end

# True for a float: an integer or a decimal takes a zero added, a float refuses it.
func _StzIsFloat(xV)
	if not IsNumber(xV)
		return false
	end
	try
		xT = xV + 0
		return false
	catch e
		return true
	end
end

# Arithmetic as the older code did it, where every number was of one kind: the operation itself when both sides
# are of one kind; otherwise both sides as floats.
func _A(xA, tOp, xB)
	try
		if tOp = "+"
			return xA + xB
		end
		if tOp = "-"
			return xA - xB
		end
		return xA * xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	if tOp = "+"
		return fA + fB
	end
	if tOp = "-"
		return fA - fB
	end
	return fA * fB
end
