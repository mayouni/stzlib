# R1 SPIKE for the resident backbone (SOFTANZA_GPU_PLAN.md).
#
# Times the MATMUL SPINE of a MiniLM forward pass exactly as a resident
# backbone would run it: every operand already on the device, every
# dispatch submitted with NO readback and NO sync between links, ONE sync
# at the end. That is the FLOOR -- the real backbone adds LN, softmax,
# GELU, bias and pooling dispatches on top, so it can only be slower.
#
# The bar (R1, written before this ran): the spine must beat the CPU's
# FULL forward -- 36.6 ms measured by neural_gpu_routing_narrated on
# the same machine, same seq -- by >= 2x, or the backbone has no headroom
# for its remaining kernels and is a NO-GO.
#
# MiniLM-L6-v2 at seq 130: n_embd 384, 12 heads (head_dim 32), ffn 1536,
# 6 layers. Per layer: Q,K,V,attn_out [130x384]x[384x384]; ffn_up
# [130x384]x[384x1536]; ffn_down [130x1536]x[1536x384]; plus per-head
# KQ [130x32]x[32x130] and KQV [130x130]x[130x32].

load "../../stzBase.ring"

$nStzPlaces = 3

$nSeq = 130
$nEmb = 384
$nHeads = 12
$nHeadDim = 32
$nFfn = 1536
$nLayers = 6
nCpuFullMs = 36.6   # measured, same machine/seq (neural_gpu_routing guard)

StzEngineGpuInit($tStzGpuRuntime)
if _C(StzEngineGpuIsAvailable(), "=", 0)
    ? "no GPU -- the spike needs the device"
    return
end
? "device: " + _T(StzEngineGpuAdapterName(StzEngineGpuSelectedAdapter()))

# --- resident operands (a real backbone holds exactly these) ---
$nHX = StzEngineGpuBufferNew($nSeq * $nEmb * 4)        # activations
$nHW = StzEngineGpuBufferNew($nEmb * $nEmb * 4)        # a 384x384 weight
$nHWup = StzEngineGpuBufferNew($nEmb * $nFfn * 4)      # 384x1536
$nHWdn = StzEngineGpuBufferNew($nFfn * $nEmb * 4)      # 1536x384
$nHMid = StzEngineGpuBufferNew($nSeq * $nFfn * 4)      # ffn hidden
$nHOut = StzEngineGpuBufferNew($nSeq * $nEmb * 4)
$nHQ = StzEngineGpuBufferNew($nSeq * $nHeadDim * 4)    # one head slice
$nHK = StzEngineGpuBufferNew($nHeadDim * $nSeq * 4)
$nHS = StzEngineGpuBufferNew($nSeq * $nSeq * 4)        # scores
$nHV = StzEngineGpuBufferNew($nSeq * $nHeadDim * 4)
$nHHo = StzEngineGpuBufferNew($nSeq * $nHeadDim * 4)

vFill = []
for i = 1 to $nSeq * $nEmb
    vFill + 0.01
end
StzEngineGpuBufferUploadList($nHX, vFill)

SpineOnce()   # warm (pipeline compiles)

nBest = 999999999
for r = 1 to 5
    nT0 = StzEngineWatchTimestampNs()
    SpineOnce()
    nMs = (StzEngineWatchTimestampNs() - nT0) / 1000000
    if _C(nMs, "<", nBest)
        nBest = nMs
    end
end

nDisp = 6 * (4 + 2*$nHeads + 2)
? ""
? "dispatches per forward (matmul spine only): " + _T(nDisp)
? "resident spine, warm-min: " + _T(nBest) + " ms"
? "CPU FULL forward (measured, same seq): " + _T(nCpuFullMs) + " ms"
? "ratio vs CPU full forward: " + _T((_Q(nCpuFullMs, nBest))) + "x"
? ""
if _C(_Q(nCpuFullMs, nBest), ">=", 2)
    ? "R1 PASSES (>= 2x): the backbone has headroom for its other kernels."
else
    ? "R1 FAILS (< 2x): the spine ALONE cannot clear the bar; the backbone"
    ? "                 (which only adds dispatches) is a NO-GO at this scale."
end

# DIAGNOSTIC: split the spine -- 36 big projection/FFN matmuls vs the 144
# tiny per-head attention ones. If the tiny ones dominate, a batched
# attention kernel is the only thing that could move the verdict.
BigOnly()
nBig = 999999999
for r = 1 to 5
    nT0 = StzEngineWatchTimestampNs()
    BigOnly()
    nMs = (StzEngineWatchTimestampNs() - nT0) / 1000000
    if _C(nMs, "<", nBig)
        nBig = nMs
    end
end
? ""
? "  big projections + FFN only (36 dispatches): " + _T(nBig) + " ms"
? "  per-head attention share (144 dispatches):  " + _T((nBest - nBig)) + " ms"
? "  even at ZERO attention cost the ratio would be: " + _T((_Q(nCpuFullMs, nBig))) + "x"

StzEngineGpuShutdown()

func SpineOnce
    StzEngineGpuBatchBegin()
    for nLy = 1 to $nLayers
        # Q, K, V, attn_output projections
        for p = 1 to 4
            StzEngineGpuOpMatmul($nHX, $nHW, $nHOut, $nSeq, $nEmb, $nEmb)
        end
        # per-head attention: scores then context
        for h = 1 to $nHeads
            StzEngineGpuOpMatmul($nHQ, $nHK, $nHS, $nSeq, $nHeadDim, $nSeq)
            StzEngineGpuOpMatmul($nHS, $nHV, $nHHo, $nSeq, $nSeq, $nHeadDim)
        end
        # FFN
        StzEngineGpuOpMatmul($nHX, $nHWup, $nHMid, $nSeq, $nEmb, $nFfn)
        StzEngineGpuOpMatmul($nHMid, $nHWdn, $nHOut, $nSeq, $nFfn, $nEmb)
    end
    StzEngineGpuBatchEnd()  # ONE submit for the whole spine
    StzEngineGpuSync()      # the ONE sync a resident backbone pays
end
func BigOnly
    StzEngineGpuBatchBegin()
    for nLy = 1 to $nLayers
        for p = 1 to 4
            StzEngineGpuOpMatmul($nHX, $nHW, $nHOut, $nSeq, $nEmb, $nEmb)
        end
        StzEngineGpuOpMatmul($nHX, $nHWup, $nHMid, $nSeq, $nEmb, $nFfn)
        StzEngineGpuOpMatmul($nHMid, $nHWdn, $nHOut, $nSeq, $nFfn, $nEmb)
    end
    StzEngineGpuBatchEnd()
    StzEngineGpuSync()
end

# A value as text, as the guard's narration writes it: a text as it is, a whole number plainly, any other number
# to $nStzPlaces places, rounded half away from zero. (The library's one-argument Text and Round shadow the built-ins.)
func _T(xV)
	if IsString(xV)
		return xV
	end
	if not IsNumber(xV)
		return String(xV)
	end
	tS = String(xV)
	nLen = Len(tS)
	bPlain = true
	for k = 1 to nLen
		tC = tS[k]
		if tC = "n" or tC = "i"
			return tS
		end
		if tC = "." or tC = "e" or tC = "E"
			bPlain = false
		end
	end
	if bPlain
		return tS
	end
	nP = $nStzPlaces
	nScale = 1
	for k = 1 to nP
		nScale = nScale * 10
	end
	fV = Float(xV)
	bNeg = fV < Float(0)
	if bNeg
		fV = Float(0) - fV
	end
	nI = Floor(fV * Float(nScale) + 0.5f)
	if nP = 0
		tR = String(nI)
	else
		nW = _Q((nI - nI % nScale), nScale)
		tF = String(nI % nScale)
		while Len(tF) < nP
			tF = "0" + tF
		end
		tR = String(nW) + "." + tF
	end
	if bNeg and nI != 0
		tR = "-" + tR
	end
	return tR
end

# A condition as true or false: a 1 or 0 from older code, or a boolean.
func _StzB(xV)
	if IsNumber(xV)
		return xV != 0
	end
	return xV
end

# The absolute value of any number: exact for an integer or a decimal, a float for a float.
func _StzAbs(xV)
	try
		if xV < 0
			return 0 - xV
		end
		return xV
	catch e
		fV = Float(xV)
		if fV < Float(0)
			return Float(0) - fV
		end
		return fV
	end
end

# A quotient as the older code took it: exact when one exists; otherwise, taken through floats, a decimal to
# nine places, or a float when either side is a float.
func _Q(xA, xB)
	try
		return xA / xB
	catch e
	end
	fQ = Float(String(xA)) / Float(String(xB))
	if _StzIsFloat(xA) or _StzIsFloat(xB)
		return fQ
	end
	try
		return Decimal(fQ, 9)
	catch e
		return fQ
	end
end

# A comparison as the older code made it, where every number was of one kind: the comparison itself when both
# sides are of one kind; otherwise both sides as floats, equal when neither is below the other, and a NaN equal
# to nothing.
func _C(xA, tOp, xB)
	try
		if tOp = "="
			return xA = xB
		end
		if tOp = "!="
			return xA != xB
		end
		if tOp = "<"
			return xA < xB
		end
		if tOp = ">"
			return xA > xB
		end
		if tOp = "<="
			return xA <= xB
		end
		return xA >= xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	bNaN = _StzNaN(fA) or _StzNaN(fB)
	if tOp = "="
		return not bNaN and not (fA < fB) and not (fA > fB)
	end
	if tOp = "!="
		return bNaN or fA < fB or fA > fB
	end
	if bNaN
		return false
	end
	if tOp = "<"
		return fA < fB
	end
	if tOp = ">"
		return fA > fB
	end
	if tOp = "<="
		return not (fA > fB)
	end
	return not (fA < fB)
end

# A number, or a true or false, as a float (the older code read a true as 1).
func _StzF(xV)
	if IsNumber(xV)
		if _StzIsFloat(xV)
			return xV
		end
		return Float(String(xV))
	end
	if xV
		return 1.0f
	end
	return 0.0f
end

# True for a NaN, read from its text.
func _StzNaN(xV)
	if not IsNumber(xV)
		return false
	end
	tS = String(xV)
	return tS = "nan" or tS = "-nan"
end

# True for a float: an integer or a decimal takes a zero added, a float refuses it.
func _StzIsFloat(xV)
	if not IsNumber(xV)
		return false
	end
	try
		xT = xV + 0
		return false
	catch e
		return true
	end
end

# Arithmetic as the older code did it, where every number was of one kind: the operation itself when both sides
# are of one kind; otherwise both sides as floats.
func _A(xA, tOp, xB)
	try
		if tOp = "+"
			return xA + xB
		end
		if tOp = "-"
			return xA - xB
		end
		return xA * xB
	catch e
	end
	fA = _StzF(xA)
	fB = _StzF(xB)
	if tOp = "+"
		return fA + fB
	end
	if tOp = "-"
		return fA - fB
	end
	return fA * fB
end
