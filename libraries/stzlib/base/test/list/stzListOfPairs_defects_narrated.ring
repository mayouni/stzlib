load "../../stzBase.ring"
load "../_narrated.ring"

# Guard for the stzListOfPairs defects fixed on fix/gscl (DEFECTS.md, stzListOfPairs):
# the SortBy family never sorted (stzList.SortBy does not evaluate an expression on a
# list item); the descending forms swapped the items INSIDE each pair (Reverse is
# SwapItems in this class); SortedInDescending answered ascending; ReplacePair raised
# R20 (IsPair reached the inherited method); UpdatePairWith refused n above 2.
#
# And, from fix/lp2: ExpandedIfPairsOfNumbers raised R14 (it called a method that exists nowhere);
# IsListOfSections answered TRUE for text pairs (the failing pair was recorded in a variable never
# read); AreAnagrams raised R14 (it read FirstValue and SecondValue, which this class lacks, and
# the class holds many pairs); ToStzSetOfSections raised the constructor's message, a constructor
# that refuses every list (@IsSetOfSections has an empty body in another file), so the method
# now names the cause. Accented and Hebrew texts are built from char codes and never printed.

aPairs = [ [ "b", 3 ], [ "aaa", 1 ], [ "cc", 2 ] ]

Scenario("SortBy orders the pairs by an evaluated key")
	o = new stzListOfPairs(aPairs)
	o.SortBy('@pair[2]')
	Then("by the second item, ascending", @@(o.Content()), '[ [ "aaa", 1 ], [ "cc", 2 ], [ "b", 3 ] ]')
	o = new stzListOfPairs(aPairs)
	o.SortByInAscending('len(@pair[1])')
	Then("by the length of the first item", @@(o.Content()), '[ [ "b", 3 ], [ "cc", 2 ], [ "aaa", 1 ] ]')
	o = new stzListOfPairs(aPairs)
	o.SortByUp('-@pair[2]')
	Then("a negated key gives the reverse order", @@(o.Content()), '[ [ "b", 3 ], [ "cc", 2 ], [ "aaa", 1 ] ]')
	o = new stzListOfPairs(aPairs)
	Then("SortedBy answers a sorted copy", @@(o.SortedBy('@pair[1]')), '[ [ "aaa", 1 ], [ "b", 3 ], [ "cc", 2 ] ]')
	Then("and leaves the list as it was", @@(o.Content()), @@(aPairs))
EndScenario()

Scenario("Equal keys keep their order")
	o = new stzListOfPairs([ [ "x", 2 ], [ "y", 1 ], [ "z", 2 ], [ "w", 1 ] ])
	Then("ascending: y w before x z, each in input order",
		@@(o.SortedBy('@pair[2]')), '[ [ "y", 1 ], [ "w", 1 ], [ "x", 2 ], [ "z", 2 ] ]')
	Then("descending: x z before y w, each in input order",
		@@(o.SortedByInDescending('@pair[2]')), '[ [ "x", 2 ], [ "z", 2 ], [ "y", 1 ], [ "w", 1 ] ]')
EndScenario()

Scenario("The descending forms order the pairs and keep each pair as it is")
	o = new stzListOfPairs(aPairs)
	o.SortByInDescending('@pair[2]')
	Then("SortByInDescending, by the second item", @@(o.Content()), '[ [ "b", 3 ], [ "cc", 2 ], [ "aaa", 1 ] ]')
	o = new stzListOfPairs(aPairs)
	o.SortByDown('len(@pair[1])')
	Then("SortByDown, by length", @@(o.Content()), '[ [ "aaa", 1 ], [ "cc", 2 ], [ "b", 3 ] ]')
	o = new stzListOfPairs(aPairs)
	Then("SortedByDown answers a copy", @@(o.SortedByDown('@pair[1]')), '[ [ "cc", 2 ], [ "b", 3 ], [ "aaa", 1 ] ]')
	Then("no pair is turned round", o.Content()[1][1], "b")
	Then("SortedInDescending is descending", @@(o.SortedInDescending()), '[ [ "cc", 2 ], [ "b", 3 ], [ "aaa", 1 ] ]')
EndScenario()

Scenario("A bad key expression is refused")
	o = new stzListOfPairs(aPairs)
	Then("an expression without @pair raises", Raises(o, "o.SortBy('len(x)')") != "", 1)
	o = new stzListOfPairs([ [ "a", 1 ], [ "b", "z" ] ])
	Then("keys mixing numbers and texts raise", Raises(o, "o.SortBy('@pair[2]')") != "", 1)
EndScenario()

Scenario("ReplacePair and UpdatePairWith reach every position")
	o = new stzListOfPairs(aPairs)
	o.ReplacePair(2, [ "x", 9 ])
	Then("ReplacePair(2) replaces the second pair", @@(o.Content()), '[ [ "b", 3 ], [ "x", 9 ], [ "cc", 2 ] ]')
	o.UpdatePairWith(3, [ "y", 8 ])
	Then("UpdatePairWith(3) replaces the third pair", @@(o.Content()), '[ [ "b", 3 ], [ "x", 9 ], [ "y", 8 ] ]')
	o = new stzListOfPairs(aPairs)
	Then("PairReplaced answers a copy", @@(o.PairReplaced(3, [ "q", 0 ])), '[ [ "b", 3 ], [ "aaa", 1 ], [ "q", 0 ] ]')
	Then("and leaves the list as it was", @@(o.Content()), @@(aPairs))
	Then("a position past the end raises", Raises(o, "o.ReplacePair(4, [ 1, 2 ])") != "", 1)
	Then("a new pair of three items raises", Raises(o, "o.ReplacePair(1, [ 1, 2, 3 ])") != "", 1)
EndScenario()

Scenario("ExpandedIfPairsOfNumbers expands each pair of whole numbers, up or down")
	o = new stzListOfPairs([ [ 1, 3 ], [ 5, 7 ] ])
	Then("two ascending pairs", @@(o.ExpandedIfPairsOfNumbers()), '[ [ 1, 2, 3 ], [ 5, 6, 7 ] ]')
	o = new stzListOfPairs([ [ 3, 1 ] ])
	Then("a descending pair counts down", @@(o.ExpandedIfPairsOfNumbers()), '[ [ 3, 2, 1 ] ]')
	Then("and is not the ascending answer", @@(o.ExpandedIfPairsOfNumbers()) != '[ [ 1, 2, 3 ] ]', 1)
	o = new stzListOfPairs([ [ 2, 2 ] ])
	Then("an equal pair gives the one number", @@(o.ExpandedIfPairsOfNumbers()), '[ [ 2 ] ]')
	o = new stzListOfPairs([ [ -2, 1 ], [ -1, -3 ] ])
	Then("negative numbers work, up and down", @@(o.ExpandedIfPairsOfNumbers()), '[ [ -2, -1, 0, 1 ], [ -1, -2, -3 ] ]')
	o = new stzListOfPairs([ [ 1, 3 ], [ 3, 1 ] ])
	Then("the lists come in the order of the pairs", @@(o.ExpandedIfPairsOfNumbers()), '[ [ 1, 2, 3 ], [ 3, 2, 1 ] ]')
	Then("the list of pairs is left as it was", @@(o.Content()), '[ [ 1, 3 ], [ 3, 1 ] ]')
EndScenario()

Scenario("A pair that is not two whole numbers is left out, and the others stay")
	o = new stzListOfPairs([ [ "a", "b" ], [ 1, 2 ], [ 1, "b" ], [ "a", 4 ] ])
	Then("texts and mixed pairs are left out", @@(o.ExpandedIfPairsOfNumbers()), '[ [ 1, 2 ] ]')
	o = new stzListOfPairs([ [ 1.5, 4 ], [ 2, 3.25 ], [ 6, 7 ] ])
	Then("a decimal pair is left out", @@(o.ExpandedIfPairsOfNumbers()), '[ [ 6, 7 ] ]')
	o = new stzListOfPairs([ [ "a", "b" ] ])
	Then("nothing expandable gives an empty list", @@(o.ExpandedIfPairsOfNumbers()), '[ ]')
	o = new stzListOfPairs([])
	Then("no pair gives an empty list", @@(o.ExpandedIfPairsOfNumbers()), '[ ]')
	o = new stzListOfPairs([ [ 1, 3 ], [ 5, 8 ] ])
	Then("the fluent form answers a stzList of the same lists", @@(o.ExpandedIfPairsOfNumbersQ().Content()), '[ [ 1, 2, 3 ], [ 5, 6, 7, 8 ] ]')
	Then("and so does the stzListOfLists form", @@(o.ExpandedIfPairsOfNumbersQRT(:stzListOfLists).Content()), '[ [ 1, 2, 3 ], [ 5, 6, 7, 8 ] ]')
EndScenario()

Scenario("IsListOfSections is TRUE only when every pair is made of two numbers")
	o = new stzListOfPairs([ [ 1, 3 ], [ 5, 8 ] ])
	Then("two number pairs", o.IsListOfSections(), 1)
	o = new stzListOfPairs([ [ "a", "b" ] ])
	Then("a text pair", o.IsListOfSections(), 0)
	o = new stzListOfPairs([ [ 1, "b" ] ])
	Then("a mixed pair", o.IsListOfSections(), 0)
	o = new stzListOfPairs([ [ 1, 3 ], [ "a", "b" ] ])
	Then("a bad pair last", o.IsListOfSections(), 0)
	o = new stzListOfPairs([ [ "a", "b" ], [ 1, 3 ] ])
	Then("a bad pair first", o.IsListOfSections(), 0)
	o = new stzListOfPairs([ [ 1, 3 ], [ 4, "x" ], [ 5, 8 ] ])
	Then("a bad pair in the middle", o.IsListOfSections(), 0)
	o = new stzListOfPairs([ [ 8, 5 ], [ 1.5, 2.5 ], [ -3, 0 ] ])
	Then("decimals, negatives and a start above the end are numbers all the same", o.IsListOfSections(), 1)
	o = new stzListOfPairs([])
	Then("an empty list has no failing pair", o.IsListOfSections(), 1)
	o = new stzListOfPairs([ [ "1", "3" ] ])
	Then("numbers written as texts are texts", o.IsListOfSections(), 0)
EndScenario()

Scenario("The sorted checks no longer accept text pairs")
	o = new stzListOfPairs([ [ 1, 3 ], [ 5, 8 ] ])
	Then("ascending sections", o.IsListOfSectionsSortedInAscending(), 1)
	Then("they are not descending", o.IsListOfSectionsSortedInDescending(), 0)
	Then("and are sorted", o.IsSortedListOfSections(), 1)
	o = new stzListOfPairs([ [ 5, 8 ], [ 1, 3 ] ])
	Then("descending sections", o.IsListOfSectionsSortedInDescending(), 1)
	o = new stzListOfPairs([ [ 1, 5 ], [ 3, 4 ] ])
	Then("overlapping sections are not sorted", o.IsSortedListOfSections(), 0)
	o = new stzListOfPairs([ [ "a", "b" ], [ "c", "d" ] ])
	Then("text pairs are not ascending sections", o.IsListOfSectionsSortedInAscending(), 0)
	Then("nor descending", o.IsListOfSectionsSortedInDescending(), 0)
	Then("nor sorted", o.IsSortedListOfSections(), 0)
EndScenario()

cAeAcute = char(195) + char(169)                                   # e acute, small
cAeBig   = char(195) + char(137)                                   # E acute, capital
cAeHeb1  = char(215) + char(144) + char(215) + char(145) + char(215) + char(146)   # alef bet gimel
cAeHeb2  = char(215) + char(146) + char(215) + char(144) + char(215) + char(145)   # gimel alef bet

Scenario("AreAnagrams: both items of a pair are the same letters in another order")
	o = new stzListOfPairs([ [ "listen", "silent" ] ])
	Then("listen and silent", o.AreAnagrams(), 1)
	o = new stzListOfPairs([ [ "abc", "abd" ] ])
	Then("abc and abd are not", o.AreAnagrams(), 0)
	o = new stzListOfPairs([ [ "aab", "abb" ] ])
	Then("the same letters, not the same counts, are not", o.AreAnagrams(), 0)
	o = new stzListOfPairs([ [ "ab", "abc" ] ])
	Then("different lengths are not", o.AreAnagrams(), 0)
	o = new stzListOfPairs([ [ "abc", "abc" ] ])
	Then("a text is an anagram of itself, as IsAnagramOf of stzString says", o.AreAnagrams(), 1)
	o = new stzListOfPairs([ [ "", "" ] ])
	Then("two empty texts are anagrams", o.AreAnagrams(), 1)
	o = new stzListOfPairs([ [ "a b", "ba " ] ])
	Then("spaces count as characters and can move", o.AreAnagrams(), 1)
	o = new stzListOfPairs([ [ "a b", "ab" ] ])
	Then("a missing space is a difference", o.AreAnagrams(), 0)
EndScenario()

Scenario("AreAnagrams: case, accents and Hebrew")
	o = new stzListOfPairs([ [ "Listen", "Silent" ] ])
	Then("case counted by default: Listen and Silent are not", o.AreAnagrams(), 0)
	Then("AreAnagramsCS(1) agrees", o.AreAnagramsCS(1), 0)
	Then("AreAnagramsCS(0) ignores the case", o.AreAnagramsCS(0), 1)
	o = new stzListOfPairs([ [ "caf" + cAeAcute, cAeAcute + "fac" ] ])
	Then("words with an accented letter", o.AreAnagrams(), 1)
	o = new stzListOfPairs([ [ "caf" + cAeAcute, "cafe" ] ])
	Then("the accented letter is not its plain letter", o.AreAnagrams(), 0)
	o = new stzListOfPairs([ [ "caf" + cAeAcute, "caf" + cAeBig ] ])
	Then("e acute and E acute differ when the case counts", o.AreAnagrams(), 0)
	Then("and are the same letter when it does not", o.AreAnagramsCS(0), 1)
	o = new stzListOfPairs([ [ cAeHeb1, cAeHeb2 ] ])
	Then("Hebrew words of the same letters", o.AreAnagrams(), 1)
	o = new stzListOfPairs([ [ cAeHeb1, "abc" ] ])
	Then("a Hebrew word and a Latin word are not", o.AreAnagrams(), 0)
EndScenario()

Scenario("AreAnagrams: several pairs, and items that are not texts")
	o = new stzListOfPairs([ [ "listen", "silent" ], [ "abc", "cab" ] ])
	Then("every pair is a pair of anagrams", o.AreAnagrams(), 1)
	o = new stzListOfPairs([ [ "listen", "silent" ], [ "abc", "abd" ] ])
	Then("one bad pair last", o.AreAnagrams(), 0)
	o = new stzListOfPairs([ [ "abc", "abd" ], [ "listen", "silent" ] ])
	Then("one bad pair first", o.AreAnagrams(), 0)
	o = new stzListOfPairs([ [ 12, 21 ] ])
	Then("two numbers are not texts", o.AreAnagrams(), 0)
	o = new stzListOfPairs([ [ "a", 1 ] ])
	Then("a text and a number are not", o.AreAnagrams(), 0)
	o = new stzListOfPairs([ [ "a", [ "a" ] ] ])
	Then("a text and a list are not", o.AreAnagrams(), 0)
	o = new stzListOfPairs([])
	Then("an empty list of pairs has no failing pair", o.AreAnagrams(), 1)
EndScenario()

Scenario("ToStzSetOfSections names its cause instead of the constructor's message")
	oSos = new stzListOfPairs([ [ 1, 3 ], [ 5, 8 ] ])
	cMsg = Raises(oSos, "o.ToStzSetOfSections()")
	Then("valid sections are accepted now that the constructor builds a set", cMsg, "")
	oSet = oSos.ToStzSetOfSections()
	Then("and the answer holds the pairs in order", @@(oSet.Content()), '[ [ 1, 3 ], [ 5, 8 ] ]')
	oSos = new stzListOfPairs([ [ "a", "b" ] ])
	cMsg = Raises(oSos, "o.ToStzSetOfSections()")
	nHit = len(StzFind("two numbers", cMsg))
	Then("a text pair raises a message about the numbers", nHit > 0, 1)
	nHit = len(StzFind("@IsSetOfSections", cMsg))
	Then("and does not blame the constructor", nHit, 0)
	oSos = new stzListOfPairs([ [ 1, 3 ], [ 1, 3 ] ])
	cMsg = Raises(oSos, "o.ToStzSetOfSections()")
	nHit = len(StzFind("repeated pair", cMsg))
	Then("a repeated pair raises a message about the repetition", nHit > 0, 1)
	nHit = len(StzFind("two numbers", cMsg))
	Then("and not the one about the numbers", nHit, 0)
	o = new stzListOfPairs([ [ 1, 3 ], [ 5, 8 ] ])
	oLs = o.ToStzListOfSections()
	Then("ToStzListOfSections accepts the same pairs", @@(oLs.Content()), '[ [ 1, 3 ], [ 5, 8 ] ]')
	Then("and the list of pairs is left as it was", @@(o.Content()), '[ [ 1, 3 ], [ 5, 8 ] ]')
EndScenario()

Summary()

func Raises(o, cCode)
	try
		eval(cCode)
		return ""
	catch
		return cCatchError
	done
