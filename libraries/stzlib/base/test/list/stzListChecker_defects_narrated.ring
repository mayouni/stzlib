load "../../stzBase.ring"
load "../_narrated.ring"

# stzListChecker -- the four rows of the register (DEFECTS.md) and the matching rules under them.
#
# Before: ContainsItem answered 0 for every item, because the engine call it made takes a value
# handle that the list module cannot read; ContainsAllOfThese then answered 1 only for the empty
# list of items and ContainsOneOfThese answered 0 always; ContainsW raised R3 (it called
# StzCCodeToRingCode, which no file defines). Run from inside test/list.
#
# What matches what is stated in the doc block of ContainsItemCS and pinned here: a number only a
# number, a text only a text (the case flag decides A and a), a list only an equal list, item by
# item. Every positive has a negative sibling. Accented, Hebrew and emoji texts are built from
# char codes and never printed.

cLcEsm  = char(195) + char(169)                                  # e acute, small
cLcEbig = char(195) + char(137)                                  # E acute, capital
cLcHeb  = char(215) + char(144) + char(215) + char(145)          # alef bet
cLcEmo  = char(240) + char(159) + char(152) + char(128)          # grinning face
cLcSsm  = char(207) + char(131)                                  # sigma, small
cLcSbig = char(206) + char(163)                                  # sigma, capital
nLcHuge = 1000000000000 * 1000000000000 * 1000000                # beyond the 64-bit range

Scenario("Numbers: integers, decimals, negatives, zero")
	o = new stzListChecker([ 1, 2, 3 ])
	Then("2 is found in 1 2 3", o.ContainsItem(2), 1)
	Then("9 is not found in 1 2 3", o.ContainsItem(9), 0)
	o = new stzListChecker([ 1, 2.5, -3, 0, -0.75 ])
	Then("a decimal is found", o.ContainsItem(2.5), 1)
	Then("a close decimal is not found", o.ContainsItem(2.4), 0)
	Then("a negative integer is found in a list that also holds decimals", o.ContainsItem(-3), 1)
	Then("its opposite is not found", o.ContainsItem(3), 0)
	Then("zero is found in a list that also holds decimals", o.ContainsItem(0), 1)
	Then("a negative decimal is found", o.ContainsItem(-0.75), 1)
	Then("its opposite is not found", o.ContainsItem(0.75), 0)
	Then("1.0 is the number 1", o.ContainsItem(1.0), 1)
	Then("2.0 is not in the list, though 2.5 is", o.ContainsItem(2.0), 0)
	o = new stzListChecker([ 5, 6 ])
	Then("a number beyond the 64-bit range is not found, and does not abort", o.ContainsItem(nLcHuge), 0)
	o = new stzListChecker([ nLcHuge, 5 ])
	Then("the same number is found when the list holds it", o.ContainsItem(nLcHuge), 1)
	Then("and 5 next to it is found", o.ContainsItem(5), 1)
EndScenario()

Scenario("A number is not its text, a text is not its number")
	o = new stzListChecker([ 1, 2, 3 ])
	Then("the text 2 is not found among numbers", o.ContainsItem("2"), 0)
	o = new stzListChecker([ "2", "x" ])
	Then("the number 2 is not found among texts", o.ContainsItem(2), 0)
	Then("the text 2 is found among texts", o.ContainsItem("2"), 1)
EndScenario()

Scenario("Texts: ASCII, with and without the case flag")
	o = new stzListChecker([ "a", "b" ])
	Then("a is found", o.ContainsItem("a"), 1)
	Then("z is not found", o.ContainsItem("z"), 0)
	Then("A is not found, the flag defaults to case-sensitive", o.ContainsItem("A"), 0)
	Then("A is found when the case is ignored", o.ContainsItemCS("A", 0), 1)
	Then("A is not found when the case counts", o.ContainsItemCS("A", 1), 0)
	Then("Z is not found when the case is ignored", o.ContainsItemCS("Z", 0), 0)
	Then("the pair [ :CaseSensitive, 0 ] ignores the case", o.ContainsItemCS("A", [ :CaseSensitive, 0 ]), 1)
	Then("the pair [ :CaseSensitive, 1 ] keeps it", o.ContainsItemCS("A", [ :CaseSensitive, 1 ]), 0)
	o = new stzListChecker([ "", "a" ])
	Then("the empty text is found when the list holds it", o.ContainsItem(""), 1)
	o = new stzListChecker([ "a" ])
	Then("the empty text is not found when it does not", o.ContainsItem(""), 0)
EndScenario()

Scenario("Texts beyond ASCII: accented, Hebrew, emoji, sigma")
	o = new stzListChecker([ "a", cLcEsm, cLcHeb, cLcEmo, cLcSsm ])
	Then("e acute is found", o.ContainsItem(cLcEsm), 1)
	Then("a capital E acute is not found while the case counts", o.ContainsItem(cLcEbig), 0)
	Then("a capital E acute is found when the case is ignored", o.ContainsItemCS(cLcEbig, 0), 1)
	Then("a plain e is not e acute, with either flag", o.ContainsItemCS("e", 0), 0)
	Then("the Hebrew text is found", o.ContainsItem(cLcHeb), 1)
	Then("the Hebrew text with a letter more is not found", o.ContainsItem(cLcHeb + "a"), 0)
	Then("the Hebrew text is found with the flag at 0", o.ContainsItemCS(cLcHeb, 0), 1)
	Then("the emoji is found", o.ContainsItem(cLcEmo), 1)
	Then("the first three bytes of the emoji are not found", o.ContainsItem(left(cLcEmo, 3)), 0)
	Then("the emoji is found with the flag at 0", o.ContainsItemCS(cLcEmo, 0), 1)
	Then("a capital sigma is not found while the case counts", o.ContainsItem(cLcSbig), 0)
	Then("a capital sigma is found when the case is ignored", o.ContainsItemCS(cLcSbig, 0), 1)
EndScenario()

Scenario("Lists as items: matched whole, item by item")
	o = new stzListChecker([ [ 1, 2 ], [ 3 ] ])
	Then("[3] is found", o.ContainsItem([ 3 ]), 1)
	Then("[1, 2] is found", o.ContainsItem([ 1, 2 ]), 1)
	Then("[2] is not found, a part is not the item", o.ContainsItem([ 2 ]), 0)
	Then("[3, 4] is not found", o.ContainsItem([ 3, 4 ]), 0)
	Then("[2, 1] is not found, the order counts", o.ContainsItem([ 2, 1 ]), 0)
	Then("the number 3 is not the list [3]", o.ContainsItem(3), 0)
	o = new stzListChecker([ [ 1 ], [] ])
	Then("the empty list is found when the list holds one", o.ContainsItem([]), 1)
	o = new stzListChecker([ [ 1 ] ])
	Then("the empty list is not found when it does not", o.ContainsItem([]), 0)
	o = new stzListChecker([ 1, "b", [ 3 ] ])
	Then("a list, a text and a number can sit together: the list", o.ContainsItem([ 3 ]), 1)
	Then("the text B is not b", o.ContainsItem("B"), 0)
	o = new stzListChecker([ [ 4, "X" ], [ cLcEbig ] ])
	Then("a text inside a list follows the flag: x is not X", o.ContainsItem([ 4, "x" ]), 0)
	Then("x is X when the case is ignored", o.ContainsItemCS([ 4, "x" ], 0), 1)
	Then("X is found as it is", o.ContainsItem([ 4, "X" ]), 1)
	Then("a capital E acute inside a list is found as it is", o.ContainsItem([ cLcEbig ]), 1)
	Then("a small e acute inside a list is not found", o.ContainsItem([ cLcEsm ]), 0)
	Then("a small e acute inside a list is found when the case is ignored", o.ContainsItemCS([ cLcEsm ], 0), 1)
	o = new stzListChecker([ [ 1, [ 2, "q" ] ] ])
	Then("a list inside a list inside a list is compared too", o.ContainsItem([ 1, [ 2, "q" ] ]), 1)
	Then("and a difference deep down is seen", o.ContainsItem([ 1, [ 2, "r" ] ]), 0)
	Then("the case flag reaches down there as well", o.ContainsItemCS([ 1, [ 2, "Q" ] ], 0), 1)
	o = new stzListChecker([ 1, 2.5, 3, [ 1, 2.5 ] ])
	Then("a list of numbers holding a decimal is found", o.ContainsItem([ 1, 2.5 ]), 1)
	Then("the whole number 3 is found beside a decimal", o.ContainsItem(3), 1)
EndScenario()

Scenario("The empty list holds nothing")
	o = new stzListChecker([])
	Then("no number", o.ContainsItem(1), 0)
	Then("no text", o.ContainsItem("a"), 0)
	Then("no empty text", o.ContainsItem(""), 0)
	Then("no empty list", o.ContainsItem([]), 0)
	Then("nothing with the flag at 0 either", o.ContainsItemCS("a", 0), 0)
EndScenario()

Scenario("ContainsAllOfThese: every item must be there")
	o = new stzListChecker([ 1, 2, 3 ])
	Then("[1, 2] are all there", o.ContainsAllOfThese([ 1, 2 ]), 1)
	Then("[1, 9] are not all there", o.ContainsAllOfThese([ 1, 9 ]), 0)
	Then("[9, 1] are not all there, whichever comes first", o.ContainsAllOfThese([ 9, 1 ]), 0)
	Then("the empty list of items is all there, nothing is missing", o.ContainsAllOfThese([]), 1)
	Then("something that is not a list answers 0", o.ContainsAllOfThese(2), 0)
	o = new stzListChecker([ "a", "b", cLcHeb ])
	Then("texts, with the Hebrew one: all there", o.ContainsAllOfThese([ "a", cLcHeb ]), 1)
	Then("texts: one missing", o.ContainsAllOfThese([ "a", "z" ]), 0)
	Then("A is not there while the case counts", o.ContainsAllOfThese([ "A", "B" ]), 0)
	Then("A and B are there when the case is ignored", o.ContainsAllOfTheseCS([ "A", "B" ], 0), 1)
	Then("A and Z are not, even when the case is ignored", o.ContainsAllOfTheseCS([ "A", "Z" ], 0), 0)
	o = new stzListChecker([ [ 1, 2 ], [ 3 ], 4 ])
	Then("lists and a number: all there", o.ContainsAllOfThese([ [ 3 ], 4 ]), 1)
	Then("lists and a number: [2] is not an item", o.ContainsAllOfThese([ [ 2 ], 4 ]), 0)
EndScenario()

Scenario("ContainsOneOfThese: one is enough")
	o = new stzListChecker([ 1, 2, 3 ])
	Then("[9, 2] holds one that is there", o.ContainsOneOfThese([ 9, 2 ]), 1)
	Then("[9, 8] holds none", o.ContainsOneOfThese([ 9, 8 ]), 0)
	Then("the empty list of items finds nothing", o.ContainsOneOfThese([]), 0)
	Then("something that is not a list answers 0", o.ContainsOneOfThese(2), 0)
	o = new stzListChecker([ "a", "b" ])
	Then("texts: z, b has one", o.ContainsOneOfThese([ "z", "b" ]), 1)
	Then("texts: z, y has none", o.ContainsOneOfThese([ "z", "y" ]), 0)
	Then("B is not there while the case counts", o.ContainsOneOfThese([ "Z", "B" ]), 0)
	Then("B is there when the case is ignored", o.ContainsOneOfTheseCS([ "Z", "B" ], 0), 1)
	Then("Z and Y are not, with the case ignored", o.ContainsOneOfTheseCS([ "Z", "Y" ], 0), 0)
	o = new stzListChecker([ [ 1, 2 ], [ 3 ] ])
	Then("lists: [9] then [3] has one", o.ContainsOneOfThese([ [ 9 ], [ 3 ] ]), 1)
	Then("lists: [9] then [2] has none", o.ContainsOneOfThese([ [ 9 ], [ 2 ] ]), 0)
EndScenario()

Scenario("ContainsW: some item meets the condition")
	o = new stzListChecker([ 1, 2, 3 ])
	Then("an item above 2 exists", o.ContainsW("@item > 2"), 1)
	Then("an item above 5 does not exist", o.ContainsW("@item > 5"), 0)
	Then("an item equal to 2 exists", o.ContainsW("@item = 2"), 1)
	Then("ContainsWhere is the same question", o.ContainsWhere("@item > 2"), 1)
	Then("ContainsItemW is the same question", o.ContainsItemW("@item > 5"), 0)
	o = new stzListChecker([ "abc", "zz" ])
	Then("a text equal to zz exists", o.ContainsW('@item = "zz"'), 1)
	Then("a text equal to q does not exist", o.ContainsW('@item = "q"'), 0)
	o = new stzListChecker([ 4, -1, 7 ])
	Then("a negative item exists", o.ContainsW("@item < 0"), 1)
	o = new stzListChecker([ 4, 1, 7 ])
	Then("no negative item here", o.ContainsW("@item < 0"), 0)
	o = new stzListChecker([])
	Then("the empty list meets nothing", o.ContainsW("@item > 1"), 0)
	o = new stzListChecker([ 5, 6, 7 ])
	Then("the answer is a number, 1 or 0, usable in a test", isNumber(o.ContainsW("@item > 5")), 1)
EndScenario()

Scenario("The list is left as it was, and a checker over a stzList object works too")
	aLcBefore = [ 3, "a", [ 1, 2 ] ]
	o = new stzListChecker(aLcBefore)
	cLcTmp = "" + o.ContainsItem("a") + o.ContainsItem([ 1, 2 ]) + o.ContainsAllOfThese([ 3, "a" ]) + o.ContainsOneOfThese([ 9, 3 ]) + o.ContainsW("@item = 3")
	Then("the five questions answer 1 each", cLcTmp, "11111")
	Then("the content is untouched", LcSame(o.Content(), aLcBefore), 1)
	oLcList = new stzList([ "x", "y" ])
	o = new stzListChecker(oLcList)
	Then("over a stzList: x is found", o.ContainsItem("x"), 1)
	Then("over a stzList: X is not found", o.ContainsItem("X"), 0)
	Then("over a stzList: X is found when the case is ignored", o.ContainsItemCS("X", 0), 1)
EndScenario()

Scenario("The ContainsOnly family beside them, on the same data")
	oLcNum = new stzListChecker([ 1, 2.5, -3 ])
	oLcStr = new stzListChecker([ "a", "b" ])
	oLcLst = new stzListChecker([ [ 1 ], [ 2 ] ])
	oLcMix = new stzListChecker([ 1, "a" ])
	Then("numbers only: yes for numbers", oLcNum.ContainsOnly(:Number), 1)
	Then("numbers only: no for texts", oLcStr.ContainsOnly(:Number), 0)
	Then("numbers only: no for a mix", oLcMix.ContainsOnly(:Number), 0)
	Then("texts only: yes for texts", oLcStr.ContainsOnlyStringsCS(0), 1)
	Then("texts only: no for numbers", oLcNum.ContainsOnlyStringsCS(1), 0)
	Then("lists only: yes for lists", oLcLst.ContainsOnlyLists(), 1)
	Then("lists only: no for numbers", oLcNum.ContainsOnlyLists(), 0)
	oLcPair = new stzListChecker([ 4, 5 ])
	Then("a pair of numbers: yes", oLcPair.ContainsOnlyPairOfNumbers(), 1)
	Then("a pair of numbers: no for three", oLcNum.ContainsOnlyPairOfNumbers(), 0)
	Then("the :Where form of the condition is accepted", oLcNum.ContainsW([ :Where, "@item < 0" ]), 1)
	Then("and a failing one answers 0", oLcNum.ContainsW([ :Where, "@item > 9" ]), 0)
EndScenario()

Summary()

func LcSame(a, b)
	return @@(a) = @@(b)
