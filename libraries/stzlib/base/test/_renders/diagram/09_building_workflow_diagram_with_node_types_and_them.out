digraph "orderflow" {
    graph [rankdir=TB, bgcolor=white, fontname="helvetica", fontsize=12, splines=spline, nodesep=0.60, ranksep=0.80, ordering=out, tooltip=" "]
    node [fontname="helvetica", fontsize=12]
    edge [fontname="helvetica", fontsize=12, color="#000000", style=solid, penwidth=1, arrowhead=normal, arrowtail=none]

    start [label="Order Received", shape=ellipse, style="solid,filled", fillcolor="#A3D1A3", penwidth=1, fontcolor="black", tooltip=" "]
    validate [label="Validate", shape=box, style="rounded,solid,filled", fillcolor="#4D4DC9", penwidth=1, fontcolor="white", tooltip=" "]
    complete [label="Done", shape=doublecircle, style="solid,filled", fillcolor="#A3D1A3", penwidth=1, fontcolor="black", tooltip=" "]

    start -> validate
    validate -> complete

}


