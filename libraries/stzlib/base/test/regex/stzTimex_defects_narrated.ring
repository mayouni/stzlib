load "../../stzBase.ring"
load "../_narrated.ring"

# stzTimex -- the pattern parser and the matcher.
# The parser slices with a start and an END position and @StzMid takes a COUNT (the same slip as stzTablex): a step
# came out with the right type and a label that kept its closing bracket, SplitByOperator never cut, and a pattern
# of several steps was read as one. Each scenario states the answer AFTER the fix; every expected value below was
# written by hand before the run. A positive always has a negative sibling.

$sA = "2025-10-22 09:00:00"
$sB = "2025-10-22 10:00:00"
$sC = "2025-10-22 11:00:00"

$aT0 = []
$aT1 = [ $sA ]
$aT2 = [ $sA, $sB ]
$aT3 = [ $sA, $sB, $sC ]
$aTmix = [ 5, $sA, "x", 2.5 ]

# a timeline: Meeting (instant 09:00), Break (span 10:00-10:15), Lunch (instant 12:00)
$oTL = new stzTimeLine("2025-10-22", "2025-10-22")
$oTL.AddInstant("Meeting", "2025-10-22 09:00:00")
$oTL.AddSpan("Break", "2025-10-22 10:00:00", "2025-10-22 10:15:00")
$oTL.AddInstant("Lunch", "2025-10-22 12:00:00")

# a label with a multibyte letter, built from char codes
$cE = "caf" + char(195) + char(169)
$oTLa = new stzTimeLine("2025-10-22", "2025-10-22")
$oTLa.AddInstant($cE, "2025-10-22 09:00:00")
$oTLa.AddInstant("B", "2025-10-22 10:00:00")

$oDt = new stzDateTime("2025-10-22 09:00:00")
$oDur90 = new stzDuration("1 hour 30 minutes")

$oBase = new stzTimex("@Instant")

Scenario("SplitByOperator cuts at an operator outside brackets")
	Then("a->b is a and b", TxJoin($oBase.SplitByOperator("a->b", "->")), "a#b")
	Then("an arrow inside brackets does not cut", TxJoin($oBase.SplitByOperator("a -> b(c -> d) -> e", "->")), "a#b(c -> d)#e")
	Then("a bar cuts too", TxJoin($oBase.SplitByOperator("a|b|c", "|")), "a#b#c")
	Then("a text without the operator stays whole", TxJoin($oBase.SplitByOperator("a|b|c", "->")), "a|b|c")
	Then("a bar inside a group does not cut", TxJoin($oBase.SplitByOperator("(a|b)|c", "|")), "(a|b)#c")
	Then("braces hide an arrow", TxJoin($oBase.SplitByOperator("{x->y}->z", "->")), "{x->y}#z")
	Then("a text with no operator is one part", TxJoin($oBase.SplitByOperator("x", "->")), "x")
	Then("an empty text has no part", len($oBase.SplitByOperator("", "->")), 0)
	Then("two operators in a row leave an empty part", TxJoin($oBase.SplitByOperator("a->->b", "->")), "a##b")
	Then("an operator first leaves an empty part", TxJoin($oBase.SplitByOperator("->a", "->")), "#a")
	Then("an operator last leaves nothing after it", TxJoin($oBase.SplitByOperator("a->", "->")), "a")
	aMb = $oBase.SplitByOperator($cE + "->b", "->")
	Then("a multibyte letter before the arrow: two parts", len(aMb), 2)
	Then("the first part is the letter text whole", aMb[1], $cE)
	Then("the second is b", aMb[2], "b")
EndScenario()

Scenario("Parsing: the steps, their labels and their quantifiers")
	Then("one step is one token", len(TxTok("@Instant")), 1)
	Then("three steps are three tokens", len(TxTok("@Event(A) -> @Duration -> @Event(B)")), 3)
	Then("braces around the pattern change nothing", len(TxTok("{@Instant -> @Instant}")), 2)
	aE = TxTok("@Event(A)")
	Then("an event step has the type event", aE[1][1][2], "event")
	Then("a label keeps no closing bracket", aE[1][2][2], "A")
	Then("a step without brackets has an empty label", TxTok("@Instant")[1][2][2], "")
	Then("a plain step is exactly one", TxQuant("@Instant"), "1-1")
	Then("+ is one or more", TxQuant("@Event(A)+"), "1-999999")
	Then("* is zero or more", TxQuant("@Event(A)*"), "0-999999")
	Then("? is zero or one", TxQuant("@Event(A)?"), "0-1")
	Then("a count is that many", TxQuant("@Event(A)3"), "3-3")
	Then("a count right after the type (no brackets) counts too", TxQuant("@Instant3"), "3-3")
	Then("a range gives its two ends", TxQuant("@Event(A)2-3"), "2-3")
	Then("a range after the type gives its two ends", TxQuant("@Instant2-4"), "2-4")
	Then("~ marks the step cyclic", TxTok("@Instant~")[1][6][2], 1)
	Then("and a plain step is not cyclic", TxTok("@Instant")[1][6][2], 0)
	Then("a duration holds its constraint", len(TxTok("@Duration(1h)")[1][3][2]), 1)
	Then("a duration of 1h is an exact constraint", TxTok("@Duration(1h)")[1][3][2][1][1][2], "exact")
	Then("a duration step holds no label", TxTok("@Duration(1h)")[1][2][2], "")
	Then("an event with a duration after a colon: label", TxTok("@Event(S:1h)")[1][2][2], "S")
	Then("an event with a duration after a colon: constraint", len(TxTok("@Event(S:1h)")[1][3][2]), 1)
	Then("a frame step", TxTok("@Frame(F)")[1][1][2], "frame")
	Then("a sequence step", TxTok("@Sequence(S)")[1][1][2], "sequence")
	Then("a negated step is marked", TxTok("@!Event(A)")[1][7][2], 1)
	Then("and keeps its type and label", TxTok("@!Event(A)")[1][1][2] + "/" + TxTok("@!Event(A)")[1][2][2], "event/A")
	Then("a plain step is not negated", TxTok("@Event(A)")[1][7][2], 0)
	Then("a step that names no type is dropped", len(TxTok("@Foo")), 0)
	Then("an arrow inside a label is part of the label", TxTok("@Event(a->b)")[1][2][2], "a->b")
	Then("and stays one token", len(TxTok("@Event(a->b)")), 1)
	Then("an empty pattern has no token", len(TxTok("")), 0)
	Then("a trailing arrow leaves one token", len(TxTok("@Instant ->")), 1)
	Then("ParseSingleToken of empty text is empty", len($oBase.ParseSingleToken("")), 0)
EndScenario()

Scenario("Parsing: alternations")
	aA = TxTok("@Event(A)|@Event(B)")
	Then("a bar outside any bracket makes an alternation", aA[1][1][2], "alternation")
	Then("with two alternatives", len(aA[1][2][2]), 2)
	Then("the first has the label A", aA[1][2][2][1][2][2], "A")
	Then("the second has the label B", aA[1][2][2][2][2][2], "B")
	aG = TxTok("@Event(A) -> (@Event(B)|@Event(C)) -> @Event(D)")
	Then("a group between arrows: three tokens", len(aG), 3)
	Then("the middle one is an alternation", aG[2][1][2], "alternation")
	Then("of two alternatives", len(aG[2][2][2]), 2)
	Then("the last one is the event D", aG[3][2][2], "D")
	Then("ParseAlternation of a group: 2 alternatives", len($oBase.ParseAlternation("(@Event(A)|@Event(B))")[2][2]), 2)
	Then("each alternative in its own brackets: 2 alternatives", len($oBase.ParseAlternation("(@Event(A))|(@Event(B))")[2][2]), 2)
	Then("three alternatives", len($oBase.ParseAlternation("@Event(A)|@Event(B)|@Event(C)")[2][2]), 3)
	Then("a bar inside the label brackets is label text", TxTok("@Event(A|B)")[1][2][2][1][2][2], "A|B")
	Then("a quantifier on a whole group is not supported: no alternative", len(TxTok("(@Event(A)|@Event(B))+")[1][2][2]), 0)
EndScenario()

Scenario("Parsing: durations and constraints")
	Then("1h is 60 minutes", $oBase.ParseDurationToMinutes("1h"), 60)
	Then("1h30min is 90", $oBase.ParseDurationToMinutes("1h30min"), 90)
	Then("a bare number is minutes", $oBase.ParseDurationToMinutes("45"), 45)
	Then("2H is 120", $oBase.ParseDurationToMinutes("2H"), 120)
	Then("30m is 30", $oBase.ParseDurationToMinutes("30m"), 30)
	Then("90min is 90", $oBase.ParseDurationToMinutes("90min"), 90)
	Then("1h is not 61", $oBase.ParseDurationToMinutes("1h") = 61, 0)
	aR = $oBase.ParseConstraints("1h..2h:15min")
	Then("a range with a step: one constraint", len(aR), 1)
	Then("its type is range", aR[1][1][2], "range")
	Then("its start", aR[1][2][2], "1h")
	Then("its end", aR[1][3][2], "2h")
	Then("its step", aR[1][4][2], "15min")
	aX = $oBase.ParseConstraints("1h")
	Then("a single duration is exact", aX[1][1][2], "exact")
	Then("of 60 minutes", aX[1][2][2], 60)
	Then("an empty text gives no constraint", len($oBase.ParseConstraints("")), 0)
	aS = $oBase.ParseConstraints("{Mon;Wed;Fri}")
	Then("a set is one constraint", len(aS), 1)
	Then("of type set", aS[1][1][2], "set")
	Then("with three values", len(aS[1][2][2]), 3)
	Then("a set in a duration step builds (it once raised)", TxTok("@Duration({Mon;Wed})")[1][3][2][1][1][2], "set")
EndScenario()

Scenario("Constraints on one item")
	aD45 = [ [ "type", "duration" ], [ "label", "" ], [ "minutes", 45 ] ]
	aD90 = [ [ "type", "duration" ], [ "label", "" ], [ "minutes", 90 ] ]
	aD50 = [ [ "type", "duration" ], [ "label", "" ], [ "minutes", 50 ] ]
	aRange = $oBase.ParseConstraints("30m..1h")
	Then("45 minutes is inside 30m..1h", $oBase.CheckConstraints(aRange, aD45), 1)
	Then("90 minutes is not", $oBase.CheckConstraints(aRange, aD90), 0)
	aStep = $oBase.ParseConstraints("30m..1h:20m")
	Then("50 minutes is on the 20 minute step from 30", $oBase.CheckConstraints(aStep, aD50), 1)
	Then("45 minutes is not on that step", $oBase.CheckConstraints(aStep, aD45), 0)
	aEx = $oBase.ParseConstraints("45m")
	Then("exactly 45 holds for 45", $oBase.CheckConstraints(aEx, aD45), 1)
	Then("and not for 50", $oBase.CheckConstraints(aEx, aD50), 0)
	aSet = $oBase.ParseConstraints("{Mon;Wed}")
	aWed = [ [ "type", "event" ], [ "label", "wed" ], [ "minutes", 0 ] ]
	aTue = [ [ "type", "event" ], [ "label", "Tue" ], [ "minutes", 0 ] ]
	Then("a set holds a label of the set, whatever its case", $oBase.CheckConstraints(aSet, aWed), 1)
	Then("and not a label outside it", $oBase.CheckConstraints(aSet, aTue), 0)
	Then("no constraint always holds", $oBase.CheckConstraints([], aD45), 1)
EndScenario()

Scenario("Single steps against lists of date texts")
	Then("@Instant matches one date text", TxE("@Instant", $aT1), 1)
	Then("but not two", TxE("@Instant", $aT2), 0)
	Then("@Instant matches somewhere in two", TxP("@Instant", $aT2), 1)
	Then("nothing is found in an empty list", TxP("@Instant", $aT0), 0)
	Then("an empty list is not one instant", TxE("@Instant", $aT0), 0)
	Then("@Instant+ takes all three", TxE("@Instant+", $aT3), 1)
	Then("@Instant+ needs at least one", TxE("@Instant+", $aT0), 0)
	Then("@Instant* takes none", TxE("@Instant*", $aT0), 1)
	Then("@Instant* takes three too", TxE("@Instant*", $aT3), 1)
	Then("@Instant? takes one", TxE("@Instant?", $aT1), 1)
	Then("@Instant? does not take two", TxE("@Instant?", $aT2), 0)
	Then("@Instant? takes none", TxE("@Instant?", $aT0), 1)
	Then("@Instant2 takes exactly two", TxE("@Instant2", $aT2), 1)
	Then("@Instant2 does not take three", TxE("@Instant2", $aT3), 0)
	Then("@Instant2 is found inside three", TxP("@Instant2", $aT3), 1)
	Then("@Instant2-3 takes three", TxE("@Instant2-3", $aT3), 1)
	Then("@Instant2-3 does not take one", TxE("@Instant2-3", $aT1), 0)
	Then("@Instant~ is one step today", TxE("@Instant~", $aT1), 1)
	Then("@Instant~ does not take two", TxE("@Instant~", $aT2), 0)
	Then("a label on an instant of a list is not compared", TxE("@Instant(A)", $aT1), 1)
	Then("Match is MatchExact: yes", TxM("@Instant", $aT1), 1)
	Then("Match is MatchExact: no", TxM("@Instant", $aT2), 0)
	Then("Match is MatchExact: a count, yes", TxM("@Instant2", $aT2), 1)
	Then("Match is MatchExact: a count, no", TxM("@Instant2", $aT1), 0)
EndScenario()

Scenario("Sequences of steps against lists")
	Then("two instants for two steps", TxE("@Instant -> @Instant", $aT2), 1)
	Then("one instant is too few", TxE("@Instant -> @Instant", $aT1), 0)
	Then("three instants are too many for an exact match", TxE("@Instant -> @Instant", $aT3), 0)
	Then("but the pair is found inside three", TxP("@Instant -> @Instant", $aT3), 1)
	Then("three steps, three instants", TxE("@Instant -> @Instant -> @Instant", $aT3), 1)
	Then("three steps, two instants", TxE("@Instant -> @Instant -> @Instant", $aT2), 0)
	Then("a step of one or more then one: backtracking", TxE("@Instant+ -> @Instant", $aT3), 1)
	Then("a step of one or more then one: one instant is too few", TxE("@Instant+ -> @Instant", $aT1), 0)
	Then("one then one or more: one instant is too few", TxE("@Instant -> @Instant+", $aT1), 0)
	Then("one then one or more: two", TxE("@Instant -> @Instant+", $aT2), 1)
	Then("an optional gap step needs no gap", TxE("@Instant -> @Duration? -> @Instant", $aT2), 1)
	Then("a gap step that is required finds none in a list", TxE("@Instant -> @Duration -> @Instant", $aT2), 0)
	Then("zero or more gaps", TxE("@Instant -> @Duration* -> @Instant", $aT2), 1)
	Then("one or more gaps are not there", TxE("@Instant -> @Duration+ -> @Instant", $aT2), 0)
EndScenario()

Scenario("Alternations against lists")
	Then("instant or event, one instant", TxE("@Instant | @Event", $aT1), 1)
	Then("instant or event, two instants", TxE("@Instant | @Event", $aT2), 0)
	Then("a group of instant or duration", TxE("(@Instant|@Duration)", $aT1), 1)
	Then("a group of duration or frame holds no instant", TxE("(@Duration|@Frame)", $aT1), 0)
	Then("a group after an arrow, second alternative", TxE("@Instant -> (@Duration|@Instant)", $aT2), 1)
	Then("a group after an arrow, none fits", TxE("@Instant -> (@Duration|@Frame)", $aT2), 0)
	Then("a group followed by a quantifier is not supported: no match", TxE("(@Instant|@Duration)+", $aT1), 0)
	Then("each alternative in its own brackets", TxE("(@Instant)|(@Duration)", $aT1), 1)
	Then("each alternative in its own brackets, none fits", TxE("(@Duration)|(@Frame)", $aT1), 0)
EndScenario()

Scenario("A timeline: events, gaps and labels")
	cSeq = "@Event(Meeting) -> @Duration -> @Event(Break) -> @Duration -> @Event("
	Then("the whole timeline, exactly", TxE(cSeq + "Lunch)", $oTL), 1)
	Then("a wrong last label", TxE(cSeq + "Dinner)", $oTL), 0)
	Then("a wrong last label is not found inside either", TxP(cSeq + "Dinner)", $oTL), 0)
	Then("labels ignore case", TxE("@Event(meeting) -> @Duration -> @Event(BREAK) -> @Duration -> @Event(lunch)", $oTL), 1)
	Then("without a label every event fits", TxE("@Event -> @Duration -> @Event -> @Duration -> @Event", $oTL), 1)
	Then("Meeting, any gaps, Break: not the whole timeline", TxE("@Event(Meeting) -> @Duration* -> @Event(Break)", $oTL), 0)
	Then("Meeting, any gaps, Break: found inside", TxP("@Event(Meeting) -> @Duration* -> @Event(Break)", $oTL), 1)
	Then("a gap of exactly 1h between Meeting and Break", TxP("@Event(Meeting) -> @Duration(1h) -> @Event(Break)", $oTL), 1)
	Then("a gap of exactly 30m is not there", TxP("@Event(Meeting) -> @Duration(30m) -> @Event(Break)", $oTL), 0)
	Then("a gap of 105 minutes is the later one, not before Break", TxP("@Event(Meeting) -> @Duration(105min) -> @Event(Break)", $oTL), 0)
	Then("a gap between 30m and 2h", TxP("@Event(Meeting) -> @Duration(30m..2h) -> @Event(Break)", $oTL), 1)
	Then("a gap between 2h and 3h is not there", TxP("@Event(Meeting) -> @Duration(2h..3h) -> @Event(Break)", $oTL), 0)
	Then("a gap on a 30m step from 30m: 60 is on it", TxP("@Event(Meeting) -> @Duration(30m..2h:30m) -> @Event(Break)", $oTL), 1)
	Then("a gap on a 20m step from 30m: neither 60 nor 105 is on it", TxP("@Event(Meeting) -> @Duration(30m..2h:20m) -> @Event(Break)", $oTL), 0)
	Then("the span Break lasts 15 minutes", TxP("@Event(Break:15min)", $oTL), 1)
	Then("the span Break does not last 30 minutes", TxP("@Event(Break:30min)", $oTL), 0)
	Then("an alternative of two labels: the second is there", TxP("@Event(Meeting) -> @Duration* -> (@Event(Coffee)|@Event(Lunch))", $oTL), 1)
	Then("an alternative of two labels: neither is there", TxP("@Event(Meeting) -> @Duration* -> (@Event(Coffee)|@Event(Dinner))", $oTL), 0)
	Then("the whole timeline ending with an alternative", TxE("@Event(Meeting) -> @Duration -> @Event(Break) -> @Duration -> (@Event(Coffee)|@Event(Lunch))", $oTL), 1)
	Then("the same with no alternative there", TxE("@Event(Meeting) -> @Duration -> @Event(Break) -> @Duration -> (@Event(Coffee)|@Event(Dinner))", $oTL), 0)
	Then("an instant step does not take the span", TxP("@Instant(Break)", $oTL), 0)
	Then("an event step takes the span", TxP("@Event(Break)", $oTL), 1)
	Then("an instant step takes an instant", TxP("@Instant(Lunch)", $oTL), 1)
	Then("a frame step finds no frame", TxP("@Frame", $oTL), 0)
	Then("@Event+ stops at the first gap, so not the whole timeline", TxE("@Event+", $oTL), 0)
	Then("@Event+ is found at the start", TxP("@Event+", $oTL), 1)
	Then("a partial search skips the items between two steps: Meeting then Lunch", TxP("@Event(Meeting) -> @Event(Lunch)", $oTL), 1)
	Then("an exact match skips nothing: Meeting then Lunch", TxE("@Event(Meeting) -> @Event(Lunch)", $oTL), 0)
	Then("a partial search keeps the order: Lunch then Meeting", TxP("@Event(Lunch) -> @Event(Meeting)", $oTL), 0)
EndScenario()

Scenario("Negation")
	oDurT = [ $sA, new stzDuration("30 minutes") ]
	Then("an instant then something that is not an instant: the duration", TxE("@Instant -> @!Instant", oDurT), 1)
	Then("the same against two instants", TxE("@Instant -> @!Instant", $aT2), 0)
	Then("not an event matches a gap", TxP("@Event(Meeting) -> @!Event", $oTL), 1)
	Then("not an event does not match an event", TxE("@!Event", $aT1), 0)
EndScenario()

Scenario("Which texts are instants")
	Then("a date and time", TxE("@Instant", [ "2025-10-22 09:00:00" ]), 1)
	Then("a date alone", TxE("@Instant", [ "2025-10-22" ]), 1)
	Then("a date and time with a T", TxE("@Instant", [ "2025-10-22T09:00:00" ]), 1)
	Then("the text x is not an instant", TxE("@Instant", [ "x" ]), 0)
	Then("nor is it found inside", TxP("@Instant", [ "x" ]), 0)
	Then("the text x does not count as a second instant", TxE("@Instant", [ $sA, "x" ]), 1)
	Then("and not as the second step", TxE("@Instant -> @Instant", [ $sA, "x" ]), 0)
	Then("numbers are skipped", TxE("@Instant", $aTmix), 1)
	Then("numbers and x are skipped, two steps need two dates", TxE("@Instant -> @Instant", $aTmix), 0)
	Then("only numbers: nothing", TxP("@Instant", [ 1, 2 ]), 0)
	Then("an empty text is not an instant", TxP("@Instant", [ "" ]), 0)
	Then("NormalizeTarget keeps the one date of a mixed list", len($oBase.NormalizeTarget($aTmix)), 1)
	Then("it keeps three of three dates", len($oBase.NormalizeTarget($aT3)), 3)
	Then("it keeps none of x", len($oBase.NormalizeTarget([ "x" ])), 0)
EndScenario()

Scenario("Date-time and duration objects")
	Then("a date-time object is an instant", TxE("@Instant", [ $oDt ]), 1)
	Then("a lone date-time object is an instant", TxE("@Instant", $oDt), 1)
	Then("two instants: object then text", TxE("@Instant -> @Instant", [ $oDt, $sB ]), 1)
	Then("an object and a text are not one instant", TxE("@Instant", [ $oDt, $sB ]), 0)
	Then("an instant then 90 minutes: exactly 1h30min", TxE("@Instant -> @Duration(1h30min)", [ $sA, $oDur90 ]), 1)
	Then("an instant then 90 minutes: not 1h", TxE("@Instant -> @Duration(1h)", [ $sA, $oDur90 ]), 0)
	Then("an instant then 90 minutes: in 1h..2h", TxE("@Instant -> @Duration(1h..2h)", [ $sA, $oDur90 ]), 1)
	Then("a lone duration object", TxE("@Duration(1h..2h:15min)", $oDur90), 1)
	Then("a lone duration object off the step", TxE("@Duration(1h..2h:20min)", $oDur90), 0)
	Then("a lone duration is no instant", TxE("@Instant", $oDur90), 0)
	Then("NormalizeTarget of a date-time object", len($oBase.NormalizeTarget($oDt)), 1)
	Then("NormalizeTarget of a duration object", len($oBase.NormalizeTarget($oDur90)), 1)
	Then("NormalizeTarget of a timeline: 3 items and 2 gaps", len($oBase.NormalizeTarget($oTL)), 5)
	Then("NormalizeTarget of a bare text", len($oBase.NormalizeTarget("abc")), 0)
	Then("NormalizeTarget of a bare number", len($oBase.NormalizeTarget(42)), 0)
EndScenario()

Scenario("Empty pattern, empty target, unknown steps")
	Then("an empty pattern matches an empty target", TxE("", $aT0), 1)
	Then("but not a target with a date", TxE("", $aT1), 0)
	Then("an empty pattern is found in a target with a date", TxP("", $aT1), 1)
	Then("an empty pattern is not found in an empty target", TxP("", $aT0), 0)
	Then("a step that names no type is dropped: the pattern is empty", TxE("@Foo", $aT0), 1)
	Then("and then it does not match a date", TxE("@Foo", $aT1), 0)
EndScenario()

Scenario("Multibyte labels")
	Then("the label is read whole", TxTok("@Event(" + $cE + ")")[1][2][2], $cE)
	Then("Cafe with the accent, a gap, B: the whole timeline", TxE("@Event(" + $cE + ") -> @Duration -> @Event(B)", $oTLa), 1)
	Then("the ASCII spelling is another label", TxE("@Event(cafe) -> @Duration -> @Event(B)", $oTLa), 0)
	Then("an arrow after the multibyte label still cuts", len(TxTok("@Event(" + $cE + ")->@Event(B)")), 2)
EndScenario()

Scenario("MatchedParts and Explain")
	o1 = new stzTimex("@Instant+")
	Then("a fresh object holds no parts", len(o1.MatchedParts()), 0)
	Then("and has no target", o1.Explain()[4][2], 0)
	Then("and no match", o1.Explain()[5][2], 0)
	Then("it matches two dates", o1.MatchExact($aT2), 1)
	Then("two parts are recorded", len(o1.MatchedParts()), 2)
	Then("the first part is an instant", o1.MatchedParts()[1][1][2], "instant")
	Then("Explain knows the target", o1.Explain()[4][2], 1)
	Then("and the match", o1.Explain()[5][2], 1)
	Then("Explain counts the token", o1.Explain()[2][2], 1)
	Then("a failed match", o1.MatchExact($aT0), 0)
	Then("clears the parts", len(o1.MatchedParts()), 0)
	Then("Explain no longer reports a match", o1.Explain()[5][2], 0)
	o2 = new stzTimex("@Instant")
	o2.SetTarget($aT1)
	Then("SetTarget records the target", o2.Explain()[4][2], 1)
	Then("without matching", o2.Explain()[5][2], 0)
	Then("Pattern gives the braced text", o2.Pattern(), "{@Instant}")
	Then("NormalizePattern wraps and trims", o2.NormalizePattern("  @Event(A) "), "{@Event(A)}")
	Then("NormalizePattern keeps braces", o2.NormalizePattern("{x}"), "{x}")
	Then("Tokens gives one token", len(o2.Tokens()), 1)
	Then("TokensXT gives one record", len(o2.TokensXT()), 1)
	Then("whose type is instant", o2.TokensXT()[1][2][2], "instant")
	o3 = new stzTimex("@Event(A)+")
	Then("TokensXT shows a quantifier", o3.TokensXT()[1][4][1], "quantifier")
	Then("a plain step shows none", len(o2.TokensXT()[1]), 3)
EndScenario()

Scenario("Matching as the target is built")
	Then("one instant of two steps: it could still match", TxB("@Instant -> @Instant", $aT1), 1)
	Then("two instants of two steps: it matches", TxB("@Instant -> @Instant", $aT2), 1)
	Then("no instant yet: it could still match", TxB("@Instant -> @Instant", $aT0), 1)
	Then("two instants and a gap step wanted: no list gap can come, so no", TxB("@Instant -> @Duration", $aT2), 0)
	Then("three instants and a gap step wanted", TxB("@Instant -> @Duration", $aT3), 0)
	Then("a one step pattern with an instant", TxB("@Instant", $aT1), 1)
	Then("a one step pattern has nothing more to wait for", $oBase.CouldMatchWithMore($oBase.NormalizeTarget($aT1)), 0)
	o4 = new stzTimex("@Instant -> @Instant -> @Instant")
	Then("a pattern of three steps could match with two", o4.CouldMatchWithMore(o4.NormalizeTarget($aT2)), 1)
	Then("a pattern of three steps with 3 instants has nothing to wait for", o4.CouldMatchWithMore(o4.NormalizeTarget($aT3)), 0)
EndScenario()

Scenario("The matching engine on tokens built by hand")
	oI = new stzTimex("@Instant+")
	oO = new stzTimex("@Instant")
	aN2 = oO.NormalizeTarget($aT2)
	Then("one or more against two instants, whole", oI.BacktrackMatch(oI.Tokens(), aN2, 1, 1, []), 1)
	Then("exactly one against two instants, whole", oO.BacktrackMatch(oO.Tokens(), aN2, 1, 1, []), 0)
	Then("exactly one against the second instant, whole", oO.BacktrackMatch(oO.Tokens(), aN2, 1, 2, []), 1)
	Then("exactly one from item 2 of two, partial", oO.BacktrackMatchPartial(oO.Tokens(), aN2, 1, 2, []), 1)
	Then("exactly one from item 3 of two, partial: nothing left", oO.BacktrackMatchPartial(oO.Tokens(), aN2, 1, 3, []), 0)
	Then("the smallest of 3, 1, 2", oO.@Min([ 3, 1, 2 ]), 1)
	Then("the smallest of one", oO.@Min([ 7 ]), 7)
	aItems = [ [ [ "type", "instant" ], [ "label", "" ], [ "datetime", $sC ] ], [ [ "type", "instant" ], [ "label", "" ], [ "datetime", $sA ] ], [ [ "type", "event" ], [ "label", "" ], [ "start", $sB ] ] ]
	aSorted = oO.SortByDateTime(aItems)
	Then("sorted: the earliest first", aSorted[1][3][2], $sA)
	Then("sorted: the span in the middle", aSorted[2][1][2], "event")
	Then("sorted: the latest last", aSorted[3][3][2], $sC)
	oO.ExtractMatches(aN2)
	Then("ExtractMatches records a part per item", len(oO.MatchedParts()), 2)
EndScenario()

Scenario("A calendar as the target")
	oCal = new stzCalendar([ :From = "2025-10-20", :To = "2025-10-26" ])
	Then("the working days of the week are 5 instants", len($oBase.NormalizeTarget(oCal)), 5)
	Then("one or more instants take them", TxE("@Instant+", oCal), 1)
	Then("exactly five take them", TxE("@Instant5", oCal), 1)
	Then("exactly four do not", TxE("@Instant4", oCal), 0)
	Then("one instant does not", TxE("@Instant", oCal), 0)
	Then("the instants carry the label WorkDay: an event of that label", TxP("@Event(WorkDay)", oCal), 1)
	Then("an event of another label is not there", TxP("@Event(Holiday)", oCal), 0)
EndScenario()

Scenario("Type tests of the target")
	Then("a timeline is a timeline", $oBase.@IsStzTimeLine($oTL), 1)
	Then("a text is not", $oBase.@IsStzTimeLine("x"), 0)
	Then("a date-time object is a date-time", $oBase.@IsStzDateTime($oDt), 1)
	Then("a timeline is not a date-time", $oBase.@IsStzDateTime($oTL), 0)
	Then("a duration object is a duration", $oBase.@IsStzDuration($oDur90), 1)
	Then("a date-time is not a duration", $oBase.@IsStzDuration($oDt), 0)
	Then("a text is no calendar", $oBase.@IsStzCalendar("x"), 0)
EndScenario()

Summary()

func TxJoin(aList)
	cOut = ""
	nItems = len(aList)
	for i = 1 to nItems
		if i > 1
			cOut += "#"
		ok
		cOut += aList[i]
	next
	return cOut

func TxTok(cPattern)
	oT = new stzTimex(cPattern)
	return oT.Tokens()

func TxQuant(cPattern)
	aT = TxTok(cPattern)
	return "" + aT[1][4][2] + "-" + aT[1][5][2]

func TxE(cPattern, xTarget)
	oT = new stzTimex(cPattern)
	return oT.MatchExact(xTarget)

func TxP(cPattern, xTarget)
	oT = new stzTimex(cPattern)
	return oT.MatchPartial(xTarget)

func TxM(cPattern, xTarget)
	oT = new stzTimex(cPattern)
	return oT.Match(xTarget)

func TxB(cPattern, xTarget)
	oT = new stzTimex(cPattern)
	return oT.MatchAsYouBuild(xTarget)
