load "../../stzBase.ring"
load "../_narrated.ring"
load "_tblfix.ring"

# stzTable defects, part two of the finders and counters: 31 methods the register still listed as raising.
# The first batch (t04) had already repaired most of them, so this guard CLASSIFIES them by running each one on
# a square table and a rectangular one, with a text cell, a number cell and a list cell, and with a negative
# sibling for every positive. The one real defect it found: a cell that is a LIST could not be looked for
# among the cells of rows or columns when the last (or the nth) occurrence was wanted, because the list was
# read as a named parameter [ :Cell, value ] instead of as a value.
#
#   3 x 3 :  1 2 3 / 4 5 6 / 7 8 9            (numbers)                       o
#   4 x 2 :  x y / z w / x q / r y            (text, repeated)                o4
#   ow    :  name = Andy Ali Alia   job = Maestro Abraham Ali                 (texts that contain texts)
#   lt    :  as the 3 x 3 table, but the cell [ 2, 2 ] is the list [ 5, 6 ]   (a list cell)

Scenario("A range and a section as a range")
	Given("the 3 x 3 and the 4 x 2 tables")
	Tn("SectionToRange gives the start and the count", Does("o.SectionToRange(2, 5)"), "[ 2, 4 ]")
	Tn("a section of one position is a count of 1", Does("o.SectionToRange(3, 3)"), "[ 3, 1 ]")
	Tn("Range reads a block from a corner and a size (4 x 2, columns 2 rows 3 to 4)", Does("o4.Range([ 2, 3 ], [ 1, 2 ])"), '[ "q", "y" ]')
	Tn("the whole 4 x 2 table, row by row", Does("o4.Range([ 1, 1 ], [ 2, 4 ])"), '[ "x", "y", "z", "w", "x", "q", "r", "y" ]')
	Tn("a block of the 3 x 3 table", Does("o.Range([ 1, 1 ], [ 2, 2 ])"), "[ 1, 2, 4, 5 ]")
	Tn("a size of 0 rows gives [ ], not an error", Does("o.Range([ 1, 1 ], [ 2, 0 ])"), "[ ]")
	Tn("a size that is not a pair of numbers raises", Does("o4.Range([ 1, 1 ], 'x')"), "RAISES")
	Tn("a start that is not a pair raises", Does("o.Range(1, [ 1, 1 ])"), "RAISES")
	Tn("a block that leaves the table raises", Does("o4.Range([ 1, 1 ], [ 2, 5 ])"), "RAISES")
EndScenario()

Scenario("Columns found by their whole content")
	Given("the 3 x 3 table, the 4 x 2 table and a table with a list cell")
	Tn("a column is found by its cells, top to bottom", Does("o.FindColsByValue([ [ 1, 4, 7 ] ])"), "[ 1 ]")
	Tn("several lists give the positions, in table order", Does("o.FindColsByValue([ [ 3, 6, 9 ], [ 1, 4, 7 ] ])"), "[ 1, 3 ]")
	Tn("a list that is no column gives [ ]", Does("o.FindColsByValue([ [ 1, 4, 8 ] ])"), "[ ]")
	Tn("a list that is a column read bottom to top is no column", Does("o.FindColsByValue([ [ 7, 4, 1 ] ])"), "[ ]")
	Tn("the same list twice gives the column once", Does("o.FindColsByValue([ [ 1, 4, 7 ], [ 1, 4, 7 ] ])"), "[ 1 ]")
	Tn("no list at all gives [ ]", Does("o.FindColsByValue([ ])"), "[ ]")
	Tn("on the 4 x 2 table, text cells", Does("o4.FindColsByValue([ [ 'y', 'w', 'q', 'y' ] ])"), "[ 2 ]")
	Tn("the text is compared with its case", Does("o4.FindColsByValue([ [ 'X', 'Z', 'X', 'R' ] ])"), "[ ]")
	Tn("a list with too few cells is no column", Does("o4.FindColsByValue([ [ 'x', 'z' ] ])"), "[ ]")
	Tn("a column that holds a list cell", Does("LT().FindColsByValue([ [ 2, [ 5, 6 ], 8 ] ])"), "[ 2 ]")
	Tn("and the same column without its list cell is not found", Does("LT().FindColsByValue([ [ 2, 5, 8 ] ])"), "[ ]")
	Tn("something that is not a list of lists raises", Does("o.FindColsByValue(5)"), "RAISES")
EndScenario()

Scenario("A text, a value or a number inside one cell")
	Given("the people table: the cell [ 2, 2 ] is Abraham, [ 1, 3 ] is Alia, [ 1, 1 ] is Andy")
	Tn("FindLastInCell gives the last place of a letter", Does("ow.FindLastInCell(2, 2, 'a')"), "6")
	Tn("FindLastInCell takes the column by its name", Does("ow.FindLastInCell(:job, 2, 'a')"), "6")
	Tn("a letter that occurs once", Does("ow.FindLastInCell(1, 3, 'a')"), "4")
	Tn("the case counts: A is only the first letter of Abraham", Does("ow.FindLastInCell(2, 2, 'A')"), "1")
	Tn("a text that is absent gives 0, not an error", Does("ow.FindLastInCell(1, 1, 'zzz')"), "0")
	Tn("a text that is there in another case only", Does("ow.FindLastInCell(1, 1, 'ANDY')"), "0")
	Tn("a number cell holds no text", Does("o.FindLastInCell(2, 2, 5)"), "0")
	Tn("on the 4 x 2 table", Does("o4.FindLastInCell(1, 3, 'x')"), "1")
	Tn("a list cell: the last place of an item", Does("LT().FindLastInCell(2, 2, 5)"), "1")
	Tn("NumberOfOccurrencesInCell counts the places of a text", Does("ow.NumberOfOccurrencesInCell(2, 2, [ :SubValue, 'a' ])"), "2")
	Tn("a text that is not in the cell counts 0", Does("ow.NumberOfOccurrencesInCell(2, 2, [ :SubValue, 'zz' ])"), "0")
	Tn("a whole value that equals the cell counts 1", Does("ow.NumberOfOccurrencesInCell(1, 3, 'Alia')"), "1")
	Tn("a whole value that is only a part of the cell counts 0", Does("ow.NumberOfOccurrencesInCell(1, 3, 'Ali')"), "0")
	Tn("[ :Cell, value ] is the whole-value form", Does("ow.NumberOfOccurrencesInCell(2, 2, [ :Cell, 'Abraham' ])"), "1")
	Tn("a number cell equal to the number", Does("o.NumberOfOccurrencesInCell(2, 2, 5)"), "1")
	Tn("a number cell that differs", Does("o.NumberOfOccurrencesInCell(2, 2, 6)"), "0")
	Tn("a list cell equal to the list", Does("LT().NumberOfOccurrencesInCell(2, 2, [ :Cell, [ 5, 6 ] ])"), "1")
	Tn("a list cell that contains an item", Does("LT().NumberOfOccurrencesInCell(2, 2, [ :SubValue, 5 ])"), "1")
	Tn("a list cell that does not contain it", Does("LT().NumberOfOccurrencesInCell(2, 2, [ :SubValue, 7 ])"), "0")
	Tn("NumberOfOccurrencesOfValueInCell is 1 for the cell that equals the value", Does("ow.NumberOfOccurrencesOfValueInCell(:name, 2, 'Ali')"), "1")
	Tn("0 for a value that only starts the cell", Does("ow.NumberOfOccurrencesOfValueInCell(:name, 3, 'Ali')"), "0")
	Tn("0 when the case differs", Does("ow.NumberOfOccurrencesOfValueInCell(:name, 2, 'ali')"), "0")
	Tn("a number equal to the cell", Does("o.NumberOfOccurrencesOfValueInCell(1, 1, 1)"), "1")
	Tn("a number that is not the cell", Does("o.NumberOfOccurrencesOfValueInCell(1, 1, 2)"), "0")
	Tn("text on the 4 x 2 table", Does("o4.NumberOfOccurrencesOfValueInCell(2, 4, 'y')"), "1")
	Tn("a list value equal to a list cell", Does("LT().NumberOfOccurrencesOfValueInCell(2, 2, [ 5, 6 ])"), "1")
	Tn("an item of the list is not the cell", Does("LT().NumberOfOccurrencesOfValueInCell(2, 2, 5)"), "0")
	Tn("NumberOfOccurrencesOfSubValueInCell counts every place of a letter", Does("ow.NumberOfOccurrencesOfSubValueInCell(2, 2, 'a')"), "2")
	Tn("a capital is another letter", Does("ow.NumberOfOccurrencesOfSubValueInCell(2, 2, 'A')"), "1")
	Tn("a text of two letters", Does("ow.NumberOfOccurrencesOfSubValueInCell(1, 3, 'li')"), "1")
	Tn("a text that is not in the cell", Does("ow.NumberOfOccurrencesOfSubValueInCell(2, 2, 'zz')"), "0")
	Tn("a cell without that letter", Does("ow.NumberOfOccurrencesOfSubValueInCell(1, 1, 'a')"), "0")
	Tn("text on the 4 x 2 table", Does("o4.NumberOfOccurrencesOfSubValueInCell(1, 1, 'x')"), "1")
	Tn("an item inside a list cell", Does("LT().NumberOfOccurrencesOfSubValueInCell(2, 2, 5)"), "1")
	Tn("a number cell holds no text to look into", Does("o.NumberOfOccurrencesOfSubValueInCell(2, 2, 5)"), "0")
EndScenario()

Scenario("Several cells")
	Given("the people table and the 4 x 2 table")
	Tn("NumberOfOccurrencesOfSubValueInCells counts the places in the cells that contain the text",
		Does("ow.NumberOfOccurrencesOfSubValueInCells([ [ 1, 2 ], [ 2, 3 ] ], 'li')"), "2")
	Tn("two cells, several places each", Does("ow.NumberOfOccurrencesOfSubValueInCells([ [ 1, 3 ], [ 2, 2 ] ], 'a')"), "3")
	Tn("a text found inside a longer cell is counted, not only a cell equal to it",
		Does("ow.NumberOfOccurrencesOfSubValueInCells([ [ 2, 3 ] ], 'l')"), "1")
	Tn("a cell without the text counts 0", Does("ow.NumberOfOccurrencesOfSubValueInCells([ [ 1, 1 ] ], 'li')"), "0")
	Tn("the case counts", Does("ow.NumberOfOccurrencesOfSubValueInCells([ [ 1, 2 ], [ 2, 3 ] ], 'LI')"), "0")
	Tn("on the 4 x 2 table", Does("o4.NumberOfOccurrencesOfSubValueInCells([ [ 1, 1 ], [ 1, 3 ], [ 2, 1 ] ], 'x')"), "2")
	Tn("no cell at all", Does("o4.NumberOfOccurrencesOfSubValueInCells([ ], 'x')"), "0")
EndScenario()

Scenario("Rows: counting")
	Given("the four tables")
	Tn("NumberOfOccurrenceOfCellInRow counts the cells of the row that equal the value", Does("o.NumberOfOccurrenceOfCellInRow(2, 5)"), "1")
	Tn("a value that is in another row", Does("o.NumberOfOccurrenceOfCellInRow(3, 5)"), "0")
	Tn("text on the 4 x 2 table, row 3 is x q", Does("o4.NumberOfOccurrenceOfCellInRow(3, 'x')"), "1")
	Tn("row 2 is z w", Does("o4.NumberOfOccurrenceOfCellInRow(2, 'x')"), "0")
	Tn("a cell that only starts with the value is not counted", Does("ow.NumberOfOccurrenceOfCellInRow(3, 'Ali')"), "1")
	Tn("the case counts", Does("ow.NumberOfOccurrenceOfCellInRow(3, 'ali')"), "0")
	Tn("a list cell equal to a list", Does("LT().NumberOfOccurrenceOfCellInRow(2, [ 5, 6 ])"), "1")
	Tn("a row that does not exist raises", Does("o4.NumberOfOccurrenceOfCellInRow(9, 'x')"), "RAISES")
	Tn("NumberOfOccurrenceOfCellInRows adds the rows", Does("o4.NumberOfOccurrenceOfCellInRows([ 1, 3 ], 'x')"), "2")
	Tn("one row of them", Does("o4.NumberOfOccurrenceOfCellInRows([ 1, 2 ], 'x')"), "1")
	Tn("rows without the value", Does("o4.NumberOfOccurrenceOfCellInRows([ 2, 4 ], 'x')"), "0")
	Tn("a value that repeats over the rows", Does("o4.NumberOfOccurrenceOfCellInRows([ 1, 4 ], 'y')"), "2")
	Tn("texts that contain the text are not the text", Does("ow.NumberOfOccurrenceOfCellInRows([ 2, 3 ], 'Ali')"), "2")
	Tn("on the 3 x 3 table", Does("o.NumberOfOccurrenceOfCellInRows([ 1, 2 ], 5)"), "1")
	Tn("a list cell", Does("LT().NumberOfOccurrenceOfCellInRows([ 1, 2 ], [ 5, 6 ])"), "1")
	Tn("a row that does not exist raises", Does("o4.NumberOfOccurrenceOfCellInRows([ 1, 9 ], 'x')"), "RAISES")
EndScenario()

Scenario("Rows: the nth, the first and the last cell")
	Given("the four tables; the rows are read in the order given")
	Tn("FindNthInRows: the first x", Does("o4.FindNthInRows(1, [ 1, 3 ], 'x')"), "[ 1, 1 ]")
	Tn("the second x", Does("o4.FindNthInRows(2, [ 1, 3 ], 'x')"), "[ 1, 3 ]")
	Tn("the third x does not exist", Does("o4.FindNthInRows(3, [ 1, 3 ], 'x')"), "[ ]")
	Tn("the nth of a value that is in no given row", Does("o4.FindNthInRows(1, [ 2, 4 ], 'x')"), "[ ]")
	Tn("a number cell", Does("o.FindNthInRows(1, [ 1, 2 ], 5)"), "[ 2, 2 ]")
	Tn("a number that is in another row", Does("o.FindNthInRows(1, [ 1, 3 ], 5)"), "[ ]")
	Tn("a text inside the cells, with [ :SubValue, text ]", Does("ow.FindNthInRows(2, [ 2, 3 ], [ :SubValue, 'Ali' ])"), "[ [ 1, 3 ], 1 ]")
	Tn("a list cell, wrapped as [ :Cell, list ]", Does("LT().FindNthInRows(1, [ 1, 2 ], [ :Cell, [ 5, 6 ] ])"), "[ 2, 2 ]")
	Tn(":Last as the occurrence", Does("o4.FindNthInRows(:Last, [ 1, 3 ], 'x')"), "[ 1, 3 ]")
	Tn("an occurrence that is not a number raises", Does("o4.FindNthInRows('x', [ 1, 3 ], 'x')"), "RAISES")
	Tn("FindFirstInRows", Does("o4.FindFirstInRows([ 1, 3 ], 'x')"), "[ 1, 1 ]")
	Tn("the rows are read in the order given", Does("o4.FindFirstInRows([ 3, 1 ], 'x')"), "[ 1, 3 ]")
	Tn("a value that is in no given row", Does("o4.FindFirstInRows([ 2, 4 ], 'x')"), "[ ]")
	Tn("a number", Does("o.FindFirstInRows([ 1, 3 ], 9)"), "[ 3, 3 ]")
	Tn("a number in another row", Does("o.FindFirstInRows([ 1, 2 ], 9)"), "[ ]")
	Tn("a text inside the cells", Does("ow.FindFirstInRows([ 2, 3 ], [ :SubValue, 'Ali' ])"), "[ [ 1, 2 ], 1 ]")
	Tn("a list cell", Does("LT().FindFirstInRows([ 1, 2 ], [ :Cell, [ 5, 6 ] ])"), "[ 2, 2 ]")
	Tn("FindFirstValueInRows", Does("o4.FindFirstValueInRows([ 1, 3 ], 'x')"), "[ 1, 1 ]")
	Tn("FindFirstValueInRows in the order given", Does("o4.FindFirstValueInRows([ 3, 1 ], 'x')"), "[ 1, 3 ]")
	Tn("a value that is in no given row", Does("o4.FindFirstValueInRows([ 2, 4 ], 'x')"), "[ ]")
	Tn("a cell that only starts with the value is not a match", Does("ow.FindFirstValueInRows([ 3 ], 'Al')"), "[ ]")
	Tn("texts that contain the text: the whole value only", Does("ow.FindFirstValueInRows([ 2, 3 ], 'Ali')"), "[ 1, 2 ]")
	Tn("a number", Does("o.FindFirstValueInRows([ 1, 2 ], 5)"), "[ 2, 2 ]")
	Tn("a list cell is a value, as it stands", Does("LT().FindFirstValueInRows([ 1, 2 ], [ 5, 6 ])"), "[ 2, 2 ]")
	Tn("FindFirstSubValueInRows gives the cell and the place", Does("ow.FindFirstSubValueInRows([ 1, 3 ], 'li')"), "[ [ 1, 3 ], 2 ]")
	Tn("on the 4 x 2 table", Does("o4.FindFirstSubValueInRows([ 1, 3 ], 'x')"), "[ [ 1, 1 ], 1 ]")
	Tn("a text that is in no given row", Does("ow.FindFirstSubValueInRows([ 1 ], 'li')"), "[ ]")
	Tn("the case counts", Does("ow.FindFirstSubValueInRows([ 1, 2, 3 ], 'ALI')"), "[ ]")
	Tn("FindLastInRows", Does("o4.FindLastInRows([ 1, 3 ], 'x')"), "[ 1, 3 ]")
	Tn("the last of a value that repeats", Does("o4.FindLastInRows([ 1, 4 ], 'y')"), "[ 2, 4 ]")
	Tn("the rows are read in the order given: the last is then row 1", Does("o4.FindLastInRows([ 4, 1 ], 'y')"), "[ 2, 1 ]")
	Tn("the first of the same", Does("o4.FindFirstInRows([ 1, 4 ], 'y')"), "[ 2, 1 ]")
	Tn("a value that is in no given row", Does("o4.FindLastInRows([ 2, 4 ], 'x')"), "[ ]")
	Tn("a number", Does("o.FindLastInRows([ 1, 2 ], 5)"), "[ 2, 2 ]")
	Tn("a text inside the cells", Does("ow.FindLastInRows([ 2, 3 ], [ :SubValue, 'li' ])"), "[ [ 2, 3 ], 2 ]")
	Tn("a list cell, wrapped", Does("LT().FindLastInRows([ 1, 2 ], [ :Cell, [ 5, 6 ] ])"), "[ 2, 2 ]")
	Tn("FindLastValueInRows", Does("o4.FindLastValueInRows([ 1, 4 ], 'y')"), "[ 2, 4 ]")
	Tn("a value that is in the first row only", Does("o4.FindLastValueInRows([ 1, 2 ], 'x')"), "[ 1, 1 ]")
	Tn("a value that is in no given row", Does("o.FindLastValueInRows([ 1, 2 ], 9)"), "[ ]")
	Tn("a list cell is a value, as it stands", Does("LT().FindLastValueInRows([ 1, 2 ], [ 5, 6 ])"), "[ 2, 2 ]")
	Tn("a row that does not exist raises", Does("o4.FindLastValueInRows([ 9 ], 'x')"), "RAISES")
	Tn("FindLastSubValueInRows", Does("o4.FindLastSubValueInRows([ 1, 4 ], 'y')"), "[ [ 2, 4 ], 1 ]")
	Tn("the last cell that holds the text, not the first", Does("ow.FindLastSubValueInRows([ 1, 3 ], 'li')"), "[ [ 2, 3 ], 2 ]")
	Tn("one row, two places in the cell", Does("ow.FindLastSubValueInRows([ 2 ], 'a')"), "[ [ 2, 2 ], 6 ]")
	Tn("a text that is in no given row", Does("ow.FindLastSubValueInRows([ 1 ], 'li')"), "[ ]")
EndScenario()

Scenario("One column: the first and the last cell, and the count")
	Given("the four tables")
	Tn("FindFirstValueInCol", Does("o4.FindFirstValueInCol(:a, 'x')"), "[ 1, 1 ]")
	Tn("in the other column", Does("o4.FindFirstValueInCol(:b, 'y')"), "[ 2, 1 ]")
	Tn("the column by its position", Does("o4.FindFirstValueInCol(2, 'y')"), "[ 2, 1 ]")
	Tn("a value that is in the other column", Does("o4.FindFirstValueInCol(:a, 'y')"), "[ ]")
	Tn("a number", Does("o.FindFirstValueInCol(:c, 6)"), "[ 3, 2 ]")
	Tn("texts that contain the text: the whole value only", Does("ow.FindFirstValueInCol(:job, 'Ali')"), "[ 2, 3 ]")
	Tn("a list cell is a value, as it stands", Does("LT().FindFirstValueInCol(:b, [ 5, 6 ])"), "[ 2, 2 ]")
	Tn("a column that does not exist raises", Does("o4.FindFirstValueInCol(:zz, 'x')"), "RAISES")
	Tn("FindFirstSubValueInCol", Does("ow.FindFirstSubValueInCol(:name, 'li')"), "[ [ 1, 2 ], 2 ]")
	Tn("on the 4 x 2 table", Does("o4.FindFirstSubValueInCol(:a, 'x')"), "[ [ 1, 1 ], 1 ]")
	Tn("a text that is in the other column", Does("o4.FindFirstSubValueInCol(:a, 'q')"), "[ ]")
	Tn("the case counts", Does("ow.FindFirstSubValueInCol(:name, 'LI')"), "[ ]")
	Tn("FindLastValueInCol", Does("o4.FindLastValueInCol(:a, 'x')"), "[ 1, 3 ]")
	Tn("a value that repeats in the other column", Does("o4.FindLastValueInCol(:b, 'y')"), "[ 2, 4 ]")
	Tn("a number", Does("o.FindLastValueInCol(:a, 4)"), "[ 1, 2 ]")
	Tn("a number that is in another column", Does("o.FindLastValueInCol(:a, 5)"), "[ ]")
	Tn("a list cell is a value, as it stands", Does("LT().FindLastValueInCol(:b, [ 5, 6 ])"), "[ 2, 2 ]")
	Tn("a column that does not exist raises", Does("o4.FindLastValueInCol(:zz, 'x')"), "RAISES")
	Tn("FindLastSubValueInCol gives the last place", Does("ow.FindLastSubValueInCol(:name, 'li')"), "[ [ 1, 3 ], 2 ]")
	Tn("on the 4 x 2 table", Does("o4.FindLastSubValueInCol(:b, 'y')"), "[ [ 2, 4 ], 1 ]")
	Tn("a text that is in no cell of the column", Does("ow.FindLastSubValueInCol(:job, 'zz')"), "[ ]")
	Tn("NumberOfOccurrenceOfCellInCol", Does("o4.NumberOfOccurrenceOfCellInCol(:a, 'x')"), "2")
	Tn("the other column", Does("o4.NumberOfOccurrenceOfCellInCol(:b, 'y')"), "2")
	Tn("a value that is in the other column only", Does("o4.NumberOfOccurrenceOfCellInCol(:b, 'x')"), "0")
	Tn("the column by its position", Does("o4.NumberOfOccurrenceOfCellInCol(1, 'x')"), "2")
	Tn("a number", Does("o.NumberOfOccurrenceOfCellInCol(:a, 4)"), "1")
	Tn("a cell that only starts with the value is not counted", Does("ow.NumberOfOccurrenceOfCellInCol(:name, 'Ali')"), "1")
	Tn("a list cell", Does("LT().NumberOfOccurrenceOfCellInCol(:b, [ 5, 6 ])"), "1")
	Tn("a column that does not exist raises", Does("o4.NumberOfOccurrenceOfCellInCol(:zz, 'x')"), "RAISES")
EndScenario()

Scenario("Several columns: the nth, the first and the last cell, and the count")
	Given("the four tables; the columns are read in the order given")
	Tn("FindNthInCols: the first y", Does("o4.FindNthInCols(1, [ :a, :b ], 'y')"), "[ 2, 1 ]")
	Tn("the second y", Does("o4.FindNthInCols(2, [ :a, :b ], 'y')"), "[ 2, 4 ]")
	Tn("the third y does not exist", Does("o4.FindNthInCols(3, [ :a, :b ], 'y')"), "[ ]")
	Tn("a column that has none", Does("o4.FindNthInCols(1, [ :a ], 'y')"), "[ ]")
	Tn("names and positions alike", Does("ow.FindNthInCols(2, [ :name, 2 ], 'Ali')"), "[ 2, 3 ]")
	Tn("a number", Does("o.FindNthInCols(1, [ :a, :b ], 5)"), "[ 2, 2 ]")
	Tn("a text inside the cells", Does("o4.FindNthInCols(1, [ :a, :b ], [ :SubValue, 'y' ])"), "[ [ 2, 1 ], 1 ]")
	Tn("a list cell, wrapped", Does("LT().FindNthInCols(1, [ :a, :b ], [ :Cell, [ 5, 6 ] ])"), "[ 2, 2 ]")
	Tn("FindFirstInCols", Does("o4.FindFirstInCols([ :a, :b ], 'y')"), "[ 2, 1 ]")
	Tn("the columns are read in the order given", Does("ow.FindFirstInCols([ :job, :name ], 'Ali')"), "[ 2, 3 ]")
	Tn("and in the other order", Does("ow.FindFirstInCols([ :name, :job ], 'Ali')"), "[ 1, 2 ]")
	Tn("a value that only the first given column has", Does("o4.FindFirstInCols([ :b, :a ], 'x')"), "[ 1, 1 ]")
	Tn("a value that is in no given column", Does("o4.FindFirstInCols([ :b ], 'x')"), "[ ]")
	Tn("a number", Does("o.FindFirstInCols([ :a, :c ], 9)"), "[ 3, 3 ]")
	Tn("a text inside the cells", Does("o4.FindFirstInCols([ :a, :b ], [ :SubValue, 'y' ])"), "[ [ 2, 1 ], 1 ]")
	Tn("a list cell", Does("LT().FindFirstInCols([ :a, :b ], [ :Cell, [ 5, 6 ] ])"), "[ 2, 2 ]")
	Tn("FindFirstValueInCols", Does("o4.FindFirstValueInCols([ :a, :b ], 'y')"), "[ 2, 1 ]")
	Tn("columns given by position", Does("o4.FindFirstValueInCols([ 2, 1 ], 'y')"), "[ 2, 1 ]")
	Tn("the columns are read in the order given", Does("ow.FindFirstValueInCols([ :job, :name ], 'Ali')"), "[ 2, 3 ]")
	Tn("a value that is in no given column", Does("o4.FindFirstValueInCols([ :b ], 'x')"), "[ ]")
	Tn("texts that contain the text: the whole value only", Does("ow.FindFirstValueInCols([ 1, 2 ], 'Ali')"), "[ 1, 2 ]")
	Tn("a list cell is a value, as it stands", Does("LT().FindFirstValueInCols([ :a, :b ], [ 5, 6 ])"), "[ 2, 2 ]")
	Tn("FindFirstSubValueInCols", Does("o4.FindFirstSubValueInCols([ :a, :b ], 'y')"), "[ [ 2, 1 ], 1 ]")
	Tn("texts that contain the text", Does("ow.FindFirstSubValueInCols([ 1, 2 ], 'Ali')"), "[ [ 1, 2 ], 1 ]")
	Tn("the columns are read in the order given", Does("ow.FindFirstSubValueInCols([ :job, :name ], 'Ali')"), "[ [ 2, 3 ], 1 ]")
	Tn("a text that is in no given column", Does("o4.FindFirstSubValueInCols([ :a ], 'y')"), "[ ]")
	Tn("FindLastInCols", Does("o4.FindLastInCols([ :a, :b ], 'y')"), "[ 2, 4 ]")
	Tn("the columns are read in the order given: the last is then in the first column", Does("ow.FindLastInCols([ :job, :name ], 'Ali')"), "[ 1, 2 ]")
	Tn("and in the other order", Does("ow.FindLastInCols([ :name, :job ], 'Ali')"), "[ 2, 3 ]")
	Tn("a value that is in no given column", Does("o4.FindLastInCols([ :b ], 'x')"), "[ ]")
	Tn("a number", Does("o.FindLastInCols([ :a, :b ], 5)"), "[ 2, 2 ]")
	Tn("a text inside the cells", Does("o4.FindLastInCols([ :a, :b ], [ :SubValue, 'y' ])"), "[ [ 2, 4 ], 1 ]")
	Tn("a list cell, wrapped", Does("LT().FindLastInCols([ :a, :b ], [ :Cell, [ 5, 6 ] ])"), "[ 2, 2 ]")
	Tn("FindLastValueInCols", Does("o4.FindLastValueInCols([ :a, :b ], 'y')"), "[ 2, 4 ]")
	Tn("a value that repeats in one column", Does("o4.FindLastValueInCols([ :b, :a ], 'x')"), "[ 1, 3 ]")
	Tn("the columns are read in the order given", Does("ow.FindLastValueInCols([ :job, :name ], 'Ali')"), "[ 1, 2 ]")
	Tn("a value that is in no given column", Does("o4.FindLastValueInCols([ :b ], 'x')"), "[ ]")
	Tn("a list cell is a value, as it stands", Does("LT().FindLastValueInCols([ :a, :b ], [ 5, 6 ])"), "[ 2, 2 ]")
	Tn("FindLastSubValueInCols", Does("o4.FindLastSubValueInCols([ :a, :b ], 'y')"), "[ [ 2, 4 ], 1 ]")
	Tn("the last place of a text", Does("ow.FindLastSubValueInCols([ 1, 2 ], 'Ali')"), "[ [ 2, 3 ], 1 ]")
	Tn("the columns are read in the order given", Does("ow.FindLastSubValueInCols([ :job, :name ], 'Ali')"), "[ [ 1, 3 ], 1 ]")
	Tn("a text that is in no given column", Does("o4.FindLastSubValueInCols([ :a ], 'y')"), "[ ]")
	Tn("the case counts", Does("o4.FindLastSubValueInCols([ :a, :b ], 'Y')"), "[ ]")
	Tn("NumberOfOccurrenceOfCellInCols", Does("o4.NumberOfOccurrenceOfCellInCols([ :a, :b ], 'y')"), "2")
	Tn("a value in both columns", Does("o4.NumberOfOccurrenceOfCellInCols([ :a, :b ], 'x')"), "2")
	Tn("a column without the value adds nothing", Does("o4.NumberOfOccurrenceOfCellInCols([ :b ], 'x')"), "0")
	Tn("columns by position", Does("ow.NumberOfOccurrenceOfCellInCols([ 1, 2 ], 'Ali')"), "2")
	Tn("a number", Does("o.NumberOfOccurrenceOfCellInCols([ :a, :b ], 5)"), "1")
	Tn("a list cell", Does("LT().NumberOfOccurrenceOfCellInCols([ :a, :b ], [ 5, 6 ])"), "1")
	Tn("a column that does not exist raises", Does("o4.NumberOfOccurrenceOfCellInCols([ :a, :zz ], 'x')"), "RAISES")
EndScenario()

Scenario("A section: counting the cells")
	Given("the four tables; a section is two [ column, row ] corners")
	Tn("the whole 3 x 3 table", Does("o.NumberOfOccurrenceOfCellInSection([ 1, 1 ], [ 3, 3 ], 5)"), "1")
	Tn("the lower right block", Does("o.NumberOfOccurrenceOfCellInSection([ 2, 2 ], [ 3, 3 ], 5)"), "1")
	Tn("a value the block leaves out", Does("o.NumberOfOccurrenceOfCellInSection([ 2, 2 ], [ 3, 3 ], 1)"), "0")
	Tn("a column of the block only", Does("o.NumberOfOccurrenceOfCellInSection([ 1, 1 ], [ 1, 3 ], 5)"), "0")
	Tn("the whole 4 x 2 table", Does("o4.NumberOfOccurrenceOfCellInSection([ 1, 1 ], [ 2, 4 ], 'y')"), "2")
	Tn("one column of it", Does("o4.NumberOfOccurrenceOfCellInSection([ 1, 1 ], [ 1, 4 ], 'y')"), "0")
	Tn("the two middle rows", Does("o4.NumberOfOccurrenceOfCellInSection([ 1, 2 ], [ 2, 3 ], 'q')"), "1")
	Tn("a value that repeats", Does("o4.NumberOfOccurrenceOfCellInSection([ 1, 1 ], [ 1, 4 ], 'x')"), "2")
	Tn("the case counts", Does("o4.NumberOfOccurrenceOfCellInSection([ 1, 1 ], [ 2, 4 ], 'Y')"), "0")
	Tn("the cell that only starts with the value is not counted", Does("ow.NumberOfOccurrenceOfCellInSection([ 1, 1 ], [ 2, 3 ], 'Ali')"), "2")
	Tn("the same, with a case that differs", Does("ow.NumberOfOccurrenceOfCellInSection([ 1, 1 ], [ 2, 3 ], 'ali')"), "0")
	Tn("a list cell", Does("LT().NumberOfOccurrenceOfCellInSection([ 1, 1 ], [ 3, 3 ], [ 5, 6 ])"), "1")
	Tn("a list cell left out of the section", Does("LT().NumberOfOccurrenceOfCellInSection([ 1, 1 ], [ 1, 3 ], [ 5, 6 ])"), "0")
	Tn("a section that leaves the table raises", Does("o4.NumberOfOccurrenceOfCellInSection([ 1, 1 ], [ 3, 9 ], 'y')"), "RAISES")
EndScenario()

Summary()

func LT()
	return new stzTable([ [ :A, :B, :C ], [ 1, 2, 3 ], [ 4, [ 5, 6 ], 6 ], [ 7, 8, 9 ] ])
