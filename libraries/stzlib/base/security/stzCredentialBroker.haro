# stzCredentialBroker -- an agent names a credential; the engine attaches it
# (RADAR-OPENSHELL-CREDBROKER-01, the runtime half of PRINCIPAL-SECRETNAME-01).
#
# The value is read by the engine from where it is held (an environment variable
# or a file) into locked pages, and is attached only to a request bound for the
# host its grant names. No function here or in the engine answers the value, and
# the engine masks it out of the response body and headers before they come back,
# so neither the agent's code nor the model it talks to ever holds it.
#
#   StzBrokerGrant("github", "env:GITHUB_TOKEN", "api.github.com", "Authorization", "Bearer ")
#   StzBrokerGrantFromStore(oStore, "stripe", "api.stripe.com", "Authorization", "Bearer ")
#   StzBrokerSeal()          # after this, no grant can be added in this process
#   xR = StzBrokerRequest("github", "GET", "https://api.github.com/user", "", "")
#   ? xR[:status]            # the HTTP status, or -3 for a refusal
#   ? xR[:refusal]           # why, when refused; nothing was sent
#
# The governance grants at start and seals before any agent runs. A grant binds
# one credential to one host and one header; https only (plain http only to
# 127.0.0.1); redirects are not followed; the caller's own headers may not name
# the granted header. Engine side: engine/src/cred_broker.zig.

func StzBrokerMethodCode(tMethod)
    tM = Upper("" + tMethod)
    vNames = ["GET", "POST", "PUT", "DELETE", "HEAD", "OPTIONS", "PATCH"]
    nN = Len(vNames)
    for i = 1 to nN
        if vNames[i] = tM
            return i - 1
        end
    end
    StzRaise("stzCredentialBroker: no HTTP method named '" + tMethod + "'.")
end

# Grants a credential read from tSource ("env:NAME" or "file:PATH") for requests to
# tHost, sent as "tHeader: tPrefix<value>". Raises with the engine's reason when
# refused -- a sealed broker, a malformed field, a source that names nothing.
func StzBrokerGrant(tName, tSource, tHost, tHeader, tPrefix)
    nR = StzEngineHttpBrokerGrant("" + tName, "" + tSource, "" + tHost, "" + tHeader, "" + tPrefix)
    if nR != 1
        StzRaise("stzCredentialBroker: grant '" + tName + "' refused: " + StzEngineHttpBrokerLastError() + ".")
    end
    return 1
end

# The common case: an OAuth-style bearer token.
func StzBrokerGrantBearer(tName, tSource, tHost)
    return StzBrokerGrant(tName, tSource, tHost, "Authorization", "Bearer ")
end

# Grants a secret registered in a stzSecretStore by its NAME. Only a secret sourced
# from the environment or a file can be brokered: the engine reads it from there,
# so the store never reveals it. A literal or vault secret is refused, named.
func StzBrokerGrantFromStore(oStore, tSecretName, tHost, tHeader, tPrefix)
    oS = oStore.Secret(tSecretName)
    if not IsObject(oS)
        StzRaise("stzCredentialBroker: the store holds no secret named '" + tSecretName + "'.")
    end
    tKind = Lower("" + oS.SourceKind())
    if tKind != "env" and tKind != "file"
        StzRaise("stzCredentialBroker: secret '" + tSecretName + "' is sourced from " + tKind + "; only an env or a file secret can be brokered.")
    end
    return StzBrokerGrant(tSecretName, tKind + ":" + oS.SourceLocator(), tHost, tHeader, tPrefix)
end

func StzBrokerSeal
    return StzEngineHttpBrokerSeal()
end

func StzBrokerIsSealed
    return StzEngineHttpBrokerIsSealed() = 1
end

# Revokes a grant and wipes its value; allowed after the seal (it only narrows).
func StzBrokerRevoke(tName)
    return StzEngineHttpBrokerRevoke("" + tName) = 1
end

func StzBrokerCount
    return StzEngineHttpBrokerCount()
end

# Every grant as [name, host, header, times attached, times refused]; never a value.
func StzBrokerGrants
    vOut = []
    vLines = Str2List(StzEngineHttpBrokerDescribe())
    nL = Len(vLines)
    for i = 1 to nL
        if vLines[i] != ""
            vF = StzSplit(vLines[i], Char(9))
            if Len(vF) = 5
                vOut + [vF[1], vF[2], vF[3], Number(vF[4]), Number(vF[5])]
            end
        end
    end
    return vOut
end

# Sends a request with a granted credential attached by the engine. Answers
# [[:status, n], [:body, text], [:headers, text], [:refusal, text]]: the status is
# -3 and :refusal says why when the broker refused (nothing was sent then).
func StzBrokerRequest(tGrant, tMethod, tUrl, tHeaders, tBody)
    tCt = ""
    if tBody != ""
        tCt = "application/json"
    end
    return StzBrokerRequestXT(tGrant, tMethod, tUrl, tHeaders, tCt, tBody, 10000, 30000)
end

func StzBrokerRequestXT(tGrant, tMethod, tUrl, tHeaders, tContentType, tBody, nConnectMs, nRequestMs)
    tB = StzEngineHttpRequestBrokered("" + tGrant, StzBrokerMethodCode(tMethod), "" + tUrl, "" + tHeaders, "" + tContentType, "" + tBody, nConnectMs, nRequestMs)
    nS = StzEngineHttpLastStatus()
    tWhy = ""
    tH = ""
    if nS = -3
        tWhy = StzEngineHttpBrokerLastError()
    elseif nS < 0
        tWhy = "transport: " + StzEngineHttpLastError()
    else
        tH = StzEngineHttpLastHeaders()
    end
    return [[:status, nS], [:body, tB], [:headers, tH], [:refusal, tWhy]]
end
