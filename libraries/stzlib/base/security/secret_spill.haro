# secret_spill.haro -- a secret typed where it should be named (LOOKOUT-W45-SECRETS-02).
#
# PRINCIPAL-SECRETNAME-01 (2026-11-08): a password, token or key appears only as a
# reference to where it is held -- $NAME, ${NAME}, %NAME%, $env:NAME, or a file read at
# run time -- never as its value, in a command, a script, a settings allow-list, a memo,
# a mailbox or a handoff note. Key-format scanners miss a typed password: it has no
# format. This tool reads the files it is given and names every place a secret is typed.
#
#   run:      haro secret_spill.haro [--allow-skip] <file or folder> ...  (folders walked)
#             haro secret_spill.haro --selftest
#   prints:   SPILL <file>:<line> <shape> (<n> chars) -- never the value
#             then: files read N, lines read N, spills N
#             SKIP <path> (why) for every path it was given and could not read
#   exits:    the number of spills (253 at most), so a gate reads its code; 254 when a
#             given path was skipped, unless --allow-skip (SECRETNAME-GATEEXT-01)
#
# The shapes: a secret-named variable given a literal (PGPASSWORD=..., export TOKEN=...,
# $env:API_KEY = "...", "password": "..."); sshpass -p; mysql -p... and --password=;
# --token / --api-key / --secret flags; an Authorization Bearer header; credentials in a
# URL (scheme://user:pass@host). A value that is a reference, or a placeholder (<...>,
# ***, xxxx, changeme, your_...), is not a spill.

func main
    if Len(sysargv) >= 3 and sysargv[3] = "--selftest"
        Shutdown(SelfTest())
    end
    bAllowSkip = false
    vPaths = []
    nArgs = Len(sysargv)
    for i = 3 to nArgs
        if sysargv[i] = "--allow-skip"
            bAllowSkip = true
        else
            vPaths + sysargv[i]
        end
    end
    if Len(vPaths) = 0
        FWrite(stdout, "usage: haro secret_spill.haro [--allow-skip] <file or folder> ... | --selftest" + Char(10))
        Shutdown(2)
    end
    # [files read, lines read, spills, given paths skipped, binary files skipped inside folders]
    vCount = [0, 0, 0, 0, 0]
    nP = Len(vPaths)
    for i = 1 to nP
        vCount = Walk(vPaths[i], vCount, true)
    end
    FWrite(stdout, "files read " + String(vCount[1]) + ", lines read " + String(vCount[2]) + ", spills " + String(vCount[3]) + ", given paths skipped " + String(vCount[4]) + ", binary files skipped in folders " + String(vCount[5]) + Char(10))
    Shutdown(ExitCode(vCount, bAllowSkip))
end

# the spill count, at most 253; 254 when a path the caller named was not read and the
# caller did not say --allow-skip -- a gate that read less than it was given never passes
func ExitCode(vCount, bAllowSkip)
    if vCount[4] > 0 and not bAllowSkip
        return 254
    end
    if vCount[3] > 253
        return 253
    end
    return vCount[3]
end

# reads a file, or every file under a folder; aCount is the five counts of main.
# bGiven: the caller named this path. A given path that is not read is printed SKIP and
# counted; a binary file met inside a folder is counted only (a repository holds many).
func Walk(tPath, vCount, bGiven)
    if DirExists(tPath)
        vIn = Dir(tPath)
        nIn = Len(vIn)
        for i = 1 to nIn
            # worktrees are whole copies of a repository: name the repository itself instead
            if vIn[i][1] != ".git" and vIn[i][1] != "node_modules" and vIn[i][1] != ".zig-cache" and vIn[i][1] != "zig-out" and vIn[i][1] != "worktrees"
                vCount = Walk(tPath + "/" + vIn[i][1], vCount, false)
            end
        end
        return vCount
    end
    if not FExists(tPath)
        FWrite(stdout, "SKIP " + tPath + " (no such file)" + Char(10))
        vCount[4] = vCount[4] + 1
        return vCount
    end
    vText = TextOf(Read(tPath))
    if not vText[1]
        if bGiven
            FWrite(stdout, "SKIP " + tPath + " (binary: a NUL byte in its first 8000 bytes)" + Char(10))
            vCount[4] = vCount[4] + 1
        else
            vCount[5] = vCount[5] + 1
        end
        return vCount
    end
    vLines = Str2List(vText[2])
    vCount[1] = vCount[1] + 1
    nL = Len(vLines)
    for i = 1 to nL
        vCount[2] = vCount[2] + 1
        vHits = SpillsIn(vLines[i])
        nH = Len(vHits)
        for h = 1 to nH
            FWrite(stdout, "SPILL " + tPath + ":" + String(i) + " " + vHits[h][1] + " (" + String(vHits[h][2]) + " chars)" + Char(10))
            vCount[3] = vCount[3] + 1
        end
    end
    return vCount
end

# a file is text by its content, never its name (SECRETNAME-GATEEXT-01): .pem, .netrc,
# .npmrc, .tfvars, .html, .sql, .ipynb and a name with no extension are all read.
# Binary = a NUL byte in the first 8000 bytes, as git judges it. UTF-16 (a BOM, as
# Windows tools write .reg and redirected PowerShell output) is read with its NULs
# dropped, which recovers every ASCII secret shape. Answers [bText, tText].
func TextOf(tData)
    if Len(tData) >= 2
        nA = Ascii(Left(tData, 1))
        nB = Ascii(SubStr(tData, 2, 1))
        if (nA = 255 and nB = 254) or (nA = 254 and nB = 255)
            return [true, SubStr(SubStr(tData, 3, Len(tData) - 2), Char(0), "")]
        end
    end
    if SubStr(Left(tData, 8000), Char(0)) > 0
        return [false, ""]
    end
    return [true, tData]
end

# every spill on one line: [ [shape, value length], ... ]
func SpillsIn(tLine)
    vHits = []
    tLow = Lower(tLine)
    vHits = NamedSecrets(tLine, tLow, vHits)
    vHits = AfterWord(tLine, tLow, "sshpass -p", "sshpass -p", vHits)
    vHits = AfterWord(tLine, tLow, "--password=", "--password=", vHits)
    vHits = AfterWord(tLine, tLow, "--password ", "--password flag", vHits)
    vHits = AfterWord(tLine, tLow, "--token=", "--token=", vHits)
    vHits = AfterWord(tLine, tLow, "--token ", "--token flag", vHits)
    vHits = AfterWord(tLine, tLow, "--api-key=", "--api-key=", vHits)
    vHits = AfterWord(tLine, tLow, "--api-key ", "--api-key flag", vHits)
    vHits = AfterWord(tLine, tLow, "--secret ", "--secret flag", vHits)
    vHits = AfterWord(tLine, tLow, "bearer ", "Bearer header", vHits)
    vHits = MysqlP(tLine, tLow, vHits)
    vHits = UrlCredentials(tLine, tLow, vHits)
    return vHits
end

# NAME=value or NAME: "value" where NAME carries a secret word
func NamedSecrets(tLine, tLow, vHits)
    vWords = ["password", "passwd", "token", "secret", "api_key", "apikey", "access_key", "private_key"]
    # a name reported once, however many of its words it carries (PGPASSWORD, CLIENT_SECRET_TOKEN)
    vSeen = []
    nW = Len(vWords)
    nLen = Len(tLow)
    for w = 1 to nW
        nFrom = 1
        while nFrom <= nLen
            nAt = FindFrom(tLow, vWords[w], nFrom)
            if nAt = 0
                exit
            end
            nFrom = nAt + Len(vWords[w])
            # the whole name around the word
            nS = nAt
            while nS > 1 and IsNameChar(tLow[nS - 1])
                nS = nS - 1
            end
            nE = nAt + Len(vWords[w])
            while nE <= nLen and IsNameChar(tLow[nE])
                nE = nE + 1
            end
            # an assignment follows: optional quote, spaces, then = or :
            nP = nE
            if nP <= nLen and (tLow[nP] = Char(34) or tLow[nP] = "'")
                nP = nP + 1
            end
            nGap = nP
            while nP <= nLen and tLow[nP] = " "
                nP = nP + 1
            end
            bSpaced = nP > nGap
            if nP > nLen
                loop
            end
            bColon = tLow[nP] = ":"
            if tLow[nP] != "=" and not bColon
                loop
            end
            if nP < nLen and tLow[nP + 1] = "="
                loop
            end
            tVal = ValueAt(tLine, nP + 1)
            # a colon, or an = with a space before it, counts only before a QUOTED value
            # ("password": "x", $env:TOKEN = "x"); prose ("the pad token = added token") does not quote
            if (bColon or bSpaced) and not QuotedAt(tLine, nP + 1)
                loop
            end
            # the secret word ENDS the name (pgpassword, github_token, api_key), so
            # max_tokens, tokenizer and image_token_id are not secrets; publickeytoken
            # is a public .NET identifier
            tName = SubStr(tLow, nS, nE - nS)
            if nE != nAt + Len(vWords[w]) or tName = "publickeytoken"
                nFrom = nE
                loop
            end
            if IsSpill(tVal) and Find(vSeen, nS) = 0
                vSeen + nS
                vHits + ["secret-named value " + Lower(SubStr(tLine, nS, nE - nS)), Len(tVal)]
            end
            nFrom = nE
        end
    end
    return vHits
end

# the value right after a word such as "sshpass -p"
func AfterWord(tLine, tLow, tWord, tShape, vHits)
    nFrom = 1
    nLen = Len(tLow)
    while nFrom <= nLen
        nAt = FindFrom(tLow, tWord, nFrom)
        if nAt = 0
            exit
        end
        nFrom = nAt + Len(tWord)
        tVal = ValueAt(tLine, nAt + Len(tWord))
        if tShape = "Bearer header" and Len(tVal) < 16
            loop
        end
        if IsSpill(tVal)
            vHits + [tShape, Len(tVal)]
        end
    end
    return vHits
end

# mysql -pVALUE (attached, no space) on a line that runs mysql or mariadb
func MysqlP(tLine, tLow, vHits)
    if FindFrom(tLow, "mysql", 1) = 0 and FindFrom(tLow, "mariadb", 1) = 0
        return vHits
    end
    nFrom = 1
    nLen = Len(tLow)
    while nFrom < nLen
        nAt = FindFrom(tLow, " -p", nFrom)
        if nAt = 0
            exit
        end
        nFrom = nAt + 3
        if nAt + 3 <= nLen and tLow[nAt + 3] != " "
            tVal = ValueAt(tLine, nAt + 3)
            if IsSpill(tVal)
                vHits + ["mysql -p", Len(tVal)]
            end
        end
    end
    return vHits
end

# scheme://user:password@host
func UrlCredentials(tLine, tLow, vHits)
    nFrom = 1
    nLen = Len(tLow)
    while nFrom <= nLen
        nAt = FindFrom(tLow, "://", nFrom)
        if nAt = 0
            exit
        end
        nFrom = nAt + 3
        nP = nAt + 3
        nColon = 0
        while nP <= nLen and not IsStop(tLow[nP]) and tLow[nP] != "/" and tLow[nP] != "@"
            if tLow[nP] = ":" and nColon = 0
                nColon = nP
            end
            nP = nP + 1
        end
        if nColon > 0 and nP <= nLen and tLow[nP] = "@"
            tVal = SubStr(tLine, nColon + 1, nP - nColon - 1)
            if IsSpill(tVal)
                vHits + ["credentials in a URL", Len(tVal)]
            end
        end
    end
    return vHits
end

# the value starting at nAt: a quoted text, or a run up to a space, quote or separator
func ValueAt(tLine, nAt)
    nLen = Len(tLine)
    nP = nAt
    while nP <= nLen and tLine[nP] = " "
        nP = nP + 1
    end
    if nP > nLen
        return ""
    end
    tQ = tLine[nP]
    if tQ = Char(34) or tQ = "'"
        nE = nP + 1
        while nE <= nLen and tLine[nE] != tQ
            # an escaped quote inside JSON text
            if tLine[nE] = Char(92)
                nE = nE + 1
            end
            nE = nE + 1
        end
        return SubStr(tLine, nP + 1, nE - nP - 1)
    end
    nE = nP
    while nE <= nLen and not IsStop(tLine[nE])
        nE = nE + 1
    end
    return SubStr(tLine, nP, nE - nP)
end

func QuotedAt(tLine, nAt)
    nLen = Len(tLine)
    nP = nAt
    while nP <= nLen and tLine[nP] = " "
        nP = nP + 1
    end
    return nP <= nLen and (tLine[nP] = Char(34) or tLine[nP] = "'")
end

# a value is a spill when it is a literal: not empty, not a reference, not a placeholder
func IsSpill(tVal)
    tV = Lower(Trim(tVal))
    if Len(tV) < 4
        return false
    end
    # a number is a count or a limit, not a secret (max tokens, --token 512)
    bDigits = true
    nV = Len(tV)
    for i = 1 to nV
        if not (IsDigit(tV[i]) or tV[i] = "." or tV[i] = "-" or tV[i] = "_")
            bDigits = false
            exit
        end
    end
    if bDigits
        return false
    end
    # a help text's metavariable is written in capitals (--token TEXT, --password PASSWORD);
    # a real token is mixed case, lowercase or hex
    bCaps = true
    tRaw = Trim(tVal)
    nR = Len(tRaw)
    for i = 1 to nR
        if not ((Ascii(tRaw[i]) >= 65 and Ascii(tRaw[i]) <= 90) or tRaw[i] = "_" or tRaw[i] = "-")
            bCaps = false
            exit
        end
    end
    if bCaps
        return false
    end
    if Left(tV, 1) = "$" or Left(tV, 1) = "%" or Left(tV, 1) = "@" or Left(tV, 1) = "<" or Left(tV, 1) = "{" or Left(tV, 1) = "("
        return false
    end
    # a JSON-escaped quote opening an inner reference: \"$NAME\"
    if Left(tV, 2) = Char(92) + Char(34) and Len(tV) > 2 and (tV[3] = "$" or tV[3] = "%")
        return false
    end
    vHolders = ["***", "xxxx", "....", "changeme", "your_", "your-", "<redacted>", "redacted", "placeholder", "example", "dummy", "secret_value", "password_here", "none", "null", "true", "false", "env:", "process.env", "os.environ", "getenv", "sysget"]
    nH = Len(vHolders)
    for i = 1 to nH
        if FindFrom(tV, vHolders[i], 1) > 0
            return false
        end
    end
    return true
end

func IsNameChar(tC)
    return IsAlnum(tC) or tC = "_" or tC = "-"
end

func IsStop(tC)
    return tC = " " or tC = Char(9) or tC = Char(34) or tC = "'" or tC = ";" or tC = "&" or tC = "|" or tC = "," or tC = ")" or tC = "}" or tC = "]" or tC = Char(92) or tC = "`"
end

func FindFrom(tText, tWord, nFrom)
    if nFrom > Len(tText)
        return 0
    end
    if nFrom = 1
        return SubStr(tText, tWord)
    end
    nAt = SubStr(SubStr(tText, nFrom, Len(tText) - nFrom + 1), tWord)
    if nAt = 0
        return 0
    end
    return nAt + nFrom - 1
end

# planted lines that must spill, and their clean siblings that must not
func SelfTest
    vPlanted = [
        ["PGPASSWORD=hunter2pw psql -h db", 1],
        ["export GITHUB_TOKEN=ghp_abcdefghijklmnop", 1],
        ["$env:API_KEY = " + Char(34) + "sk-live-1234567890" + Char(34), 1],
        [Char(34) + "password" + Char(34) + ": " + Char(34) + "correct horse" + Char(34), 1],
        ["sshpass -p s3cr3tpass ssh root@host", 1],
        ["mysql -u root -ps3cr3tpass mydb", 1],
        ["curl -H " + Char(34) + "Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.payload" + Char(34) + " https://api", 1],
        ["git clone https://alice:pa55word@example.org/repo.git", 1],
        ["tool --token abcdef123456 --verbose", 1]
    ]
    vClean = [
        "PGPASSWORD=$PGPASSWORD psql -h db",
        "export GITHUB_TOKEN=${GITHUB_TOKEN}",
        "$env:API_KEY = $env:SECRET_FROM_VAULT",
        "set DB_PASSWORD=%DB_PASSWORD%",
        Char(34) + "password" + Char(34) + ": " + Char(34) + "<your password>" + Char(34),
        "sshpass -p $SSHPASS ssh host",
        "mysql -u root -p mydb",
        "the password: rotate it every 90 days",
        "git clone https://example.org/repo.git",
        "tool --token @token.txt",
        "a token bucket has a rate of 10 per second",
        "if tPassword == tStored return 1",
        "the pad token = added token, and a Number token = optional digits",
        "max_tokens=512 max_new_tokens=128 --token 2048",
        "image_token_id=151655 tokenizer=bpe",
        "Version=4.0.0.0, PublicKeyToken=b77a5c561934e089",
        "* `--token TEXT`: the access token; hf auth login --token TOKEN",
        "Authorization: Bearer $TOKEN"
    ]
    nBad = 0
    nP = Len(vPlanted)
    for i = 1 to nP
        nGot = Len(SpillsIn(vPlanted[i][1]))
        if nGot != vPlanted[i][2]
            FWrite(stdout, "SELFTEST planted line " + String(i) + ": " + String(nGot) + " spills, expected " + String(vPlanted[i][2]) + Char(10))
            nBad = nBad + 1
        end
    end
    nC = Len(vClean)
    for i = 1 to nC
        nGot = Len(SpillsIn(vClean[i]))
        if nGot != 0
            FWrite(stdout, "SELFTEST clean line " + String(i) + ": " + String(nGot) + " spills, expected 0" + Char(10))
            nBad = nBad + 1
        end
    end
    # what is read and how a skip ends (SECRETNAME-GATEEXT-01): content decides, a skip is never a pass
    vFiles = [
        ["text with no known extension is read", TextOf("machine x" + Char(10) + "password hunter2")[1], true],
        ["a NUL byte in the first block is binary", TextOf("PK" + Char(0) + Char(3) + "data")[1], false],
        ["a NUL after 8000 bytes is still text", TextOf(Copy("x", 8001) + Char(0))[1], true],
        ["UTF-16 is read with its NULs dropped", TextOf(Char(255) + Char(254) + "P" + Char(0) + "W" + Char(0))[2] = "PW", true],
        ["a given path skipped exits 254", ExitCode([1, 1, 0, 1, 0], false) = 254, true],
        ["--allow-skip exits with the spills", ExitCode([1, 1, 2, 1, 0], true) = 2, true],
        ["a binary file inside a folder does not fail the run", ExitCode([1, 1, 0, 0, 3], false) = 0, true]
    ]
    nF = Len(vFiles)
    for i = 1 to nF
        if vFiles[i][2] != vFiles[i][3]
            FWrite(stdout, "SELFTEST file case " + String(i) + ": " + vFiles[i][1] + Char(10))
            nBad = nBad + 1
        end
    end
    FWrite(stdout, "selftest: " + String(nP) + " planted, " + String(nC) + " clean, " + String(nF) + " file cases, " + String(nBad) + " wrong" + Char(10))
    return nBad
end
