# Two tiles staged per turn, sixteen products added from the group's memory, k / 16 turns.
k = StzKernelMakerQ()
k.TakesVector(:a)
k.TakesVector(:b)
k.TakesScalar(:k)
k.TakesScalar(:w)
k.ReturnsVector(:c)
k.Width(:w)
k.Shared(:ta, 256)
k.Shared(:tb, 256)
k.Tiles(:t, '{ k / 16 }')
k.Stage('{ @ta[@ly * 16 + @lx] = @a[@row * k + t * 16 + @lx] }')
k.Stage('{ @tb[@ly * 16 + @lx] = @b[(t * 16 + @ly) * w + @col] }')
k.Accumulate('{ @acc = @acc + sum(j, 0, 16, @ta[@ly * 16 + j] * @tb[j * 16 + @lx]) }')
k.ForEachElement('{ @c = @acc }')
? StzKernelPuzzleQ("kp-10").Grade(k)
