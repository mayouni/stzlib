# The count of starts strictly BEFORE an element, with the element's own start added back when the numbers are compared: the same segment number, written another way.
k = StzKernelMakerQ()
k.TakesVector(:a)
k.TakesVector(:b)
k.ReturnsVector(:c)
k.Shared(:t, 256)
k.Shared(:s, 256)
k.Shared(:r, 256)
k.Stage('{ @t[@l] = @a }')
k.Stage('{ @s[@l] = when(@b < 2, 1, 0) }')
k.Stage('{ @r[@l] = sum(j, 0, 256, when(j < @l, @s[j], 0)) }')
k.ForEachElement('{ @c = sum(j, 0, 256, when(j <= @l and @r[j] + @s[j] == @r[@l] + @s[@l], @t[j], 0)) }')
? StzKernelPuzzleQ("kp-23").Grade(k)
