# The rank that counts only the kept elements BEFORE each place (exclusive) is the slot the element goes to: slot l takes the kept element whose rank is l.
k = StzKernelMakerQ()
k.TakesVector(:a)
k.ReturnsVector(:c)
k.Shared(:t, 256)
k.Shared(:r, 256)
k.Stage('{ @t[@l] = @a }')
k.Stage('{ @r[@l] = sum(j, 0, 256, when(j < @l, when(@t[j] > 5, 1, 0), 0)) }')
k.ForEachElement('{ @c = sum(j, 0, 256, when(@t[j] > 5 and @r[j] == @l, @t[j], 0)) }')
? StzKernelPuzzleQ("kp-21").Grade(k)
