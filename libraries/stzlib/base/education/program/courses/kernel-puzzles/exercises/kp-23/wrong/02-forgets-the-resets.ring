# The plain running total of a group: it never starts over, so the first start it meets still carries the segment before it.
k = StzKernelMakerQ()
k.TakesVector(:a)
k.TakesVector(:b)
k.ReturnsVector(:c)
k.Shared(:t, 256)
k.Shared(:s, 256)
k.Shared(:r, 256)
k.Stage('{ @t[@l] = @a }')
k.Stage('{ @s[@l] = when(@b < 2, 1, 0) }')
k.ForEachElement('{ @c = sum(j, 0, 256, when(j <= @l, @t[j], 0)) }')
? StzKernelPuzzleQ("kp-23").Grade(k)
