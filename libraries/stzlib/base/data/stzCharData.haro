	# Diacritics

	func DiacriticsXT
		xResult = []

		xLatinDiacriticsXT2 = LatinDiacriticsXT()
		nLatinDiacriticsXT2Len = Len(xLatinDiacriticsXT2)
		for iLoopLatinDiacriticsXT2 = 1 to nLatinDiacriticsXT2Len
			xItem = xLatinDiacriticsXT2[iLoopLatinDiacriticsXT2]
			xResult + xItem
		end
		xArabicDiacriticsXT1 = ArabicDiacriticsXT()
		nArabicDiacriticsXT1Len = Len(xArabicDiacriticsXT1)
		for iLoopArabicDiacriticsXT1 = 1 to nArabicDiacriticsXT1Len
			xItem = xArabicDiacriticsXT1[iLoopArabicDiacriticsXT1]
			xResult + xItem
		end

		return xResult
	end
