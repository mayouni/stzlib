	  #-----------------#
	 #   PUNCTUATION   #
	#-----------------#

	#WARNING
	# The two unicode blocks GENERAL_PUNC and SUPPLEMENTAL_PUNCT
	# do not contain basic punctuations like ",",";", and so on.
	# Those are classified in the category "Other Punctuation". Listed here:
	# https://www.compart.com/en/unicode/category/Po

	#TODO
	# Add them to this list of unicodes herefater, otherwise the
	# use of Punctuations() function would lead the user to error...

	vOtherPunctuationUnicodes	= [] #TODO // Comptete it
	$viGeneralPunctuationUnicodes   = 8192  : 8303
	$viSupplementalPunctuationCodes = 11766 : 11903

	# Merging the three lists above
	$viPunctuationUnicodes = []
	nOtherPunctuationUnicoLen = Len(vOtherPunctuationUnicodes)
	for iLoop_anOtherPunctuationUnico1 = 1 to nOtherPunctuationUnicoLen
		xItem2 = vOtherPunctuationUnicodes[iLoop_anOtherPunctuationUnico1]
		$viPunctuationUnicodes + xItem2
	end

	nGeneralPunctuationUniLen = Len($viGeneralPunctuationUnicodes)
	for iLoop_anGeneralPunctuationUni1 = 1 to nGeneralPunctuationUniLen
		xItem2 = $viGeneralPunctuationUnicodes[iLoop_anGeneralPunctuationUni1]
		$viPunctuationUnicodes + xItem2
	end

	nSupplementalPunctuatiLen = Len($viSupplementalPunctuationCodes)
	for iLoop_anSupplementalPunctuati1 = 1 to nSupplementalPunctuatiLen
		xItem2 = $viSupplementalPunctuationCodes[iLoop_anSupplementalPunctuati1]
		$viPunctuationUnicodes + xItem2
	end

	  #-------------------#
	 #   ARABIC STAFF    #
	#-------------------#

	# Arabic Basmalah

	$tAllahAsChar = "ﷲ"
	$tAllahAsString = "اللَّه"

	$tBasmalahAsChar = "﷽"
	nBasmalahCharUnicode = 65021

	$tBasmalahAsString = "بِسْمِ اللَّهِ الرَّحْمَانِ الرَّحِيمِ"

	$tMuhammedAsChar = "ﷴ"
	$tMuhammedAsString = "مُحَمَّد"
	$tSalatAlaMuhammedAsChar = "ﷺ"
	tSalatAlaMuhammedAsString = "صَلَّى اللّهُ عَلَيْهِ وَ سَلَّمَ"

	# Arabic letters
	$vtArabicLetters   = ["أ", "ب", "ت", "ث", "ج", "ح", "خ", "د", "ذ", "ر", "ز", "س", "ش", "ص", "ض", "ط", "ظ", "ع", "غ", "ف", "ق", "ك", "ل", "م", "ن", "ه", "و", "ي"]
	$vtArabicLettersXT = [ "ا","أ","ئ","ء","آ","ب","ت","ة","ث","ج","ح","خ","د","ذ","ر","ز","س","ش","ص","ض","ط","ظ","ع","غ","ف","ق","ك","ل","م","ن","و","ه","ي", "ّ" ]

	# Arabic 7arakets

	$tArabicDhammah = "ُ"		nArabicDhammahUnicode = 1615
	$tArabicFat7ah = "َ"		nArabicFat7ahUnicode  = 1614
	$tArabicKasrah = "ِ"		nArabicKasrahUnicode  = 1616
	$tArabicSukoon = "ْ"		nArabicSukoonUnicode  = 1618
	$tArabicDoubleDhammah = "ُُ"
	$tArabicDoubleFat7ah = "ََ"
	$tArabicDoubleKasrah = "ِِ"

	
	$viArabic7araketUnicodes = [
		nArabicDhammahUnicode, nArabicFat7ahUnicode,
		nArabicKasrahUnicode, nArabicSukoonUnicode
	]

	# Arabic Shaddah

	$tArabicShaddah = "ّ"
	
	# Arabic Tamdeed

	$tArabicTamdeed = "ـ" # used to extend arabic words like in حُسَيْـــــن

	# Arabic Tinween

	viArabicTinweenUnicodes = 1611:1613

