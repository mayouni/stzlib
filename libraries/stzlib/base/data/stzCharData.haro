	func LanguagesInScript(tScript)	
		if not IsString(tScript)
			StzRaise("Incorrect param type! cScript must be a string")
		end

		vtUnicodeScriptsXT = UnicodeScriptsXT()
		nLen = Len(vtUnicodeScriptsXT)

		vtResult = []
		for i = 1 to nLen
			if vtUnicodeScriptsXT[i][2] = tScript
				oChain = new stzList(vtUnicodeScriptsXT[i][4])
				vtResult = oChain.Sorted()
				exit
			end
		end

		return vtResult
	end
	func CommonLanguagesInScripts(pxScripts)
		if not ( IsList(pxScripts) and @IsListOfStrings(pxScripts) )
			StzRaise("Incorrect param type! pacScripts must be a list of strings.")
		end

		nLen = Len(pxScripts)
		vListOfLists = []

		for i = 1 to nLen
			vListOfLists + LanguagesInScript(pxScripts[i])
		end

		vtResult = Common(vListOfLists)
		return vtResult
	end
	func ScriptsForLanguage(pxLang)
		return StzLanguageQ(pxLang).Scripts()
	end
	func CommonScriptsForLanguages(pxLangs)
		if not ( IsList(pxLangs) and @IsListOfStrings(pxLangs) )
			StzRaise("Incorrect param type! pacLangs must be a list of strings.")
		end

		nLen = Len(pxLangs)
		vtResult = []
		for i = 1 to nLen
			vtResult + StzLanguageQ(pxLangs[i]).Script()
		end
		return vtResult
	end
