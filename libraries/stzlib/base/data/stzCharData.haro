	#--

	func CardsXT
		return $xCardsXT
	end
	func Cards
	
		nLen = Len($xCardsXT)
	
		vtResult = []
	
		for i = 1 to nLen
			vtResult + $xCardsXT[i][2]
		end
	
		return vtResult
	end
	func Card(pxCard)
	
		if not IsString(pxCard)
			StzRaise("Incorrect param type!")
		end
	
		tResult = $xCardsXT[pxCard]
	
		if tResult = ""
			StzRaise("Incorrect param value!")
		end 
	
		return tResult
	end
	func TheseCards(vtCards)
		if not (IsList(vtCards) and IsListOfStrings(vtCards))
			StzRaise("Incorrect param type! acCards must be a list of strings.")
		end

		vtResult = []
		nLen = Len(vtCards)

		for i = 1 to nLen
			
			tCard = $xCardsXT[vtCards[i]]

			if tCard != ""
				vtResult + tCard
			end
		end

		return vtResult
	end
	func TheseCardsXT(vtCards)
		if not (IsList(vtCards) and IsListOfStrings(vtCards))
			StzRaise("Incorrect param type! acCards must be a list of strings.")
		end

		vtResult = []
		nLen = Len(vtCards)

		for i = 1 to nLen
			
			tCard = $xCardsXT[vtCards[i]]

			if tCard != ""
				vtResult + [ vtCards[i], tCard ]
			end
		end

		return vtResult
	end
	func NCards(xN)
		return NRandomItemsFrom(xN, Cards())
	end
		func NRandomCards(xN)
			return NCards(xN)
		end
