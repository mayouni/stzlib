	func DiacriticDescription(pxChar)
		if @IsChar(pxChar) and StzCharQ(pxChar).IsDiacritic()
			xDiacriticsXT1 = DiacriticsXT()
			nDiacriticsXT1Len = Len(xDiacriticsXT1)
			for iLoopDiacriticsXT1 = 1 to nDiacriticsXT1Len
				xItem = xDiacriticsXT1[iLoopDiacriticsXT1]
				if xItem[1] = pxChar
					return xItem[3]
				end
			end
		end
	end
	func DiacriticsOfAsciiLetter(pxChar)
		if StzCharQ(pxChar).IsAsciiLetter()
			xResult = []
			xLatinDiacriticsXT1 = LatinDiacriticsXT()
			nLatinDiacriticsXT1Len = Len(xLatinDiacriticsXT1)
			for iLoopLatinDiacriticsXT1 = 1 to nLatinDiacriticsXT1Len
				xItem = xLatinDiacriticsXT1[iLoopLatinDiacriticsXT1]
				if xItem[2] = pxChar
					xResult + xItem[1]
				end
			end

			return xResult
		end
	end
