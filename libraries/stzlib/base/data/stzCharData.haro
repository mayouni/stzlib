		$viArabicHamzahUnicodes + xItem2
	end
	nArabicHamzahWasliahUnLen = Len(xArabicHamzahWasliahUnicodes)
	for iLoop_anArabicHamzahWasliahUn1 = 1 to nArabicHamzahWasliahUnLen
		xItem2 = xArabicHamzahWasliahUnicodes[iLoop_anArabicHamzahWasliahUn1]
		$viArabicHamzahUnicodes + xItem2
	end

