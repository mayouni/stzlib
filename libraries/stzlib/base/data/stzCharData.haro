	func LatinLetters
		xLetters = "a":"z"
	
		xAZ1 = "A":"Z"
		nAZ1Len = Len(xAZ1)
		for iLoopAZ1 = 1 to nAZ1Len
			tChar = xAZ1[iLoopAZ1]
			xLetters + tChar
		end
	
		return xLetters
	end
