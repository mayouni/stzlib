		end
		#>

	  #===============================================#
	 #  SPLITTING AROUND POSITION(S) OR SECTION(s)  #
	#===============================================#

	# Returns the sections left around a position, a section given as a pair, several positions or several sections.
	#
	#   p          a position, a pair [ first, last ] taken as a section, a list of three or more
	#              positions, or a list of sections
	#   returns    a list of sections, each [ first, last ]
	#   note       SplitAround([ 3, 6, 8 ]) on 10 positions gives [ [ 1, 2 ], [ 4, 5 ], [ 7, 7 ], [
	#              9, 10 ] ]; a position outside 1..N raises an error
	#   see        SplitAroundPosition, SplitAroundPositions, SplitAroundSections
	def SplitAround(xP)
		if IsNumber(xP)
			return this.SplitAroundPosition(xP)
		end

		if IsList(xP)
			oParam = Q(xP)
			if oParam.IsPairOfNumbers()
				return this.SplitAroundSection(xP[1], xP[2])

			elseif oParam.IsListOfNumbers()
				return this.SplitAroundPositions(xP)

			elseif oParam.IsListOfPairsOfNumbers()
				return this.SplitAroundSections(xP)
			end
		else
			StzRaise("Incorrect param type! p must be a number or pair of numbers or list of numbers.")

		end
	end
		def SplitsAround(xP)
			return this.SplitAround(xP)
		end
	def SplitAroundIB(xP)
		xSections = this.SplitAround(xP)
		xResult = this.pvtSectionsToSectionsIB(xSections)
		return xResult
	end
		def SplitsAroundIB(xP)
			return this.SplitAroundIB(xP)
		end
	  #-------------------------------#
