	  #===================================#
	 #   SPLITTING TO PARTS OF N ITEMS   #
	#===================================#

	def SplitToPartsOfNItemsXT(xN)
		if not IsNumber(xN)
			StzRaise("Incorrect param type! n must be a number.")
		end

		nLen = this.NumberOfPositions()

		xResult = []

		for i = 1 to nLen step xN
			nTemp = i + xN-1

			if nTemp > nLen
				nTemp = nLen
			end

			xResult + [ i, nTemp ]
		end

			return xResult
	end
