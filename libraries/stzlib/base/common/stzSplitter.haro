
/*
This class is a numrical solution to splitting things.

A splitter recieves a number of N positions.

Then the splitter initializes an internal list of numbers from 1 to N.

Then the several splitting features are provided (see the class methods).

Each of these methods returns a list pof Sections (as pairs of numbers).

In practice, stzSplitter is called from inside a stzString or stzList. In this
case, the returned sections are passed to stzString.Sections() or stzList.Sections()
to provide us with the splitted parts of the string or the list.
	
*/

func StzSplitterQ(xP)
	return new stzSplitter(xP)
end
# Holds a number of positions, 1 to N, and answers where a string or a list would be cut, as sections [ first, last ] and never as parts.
#
# A splitter knows only a size. It never sees the items: every Split method returns a list of
# sections that a stzString or a stzList then hands to its own Sections method to get the parts. The
# family has three axes. The cut can fall AT a position or section (the cut-out positions are left
# out), BEFORE it (the position starts a new section) or AFTER it (the position ends a section);
# each exists for one position, for several positions, for one section and for several sections,
# plus SplitToNParts and SplitToPartsOfNItems for even cuts. The IB forms (inclusive bounds, such as
# SplitAtSectionIB) grow the sections by one part width so the cut positions are kept. Known gaps
# today, each carried as a warning on its method: SplitAround with a flat pair raises R19,
# SplitAroundSection raises R14, SplitAroundPosition raises R21 for the last position,
# SplitAtSections reads its first and last cuts before sorting, and the named forms of SplitAt
# (:ToNParts, :ToPartsOfNItems) raise R14.
#
#   receiver   o1 = new stzSplitter(10)
#   example    ? @@( o1.SplitAtSection(3, 5) )
#              #--> [ [ 1, 2 ], [ 6, 10 ] ]
#   see        stzString, stzList, stzListOfNumbers
class stzSplitter from stzListOfNumbers

	@nNumberOfPositions
	@nLenPart = 1

	  #--------------------------------#
	 #    INITIALIZING THE SPLITTER   #
	#--------------------------------#

	# Builds a splitter over N positions, given as a number or as a pair [ N, part width ]; a string or a negative number raises an error.
	#
	#   p          the number of positions N, or a pair [ N, width of one part ]
	#   returns    nothing; the splitter is built
	#   note       A splitter of 0 positions answers [ 1, 0 ] as its content, because the range 1:0
	#              counts down. Everything it answers is a list of sections, each [ first, last ],
	#              to hand to a string or a list
	#   see        NumberOfPositions, Content
	def init(xP)

		if not (IsNumber(xP) or @IsPairOfNumbers(xP))
			StzRaise("Incorrect param type! p must be a number or a pair of numbers.")
		end

		if IsNumber(xP)

			if xP < 0
				StzRaise("p must be positive!") #--> TODO: stzListError
			end

			@nNumberOfPositions = xP

		elseif IsList(xP)
			@nNumberOfPositions = xP[1]
			@nLenPart = xP[2]

		end
	end
	# Returns how many positions the splitter covers.
	#
	#   returns    a number
	#   note       NumberOfItems is the same method
	#   see        Content, ToStzList
	def NumberOfPositions
		return @nNumberOfPositions
	end
		def NumberOfItems
			return this.NumberOfPositions()
		end
	# Returns the positions 1 to N as a list of numbers.
	#
	#   returns    a list of numbers
	#   note       Value is the same method
	#   see        NumberOfPositions, ToStzList
	def Content
		xResult = 1:this.NumberOfPositions()
		return xResult
	end
		# Returns the positions 1 to N as a list of numbers, the same answer as the content accessor.
		#
		#   returns    a list of numbers
		#   see        Content, NumberOfPositions
		def Value
			return Content()
		end
	# Returns a new splitter over the same number of positions; a part width given as [ N, width ] is not carried over.
	#
	#   returns    a stzSplitter
	#   note       A copy of a splitter built from a pair answers with the default width 1 where the
	#              part width matters
	#   see        NumberOfPositions
	def Copy
		return new stzSplitter( this.NumberOfPositions() )
	end
	  #========================================#
	 #    SPLITTING : THE GENERIC FUNCTION    #
	#========================================#

	def SplitXT(xP)
		if not IsList(xP)
			StzRaise("Incorrect param type! p must be a list.")
		end

		# Case of number or lit of numbers param

		if IsNumber(xP)
			return this.SplitAtPosition(xP)

		elseif @IsListOfNumbers(xP)
			return this.SplitAtPositions(xP)
		end

		# Cases of named params

		oParam = Q(xP)

		#-- :At

		if oParam.IsAtNamedParam()
			return this.SplitAtPosition(xP[2])

		elseif oParam.IsAtIBNamedParam()
			return this.SplitAtPositionIB(xP[2])

		#-- :AtPosition

		elseif IsOneOfTheseNamedParamsList(xP,[
			:AtPosition, :AtThisPosition ])

			return this.SplitAtPositionIB(xP[2])

		elseif IsOneOfTheseNamedParamsList(xP,[
			:AtPositionIB, :AtThisPositionIB ])

			return this.SplitAtPositionIB(xP[2])

		#-- :AtPositions

		elseif IsOneOfTheseNamedParamsList(xP,[
			:AtPositions, :AtThesePositions, :AtManyPositions ])

			return this.SplitAtPositions(xP[2])

		elseif IsOneOfTheseNamedParamsList(xP,[
			:AtPositionsIB, :AtThesePositionsIB, :AtManyPositionsIB ])

			return this.SplitAtPositionsIB(xP[2])

		#-- :BeforePosition

		elseif IsOneOfTheseNamedParamsList(xP,[
			:Before, :BeforePosition, :BeforeThisPosition ])

			return this.SplitAtPosition(xP[2])

		elseif IsOneOfTheseNamedParamsList(xP,[
			:BeforeIB, :BeforePositionIB, :BeforeThisPositionIB ])

			return this.SplitAtPositionIB(xP[2])

		#-- :BeforePositions

		elseif IsOneOfTheseNamedParamsList(xP,[
			:BeforePositions, :BeforeThesePositions, :BeforeManyPositions ])

			return this.SplitBeforePositions(xP[2])

		elseif IsOneOfTheseNamedParamsList(xP,[
			:BeforePositionsIB, :BeforeThesePositionsIB, :BeforeManyPositionsIB ])

			return this.SplitBeforePositionsIB(xP[2])

		#-- :AfterPosition

		elseif IsOneOfTheseNamedParamsList(xP,[
			:After, :AfterPosition, :AfterThisPosition ])

			return this.SplitAfterPosition(xP[2])

		elseif IsOneOfTheseNamedParamsList(xP,[
			:AfterIB, :AfterPositionIB, :AfterThisPositionIB ])

			return this.SplitAfterPositionIB(xP[2])

		# :AfterPositions

		elseif IsOneOfTheseNamedParamsList(xP,[
			:AfterPositions, :AfterThesePositions, :AfterManyPositions ])

			return this.SplitAfterPositions(xP[2])

		elseif IsOneOfTheseNamedParamsList(xP,[
			:AfterPositionsIB, :AfterThesePositionsIB, :AfterManyPositionsIB ])

			return this.SplitAfterPositionsIB(xP[2])

		#-- :AtSection

		elseif IsOneOfTheseNamedParamsList(xP,[ :AtSection, :AtThisSection ])
			return this.SplitAtSection(xP[2][1], xP[2][2])

		elseif IsOneOfTheseNamedParamsList(xP,[ :AtSectionIB, :AtThisSectionIB ])
			return this.SplitAtSectionIB(xP[2][1], xP[2][2])

		#-- :AtSections

		elseif IsOneOfTheseNamedParamsList(xP,[
			:AtSections, :AtTheseSections, :AtManySections ])

			return this.SplitAtSections(xP[2])

		elseif IsOneOfTheseNamedParamsList(xP,[
			:AtSectionsIB, :AtTheseSectionsIB, :AtManySectionsIB ])

			return this.SplitAtSectionsIB(xP[2])

		#-- :BeforeSection

		elseif IsOneOfTheseNamedParamsList(xP,[ :BeforeSection, :BeforeThisSection ])
			return this.SplitBeforeSection(xP[2][1], xP[2][2])

		elseif IsOneOfTheseNamedParamsList(xP,[ :BeforeSectionIB, :BeforeThisSectionIB ])
			return this.SplitBeforeSectionIB(xP[2][1], xP[2][2])

		#-- :BeforeSections

		elseif IsOneOfTheseNamedParamsList(xP,[
			:BeforeSections, :BeforeTheseSections, :BeforeManySections ])

			return this.SplitBeforeSections(xP[2])

		elseif IsOneOfTheseNamedParamsList(xP,[
			:BeforeSectionsIB, :BeforeTheseSectionsIB, :BeforeManySectionsIB ])

			return this.SplitBeforeSectionsIB(xP[2])

		#-- :AfterSection

		elseif IsOneOfTheseNamedParamsList(xP,[ :AfterSection, :AfterThisSection ])
			return this.SplitAfterSection(xP[2][1], xP[2][2])

		elseif IsOneOfTheseNamedParamsList(xP,[ :AfterSectionIB, :AfterThisSectionIB ])
			return this.SplitAfterSectionIB(xP[2][1], xP[2][2])

		#-- :AfterSections

		elseif IsOneOfTheseNamedParamsList(xP,[
			:AfterSections, :AfterTheseSections, :AfterManySections ])

			return this.SplitAfterSections(xP[2])

		elseif IsOneOfTheseNamedParamsList(xP,[
			:AfterSectionsIB, :AfterTheseSectionsIB, :AfterManySectionsIB ])

			return this.SplitAfterSectionsIB(xP[2])

		#== Misc.

		elseif oParam.IsToPartsOfNItemsNamedParam()
			return this.SplitToPartsOfNItemsXT(xP[2])

		elseif oParam.IsToPartsOfExactlyNItemsNamedParam()
			return this.SplitToPartsOfNItems(xP[2])

		elseif oParam.IsToNPartsNamedParam()
			return this.SplitToNParts(xP[2])

		else
			StzRaise("Unsupported syntax!")
		end
	end
		#< @FunctionAlternativeForms

		def SplitsXT(xP)
			return this.SplitXT(xP)
		end
		def SplitXTZZ(xP)
			return this.SplitXT(xP)
		end
		def SplitsXTZZ(xP)
			return this.SplitXT(xP)
		end
		#>

	  #====================#
	 #    SPLITTING AT    #
	#====================#

	# Returns the sections left when the given position, positions, section or sections are cut out of 1..N.
	#
	#   p          a position, a list of positions, a section, a list of sections, or a named pair
	#              such as [ :Section, [ 3, 5 ] ]
	#   returns    a list of sections, each [ first, last ]
	#   note       SplitAt([ 3, 6 ]) on 10 positions gives [ [ 1, 2 ], [ 4, 5 ], [ 7, 10 ] ]; Split
	#              and SplitsAt are the same method
	#   warning    Named pairs :ToNParts, :ToPartsOfNItems, :PositionsIB and any unknown name raise
	#              error R14 today (a method they call exists nowhere); an unknown name should raise
	#              the Unsupported syntax error
	#   see        SplitAtPosition, SplitAtPositions, SplitAtSection, SplitAtSections
	def SplitAt(xP)

		if IsNumber(xP)
			return this.SplitAtPosition(xP)

		elseif IsList(xP)
			oParam = Q(xP)

			if oParam.IsListOfNumbers()
				return this.SplitAtPositions(xP)

			elseif oParam.IsListOfPairsOfNumbers()
				return this.SplitAtSections(xP)

			#--

			elseif IsOneOfTheseNamedParamsList(xP,[ :Position, :ThisPosition ])
				return this.SplitAtPosition(xP[2])

			elseif IsOneOfTheseNamedParamsList(xP,[ :PositionsIB, :ThesePositionsIB ])
				return this.SplitAtPositionsIB(xP[2])

			#--

			elseif IsOneOfTheseNamedParamsList(xP,[ :Section, :ThisSection ])
				return this.SplitAtSection(xP[2][1], xP[2][2])

			elseif IsOneOfTheseNamedParamsList(xP,[ :SectionIB, :ThisSectionIB ])
				return this.SplitAtSectionIB(xP[2][1], xP[2][2])

			#--

			elseif IsOneOfTheseNamedParamsList(xP,[ :Sections, :TheseSections ])
				return this.SplitAtSections(xP[2])

			elseif IsOneOfTheseNamedParamsList(xP,[ :SectionsIB, :TheseSectionsIB ])
				return this.SplitAtSectionsIB(xP[2])

			#==

			elseif oParam.IsToPartsOfNItemsNamedParam() or
			    oParam.IsToPartsOfExactlyNItemsNamedParam()

				return this.SplitToPartsOfNItems(xP[2])

			elseif oParam.IsToPartsOfNItemsXTNamedParam()

				return this.SplitToPartsOfNItemsXT(xP[2])

			elseif oParam.IsToNPartsNamedParam() or
			    oParam.IsToExactlyNPartsNamedParam()

				return this.SplitToNParts(xP[2])

			elseif oParam.IsToNPartsXTNamedParam()
				return this.SplitToNParts(xP[2])

			else
				StzRaise("Unsupported syntax of Split( :... = ... ).")
			end
		else
			StzRaise("Incorrect param! p must be a number, list of numbers, section, or list of sections.")
		end
	end
		#< @FunctionAlternativeForms

		def SplitsAt(xP)
			return this.SplitAt(xP)
		end
		def Split(xP)
			return this.SplitAt(xP)
		end
		def Splits(xP)
			return this.SplitAt(xP)
		end
		#--

		def SplitAtZZ(xP)
			return this.SplitAt(xP)
		end
		def SplitsAtZZ(xP)
			return this.SplitAt(xP)
		end
		def SplitZZ(xP)
			return this.SplitAt(xP)
		end
		def SplitsZZ(xP)
			return this.SplitAt(xP)
		end
		#>

	  #-----------------------------------#
	 #   SPLITTING AT A GIVEN POSITION   #
	#-----------------------------------#

	# Returns the sections on each side of one position, which is itself left out.
	#
	#   n          the position to cut out, from 1 to N
	#   returns    a list of sections; [ [ 2, N ] ] for position 1, [ [ 1, N-1 ] ] for position N
	#              and [ ] when N is 1
	#   note       SplitAtPosition(4) on 10 positions gives [ [ 1, 3 ], [ 5, 10 ] ]; a position
	#              outside 1..N raises an error
	#   see        SplitAtPositions, SplitBeforePosition, SplitAfterPosition
	def SplitAtPosition(xN)

		this._CheckPosition(xN)

		nLen = @nNumberOfPositions
		xResult = []

		if xN > 1
			xResult + [ 1, xN-1 ]
		end

		if xN < nLen
			xResult + [ xN+1, nLen ]
		end

		return xResult
	end
		#< @FunctionAlternativeForm

		def SplitsAtPosition(xN)
			return this.SplitAtPosition(xN)
		end
		#--

		def SplitAtPositionZZ(xN)
			return this.SplitAtPosition(xN)
		end
		def SplitsAtPositionZZ(xN)
			return this.SplitAtPosition(xN)
		end
		#>

	  #---------------------------------#
	 #   SPLITTING AT MANY POSITIONS   #
	#---------------------------------#

	# Returns the sections between several positions, which are themselves left out.
	#
	#   panPos     the positions to cut out, from 1 to N, in any order
	#   returns    a list of sections, each [ first, last ]; [ [ 1, N ] ] for an empty list
	#   note       [ 3, 6 ] on 10 positions gives [ [ 1, 2 ], [ 4, 5 ], [ 7, 10 ] ]; adjacent or
	#              repeated positions make no empty section; a position outside 1..N raises an error
	#   see        SplitAtPosition, SplitBeforePositions, SplitAfterPositions
	def SplitAtPositions(pxPos)

		if not ( IsList(pxPos) and ( ring_len(pxPos) = 0 or @IsListOfNumbers(pxPos) ) )
			StzRaise("Incorrect param type! panPos must be a list of numbers.")
		end

		nLenPos = ring_len(pxPos)
		for i = 1 to nLenPos
			this._CheckPosition(pxPos[i])
		end

		nLen = @nNumberOfPositions
		viPos = ring_sort(pxPos)
		xResult = []
		nPrev = 0

		# Each gap between two cut positions is a section; adjacent or
		# repeated positions leave no gap, so no empty section is made
		for i = 1 to nLenPos
			if viPos[i] > nPrev + 1
				xResult + [ nPrev + 1, viPos[i] - 1 ]
			end
			if viPos[i] > nPrev
				nPrev = viPos[i]
			end
		end

		if nPrev < nLen
			xResult + [ nPrev + 1, nLen ]
		end

		return xResult
	end
		#< @FunctionAlternativeForms

		def SplitAtThesePositions(pxPos)
			return this.SplitAtPositions(pxPos)
		end
		def SplitAtManyPositions(pxPos)
			return this.SplitAtPositions(pxPos)
		end
		#--

		def SplitsAtPositions(pxPos)
			return this.SplitAtPositions(pxPos)
		end
		def SplitsAtThesePositions(pxPos)
			return this.SplitAtPositions(pxPos)
		end
		def SplitsAtManyPositions(pxPos)
			return this.SplitAtPositions(pxPos)
		end
		#==

		def SplitAtPositionsZZ(pxPos)
			return this.SplitAtPositions(pxPos)
		end
		def SplitAtThesePositionsZZ(pxPos)
			return this.SplitAtPositions(pxPos)
		end
		def SplitAtManyPositionsZZ(pxPos)
			return this.SplitAtPositions(pxPos)
		end
		#--

		def SplitsAtThesePositionsZZ(pxPos)
			return this.SplitAtPositions(pxPos)
		end
		def SplitsAtManyPositionsZZ(pxPos)
			return this.SplitAtPositions(pxPos)
		end
		#>

	  #========================#
	 #    SPLITTING BEFORE    #
	#========================#

	# Returns the sections cut just before a position, positions, section or sections, each cut position starting a new section.
	#
	#   p          a position, a list of positions, a section, a list of sections, or a named pair
	#              such as [ :Position, 4 ]
	#   returns    a list of sections, each [ first, last ]
	#   note       SplitBefore(4) on 10 positions gives [ [ 1, 3 ], [ 4, 10 ] ]
	#   warning    An unknown named pair answers an empty string instead of raising an error, and
	#              :PositionIB raises R14
	#   see        SplitBeforePosition, SplitBeforePositions, SplitBeforeSection,
	#              SplitBeforeSections
	def SplitBefore(xP)
	
		if IsNumber(xP)
			return this.SplitBeforePosition(xP)

		elseif IsList(xP)
			oParam = Q(xP)
			if oParam.IsListOfNumbers()
				return this.SplitBeforePositions(xP)

			elseif oParam.IsListOfPairsOfNumbers()
				return this.SplitBeforeSections(xP)

			#--

			elseif IsOneOfTheseNamedParamsList(xP,[ :Position, :ThisPosition ])
				return this.SplitBeforePosition(xP[2])

			elseif IsOneOfTheseNamedParamsList(xP,[ :PositionIB, :ThisPositionIB ])
				return this.SplitBeforePositionIB(xP[2])

			#--

			elseif IsOneOfTheseNamedParamsList(xP,[ :Positions, :ThesePositions ])
				return this.SplitBeforePositions(xP[2])

			elseif IsOneOfTheseNamedParamsList(xP,[ :PositionsIB, :ThesePositionsIB ])
				return this.SplitBeforePositionsIB(xP[2])

			#--

			elseif IsOneOfTheseNamedParamsList(xP,[ :Section, :ThisSection ])
				return this.SplitBeforeSection(xP[2][1], xP[2][2])

			elseif IsOneOfTheseNamedParamsList(xP,[ :SectionIB, :ThisSectionIB ])
				return this.SplitBeforeSectionIB(xP[2][1], xP[2][2])

			#--

			elseif IsOneOfTheseNamedParamsList(xP,[ :Sections, :TheseSections ])
				return this.SplitBeforeSections(xP[2])

			elseif IsOneOfTheseNamedParamsList(xP,[ :SectionsIB, :TheseSectionsIB ])
				return this.SplitBeforeSectionsIB(xP[2])

			end
		else
			StzRaise("Incorrect param! p must be a number, list of numbers, section, or list of sections.")
		end
	end
		def SplitsBefore(xP)
			return this.SplitBefore(xP)
		end
	  #---------------------------------#
	 #   SPLITTING BEFORE A POSITION   #
	#---------------------------------#

	# Returns two sections that meet at a position, which starts the second one.
	#
	#   n          the position that starts the second section
	#   returns    a list of sections; [ [ 1, N ] ] for position 1
	#   note       SplitBeforePosition(4) on 10 positions gives [ [ 1, 3 ], [ 4, 10 ] ]
	#   warning    Raises an error for a position outside 1..N
	#   see        SplitBeforePositions, SplitAtPosition, SplitAfterPosition
	def SplitBeforePosition(xN)
		return this.SplitBeforePositions([xN])
	end
		def SplitsBeforePosition(xN)
			return this.SplitBeforePosition(xN)
		end
	  #-------------------------------------#
	 #   SPLITTING BEFORE MANY POSITIONS   #
	#-------------------------------------#

	# Returns the sections cut just before each position, so every position starts a section.
	#
	#   returns    a list of sections, each [ first, last ]
	#   note       Duplicates are ignored and the order does not matter; [ 3, 6 ] on 10 positions
	#              gives [ [ 1, 2 ], [ 3, 5 ], [ 6, 10 ] ]
	#   warning    Raises an error for a position outside 1..N or for an empty list
	#   see        SplitBeforePosition, SplitAfterPositions, SplitAtPositions
	def SplitBeforePositions(pxPos)

		if CheckingParams()
			if not ( IsList(pxPos) and @IsListOfNumbers(pxPos) )
				StzRaise("Incorrect param type! panPos must be a list of numbers.")
			end
		end

		# Resolving the positions correctness

		nLen = this.NumberOfItems()

		oTmpSpSort = new stzList(pxPos)
		viPos = U( oTmpSpSort.Sorted() )
		nLenPos = Len(viPos)

		for i = 1 to nLenPos
			if not (viPos[i] >= 1 and viPos[i] <= nLen)
				StzRaise("Incorrect param type! panPos must contain unique numbers between 1 and " + String(nLen) + ".")
			end
		end

		# Doing the job

   		xResult = []
   		nStart = 1

		for i = 1 to nLenPos
			nPos = viPos[i]
	       		xResult + [ nStart, nPos-1 ]
	        	nStart = nPos
		end

		if xResult[1][1] = 1 and xResult[1][2] = 0
			Del(xResult, 1)
		end

		xResult + [nStart, nLen]

    		return xResult
	end

		#< @FunctionAlternativeForms

		def SplitBeforeThesePositions(pxPos)
			return this.SplitBeforePositions(pxPos)
		end
		def SplitBeforeManyPositions(pxPos)
			return this.SplitBeforePositions(pxPos)
		end
		#--

		def SplitsBeforeThesePositions(pxPos)
			return this.SplitBeforePositions(pxPos)
		end
		def SplitsBeforeManyPositions(pxPos)
			return this.SplitBeforePositions(pxPos)
		end
		#>

	  #=======================#
	 #    SPLITTING AFTER    #
	#=======================#

	# Returns the sections cut just after a position, positions, section or sections, each cut position ending a section.
	#
	#   p          a position, a list of positions, a section, a list of sections, or a named pair
	#              such as [ :Position, 4 ]
	#   returns    a list of sections, each [ first, last ]
	#   note       SplitAfter(4) on 10 positions gives [ [ 1, 4 ], [ 5, 10 ] ]
	#   warning    An unknown named pair answers an empty string instead of raising an error, and
	#              :PositionIB raises R14
	#   see        SplitAfterPosition, SplitAfterPositions, SplitAfterSection, SplitAfterSections
	def SplitAfter(xP)

		if IsNumber(xP)
			return this.SplitAfterPosition(xP)

		elseif IsList(xP)
			oParam = Q(xP)
			if oParam.IsListOfNumbers()
				return this.SplitAfterPositions(xP)

			elseif oParam.IsListOfPairsOfNumbers()
				return this.SplitAfterSections(xP)

			#--

			elseif IsOneOfTheseNamedParamsList(xP,[ :Position, :ThisPosition ])
				return this.SplitAfterPosition(xP[2])

			elseif IsOneOfTheseNamedParamsList(xP,[ :PositionIB, :ThisPositionIB ])
				return this.SplitAfterPositionIB(xP[2])

			#--

			elseif IsOneOfTheseNamedParamsList(xP,[ :Positions, :ThesePositions ])
				return this.SplitAfterPositions(xP[2])

			elseif IsOneOfTheseNamedParamsList(xP,[ :PositionsIB, :ThesePositionsIB ])
				return this.SplitAfterPositionsIB(xP[2])

			#--

			elseif IsOneOfTheseNamedParamsList(xP,[ :Section, :ThisSection ])
				return this.SplitAfterSection(xP[2][1], xP[2][2])

			elseif IsOneOfTheseNamedParamsList(xP,[ :SectionIB, :ThisSectionIB ])
				return this.SplitAfterSectionIB(xP[2][1], xP[2][2])

			#--

			elseif IsOneOfTheseNamedParamsList(xP,[ :Sections, :TheseSections ])
				return this.SplitAfterSections(xP[2])

			elseif IsOneOfTheseNamedParamsList(xP,[ :SectionsIB, :TheseSectionsIB ])
				return this.SplitAfterSectionsIB(xP[2])

			end
		else
			StzRaise("Incorrect param! p must be a number, list of numbers, section, or list of sections.")
		end
	end

		def SplitsAfter(xP)
			return this.SplitAfter(xP)
		end
	  #--------------------------------------#
	 #   SPLITTING AFTER A GIVEN POSITION   #
	#--------------------------------------#

	# Returns two sections that meet after a position, which ends the first one.
	#
	#   n          the position that ends the first section
	#   returns    a list of sections; [ [ 1, N ] ] for position N
	#   note       SplitAfterPosition(4) on 10 positions gives [ [ 1, 4 ], [ 5, 10 ] ]
	#   warning    Raises an error for a position outside 1..N
	#   see        SplitAfterPositions, SplitAtPosition, SplitBeforePosition
	def SplitAfterPosition(xN)
		return this.SplitAfterPositions([xN])
	end
		def SplitsAfterPosition(xN)
			return this.SplitAfterPosition(xN)
		end
	  #------------------------------------#
	 #   SPLITTING AFTER MANY POSITIONS   #
	#------------------------------------#

	# Returns the sections cut just after each position, so every position ends a section.
	#
	#   returns    a list of sections, each [ first, last ]
	#   note       Duplicates are ignored and the order does not matter; [ 3, 6 ] on 10 positions
	#              gives [ [ 1, 3 ], [ 4, 6 ], [ 7, 10 ] ]
	#   warning    Raises an error for a position outside 1..N or for an empty list
	#   see        SplitAfterPosition, SplitBeforePositions, SplitAtPositions
	def SplitAfterPositions(pxPos)
		if CheckingParams()
			if not ( IsList(pxPos) and @IsListOfNumbers(pxPos) )
				StzRaise("Incorrect param type! panPos must be a list of numbers.")
			end
		end

		# Resolving the positions correctness

		nLen = this.NumberOfItems()

		oTmpSpSort = new stzList(pxPos)
		viPos = U( oTmpSpSort.Sorted() )
		nLenPos = Len(viPos)

		for i = 1 to nLenPos
			if not (viPos[i] >= 1 and viPos[i] <= nLen)
				StzRaise("Incorrect param type! panPos must contain unique numbers between 1 and " + String(nLen) + ".")
			end
		end

		# Doing the job

   		xResult = []
   		nStart = 1

		for i = 1 to nLenPos
			nPos = viPos[i]
	       		xResult + [ nStart, nPos ]
	        	nStart = nPos + 1
		end

		if nStart <= nLen
			xResult + [nStart, nLen]
		end

    		return xResult
	end
