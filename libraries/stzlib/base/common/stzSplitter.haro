	  #=================================#
	 #  SPLITTING AT A GIVEN SECTION   #
	#=================================#

	# Returns the sections before and after a section, which is itself left out; one side is missing when the section touches an end.
	#
	#   _n1_       the first position of the section to cut out
	#   _n2_       the last position of the section to cut out
	#   returns    a list of 0, 1 or 2 sections
	#   note       SplitAtSection(3, 5) on 10 positions gives [ [ 1, 2 ], [ 6, 10 ] ]; SplitBetween
	#              is the same method
	#   warning    Only the first position is checked against 1..N, so a last position past N is
	#              accepted, and a reversed section such as 5, 3 answers overlapping sections
	#   see        SplitAtSections, SplitBeforeSection, SplitAfterSection
	def SplitAtSection(xN1, xN2)
		/* EXAMPLE

		oO1 = new stzSplitter(8)
		? oO1.SplitAtSection([3,5])

		# 1..2..3..4..5..8
		#       ^-----^

		#--> [ [1,2], [6,8] ]

		# If you want to include the bounds of the sections
		# in the result, use the ...IB() extension like this:

		? oO1.SplitAtSectionIB([3,5])
		#--> [ [1,3], [5,8] ]

		*/

		if not (IsNumber(xN1) and IsNumber(xN2))
			StzRaise("Incorrect param type! n1 and n2 must both be numbers.")
		end

		nLen = this.NumberOfPositions()

		if not ( (xN1 >= 1 and xN1 <= nLen) and (xN1 >= 1 and xN1 <= nLen) )

			StzRaise("Can't split! Indices provided in panSection must be between 1 and " +
				  String(nLen) + "." )
		end

		xResult = []

		if xN1-1 >= 1 and xN1-1 <= nLen
			xResult + [ 1, xN1 - 1 ]
		end

		if xN2+1 >= 1 and xN2+1 <= nLen
			xResult + [ xN2 + 1, nLen ]
		end

		return xResult
	end
