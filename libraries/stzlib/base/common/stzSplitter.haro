	  #------------------------------#
	 #  SPLITTING AROUND A SECTION  #
	#------------------------------#

	# Returns the sections left on each side of one section, which is left out.
	#
	#   _n1_       the first position of the section, from 1 to N
	#   _n2_       the last position of the section, from 1 to N
	#   returns    a list of sections; [ [ 1, 1 ], [ 6, 10 ] ] for 2 to 5 on 10 positions
	#   note       the two ends may come in either order; a position outside 1..N raises an error
	#   see        SplitAroundSections, SplitAtSection
	def SplitAroundSection(xN1, xN2)
		this._CheckPosition(xN1)
		this._CheckPosition(xN2)

		if xN1 > xN2
			nTemp = xN1
			xN1 = xN2
			xN2 = nTemp
		end

		xResult = []

		if xN1 > 1
			xResult + [ 1, xN1 - 1 ]
		end

		if xN2 < @nNumberOfPositions
			xResult + [ xN2 + 1, @nNumberOfPositions ]
		end

		return xResult
	end
		def SplitsAroundSection(xN1, xN2)
			return this.SplitAroundSection(xN1, xN2)
		end
	def SplitAroundSectionIB(xN1, xN2)
		xSections = this.SplitAroundSection(xN1, xN2)
		xResult = this.pvtSectionsToSectionsIB(xSections)
		return xResult
	end
		def SplitsAroundSectionIB(xN1, xN2)
			return this.SplitAroundSectionIB(xN1, xN2)
		end
	  #-----------------------------#
	 #  SPLITTING AROUND SECTIONS  #
	#-----------------------------#

	# Returns the sections left around several sections, which are left out, sorting them first.
	#
	#   paSections   the sections to leave out, each [ first, last ] within 1..N
	#   returns      a list of sections, each [ first, last ]
	#   note         [ [ 8, 9 ], [ 2, 3 ] ] on 12 positions gives [ [ 1, 1 ], [ 4, 7 ], [ 10, 12 ] ];
	#                overlapping sections are merged; a position outside 1..N raises an error
	#   see          FindAntiSectionsZZ_local, SplitAtSections
	def SplitAroundSections(pxSections)
		if not IsList(pxSections)
			StzRaise("Incorrect param type! paSections must be a list of pairs of numbers.")
		end

		nLenSec = ring_len(pxSections)
		for i = 1 to nLenSec
			if not ( IsList(pxSections[i]) and ring_len(pxSections[i]) = 2 )
				StzRaise("Incorrect param type! paSections must be a list of pairs of numbers.")
			end
			this._CheckPosition(pxSections[i][1])
			this._CheckPosition(pxSections[i][2])
		end

		xResult = this.FindAntiSectionsZZ_local(pxSections)
		return xResult
	end
	# Returns the sections that no given section covers, after sorting the given ones by their first position.
	#
	#   paSections   the sections, each [ first, last ]
	#   returns      a list of sections; [ ] when the argument is not a list
	#   note         [ ] as the argument gives the whole range [ [ 1, N ] ]; overlapping sections
	#                are merged
	#   see          SplitAroundSections
	def FindAntiSectionsZZ_local(pxSections)
		if not IsList(pxSections) return [] end
		xSorted = _ListCopy(pxSections)
		nL = Len(xSorted)
		for i = 2 to nL
			xV = xSorted[i]; nJ = i - 1
			while nJ >= 1 and IsList(xSorted[nJ]) and IsList(xV) and xSorted[nJ][1] > xV[1]
				xSorted[nJ + 1] = xSorted[nJ]; nJ--
			end
			xSorted[nJ + 1] = xV
		end
		vRes = []
		nPrev = 0
		nTotal = @nNumberOfPositions
		if not IsNumber(nTotal) nTotal = 0 end
		for i = 1 to nL
			xS = xSorted[i]
			if IsList(xS) and Len(xS) >= 2
				if xS[1] > nPrev + 1
					vRes + [ nPrev + 1, xS[1] - 1 ]
				end
				# max, so a section inside an earlier one does not move back
				if xS[2] > nPrev
					nPrev = xS[2]
				end
			end
		end
		if nTotal > nPrev
			vRes + [ nPrev + 1, nTotal ]
		end
		return vRes
	end
		def SplitsAroundSections(pxSections)
			return this.SplitAroundSections(pxSections)
		end
	def SplitAroundSectionsIB(pxSections)
		xSections = this.SplitAroundSections(pxSections)
		xResult = this.pvtSectionsToSectionsIB(xSections)
		return xResult
	end
		def SplitsAroundSectionsIB(pxSections)
			return this.SplitAroundSectionsIB(pxSections)
		end
	  #=======================================================#
	 #   Utility functions used by the other methods above   #
	#=======================================================#

	# Raises a clear error when n is not a position of the splitter, 1 to N.
	#
	#   n          the position to check
	#   returns    nothing; raises an error for a position outside 1..N or for a non-number
	#   see        SplitAtPosition, SplitAroundSection
	def _CheckPosition(xN)
		if not IsNumber(xN)
			StzRaise("Incorrect param type! A position must be a number.")
		end

		if xN < 1 or xN > @nNumberOfPositions
			StzRaise("Out of range! The position " + xN + " is outside 1.." +
				 String(@nNumberOfPositions) + ".")
		end
	end
	# Returns the consecutive pairs formed by the positions, with 1 and N added at the ends, for the splitting methods.
	#
	#   returns    a list of pairs of numbers
	#   note       The positions are sorted and deduplicated; [ 3, 6, 8 ] on 10 positions gives [ [
	#              1, 3 ], [ 3, 6 ], [ 6, 8 ], [ 8, 10 ] ]
	#   warning    Raises error R2 for [ 1 ] on 10 positions, because the helper compares the last
	#              position with a literal 10
	#   see        SplitAtPositions
	#TODO // A general function, can move to stzListOfNumbers
	def GetPairsFromPositions(pxPos)
		/*
		Main list 	--> 1:10
		panPos		--> [ 3, 6, 8 ]
		List of pairs	--> [ [ 1, 3 ], [ 3, 6 ], [ 6, 8 ], [ 8, 10 ] ]
		*/

		nLen = this.NumberOfPositions()
		pxPos + nLen

		# Eliminating doubble positions
		xPos = UCS(pxPos, 1)

		# Doing the job

		if Len(xPos) = 0
			return [ [] ]
		end
		
		# Adding 1 and (NumberOfItems()) if inexistant
		if xPos[1] != 1 xPos + 1 end
		if xPos[Len(xPos)] != 10 xPos + nLen end
		
		# Sorting the list
		oChain = new stzList(xPos)
		xPos = oChain.Sorted()
		
		# Getting the pairs of that list

		vPairs = []
		nPosLen = Len(xPos)
		for i = 1 to nPosLen - 1
			vPairs + [ xPos[i], xPos[i+1] ]
		end

		nLenPairs = Len(vPairs)
		xLastPair = vPairs[nLenPairs]
		xBeforeLastPair = vPairs[nLenPairs-1]

		if xLastPair[1] = nLen and
		   xLastPair[2] = nLen and
		   xBeforeLastPair[2] = nLen

			Del(vPairs, nLenPairs)
		end

		return vPairs
	end
	# Returns a stzList holding the positions 1 to N.
	#
	#   returns    a stzList
	#   see        Content
	def ToStzList
		return StzListQ(this.Content())
	end
	private

	# Widens each section by one part width on the side where it touches a cut, so the cut positions are included in the sections.
	#
	#   returns    a list of sections
	#   note       Private: called by the IB forms such as SplitAtSectionIB. The first section grows
	#              at its end, the last at its start, the ones between on both sides
	#   see        SplitAtSection
	def pvtSectionsToSectionsIB(xSections)

		nLen = Len(xSections)

		if nLen = 1
			if xSections[1][1] > 1
				xSections[1][1] -= @nLenPart
			end

			if xSections[1][2] < this.NumberOfItems()
				xSections[1][2] += @nLenPart
			end

			return xSections
		end

		# Adding the first section

		xResult = [] + [ xSections[1][1], xSections[1][2] + @nLenPart ]

		# Adding the sections between the first and last sections

		nLenBetween = nLen - 2

		for i = 1 to nLenBetween
			xResult + [ xSections[i+1][1] - @nLenPart, xSections[i+1][2] + @nLenPart ]
		end

		# adding the last section

		xResult + [ xSections[nLen][1] - @nLenPart, xSections[nLen][2] ]
		return xResult
	end
end
