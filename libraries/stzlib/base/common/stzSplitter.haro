	  #----------------------------#
	 #    SPLITTING TO N PARTS    #
	#----------------------------#

	# Returns n sections that cover all positions, the larger ones first and sizes differing by at most one.
	#
	#   n          how many sections to cut
	#   returns    a list of n sections; [ ] for n = 0 or for a splitter of 0 positions
	#   note       On 10 positions, n = 3 gives [ [ 1, 4 ], [ 5, 7 ], [ 8, 10 ] ]; SplitToNSections
	#              is the same method
	#   warning    Raises an error for n larger than N
	#   see        SplitToPartsOfNItems
	def SplitToNParts(xN)
		if CheckingParams()
			if not IsNumber(xN)
				StzRaise("Incorrect param type! n must be a number.")
			end
		end

		nLen = this.NumberOfItems()
		if nLen = 0
			return []
		end

		if not (xN >= 0 and xN <= nLen)
			StzRaise("Incorrect value! n must be between 0 and " + String(nLen) + " (the size of the list).")
		end
		
		xResult = []
	
		# Early checks
	
		if xN = 0
			return []
	
		elseif xN = 1
			return [ [ 1, nLen ] ]
		end
	
		# Case where the list is even (simpler)
		# ~> each part takes nLen / n items
	
		if nLen % xN = 0
			nSize = nLen / xN
	
			xResult + [ 1, nSize ]
			for i = 2 to xN
				xN1 = xResult[i-1][2] + 1
				xN2 = xN1 + nSize - 1
				xResult + [xN1, xN2]
			end
	
		else # Case where the list is odd (more complex)
		     # We want the larger sections to be returned first

			# if the number of splits is under the half of list

			if xN <= nLen / 2

				# We calculate the number of main parts and
				# how many items are remaining

				nRest = nLen % xN

				nMain = nLen - nRest
				nSize = nMain / xN

				# We split the list to get the main parts

				xResult = [ [ 1, nSize ] ]
				for i = 2 to xN
					xN1 = xResult[i-1][2] + 1
					xN2 = xN1 + nSize - 1
					xResult + [ xN1, xN2 ]
				end

				# We start adding the remaining items to
				# the main parts (starting with first)

				xResult[1][2]++
				nResultLen = Len(xResult)
				for i = 2 to nResultLen
					xResult[i][1]++
					xResult[i][2]++
				end

				# We do the same to add the remaining items
				# to the main parts (other then the first)

				if nRest > 1
					for i = 2 to nRest
						nDiff = xResult[i][2] - xResult[i][1]
						xN1 = xResult[i-1][2] + 1
						xN2 = xN1 + nDiff + 1
						xResult[i][1] = xN1
						xResult[i][2] = xN2
					end

				end

				for i = nRest + 1 to xN
					nDiff = xResult[i][2] - xResult[i][1]
					xN1 = xResult[i-1][2] + 1
					xN2 = xN1 + nDiff
					xResult[i][1] = xN1
					xResult[i][2] = xN2
				end
				#aResult[n][2] = nLen

			else # The number of splits is higher than the half of the list

				# We calculate the half of the list and
				# the difference between the half and n

				nHalf = Q(nLen / 2).IntegerPart()
				nDiff = xN - nHalf

				# We split the list on nHalf parts and we include
				# just the (nHalf - ndiff) sections in the result

				xSplits = this.SplitToNParts(nHalf)
				xResult = []
				for i = 1 to nHalf - nDiff
					xResult + xSplits[i]
				end

				# We take the remaining (last nDiff) sections
				# of the splits on half and we decompose them
				# each section into two separate sections

				nStart = Len(xResult) + 1
				nEnd = nStart + nDiff - 1

				for i = nStart to nEnd
					xSection = xSplits[i]
					xN1 = xSection[1]
					xN2 = xSection[2]
					xResult + [ xN1, xN1 ] + [ xN2, xN2 ]
				end

			end
		end
	
		# Finally, we return the result
		return xResult
	end
