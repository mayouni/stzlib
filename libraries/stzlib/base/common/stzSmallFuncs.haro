func StzLC(xP)
	if IsList(xP)
		xResult = []
		nLen = Len(xP)
		for i = 1 to nLen
			if IsString(xP[i]) and Len(xP[i]) = 1
				xResult + xP[i]
			end
		end
		return xResult

	elseif IsString(xP) and StzQ(xP).IsListInString()
		xResult = StzQ(xP).ToListQ().OnlyChars()
		return xResult

	elseif IsNumber(xP)
		xResult = []
		for i = 1 to xP
			xResult + ""
		end
		return xResult

	end
end
	func LC(xP)
		return StzLC(xP)
	end
	func StzLCQ(xP)
