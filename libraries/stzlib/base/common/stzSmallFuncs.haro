func StzUCS(xP, pxCaseSensitive)
	/* EXAMPLE

	? StzU([ "a", 1, 2, 2, "a", "a", 3 ]) # Or Unique() or WithoutDuplicates()
	#--> [ "a", 1, 2, 3 ]

	*/

	if CheckingParams()
		if not IsList(xP)
			StzRaise("Incorrect param type!")
		end
	end

	xResult = []
	nLen = Len(xP)
	for i = 1 to nLen
		bFound = false
		nResLen = Len(xResult)
		for j = 1 to nResLen
			if BothAreEqualCS(xResult[j], xP[i], pxCaseSensitive)
				bFound = true
				exit
			end
		end
		if not bFound
			xResult + xP[i]
		end
	end
	return xResult
end
	func UCS(xP, pxCaseSensitive)
		return StzUCS(xP, pxCaseSensitive)
	end
