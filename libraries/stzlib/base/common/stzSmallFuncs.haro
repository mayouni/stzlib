

# Returns the softanza object related to the type of p
func StzQ(xP)

	oResult = AFalseObject()

	if IsString(xP)
		oResult = new stzString(xP)

	elseif IsNumber(xP)
		oResult = new stzNumber(xP)

	elseif IsList(xP)
		oResult = new stzList(xP)

	elseif IsObject(xP)
		oResult = new stzObject(xP)
	end

	return oResult
end
	func Q(xP)
		return StzQ(xP)
	end
	func @Q(xP)
		return StzQ(xP)
	end
	func The(xP)
		return StzQ(xP)
	end
	func TheQ(xP)
		return StzQ(xP)
	end
	func TQ(xP)
		return StzQ(xP)
	end
	# the LOCATIVE topic opener: "In [1, 2, 3], each item is a number"
	func InQ(xP)
		return StzQ(xP)
	end
	func @InQ(xP)
		return StzQ(xP)
	end
func StzQC(xP)
	if IsObject(xP)
		# an stz object: clone THROUGH the content -- a fresh object
		# gets a fresh engine handle
		xQc = xP.Content()
		if IsList(xQc)
			vQc = xQc    # Ring copies lists on assignment
			return StzQ(vQc)
		end
		return StzQ(xQc)
	end
	if IsList(xP)
		vQc = xP            # Ring copies lists on assignment
		return StzQ(vQc)
	end
	# numbers and strings are copied by Ring naturally
	return StzQ(xP)
end
	func QC(xP)
		return StzQC(xP)
	end
	func @QC(xP)
		return StzQC(xP)
	end
func StzQH(xP)
	#TODO // Review the code of all functions where loops are used
	# on the main object and modify it many times

	#~> // Use a copy on which the loop is used and then update
	# the main object in on UpdateWith() call

	# Turn history-keeping ON; the first history-aware fluent op opens
	# the stream with its pre-op (initial) value, and every such op
	# appends its result (see _StzHistoOpen / _StzHistoAdd).
	StzKeepHistoryON()

	return StzQ(xP)
end
# History snapshots at the PUBLIC fluent-op boundary (per-op values,
# not the internal per-step Updates). _StzHistoOpen records the pre-op
# value once per stream (History() consumes and clears the stream);
# _StzHistoAdd records each op's result.
func _StzHistoOpen(xV)
	if StzKeepingHistory() and Len($vHisto) = 0
		$vHisto + xV
	end
end
func _StzHistoAdd(xV)
	if StzKeepingHistory()
		$vHisto + xV
	end
end
# Global stub: history-tracking toggle. The full implementation will
# weave through each mutating method; for now we just declare the
# globals so callers don't R3.
func SetKeepingHistoryTo(bOn)
	# No-op stub.
	return
end
func SetKeepingHistoryToXT(bOn, pxMode)
	# No-op stub.
	return

	return StzQHHV(p) # tracing only the value (V)
end
	func QH(xP)
		return StzQH(xP)
	end
	func StzQHHV(xP)
		return StzQHH(xP)
	end
func StzQHH(xP)
