func StzWhere(tCode)
	if not IsString(tCode)
		StzRaise("Incorrect param type! cCode must be a string.")
	end

	xResult = [:Where, tCode]
	return xResult
end
	func W(tCode)
		return StzWhere(tCode)
	end
	func Where(tCode)
		return StzWhere(tCode)
	end
func StzWhereXT(tCode)
	if not IsString(tCode)
		StzRaise("Incorrect param type! cCode must be a string.")
	end

	xResult = [:WhereXT, tCode]
	return xResult
end
	func WXT(tCode)
		return StzWhereXT(tCode)
	end
	func WhereXT(tCode)
		return StzWhereXT(tCode)
	end
# Global Join() function. Mirrors stzList.Join() but works on raw
# Ring lists too -- callers like stzCCode use it on intermediate
# substring arrays without wrapping them first.

# Join a list with a SEPARATOR. `Join` above takes none, which is fine for
# concatenation and useless for a message -- and two call sites had already
# been written against a StzJoinWith that did not exist, each of them inside
# a StzRaise. Both raised R3 "calling function without definition" instead
# of the message they were written to give, and both guards passed anyway
# because they only asserted THAT it raised.
func StzJoinWith(pxList, pxSep)
	if not IsList(pxList)
		StzRaise("StzJoinWith: give a list.")
	end
	tC = ""
	nN = Len(pxList)
	for i = 1 to nN
		if i > 1  tC += ("" + pxSep)  end
		tC += ("" + pxList[i])
	end
	return tC
end
func Join(pxList)
	if not IsList(pxList)
		StzRaise("Join: paList must be a list")
	end
	tJoined = ""
	nLen = Len(pxList)
	for i = 1 to nLen
		if IsString(pxList[i])
			tJoined += pxList[i]
		elseif IsNumber(pxList[i])
			tJoined += "" + pxList[i]
		end
	end
	return tJoined

# Global StzSubStr() -- thin alias for Ring's substr() with the
# (str, start, length) signature. Used by stzRegex.PartialMatchInfo
# and other engine-result formatters that build substring extracts
# from raw byte positions.

# Global stopwords status. The full stopwords feature lives in
# libraries/stzlib/max/string/stxStringStopWords.ring (extended
# layer); the simple status flag itself is base-layer territory so
# narrative tests in the base/test corpus can flip it without
# pulling in `max`.

tStopWordsStatus = :MustNotBeRemoved
end
func StopWordsMustBeRemoved
	tStopWordsStatus = :MustBeRemoved
end
	func StopWordsMustNotBeRemoved
		tStopWordsStatus = :MustNotBeRemoved
	end
func StopWordsStatus
	return tStopWordsStatus
end
func StzSubStr(tStr, nStart, nLen)
	if not IsString(tStr)
		StzRaise("StzSubStr: cStr must be a string")
	end
	if not (IsNumber(nStart) and IsNumber(nLen))
		StzRaise("StzSubStr: nStart and nLen must be numbers")
	end
	if nLen <= 0 or nStart < 1
		return ""
	end
	return StzMid(tStr, nStart, nLen)
end
	func JoinXT(pxList, pxSep)
		if not IsList(pxList)
			StzRaise("JoinXT: paList must be a list")
		end
		if not IsString(pxSep)
			StzRaise("JoinXT: pcSep must be a string")
		end
		tJoinedSep = ""
		nLn = Len(pxList)
		for i = 1 to nLn
			if IsString(pxList[i])
				tJoinedSep += pxList[i]
			elseif IsNumber(pxList[i])
				tJoinedSep += "" + pxList[i]
			end
			if i < nLn
				tJoinedSep += pxSep
			end
		end
		return tJoinedSep
	end
# CenterText: pad cText so it occupies nWidth visible columns, with
# the text centered (extra space biased to the right when nWidth is
# even and the remainder is odd). Used by the pivot-table-show
# row-rendering helper.
func CenterText(tText, nWidth)
	if not (IsString(tText) and IsNumber(nWidth)) return tText end
	if nWidth < 1 return "" end
	# Visible columns = codepoint count, not bytes; byte len()/left() over-
	# counted and could split a multibyte char ('café' is 4 cols, 5 bytes).
	nLen = StzLen(tText)
	if nLen >= nWidth
		return StzLeft(tText, nWidth)
	end
	nLeft = Floor((nWidth - nLen) / 2)
	nRight = nWidth - nLen - nLeft
	tOut = ""
	for i = 1 to nLeft
		tOut += " "
	end
	tOut += tText
	for i = 1 to nRight
		tOut += " "
	end
	return tOut
end
