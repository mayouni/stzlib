func StzW(tType, pxMethodAndFilter)
	/* EXAMPLE
	? StzW(:Char, [ :Methods, :Where = 'Q(@Method).StartsWith("is")' ])
	*/

	if not ( IsList(pxMethodAndFilter) and Len(pxMethodAndFilter) = 2 and
		 IsList(pxMethodAndFilter[2]) and
		 Q(pxMethodAndFilter[2]).IsWhereNamedParam() and
		 IsString(pxMethodAndFilter[2][2]) )

		StzRaise('Incorrect param type! paMethodAndFilter must be a pair of the form [ :Methods, :Where = "@Method..." ], for example.')
	end

	xTempList = Stz(tType, pxMethodAndFilter[1])
	tCondition = Q(pxMethodAndFilter[2][2])
			.ReplaceCSQ("@Method", "@Item", 0)
			.Content()

	xResult = QRT(xTempList, :stzListOfStrings).StringsW(tCondition)

	return xResult
end
func Stz(tType, pxInfo)
	/* EXAMPLE
		? Stz(:Char, :Methods) #--> [ :Init, :Content, ... ]
	*/

	if IsList(pxInfo) and Len(pxInfo) = 2 and
		 IsList(pxInfo[2]) and
		 Q(pxInfo[2]).IsWhereNamedParam() and
		 IsString(pxInfo[2][2])

		return StzW(tType, pxInfo)
	end

	tInfo = pxInfo

	if not @BothAreStrings(tType, [:And, tInfo])
		StzRaise("Incorrect params type! Botht cType and cInfo must be strings.")
	end

	tClass = 'stz' + tType

	if not Q(tClass).IsStzClassName()
		StzRaise("Incorrect param! cType must be a valid softanza type.")
	end

	oEmptyObject = Empty(tClass)

	switch tInfo
	case :Class
		return tClass

	case :ClassName
		return tClass

	case :Methods
		return Methods(oEmptyObject)

	case :Attributes
		return Attributes(oEmptyObject)

	else
		StzRaise("Unsupported information! Allowed values are :Methods and :Attributes.")
	end
end

# This function tries its best to infere a convenient type
# by analysing a value hosted in a string

func StzQQ(xP)

	/* EXAMPLE 1

	? StzQQ("19")		# stzNumber
	#--> Note that this is a number in string:
	? StzQ("19").IsNumberInString() #--> TRUE

	EXAMPLE 2

	? StzQQ("[1, 2, 3]")	#--> stzListOfNumbers
	#--> Note that this is a list in string:
	? StzQ("[1, 2, 3]").IsListOfNumbersInString() #--> TRUE

	EXAMPLE 3

	? StzQQ(' [ "one", "two", "three" ] ')	#--> stzListOfStrings
	#--> Note that this is a list of strings in a string:
	? StzQ(' [ "one", "two", "three" ] ').IsListOfStringsInString #--> TRUE

	*/

	if IsString(xP)

		oParam = new stzString(xP)

		# QQ elevates a string to its most-specific STRING-FAMILY type. A single
		# char is one -> stzChar, checked FIRST: "3" is a single char, so QQ("3")
		# is stzChar (NOT stzNumber -- converting "3" the STRING to 3 the NUMBER is
		# a coercion, StzN()/ToStzNumber()'s job, not a Q-elevation).
		if oParam.IsChar() or oParam.IsHexUnicode()
			return new stzChar(xP)

		# NOTE: these two still COERCE to non-string types (stzNumber / stzList),
		# which strictly should be stzNumberInString / stzListInString -- but those
		# classes don't exist yet. Kept as-is (option 1) until they land; then a
		# multi-char "19" -> stzNumberInString, "[1,2,3]" -> stzListInString.
		elseif oParam.IsNumberInString()
			return new stzNumber(xP)

		elseif oParam.IsListInString()
			return new stzList(StzL(xP))

		elseif StzIsDate(xP)
			return new stzDate(xP)

		end

		# stzText hasn't been ported yet -- fall back to stzString so
		# narrative chains like QQ("Ⓜ").IsCircledNumber() still resolve
		# on the string surface.
		return new stzString(xP)

	elseif IsList(xP)

		oQTemp = StzQ(xP)

		# QQ = the FIRST LOGICAL secondary type. A list of chars is a list of
		# STRINGS here (chars are single-char strings) -> stzListOfStrings; the
		# more specific stzListOfChars is QQQ's job, not QQ's.
		if oQTemp.IsListOfNumbers()
			return new stzListOfNumbers(xP)

		elseif oQTemp.IsListOfStrings()
			return new stzListOfstrings(xP)

		elseif oQTemp.IsListOfHashLists()
			return new stzListOfHashLists(xP)

		elseif oQTemp.IsListOfPairs()
			return new stzListOfPairs(xP)

		elseif oQTemp.IsListOfLists()
			return new stzListOfLists(xP)

		else
			return new stzList(xP)
		end

	else
		return StzQ(xP)
	end
end
	func QQ(xP)
		return StzQQ(xP)
	end
# QQQ = the MOST SPECIFIC type the content maps to. Past QQ's stzListOfStrings,
# a list resolves further by what the items ACTUALLY are -- today the reliably
# structurally-detectable refinement is chars -> stzListOfChars (a proper
# IsListOfDates/Bytes/Words/Regex predicate would extend this). For non-lists it
# falls back to StzQQ (whose string branch already detects char/date/number).
# NOTE: for SOLID code where the content could be ambiguous, prefer the explicit
# QRT(p, :stzExactType) over relying on QQQ's auto-detection.
func StzQQQ(xP)
	if IsList(xP)

		oQTemp = StzQ(xP)

		if oQTemp.IsListOfNumbers()
			return new stzListOfNumbers(xP)

		elseif oQTemp.IsListOfChars()
			return new stzListOfChars(xP)

		elseif oQTemp.IsListOfStrings()
			return new stzListOfstrings(xP)

		elseif oQTemp.IsListOfHashLists()
			return new stzListOfHashLists(xP)

		elseif oQTemp.IsListOfPairs()
			return new stzListOfPairs(xP)

		elseif oQTemp.IsListOfLists()
			return new stzListOfLists(xP)

		else
			return new stzList(xP)
		end

	else
		return StzQQ(xP)
	end
end
	func QQQ(xP)
		return StzQQQ(xP)
	end
#---

func StzN(xP)
	if IsNumber(xP)
		return xP

	elseif IsString(xP)

		oParam = StzQ(xP)

		if oParam.IsNumberInString()
			return Decimal(xP)

		elseif oParam.IsListInString()
			return Len( StzQ(xP).ToList() )

		else
			return StzQ(xP).NumberOfChars()
		end

	elseif IsList(xP)
		return Len(xP)

	elseif IsObject(xP)
		return Len( StzQ(xP).ObjectAttributes() )
	end
end
	func N(xP)
		return StzN(xP)
	end
	func StzNQ(xP)
		return new stzNumber( StzN(xP) )
	end
	func NQ(xP)
		return StzNQ(xP)
	end
	func QN(xP)
		return StzNQ(xP)
	end
#---

func StzS(xP)
	if IsString(xP)
		return xP

	elseif IsNumber(xP)
		return ""+ xP

	elseif IsList(xP)
		return StzQ(xP).ToCode()

	elseif IsObject(xP)
		return StzLQ(xP).ToCode()
	end
end
	func S(xP)
		return StzS(xP)
	end
	func StzSQ(xP)
		return StzQ( StzS(xP) )
	end
	func SQ(xP)
		return StzSQ(xP)
	end
	func QS(xP)
		return StzSQ(xP)
	end

