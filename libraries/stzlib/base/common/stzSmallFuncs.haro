func StzL(xP)

	if IsList(xP)
		return xP

	elseif IsString(xP)

		# 1. A range expression like  "A" : "E"  /  "v1" : "v3"  /  1.02 : 1.05
		#    (eval-free, codepoint- and decimal-aware).

		xRange = StzParseRange(xP)
		if IsList(xRange)
			return xRange
		end

		# 2. A Ring list literal written inside the string, e.g. "[ 1, 2, 3 ]"

		if StzStringQ(xP).IsListInString()
			return StzStringQ(xP).ToList()
		end

		# 3. Fallback: split the string into its characters (codepoint-safe)

		xResult = []
		nLen = StzLen(xP)
		for i = 1 to nLen
			xResult + StzMid(xP, i, 1)
		end
		return xResult

	elseif IsObject(xP)
		return StzObject(xP).ObjectAttributesAndValues()

	elseif IsNumber(xP)
		xResult = []
		for i = 1 to xP
			xResult + ""
		end

		return xResult

	else
		StzRaise("Incorrect param! Can't tranform param to list.")
	end
end
	func L(xP)
		return StzL(xP)
	end
	func StzLQ(xP)
		return new stzList(StzL(xP))
	end
	func LQ(xP)
		return StzLQ(xP)
	end
#--- RANGE EXPRESSION PARSER (eval-free) for L() / StzL()

# Expands a textual range "lhs : rhs" into the list it denotes. Returns
# NULL (not a list) when the string is not a recognizable range, so the
# caller can fall through to its other interpretations. Supports:
#   "A" : "E"          -> codepoint char range  [ "A", "B", "C", "D", "E" ]
#   "v1" : "v3"        -> numbered tokens        [ "v1", "v2", "v3" ]   (any prefix, incl. multibyte)
#   1 : 5              -> integer range
#   1.02 : 1.05        -> real range at the endpoints' decimal granularity
# It is codepoint-correct (multibyte prefixes/chars preserved) and never
# uses Ring's byte-oriented substr on the inner content.

func StzParseRange(pxStr)

	tStr = ring_trim(pxStr)
	nLen = ring_len(tStr)
	if nLen = 0
		return ""
	end

	# Locate the top-level ':' separator (not inside a double-quoted token).
	# ':' and '"' are ASCII single bytes, and every byte of a multibyte
	# UTF-8 char is >= 0x80, so a raw byte scan is safe here.

	nColon = 0
	bInQuote = false
	for i = 1 to nLen
		xC = tStr[i]
		if xC = '"'
			bInQuote = not bInQuote
		elseif xC = ':' and bInQuote = false
			nColon = i
			exit
		end
	end

	if nColon = 0
		return ""
	end

	tLhs = ring_trim( ring_left(tStr, nColon - 1) )
	tRhs = ring_trim( ring_right(tStr, nLen - nColon) )

	if ring_len(tLhs) = 0 or ring_len(tRhs) = 0
		return ""
	end

	bLhsQuoted = _IsQuotedToken(tLhs)
	bRhsQuoted = _IsQuotedToken(tRhs)

	# --- Both sides are quoted string tokens ---

	if bLhsQuoted and bRhsQuoted

		tA = _Unquote(tLhs)
		tB = _Unquote(tRhs)

		# Single codepoint on each side -> char range
		if StzLen(tA) = 1 and StzLen(tB) = 1
			return StzCharsBetween(tA, tB)
		end

		# Numbered tokens: shared prefix + trailing integer
		xA = _SplitTrailingDigits(tA)
		xB = _SplitTrailingDigits(tB)
		if xA[2] != "" and xB[2] != "" and xA[1] = xB[1]
			viNums = NumbersBetween(Decimal(xA[2]), Decimal(xB[2]))
			xResult = []
			nN = Len(viNums)
			for i = 1 to nN
				xResult + ( xA[1] + viNums[i] )
			end
			return xResult
		end

		return ""
	end

	# --- Both sides are unquoted -> numeric range ---

	if (not bLhsQuoted) and (not bRhsQuoted) and
	   _IsNumericToken(tLhs) and _IsNumericToken(tRhs)

		nDec = Max(_DecimalsOf(tLhs), _DecimalsOf(tRhs))

		if nDec = 0
			return NumbersBetween(Decimal(tLhs), Decimal(tRhs))
		end

		nFactor = Pow(10, nDec)
		nStart = Floor( (Decimal(tLhs)) * nFactor + 0.5 )
		if (Decimal(tLhs)) < 0
			nStart = Ceil( (Decimal(tLhs)) * nFactor - 0.5 )
		end
		nEnd = Floor( (Decimal(tRhs)) * nFactor + 0.5 )
		if (Decimal(tRhs)) < 0
			nEnd = Ceil( (Decimal(tRhs)) * nFactor - 0.5 )
		end

		nStep = 1
		if nStart > nEnd nStep = -1 end

		xResult = []
		for k = nStart to nEnd step nStep
			xResult + ( k / nFactor )
		end
		return xResult
	end

	return ""
end
#--- range-parser local helpers

# A BARE `n` HERE CLOBBERED THE CALLER'S GLOBAL `n` (the global-capture
# trap: a plain assignment in a func BINDS an existing global of that
# name rather than creating a local). A user script holding `n = 44`
# got it silently rewritten to the length of whatever token these
# helpers were parsing. Sigil'd, like every other local in the library.
func _IsQuotedToken(xC)
	xN = ring_len(xC)
	if xN >= 2 and xC[1] = '"' and xC[xN] = '"'
		return true
	end
	return false
end
func _Unquote(xC)
	xN = ring_len(xC)
	if xN >= 2 and xC[1] = '"' and xC[xN] = '"'
		return ring_substr2(xC, 2, xN - 2)   # inner bytes between the ASCII quotes; multibyte kept intact
	end
	return xC
end
# Returns [ prefix, trailingDigitsAsString ]. Digits are ASCII so a
# backward byte scan stops cleanly at the first non-digit byte, leaving
# any multibyte prefix untouched.
func _SplitTrailingDigits(xC)
	xN = ring_len(xC)
	nCut = xN
	while nCut >= 1
		nK = Ascii(xC[nCut])
		if nK >= 48 and nK <= 57   # ASCII '0'..'9'
			nCut--
		else
			exit
		end
	end
	if nCut = xN
		return [ xC, "" ]
	end
	tPrefix = ""
	if nCut >= 1 tPrefix = ring_left(xC, nCut) end
	tDigits = ring_right(xC, xN - nCut)
	return [ tPrefix, tDigits ]
end
func _IsNumericToken(xC)
	xN = ring_len(xC)
	if xN = 0 return 0 end
	nI = 1
	if xC[1] = "-" or xC[1] = "+"
		nI = 2
	end
	if nI > xN return 0 end
	bDigitSeen = false
	bDotSeen = false
	while nI <= xN
		nK = Ascii(xC[nI])
		if nK >= 48 and nK <= 57   # ASCII '0'..'9'
			bDigitSeen = true
		elseif nK = 46               # ASCII '.'
			if bDotSeen return 0 end
			bDotSeen = true
		else
			return 0
		end
		nI++
	end
	return bDigitSeen
end
func _DecimalsOf(xC)
	nDot = ring_substr1(xC, ".")
	if nDot = 0
		return 0
	end
	return ring_len(xC) - nDot
end
#---

func StzLN(xP)

	if  IsPair(xP) and
	    IsPair(xP[1]) and IsPair(xP[2]) and
	    IsString(xP[1][1]) and IsString(xP[2][1]) and
	    xP[1][1] = :From and xP[2][1] = :To and
	    IsNumber(xP[1][2]) and IsNumber(xP[2][2])

		return NumbersBetween(xP[1][2], xP[2][2])

	elseif IsList(xP)
		xResult = []
		nLen = Len(xP)
		for i = 1 to nLen
			if IsNumber(xP[i])
				xResult + xP[i]
			end
		end
		return xResult

	elseif IsString(xP) and StzQ(xP).IsListInString()
		xResult = StzQ(xP).ToListQ().OnlyNumbers()
		return xResult

	elseif IsNumber(xP)
		xResult = []
		for i = 1 to xP
			xResult + 0
		end
		return xResult
	end
end
	func LN(xP)
		return StzLN(xP)
	end
	func StzLNQ(xP)
		return StzQ(StzLN(xP))
	end
	func LNQ(xP)
		return StzLNQ(xP)
	end
	func QLN(xP)
		return StzLNQ(xP)
	end
	func StzLoN(xP)
		return StzLN(xP)
	end
	func LoN(xP)
		return StzLN(xP)
	end
	func LoNQ(xP)
		return StzLNQ(xP)
	end
