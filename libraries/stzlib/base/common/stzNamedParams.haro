  #/////////////////
 #/  CHECKPARAM  ///
#/////////////////

func StzCheckParam(pxValue, xP2, xP3)

	if IsList(xP2) and Len(xP2) = 2 and IsString(xP2[1]) and xP2[1] = :Skipping
		vtSkipping = xP2[2]
	else
		vtSkipping = xP2
	end

	if IsList(xP3) and Len(xP3) = 2 and IsString(xP3[1]) and xP3[1] = :MustBe
		tMustBe = xP3[2]
	else
		tMustBe = xP3
	end

	if IsList(pxValue) and Len(pxValue) = 2 and IsString(pxValue[1])
		tKey = StzLower(pxValue[1])
		nLen = Len(vtSkipping)
		for i = 1 to nLen
			if tKey = StzLower(vtSkipping[i])
				pxValue = pxValue[2]
				exit
			end
		end
	end

	if CheckingParams()
		bOk = _CheckType(pxValue, tMustBe)
		if not bOk
			StzRaise("Incorrect param type! " +
				 "Expected " + tMustBe + ".")
		end
	end

	return pxValue
end
	func CheckParam(pxValue, xP2, xP3)
		return StzCheckParam(pxValue, xP2, xP3)
	end
  #//////////////////////
 #/  CHECKPARAM (CS)  ///
#//////////////////////

func StzCheckParamCS(pxValue)
	if IsList(pxValue) and Len(pxValue) = 2 and IsString(pxValue[1])
		tKey = StzLower(pxValue[1])
		if tKey = "casesensitive" or tKey = "cs"
			pxValue = pxValue[2]
		end
	end

	if not IsNumber(pxValue)
		if CheckingParams()
			StzRaise("Incorrect param type! " +
				 "CaseSensitive must be a number (0 or 1).")
		end
		return 1
	end

	return pxValue
end
	func CheckParamCS(pxValue)
		return StzCheckParamCS(pxValue)
	end
  #//////////////////////////
 #/  NAMED PARAM CHECKS  ///
#//////////////////////////

func StzIsNamedParamList(pxList)
	if not IsList(pxList)
		return false
	end

	if Len(pxList) != 2
		return false
	end

	if not IsString(pxList[1])
		return false
	end

	return ring_find($vtStzNamedParams, StzLower(pxList[1])) > 0
end
	func IsNamedParamList(pxList)
		return StzIsNamedParamList(pxList)
	end
func StzIsThisNamedParam(pxList, tKeyword)
	if not IsList(pxList)
		return false
	end

	if Len(pxList) != 2
		return false
	end

	if not IsString(pxList[1])
		return false
	end

	if StzLower(pxList[1]) = StzLower(tKeyword)
		return true
	end

	return false
end
	func IsThisNamedParam(pxList, tKeyword)
		return StzIsThisNamedParam(pxList, tKeyword)
	end
func StzIsOneOfTheseNamedParamsList(pxList, pxKeywords)
	if not IsList(pxList)
		return false
	end

	if Len(pxList) != 2
		return false
	end

	if not IsString(pxList[1])
		return false
	end

	tParam = StzLower(pxList[1])
	nLen = Len(pxKeywords)

	for i = 1 to nLen
		if tParam = StzLower(pxKeywords[i])
			return true
		end
	end

	return false
end
	func IsOneOfTheseNamedParamsList(pxList, pxKeywords)
		return StzIsOneOfTheseNamedParamsList(pxList, pxKeywords)
	end
  #///////////////////////
 #/  TYPE CHECK LOGIC  ///
#///////////////////////

func _CheckType(pxValue, tExpected)
	switch tExpected
	case :string
		return IsString(pxValue)
	case :number
		return IsNumber(pxValue)
	case :list
		return IsList(pxValue)
	case :object
		return IsObject(pxValue)
	case :string_or_number
		return IsString(pxValue) or IsNumber(pxValue)
	case :number_or_string
		return IsString(pxValue) or IsNumber(pxValue)
	case :string_or_list
		return IsString(pxValue) or IsList(pxValue)
	case :list_or_string
		return IsString(pxValue) or IsList(pxValue)
	case :any
		return true
	else
		return true
	end
end
  #////////////////////////////////
 #/  SPECIFIC PARAM CHECKERS  ///
#////////////////////////////////

func StzIsOfNamedParamList(pxList)
	if not IsList(pxList) return false end
	if Len(pxList) != 2 return false end
	if not IsString(pxList[1]) return false end
	return pxList[1] = :Of
end
	func IsOfNamedParamList(pxList)
		return StzIsOfNamedParamList(pxList)
	end
func StzIsCaseSensitiveNamedParamList(pxList)
	if not IsList(pxList) return false end
	if Len(pxList) != 2 return false end
	if not IsString(pxList[1]) return false end
	if not IsNumber(pxList[2]) return false end
	if not (pxList[1] = :CaseSensitive or pxList[1] = :CS) return false end
	if not (pxList[2] = 0 or pxList[2] = 1) return false end
	return true
end
	func IsCaseSensitiveNamedParamList(pxList)
		return StzIsCaseSensitiveNamedParamList(pxList)
	end
func StzIsAndNamedParamList(pxList)
	if not IsList(pxList) return false end
	if Len(pxList) != 2 return false end
	if not IsString(pxList[1]) return false end
	return pxList[1] = :And or pxList[1] = :And@
end
	func IsAndNamedParamList(pxList)
		return StzIsAndNamedParamList(pxList)
	end
func StzIsWithOrByNamedParamList(pxList)
	if not IsList(pxList) return false end
	if Len(pxList) != 2 return false end
	if not IsString(pxList[1]) return false end
	tKey = pxList[1]
	return tKey = :With or tKey = :With@ or tKey = :By or tKey = :By@
end
	func IsWithOrByNamedParamList(pxList)
		return StzIsWithOrByNamedParamList(pxList)
	end
func StzIsToNamedParamList(pxList)
	if not IsList(pxList) return false end
