func StzStartingAt(xP)
	if IsNumber(xP)
		return xP

	elseif IsString(xP)
		xP = StzLower(xP)

		if xP = :first
			return 1

		elseif xP = :Last
			# do nothing

		else
			StzRaise("Incorrect param type! p, when it is a string, must be a equal to :First or :Last")
		end

	elseif IsList(xP)
		if Len(xP) = 2 and Q(xP).IsStartingAtNamedParam()
			return xP[2]

		else
			StzRaise("Incorrect param! p, when it is a list, must be a named param of the form :StartingAt = number.")
		end
	end

	StzRaise("Incorrect param type! p must be string or a list containing a named param.")
end
	func StartingAt(xP)
		return StzStartingAt(xP)
	end
	func @StartingAt(xP)
		return StzStartingAt(xP)
	end
func StzStoppingAt(xP)
	if IsNumber(xP)
		return xP

	elseif IsString(xP)
		xP = StzLower(xP)

		if xP = :first
			return 1

		elseif xP = :Last
			# do nothing

		else
			StzRaise("Incorrect param type! p, when it is a string, must be a equal to :First or :Last")
		end

	elseif IsList(xP)
		if Len(xP) = 2 and Q(xP).IsStoppingAtNamedParam()
			return xP[2]

		else
			StzRaise("Incorrect param! p, when it is a list, must be a named param of the form :StoppingAt = number.")
		end
	end

	StzRaise("Incorrect param type! p must be string or a list containing a named param.")
end
	func StoppingAt(xP)
		return StzStoppingAt(xP)
	end
	func @StoppingAt(xP)
		return StzStoppingAt(xP)
	end
	func EndingAt(xP)
		return StzStoppingAt(xP)
	end
	func @EndingAt(xP)
		return StzStoppingAt(xP)
	end
#==

func StzBounds(pxBounds)

	if not ( IsString(pxBounds) or ( IsList(pxBounds) and Len(pxBounds) = 2 and IsString(pxBounds[1]) ) )
			StzRaise("Incorrect param type! pBounds must be a string or a list of two strings.")
	end

	if IsString(pxBounds)
		return [ pxBounds, pxBounds ]
	end

	# Now, pBounds is a list of two items where 1st item is a string

	xP1 = pxBounds[1]
	xP2 = pxBounds[2]

	if IsList(xP2) and IsAndNamedParamList(xP2)
		xP2 = xP2[2]
	end

	if not IsString(xP2)
		StzRaise("Incorrect param type! The second item of pBounds must be also a string.")
	end

	return [ xP1, xP2 ]
end
	func Bounds(pxBounds)
		return StzBounds(pxBounds)
	end
	func @Bounds(pxBounds)
		return StzBounds(pxBounds)
	end
#--

func StzDirection(xP)
	if IsString(xP)

		xP = StzLower(xP)

		if xP = :Forward or xP = :Backward
			return xP

		else
			StzRaise("Incorrect param! p must be a string containing :Forward or :Backward.")
		end

	elseif IsList(xP)
		if Len(xP) = 2 and Q(xP).IsDirectionOrGoingNamedParam()
			return xP[2]

		else
			StzRaise("Incorrect param! p must be a named param containing :Forward or :Backward.")
		end

	end

	StzRaise("Incorrect param type! p must be string or a list containing a named param.")
end
	func Direction(xP)
		return StzDirection(xP)
	end
	func @Direction(xP)
		return StzDirection(xP)
	end
