func StzBothAreCharsInComputableForm(xP1, xP2)
	if IsList(xP2) and Q(xP2).IsAndNamedParam()
		xP2 = xP2[2]
	end

	bResult = false

	if BothAreStringsInComputableForm(xP1, xP2)
		tC1 = '"'
		tC2 = "'"

		tClean1 = StzReplace(StzReplace(xP1, tC1, ""), tC2, "")
		bOk1 = (Len(tClean1) = 1)
		tClean2 = StzReplace(StzReplace(xP2, tC1, ""), tC2, "")
		bOk2 = (Len(tClean2) = 1)

		if bOk1 and bOk2
			bResult = true
		end
	end

	return bResult
end
	func BothAreCharsInComputableForm(xP1, xP2)
		return StzBothAreCharsInComputableForm(xP1, xP2)
	end
	func AreBothCharsInComputableForm(xP1, xP2)
		return StzBothAreCharsInComputableForm(xP1, xP2)
	end
	func @BothAreCharsInComputableForm(xP1, xP2)
		return StzBothAreCharsInComputableForm(xP1, xP2)
	end
	func @AreBothCharsInComputableForm(xP1, xP2)
		return StzBothAreCharsInComputableForm(xP1, xP2)
	end
func StzBothAreStringsInComputableForm(xP1, xP2)
	if IsList(xP2) and Q(xP2).IsAndNamedParam()
		xP2 = xP2[2]
	end

	tC1 = '"'
	tC2 = "'"

	if BothAreStrings(xP1, xP2) and

	   ( ( Q(xP1).FirstChar() = tC1 and Q(xP1).LastChar() = tC1 ) or
	     ( Q(xP1).LastChar()  = tC2 and Q(xP1).LastChar() = tC2 ) ) and

	   ( ( Q(xP2).FirstChar() = tC1 and Q(xP2).LastChar() = tC1 ) or
	     ( Q(xP2).LastChar()  = tC2 and Q(xP2).LastChar() = tC2 ) )

		return true

	else
		return false
	end
end
	func BothAreStringsInComputableForm(xP1, xP2)
		return StzBothAreStringsInComputableForm(xP1, xP2)
	end
