#-- VizFind* default wrap width (columns). The visuals split a too-wide render
#-- into successive lines this wide. Read it with DefaultVizWidth(); change it
#-- globally with SetVizWidth(80). A width < 1 restores the 50-column default.

func DefaultVizWidth
	return $nVizWidth
end
	func VizWidth
		return $nVizWidth
	end
	func GetVizWidth
		return $nVizWidth
	end
func SetVizWidth(xN)
	if IsList(xN) and Len(xN) = 2 and IsString(xN[1])
		xN = xN[2]
	end
	if not IsNumber(xN)
		StzRaise("Can't set the Viz width! n must be a number.")
	end
	xN = Floor(xN)
	if xN < 1
		xN = 50
	end
	$nVizWidth = xN
	return $nVizWidth
end
	func SetVizWidthTo(xN)
		return SetVizWidth(xN)
	end
	func SetDefaultVizWidth(xN)
		return SetVizWidth(xN)
	end
func ResetVizWidth
	$nVizWidth = 50
	return $nVizWidth
end
