func StzBothArePairsOfObjects(xP1, xP2)
	if BothAreLists(xP1, xP2) and
	   IsList(xP1) and Q(xP1).IsPairOfObjects() and
	   IsList(xP2) and Q(xP2).IsPairOfObjects()

		return true
	else
		return false
	end
end
