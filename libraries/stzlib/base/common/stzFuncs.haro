func AttributesValues(pxObject) # Compliments Ring attributes() function
	if not IsObject(pxObject)
		Raise("Incorrect param type! pObject must be an object.")
	end

	xResult = []

	vtAttributes = Attributes(pxObject)
	nLen = Len(vtAttributes)

	for i = 1 to nLen
		xValue = GetAttribute(pxObject, vtAttributes[i])   # no eval: Haro runs no text as code
		xResult + xValue
	end

	return xResult
end
	func @AttributesValues(pxObject)
		return AttributesValues(pxObject)
	end
#====== REPEATING A VALUE N TIMES

func @N(xN, xItem)
	# EXAMPLE
	# ? @N(3 ,"A")	#--> [ "A", "A", "A" ]

	if CheckParams()
		if not IsNumber(xN)
			StzRaise("Incorrect param type! n must be a number.")
		end
	end

	return @NXT(xN, xItem, :InAList)
end
	#< @FunctionSpecificForms

	func @1(xVal)
		return @N(1, xVal)
	end
		func One(xVal)
			return @N(1, xVal)
		end
	func @2(xVal)
		return @N(2, xVal)
	end
		func Two(xVal)
			return @N(2, xVal)
		end
