func TheseNumbersQ(xP)
	
	if CheckingParams()
		if not IsList(xP)
			StzRaise("Incorrect param type! p must be a list.")
		end
	end

	$bTheseQ = true
	$bThese = false

	nLen = Len(xP)
	viResult = []

	for i = 1 to nLen
		if IsNumber(xP[i])
			viResult + xP[i]
		end
	end

	return new stzListOfNumbers(viResult)
end
