func StzSetEarlyCheck(xB)
	if CheckingParams()
		if not (IsNumber(xB) and (xB = 0 or xB = 1) )
			StzRaise("Incorrect param! b must be a boolean (1 or FALSE).")
		end
	end

	$bEarlyCheck = xB
end
