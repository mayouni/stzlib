func StzBothAreNumbers(xP1, xP2)
	if IsList(xP2) and Q(xP2).IsAndNamedParam()
		xP2 = xP2[2]
	end

	if IsNumber(xP1) and IsNumber(xP2)
		return true
	else
		return false
	end
end
	func BothAreNumbers(xP1, xP2)
		return StzBothAreNumbers(xP1, xP2)
	end
	func AreBothNumbers(xP1, xP2)
		return StzBothAreNumbers(xP1, xP2)
	end
	func @BothAreNumbers(xP1, xP2)
		return StzBothAreNumbers(xP1, xP2)
	end
	func @AreBothNumbers(xP1, xP2)
		return StzBothAreNumbers(xP1, xP2)
	end
func StzBothAreNumbersInStrings(xP1, xP2)
	if IsList(xP2) and Q(xP2).IsAndNamedParam()
		xP2 = xP2[2]
	end

	if IsString(xP1) and IsString(xP2) and
	   Q(xP1).IsNumberInString() and
	   Q(xP2).IsNumberInString()

		return true
	else
		return false
	end
end
