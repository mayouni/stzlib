# Viewing a file in the default program in the system

func StzView(tFileName)
	if CheckParams()
		if not IsString(tFileName)
			StzRaise("Incorrect param type! cFileName mlust be a string.")
		end
	end

	if FExists(tFileName)
		oSysCall = new stzSystemCall("")
		oSysCall.OpenFile(tFileName)

	else
		StzRaise("Can't proceed! The file you provided does not exist.")
	end
end
	func View(tFileName)
		StzView(tFileName)
	end
	func @View(tFileName)
		StzView(tFileName)
	end

  #//////////////////////
 #/  GLOBAL CLASSES  ///
#//////////////////////

#WARNING: Be careful! don't put global functions after theses classes,
# because Ring will consider them as methods of the classes and not global functons!

# Runs a piece of Ring code once for each item of a list, with every loop variable bound by name; the earlier form of stzForEachObject.
#
# Give the variable name or names and the data as :In = ... Then the code, passed as text to @, is
# evaluated once per item with each name bound to that item's value, one name or several. It has no
# positions and no reader function: stzForEachObject is the form to use, and this one is kept for
# older code. Values always answers a list of lists, one inner list per item.
#
#   receiver   o1 = new stzForEachObjectOld([ :A, :B ], :In = [ [ "a", 1 ], [ "b", 2 ] ])
#   example    aOut = []
#              o1.@('aOut + (A + B)')
#              ? @@( aOut )
#              #--> [ "a1", "b2" ]
#              ? @@( o1.Vars() )
#              #--> [ "a", "b" ]
#              ? o1.NumberOfIterations()
#              #--> 2
#              ? @@( o1.Values() )
#              #--> [ [ "a", 1 ], [ "b", 2 ] ]
#   see        stzForEachObject
class stzForEachObjectOld from stzObject
	@vtVars
	@xValues

	# Builds the earlier version of the loop, which runs Ring code once per item with every loop variable bound by name.
	#
	#   p          the name of the loop variable as text, or a list of names when each item is
	#              itself a list
	#   pIn        the data, written as a named parameter :In = ...
	#   returns    nothing; the object is built
	#   note       superseded by stzForEachObject, which adds positions and the v reader
	#   warning    Raises an error unless pIn is written as :In = ...; a single name wraps each item
	#              in a list of one, so Values answers [ [ 1 ], [ 2 ] ] for [ 1, 2 ]
	#   see        @, stzForEachObject
	def init(xP, pxIn)

		# Checking params
	
		if IsList(pxIn) and Q(pxIn).IsInNamedParam()
			pxIn = pxIn[2]
		else
			StzRaise("Syntax error! pIn must be a named param of the form :In = ...")
		end
	
		if not ( IsString(xP) or ( IsList(xP) and @IsListOfStrings(xP) ) )
			StzRaise("Incorrect param type! p must be a string or a list of strings.")
		end
	
		if not (IsList(pxIn) or IsString(pxIn))
			StzRaise("Incorrect param type! pIn must be a string or list.")
		end
	
		if IsString(pxIn) and IsList(xP)
			StzRaise("Incorrect params! pIn can't be a string when p is a List.")
		end
	
		if IsList(xP)
			nLen = Len(xP)
			
			if not IsListOfLists(pxIn)
				StzRaise("Incorrect param! pIn must be a list of lists containing " + String(nLen) + " items in each list.")
			end
	
			if not StzListOfListsQ(pxIn).SizeOfEach@Is(nLen)
	
				StzRaise("Syntax error! Each list in pIn must have the same size as the number of params in p.")
			end
	
		end
	
		if IsString(xP)
			vTemp = []
			vTemp + xP
			xP = vTemp

			if IsList(pxIn)
				nLen = Len(pxIn)
				vTemp = []
				for i = 1 to nLen
					vTemp + [ pxIn[i] ]
				end
				pxIn = vTemp
			end
		end

		@vtVars = xP
 		@xValues = pxIn
	end
	# Returns the names of the loop variables, in lowercase.
	#
	#   returns    a list of text, such as [ "a", "b" ]
	#   see        NumberOfVars, Values
	def Vars
		return @vtVars
	end
		def VarNames
			return this.Vars()
		end
	# Returns how many loop variables the loop has.
	#
	#   returns    a number
	#   see        Vars
	def NumberOfVars
		return Len(@vtVars)
	end
		def NumbersOfVarNames
			return this.NumberOfVars()
		end
		def HowManyVars
			return this.NumberOfVars()
		end
		def HowManyVar
			return this.NumberOfVars()
		end
		def HowManyVarNames
			return this.NumberOfVars()
		end
		def HowManyVarName
			return this.NumberOfVars()
		end
	# Returns the data as a list of items, each item a list holding one value per variable.
	#
	#   returns    a list of lists, such as [ [ 1 ], [ 2 ] ] for one variable
	#   see        NumberOfIterations, Vars
	def VALUES
		return @xValues
	end
	# Returns how many items the loop will go through.
	#
	#   returns    a number
	#   see        Values
	def NumberOfIterations
		return Len(@xValues)
	end
		def NumberOfValues
			return this.NumberOfIterations()
		end
		def HowManyIterations
			return this.NumberOfIterations()
		end
		def HowManyIteration
			return this.NumberOfIterations()
		end
		def HowManyValues
			return this.NumberOfIterations()
		end
		def HowManyValue
			return this.NumberOfIterations()
		end
	# Calls a function once for each item, with the item's values as its arguments, one per loop variable.
	#
	#   pFunc      a function, such as func a, b { ? a + b }; code as text is refused (Haro runs no
	#              text as code)
	#   returns    nothing
	#   see        Vars, Values
	def @(pxFunc)
		StzRequireFunction(pxFunc, "The loop body")
		nItems = Len(@xValues)
		for i = 1 to nItems
			_StzCallWithValues(pxFunc, @xValues[i])
		end
end
	end
# Runs a piece of Ring code once for each item of a list, binding the item's values to named loop variables.
#
# Build it with @ForEach(p, pIn), giving the variable name or names and the data as :In = ... Then
# Exec (or Run, X, @) takes the code as text and evaluates it once per item. With several names,
# each item of the list is a list and every name is a variable inside the code; with one name, read
# the item through v(:Name), because the name itself is not bound. ExecN runs the code only at
# chosen positions, and @SetIterations narrows every later Exec to a list of positions. The code is
# evaluated inside the object, so collect results in a global variable. A text can be walked with a
# single name, but byte by byte, and an empty list or text raises an index error when run.
#
#   receiver   o1 = new stzForEachObject([ :Char, :Number ], :In = [ [ "A", 1 ], [ "B", 2 ], [ "C",
#              3 ] ])
#   example    aOut = []
#              o1.Exec('aOut + (Char + Number)')
#              ? @@( aOut )
#              #--> [ "A1", "B2", "C3" ]
#              aOut = []
#              o1.ExecN([ 3, 1 ], 'aOut + v(:Char)')
#              ? @@( aOut )
#              #--> [ "C", "A" ]
#              ? @@( o1.@Vars() )
#              #--> [ "char", "number" ]
#              ? o1.@NumberOfIterations()
#              #--> 3
#              ? @@( o1.@Content() )
#              #--> [ [ "char", [ "A", "B", "C" ] ], [ "number", [ 1, 2, 3 ] ] ]
#              o1.@SetIterations([ 2 ])
#              aOut = []
#              o1.Exec('aOut + v(:Number)')
#              ? @@( aOut )
#              #--> [ 2 ]
#   see        @ForEach, stzForEachObjectOld, stzListOfLists
class stzForEachObject from stzObject
	@vtVars
	@xValues

	@xDataVars
	@iI

	@xIterations

	# Builds a loop over a list or a text that runs a piece of Ring code once per item, with one or several loop variables.
	#
	#   p          the name of the loop variable as text, or a list of names when each item is
	#              itself a list
	#   pIn        the data, written as a named parameter :In = ... holding a list (or a text, for a
	#              single variable)
	#   returns    nothing; the object is built
	#   note       use @ForEach(p, pIn) to build it
	#   warning    Raises an error unless pIn is written as :In = ...; with several names every item
	#              of the list must be a list with as many values as there are names; a text can
	#              only be used with a single name and is walked byte by byte, so a multi-byte
	#              letter splits into broken pieces; an empty list or text builds the loop, but
	#              running it raises an index error
	#   see        Exec, ExecN, v
	def init(xP, pxIn)

		# Checking params
	
		if IsList(pxIn) and Q(pxIn).IsInNamedParam()
			pxIn = pxIn[2]
		else
			StzRaise("Syntax error! pIn must be a named param of the form :In = ...")
		end
	
		if not ( IsString(xP) or ( IsList(xP) and @IsListOfStrings(xP) ) )
			StzRaise("Incorrect param type! p must be a string or a list of strings.")
		end
	
		if not (IsList(pxIn) or IsString(pxIn))
			StzRaise("Incorrect param type! pIn must be a string or list.")
		end
	
		if IsString(pxIn) and IsList(xP)
			StzRaise("Incorrect params! pIn can't be a string when p is a List.")
		end
	
		if IsList(xP)
			nLen = Len(xP)

			if not IsListOfLists(pxIn)
				StzRaise("Incorrect param! pIn must be a list of lists containing " + String(nLen) + " items in each list.")
			end
	
			if not StzListOfListsQ(pxIn).SizeOfEach@Is(nLen)
	
				StzRaise("Syntax error! Each list in pIn must have the same size as the number of params in p.")
			end
	
		end
	
		if IsString(xP)
			@xIterations = 1 : Len(pxIn)

			vTemp = []
			vTemp + [ xP, pxIn ]
			xP = vTemp
			@xDataVars = xP

			@xValues = @xDataVars[1][2]
			
		else

			@vtVars = xP
	 		@xValues = pxIn
	
			@xDataVars = []
	
			nPLen = Len(xP)
			for i = 1 to nPLen
				@xDataVars + [ xP[i], [] ]
			end
	
	
			nDataVarsLen = Len(@xDataVars)
			for i = 1 to nDataVarsLen
				nValuesLen = Len(@xValues)
				for j = 1 to nValuesLen
					@xDataVars[i][2] + @xValues[j][i]
				end
			end

			@xIterations = 1 : Len(@xValues)
		end
	end
	

	# Returns the names of the loop variables, in lowercase.
	#
	#   returns    a list of text, such as [ "char", "number" ]
	#   see        @NumberOfVars, @Content
	def @Vars
		if this.@NumberOfVars() = 1
			return [ @xDataVars[1][1] ]

		else
			return @vtVars
		end
	end
		# Returns the names of the loop variables, in lowercase.
		#
		#   returns    a list of text, such as [ "item" ]
		#   see        @NumberOfVars, @Content
		def @VarNames
			return this.@Vars()
		end
	# Returns how many loop variables the loop has.
	#
	#   returns    a number
	#   see        @Vars
	def @NumberOfVars
		return Len(this.@VarsXT())
	end
		# Returns how many loop variables the loop has.
		#
		#   returns    a number
		#   see        @Vars
		def @NumbersOfVarNames
			return this.@NumberOfVars()
		end
	# Returns the data exactly as it was given in the :In = ... part.
	#
	#   returns    the list, or the text, given at construction
	#   see        @Content, @NumberOfIterations
	def @Values
		return @xValues
	end
	# Returns each loop variable paired with the list of all its values, one pair per variable.
	#
	#   returns    a list of pairs, such as [ [ "char", [ "A", "B" ] ], [ "number", [ 1, 2 ] ] ]
	#   see        @Values, @Vars
	def @Content
		return @xDataVars
	end
		# Returns each loop variable paired with the list of all its values.
		#
		#   returns    a list of pairs such as [ [ "item", [ "a", "b" ] ] ]
		#   see        @Content
		#< @FunctionAlternativeForms
		def @VarValues
			return this.@Content()
		end
		# Returns each loop variable paired with the list of all its values.
		#
		#   returns    a list of pairs such as [ [ "item", [ "a", "b" ] ] ]
		#   see        @Content
		def @VarsAndValues
			return this.@Content()
		end
		# Returns each loop variable paired with the list of all its values.
		#
		#   returns    a list of pairs such as [ [ "item", [ "a", "b" ] ] ]
		#   see        @Content
		def @VarsAndTheirValues
			return this.@Content()
		end
		def @VarsXT
			return this.@Content()
		end
		# Returns each loop variable paired with the list of all its values.
		#
		#   returns    a list of pairs such as [ [ "item", [ "a", "b" ] ] ]
		#   see        @Content
		def @VarVal
			return this.@Content()
		end
	# Returns how many items the data holds, which is how many times a full run executes the code.
	#
	#   returns    a number; the length in bytes for a text
	#   see        @Iterations, Exec
		#>
	def @NumberOfIterations
		return Len(@xValues)
	end
		# Returns how many items the data holds.
		#
		#   returns    a number
		#   see        @NumberOfIterations
		def @NumberOfValues
			return this.@NumberOfIterations()
		end
	# Returns the position of the item the running code is on, and keeps the last one reached after the run.
	#
	#   returns    a number; the text NULL before any run
	#   see        v, Exec
	def @CurrentIteration
		return @iI
	end
		# Returns the position of the item the running code is on, and keeps the last one reached after the run.
		#
		#   returns    a number; the text NULL before any run
		#   see        @CurrentIteration
		def @CurrentIndex
			return this.@CurrentIteration()
		end
	# Restricts the next runs of Exec to these positions, in this order.
	#
	#   panPos     a list of positions in the data, such as [ 3, 1 ]
	#   returns    nothing
	#   note       it stays in force for every later Exec until set again
	#   warning    Raises an error at run time for a position beyond the data, and when panPos is a
	#              single number instead of a list
	#   see        ExecN, @NumberOfIterations
	def @SetIterations(pxPos)
		@xIterations = pxPos
	end
		# Restricts the next runs of Exec to these positions, in this order.
		#
		#   panPos     a list of positions in the data
		#   returns    nothing
		#   see        @SetIterations
		def @xIterations(pxPos)
			@SetIterations(pxPos)
		end
		# Restricts the next runs of Exec to these positions, in this order.
		#
		#   panPos     a list of positions in the data
		#   returns    nothing
		#   see        @SetIterations
		def @Scope(pxPos)
			@SetIterations(pxPos)
		end
		# Restricts the next runs of Exec to these positions, in this order.
		#
		#   panPos     a list of positions in the data
		#   returns    nothing
		#   see        @SetIterations
		def @SetScope(pxPos)
			@SetIterations(pxPos)
		end
		# Restricts the next runs of Exec to these positions, in this order.
		#
		#   panPos     a list of positions in the data
		#   returns    nothing
		#   see        @SetIterations
		def @IterateOn(pxPos)
			@SetIterations(pxPos)
		end
		# Restricts the next runs of Exec to these positions, in this order.
		#
		#   panPos     a list of positions in the data
		#   returns    nothing
		#   see        @SetIterations
		def @IterateOnThesePositions(pxPos)
			@SetIterations(pxPos)
		end
		# Restricts the next runs of Exec to these positions, in this order.
		#
		#   panPos     a list of positions in the data
		#   returns    nothing
		#   see        @SetIterations
		def @IterateOnlyOn(pxPos)
			@SetIterations(pxPos)
		end
		# Restricts the next runs of Exec to these positions, in this order.
		#
		#   panPos     a list of positions in the data
		#   returns    nothing
		#   see        @SetIterations
		def @IterateOnLyOnThesePositions(pxPos)
			@SetIterations(pxPos)
		end
	# Calls the loop's function once for each item in scope, with that item's values as its arguments.
	#
	#   pcCode     a function, called with the item's values, one argument per loop variable
	#   returns    nothing
	#   note       the code is evaluated in the method, so collect results in a global variable
	#   warning    with several variables each name is a variable inside the code (Char, Number);
	#              with a single variable the name is NOT bound and using it raises an
	#              uninitialized-variable error, so read the item with v; running over an empty list
	#              or text raises an index error
	#   see        ExecN, v, @SetIterations
	def exec(pxCode)

		if IsList(pxCode) and Len(pxCode) = 2
			ExecN(pxCode[1], pxCode[2])
			return
		end

		this._ExecAt(@xIterations, pxCode)
	end
	# Calls the loop's function at each of the positions, in order, with that item's values.
	#
	#   panPos     the positions
	#   pFunc      the function; one argument per loop variable
	#   returns    nothing
	#   see        Exec, ExecN
	def _ExecAt(pxPos, pxFunc)
		StzRequireFunction(pxFunc, "The loop body")
		nPos = Len(pxPos)
		bOne = ( this.@NumberOfVars() = 1 )
		for i = 1 to nPos
			@iI = pxPos[i]
			if bOne
				_StzCallWithValues(pxFunc, [ @xValues[@iI] ])
			else
				_StzCallWithValues(pxFunc, @xValues[@iI])
			end
		end
	end
		# Calls the loop's function once for each item in scope, with that item's values as its arguments.
		#
		#   pcCode     a function, called with the item's values
		#   returns    nothing
		#   warning    with a single loop variable use v(:Name), as the name itself is not bound
		#   see        Exec
		def Execute(pxCode)
			this.exec(pxCode)
		end
		# Calls the loop's function once for each item in scope, with that item's values as its arguments.
		#
		#   pcCode     a function, called with the item's values
		#   returns    nothing
		#   warning    with a single loop variable use v(:Name), as the name itself is not bound
		#   see        Exec
		def Run(pxCode)
			this.exec(pxCode)
		end
		# Calls the loop's function once for each item in scope, with that item's values as its arguments.
		#
		#   pcCode     a function, called with the item's values
		#   returns    nothing
		#   warning    with a single loop variable use v(:Name), as the name itself is not bound
		#   see        Exec
		def @(pxCode)
			this.exec(pxCode)
		end
		def _(pxCode)
			this.exec(pxCode)
		end
		# Calls the loop's function once for each item in scope, with that item's values as its arguments.
		#
		#   pcCode     a function, called with the item's values
		#   returns    nothing
		#   warning    with a single loop variable use v(:Name), as the name itself is not bound
		#   see        Exec
		def X(pxCode)
			this.exec(pxCode)
		end
	# Calls the loop's function only for the item at one position, or for the items at a list of positions, in the order given.
	#
	#   _n_        a position or a list of positions in the data
	#   pcCode     a function, called with the item's values
	#   returns    nothing
	#   note       the positions given here do not change the scope that Exec uses
	#   warning    a position given as text does nothing and raises no error; with a single loop
	#              variable use v(:Name)
	#   see        Exec, @SetIterations
	def ExecN(xN, pxCode)
		viPos = []

		if IsNumber(xN)
			viPos + xN

		elseif IsList(xN) and @IsListOfNumbers(xN)
			viPos = xN
		end

		this._ExecAt(viPos, pxCode)
	end
		# Calls the loop's function only for the item at one position, or for the items at a list of positions.
		#
		#   _n_        a position or a list of positions in the data
		#   pcCode     a function, called with the item's values
		#   returns    nothing
		#   see        ExecN
		def ExecuteN(xN, pxCode)
			this.ExecN(xN, pxCode)
		end
		# Calls the loop's function only for the item at one position, or for the items at a list of positions.
		#
		#   _n_        a position or a list of positions in the data
		#   pcCode     a function, called with the item's values
		#   returns    nothing
		#   see        ExecN
		def RunN(xN, pxCode)
			this.ExecN(xN, pxCode)
		end
		# Calls the loop's function only for the item at one position, or for the items at a list of positions.
		#
		#   _n_        a position or a list of positions in the data
		#   pcCode     a function, called with the item's values
		#   returns    nothing
		#   see        ExecN
		def @n(xN, pxCode)
			this.ExecN(xN, pxCode)
		end
		def _n(xN, pxCode)
			this.ExecN(xN, pxCode)
		end
		# Calls the loop's function only for the item at one position, or for the items at a list of positions.
		#
		#   _n_        a position or a list of positions in the data
		#   pcCode     a function, called with the item's values
		#   returns    nothing
		#   see        ExecN
		def Xn(xN, pxCode)
			this.ExecN(xN, pxCode)
		end
	# Returns the value of a loop variable for the item the code is on, the way to read a variable from inside the code.
	#
	#   pcVar      the name of the loop variable, such as :Item
	#   returns    the value of the variable at the current position; the last item reached after a
	#              run
	#   see        Exec, @CurrentIteration
	def V(pxVar)

		if this.@NumberOfVars() = 1
			return this.@VarsXT()[1][2][@iI]

		else
			return this.@VarsXT()[pxVar][@iI]
		end
	end
#WARNING
# DO NOT ADD GLOBAL FUNCTIONS HERE BECAUSE THIS IS A CLASS REGION

# Calls pFunc with the values of paValues as its arguments (at most 4), for the @ForEach loops.
def _StzCallWithValues(pxFunc, pxValues)
	switch Len(pxValues)
	case 0
		call pxFunc()
	case 1
		call pxFunc(pxValues[1])
	case 2
		call pxFunc(pxValues[1], pxValues[2])
	case 3
		call pxFunc(pxValues[1], pxValues[2], pxValues[3])
	case 4
		call pxFunc(pxValues[1], pxValues[2], pxValues[3], pxValues[4])
	else
		StzRaise("Can't call the loop body! At most 4 loop variables are passed.")
	end
end
end
