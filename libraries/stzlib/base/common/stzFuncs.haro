func StzFindCS(pxThing, pxIn, pxCaseSensitive)

	# :In marks the HAYSTACK and is natural only AFTER the needle:
	# StzFind(needle, :In = haystack) == "find needle in haystack".
	if IsList(pxIn) and StzIsInNamedParamList(pxIn)
		pxIn = pxIn[2]
	end

	# String haystack -> ONE engine call for ALL positions.
	#
	# This was a Ring loop calling FindFirstFrom once per hit, which was
	# wrong twice over:
	#
	#   OVERLAPPING. It advanced by the needle's LENGTH after each hit, so
	#   StzFindCS("aa", "aaaa") answered [1, 3] while the class surface,
	#   stzString("aaaa").Find("aa"), answered [1, 2, 3]. Two spellings of
	#   one operation disagreeing. Overlapping is the Softanza behaviour
	#   (see the BoundedBy family, which relies on it), so the global was
	#   the outlier -- the engine primitive had it right all along.
	#
	#   COST. n matches meant n crossings, and each call re-resolved its
	#   start position, which made collecting all occurrences quadratic.
	#
	# str_find_cs walks the string ONCE, counting codepoints incrementally,
	# and hands back every position. Both problems are the same fix.
	if IsString(pxIn) and IsString(pxThing) and pxThing != ""
		bCase = CaseSensitive(pxCaseSensitive)
		xH = StzEngineString(pxIn)
		# THE DRAIN STAYS HERE, and only here -- measured, not assumed.
		#
		# stzString.FindCS uses the bulk StzEngineStringFindPositionsCS and is
		# 1.40x faster for it, because it holds a PERSISTENT @pEngine and can
		# `return <bulk call>` with nothing in between. This function cannot:
		# its handle is temporary and must be freed before returning, which
		# forces `_a_ = bulk(...)` / free / `return _a_` -- and that
		# intermediate assignment copies the whole list. The in-place drain
		# below builds the list once and copies it once.
		#
		# Same operation, opposite answers, for a reason that is entirely
		# about handle LIFETIME rather than about find:
		#
		#     class  (persistent handle)  361 -> 258 ms   bulk WINS 1.40x
		#     global (temp handle)        237 -> 325 ms   bulk LOSES 1.37x
		#
		# 5 runs each; the first 2-run reading of this was noise in both
		# directions and said the opposite for the class.
		xFcRes = StzEngineStringFindCS(xH, pxThing, StzBoolAsNumber(bCase))
		xResult = []
		nFcCount = StzEngineFindResultCount(xFcRes)
		for nFcI = 1 to nFcCount
			xResult + StzEngineFindResultGet(xFcRes, nFcI)
		end
		StzEngineFindResultFree(xFcRes)
		StzEngineStringFree(xH)
		return xResult
	end

	# Canonical (needle, haystack): list haystack -> engine-backed find-all
	# (stzList.FindCS routes to the Zig stz_list_find_cs / *_string_cs / *_int
	# / *_held_cs paths -- O(n) with no per-item Ring stringify).
	if IsList(pxIn)
		return StzListQ(pxIn).FindCS(pxThing, CaseSensitive(pxCaseSensitive))
	end

	# Backward-compat (haystack, needle) for list-first callers:
	# pThing is the list, paIn the item -> find paIn in pThing (engine-backed).
	if IsList(pxThing)
		return StzListQ(pxThing).FindCS(pxIn, CaseSensitive(pxCaseSensitive))
	end

	return []
end
# StzFindFirstCS / StzFindFirst -- the FIRST position only (single number, 0 if
# not found). This is the COMPATIBILITY surface preserving the historical
# (polymorphic) StzFind behavior exactly, so callers renamed from StzFind keep
# working unchanged:
#   - StzFindFirst(item, list)        -> find item in list   (needle, haystack)
#   - StzFindFirst(list, item)        -> find item in list   (haystack, needle)
#   - StzFindFirst(haystackStr, sub)  -> find sub in haystack (two-string: p1 is
#                                        the haystack, p2 the needle).
# The canonical StzFind / StzFindCS instead return the full LIST of positions of
# the NEEDLE (first arg) in the HAYSTACK (second arg).
func StzFindFirstCS(xP1, xP2, pxCaseSensitive)

	# Natural :In form -- StzFindFirst(needle, :In = haystack) -- resolves via
	# the canonical StzFindCS and takes the first hit. (:In before the needle is
	# not natural language and is not supported.) The legacy positional behavior
	# below handles the no-:In calls.
	if IsList(xP2) and StzIsInNamedParamList(xP2)
		xFfPos = StzFindCS(xP1, xP2, pxCaseSensitive)
		if IsList(xFfPos) and Len(xFfPos) > 0 return xFfPos[1] end
		return 0
	end

	# p2 is a list -> find p1 in p2. Route through the engine (StzFindCS) so a
	# LIST needle is matched structurally (Ring's "=" does not deep-compare lists).
	if IsList(xP2)
		xFfPos = StzFindCS(xP1, xP2, pxCaseSensitive)
		if IsList(xFfPos) and Len(xFfPos) > 0 return xFfPos[1] end
		return 0
	end

	# p1 is a list -> find p2 in p1 (backward-compat haystack-first). Engine-backed
	# too, so a LIST needle (p2) is matched structurally.
	if IsList(xP1)
		xFfPos = StzFindCS(xP2, xP1, pxCaseSensitive)
		if IsList(xFfPos) and Len(xFfPos) > 0 return xFfPos[1] end
		return 0
	end

	# Both strings -> find p1 (needle/substr) in p2 (container), NEEDLE-FIRST,
	# matching StzFind/StzFindCS and the library-wide (item/substr, container)
	# convention. (Historically this path was haystack-first -- swapped 2026-07-18
	# together with a library-wide caller migration.)
	if IsString(xP1) and IsString(xP2) and xP1 != ""
		bCase = CaseSensitive(pxCaseSensitive)
		xH = StzEngineString(xP2)
		nPos = StzEngineStringFindFirstFromCS(xH, xP1, 1, StzBoolAsNumber(bCase))
		StzEngineStringFree(xH)
		if nPos > 0 return nPos end
	end

	return 0
end
	func @StzFindFirstCS(xP1, xP2, pxCaseSensitive)
		return StzFindFirstCS(xP1, xP2, pxCaseSensitive)
	end
func StzFindFirst(pxThing, pxIn)
	return StzFindFirstCS(pxThing, pxIn, 1)
end
	func @StzFindFirst(pxThing, pxIn)
		return StzFindFirst(pxThing, pxIn)
	end
# StzFindLast / StzFindNth -- same (pSubStrOrItem, pStrOrList) convention as
# StzFindFirst: the substring/item to find comes FIRST, the container (a string
# or a list) SECOND. The container may also be written [ :In, container ] for
# expressiveness. They delegate to the canonical StzFindCS (all positions).

func StzFindLastCS(pxSubStrOrItem, pxStrOrList, pxCaseSensitive)
	xPos = StzFindCS(pxSubStrOrItem, pxStrOrList, pxCaseSensitive)
	if IsList(xPos) and Len(xPos) > 0
		return xPos[ Len(xPos) ]
	end
	return 0
end
	func @StzFindLastCS(pxSubStrOrItem, pxStrOrList, pxCaseSensitive)
		return StzFindLastCS(pxSubStrOrItem, pxStrOrList, pxCaseSensitive)
	end
func StzFindLast(pxSubStrOrItem, pxStrOrList)
	return StzFindLastCS(pxSubStrOrItem, pxStrOrList, 1)
end
	func @StzFindLast(pxSubStrOrItem, pxStrOrList)
		return StzFindLast(pxSubStrOrItem, pxStrOrList)
	end
func StzFindNthCS(pxSubStrOrItem, pxStrOrList, xN, pxCaseSensitive)
	if not IsNumber(xN) return 0 end
	xPos = StzFindCS(pxSubStrOrItem, pxStrOrList, pxCaseSensitive)
	if IsList(xPos) and xN >= 1 and Len(xPos) >= xN
		return xPos[ xN ]
	end
	return 0
end
	func @StzFindNthCS(pxSubStrOrItem, pxStrOrList, xN, pxCaseSensitive)
		return StzFindNthCS(pxSubStrOrItem, pxStrOrList, xN, pxCaseSensitive)
	end
func StzFindNth(pxSubStrOrItem, pxStrOrList, xN)
	return StzFindNthCS(pxSubStrOrItem, pxStrOrList, xN, 1)
end
	func @StzFindNth(pxSubStrOrItem, pxStrOrList, xN)
		return StzFindNth(pxSubStrOrItem, pxStrOrList, xN)
	end
# StzFind / StzFindCS ALWAYS return the LIST of all positions of pThing (needle)
# in paIn (haystack), or an empty list if not found. Engine-backed; works for
# string and list haystacks. For a single position use StzFindFirst.
func StzFind(pxThing, pxIn)
	return StzFindCS(pxThing, pxIn, 1)
end
	func @StzFind(pxThing, pxIn)
		return StzFind(pxThing, pxIn)
	end
