  #////////////////////////
 #/  GLOBAL FUNCTIONS  ///
#////////////////////////

# NEEDLE FIRST -- StzFindAll(what, wherein) -- like every other member of
# this family: StzFind, StzFindFirst, StzFindLast and StzFindNth all take
# the thing being looked FOR first.
#
# THESE TWO USED TO BE THE OTHER WAY ROUND, alone in the family, and the
# mismatch could not be noticed by anyone calling them: both parameters
# accept a string, so a needle-first call searched the NEEDLE for the
# HAYSTACK, found nothing, and answered [] -- "not found". A wrong argument
# order that raises costs a minute; one that answers "not found" is a bug in
# the caller's logic that looks like data.
#
# It was found by a guard whose own instrument was the victim: an assertion
# that "no cylinder cap is deeper than it is wide" scanned an SVG using
# StzFindAll, got [] for a tag that was plainly there, and so PASSED while
# reading a canvas that contained a deliberately broken cap.
#
# Safe to align: outside the alias forwarders just below, the whole library
# had no caller of either name.
func StzFindAllCS(pxThing, pxContainer, pxCaseSensitive)
	xVal = pxThing
	if CheckParams()
		if not (IsString(pxContainer) or IsList(pxContainer))
			StzRaise("Incorrect param type! the container searched must be " +
				"a string or list -- StzFindAll takes what you are looking " +
				"FOR first, then what to look IN.")
		end
	end

	if IsString(pxContainer)
		return StzStringQ(pxContainer).FindCS(xVal, pxCaseSensitive)

	else
		# Engine-backed find for string items
		if IsString(xVal)
			xFacList = StzEngineMarshalList(pxContainer)
			xFacResult = StzEngineListFindAllStringCS(xFacList, xVal, CaseSensitive(pxCaseSensitive))
			StzEngineListFree(xFacList)
			if xFacResult != ""
				xFacPositions = StzEngineContentFromList(xFacResult)
				StzEngineListFree(xFacResult)
				return xFacPositions
			end
			return []
		end

		# Fallback for non-string items
		xResult = []
		nLen = Len(pxContainer)
		for i = 1 to nLen
			if BothAreEqualCS(pxContainer[i], xVal, pxCaseSensitive)
				xResult + i
			end
		end
		return xResult
	end
end
	func FindCS(pxThing, pxContainer, pxCaseSensitive)
		return StzFindAllCS(pxThing, pxContainer, pxCaseSensitive)
	end
	func @FindCS(pxThing, pxContainer, pxCaseSensitive)
		return StzFindAllCS(pxThing, pxContainer, pxCaseSensitive)
	end
	func FindAllCS(pxThing, pxContainer, pxCaseSensitive)
		return StzFindAllCS(pxThing, pxContainer, pxCaseSensitive)
	end
	func @FindAllCS(pxThing, pxContainer, pxCaseSensitive)
		return StzFindAllCS(pxThing, pxContainer, pxCaseSensitive)
	end
func StzFindAll(pxThing, pxContainer)
	return StzFindAllCS(pxThing, pxContainer, 1)
end
	func @Find(pxThing, pxContainer)
		return StzFindAll(pxThing, pxContainer)
	end
	func FindAll(pxThing, pxContainer)
		return StzFindAll(pxThing, pxContainer)
	end
	func @FindAll(pxThing, pxContainer)
		return StzFindAll(pxThing, pxContainer)
	end

