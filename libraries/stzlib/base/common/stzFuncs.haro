func IsStzType(pxStr)
	if not IsString(pxStr)
		StzRaise("Incorrect param type! pcStr must be a string.")
	end

	vtTypes = StzTypes() # Assumes they are lowercase strings

	if Find(vtTypes, pxStr) > 0
		return true
	else
		return false
	end
end
