func StzIsCaseSensitive(xP)

	if (IsNumber(xP) and xP = 1) or
	   (IsList(xP) and Q(xP).IsCaseSensitiveNamedParam() and xP[2] = 1)

		return true

	elseif (IsNumber(xP) and xP = 0) or
	   (IsList(xP) and Q(xP).IsCaseSensitiveNamedParam() and xP[2] = 0)

		return false

	else
		StzRaise("Incorrect param! p must be 1 or FALSE.")
	end
end
	func IsCaseSensitive(xP)
		return StzIsCaseSensitive(xP)
	end
	func @IsCaseSensitive(xP)
		return StzIsCaseSensitive(xP)
	end
func StzCaseSensitive(xP)

	if Type(xP) = "BOOLEAN"
		return xP

	elseif IsNumber(xP)
		if xP = 1
			return true
		elseif xP = 0
			return false
		end

	elseif IsList(xP) and IsCaseSensitiveNamedParamList(xP)
		xP = xP[2]

		if Type(xP) = "BOOLEAN"
			return xP
		end
		if IsNumber(xP)
			if xP = 1
				return true
			elseif xP = 0
				return false
			end
		end

	else
		StzRaise("Incorrect param type! p must be a bolean (1 or FALSE).")
	end
end
	func CaseSensitive(xP)
		return StzCaseSensitive(xP)
	end
	func @CaseSensitive(xP)
		return StzCaseSensitive(xP)
	end
