	if not IsString(pxStr)
		StzRaise("Incorrect param type! pcStr must be a string.")
	end

	pxStr = StzLower(pxStr)
	vtRingTypes = RingTypes()

	if Find( RingTypes(), pxStr) > 0
		return true
	else
		return false
	end
end
