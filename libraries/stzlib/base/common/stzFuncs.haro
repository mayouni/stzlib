		end
	#>

func @NXT(xN, pxStrOrItem, pxInStrOrList)
	# EXAMPLES
	# ? @NXT(3 ,"A", :InAString)	#--> "AAA"
	# ? @NXT(3, "A", :InAList)	#--> [ "A", "A", "A" ]

	if CheckParams()
		if not IsNumber(xN)
			StzRaise("Incorrect param type! n must be a number.")
		end

		if not IsString(pxInStrOrList)
			StzRaise("Incorrect param type! pcInStrOrList must be a string.")
		end
	end

	if pxInStrOrList = :InList or pxInStrOrList = :InAList or
	   pxInStrOrList = :AsList or pxInStrOrList = :AsAList or
	   pxInStrOrList = :List

		xResult = []
	
		for i = 1 to xN
			xResult + pxStrOrItem
		end
	
		return xResult

	elseif pxInStrOrList = :InString or pxInStrOrList = :InAString or
	    pxInStrOrList = :AsString or pxInStrOrList = :AsAString or
	    pxInStrOrList = :String

		tResult = Copy(pxStrOrItem, xN)
		return tResult

	else
		StzRaise("Incorrect syntax! pcInStrOrList must be a string equal to :InString or :InList.")
	end
end
	#< @FunctionSpecificForms

	func @1XT(pxStrOrItem, pxInStrOrList)
		return @NXT(1, pxStrOrItem, pxInStrOrList)
	end
		func OneXT(pxStrOrItem, pxInStrOrList)
			return @NXT(1, pxStrOrItem, pxInStrOrList)
		end
	func @2XT(pxStrOrItem, pxInStrOrList)
