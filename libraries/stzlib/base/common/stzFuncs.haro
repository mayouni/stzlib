func TheseNumbers(xP)
	$bThese = true
	$bTheseQ = false

	if CheckingParams()
		if not IsList(xP)
			StzRaise("Incorrect param type! p must be a list.")
		end
	end

	nLen = Len(xP)
	viResult = []

	for i = 1 to nLen
		if IsNumber(xP[i])
			viResult + xP[i]
		end
	end

	return viResult
end
	# Must be reset to FALSE everytime TheseNumbers() is used.

