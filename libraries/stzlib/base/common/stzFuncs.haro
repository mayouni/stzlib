func StzEmpty(pxStzType)
	if not IsString(pxStzType)
		StzRaise("Incorrect param type! pcStzType must be a string.")
	end

	if not Q(pxStzType).IsStzClassName()
		StzRaise("Incorrect param! pcStzType must be a valid class name.")
	end

	switch pxStzType
	case :stzChar
		return new stzChar("_")

	case :stzString
		return new stzString("")

	case :stzNumber
		return new stzNumber(0)

	case :stzList
		return new stzList([])

	case :stzobject
		return new stzObject( new stzString("") )

	case :stzText
		return new stzText("")

	case :stzlistofobjects
		return new stzListOfObjects([])

	case :stzlistofnumbers
		return new stzListOfNumbers([])

	case :stzlistofstrings
		return new stzListOfstrings([])
		
	case :stzlistofchars
		return new stzListOfChars([])

	case :stzhashlist
		return new stzHashList([])

	case :stzlistofhashlists
		return new stzListOfHashLists([])

	case :stzset
		return new stzSet([])

	case :stzlistoflists
		return new stzListOfLists([])

	case :stzlistofpairs
		return new stzListOfPairs([])

	case :stzpair
		return new stzPair([])

	case :stzlistofsets
		return new stzListOfSets([])

	case :stzpairoflists
		return new stzPairOfLists([])

	case :stztree
		return new stzTree([])

	case :stztable
		return new stzTable([])

	case :stzlocale
		return new stzLocale([])

	case :stzcountry
		return new stzCountry([])

	case :stzlanguage
		return new stzLanguage([])

	case :stzscript
		return new stzScript([])

	case :stzcurrency
		return new stzCurrency("")

	case :stzgrid
		return new stzGrid([])

	case :stzentity
		return new stzEnity(:nothing)

	case :stzlistofentities
		return new stzListOfEntities([])

	case :stzstringart
		return new stzStringArt("")

	end
end
	func Empty(pxStzType)
		return StzEmpty(pxStzType)
	end
func StzSwap(xP1, xP2)
	xTemp = xP2
	xP2 = xP1
	xP1 = xTemp

	return [xP1, xP2]
end
	func Swap(xP1, xP2)
		return StzSwap(xP1, xP2)
