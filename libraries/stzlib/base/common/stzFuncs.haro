func StzUnicode(xP)
	if IsList(xP) and Q(xP).IsOfNamedParam()
		xP = xP[2]
	end

	if IsString(xP)
		nResult = StzStringQ(xP).Unicode()
		return nResult

	elseif IsList(xP)
		viResult = StzListQ(xP).Unicode()
		return viResult

	else
		StzRaise("Incorrect param type! p must be either a string or list.")
	end
end
	func Unicode(xP)
		return StzUnicode(xP)
	end
	func @Unicode(xP)
		return StzUnicode(xP)
	end
	func UnicodeOf(xP)
		return StzUnicode(xP)
	end
	func @UnicodeOf(xP)
		return StzUnicode(xP)
	end
