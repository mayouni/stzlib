func StzEuclideanDistance(viNumbers1, viNumbers2)

	if CheckParams()
		if IsList(viNumbers1) and IsBetweenNamedParamList(viNumbers1)
			viNumbers1 = viNumbers1[1]
		end
		if IsList(viNumbers2) and IsAndNamedParamList(viNumbers2)
			viNumbers2 = viNumbers2[1]
		end
		
		if not AreBothListsOfNumbers(viNumbers1, viNumbers2)
			StzRaise("Incorrect param types! anNumbers1 and anNumbers2 must be both lists of numbers.")
		end
		
		if Len(viNumbers1) != Len(viNumbers2)
			StzRaise("Incorrect lists sizes! anNumbers1 and anNumbers2 must both have the same size.")
		end
	end

	nResult = euc_dist(viNumbers1, viNumbers2)
	return nResult
end
	func EuclideanDistance(viNumbers1, viNumbers2)
		return StzEuclideanDistance(viNumbers1, viNumbers2)
	end
func euc_dist(xA,xB)

	if CheckParams()
		if not ( IsNumber(xA) and IsNumber(xB) )
			StzRaise("Incorrect param types! a and b must be bother numbers.")
		end
	end

	nS = 0
	nN = Len(xA)

	for i = 1 to nN

		xDist = xA[i] - xB[i]
		nS += xDist * xDist
	end

	return Sqrt(nS)
end
