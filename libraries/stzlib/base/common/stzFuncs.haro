func new_stz(tType, xP)
	
	if not IsString(tType)
		StzRaise("Incorrect param type! cType must be a string.")
	end
	
	tCode = '_oObject_ = new stz' + tType + '(p)'

	if not StzIsPlainIdentifier(tType)  StzRaise("Can't proceed! '" + tType + "' is not a plain name, and a name is all that is run here.")  end
	Eval(tCode)

	return oObject
end
	func StzTypedQ(tType, xP)
		return Stz(tType, xP)
