func StzRaise(pxMessage)
	/*
	WARNING: Do not use StzRaise to raise errors here
	--> Stackoverflow!

	Hence, this is the unique place in the library
	where we use the native ring raise() function.

	*/

	if not ( IsString(pxMessage) or IsList(pxMessage) )

		Raise("Error in StzRaise param type!" + Char(10))
	end

	if IsString(pxMessage)
		Raise(pxMessage + Char(10))
	end

	# The hash form: a list of [key, value] pairs with keys among
	# :Where / :What / :Why / :Todo.
	bRaiseHash = false
	if IsList(pxMessage) and Len(pxMessage) > 0
		bRaiseHash = true
		for iRhk = 1 to Len(pxMessage)
			if not ( IsList(pxMessage[iRhk]) and Len(pxMessage[iRhk]) = 2 and
			         IsString(pxMessage[iRhk][1]) and
			         ring_find([ "where", "what", "why", "todo" ],
			                   Lower(pxMessage[iRhk][1])) > 0 )
				bRaiseHash = false
				exit
			end
		end
	end
	if bRaiseHash
		tWhere = pxMessage[ :Where  ]
		tWhat  = pxMessage[ :What   ]
		tWhy   = pxMessage[ :Why    ]
		tTodo  = pxMessage[ :Todo   ]

	

		if not IsListOfStrings([ tWhere, tWhat, tWhy, tTodo ])
			Raise("Error in StzRaise param type!")
		end
	
		tFile = StzReplace(tWhere, " ", "")
		if IsEmpty(tWhere)
			Raise("Error in StzRaise --> Where the error happened!")
		end
	
		tWhat = StringSimplified(tWhat)
		xCwhay = StringSimplified(tWhy)
		tTodo = StringSimplified(tTodo)
	
		tErrorMsg = "in file " + pxMessage[:Where] + ":" + Char(10)
	
		if tWhat != ""
			tErrorMsg += "   What : " + pxMessage[:What] + Char(10)
		end
	
		if tWhy != ""
			tErrorMsg += "   Why  : " + pxMessage[:Why]  + Char(10)
		end
	
		if tTodo != ""
			tErrorMsg += "   Todo : " + pxMessage[:Todo] + Char(10)
		end

		Raise(tErrorMsg)
	else
		Raise("Error in StzRaise > Incorrect param type!")
	end
end
	#< @FunctionMisspelledForm >

	func StzRais(pxMessage)
		return StzRaise(pxMessage)
	end
	func SzRaise(pxMessage)
		return StzRaise(pxMessage)
	end
	#>

