digraph "techco" {
    graph [rankdir=TB, bgcolor=white, fontname="helvetica", fontsize=12, splines=spline, nodesep=1, ranksep=1, ordering=out, tooltip=" "]
    node [fontname="helvetica", fontsize=12]
    edge [fontname="helvetica", fontsize=12, color="#808080", style=solid, penwidth=1, arrowhead=normal, arrowtail=none]

    ceo [label="CEO", shape=box, style="rounded,solid,filled", fillcolor="#FFFFFF", penwidth=1, fontcolor="black", fillcolor="#FFFFFF", fontcolor="black", color="#808080", tooltip=" "]
    cto [label="CTO", shape=box, style="rounded,solid,filled", fillcolor="#FFFFFF", penwidth=1, fontcolor="black", fillcolor="#FFFFFF", fontcolor="black", color="#808080", tooltip=" "]
    cfo [label="CFO", shape=box, style="rounded,solid,filled", fillcolor="#C94DC9", penwidth=1, fontcolor="white", fillcolor="#C94DC9", fontcolor="white", color="#808080", tooltip=" "]
    dev1 [label="Developer", shape=box, style="rounded,solid,filled", fillcolor="#FFFFFF", penwidth=1, fontcolor="black", fillcolor="#FFFFFF", fontcolor="black", color="#808080", tooltip=" "]
    dev2 [label="Developer", shape=box, style="rounded,solid,filled", fillcolor="#C94DC9", penwidth=1, fontcolor="white", fillcolor="#C94DC9", fontcolor="white", color="#808080", tooltip=" "]
    acct [label="Accountant", shape=box, style="rounded,solid,filled", fillcolor="#C94DC9", penwidth=1, fontcolor="white", fillcolor="#C94DC9", fontcolor="white", color="#808080", tooltip=" "]

    ceo -> cto
    ceo -> cfo
    cto -> dev1
    cto -> dev2
    cfo -> acct

}