# made c1.ring ; run: cd libraries/stzlib/base/test/reflect && ring <this file>  (picture: canvas_hires.png)
load "../../../stzlib.ring"
# chdir("<an output folder>") here, after the load, so the picture lands there (the engine DLL path breaks if Ring starts elsewhere: run from base/test/reflect)
oF = new stzFont("C:/Windows/Fonts/segoeui.ttf")

o = new stzCanvas(480, 320)
o.SetBackgroundQ("#FFFFFF")
o.AddRectQ(20, 20, 100, 60).FillQ("red").StrokeQ("#000000", 3)
o.AddRoundRectQ(140, 20, 100, 60, 16).FillQ("#2E86DE").StrokeQ("#0B3C6F", 2)
o.AddCircleQ(300, 50, 32).FillQ("gold").StrokeQ("#7A5C00", 4)
o.AddEllipseQ(400, 50, 50, 28).FillQ("#27AE60")
o.AddGradientRect(20, 110, 140, 60, "#FFFFFF", "#000000", 0)
o.AddGradientRect(180, 110, 60, 60, "#FF0000", "#0000FF", 1)
o.AddLineQ(270, 110, 460, 170).StrokeQ("#8E44AD", 5)
o.AddPolylineQ([ 20, 250, 70, 200, 120, 250, 170, 200 ]).StrokeQ("#E67E22", 3)
o.AddPolygonQ([ 250, 250, 300, 190, 350, 250 ]).FillQ("#1ABC9C").StrokeQ("#000000", 2)
o.AddTextQ("Hello stzCanvas 123", 20, 300).SetFontQ(oF, 22).Color("#222222")
o.AddTextQ("small text 12px", 300, 300).SetFontQ(oF, 12).Color("#222222")
cP = o.ToPNG("canvas_shapes.png")
? "png " + len(cP)
cS = o.ToSVG()
write("canvas_shapes.svg", cS)
? "svg " + len(cS)
? "shapes: " + o.ShapeCount()
o2 = new stzCanvas(480, 320)
o2.SetBackgroundQ("#FFFFFF")
o2.AddRectQ(20, 20, 100, 60).FillQ("red").StrokeQ("#000000", 3)
o2.AddCircleQ(300, 50, 32).FillQ("gold").StrokeQ("#7A5C00", 4)
o2.AddLineQ(270, 110, 460, 170).StrokeQ("#8E44AD", 1)
o2.AddLineQ(270, 130, 460, 140).StrokeQ("#8E44AD", 1)
o2.ToPNGHiRes("canvas_hires.png")
