#--------------------------------------------------------------#
#         SOFTANZA LIBRARY (V0.9) - STZWEBBUNDLE               #
#   An accelerative library for Ring applications, and more!   #
#--------------------------------------------------------------#
#                                                              #
#   Description  : The WEB is a COMPOSITE target -- not one    #
#                  binary but an assembly: wasm module(s) +    #
#                  a stz.js bridge + an HTML shell + a         #
#                  manifest. stzBuilder builds the wasm parts  #
#                  (freestanding, bridge ABI); stzWebBundle    #
#                  assembles them into one deployable folder.  #
#   Version      : V0.9 (2026)                                 #
#   Author       : Mansour Ayouni (kalidianow@gmail.com)       #
#                                                              #
#--------------------------------------------------------------#
#
# The bridge is real, not WASI emulation: JS owns the linear memory and passes it
# to the module; the module imports stz_log to render; its listed exports are
# callable from JS. This is "a part in wasm + a stz.js library bridging Softanza
# to the native wasm", assembled.
#
#   oW = new stzBuilder("app").InCQ().AddSourceQ("app.c").TargetWebQ().AddExportQ("stz_main")
#   oW.Build()
#   oB = new stzWebBundle("app").SetTitleQ("My App").SetOutDirQ("dist")
#   oB.AddWasmQ("app", oW.OutputPath())
#   oB.Build()
#   #--> dist/{app.wasm, stz.js, index.html, bundle.json}

  #=============#
 #  FUNCTIONS  #
#=============#

func StzWebBundleQ(pcName)
	return new stzWebBundle(pcName)

# The Softanza <-> wasm bridge, emitted into the bundle. JS strings are single-
# quoted so this stays clean when generated. Matches the proven runtime bridge.
func _StzWebBridgeJs()
	_c_ = "// stz.js -- the Softanza <-> wasm bridge (generated by stzWebBundle)." + char(10)
	_c_ += "// JS owns the linear memory and passes it to the module; the module" + char(10)
	_c_ += "// imports stz_log to render. No WASI -- a real, minimal bridge surface." + char(10)
	_c_ += "(function (global) {" + char(10)
	_c_ += "  'use strict';" + char(10)
	_c_ += "  var dec = new TextDecoder('utf-8');" + char(10)
	_c_ += "  async function load(wasmUrl, opts) {" + char(10)
	_c_ += "    opts = opts || {};" + char(10)
	_c_ += "    var sink = opts.sink || function (s) { if (typeof console !== 'undefined') console.log(s); };" + char(10)
	_c_ += "    var memory = new WebAssembly.Memory({ initial: opts.pages || 256, maximum: opts.maxPages || 16384 });" + char(10)
	_c_ += "    var imports = { env: { memory: memory," + char(10)
	_c_ += "      stz_log: function (ptr, len) { sink(dec.decode(new Uint8Array(memory.buffer, ptr, len))); }" + char(10)
	_c_ += "    } };" + char(10)
	_c_ += "    var bytes = await fetch(wasmUrl).then(function (r) { return r.arrayBuffer(); });" + char(10)
	_c_ += "    var res = await WebAssembly.instantiate(bytes, imports);" + char(10)
	_c_ += "    return { exports: res.instance.exports, memory: memory };" + char(10)
	_c_ += "  }" + char(10)
	_c_ += "  global.Stz = { load: load };" + char(10)
	_c_ += "})(typeof window !== 'undefined' ? window : this);" + char(10)
	return _c_

func _StzWebShellHtml(pcTitle, pcMainWasm)
	_c_ = "<!doctype html>" + char(10)
	_c_ += "<html lang='en'><head><meta charset='utf-8'>" + char(10)
	_c_ += "<meta name='viewport' content='width=device-width, initial-scale=1'>" + char(10)
	_c_ += "<title>" + pcTitle + "</title></head>" + char(10)
	_c_ += "<body>" + char(10)
	_c_ += "<h1>" + pcTitle + "</h1>" + char(10)
	_c_ += "<div id='stz-out'></div>" + char(10)
	_c_ += "<script src='stz.js'></script>" + char(10)
	_c_ += "<script>" + char(10)
	_c_ += "(function () {" + char(10)
	_c_ += "  var out = document.getElementById('stz-out');" + char(10)
	_c_ += "  function sink(s) { var p = document.createElement('p'); p.textContent = s; out.appendChild(p); }" + char(10)
	_c_ += "  Stz.load('" + pcMainWasm + "', { sink: sink }).then(function (mod) {" + char(10)
	_c_ += "    if (mod.exports.stz_main) { mod.exports.stz_main(); }" + char(10)
	_c_ += "    var d = document.createElement('div'); d.id = 'stz-done'; d.textContent = 'ready';" + char(10)
	_c_ += "    document.body.appendChild(d);" + char(10)
	_c_ += "  }).catch(function (e) { sink('ERROR: ' + e); });" + char(10)
	_c_ += "})();" + char(10)
	_c_ += "</script></body></html>" + char(10)
	return _c_

func _StzWebManifest(pcName, paFiles, pcMain)
	_q_ = char(34)
	_c_ = "{" + char(10)
	_c_ += "  " + _q_ + "name" + _q_ + ": " + _q_ + pcName + _q_ + "," + char(10)
	_c_ += "  " + _q_ + "kind" + _q_ + ": " + _q_ + "web-bundle" + _q_ + "," + char(10)
	_c_ += "  " + _q_ + "entry" + _q_ + ": " + _q_ + "index.html" + _q_ + "," + char(10)
	_c_ += "  " + _q_ + "main" + _q_ + ": " + _q_ + pcMain + _q_ + "," + char(10)
	_c_ += "  " + _q_ + "files" + _q_ + ": ["
	_n_ = len(paFiles)
	for _i_ = 1 to _n_
		_c_ += _q_ + paFiles[_i_] + _q_
		if _i_ < _n_
			_c_ += ", "
		ok
	next
	_c_ += "]" + char(10) + "}" + char(10)
	return _c_


  #===============#
 #  STZWEBBUNDLE  #
#===============#

# Assembles a deployable web folder from wasm modules: the modules, the stz.js bridge, an HTML shell and a manifest.
#
# The web is a composite target, not one binary. stzBuilder compiles the wasm parts; stzWebBundle
# copies them into one folder together with the bridge that lets JavaScript own the linear memory
# and call the module's exports, a page that loads the first module and calls its stz_main, and
# bundle.json. Add modules by path (or hand over a stzBuilder, which is built first), set the title
# and the output folder, then Build. The default folder is <name>_web in the current folder.
#
#   receiver   o1 = new stzWebBundle("app") o1.SetTitle("My App") o1.SetOutDir("web_demo_unused")
#   example    ? o1.IsBuilt()
#              #--> 0
#              ? o1.ShellPath()
#              #--> web_demo_unused/index.html
#              ? o1.ManifestPath()
#              #--> web_demo_unused/bundle.json
#              ? o1.NumberOfParts()
#              #--> 0
#   see        stzBuilder, stzEmulator, stzDeployment
class stzWebBundle from stzObject

	@cName = ""
	@cTitle = ""
	@cOutDir = ""
	@aParts = []       # [ name, wasmPath ]
	@aFiles = []
	@bBuilt = 0

	# Creates a web bundle with a name, which is also its page title until SetTitle changes it.
	#
	#   pcName     the bundle's name
	#   returns    nothing; the object is built
	#   see        AddWasm, Build
	def init(pcName)
		@cName = "" + pcName
		@cTitle = "" + pcName

	# Sets the title of the generated HTML page.
	#
	#   pcTitle    the title text
	#   returns    nothing; use SetTitleQ to chain
	#   warning    the title is placed in the page as written, without escaping
	#   see        Build
	def SetTitle(pcTitle)
		This.SetTitleQ(pcTitle)

	def SetTitleQ(pcTitle)
		@cTitle = "" + pcTitle
		return This

	# Chooses the folder the bundle is assembled in, in place of the default <name>_web in the current folder.
	#
	#   pcDir      the folder to assemble in, created by Build if missing
	#   returns    nothing; use SetOutDirQ to chain
	#   warning    Build writes there: point it at a scratch folder
	#   see        BundleDir, Build
	def SetOutDir(pcDir)
		This.SetOutDirQ(pcDir)

	def SetOutDirQ(pcDir)
		@cOutDir = "" + pcDir
		return This

	# Adds a wasm module to the bundle, by the path of a prebuilt file or by a stzBuilder that is built on the spot.
	#
	#   pcName     the module's name, which becomes <name>.wasm in the bundle
	#   pWasm      the path of a prebuilt .wasm file, or a stzBuilder
	#   returns    nothing; use AddWasmQ to chain
	#   note       run here with the path of a prebuilt stand-in file only
	#   warning    the first module added is the one the page runs; given a stzBuilder it runs that
	#              builder's compiler
	#   see        Build, NumberOfParts
	#@ aka  Add a wasm part -- a prebuilt .wasm path, or a stzBuilder (which is built).
	def AddWasm(pcName, pWasm)
		This.AddWasmQ(pcName, pWasm)

	def AddWasmQ(pcName, pWasm)
		_cPath_ = ""
		if isObject(pWasm)
			pWasm.Build()
			_cPath_ = pWasm.OutputPath()
		else
			_cPath_ = "" + pWasm
		ok
		@aParts + [ "" + pcName, _cPath_ ]
		return This

	# Returns the folder the bundle is or will be assembled in.
	#
	#   returns    a text
	#   see        SetOutDir, ShellPath
	def BundleDir()
		if @cOutDir != ""
			return @cOutDir
		ok
		return @cName + "_web"

	# Copies the wasm modules into the bundle folder and writes the bridge stz.js, the page index.html and the manifest bundle.json.
	#
	#   returns    the bundle itself, so calls chain
	#   note       the manifest lists the files except bundle.json itself
	#   warning    writes files and replaces those of the same names; a wasm path that does not
	#              exist raises error R35; a bundle with no module is still written, with a page
	#              that loads nothing
	#   see        Files, IsBuilt, BundleDir
	def Build()
		_cDir_ = This.BundleDir()
		StzEngineDirCreatePath(_cDir_)
		@aFiles = []

		# copy each wasm part into the bundle
		_nP_ = len(@aParts)
		_cMain_ = ""
		for _i_ = 1 to _nP_
			_cPartName_ = @aParts[_i_][1]
			_cSrc_ = @aParts[_i_][2]
			_cDst_ = _cDir_ + "/" + _cPartName_ + ".wasm"
			write(_cDst_, read(_cSrc_))
			@aFiles + (_cPartName_ + ".wasm")
			if _i_ = 1
				_cMain_ = _cPartName_ + ".wasm"
			ok
		next

		# the bridge, the shell, the manifest
		write(_cDir_ + "/stz.js", _StzWebBridgeJs())
		@aFiles + "stz.js"
		write(_cDir_ + "/index.html", _StzWebShellHtml(@cTitle, _cMain_))
		@aFiles + "index.html"
		write(_cDir_ + "/bundle.json", _StzWebManifest(@cName, @aFiles, _cMain_))
		@aFiles + "bundle.json"

		@bBuilt = 1
		return This

		def BuildQ()
			This.Build()
			return This

	# Returns the files the last Build wrote, relative to the bundle folder, in the order written.
	#
	#   returns    a list of texts
	#   warning    empty before the first Build
	#   see        Build
	def Files()
		return @aFiles

	# Returns how many wasm modules were added.
	#
	#   returns    a number
	#   see        AddWasm
	def NumberOfParts()
		return len(@aParts)

	# TRUE if Build has run on this bundle.
	#
	#   returns    TRUE or FALSE
	#   see        Build, Files
	def IsBuilt()
		return @bBuilt

	# Returns the path of the bundle's page, index.html.
	#
	#   returns    a text
	#   see        BundleDir, BridgePath
	def ShellPath()
		return This.BundleDir() + "/index.html"

	# Returns the path of the bridge file stz.js in the bundle.
	#
	#   returns    a text
	#   see        ShellPath, ManifestPath
	def BridgePath()
		return This.BundleDir() + "/stz.js"

	# Returns the path of the manifest bundle.json in the bundle.
	#
	#   returns    a text
	#   see        ShellPath, BridgePath
	def ManifestPath()
		return This.BundleDir() + "/bundle.json"

	# Prints the bundle's name, number of modules and folder, and, once built, its files.
	#
	#   returns    nothing; it prints
	#   see        Files, Build
	def Show()
		? "WebBundle '" + @cName + "' (" + This.NumberOfParts() + " wasm part(s))"
		? "  dir:   " + This.BundleDir()
		if @bBuilt
			? "  files: " + @@(@aFiles)
		ok
