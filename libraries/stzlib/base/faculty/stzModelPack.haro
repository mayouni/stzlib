#--------------------------------------------------------------#
#      SOFTANZA LIBRARY (V1.2) - STZMODELPACK                   #
#--------------------------------------------------------------#
#                                                              #
#   Description  : MP2 of SOFTANZA_MODEL_PLACEMENT.md: the     #
#                  OPTIONAL PACKS of the model catalogue, and  #
#                  the target PROFILE that says which packs    #
#                  and how much memory a machine has.          #
#                                                              #
#                  A pack is a set of model files Softanza     #
#                  never needs and never chooses by default:   #
#                  it is offered where the court measured a    #
#                  gain worth its size. Where it is installed, #
#                  and the machine has the memory it names,    #
#                  its implementations take part in the        #
#                  registry's choice like any other; where it  #
#                  is not, the faculty answers as before.      #
#                  It fetches NOTHING: StzModelFetchFile is     #
#                  the developer's act.                        #
#                                                              #
#--------------------------------------------------------------#

# a target profile (StzModelsReportFor): "" reads this machine; "profile" takes the packs and the memory from the profile
$tStzPlacementProfile = ""
$aStzPlacementPacks = []
$nStzPlacementMemoryMB = 0

# Every optional pack the catalogue names.
#
#   returns    [ [ :name, :paths, :memory, :title, :note ] ... ] -- :memory is the machine memory it needs, in MB
#   example    aP = StzModelPacks()
#   see        StzModelPackState, StzModelPackPlanText
func StzModelPacks
	return StzModelCatalog()[:packs]
end

# One pack by its name; [] when the catalogue has none of that name.
func StzModelPack(tName)
	aP = StzModelPacks()
	nLenaP = Len(aP)
	for i = 1 to nLenaP
		if aP[i][:name] = tName
			return aP[i]
		end
	end
	return []
end

# The machine's memory in MB: the profile's when a target profile is set, else this machine's (0 when it cannot be read).
func StzPlacementMemoryMB
	if $tStzPlacementProfile = "profile" and $nStzPlacementMemoryMB > 0
		return $nStzPlacementMemoryMB
	end
	nBytes = StzEnginePerfSysMemTotal()
	if nBytes <= 0
		return 0
	end
	return Floor(nBytes / 1048576)
end

# 1 while a target profile decides which packs are installed (StzModelsReportFor with a profile), else 0.
func StzPlacementIsProfile
	if $tStzPlacementProfile = "profile"
		return 1
	end
	return 0
end

# Sets a target profile: [ [:os, "linux"], [:memory, 8192], [:packs, [ "support-quality" ]] ] -- each key optional. The operating
# system is the registry's own ($cStzPlacementOS, set by StzModelsReportFor); this keeps the packs and the memory.
func StzPlacementProfileSet(aProfile)
	$tStzPlacementProfile = "profile"
	$aStzPlacementPacks = []
	$nStzPlacementMemoryMB = 0
	if HasKey(aProfile, :packs) = 1
		$aStzPlacementPacks = aProfile[:packs]
	end
	if HasKey(aProfile, :memory) = 1
		$nStzPlacementMemoryMB = aProfile[:memory]
	end
end

func StzPlacementProfileClear
	$tStzPlacementProfile = ""
	$aStzPlacementPacks = []
	$nStzPlacementMemoryMB = 0
end

# The pack an implementation belongs to: the one holding a file its needle names (a fragment of a file name), or a file the catalogue's
# requires rows say it needs. "" when it belongs to none.
func StzModelPackOf(aImpl)
	tNeedle = ""
	if HasKey(aImpl, :needle) = 1
		tNeedle = StzLower("" + aImpl[:needle])
	end
	aNeeds = []
	if HasKey(aImpl, :faculty) = 1 and HasKey(aImpl, :id) = 1
		if aImpl[:faculty] != ""
			aNeeds = StzImplementationFiles(aImpl[:faculty], aImpl[:id], "")
		end
	end
	aP = StzModelPacks()
	nLenaP = Len(aP)
	for i = 1 to nLenaP
		aPaths = aP[i][:paths]
		nLenaPaths = Len(aPaths)
		for k = 1 to nLenaPaths
			if tNeedle != ""
				if StzFindFirst(tNeedle, StzLower(StzEnginePathBasename(aPaths[k]))) > 0
					return aP[i][:name]
				end
			end
			if Len(StzFind(aPaths[k], aNeeds)) > 0
				return aP[i][:name]
			end
		end
	end
	return ""
end

# 1 when the pack is installed: under a target profile, when the profile lists it; here, when every file it holds is in the models
# directory at its catalogued size (StzModelPackState checks the digests).
func StzModelPackInstalled(tName)
	if $tStzPlacementProfile = "profile"
		if Len(StzFind(tName, $aStzPlacementPacks)) > 0
			return 1
		end
		return 0
	end
	aPk = StzModelPack(tName)
	if Len(aPk) = 0
		return 0
	end
	aPaths = aPk[:paths]
	nLenaPaths = Len(aPaths)
	for i = 1 to nLenaPaths
		aS = StzModelFileState(aPaths[i], 0)
		if aS[:present] = 0 or aS[:sizeok] = 0
			return 0
		end
	end
	return 1
end

# MP2 capability: [ 1, "" ] when the implementation is in no pack, or its pack's memory need is met here (or on the profile's machine);
# else [ 0, the reason ]. The registry asks it for every implementation (StzImplementationAvailable).
func StzModelPackAvailable(aImpl)
	tPack = StzModelPackOf(aImpl)
	if tPack = ""
		return [ 1, "" ]
	end
	nNeed = StzModelPack(tPack)[:memory]
	nHave = StzPlacementMemoryMB()
	if nHave > 0 and nHave < nNeed
		return [ 0, "in the optional pack '" + tPack + "', which needs a machine with " + String(nNeed) + " MB of memory; this one has " + String(nHave) + " MB" ]
	end
	return [ 1, "" ]
end

# The state of a pack here.
#
#   returns    [ :name, :title, :note, :installed, :bytes, :memory, :machinememory, :memoryok, :files = [ [ path, state ] ... ] ]
#              -- a state is StzModelFileState's; the digests are read only when bDigest is 1 (about three seconds a gigabyte)
func StzModelPackState(tName, bDigest)
	aPk = StzModelPack(tName)
	if Len(aPk) = 0
		StzRaise("StzModelPackState: the catalogue names no pack '" + tName + "'")
	end
	nDigest = 0
	if bDigest
		nDigest = 1
	end
	aFiles = []
	nBytes = 0
	nInstalled = 1
	aPaths = aPk[:paths]
	nLenaPaths = Len(aPaths)
	for i = 1 to nLenaPaths
		aS = StzModelFileState(aPaths[i], nDigest)
		aFiles + [ aPaths[i], aS ]
		aE = StzModelCatalogEntry(aPaths[i])
		if Len(aE) > 0
			nBytes = nBytes + aE[:bytes]
		end
		if aS[:present] = 0 or aS[:sizeok] = 0 or aS[:digest] = "differs"
			nInstalled = 0
		end
	end
	nHave = StzPlacementMemoryMB()
	nMemOk = 1
	if nHave > 0 and nHave < aPk[:memory]
		nMemOk = 0
	end
	return [ [:name, tName], [:title, aPk[:title]], [:note, aPk[:note]], [:installed, nInstalled], [:bytes, nBytes],
		 [:memory, aPk[:memory]], [:machinememory, nHave], [:memoryok, nMemOk], [:files, aFiles] ]
end

# What a pack would change, faculty by faculty: every declared implementation that belongs to it, with what the measurements and the court
# say installing it changes (the setup plan's own wording). Returns [ [ faculty, implementation, value ] ... ].
func StzModelPackServes(tName)
	aOut = []
	aN = StzFacultyNames()
	nLenaN = Len(aN)
	for j = 1 to nLenaN
		oF = StzFacultyQ(aN[j])
		aI = oF.Implementations()
		nLenaI = Len(aI)
		for i = 1 to nLenaI
			aRow = aI[i]
			aRow + [ :faculty, aN[j] ]
			if StzModelPackOf(aRow) = tName
				aOut + [ aN[j], aI[i][:id], _StzSetupValue(aN[j], aI[i][:id], "") ]
			end
		end
	end
	return aOut
end

# THE PACK'S SETUP PLAN, as text: what it is, what it holds, what it needs, what it changes here -- never done for you.
#
#   example    ? StzModelPackPlanText("support-quality")
#   see        StzModelPackState, StzModelFetchFile
func StzModelPackPlanText(tName)
	aS = StzModelPackState(tName, false)
	tNl = Char(10)
	tOut = "OPTIONAL PACK " + tName + " -- " + aS[:title] + tNl
	tOut = tOut + "  optional  never a default: Softanza answers without it. Where it is installed, its implementations are chosen only where the court upheld them" + tNl
	if aS[:installed] = 1
		tOut = tOut + "  state     installed here (every file present at its catalogued size; StzModelPackState(name, 1) checks the sha256)" + tNl
	else
		tOut = tOut + "  state     not installed here" + tNl
	end
	tMem = "  memory    needs a machine with " + String(aS[:memory]) + " MB; "
	if aS[:machinememory] = 0
		tMem = tMem + "this machine's memory could not be read"
	elseif aS[:memoryok] = 1
		tMem = tMem + "this one has " + String(aS[:machinememory]) + " MB: it can run here"
	else
		tMem = tMem + "this one has " + String(aS[:machinememory]) + " MB: it cannot run here, installed or not"
	end
	tOut = tOut + tMem + tNl
	aF = aS[:files]
	nLenaF = Len(aF)
	for i = 1 to nLenaF
		aE = StzModelCatalogEntry(aF[i][1])
		tOut = tOut + "  file      " + aF[i][1] + " -- " + aF[i][2][:reason] + tNl
		if Len(aE) > 0
			tOut = tOut + "  size      " + String(aE[:bytes]) + " bytes; licence " + aE[:licence] + tNl
			tOut = tOut + "  source    " + aE[:url] + tNl
			tOut = tOut + "  check     sha256 " + aE[:sha256] + tNl
			tFrom = StzModelFetchSource(aF[i][1])
			if tFrom != ""
				tOut = tOut + "  fetch     StzModelFetchFile('" + aF[i][1] + "')   from " + tFrom + tNl
			end
		end
	end
	aV = StzModelPackServes(tName)
	if Len(aV) = 0
		tOut = tOut + "  serves    no declared faculty in this program" + tNl
	end
	nLenaV = Len(aV)
	for i = 1 to nLenaV
		tOut = tOut + "  serves    :" + aV[i][1] + " / " + aV[i][2] + " -- " + aV[i][3] + tNl
	end
	if aS[:note] != ""
		tOut = tOut + "  note      " + aS[:note] + tNl
	end
	return tOut
end

# One line per pack that is not installed here, for the end of the setup plan ("" when every pack is installed or none exists).
func StzModelPacksSetupText
	tOut = ""
	aP = StzModelPacks()
	nLenaP = Len(aP)
	for i = 1 to nLenaP
		if StzModelPackInstalled(aP[i][:name]) = 0
			tOut = tOut + "  optional pack '" + aP[i][:name] + "' -- " + aP[i][:title] + "; see StzModelPackPlanText('" + aP[i][:name] + "')" + Char(10)
		end
	end
	if tOut = ""
		return ""
	end
	return Char(10) + "OPTIONAL PACKS (never needed, never a default)" + Char(10) + tOut
end

# A target profile in words, for a report's title: "linux, 8192 MB, packs: support-quality".
func StzPlacementProfileText(aProfile)
	tOut = ""
	if HasKey(aProfile, :os) = 1
		tOut = "" + aProfile[:os]
	else
		tOut = StzPlacementOS()
	end
	if HasKey(aProfile, :memory) = 1
		tOut = tOut + ", " + String(aProfile[:memory]) + " MB"
	end
	tPacks = "none"
	if HasKey(aProfile, :packs) = 1
		aPk = aProfile[:packs]
		nLenaPk = Len(aPk)
		for i = 1 to nLenaPk
			if i = 1
				tPacks = "" + aPk[i]
			else
				tPacks = tPacks + ", " + aPk[i]
			end
		end
	end
	return tOut + ", optional packs: " + tPacks + " (a target profile)"
end
