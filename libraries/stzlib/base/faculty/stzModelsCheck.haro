#--------------------------------------------------------------#
#      SOFTANZA LIBRARY (V1.2) - STZMODELSCHECK                 #
#--------------------------------------------------------------#
#                                                              #
#   Description  : MP2 of SOFTANZA_MODEL_PLACEMENT.md: the     #
#                  STATUS a deployment script can fail on.     #
#                  A program names the faculties it needs and  #
#                  a target (this machine, an operating        #
#                  system, or a profile with memory and        #
#                  packs); the check answers, for each, what   #
#                  would answer THERE and whether that meets   #
#                  the requirement -- 0 when every one is met, #
#                  1 when one is not, 2 when a requirement     #
#                  names no declared faculty.                  #
#                                                              #
#                  It is a view of the registry, like the      #
#                  report it reads: it decides nothing.        #
#                                                              #
#--------------------------------------------------------------#

# A requirement is a text:
#
#   "ocr"                            the faculty answers there (its whole golden set): nothing may REFUSE
#   "ocr/ar"                         ...for that language, as measured in it
#   "triage_extract=bolt-e4b-choice" ...and that implementation is the one that answers (the quality the program was built on)
#   "ocr/ar=ppocr"                   both
#
# Checks every requirement against a target and returns
#
#   [ [:status, 0 | 1 | 2], [:target, its words], [:rows, [ [ [:requirement, t], [:met, 1 | 0 | -1], [:chosen, t], [:here, t],
#     [:why, t] ] ... ]] ]      -- met -1 is a requirement naming no declared faculty
#
#   example    aC = StzModelsCheck([ [:os, "linux"], [:memory, 8192], [:packs, []] ], [ "ocr", "triage_extract=bolt-e4b-choice" ])
#              Shutdown(StzModelsCheckExit(xTarget, aRequire))    # in a CI step: prints the check, exits with its status
#   see        StzModelsReportFor, StzModelsCheckText
func StzModelsCheck(xTarget, xRequire)
	xThere = StzModelsReportFor(xTarget)
	xHere = xThere
	if IsList(xTarget)
		xHere = StzModelsReportFor("")
	elseif xTarget != ""
		xHere = StzModelsReportFor("")
	end
	xRows = []
	nUnmet = 0
	nUnknown = 0
	nLenReq = Len(xRequire)
	for i = 1 to nLenReq
		xRow = _StzCheckOne("" + xRequire[i], xThere, xHere)
		if xRow[:met] = -1
			nUnknown = nUnknown + 1
		elseif xRow[:met] = 0
			nUnmet = nUnmet + 1
		end
		xRows + xRow
	end
	nStatus = 0
	if nUnmet > 0
		nStatus = 1
	end
	if nUnknown > 0
		nStatus = 2
	end
	return [ [:status, nStatus], [:target, _StzCheckTargetText(xTarget)], [:rows, xRows] ]
end

# The check as text: one line per requirement, then the status.
func StzModelsCheckText(xCheck)
	tNl = Char(10)
	tOut = "SOFTANZA MODELS CHECK -- " + xCheck[:target] + tNl
	xRows = xCheck[:rows]
	nLenRows = Len(xRows)
	nMet = 0
	for i = 1 to nLenRows
		xR = xRows[i]
		tMark = "FAIL   "
		if xR[:met] = 1
			tMark = "PASS   "
			nMet = nMet + 1
		elseif xR[:met] = -1
			tMark = "UNKNOWN"
		end
		tOut = tOut + "  " + tMark + "  :" + xR[:requirement] + "  -- " + xR[:why] + tNl
		if xR[:here] != "" and xR[:here] != xR[:chosen]
			tOut = tOut + "           (on this machine '" + xR[:here] + "' answers it; there '" + xR[:chosen] + "' would)" + tNl
		end
	end
	tOut = tOut + "status " + String(xCheck[:status]) + ": " + String(nMet) + " of " + String(nLenRows) + " requirements met"
	if xCheck[:status] = 2
		tOut = tOut + "; a requirement names no declared faculty (StzFacultyNames lists them)"
	end
	return tOut + tNl
end

# For a CI step: checks, prints the text, returns the status to exit with.
func StzModelsCheckExit(xTarget, xRequire)
	xC = StzModelsCheck(xTarget, xRequire)
	? StzModelsCheckText(xC)
	return xC[:status]
end

# one requirement against the report's entries there and here
func _StzCheckOne(tReq, xThere, xHere)
	tFac = tReq
	tBy = ""
	nEq = StzFindFirst("=", tReq)
	if nEq > 0
		tFac = Left(tReq, nEq - 1)
		tBy = Right(tReq, Len(tReq) - nEq)
	end
	tLang = ""
	nSl = StzFindFirst("/", tFac)
	if nSl > 0
		tLang = Right(tFac, Len(tFac) - nSl)
		tFac = Left(tFac, nSl - 1)
	end
	if StzHasFaculty(tFac) = 0
		return _StzCheckRow(tReq, -1, "", "", "no faculty named '" + tFac + "' is declared in this program")
	end
	xE = _StzCheckEntry(xThere, tFac, tLang)
	tHere = ""
	xH = _StzCheckEntry(xHere, tFac, tLang)
	if Len(xH) > 0
		tHere = xH[:chosen]
	end
	if Len(xE) = 0
		return _StzCheckRow(tReq, 0, "", tHere, "':" + tFac + "' is not measured in '" + tLang + "', so no choice is recorded for it there (unknown is not good)")
	end
	if xE[:refusal] = 1
		return _StzCheckRow(tReq, 0, "", tHere, "NOTHING would answer there: " + _StzCheckRefusalWhy(xE))
	end
	if tBy = ""
		return _StzCheckRow(tReq, 1, xE[:chosen], tHere, "'" + xE[:chosen] + "' would answer (" + xE[:reason] + ")")
	end
	if xE[:chosen] = tBy
		return _StzCheckRow(tReq, 1, xE[:chosen], tHere, "'" + tBy + "' would answer (" + xE[:reason] + ")")
	end
	return _StzCheckRow(tReq, 0, xE[:chosen], tHere, "'" + xE[:chosen] + "' would answer there, not '" + tBy + "': " + _StzCheckImplWhy(xE, tBy))
end

func _StzCheckRow(tReq, nMet, tChosen, tHere, tWhy)
	return [ [:requirement, tReq], [:met, nMet], [:chosen, tChosen], [:here, tHere], [:why, tWhy] ]
end

func _StzCheckEntry(xEntries, tFac, tLang)
	nLenE = Len(xEntries)
	for i = 1 to nLenE
		if xEntries[i][:faculty] = tFac and xEntries[i][:lang] = tLang
			return xEntries[i]
		end
	end
	return []
end

# why an implementation that is not chosen there is not: it cannot run, it is not installed, or the registry preferred another
func _StzCheckImplWhy(xE, tBy)
	xI = xE[:impls]
	nLenI = Len(xI)
	for i = 1 to nLenI
		if xI[i][:id] = tBy
			if xI[i][:available] = 0
				return "it cannot run there -- " + xI[i][:unavailable]
			end
			if xI[i][:installed] = 0
				return "it is not installed there (see StzModelSetupPlanText, StzModelPackPlanText)"
			end
			return "the registry chose otherwise (" + xE[:reason] + ")"
		end
	end
	return "no implementation '" + tBy + "' is declared for ':" + xE[:faculty] + "'"
end

# a refusal's reasons, one per implementation that could not take part
func _StzCheckRefusalWhy(xE)
	tOut = ""
	xI = xE[:impls]
	nLenI = Len(xI)
	for i = 1 to nLenI
		tR = ""
		if xI[i][:available] = 0
			tR = xI[i][:unavailable]
		elseif xI[i][:installed] = 0
			tR = "not installed"
		end
		if tR != ""
			if tOut != ""
				tOut = tOut + "; "
			end
			tOut = tOut + xI[i][:id] + ": " + tR
		end
	end
	if tOut = ""
		return "no implementation qualified (StzModelsReportFor says why)"
	end
	return tOut
end

func _StzCheckTargetText(xTarget)
	if IsList(xTarget)
		return StzPlacementProfileText(xTarget)
	end
	if xTarget = ""
		return StzPlacementOS() + ", this machine"
	end
	return "" + xTarget + " (an operating system; this machine's packs and memory)"
end
