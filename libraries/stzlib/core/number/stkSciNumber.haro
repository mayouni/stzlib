
func IsSciForm(tNumber)
	if not IsString(tNumber)
		return false
	end

	nPos = StkFindFirst("e", tNumber)
	if nPos = 0
		return false
	end

	tBase = ""
	for i = 1 to nPos-1
		tBase += tNumber[i]
	end

	tExp = ""
	nLen = Len(tNumber)
	for i = nPos+1 to nLen
		tExp += tNumber[i]
	end

	# Haro's Decimal RAISES on a text that is no number (R41, "1.5e" leaves an empty exponent),
	# where Ring's answered a value IsNumber could refuse. A predicate answers false instead
	try
		nBase = Decimal(tBase)
		nExp = Decimal(tExp)
	catch
		return false
	end

	return true
end
func Number2Sci(xN)
	return StzEngineNumberToScientific(Decimal(xN))
end
func Sci2Number(tNumberInStr)
	tClean = Trim( StkReplace(tNumberInStr, "_", "") )
	return StzEngineNumberFromScientific(tClean)
end
class stzCoreSciNumber from stkSciNumber
end
class stkSciNumber
	@nBase
	@nExp

	@tStrValue

	def init(tNumberInSciForm)
		if not IsString(tNumberInSciForm)
			return Raise("ERR-" + StkError(:IncorrectParamType))
		end
	
		nPos = StkFindFirst("e", tNumberInSciForm)
		if nPos = 0
			return 0
		end
	
		tBase = ""
		for i = 1 to nPos-1
			tBase += tNumberInSciForm[i]
		end
	
		tExp = ""
		nLen = Len(tNumberInSciForm)
		for i = nPos+1 to nLen
			tExp += tNumberInSciForm[i]
		end
	
		nBase = Decimal(tBase)
		if not IsNumber(nBase)
			return Raise("ERR-" + StkError(:IncorrectParamType))
		end
	
		nExp = Decimal(tExp)
		if not IsNumber(nExp)
			return Raise("ERR-" + StkError(:IncorrectParamType))
		end
	
		@nBase = nBase
		@nExp = nExp

		@tStrValue = tNumberInSciForm
	end
	def Content
		return @tStrValue
	end
		def SciForm
			return @tStrValue
		end
	def Value
		nResult = @nBase * Pow(10, @nExp)
		return nResult
	end
		def NValue
		end
	def Base
		return @nBase
	end
	def Exp
		return @nExp
	end
end
