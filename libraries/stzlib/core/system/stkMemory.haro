
# A container of buffers, and of the pointers that read and write them.
#
# It hands out the buffer and pointer OBJECTS and keeps a reference to each, never a copy. Haro
# copies an object when it is assigned or stored, so a stored copy would never see a write made
# through the object the caller holds, nor the caller a write made here. Measured on haro.exe
# 2026-11-28: Ref() of an object held in a LOCAL is shared by every later assignment of it -- the
# list's element, the caller's variable, a copy of either -- while Ref() of a list's element is
# not. So each object is made in a local, stored as Ref(local) and returned as Ref(local).
#
# Ids are texts the container gives: "buf1", "buf2"... for buffers, "ptr1", "ptr2"... for pointers.

class stkMemory
    @bIsValid = true
    @vBuffers = []           # Hashlist: [["buf1", oBuffer1], ...], each object held by reference
    @xPointers = []          # Hashlist: [["ptr1", oPointer1], ...], each object held by reference
    @nNextBufferId = 1       # Unique ID generator
    @nNextPointerId = 1      # Unique pointer ID generator

    def init
        # Initialize container
        @vBuffers = []
        @xPointers = []
        @nNextBufferId = 1
        @nNextPointerId = 1
        @bIsValid = true
    end

	#-----------#
	#  BUFFERS  #
	#-----------#

	# The new buffer itself, shared with this container: a write through it is a write here
	def CreateBuffer(nSize)

	    if nSize <= 0
	        Raise("Buffer size must be positive")
	    end

	    tBufferId = "buf" + String(@nNextBufferId)
	    @nNextBufferId++

	    oBuffer = new stkBuffer(this, tBufferId, nSize)
	    @vBuffers + [tBufferId, Ref(oBuffer)]

	    return Ref(oBuffer)
	end

	def NumberOfBuffers
		return Len(@vBuffers)
	end

	# The STORED buffer, shared with every holder of it. Raises on an id this container does not hold
	# (an id that is no text, Haro refuses at the parameter: TYPE_LETTER)
    def GetBuffer(tBufferId)
		nPos = this.FindBuffer(tBufferId)
		if nPos = 0
			Raise("Invalid buffer ID: " + tBufferId)
		end

		return @vBuffers[nPos][2]
    end

	def WriteToBuffer(tBufferId, nOffset, pxData)
		this.GetBuffer(tBufferId).Write(nOffset, pxData)
	end

	def ReadFromBuffer(tBufferId, nOffset, nLength)
	    return this.GetBuffer(tBufferId).Read(nOffset, nLength)
	end

	# Destroys the buffer and invalidates every pointer into it. The container and the caller hold
	# the same objects, so the caller's buffer and pointers say so too
	def DestroyBuffer(tBufferId)
		nPos = this.FindBuffer(tBufferId)
		if nPos = 0
	        return false
	    end

		nLenPtr = Len(@xPointers)

	    for i = 1 to nLenPtr
	        if @xPointers[i][2].BufferId() = tBufferId
	            @xPointers[i][2].@bIsValid = false
	        end
	    end

	    @vBuffers[nPos][2].@bIsValid = false
	    Del(@vBuffers, nPos)

	    return true
	end

    def FindBuffer(tBufferId)
		nLen = Len(@vBuffers)
		for i = 1 to nLen
			if @vBuffers[i][1] = tBufferId
				return i
			end
		end

		return 0
    end

	# [] for an id this container does not hold
	def BufferInfo(tBufferId)
		nPos = this.FindBuffer(tBufferId)
		if nPos = 0
			return []
		end

		oBuffer = @vBuffers[nPos][2]

	    return [
	        [:id, oBuffer.Id()],
	        [:size, oBuffer.Size()],
	        [:capacity, oBuffer.Capacity()],
	        [:hasWritePointer, oBuffer.HasWritePointer()],
	        [:isValid, oBuffer.IsValid()]
	    ]
	end

	#------------#
	#  POINTERS  #
	#------------#

	# A pointer whose view spans the buffer's capacity
	def CreatePointer(tBufferId, tAccessMode)
		return this.CreatePointerView(tBufferId, tAccessMode, 0, this.GetBuffer(tBufferId).Capacity())
	end

	# A pointer onto nLength bytes from nOffset, shared with this container. A buffer has one write
	# pointer at most: this takes its write lock, and DestroyPointer releases it
    def CreatePointerView(tBufferId, tAccessMode, nOffset, nLength)

		oBuffer = this.GetBuffer(tBufferId)

	    if not ( tAccessMode = "read" or tAccessMode = "write" )
	        Raise("Access mode must be 'read' or 'write'")
	    end

        # Validate view bounds
        if nOffset < 0 or nLength <= 0
            Raise("Invalid view bounds")
        end

        if (nOffset + nLength) > oBuffer.Capacity()
            Raise("View extends beyond buffer bounds")
        end

        # Check write access restrictions, then take the lock
        if tAccessMode = "write"
			if oBuffer.HasWritePointer()
				Raise("Buffer already has a write pointer")
			end
			oBuffer.AcquireWritePointer()
        end

		tPointerId = "ptr" + String(@nNextPointerId)
        @nNextPointerId++

        oPointer = new stkPointer(this, tBufferId, tAccessMode, nOffset, nLength, tPointerId)
        @xPointers + [ tPointerId, Ref(oPointer) ]

        return Ref(oPointer)
    end

	def NumberOfPointers
		return Len(@xPointers)
	end

	# Removes the pointer and invalidates it; a write pointer releases its buffer's write lock
    def DestroyPointer(tPointerId)
		nPos = this.FindPointer(tPointerId)
		if nPos = 0
			return false
		end

		oPointer = @xPointers[nPos][2]

        if oPointer.AccessMode() = "write"
			nBuf = this.FindBuffer(oPointer.BufferId())
			if nBuf > 0
				@vBuffers[nBuf][2].ReleaseWritePointer()
			end
        end

		oPointer.@bIsValid = false
        Del(@xPointers, nPos)

        return true
    end

    def FindPointer(tPointerId)
		nLen = Len(@xPointers)
		for i = 1 to nLen
			if @xPointers[i][1] = tPointerId
				return i
			end
		end

		return 0
    end

	# true when this container holds the pointer and the buffer it points into
    def ValidatePointer(tPointerId)
		nPos = this.FindPointer(tPointerId)
		if nPos = 0
			return false
		end

        return this.IsValidBufferId(@xPointers[nPos][2].BufferId())
    end

	# [] for an id this container does not hold
    def PointerInfo(tPointerId)
		nPos = this.FindPointer(tPointerId)
		if nPos = 0
			return []
		end

		return @xPointers[nPos][2].Info()
    end

	# Destroys every pointer that no longer validates, and answers how many
    def CleanupInvalidPointers
		vInvalid = []
		nLenPtr = Len(@xPointers)

        for i = 1 to nLenPtr
            if not @xPointers[i][2].IsValid()
                vInvalid + @xPointers[i][1]
            end
        end

		nLen = Len(vInvalid)
		for i = 1 to nLen
			this.DestroyPointer(vInvalid[i])
		end

		return nLen
    end

	#-------------#
	#  THE WHOLE  #
	#-------------#

	def Stats

		nLenBuf = Len(@vBuffers)
		nLenPtr = Len(@xPointers)
		nValid = 0
		nRead = 0
		nWrite = 0

	    for i = 1 to nLenPtr
	        if @xPointers[i][2].IsValid()
	            nValid++
	            if @xPointers[i][2].AccessMode() = "read"
	                nRead++
	            else
	                nWrite++
	            end
	        end
	    end

		nMemory = 0
	    for i = 1 to nLenBuf
	        nMemory += @vBuffers[i][2].Size()
	    end

	    return [
	        [:totalBuffers, nLenBuf],
	        [:totalPointers, nLenPtr],
	        [:validPointers, nValid],
	        [:readPointers, nRead],
	        [:writePointers, nWrite],
	        [:totalMemory, nMemory]
	    ]
	end

    def IsValid
        return @bIsValid
    end
    def Show

	nLenBuf = Len(@vBuffers)
	nLenPtr = Len(@xPointers)

  	  ? "stkMemory Container:"
	    ? "  Valid: " + String(@bIsValid)
	    ? "  Buffers: " + String(nLenBuf)
	    ? "  Pointers: " + String(nLenPtr)
	    ? "  Next Buffer ID: " + String(@nNextBufferId)
	    ? "  Next Pointer ID: " + String(@nNextPointerId)

	    if nLenBuf > 0
	        ? "  Buffer Details:"
	        for i = 1 to nLenBuf
	            oBuffer = @vBuffers[i][2]
	            ? "    ID:" + @vBuffers[i][1] + " Size:" + String(oBuffer.Size()) + " WritePtr:" + String(oBuffer.HasWritePointer())
	        end
	    end

        if nLenPtr > 0
            ? "  Pointer Details:"
            for i = 1 to nLenPtr
                oPointer = @xPointers[i][2]
                ? "    ID:" + oPointer.PointerId() + " Buffer:" + oPointer.BufferId() + " Mode:" + oPointer.AccessMode() + " Valid:" + String(oPointer.IsValid())
            end
        end
    end

	# The ids are read first: destroying deletes from the list being walked
	def DestroyAllBuffers
		vIds = []
	    nLenBuf = Len(@vBuffers)

	    for i = 1 to nLenBuf
	        vIds + @vBuffers[i][1]
	    end

	    for i = 1 to nLenBuf
	        this.DestroyBuffer(vIds[i])
	    end
	end

    def DestroyAllPointers
		vIds = []
		nLenPtr = Len(@xPointers)

        for i = 1 to nLenPtr
            vIds + @xPointers[i][1]
        end

        for i = 1 to nLenPtr
            this.DestroyPointer(vIds[i])
        end
    end
    def Free
        this.DestroyAllPointers()
        this.DestroyAllBuffers()
        @bIsValid = false
    end
    def Destroy
        this.Free()
    end
	#----

	def IsValidBuffer(oBuffer)
		if not (IsObject(oBuffer) and ClassName(oBuffer) = "stkbuffer")
			return false
		end

		return this.IsValidBufferId(oBuffer.Id())
	end
	def IsValidBufferId(tBufferId)
	    return this.FindBuffer(tBufferId) > 0
	end
end
