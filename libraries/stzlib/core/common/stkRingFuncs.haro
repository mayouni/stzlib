
# Wrappers to ring functions, that we use inside a softanza class
# where the same name is needed (example: insert() inside stzString)
#--> This will allow us to avoid conflicts!
#--> For you as a Ring programmer, this won't alter you Ring experience
#     when you want to use native Ring form. But if you are inside a
#     softanza object, then the softanza version will apply, unless you
#     you opt for the Ring's version using ring_...()

#TODO // Add the ring_...() form of all Ring functions

func SoftanzaLogo
	if not IsGlobal(:$xSOFTANZALOGO)
		$xSOFTANZALOGO = "Softanza"
	end
	return $xSOFTANZALOGO
end
	func Softanza
		if not IsGlobal(:$xSOFTANZALOGO)
			$xSOFTANZALOGO = "Softanza"
		end
		return $xSOFTANZALOGO
	end
func StzVersion
	return "0.9"
end
	func stz_version
		return StzVersion()
	end
func ring_char(xN)
	return Char(xN)
end
# The fraction digits tFraction (the text after "0.") rounded to nPlaces places, as the text of
# that number: StkRoundedFractionText("4567", 2) is "0.46", and "999" to 2 places is "1.00".
# It rounds per value; no places setting is read or changed.
func StkRoundedFractionText(tFraction, nPlaces)
	return String(Decimal(Decimal("0." + tFraction), nPlaces))
end
func ring_max(pxNumbers)
	nBest = pxNumbers[1]
	nLen = Len(pxNumbers)
	for i = 2 to nLen
		if pxNumbers[i] > nBest
			nBest = pxNumbers[i]
		end
	end
	return nBest
end
func ring_min(pxNumbers)
	nBest = pxNumbers[1]
	nLen = Len(pxNumbers)
	for i = 2 to nLen
		if pxNumbers[i] < nBest
			nBest = pxNumbers[i]
		end
	end
	return nBest
end
func ring_trim(xStr)
	return Trim(xStr)
end
func ring_split(xStr, xSep)
	# Ring's stdlib Split(), line for line, with char(10) where it reads
	# the global NL. Ring is case-insensitive, so a caller writing
	# `nL = len(aLines)` makes NL a number, and every later split() then
	# raises "Bad parameter type" inside substr(), far from that line.
	# Library code calls ring_split(), never split() (NL-SPLIT-SWEEP-01).
	# Same semantics as split(): a tab or space delimiter collapses runs
	# of blanks, the string is trimmed, and a newline always splits too.

	if xSep = ""
		vOut = []
		nLen = Len(xStr)
		for i = 1 to nLen
			vOut + xStr[i]
		end
		return vOut
	end

	if xSep = Char(9)
		xSep = " "
	end

	if xSep = " "
		while SubStr(xStr, Char(9)) > 0
			xStr = SubStr(xStr, Char(9), " ")
		end
		while SubStr(xStr, "  ") > 0
			xStr = SubStr(xStr, "  ", " ")
		end
	end

	return Str2List(SubStr(Trim(xStr), xSep, Char(10)))
end
func ring_read(tFilePath)
	return Read(tFilePath)
end
func ring_write(tFilePath, pxStr)
	return Write(tFilePath, pxStr)
end
func ring_insert(pxList, xN, xItem)
	#NOTE
	# We change the behaviour of the Ring function, since
	# it actually means in Ring insertAfter() and not insert()

	if not ( IsList(pxList)  or IsNumber(xN) )
		Raise( "ERR-" + StkError(:IncorrectParamType) )
	end

	if not xN > 0
		Raise( "ERR-" + StkError(:IncorrectParamValye) )
	end

	Insert(pxList, xN-1, xItem)
	return pxList
end
func ring_find(pxList, pxItem)
