func ring_del(pxList, xN)

	Del(pxList, xN)
	return pxList
end
	#NOTE
	# Some Ring standard functions make the action in place and does not
	# return anything. Others do the action and return the result.
	#~>
	# The ring_...() functions family always do the action and return
	# the result. So you are free to say:

	# 	aList = [ 1, 1, 2, 3 ]
	# 	ring_insert(aList, 1, 1)
	# 	? aList
	# 	#--> [ 1, 2, 3 ]

	# Or directly:

	# 	? ring_insert([ 1, 1, 2, 3 ], 1, 1)
	# 	#--> [ 1, 2, 3 ]
	

	func ring_remove(pxList, xN) # An alternative I added to the Ring semantics
		return ring_del(pxList, xN)
	end
# Finds substr in str, counting BYTES. No .haro file calls it since 2026-11-28; ten .ring modules
# that base/stzBase.ring loads still do. New code calls StkFindFirst (core) or StzFindFirst (base),
# which count codepoints. ring_substr2, its replace twin, is gone: use StkReplace or StzReplace.
func ring_substr1(xStr, xSubstr)
	if xStr = "" or xSubstr = ''
		return 0
	end

	return SubStr(xStr, xSubstr)
end
func ring_copy(xP1, xP2)
	return Copy(xP1, xP2)
end
	func @copy(xP1, xP2)
		return Copy(xP1, xP2)
	end
	func RepeatChar(xP1, xP2) #TODO// Should be located in stzChar or stzSring
		return Copy(xP1, xP2)
	end
