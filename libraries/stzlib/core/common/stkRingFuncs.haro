#--

# The interpreter running this program, so a worker or child process runs on
# the same one. exefilename() names it on Ring++ (rnxc) as on Ring; a program
# built into its own executable falls back to an interpreter named in sysargv,
# then to "rnxc". The lookups this replaces looked only for "ring", so under
# rnxc every worker was launched on the retired interpreter (2026-11-06).

func StzInterpreterPath
	vNames = [ "rnxc", "ring", "haro" ]
	tExe = String(ExeFileName())
	if _StzIsInterpreterPath(tExe, vNames)
		return tExe
	end
	xArgs = sysargv
	nArgs = Len(xArgs)
	for i = 1 to nArgs
		if _StzIsInterpreterPath(String(xArgs[i]), vNames)
			return String(xArgs[i])
		end
	end
	return "rnxc"
end
func _StzIsInterpreterPath(pxPath, pxNames)
	tP = Lower(SubStr(pxPath, Char(92), "/"))
	nSlash = 0
	nLenP = Len(tP)
	for i = nLenP to 1 step -1
		if tP[i] = "/"
			nSlash = i
			exit
		end
	end
	tBase = tP
	if nSlash > 0
		tBase = Right(tP, nLenP - nSlash)
	end
	if Right(tBase, 4) = ".exe"
		tBase = Left(tBase, Len(tBase) - 4)
	end
	nNames = Len(pxNames)
	for i = 1 to nNames
		if tBase = pxNames[i]
			return true
		end
	end
	return false
end
