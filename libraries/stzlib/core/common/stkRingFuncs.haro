func ring_del(pxList, xN)

	Del(pxList, xN)
	return pxList
end
	#NOTE
	# Some Ring standard functions make the action in place and does not
	# return anything. Others do the action and return the result.
	#~>
	# The ring_...() functions family always do the action and return
	# the result. So you are free to say:

	# 	aList = [ 1, 1, 2, 3 ]
	# 	ring_insert(aList, 1, 1)
	# 	? aList
	# 	#--> [ 1, 2, 3 ]

	# Or directly:

	# 	? ring_insert([ 1, 1, 2, 3 ], 1, 1)
	# 	#--> [ 1, 2, 3 ]
	

	func ring_remove(pxList, xN) # An alternative I added to the Ring semantics
		return ring_del(pxList, xN)
	end
func ring_file_remove(tFile)
	Remove(tFile)
end
func ring_substr(pxParams)
	if not IsList(pxParams)
		Raise("ERR-" + StkError(:IncorrectParamType))
	end

	nLen = Len(pxParams)
	if nLen < 2 or nLen > 3
		Raise("ERR-" + StkError(:IncorrectNumberOfParams))
	end

	if nLen = 2
		return ring_substr1(pxParams[1], pxParams[2])
	elseif nLen = 3
		return ring_substr2(pxParams[1], pxParams[2], pxParams[2])
	end
end
func ring_substr1(xStr, xSubstr) # Finds substr in str
	if xStr = "" or xSubstr = ''
		return 0
	end

	return SubStr(xStr, xSubstr)
end
func ring_substr2(xStr, xSubstr1, xSubstr2) # Replaces substr1 by substr2 in str
	if xStr = "" or xSubstr1 = ''
		return ""
	end

	return SubStr(xStr, xSubstr1, xSubstr2)
end
