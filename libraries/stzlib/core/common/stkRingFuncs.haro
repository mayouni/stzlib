end
func ring_EvenOrOdd(xN) # Inverses the output to be more logic (odd -> 1, even -> 2)
	if EvenOrOdd(xN) = 1
		return 2
	else
		return 1
	end
end
	func ring_OddOrEven(xN)
		return EvenOrOdd(xN)
	end
