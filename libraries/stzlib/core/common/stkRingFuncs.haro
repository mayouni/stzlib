func ring_max(pxNumbers)
	nBest = pxNumbers[1]
	nLen = Len(pxNumbers)
	for i = 2 to nLen
		if pxNumbers[i] > nBest
			nBest = pxNumbers[i]
		end
	end
	return nBest
end
func ring_min(pxNumbers)
	nBest = pxNumbers[1]
	nLen = Len(pxNumbers)
	for i = 2 to nLen
		if pxNumbers[i] < nBest
			nBest = pxNumbers[i]
		end
	end
	return nBest
end
func ring_trim(xStr)
	return Trim(xStr)
end
func ring_split(xStr, xSep)
	# Ring's stdlib Split(), line for line, with char(10) where it reads
	# the global NL. Ring is case-insensitive, so a caller writing
	# `nL = len(aLines)` makes NL a number, and every later split() then
	# raises "Bad parameter type" inside substr(), far from that line.
	# Library code calls ring_split(), never split() (NL-SPLIT-SWEEP-01).
	# Same semantics as split(): a tab or space delimiter collapses runs
	# of blanks, the string is trimmed, and a newline always splits too.

	if xSep = ""
		vOut = []
		nLen = Len(xStr)
		for i = 1 to nLen
			vOut + xStr[i]
		end
		return vOut
	end

	if xSep = Char(9)
		xSep = " "
	end

	if xSep = " "
		while SubStr(xStr, Char(9)) > 0
			xStr = SubStr(xStr, Char(9), " ")
		end
		while SubStr(xStr, "  ") > 0
			xStr = SubStr(xStr, "  ", " ")
		end
	end

	return Str2List(SubStr(Trim(xStr), xSep, Char(10)))
end
