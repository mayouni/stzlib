func @IsPpointer(xP)
	return IsPointer(xP) # A Ring standard function
end
func ArePointers(pxPointers)
	if not IsList(pxPointers)

		return 0
	end

	bResult = true
	nLen = Len(pxPointers)

	for i = 1 to nLen
		if not IsPointer(pxPointers[i])
			bResult = false
			exit
		end
	end

	return bResult
end
	func @ArePointers(pxPointers)
		return ArePointers(pxPointers)
	end
