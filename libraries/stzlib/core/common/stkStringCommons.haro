#----------------------------------#
#  COMMON FOR ALL STRING CLASSES   #
#----------------------------------#

func IsLetter(xC)
	if Len(xC) != 1
		return false
	end
	nN = Ascii(xC)
	if (nN >= 65 and nN <= 90) or (nN >= 97 and nN <= 122)
		return true
	end
	return false
end
	func @IsLetter(xC)
		return IsLetter(xC)
	end
func IsDigit(xC)
	if Len(xC) != 1
		return false
	end
	nN = Ascii(xC)
	return (nN >= 48 and nN <= 57)
end
	func @IsDigit(xC)
		return IsDigit(xC)
	end
# Polymorphic (widened 2026-07-10, see doc/design/NNL_REVIEW.md): a single
# char keeps the historical ASCII-char check; a longer string answers for
# the WHOLE string -- this is what the NNL descriptor dispatch relies on
# (@isLowercase("ring") must be TRUE; it silently answered 0 for years
# because the char-only form said "not one char -> FALSE").

func IsUpperCase(xC)
	if not IsString(xC) or Len(xC) = 0
		return false
	end
	if Len(xC) = 1
		nN = Ascii(xC)
		return (nN >= 65 and nN <= 90)
	end
	return xC = Upper(xC) and Upper(xC) != Lower(xC)
end
	func @IsUpperCase(xC)
		return IsUpperCase(xC)
	end
func IsLowerCase(xC)
	if not IsString(xC) or Len(xC) = 0
		return false
	end
	if Len(xC) = 1
		nN = Ascii(xC)
		return (nN >= 97 and nN <= 122)
	end
	return xC = Lower(xC) and Lower(xC) != Upper(xC)
end
	func @IsLowerCase(xC)
		return IsLowerCase(xC)
	end
func StringIsEmpty(xStr)
	return (Len(xStr) = 0)
end
func StringRepeat(xStr, xN)
	tResult = ""
	for i = 1 to xN
		tResult += xStr
	end
	return tResult
end
	func @StringRepeat(xStr, xN)
		return StringRepeat(xStr, xN)
	end
func StringReverse(xStr)
	tResult = ""
	for i = Len(xStr) to 1 step -1
		tResult += xStr[i]
	end
	return tResult
end
	func @StringReverse(xStr)
		return StringReverse(xStr)
	end
#-- Finding and replacing, on the engine

# The core's find and replace. Haro's SubStr counts BYTES, as Ring's did: an e-acute is two, and a
# find after one answers a position one too far. These ask the engine, which counts CODEPOINTS and
# matches whole characters. stk_string, the one engine library the core loads (stkRingLibs.haro),
# registers the StzEngineString functions, so these answer with no base layer loaded; base's
# StzFindFirst and StzReplace do not exist when the core is loaded alone (core/test does that).
#
# They replace ring_substr1 and ring_substr2 (retired 2026-11-28), and differ from them on purpose:
#   - the position is in codepoints, where ring_substr1 answered bytes (the same on ASCII text);
#   - an EMPTY NEEDLE is found nowhere (0) and replaces nothing (the text comes back whole), as
#     base's StzFindFirstCS and StzReplaceCS answer. ring_substr2 answered "", which threw the
#     whole text away, and Haro's own SubStr raises "Bad parameter value!" on it;
#   - not found is 0. The engine answers -1, and that number never leaves these functions.

# The first position of tSubStr in tStr, in codepoints, or 0 when it is not there
func StkFindFirstCS(tSubStr, tStr, bCase)
	if tSubStr = "" or tStr = ""
		return 0
	end
	nCase = 0
	if bCase
		nCase = 1
	end
	xH = StzEngineString(tStr)
	nPos = StzEngineStringFindFirstFromCS(xH, tSubStr, 1, nCase)
	StzEngineStringFree(xH)
	if nPos > 0
		return nPos
	end
	return 0
end
func StkFindFirst(tSubStr, tStr)
	return StkFindFirstCS(tSubStr, tStr, true)
end
# tStr with every tSubStr in it replaced by tNewSubStr. Case-insensitive matching keeps the text's
# own case outside the matches (the core's replace used to lowercase the whole text first)
func StkReplaceCS(tStr, tSubStr, tNewSubStr, bCase)
	if tSubStr = "" or tStr = ""
		return tStr
	end
	nCase = 0
	if bCase
		nCase = 1
	end
	xH = StzEngineString(tStr)
	StzEngineStringReplaceCS(xH, tSubStr, tNewSubStr, nCase)
	tResult = StzEngineStringData(xH)
	StzEngineStringFree(xH)
	return tResult
end
func StkReplace(tStr, tSubStr, tNewSubStr)
	return StkReplaceCS(tStr, tSubStr, tNewSubStr, true)
end
